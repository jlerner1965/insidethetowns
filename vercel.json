{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self' https://formspree.io https://buttondown.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/compare{/}?",
      "destination": "/moving/",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": false
    },
    {
      "source": "/explore{/}?",
      "has": [
        {
          "type": "host",
          "value": "insidelyons.com"
        }
      ],
      "destination": "/things-to-do/",
      "permanent": true
    },
    {
      "source": "/eat-shop{/}?",
      "has": [
        {
          "type": "host",
          "value": "insidelyons.com"
        }
      ],
      "destination": "/eat-drink/",
      "permanent": true
    },
    {
      "source": "/stay{/}?",
      "has": [
        {
          "type": "host",
          "value": "insidelyons.com"
        }
      ],
      "destination": "/things-to-do/",
      "permanent": true
    },
    {
      "source": "/outdoors{/}?",
      "has": [
        {
          "type": "host",
          "value": "insidelyons.com"
        }
      ],
      "destination": "/articles/trails-and-the-river/",
      "permanent": true
    },
    {
      "source": "/itineraries{/}?",
      "has": [
        {
          "type": "host",
          "value": "insidelyons.com"
        }
      ],
      "destination": "/things-to-do/",
      "permanent": true
    },
    {
      "source": "/plan-a-visit{/}?",
      "has": [
        {
          "type": "host",
          "value": "insidelyons.com"
        }
      ],
      "destination": "/things-to-do/",
      "permanent": true
    },
    {
      "source": "/our-story{/}?",
      "has": [
        {
          "type": "host",
          "value": "insidelyons.com"
        }
      ],
      "destination": "/articles/lyons-history-sandstone-railroad-river/",
      "permanent": true
    },
    {
      "source": "/civic{/}?",
      "has": [
        {
          "type": "host",
          "value": "insidelyons.com"
        }
      ],
      "destination": "/articles/who-governs-lyons/",
      "permanent": true
    },
    {
      "source": "/community{/}?",
      "has": [
        {
          "type": "host",
          "value": "insidelyons.com"
        }
      ],
      "destination": "/moving-here/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "insidefirestone.com"
        }
      ],
      "destination": "https://carbonvalleyguide.com/firestone/",
      "permanent": true
    },
    {
      "source": "/events{/}?",
      "has": [
        {
          "type": "host",
          "value": "insidefirestone.com"
        }
      ],
      "destination": "https://carbonvalleyguide.com/events/?where=firestone",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "insidefirestone.com"
        }
      ],
      "destination": "https://carbonvalleyguide.com/firestone/",
      "permanent": true
    }
  ]
}
