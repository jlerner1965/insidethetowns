---
/**
 * What an item rests on: the day it was checked, the page it was checked
 * against, and the way to say it is wrong. On every event and place page,
 * and in a short form on cards.
 *
 * One line, one correction link, one owner's way in (design pass, 26
 * October 2026): a place page used to carry this line, a "Tell us" link
 * twice and a second paragraph asking the owner for a photo, three asks
 * saying one thing. The correction link lands on /correct/ with the item
 * named, so the message arrives saying which listing it is about without
 * the reader typing it; the owner's link is the same form, with the
 * listings page beside it for how a listing works.
 */
import TipsLink from './TipsLink.astro';
import type { Confidence } from '@/lib/confidence';
import { formatDate, formatShortDate } from '@/lib/dates';
import { checkedBy } from '@/lib/editor';

interface Props {
  verified?: Date;
  source?: string;
  /** "event/farmers-market" or "place/niwot-tavern": the item id the correction names. */
  item: string;
  title: string;
  /** One line on what changes fastest, for the full form. */
  note?: string;
  /** Rows and cards: the check date alone, small. */
  compact?: boolean;
  /**
   * An event's confidence (src/lib/confidence.ts). When it says more than a
   * check date can (a call to the organizer, a community calendar's listing,
   * a check gone stale) its own words replace the date line.
   */
  confidence?: Confidence;
  /**
   * A place with someone to run it: one more sentence asks them for a
   * photo, new hours or a correction, through the same form.
   */
  owner?: boolean;
}

const { verified, source, item, title, note, compact = false, confidence, owner = false } = Astro.props;
const own = confidence?.line;
const host = source ? new URL(source).hostname.replace(/^www\./, '') : undefined;
const correct = `/correct/?item=${encodeURIComponent(item)}&title=${encodeURIComponent(title)}`;
---
{compact ? (
  confidence?.short ? <span class="text-ink-muted">{confidence.short}</span> : verified && <span class="text-ink-muted">{checkedBy(formatShortDate(verified))}</span>
) : (
  <div class="mt-6 border-t border-line-soft pt-4 text-[0.875rem] leading-relaxed text-ink-muted">
    <p>
      {own ? (
        <Fragment><span>{own} </span>{source && <span>Listing: <a href={source} rel="noopener" class="underline">{host}</a>. </span>}</Fragment>
      ) : (
        <Fragment>{verified && <span>{checkedBy(formatDate(verified))}</span>}{verified && source && <span> against </span>}{source && <a href={source} rel="noopener" class="underline">{host}</a>}{(verified || source) && '. '}</Fragment>
      )}
      {note && <span>{note} </span>}
      <a href={correct} class="underline">Report a correction</a>{!owner && <Fragment> · <TipsLink /></Fragment>}
    </p>
    {owner && (
      <p class="mt-2">
        Own or run {title}? <a href={correct} class="underline">Send a photo, new hours or a correction</a>. Listings are editorial and free; <a href="/for-businesses/" class="underline">how listings work</a>.
      </p>
    )}
  </div>
)}
