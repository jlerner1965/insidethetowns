---
/**
 * The independence note beside the email: one sentence and two links. The
 * footer carries the longer form on every page.
 */
import type { TownConfig } from '@/config';

interface Props {
  town: TownConfig;
  class?: string;
}

const { town, class: className } = Astro.props;
---
<section class:list={['rounded-lg bg-accent-soft p-6 md:p-8', className]} aria-labelledby="trust">
  <h2 id="trust" class="display-md text-[1.75rem] leading-tight">Independent, and checked</h2>
  <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-muted">
    Nobody pays to be listed on {town.siteTitle}, and every listing names its source and the day it was read.
  </p>
  <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-[0.9375rem]">
    <a href="/editorial/" class="inline-block -my-1 py-1 font-semibold text-primary underline">How the guide works</a>
    <a href="/correct/" class="inline-block -my-1 py-1 font-semibold text-primary underline">Send a correction</a>
  </p>
</section>
