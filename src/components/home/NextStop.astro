---
/**
 * Find your next stop (the homepage redesign brief, 27 October 2026):
 * three photographs, one each for the places to eat and drink, the things
 * to do and living here (or moving here, on a guide without a residents'
 * page), the label over the picture. They replaced three place cards and a
 * list of eight.
 *
 * Each photograph is one the town already has: the best-placed listing of
 * the kind with a picture (the editor's pick first), and the town's own
 * hero where no listing of the kind has one. No new photographs.
 */
import { Image } from 'astro:assets';
import type { TownConfig } from '@/config';
import { EAT_DRINK_TYPES, LAND_TYPES } from '@/content/schemas';
import type { TownEntry } from '@/lib/content';
import { resolveSiteImage } from '@/lib/images';

interface Props {
  town: TownConfig;
  places: TownEntry<'places'>[];
}

const { town, places } = Astro.props;
type Place = TownEntry<'places'>;
const withPhoto = places.filter((p) => !!p.data.image);
const best = (types: readonly string[]) => [...withPhoto.filter((p) => types.includes(p.data.type))].sort((a, b) => Number(!!b.data.featured) - Number(!!a.data.featured))[0];
const hero = resolveSiteImage(town.slug, town.hero.image);
const photo = (p: Place | undefined) => (p?.data.image ? { src: p.data.image, alt: p.data.imageAlt ?? '' } : { src: hero, alt: town.hero.alt });
const tiles = [
  { label: 'Eat & drink', href: '/eat-drink/', ...photo(best([...EAT_DRINK_TYPES, 'shop'])) },
  { label: 'Things to do', href: '/things-to-do/', ...photo(best(LAND_TYPES)) },
  town.livingHere
    ? { label: 'Living here', href: '/living-here/', ...photo(best(['venue'])) }
    : { label: 'Moving here', href: '/moving-here/', ...photo(best(['venue'])) },
];
---
<section class="band-compact band-white" aria-labelledby="next-stop">
  <div class="container-page">
    <h2 id="next-stop" class="display-md text-[2rem] md:text-[2.5rem]">Find your next stop</h2>
    <ul class="mt-5 grid grid-cols-3 gap-2 sm:gap-4 md:gap-6">
      {tiles.map((t) => (
        <li>
          <a href={t.href} class="group relative isolate block aspect-square overflow-hidden rounded-lg bg-primary no-underline sm:aspect-[4/3]">
            <Image src={t.src} alt={t.alt} width={720} height={720} class="absolute inset-0 -z-20 h-full! w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]" />
            <span class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgba(0,0,0,0.8)_0%,rgba(0,0,0,0.35)_45%,transparent_100%)]" aria-hidden="true"></span>
            <span class="absolute inset-x-0 bottom-0 p-2.5 text-[0.9375rem] font-semibold leading-tight text-white sm:p-4 sm:text-xl md:p-5 md:text-2xl">{t.label} <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
