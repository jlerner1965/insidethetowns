---
/**
 * What's happening (the homepage redesign brief, 27 October 2026): three
 * tabs, Today, Tomorrow and This weekend, up to five listings each, one
 * row a listing, the school's games among them as on the events page. It
 * replaced the seven-day agenda, which put forty rows on a phone before
 * the email.
 *
 * The rows come from src/lib/home-tabs.ts over the same `weekDays` reading
 * the Thursday email and the events page use. The tab that opens is Today,
 * or This weekend from Friday to Sunday; the page is built once and read
 * for days, so a few lines of script choose the tab again by the reader's
 * own day, and the browser's pruning (src/lib/expiry.ts) takes a row off
 * once its day is over, the "Nothing listed" line standing in. An empty
 * tab keeps its tab: a Tuesday with nothing on is a fact about this guide.
 *
 * Under the empty line, "Next in <Town>": up to three listings after the
 * tab's days (src/lib/home-tabs.ts, `next`). It is in every panel and shown
 * by the stylesheet only while the empty line is, so it appears whether the
 * tab was built empty or emptied in the browser after the build (Niwot, 31
 * October 2026: the day's one event ended at 2 pm and all three tabs went
 * blank). Its rows carry the same marks and come off the same way; the
 * block goes once none are left.
 *
 * Native buttons with the tab roles, so the keyboard and a screen reader
 * get the three as one control; with no script the opening tab is shown
 * and the other two are reached from the links under the list.
 *
 * "Don't miss" (the owner, 7 November 2026, after comparing niwot.com): the
 * next featured listing within three weeks (src/lib/home-tabs.ts,
 * dontMiss), as a card with a photograph, beside the list on a wide screen
 * and above the tabs on a phone, where it is a short row. It carries the
 * listing's own marks, so it comes off the page when the listing does, and
 * the block with it. Without one the list keeps a reading width rather than
 * the page's: the venue sits under the title at every width now, where on a
 * desktop it had been 800px to the right of it.
 *
 * A listing's title is a link and reads as one: the guide's link colour
 * (the primary), not underlined, as Worth knowing's headlines are (the
 * owner, 9 November 2026; they were ink until hovered). A called-off
 * listing keeps the muted ink beside its Canceled or Postponed label.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { TownConfig } from '@/config';
import type { HomeTab, TabKey } from '@/lib/home-tabs';
import { formatDate, toIsoLocal } from '@/lib/dates';

/** The "Don't miss" card's facts, from the listing (src/components/home/TownHome.astro). */
export interface Feature {
  title: string;
  href: string;
  /** "Fri, Nov 27 · 6 pm – 9 pm" */
  when: string;
  /** The venue and the cost. */
  where: string;
  /** The listing's first sentence, shown where the card has room. */
  blurb?: string;
  image: ImageMetadata;
  alt: string;
  eventDay: string;
  end?: string;
}

interface Props {
  town: TownConfig;
  tabs: HomeTab[];
  open: TabKey;
  feature?: Feature;
}

const { town, tabs, open, feature } = Astro.props;
// One line of trust on the first screen (the reader pass, 1 November 2026:
// "independent", "free" and "checked" were all in the footer): the build's
// date, since the page is rebuilt nightly and on every push.
const refreshed = new Date();
const label = (status: 'canceled' | 'postponed') => (status === 'canceled' ? 'Canceled' : 'Postponed');
// The venue: its own line on a phone, and on a wider screen the rest of the
// title's line after a dot, so it is read with the title rather than 800px
// to the right of it.
const where = "block text-[0.9375rem] text-ink-muted sm:inline sm:before:mx-2 sm:before:content-['·']";
---
<section class="band-close band-white" aria-labelledby="happening" data-pagefind-ignore>
  <div class="container-page">
    <h2 id="happening" class="display-md text-[2rem] md:text-[2.5rem]">What’s happening in {town.name}</h2>
    <p class="mt-2 text-[0.9375rem] text-ink-muted">
      Every listing checked against its source · refreshed <time datetime={toIsoLocal(refreshed)}>{formatDate(refreshed)}</time>
    </p>
    <div class:list={['mt-5', feature ? 'lg:grid lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start lg:gap-x-12 xl:grid-cols-[minmax(0,1fr)_23rem]' : 'max-w-3xl']}>
    {feature && (
      <aside aria-labelledby="dont-miss" data-hide-when-empty class="mb-6 lg:col-start-2 lg:row-start-1 lg:mb-0">
        <a href={feature.href} data-event-day={feature.eventDay} data-end={feature.end} class="group grid grid-cols-[6.5rem_minmax(0,1fr)] items-stretch gap-x-4 overflow-hidden rounded-lg bg-raised no-underline ring-1 ring-line-soft hover:ring-primary-line sm:grid-cols-[10rem_minmax(0,1fr)] lg:block" data-track="dont-miss">
          <Image src={feature.image} alt={feature.alt} width={720} height={405} loading="eager" class="h-full min-h-28 w-full object-cover lg:aspect-[16/9] lg:h-auto lg:min-h-0" />
          <div class="py-3 pr-3 lg:px-5 lg:py-4">
            <p id="dont-miss" class="eyebrow text-primary">Don’t miss</p>
            <p class="mt-1 text-[0.875rem] font-semibold leading-snug text-ink">{feature.when}</p>
            <h3 class="display-md mt-1 text-[1.25rem] leading-tight text-ink group-hover:text-primary lg:text-[1.5rem]">{feature.title}</h3>
            {feature.where && <p class="mt-1 text-[0.9375rem] leading-snug text-ink-muted">{feature.where}</p>}
            {feature.blurb && <p class="mt-2 hidden text-[0.9375rem] leading-snug text-ink lg:line-clamp-3">{feature.blurb}</p>}
            <p class="mt-2 hidden text-[0.9375rem] font-semibold text-primary underline lg:block">The details →</p>
          </div>
        </a>
      </aside>
    )}
    <div class="min-w-0 lg:col-start-1 lg:row-start-1">
    <div role="tablist" aria-label="When" class="flex gap-x-1 border-b border-line-soft" data-home-tabs>
      {tabs.map((t) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.key}`}
          aria-selected={t.key === open ? 'true' : 'false'}
          aria-controls={`panel-${t.key}`}
          tabindex={t.key === open ? 0 : -1}
          data-tab={t.key}
          class="-mb-px inline-flex min-h-11 items-center border-b-2 border-transparent px-3 text-[0.9375rem] font-semibold text-ink-muted hover:text-ink aria-selected:border-primary aria-selected:text-ink first:pl-0"
        >{t.label}</button>
      ))}
    </div>
    {tabs.map((t) => (
      <div role="tabpanel" id={`panel-${t.key}`} aria-labelledby={`tab-${t.key}`} hidden={t.key !== open} tabindex="0">
        {/* Above the day's listings on the Today tab, where the home passes one: "Today at the rec center" (RecCenterToday). */}
        {t.key === 'today' && Astro.slots.has('today') && (
          <div class="mt-4 border-b border-line-soft pb-3"><slot name="today" /></div>
        )}
        <div data-events-scope>
        {t.rows.length > 0 && (
          <ol class="divide-y divide-line-soft">
            {t.rows.map((row) => (
              <li class="grid grid-cols-[5.75rem_minmax(0,1fr)] gap-x-3 py-3 sm:grid-cols-[7rem_minmax(0,1fr)] sm:items-baseline sm:gap-x-4" data-event-day={row.eventDay} data-end={row.end}>
                <span class="text-[0.875rem] font-semibold leading-snug tabular-nums text-ink">{row.dayWord && `${row.dayWord} `}{row.when}</span>
                <p class="min-w-0 text-[1.0625rem] leading-snug">
                  <a href={row.href} class:list={['font-medium no-underline hover:underline', row.status ? 'text-ink-muted hover:text-primary' : 'text-primary']}>{row.title}</a>
                  {row.status && <span class="ml-2 inline-block rounded-sm border border-line px-1.5 py-px align-[0.1em] text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-ink">{label(row.status)}</span>}
                  {row.pick && !row.status && <span class="ml-2 inline-block rounded-sm bg-highlight-soft px-1.5 py-px align-[0.1em] text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-ink ring-1 ring-highlight">Our pick</span>}
                  {row.where && <span class={where}>{row.where}</span>}
                </p>
              </li>
            ))}
          </ol>
        )}
        <p data-events-empty hidden={t.rows.length > 0} class="py-3 text-[1.0625rem] text-ink-muted">{t.empty}</p>
        {t.more > 0 && (
          <p class="mt-1 text-[0.9375rem]"><a href={t.href} class="inline-block -my-3 py-3 font-semibold text-primary underline">{t.more} more {t.key === 'weekend' ? 'this weekend' : t.key === 'today' ? 'today' : 'tomorrow'} →</a></p>
        )}
        </div>
        {t.next.length > 0 && (
          <div data-next-up data-hide-when-empty class="pb-1">
            <h3 class="text-[0.9375rem] font-semibold text-ink">Next in {town.name}</h3>
            <ol class="divide-y divide-line-soft">
              {t.next.map((row) => (
                <li class="grid grid-cols-[5.75rem_minmax(0,1fr)] gap-x-3 py-3 sm:grid-cols-[7rem_minmax(0,1fr)] sm:items-baseline sm:gap-x-4" data-event-day={row.eventDay} data-end={row.end}>
                  <span class="text-[0.875rem] font-semibold leading-snug tabular-nums text-ink"><span class="block">{row.dayWord}</span>{row.when}</span>
                  <p class="min-w-0 text-[1.0625rem] leading-snug">
                    <a href={row.href} class="font-medium text-primary no-underline hover:underline">{row.title}</a>
                    {row.pick && <span class="ml-2 inline-block rounded-sm bg-highlight-soft px-1.5 py-px align-[0.1em] text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-ink ring-1 ring-highlight">Our pick</span>}
                    {row.where && <span class={where}>{row.where}</span>}
                  </p>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>
    ))}
    <p class="mt-5 flex flex-wrap items-baseline gap-x-6 gap-y-1 border-t border-line-soft pt-4 text-[1.0625rem]">
      <a href="/events/" class="inline-block -my-3 py-3 font-semibold text-primary underline">All events →</a>
      <a href="/submit-event/" class="inline-block -my-3 py-3 text-primary underline">Add an event</a>
    </p>
    </div>
    </div>
  </div>
</section>

<style is:global>
  /* "Next in <Town>" only while its tab says "Nothing listed": the empty
     line's `hidden` is set at build and cleared by the browser's pruning,
     so one rule covers both. */
  [data-next-up] { display: none; }
  [data-events-scope]:has(> [data-events-empty]:not([hidden])) + [data-next-up] { display: block; }
</style>

<script>
  // The three tabs, and the one that opens: Today, or This weekend on a
  // Friday, Saturday or Sunday in Denver, or Tomorrow from five on the
  // Sunday afternoon, by the reader's own clock rather than the build's
  // (src/lib/home-tabs.ts, defaultTab and WEEKEND_OVER_HOUR).
  for (const list of document.querySelectorAll<HTMLElement>('[data-home-tabs]')) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const show = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => show(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length]!;
        next.focus();
        show(next);
      });
    });
    const now = new Date();
    const day = now.toLocaleDateString('en-US', { timeZone: 'America/Denver', weekday: 'short' });
    const hour = Number(now.toLocaleString('en-US', { timeZone: 'America/Denver', hour: 'numeric', hourCycle: 'h23' }));
    const key = /^Sun/.test(day) && hour >= 17 ? 'tomorrow' : /^(Fri|Sat|Sun)/.test(day) ? 'weekend' : 'today';
    const open = tabs.find((t) => t.dataset.tab === key);
    if (open && open.getAttribute('aria-selected') !== 'true') show(open);
  }
</script>
