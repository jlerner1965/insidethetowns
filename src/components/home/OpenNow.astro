---
/**
 * "Open now": the places with a photograph and hours this site can read,
 * as cards with an open-or-closed line. The line is OpenStatus.astro's,
 * written in the browser from the listing's hours, because a page built
 * at dawn cannot say what is open at nine; a listing whose hours the
 * parser cannot read has no line at all, never a guess. One row that
 * scrolls sideways on a phone, four across on a desktop.
 */
import { Image } from 'astro:assets';
import OpenStatus from '@/components/OpenStatus.astro';
import type { TownEntry } from '@/lib/content';
import { openingHoursOf } from '@/lib/hours';
import { shorten } from '@/lib/text';

interface Props {
  /** The open places (src/lib/places isOpen), the picked ones first. */
  places: TownEntry<'places'>[];
  class?: string;
}

const { places, class: className } = Astro.props;
const withHours = places.map((p) => ({ place: p, spec: openingHoursOf(p.data) })).filter((x): x is { place: TownEntry<'places'>; spec: string[] } => !!x.spec && !!x.place.data.image);
const cards = withHours.slice(0, 4);
---
{cards.length > 0 && (
  <section class={className} aria-labelledby="open-now">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="open-now" class="display-md text-[1.75rem] md:text-[2rem]">Open now</h2>
      <a href="/directory/" class="inline-block -my-2 shrink-0 py-2 text-[0.9375rem] font-semibold text-primary underline">All {places.length} places →</a>
    </div>
    <ul class="pill-row mt-4 flex snap-x gap-3 lg:mx-0 lg:grid lg:grid-cols-4 lg:overflow-visible lg:px-0">
      {cards.map(({ place, spec }) => (
        <li class="w-[72%] shrink-0 snap-start sm:w-[45%] lg:w-auto" data-hours={JSON.stringify(spec)}>
          <a href={`/places/${place.slug}/`} class="flex h-full flex-col overflow-hidden rounded-lg bg-raised no-underline ring-1 ring-line-soft hover:ring-primary-line">
            <div class="aspect-[16/10] bg-accent-soft">
              <Image src={place.data.image!} alt={place.data.imageAlt ?? ''} widths={[320, 480, 640]} sizes="(min-width: 1024px) 22vw, 70vw" class="h-full! w-full object-cover" />
            </div>
            <span class="flex flex-1 flex-col p-4">
              <span class="font-semibold leading-snug">{place.data.title}</span>
              <span class="open-status mt-1 text-[0.875rem] font-semibold" data-open-status hidden></span>
              {place.data.summary && <span class="mt-1 text-[0.875rem] leading-snug text-ink-muted">{shorten(place.data.summary, 64)}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
    <OpenStatus />
  </section>
)}
