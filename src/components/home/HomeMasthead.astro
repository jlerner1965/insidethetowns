---
/**
 * The flagship home page's masthead, on the band the header begins: the
 * scoreboard on the left, Next up and the week's line on the right (the
 * homepage brief, 25 October 2026).
 *
 * - The scoreboard is the latest final in the last eight days, football's
 *   first (src/lib/flagship-home.ts, scoreboardResult): the two sides, the
 *   score, the losing side dimmed, the season's record, and a link to every
 *   score. With no final in that window the next game is set large in its
 *   place; with no school, or no data for it, there is no left column and
 *   the right one runs the width of the band.
 * - Next up is the next game after anything the left column shows, its day
 *   and time as the heading; on a guide without a school, the next listing
 *   on the calendar.
 * - The week's line is the weekly notes' `headline`, only from this week's
 *   file; the Checked line is when the scores were read (the sports file's
 *   `generated`), or, without them, the latest check of the week's listings.
 *
 * Every word comes from the data. "Today" is never written: a page can be
 * older than the day it was built, so the heading names the weekday.
 */
import { formatDayLong, formatMonthDay, formatTime } from '@/lib/dates';
import { clock, dashed, gameHeading, siteWord } from '@/lib/flagship-home';
import { gameDay, where, type TeamGame } from '@/lib/school-sports';

interface Props {
  title: string;
  mascot?: string;
  teamName?: string;
  /** The final the scoreboard shows. */
  result?: TeamGame;
  /** With no final: the game set large instead. */
  lead?: TeamGame;
  /** The next game after `lead`. */
  next?: TeamGame;
  /** On a guide without a school: the next listing. */
  nextEvent?: { title: string; start: Date; allDay: boolean; venue?: string; href: string };
  /** The team page a game links to. */
  teamHref: (key: string) => string;
  /** The guide's address, for the shared result's link. */
  origin: string;
  weekOf?: Date;
  headline?: string;
  checked?: { at: Date; withTime: boolean };
}

const { title, mascot, teamName, result, lead, next, nextEvent, teamHref, origin, weekOf, headline, checked } = Astro.props;
const left = result ?? lead;
// "At Mountain View", "Home", the venue of a neutral game.
const placeLine = (g: TeamGame['game']) => (g.venue ? g.venue : g.site === 'home' && !g.neutral ? 'Home' : g.site === 'away' && !g.neutral ? `At ${g.opponent}` : 'Neutral site');
const lost = (side: 'us' | 'them') => !!result?.game.result && result.game.result !== 'T' && (side === 'us' ? result.game.result === 'L' : result.game.result === 'W');
const shareText = result?.game.score
  ? `${teamName} ${result.game.score.us}, ${result.game.opponent} ${result.game.score.them}. Final, ${result.team.name.toLowerCase()}, ${formatDayLong(gameDay(result.game))}.`
  : undefined;
const shareUrl = result ? `${origin}${teamHref(result.team.key)}` : undefined;
const nextWeekday = nextEvent ? new Intl.DateTimeFormat('en-US', { timeZone: 'America/Denver', weekday: 'long' }).format(nextEvent.start) : undefined;
---
<section class="fh-band fh-masthead on-dark" aria-labelledby="fh-title">
  <div class="container-page">
    <h1 id="fh-title" class="sr-only">{title}</h1>
    <div class:list={['fh-masthead-grid', !left && 'fh-single']}>
      {result?.game.score && (
        <div>
          <h2 class="eyebrow">{mascot} {result.team.name.toLowerCase()} · Final</h2>
          <p class="fh-when"><time datetime={result.game.date}>{formatDayLong(gameDay(result.game))}</time> · {placeLine(result.game)}</p>
          <div class="fh-board">
            <p class:list={['fh-score-row', lost('us') && 'fh-lost']}>
              <span class="fh-team-name">{teamName}</span>
              <span class="fh-score">{result.game.score.us}</span>
            </p>
            <p class:list={['fh-score-row', lost('them') && 'fh-lost']}>
              <span class="fh-team-name">{result.game.opponent}</span>
              <span class="fh-score">{result.game.score.them}</span>
            </p>
          </div>
          <div class="fh-board-foot">
            {result.team.overall && <span class="fh-pill">{mascot} {dashed(result.team.overall)}</span>}
            <a href="/sports/" class="fh-link">Every score and schedule →</a>
            {shareText && (
              <span>
                <button type="button" class="fh-link fh-share" data-share data-share-text={shareText} data-share-url={shareUrl} hidden>Share →</button>
                <span class="fh-share-status" data-share-status role="status"></span>
              </span>
            )}
          </div>
        </div>
      )}
      {!result && lead && (
        <div>
          <h2 class="eyebrow">{mascot} {lead.team.name.toLowerCase()} · Next up</h2>
          <p class="fh-when"><time datetime={lead.game.date}>{formatDayLong(gameDay(lead.game))}</time> · {placeLine(lead.game)}</p>
          <p class="fh-big">
            <span>{new Intl.DateTimeFormat('en-US', { timeZone: 'America/Denver', weekday: 'short' }).format(gameDay(lead.game))}</span>
            {lead.game.time && <span>{clock(gameDay(lead.game))}</span>}
          </p>
          <p class="fh-next-line">{teamName} {where(lead.game)} {lead.game.opponent}{lead.game.stage && ` · ${lead.game.stage}`}</p>
          <div class="fh-board-foot">
            {lead.team.overall && <span class="fh-pill">{mascot} {dashed(lead.team.overall)}</span>}
            <a href="/sports/" class="fh-link">Every score and schedule →</a>
          </div>
        </div>
      )}

      <div>
        {next && (
          <Fragment>
            <h2 class="eyebrow">Next up · <time datetime={next.game.date}>{formatMonthDay(gameDay(next.game))}</time></h2>
            <p class="fh-next-heading">{gameHeading(next.game)}</p>
            <p class="fh-next-line">
              {next.team.name} {where(next.game)} {next.game.opponent} · {siteWord(next.game)}{next.game.venue && ` · ${next.game.venue}`}{next.game.stage && ` · ${next.game.stage}`}
            </p>
          </Fragment>
        )}
        {!next && nextEvent && (
          <Fragment>
            <h2 class="eyebrow">Next up · <time datetime={nextEvent.start.toISOString()}>{formatMonthDay(nextEvent.start)}</time></h2>
            <p class="fh-next-heading">{nextEvent.allDay ? nextWeekday : `${nextWeekday}, ${clock(nextEvent.start)}`}</p>
            <p class="fh-next-line"><a href={nextEvent.href} class="fh-link">{nextEvent.title}</a>{nextEvent.venue && ` · ${nextEvent.venue}`}</p>
          </Fragment>
        )}
        {headline && weekOf && (
          <Fragment>
            {(next || nextEvent) && <hr class="fh-rule" />}
            <h2 class="eyebrow">The week of {formatMonthDay(weekOf)}</h2>
            <p class="fh-headline">{headline}</p>
          </Fragment>
        )}
        {checked && (
          <p class="fh-checked">
            <span class="fh-dot" aria-hidden="true"></span>
            <span>Checked <time datetime={checked.at.toISOString()}>{formatDayLong(checked.at)}{checked.withTime && `, ${formatTime(checked.at)}`}</time></span>
          </p>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  // Share the final: the phone's own sheet where there is one, else the
  // words and the link onto the clipboard. Shown only once this has run,
  // so a page without the script has no button that does nothing.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-share]')) {
    const status = button.parentElement?.querySelector<HTMLElement>('[data-share-status]');
    const text = button.dataset.shareText ?? '';
    const url = button.dataset.shareUrl ?? location.href;
    if (!navigator.share && !navigator.clipboard) continue;
    button.hidden = false;
    button.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({ text, url });
        } catch {
          // Closed without sharing: nothing to say.
        }
        return;
      }
      try {
        await navigator.clipboard.writeText(`${text} ${url}`);
        if (status) status.textContent = ' Copied';
      } catch {
        if (status) status.textContent = ' Could not copy';
      }
    });
  }
</script>
