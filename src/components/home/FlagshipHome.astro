---
/**
 * The flagship home page (TownConfig.home). The design is fixed in
 * docs/DESIGN.md (the owner's sign-off of 26 October 2026); a change to it
 * needs the owner and a DECISIONS.md entry, and test/design.test.ts holds
 * the values. Top to bottom, in the audit's order of importance:
 *
 * 1. The town and what the guide is (the intro), on the guide's paper.
 * 2. The scoreboard card (Scorecard.astro): the latest final and the next
 *    game, compact, the school's colour as trim only.
 * 3. This week: our pick, then an agenda of the next seven days in the
 *    order of the clock (src/lib/flagship-home.ts, weekDays), beside the
 *    card on a desktop and in the first screen on a phone.
 * 4. Worth knowing: the local changes and the sign-up dates in the next
 *    fourteen days; left off the page when there are none.
 * 5. The school's teams in season, as a list, no score repeated from the card.
 * 6. The guide's routes, with the town's licensed photograph.
 * 7. The closing band, the page's one full-colour moment: the email.
 *
 * Every date, score, opponent and count is the data's; an empty section is
 * left off rather than announced, except the week, which says how to add to it.
 */
import { Image } from 'astro:assets';
import '@fontsource-variable/fraunces/opsz-italic.css';
import './flagship-home.css';
import Scorecard from './Scorecard.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import { editionFor, emailEditions, getNetworkHub, type TownConfig } from '@/config';
import { schoolSportsFor, sportsPath, teamPath, type SportsData } from '@/config/school-sports';
import { schoolTheme } from '@/config/school-colors';
import { EAT_DRINK_TYPES } from '@/content/schemas';
import { getCollection } from 'astro:content';
import { getTownEntries } from '@/lib/content';
import { formatDate, formatDayLong, formatDayRange, formatMonthDay, toIsoLocal } from '@/lib/dates';
import { isCanceled, lastDay, listedUntil, occurrences } from '@/lib/events';
import { clock, leadGame, nextGame, resultSentence, scoreboardResult, siteWord, teamRows, weekDays } from '@/lib/flagship-home';
import { resolveSiteImage } from '@/lib/images';
import { SOON_DAYS, deadlineTitle, onePerProgram, upcomingDeadlines } from '@/lib/programs';
import { gameDay, hasData, sportsDataFor, where } from '@/lib/school-sports';
import { currentUpdates } from '@/lib/updates';
import { briefingUpdates, currentNotes, currentPick, weekWindow } from '@/lib/weekly';

interface Props {
  town: TownConfig;
}

const { town } = Astro.props;
const now = new Date();
const hub = getNetworkHub();

// The school, its data and its colours. A guide with no school, or one
// whose file has never been written, has no card; the closing band is the
// guide's own primary.
const school = schoolSportsFor(town.slug);
const files = import.meta.glob<SportsData>('../../../data/*/sports*.json', { eager: true, import: 'default' });
const data = school ? sportsDataFor(school, files) : undefined;
const theme = town.school && school ? schoolTheme(town.school) : undefined;
const schoolVars = [
  `--fh-band:${theme?.band ?? town.colors.primary}`,
  `--fh-ink:${theme?.ink ?? town.colors.primary}`,
  `--fh-rule:${theme?.rule ?? town.colors.primary}`,
  `--fh-eyebrow:${theme?.eyebrow ?? '#ffffff'}`,
  `--fh-pill:${theme?.pill.fill ?? '#ffffff'}`,
  `--fh-pill-ink:${theme?.pill.text ?? 'var(--color-ink)'}`,
].join(';');
const mascot = town.school?.mascot ?? school?.mascot;
const teamName = town.school?.teamName;
const teamHref = (key: string) => {
  const team = data?.sports.find((t) => t.key === key);
  return school && team && hasData(team) ? teamPath(school, key) : '/sports/';
};

// 2. The card.
const result = data ? scoreboardResult(data, now) : undefined;
const lead = data && !result ? leadGame(data, now) : undefined;
const next = data ? nextGame(data, now, lead) : undefined;
const hasCard = !!(result || lead);
const allEvents = await getTownEntries('events');
const calendar = occurrences(allEvents, { now, horizonDays: 30 });
const checked = data?.generated ? { at: new Date(data.generated), withTime: true } : undefined;

// 1. The intro: the week's line from this week's notes only.
const weeklyEntries = await getTownEntries('weekly');
const notes = currentNotes(weeklyEntries, now);
const thisWeeks = notes && notes.data.weekOf.getTime() === weekWindow(now).monday.getTime() ? notes.data : undefined;
const headline = thisWeeks?.headline;

// 3. This week: the pick, then seven days from today in the order of the clock.
const pick = currentPick(weeklyEntries, calendar.filter((e) => !isCanceled(e)), now);
const picked = pick.thisWeek ?? pick.comingUp;
const pickKey = picked ? `${picked.event.slug}@${picked.event.data.start.getTime()}` : undefined;
const days = weekDays({
  events: occurrences(allEvents, { now, horizonDays: 8 }).filter((e) => `${e.slug}@${e.data.start.getTime()}` !== pickKey),
  sports: data,
  teamHref,
  now,
  from: 'today',
  limit: 3,
});
const shown = days.filter((d) => d.items.length > 0);
const quiet = days.filter((d) => d.items.length === 0);
const weekday = (d: Date) => new Intl.DateTimeFormat('en-US', { timeZone: 'America/Denver', weekday: 'short' }).format(d);
const dayNum = (d: Date) => new Intl.DateTimeFormat('en-US', { timeZone: 'America/Denver', day: 'numeric' }).format(d);
const pickWhen = picked
  ? `${formatDayLong(picked.event.data.start)}${picked.event.data.allDay ? '' : `, ${clock(picked.event.data.start)}`}${picked.event.data.venue ? ` · ${picked.event.data.venue}` : ''}`
  : undefined;

// The email, promoted on its own: the day, the hour, and the latest issue
// sent to this town, only where one exists.
const edition = editionFor(town.slug, emailEditions());
const sendDay = hub.newsletter?.sendDay ?? 'Thursday';
const sendTime = hub.newsletter?.sendTime;
const emailOn = !!hub.newsletter && !!edition;
const issues = emailOn ? await getCollection('issues', (e) => e.id.startsWith('hub/')) : [];
const latestIssue = issues
  .filter((i) => (i.data as { towns?: string[] }).towns?.includes(town.slug))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];
const issueHref = latestIssue ? `https://${hub.domain}/newsletter/${(latestIssue.data as { slug?: string }).slug ?? latestIssue.id.replace(/^hub\//, '')}/` : undefined;

// 4. Worth knowing: the week's local changes, newest first, and sign-up
// dates in the next fourteen days. A heading that counts nothing.
const updates = await getTownEntries('updates');
const know = briefingUpdates(currentUpdates(updates, now), now)
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime() || b.data.effective.getTime() - a.data.effective.getTime())
  .slice(0, 3);
const programs = town.families ? await getTownEntries('programs') : [];
const deadlines = onePerProgram(upcomingDeadlines(programs, { now, days: SOON_DAYS })).slice(0, 3);
const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');
const knowTitle = thisWeeks?.knowTitle ?? `Worth knowing in ${town.name}`;

// 5. The school's teams in season.
const rows = data ? teamRows(data, now) : [];
const scheduleNote = school && data
  ? `Schedules and scores from MaxPreps${school.calendar ? `, cross-checked against ${school.calendar.label}` : ''}. Checked ${formatDate(new Date(data.generated))}.`
  : undefined;

// 6. The guide's routes: families, food, things to do, taking part, town services.
const places = (await getTownEntries('places')).filter((p) => !p.delisted && (EAT_DRINK_TYPES.includes(p.data.type) || p.data.type === 'shop'));
const strip = (line: string) => line.replace(/\.\s*$/, '');
const tiles = [
  ...(town.families ? [{ href: '/families/', eyebrow: 'For families', title: town.families.label, line: strip(town.families.intro) }] : []),
  { href: '/eat-drink/', eyebrow: 'Places', title: 'Eat & drink', line: `${places.length} places, with what’s open right now` },
  { href: '/things-to-do/', eyebrow: 'Out and about', title: 'Things to do', line: `Trails, parks and places worth an afternoon in and around ${town.name}` },
  ...(town.participation ? [{ href: '/get-involved/', eyebrow: 'Taking part', title: town.participation.label, line: strip(town.participation.intro) }] : []),
  ...(town.livingHere ? [{ href: '/living-here/', eyebrow: 'Town services', title: 'Living here', line: strip(town.livingHere.intro) }] : []),
];
// The town's own photograph, the config's hero, licensed in
// IMAGE_LICENSES.csv; its credit under it where the config gives one.
const photo = resolveSiteImage(town.slug, town.hero.image);
---
<div class="fh" style={schoolVars}>
  <section class="fh-top" aria-labelledby="fh-title">
    <div class="container-page fh-top-grid" data-has-card={hasCard ? '' : undefined}>
      <div class="fh-intro">
        <h1 id="fh-title" class="fh-title">This week in {town.name}</h1>
        <p class="fh-purpose">{town.tagline}</p>
        {headline && <p class="fh-headline">{headline}</p>}
      </div>

      {hasCard && (
        <div class="fh-card-slot">
          <Scorecard mascot={mascot} teamName={teamName} result={result} lead={lead} next={next} teamHref={teamHref} origin={`https://${town.domain}`} checked={checked} />
        </div>
      )}

      <section class="fh-week" aria-labelledby="fh-week" data-events-scope>
        <div class="fh-week-head">
          <h2 id="fh-week" class="fh-h2">This week</h2>
          <p class="fh-week-range">{formatDayRange(days[0]!.date, days[6]!.date)}</p>
          <a href="/events/" class="fh-link fh-week-all">Every event →</a>
        </div>

        {picked && pickWhen && (
          <a href={`/events/${picked.event.slug}/`} class="fh-pick" data-event-day={lastDay(picked.event)} data-end={toIsoLocal(listedUntil(picked.event))}>
            <span class="fh-pick-tag">Our pick</span>
            <span class="fh-pick-title">{picked.title}</span>
            <span class="fh-pick-when">{pickWhen}</span>
          </a>
        )}

        {shown.length > 0 && (
          <ol class="fh-agenda">
            {shown.map((day) => (
              <li class="fh-agenda-day" data-day={day.key}>
                <h3 class="fh-agenda-date">
                  <span class="fh-agenda-wd" aria-hidden="true">{weekday(day.date)}</span>
                  <span class="fh-agenda-num" aria-hidden="true">{dayNum(day.date)}</span>
                  <span class="sr-only">{formatDayLong(day.date)}</span>
                </h3>
                <ul class="fh-agenda-items">
                  {day.items.map((item) => (
                    <li data-event-day={item.eventDay} data-end={item.end}>
                      <a href={item.href} class="fh-agenda-item" title={item.title !== item.fullTitle ? item.fullTitle : undefined}>
                        <span class="fh-agenda-time">{item.when}</span>
                        <span class="fh-agenda-body">
                          <span class="fh-agenda-title"><span class="fh-agenda-dot" style={`background:${item.dot}`} aria-hidden="true"></span>{item.title}</span>
                          {(item.where || item.site) && (
                            <span class="fh-agenda-where">
                              {item.where}
                              {item.site && <span class:list={['fh-site', item.site === 'Home' ? 'fh-site-home' : 'fh-site-away']}>{item.site}</span>}
                            </span>
                          )}
                        </span>
                      </a>
                    </li>
                  ))}
                  {day.more > 0 && (
                    <li class="fh-agenda-more"><a href={`/events/#day-${day.key}`} class="fh-link">{day.more} more on {formatDayLong(day.date).split(',')[0]} →</a></li>
                  )}
                </ul>
              </li>
            ))}
          </ol>
        )}
        <p class="fh-week-empty" data-events-empty hidden={shown.length > 0 || !!picked}>
          Nothing listed for the next seven days yet.
          <a href="/submit-event/" class="fh-link">Add an event</a>
          <a href="/events/" class="fh-link">See what’s further out →</a>
        </p>
        {shown.length > 0 && quiet.length > 0 && (
          <p class="fh-week-quiet">Nothing listed yet on {quiet.map((d) => weekday(d.date)).join(', ')}. <a href="/submit-event/" class="fh-link">Add an event</a></p>
        )}
      </section>

      {emailOn && (
        <aside class="fh-email" aria-labelledby="fh-email-title">
          <p class="fh-eyebrow">The {sendDay} email</p>
          <h2 id="fh-email-title" class="fh-email-title">Every {sendDay}{sendTime && ` at ${sendTime}`}: the week ahead, the scores, and what opened and closed.</h2>
          <a href="#signup" class="fh-button">Get the {sendDay} email</a>
          {latestIssue && issueHref && (
            <p class="fh-email-latest">Latest issue, {formatMonthDay(latestIssue.data.date)}: <a href={issueHref}>{latestIssue.data.title}</a></p>
          )}
        </aside>
      )}
    </div>
  </section>

  {(know.length > 0 || deadlines.length > 0) && (
    <section class="fh-white fh-section" aria-labelledby="fh-know">
      <div class="container-page">
        <h2 id="fh-know" class="fh-h2">{knowTitle}</h2>
        <div class:list={['fh-know-grid', know.length > 0 && deadlines.length > 0 && 'fh-know-two']}>
          {know.length > 0 && (
            <div>
              <p class="fh-eyebrow">Local changes</p>
              <ul class="fh-know-list">
                {know.map((u) => (
                  <li>
                    <h3 class="fh-know-head">{u.data.title}</h3>
                    <p class="fh-know-line">{u.data.summary}</p>
                    <p class="fh-know-sources">
                      {u.data.source && <a href={u.data.source} rel="noopener">Source: {u.data.sourceLabel ?? host(u.data.source)}</a>}
                      {u.data.alsoSource && <a href={u.data.alsoSource} rel="noopener">{u.data.alsoSourceLabel ?? host(u.data.alsoSource)}</a>}
                    </p>
                  </li>
                ))}
              </ul>
              <a href="/updates/" class="fh-link">Every local change →</a>
            </div>
          )}
          {deadlines.length > 0 && (
            <div>
              <p class="fh-eyebrow">Sign-up dates, next two weeks</p>
              <ul class="fh-know-list">
                {deadlines.map((d) => (
                  <li>
                    <h3 class="fh-know-head fh-know-small">{deadlineTitle(d, formatDayLong(d.on))}</h3>
                    {d.program.data.registration?.url && <p class="fh-know-sources"><a href={d.program.data.registration.url} rel="noopener" data-track="registration">How to sign up: {host(d.program.data.registration.url)}</a></p>}
                  </li>
                ))}
              </ul>
              <a href="/families/" class="fh-link">Everything for families →</a>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {school && data && rows.length > 0 && (
    <section class="fh-paper fh-section" aria-labelledby="fh-school">
      <div class="container-page">
        <div class="fh-section-head">
          <div>
            <p class="fh-eyebrow">{school.school}</p>
            <h2 id="fh-school" class="fh-h2">{mascot ?? school.mascot} sports in season</h2>
          </div>
          <a href={sportsPath(school)} class="fh-link">All teams and schedules →</a>
        </div>
        <ul class="fh-teams">
          {rows.map((row) => {
            // The card already shows this final; the row says what is next instead.
            const lastShown = row.football?.last && result && row.football.last === result.game;
            return (
              <li class="fh-team">
                <h3 class="fh-team-name">{row.team.name}{row.football?.record && <span class="fh-team-record">{row.football.record}</span>}</h3>
                <div class="fh-team-body">
                  {row.football ? (
                    <Fragment>
                      {row.football.last && !lastShown && <p>{resultSentence(row.football.last)}</p>}
                      {row.football.next ? (
                        <p>Next: {where(row.football.next)} {row.football.next.opponent} · <time datetime={row.football.next.date}>{formatDayLong(gameDay(row.football.next))}{row.football.next.time && ` · ${clock(gameDay(row.football.next))}`}</time>{row.football.next.stage && ` · ${row.football.next.stage}`} <span class:list={['fh-site', siteWord(row.football.next) === 'Home' ? 'fh-site-home' : 'fh-site-away']}>{siteWord(row.football.next)}</span></p>
                      ) : (
                        lastShown && <p>No game on the schedule yet.</p>
                      )}
                    </Fragment>
                  ) : (
                    <ul class="fh-matches">
                      {row.games.map((g) => (
                        <li>
                          <span>{where(g)} {g.opponent} · <time datetime={g.time ? `${g.date}T${g.time}` : g.date}>{formatDayLong(gameDay(g))}{g.time && ` · ${clock(gameDay(g))}`}</time>{g.stage && ` · ${g.stage}`}</span>
                          <span class:list={['fh-site', siteWord(g) === 'Home' ? 'fh-site-home' : 'fh-site-away']}>{siteWord(g)}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                <a href={teamHref(row.team.key)} class="fh-link">{row.football ? 'Season →' : 'Schedule →'}</a>
              </li>
            );
          })}
        </ul>
        {scheduleNote && <p class="fh-school-note">{scheduleNote}</p>}
      </div>
    </section>
  )}

  <section class="fh-white fh-section" aria-labelledby="fh-guide">
    <div class="container-page">
      <div class="fh-section-head">
        <div>
          <p class="fh-eyebrow">The guide</p>
          <h2 id="fh-guide" class="fh-h2">Living in {town.name}</h2>
        </div>
      </div>
      <div class="fh-guide-grid">
        <figure class="fh-photo">
          <Image src={photo} alt={town.hero.alt} widths={[480, 800, 1200]} sizes="(min-width: 64rem) 34rem, 100vw" class="fh-photo-img" />
          {town.hero.credit && <figcaption class="fh-photo-credit">Photo: {town.hero.credit}</figcaption>}
        </figure>
        <ul class="fh-tiles">
          {tiles.map((t) => (
            <li>
              <a href={t.href} class="fh-tile">
                <span class="fh-eyebrow">{t.eyebrow}</span>
                <span class="fh-tile-title">{t.title}</span>
                <span class="fh-tile-line">{t.line} →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

</div>

{/* Its own element, last in <main> and dark, so the footer meets it with a
    hairline instead of a strip of paper (global.css). */}
<section id="signup" class="fh fh-band fh-cta on-dark" style={schoolVars} aria-labelledby="fh-cta">
    <div class="container-page fh-cta-grid">
      <div>
        <p class="fh-band-eyebrow">The {sendDay} email</p>
        <h2 id="fh-cta" class="fh-cta-title">Know what’s happening <em>before</em> it happens.</h2>
      </div>
      <div>
        <p class="fh-cta-text">
          Every {sendDay}{sendTime && ` at ${sendTime}`}: the scores, the week ahead, and what opened and closed in {town.name}. Clearly labeled sponsors, and no list sharing.
        </p>
        {emailOn && <NewsletterSignup town={town} id="home-band" variant="band" />}
        {latestIssue && issueHref && (
          <p class="fh-cta-latest">Read the latest issue first: <a href={issueHref}>{latestIssue.data.title}</a></p>
        )}
      </div>
    </div>
  </section>
