---
/**
 * The town home page, one for every guide: a front door, not the whole
 * site (the homepage redesign brief, 27 October 2026). Each section shows
 * two or three things and one link to its page; the page's two jobs are
 * this week's events and the Thursday email. Top to bottom:
 *
 * 1. The photograph, the county, the name and the town's own line (Hero,
 *    compact): a short band on a phone, the type under the picture.
 * 2. The school's strip (SportsBar): the mark, the nickname, the latest
 *    result, the next game and the scores, in the school's colours. A
 *    guide that follows several schools keeps the shared strip; a guide
 *    with no sports data has none.
 * 3. What's happening (WhatsHappening): Today, Tomorrow and This weekend
 *    as tabs, five listings each, the games among them, then All events
 *    and Add an event.
 * 4. The Thursday email (NewsletterSignup, home): the heading, one line,
 *    the field and the button, as one strip in a narrow band (the owner,
 *    7 November 2026: the card took half a desktop screen and most of a
 *    phone's). The page's one form, where the email covers the town.
 * 5. For families, where the config switches it on (`families.onHome`):
 *    up to three lines from the family hub, each with its date, ages and
 *    cost, and one link to /families/ (src/lib/family-home.ts).
 * 6. Find your next stop (NextStop): Eat & drink, Things to do and Living
 *    here (or Moving here) as three photographs, each with a line of what
 *    its page lists; full-width rows on a phone.
 * 7. Worth knowing: the two newest local changes as links, and the rest on
 *    the updates page. Hidden where there are none.
 * 8. The footer every page has (Footer; one block of its own here from 27
 *    October to 9 November 2026).
 *
 * The seven-day agenda, the scoreboard, the changes' summaries and sources,
 * the place cards and the list of eight, the articles, the neighbours'
 * weekend, the grid of links and the closing bands came off the page on
 * 27 October 2026; every one of their pages is still one click away from
 * the menu or the footer. It replaced the design pass of 26 October 2026,
 * which on a phone ran to fourteen screens on Berthoud; this runs to about
 * five.
 *
 * Which of these a guide shows is the config's and the content's: a guide
 * with no school has no strip, one the email does not cover has no form,
 * one with no local changes has no Worth knowing. Every date, score and
 * count is the data's, and an empty tab says so.
 */
import Hero from '@/components/Hero.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import SportsStrip from '@/components/SportsStrip.astro';
import NextStop from './NextStop.astro';
import QuickAnswers from './QuickAnswers.astro';
import SportsBar from './SportsBar.astro';
import WhatsHappening, { type Feature } from './WhatsHappening.astro';
import RecCenterToday from '@/components/RecCenterToday.astro';
import { recCenterFor, type RecCenterData } from '@/lib/rec-center';
import { editionFor, emailEditions, getNetworkHub, getTown } from '@/config';
import { schoolsFor, teamPath, type SportsData } from '@/config/school-sports';
import { getTownEntries } from '@/lib/content';
import { fillTest, forGeneralReaders, occurrences, weeklyTest } from '@/lib/events';
import { familyLines } from '@/lib/family-home';
import { eventItem, weekDays } from '@/lib/flagship-home';
import { defaultTab, DONT_MISS_DAYS, dontMiss, homeTabs, labelGames, laterRows, TAB_DAYS_AHEAD, TAB_LIMIT, tabEditions } from '@/lib/home-tabs';
import { dayKey, formatDayShort, formatTimeRange } from '@/lib/dates';
import { resolveSiteImage } from '@/lib/images';
import { firstSentence } from '@/lib/plain-text';
import { eventDescription } from '@/lib/seo';
import { isOpen } from '@/lib/places';
import { hasData, sportsDataFor } from '@/lib/school-sports';
import { currentUpdates } from '@/lib/updates';
import { currentPick } from '@/lib/weekly';

const town = getTown();
const now = new Date();
const hub = getNetworkHub();

// 2. The school. One school: its strip. Several: the shared one.
const schools = schoolsFor(town.slug);
const files = import.meta.glob<SportsData>('../../../data/*/sports*.json', { eager: true, import: 'default' });
const school = schools.length === 1 ? schools[0] : undefined;
const data = school ? sportsDataFor(school, files) : undefined;
const teamHref = (key: string) => {
  const team = data?.sports.find((t) => t.key === key);
  return school && team && hasData(team) ? teamPath(school, key) : '/sports/';
};

// 4. The email: one form on the page, where the email covers the town.
const emailOn = !!hub.newsletter && !!editionFor(town.slug, emailEditions());

// 3. The week from today, uncapped: the tabs choose their five
// (src/lib/home-tabs.ts), the editor's pick marked.
const allEvents = await getTownEntries('events');
const calendar = occurrences(allEvents, { now, horizonDays: 30 });
const notes = await getTownEntries('weekly');
const { thisWeek: pick } = currentPick(notes, calendar, now);
const picked = new Set(pick ? [pick.event.slug] : []);
// The home is for everyone who opens it: the standing children's programs
// (the storytimes, the kids' clubs; src/lib/events.ts, standingFamilyTest)
// stay on the Families page and the events page, and off the tabs, "Next in
// <Town>" and the Families block here.
const general = (horizonDays: number) => forGeneralReaders(occurrences(allEvents, { now, horizonDays }), allEvents);
// What an empty tab offers next: the listings of the next two months, so a
// quiet guide's next date three weeks out is still found.
// The regulars (trivia, a monthly club, a food truck) are marked, so a tab
// shows them only on a quiet day and "Next in <Town>" ranks them last, once.
const isFill = fillTest(allEvents);
const later = laterRows(general(60), picked, isFill);
// The tabs for today and for each of the next two days, so a page read
// after midnight shows that day's Today, not the build's (src/lib/
// home-tabs.ts, tabEditions). The school's games say whose they are:
// "Niwot volleyball vs …".
const week = general(8 + TAB_DAYS_AHEAD);
const editions = tabEditions((asOf) => {
  const days = weekDays({ events: week, sports: data, teamHref, now: asOf, start: 'today', limit: 99, picked, isSeries: isFill });
  return homeTabs(school ? labelGames(days, school.maxprepsName) : days, asOf, TAB_LIMIT, later);
}, now);
const tabs = editions[0]!.tabs;
const open = defaultTab(now);

// 3a. "Today at the rec center" at the top of the Today tab, for a town with
// a schedule file (data/<town>/rec-center.json; src/lib/rec-center.ts). The
// day is the reader's, worked out in the browser; without script the week's
// table stands in. A town without the file shows nothing, by the data alone.
const recFiles = import.meta.glob<RecCenterData>('../../../data/*/rec-center.json', { eager: true, import: 'default' });
const rec = recCenterFor(recFiles, town.slug);

// A thin day: the tab that opens has fewer than three rows at the build, so
// the signup would follow a near-empty list. The three tiles go first then,
// and the form after them (the reader pass, 1 November 2026: Johnstown's
// phone read "Nothing listed", three library rows, then the email ask).
const THIN = 3;
const thin = (tabs.find((t) => t.key === open)?.rows.length ?? 0) < THIN;

// 6. Worth knowing: the two local changes still current, in currentUpdates'
// order: a featured change first, then the newest. A re-sort by published
// alone sat here and put two routine notices above Berthoud's featured
// election result (flagship audit, 4 November 2026).
const updates = await getTownEntries('updates');
const know = currentUpdates(updates, now).slice(0, 2);

// 5. For families: the hub's three timeliest lines, where the town has them on.
const familyRows = town.families?.onHome
  ? familyLines({ programs: await getTownEntries('programs'), breaks: town.families.breaks, events: general(10), now, isSeries: weeklyTest(allEvents) })
  : [];

// 6. The places with a photograph, for the three tiles; a closed place is not a next stop.
const places = (await getTownEntries('places')).filter(isOpen);

// 3c. The quick answers under the tabs never repeat a link the page has
// (src/components/home/QuickAnswers.astro): the pages linked from the
// families block and Worth knowing, where each is on the page. Not the rec
// line's "Schedule & passes": it is inside the Today tab, which is closed
// from Friday to Sunday, so on the weekend the quick answers' rec center
// link was the page's only one (the owner, 9 November 2026).
const linked = new Set<string>([
  ...(familyRows.length > 0 ? ['/families/'] : []),
  ...(know.length > 0 ? ['/updates/'] : []),
]);
const hasGuides = (await getTownEntries('articles')).length > 0;

// 3b. Don't miss, beside the tabs: the next featured listing within three
// weeks (src/lib/home-tabs.ts), with a photograph: its own, else its venue's
// where the venue is a listed place with one ("Niwot Hall and Downtown
// Niwot" finds Niwot Hall), else none: the town's hero is already at the top
// of the page (the design audit, 10 November 2026).
const heroSrc = resolveSiteImage(town.slug, town.hero.image).src;
const featured = dontMiss(general(DONT_MISS_DAYS + 1), now);
let feature: Feature | undefined;
if (featured) {
  const row = eventItem(featured);
  const { title, start, end, allDay, timeNote, venue, cost, image, imageAlt } = featured.data;
  const spot = places
    .filter((p) => p.data.image && p.data.image.src !== heroSrc && venue.toLowerCase().includes(p.data.title.toLowerCase()))
    .sort((a, b) => b.data.title.length - a.data.title.length)[0];
  feature = {
    title,
    href: row.href,
    when: `${formatDayShort(start)} · ${timeNote ?? formatTimeRange(start, end && dayKey(end) === dayKey(start) ? end : undefined, allDay)}`,
    where: [venue, cost].filter(Boolean).join(' · '),
    blurb: firstSentence(eventDescription(featured.body) ?? '') || undefined,
    image: image ?? spot?.data.image,
    alt: image ? (imageAlt ?? '') : (spot?.data.imageAlt ?? ''),
    eventDay: row.eventDay,
    end: row.end,
  };
}
---
<Hero compact pick={!!pick} changes={know.length > 0} />

{school && <SportsBar town={town} />}

<WhatsHappening town={town} editions={editions} open={open} feature={feature}>
  {rec && <RecCenterToday slot="today" data={rec} fallback href={`/places/${rec.place}/`} />}
</WhatsHappening>

<QuickAnswers town={town} recPlace={rec?.place} hasUpdates={updates.length > 0} {hasGuides} hasPlaces={places.length > 0} {linked} />

{/* A guide that follows several schools: the week's games, under the
    events (the owner, 10 November 2026). Above them, Loveland's four
    schools filled the first screen and no event was on it. */}
{!school && schools.length > 1 && (
  <section class="band-compact band-paper">
    <div class="container-page"><SportsStrip town={town.slug} class="max-w-3xl" limit={2} /></div>
  </section>
)}

{emailOn && !thin && (
  <section class="band-paper py-4 md:py-6">
    <div class="container-page">
      <NewsletterSignup town={town} id="home" variant="home" anchor="signup" />
    </div>
  </section>
)}

{familyRows.length > 0 && (
  <section class="band-compact band-paper" aria-labelledby="families-home" data-hide-when-empty>
    <div class="container-page">
      <h2 id="families-home" class="display-md text-[2rem] md:text-[2.5rem]">For families</h2>
      <ul class="mt-3 divide-y divide-line-soft">
        {familyRows.map((r) => (
          <li class="py-3" data-event-day={r.day} data-end={r.end}>
            <p class="text-[0.9375rem] font-semibold text-ink-muted">{r.when}</p>
            <p class="text-[1.0625rem] leading-snug"><a href={r.href} class="font-medium no-underline hover:text-primary hover:underline" data-track="family-home">{r.title}</a></p>
            {r.facts.length > 0 && <p class="mt-0.5 text-[0.9375rem] leading-snug text-ink-muted">{r.facts.join(' · ')}</p>}
          </li>
        ))}
      </ul>
      <p class="mt-3 text-[1.0625rem]"><a href="/families/" class="inline-block -my-3 py-3 font-semibold text-primary underline">Everything for families →</a></p>
    </div>
  </section>
)}

<NextStop town={town} places={places} />

{emailOn && thin && (
  <section class="band-paper py-4 md:py-6">
    <div class="container-page">
      <NewsletterSignup town={town} id="home" variant="home" anchor="signup" />
    </div>
  </section>
)}

{know.length > 0 && (
  <section class="band-compact band-paper" aria-labelledby="know">
    <div class="container-page">
      <h2 id="know" class="display-md text-[2rem] md:text-[2.5rem]">Worth knowing</h2>
      <ul class="mt-3 divide-y divide-line-soft">
        {know.map((u) => (
          <li class="py-3 text-[1.0625rem] leading-snug"><a href={`/updates/#${u.slug}`} class="font-medium text-primary no-underline hover:underline">{u.data.title}</a></li>
        ))}
      </ul>
      <p class="mt-3 text-[1.0625rem]"><a href="/updates/" class="inline-block -my-3 py-3 font-semibold text-primary underline">Every local change →</a></p>
    </div>
  </section>
)}
