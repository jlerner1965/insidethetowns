---
/**
 * The town home page, one for every guide (design pass, 26 October 2026).
 * It replaced two: the classic page (hero, the week with the games beside
 * it, places, articles, the guide's map of itself, the email, a moving-here
 * band) and the flagship page of the 25 October brief (a scoreboard the
 * size of the screen on the school's band, the week in seven columns, the
 * email twice). Top to bottom:
 *
 * 1. The photograph, the county, the name, the town's own line and three
 *    ways in (Hero), sized by what is in it.
 * 2. The scoreboard in brief, on the school's band, for a guide that
 *    follows one school (Scoreboard); the shared strip for one that follows
 *    several.
 * 3. The week as an agenda, seven days from today (WeekAgenda), the games
 *    among the listings and the editor's pick marked.
 * 4. Things to know, the week's local changes with their sources, beside
 *    the email's card: the page's one form, for this town alone, where the
 *    email covers the town. A guide with neither skips the band.
 * 5. Where to go: the places with photographs as cards, the rest as rows.
 * 6. From the guide: the latest two articles.
 * 7. What the guide covers: one line a page, the resident hubs included.
 * 8. The close: for a resident guide (`home` in the config) the ways a
 *    resident takes part; for every other, moving here.
 *
 * Which of these a guide shows is the config's and the content's: a guide
 * with no school has no scoreboard, one the email does not cover has no
 * form, one with no updates folder has no Things to know. Every date,
 * score and count is the data's, and an empty section says so.
 */
import Hero from '@/components/Hero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import PlaceCard from '@/components/PlaceCard.astro';
import PlaceFeature from '@/components/PlaceFeature.astro';
import PlaceIndex from '@/components/PlaceIndex.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import NearbyWeekend from '@/components/NearbyWeekend.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import SportsStrip from '@/components/SportsStrip.astro';
import Scoreboard from './Scoreboard.astro';
import WeekAgenda from './WeekAgenda.astro';
import { editionFor, emailEditions, getNetworkHub, getTown } from '@/config';
import { schoolsFor, teamPath, type SportsData } from '@/config/school-sports';
import { getTownEntries } from '@/lib/content';
import { formatDayRange } from '@/lib/dates';
import { occurrences } from '@/lib/events';
import { weekDays } from '@/lib/flagship-home';
import { isOpen } from '@/lib/places';
import { hasData, sportsDataFor } from '@/lib/school-sports';
import { currentUpdates } from '@/lib/updates';
import { briefingUpdates, currentPick, weekWindow } from '@/lib/weekly';

const town = getTown();
const now = new Date();
const hub = getNetworkHub();

// 2. The school. One school: the scoreboard on its band. Several: the strip.
const schools = schoolsFor(town.slug);
const files = import.meta.glob<SportsData>('../../../data/*/sports*.json', { eager: true, import: 'default' });
const school = schools.length === 1 ? schools[0] : undefined;
const data = school ? sportsDataFor(school, files) : undefined;
const teamHref = (key: string) => {
  const team = data?.sports.find((t) => t.key === key);
  return school && team && hasData(team) ? teamPath(school, key) : '/sports/';
};

// 4. The email: one form on the page, where the email covers the town.
const emailOn = !!hub.newsletter && !!editionFor(town.slug, emailEditions());
const sendDay = hub.newsletter?.sendDay ?? 'Thursday';

// 3. The week: the next seven days, the first two with room for four
// things, the rest three, the pick marked.
const allEvents = await getTownEntries('events');
const calendar = occurrences(allEvents, { now, horizonDays: 30 });
const notes = await getTownEntries('weekly');
const { thisWeek: pick } = currentPick(notes, calendar, now);
const picked = new Set(pick ? [pick.event.slug] : []);
const days = weekDays({
  events: occurrences(allEvents, { now, horizonDays: 8 }),
  sports: data,
  teamHref,
  email: emailOn ? { day: sendDay, time: hub.newsletter?.sendTime } : undefined,
  now,
  start: 'today',
  limit: (i) => (i < 2 ? 4 : 3),
  picked,
});
const weekEnd = days[6]!.date.getTime() + 86_400_000;
const laterCount = new Set(calendar.filter((e) => e.data.start.getTime() >= weekEnd).map((e) => e.slug)).size;

// 4. Things to know: the week's local changes, newest first, with sources.
const updates = await getTownEntries('updates');
const know = briefingUpdates(currentUpdates(updates, now), now)
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime() || b.data.effective.getTime() - a.data.effective.getTime())
  .slice(0, 3);
const hasUpdates = updates.length > 0;
const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');
const { monday, sunday } = weekWindow(now);

// 5. The places. The home page recommends; a place that has closed is
// listed, not recommended. Cards are for photographs: a card with none is
// an empty box, and most of these towns have a handful of licensed images,
// so the rest of the section is an index of names, not a grid of tiles.
const places = (await getTownEntries('places')).filter(isOpen);
const pickedFirst = <T extends { data: { featured: boolean } }>(list: T[]) => [
  ...list.filter((p) => p.data.featured),
  ...list.filter((p) => !p.data.featured),
];
const placeCards = pickedFirst(places.filter((p) => p.data.image)).slice(0, 3);
const carded = new Set(placeCards.map((p) => p.slug));
const placeIndex = pickedFirst(places.filter((p) => !carded.has(p.slug))).slice(0, 8);

// 6. The guide's latest.
const articles = (await getTownEntries('articles')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 2);
const [leadArticle, secondArticle] = articles;

// 7. What the guide covers: one short line a page, the resident hubs where
// the guide has them. Families and Things to do are different pages, as are
// Living here and Moving here; a guide shows the ones it has.
const strip = (line: string) => line.replace(/\.\s*$/, '');
const startHere = [
  { label: `Events in ${town.name}`, href: '/events/', text: 'Every event with a date, the weekly regulars once each.' },
  { label: 'This weekend', href: '/this-weekend/', text: `Friday to Sunday in ${town.name}.` },
  ...(school ? [{ label: `${school.mascot} sports`, href: '/sports/', text: 'Scores, schedules and every team, from MaxPreps.' }] : []),
  { label: 'Eat & drink', href: '/eat-drink/', text: 'Restaurants, bars, coffee and shops, with their hours.' },
  { label: 'Things to do', href: '/things-to-do/', text: 'Trails, parks, venues and places to stay.' },
  ...(town.families ? [{ label: town.families.label, href: '/families/', text: strip(town.families.intro) + '.' }] : []),
  ...(town.livingHere ? [{ label: 'Living here', href: '/living-here/', text: strip(town.livingHere.intro) + '.' }] : []),
  ...(town.participation ? [{ label: town.participation.label, href: '/get-involved/', text: strip(town.participation.intro) + '.' }] : []),
  { label: 'Guides', href: '/guides/', text: 'Longer reads: a walking route, the history, the town with kids.' },
  { label: `Moving to ${town.name}`, href: '/moving-here/', text: 'Housing, schools, the commute and the utilities.' },
];

// 8. The close. A resident guide ends on taking part; a visitor guide on moving here.
const resident = !!town.home;
const residentLinks = [
  { label: 'Add an event', href: '/submit-event/', text: 'A meeting, a market, a game night: it goes up once it is checked.' },
  { label: 'Suggest an update', href: '/correct/', text: 'New hours, a closure, a wrong fact: tell the guide and it is fixed.' },
  town.livingHere
    ? { label: 'Resident resources', href: '/living-here/', text: strip(town.livingHere.intro) + '.' }
    : { label: `Moving to ${town.name}`, href: '/moving-here/', text: 'Housing, schools, the commute and the utilities.' },
];
---
<Hero />

{school ? <Scoreboard town={town} /> : schools.length > 1 && (
  <section class="band band-paper">
    <div class="container-page"><SportsStrip town={town.slug} class="max-w-3xl" /></div>
  </section>
)}

<WeekAgenda town={town} days={days} now={now} laterCount={laterCount} />

{(hasUpdates || emailOn) && (
  <section class="band band-paper" aria-labelledby={hasUpdates ? 'know' : undefined}>
    <div class:list={['container-page grid gap-10', hasUpdates && emailOn && 'lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:items-start lg:gap-14']}>
      {hasUpdates && (
        <div>
          <SectionHeader eyebrow={formatDayRange(monday, sunday)} title="Things to know" id="know" href="/updates/" linkLabel="Every local change" />
          {know.length > 0 ? (
            <ol class="grid gap-6">
              {know.map((u) => (
                <li class="border-t border-line-soft pt-4 first:border-t-0 first:pt-0">
                  <h3 class="text-xl font-medium leading-tight">{u.data.title}</h3>
                  <p class="mt-1.5 text-[1.0625rem] leading-relaxed text-ink-muted">{u.data.summary}</p>
                  {(u.data.source || u.data.alsoSource) && (
                    <p class="mt-1.5 flex flex-wrap gap-x-4 text-[0.875rem]">
                      {u.data.source && <a href={u.data.source} rel="noopener" class="inline-block -my-2 py-2 text-primary underline">Source: {u.data.sourceLabel ?? host(u.data.source)}</a>}
                      {u.data.alsoSource && <a href={u.data.alsoSource} rel="noopener" class="inline-block -my-2 py-2 text-primary underline">{u.data.alsoSourceLabel ?? host(u.data.alsoSource)}</a>}
                    </p>
                  )}
                </li>
              ))}
            </ol>
          ) : (
            <p class="text-[1.0625rem] leading-relaxed text-ink-muted">No local changes on the guide for the week of {formatDayRange(monday, sunday)}. When the Town or a business changes something residents need to know, it goes here with its source.</p>
          )}
        </div>
      )}
      {emailOn && (
        <div class:list={[!hasUpdates && 'max-w-3xl']}>
          <NewsletterSignup town={town} id="home" variant="card" anchor="signup" />
        </div>
      )}
    </div>
  </section>
)}

<section class="band band-white">
  <div class="container-page">
    {/* The section shows every kind of place, not only food, so the link goes
       to the directory, which lists them all. */}
    <SectionHeader eyebrow="Eat, drink, wander" title="Where to go" href="/directory/" linkLabel="All places" />
    {places.length === 0 ? (
      <p class="text-ink-muted">Places are on their way.</p>
    ) : (
      <>
        {placeCards.length === 1 && <PlaceFeature place={placeCards[0]} />}
        {placeCards.length > 1 && (
          <div class:list={['grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:gap-x-8', placeCards.length > 2 && 'lg:grid-cols-3']}>
            {placeCards.map((place) => <PlaceCard place={place} />)}
          </div>
        )}
        {placeIndex.length > 0 && (
          <div class:list={[placeCards.length > 0 && 'mt-12 border-t border-line-soft pt-2']}>
            <PlaceIndex places={placeIndex} />
          </div>
        )}
      </>
    )}
    <NearbyWeekend town={town} class="mt-14" />
  </div>
</section>

{leadArticle && (
  <section class="band band-paper">
    <div class="container-page">
      <SectionHeader eyebrow="Latest" title="From the guide" href="/guides/" linkLabel="All guides" />
      <ArticleCard article={leadArticle} feature />
      {secondArticle && (
        <div class="mt-12 border-t border-line-soft pt-8">
          <ArticleCard article={secondArticle} row />
        </div>
      )}
    </div>
  </section>
)}

{/* The guide's map of itself, after the real content rather than before it. */}
<section class:list={['band', leadArticle ? 'band-white' : 'band-paper']}>
  <div class="container-page">
    <SectionHeader eyebrow="Start here" title={`What ${town.siteTitle} covers`} />
    <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {startHere.map((item) => (
        <li class="border-t border-line-soft pt-4">
          <a href={item.href} class="inline-block -my-1 py-1 text-lg font-semibold text-primary underline">{item.label}</a>
          <p class="mt-1 text-[0.9375rem] leading-snug text-ink-muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

{resident ? (
  <section class="on-dark bg-primary text-white">
    <div class="container-page grid gap-8 py-16 md:grid-cols-[2fr_3fr] md:items-start md:py-20">
      <div>
        <p class="eyebrow text-white">Part of {town.name}?</p>
        <h2 class="display-md mt-4 text-4xl lg:text-5xl">This guide is kept by the people who use it.</h2>
      </div>
      <ul class="grid gap-6 sm:grid-cols-3 md:pt-2">
        {residentLinks.map((item) => (
          <li class="border-t border-white/30 pt-4">
            <a href={item.href} class="inline-block -my-1 py-1 text-lg font-semibold text-white underline">{item.label}</a>
            <p class="mt-1 text-[0.9375rem] leading-snug text-white/80">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
) : (
  <section class="on-dark bg-primary text-white">
    <div class="container-page grid gap-8 py-16 md:grid-cols-[3fr_2fr] md:items-end md:py-24">
      <div>
        <p class="eyebrow text-white">Moving here</p>
        <h2 class="display-md mt-4 text-4xl lg:text-6xl">Thinking of making {town.name} home?</h2>
      </div>
      <div>
        <p class="text-lg leading-relaxed">
          Schools, commutes, what the housing market looks like, and what nobody tells you until you live here.
        </p>
        <a href="/moving-here/" class="btn btn-light mt-6">Read the guide</a>
      </div>
    </div>
  </section>
)}
