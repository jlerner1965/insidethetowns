---
/**
 * The town home page, one for every guide: a front door, not the whole
 * site (the homepage redesign brief, 27 October 2026). Each section shows
 * two or three things and one link to its page; the page's two jobs are
 * this week's events and the Thursday email. Top to bottom:
 *
 * 1. The photograph, the county, the name and the town's own line (Hero,
 *    compact): a short band on a phone, the type under the picture.
 * 2. The school's strip (SportsBar): the mark, the nickname, the latest
 *    result, the next game and the scores, in the school's colours. A
 *    guide that follows several schools keeps the shared strip; a guide
 *    with no sports data has none.
 * 3. What's happening (WhatsHappening): Today, Tomorrow and This weekend
 *    as tabs, five listings each, the games among them, then All events
 *    and Add an event.
 * 4. The Thursday email (NewsletterSignup, home): the heading, one line,
 *    the field and the button. The page's one form, where the email covers
 *    the town.
 * 5. Find your next stop (NextStop): Eat & drink, Things to do and Living
 *    here (or Moving here) as three photographs.
 * 6. Worth knowing: the two newest local changes as links, and the rest on
 *    the updates page. Hidden where there are none.
 * 7. The footer, one block on this page (Footer).
 *
 * The seven-day agenda, the scoreboard, the changes' summaries and sources,
 * the place cards and the list of eight, the articles, the neighbours'
 * weekend, the grid of links and the closing bands came off the page on
 * 27 October 2026; every one of their pages is still one click away from
 * the menu or the footer. It replaced the design pass of 26 October 2026,
 * which on a phone ran to fourteen screens on Berthoud; this runs to about
 * five.
 *
 * Which of these a guide shows is the config's and the content's: a guide
 * with no school has no strip, one the email does not cover has no form,
 * one with no local changes has no Worth knowing. Every date, score and
 * count is the data's, and an empty tab says so.
 */
import Hero from '@/components/Hero.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import SportsStrip from '@/components/SportsStrip.astro';
import NextStop from './NextStop.astro';
import SportsBar from './SportsBar.astro';
import WhatsHappening from './WhatsHappening.astro';
import { editionFor, emailEditions, getNetworkHub, getTown } from '@/config';
import { schoolsFor, teamPath, type SportsData } from '@/config/school-sports';
import { getTownEntries } from '@/lib/content';
import { occurrences, weeklyTest } from '@/lib/events';
import { weekDays } from '@/lib/flagship-home';
import { defaultTab, homeTabs, laterRows, TAB_LIMIT } from '@/lib/home-tabs';
import { isOpen } from '@/lib/places';
import { hasData, sportsDataFor } from '@/lib/school-sports';
import { currentUpdates } from '@/lib/updates';
import { currentPick } from '@/lib/weekly';

const town = getTown();
const now = new Date();
const hub = getNetworkHub();

// 2. The school. One school: its strip. Several: the shared one.
const schools = schoolsFor(town.slug);
const files = import.meta.glob<SportsData>('../../../data/*/sports*.json', { eager: true, import: 'default' });
const school = schools.length === 1 ? schools[0] : undefined;
const data = school ? sportsDataFor(school, files) : undefined;
const teamHref = (key: string) => {
  const team = data?.sports.find((t) => t.key === key);
  return school && team && hasData(team) ? teamPath(school, key) : '/sports/';
};

// 4. The email: one form on the page, where the email covers the town.
const emailOn = !!hub.newsletter && !!editionFor(town.slug, emailEditions());

// 3. The week from today, uncapped: the tabs choose their five
// (src/lib/home-tabs.ts), the editor's pick marked.
const allEvents = await getTownEntries('events');
const calendar = occurrences(allEvents, { now, horizonDays: 30 });
const notes = await getTownEntries('weekly');
const { thisWeek: pick } = currentPick(notes, calendar, now);
const picked = new Set(pick ? [pick.event.slug] : []);
const days = weekDays({ events: occurrences(allEvents, { now, horizonDays: 8 }), sports: data, teamHref, now, start: 'today', limit: 99, picked });
// What an empty tab offers next: the listings of the next two months, so a
// quiet guide's next date three weeks out is still found.
const later = laterRows(occurrences(allEvents, { now, horizonDays: 60 }), picked, weeklyTest(allEvents));
const tabs = homeTabs(days, now, TAB_LIMIT, later);
const open = defaultTab(now);

// A thin day: the tab that opens has fewer than three rows at the build, so
// the signup would follow a near-empty list. The three tiles go first then,
// and the form after them (the reader pass, 1 November 2026: Johnstown's
// phone read "Nothing listed", three library rows, then the email ask).
const THIN = 3;
const thin = (tabs.find((t) => t.key === open)?.rows.length ?? 0) < THIN;

// 6. Worth knowing: the two newest local changes still current.
const know = currentUpdates(await getTownEntries('updates'), now)
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime() || b.data.effective.getTime() - a.data.effective.getTime())
  .slice(0, 2);

// 5. The places with a photograph, for the three tiles; a closed place is not a next stop.
const places = (await getTownEntries('places')).filter(isOpen);
---
<Hero compact pick={!!pick} changes={know.length > 0} />

{school ? <SportsBar town={town} /> : schools.length > 1 && (
  <section class="band-compact band-paper">
    <div class="container-page"><SportsStrip town={town.slug} class="max-w-3xl" limit={2} /></div>
  </section>
)}

<WhatsHappening town={town} tabs={tabs} open={open} />

{emailOn && !thin && (
  <section class="band-compact band-paper">
    <div class="container-page">
      <NewsletterSignup town={town} id="home" variant="home" anchor="signup" />
    </div>
  </section>
)}

<NextStop town={town} places={places} />

{emailOn && thin && (
  <section class="band-compact band-paper">
    <div class="container-page">
      <NewsletterSignup town={town} id="home" variant="home" anchor="signup" />
    </div>
  </section>
)}

{know.length > 0 && (
  <section class="band-compact band-paper" aria-labelledby="know">
    <div class="container-page">
      <h2 id="know" class="display-md text-[2rem] md:text-[2.5rem]">Worth knowing</h2>
      <ul class="mt-3 divide-y divide-line-soft">
        {know.map((u) => (
          <li class="py-3 text-[1.0625rem] leading-snug"><a href={`/updates/#${u.slug}`} class="font-medium no-underline hover:text-primary hover:underline">{u.data.title}</a></li>
        ))}
      </ul>
      <p class="mt-3 text-[1.0625rem]"><a href="/updates/" class="inline-block -my-2 py-2 font-semibold text-primary underline">Every local change →</a></p>
    </div>
  </section>
)}
