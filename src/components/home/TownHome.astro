---
/**
 * The town home page, one for every guide: a front door, not the whole
 * site (the homepage redesign brief, 27 October 2026). Each section shows
 * two or three things and one link to its page; the page's two jobs are
 * this week's events and the Thursday email. Top to bottom, in the owner's
 * content order of 21 November 2026, the same on a phone and a desktop:
 *
 * 1. The photograph, the county, the name and the town's own line (Hero,
 *    compact), and On this page: the page's one set of section links.
 * 2. What is on now: What's happening (Today, Tomorrow and This weekend as
 *    tabs, five listings each, the games among them; on the Today tab a
 *    line to the rec center's hours where the town has a schedule), the
 *    quick answers, the school's strip (SportsBar) or a several-school
 *    guide's games, and Worth knowing (the local changes, the timely ones
 *    first). A quiet guide (Niwot): its Updates.
 * 3. The next big event: Don't miss (DontMiss).
 * 4. Things to do: an outdoors-led guide's trails and parks, and For
 *    families where the config switches it on (`families.onHome`).
 * 5. Eat, drink and explore: Find your next stop (NextStop).
 * 7. The annual calendar: the guide's dates (HomeDates); on a quiet guide,
 *    Things to know.
 * 9. The Thursday email (NewsletterSignup, home), the page's one form, last
 *    before the footer (Footer), which leaves its email band off a home
 *    page that has this form.
 *
 * Where to stay and getting here (6) and history and stories (8) are not
 * on a guide's home page; their pages are in the town bar.
 *
 * The seven-day agenda, the scoreboard, the changes' summaries and sources,
 * the place cards and the list of eight, the articles, the neighbours'
 * weekend, the grid of links and the closing bands came off the page on
 * 27 October 2026; every one of their pages is still one click away from
 * the menu or the footer. It replaced the design pass of 26 October 2026,
 * which on a phone ran to fourteen screens on Berthoud; this runs to about
 * five.
 *
 * Which of these a guide shows is the config's and the content's: a guide
 * with no school has no strip, one the email does not cover has no form,
 * one with no local changes has no Worth knowing. Every date, score and
 * count is the data's, and an empty tab says so.
 */
import Hero from '@/components/Hero.astro';
import WorthKnowing from '@/components/home/WorthKnowing.astro';
import { guideName } from '@/lib/hub-home';
import { coveredTowns } from '@/lib/town-search-index';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import SportsStrip from '@/components/SportsStrip.astro';
import NextStop from './NextStop.astro';
import QuickAnswers from './QuickAnswers.astro';
import SportsBar from './SportsBar.astro';
import WhatsHappening, { type Feature } from './WhatsHappening.astro';
import DontMiss from './DontMiss.astro';
import { recCenterFor, type RecCenterData } from '@/lib/rec-center';
import { editionFor, emailEditions, getNetworkHub, getTown } from '@/config';
import { schoolsFor, teamPath, type SportsData } from '@/config/school-sports';
import HomeDates from '@/components/home/HomeDates.astro';
import { STANDALONE_GUIDES } from '@/config/hub-towns';
import { getTownEntries, getTraditions } from '@/lib/content';
import { guideHomeDates, lineFor, placeKey } from '@/lib/hub-towns';
import { fillTest, forGeneralReaders, occurrences, weeklyTest } from '@/lib/events';
import { familyLines } from '@/lib/family-home';
import { eventItem, weekDays } from '@/lib/flagship-home';
import { defaultTab, DONT_MISS_DAYS, dontMiss, homeTabs, labelGames, laterRows, TAB_DAYS_AHEAD, TAB_LIMIT, tabEditions } from '@/lib/home-tabs';
import { dayKey, formatDayShort, formatTimeRange } from '@/lib/dates';
import { resolveSiteImage } from '@/lib/images';
import { firstSentence } from '@/lib/plain-text';
import { eventDescription } from '@/lib/seo';
import { byProminence, isListed } from '@/lib/places';
import { countByType, PLACE_TYPE_PAGES, placeTypePages } from '@/lib/place-types';
import { hasData, sportsDataFor } from '@/lib/school-sports';
import { currentUpdates, isNew, isTimely } from '@/lib/updates';
import { formatDate } from '@/lib/dates';
import { currentPick } from '@/lib/weekly';

const town = getTown();
const now = new Date();
const hub = getNetworkHub();

// What the guide leads with (TownConfig.lead): its school's sports unless
// it says outdoors (Lyons) or updates (Niwot, which lists no events).
const outdoorsLed = town.lead === 'outdoors';
const quietGuide = town.lead === 'updates';

// The shared dates, on a standalone guide (src/lib/hub-towns.ts): single
// lines under Worth knowing on a sports-led guide, the lead section on an
// outdoors-led one, and under Things to know on a quiet one, where the
// guide's own traditions join them.
const today = dayKey(now);
const place = placeKey(town.slug);
const standalone = !!place && !!STANDALONE_GUIDES[place];
const records = standalone ? await getTraditions() : [];
// Only dates that are set, and the outdoor ones first only when two or
// more are (guideHomeDates): otherwise the guide's own traditions lead.
const dates = standalone ? guideHomeDates(records, place!, today) : { lead: 'outdoor' as const, outdoor: [], traditions: [] };
const anyDates = dates.outdoor.length + dates.traditions.length > 0;
const localLines = Object.fromEntries(dates.outdoor.map((r) => [r.record.slug, place ? lineFor(r.record, place) : undefined]));

// An outdoors-led guide opens on its trails and parks (the owner, 17
// November 2026): the featured ones first, each with its line, then the
// pages that list them all. Nothing where the guide lists none.
const OUTDOOR_ROWS = 5;
const outdoorPlaces = outdoorsLed ? (await getTownEntries('places')).filter((p) => isListed(p) && (p.data.type === 'trail' || p.data.type === 'park')).sort(byProminence) : [];
const outdoorPages = placeTypePages(countByType(outdoorPlaces)).filter((t) => t === 'trail' || t === 'park');

// 2. The school. One school: its strip. Several: the shared one. None on
// an outdoors-led guide, whose home page carries no sports.
const schools = outdoorsLed ? [] : schoolsFor(town.slug);
const files = import.meta.glob<SportsData>('../../../data/*/sports*.json', { eager: true, import: 'default' });
const school = schools.length === 1 ? schools[0] : undefined;
const data = school ? sportsDataFor(school, files) : undefined;
const teamHref = (key: string) => {
  const team = data?.sports.find((t) => t.key === key);
  return school && team && hasData(team) ? teamPath(school, key) : '/sports/';
};

// 4. The email: one form on the page, where the email covers the town.
const emailOn = !!hub.newsletter && !!editionFor(town.slug, emailEditions());

// 3. The week from today, uncapped: the tabs choose their five
// (src/lib/home-tabs.ts), the editor's pick marked.
const allEvents = await getTownEntries('events');
const calendar = occurrences(allEvents, { now, horizonDays: 30 });
const notes = await getTownEntries('weekly');
const { thisWeek: pick } = currentPick(notes, calendar, now);
const picked = new Set(pick ? [pick.event.slug] : []);
// The home is for everyone who opens it: the standing children's programs
// (the storytimes, the kids' clubs; src/lib/events.ts, standingFamilyTest)
// stay on the Families page and the events page, and off the tabs, "Next in
// <Town>" and the Families block here.
const general = (horizonDays: number) => forGeneralReaders(occurrences(allEvents, { now, horizonDays }), allEvents);
// What an empty tab offers next: the listings of the next two months, so a
// quiet guide's next date three weeks out is still found.
// The regulars (trivia, a monthly club, a food truck) are marked, so a tab
// shows them only on a quiet day and "Next in <Town>" ranks them last, once.
const isFill = fillTest(allEvents);
const later = laterRows(general(60), picked, isFill);
// The tabs for today and for each of the next two days, so a page read
// after midnight shows that day's Today, not the build's (src/lib/
// home-tabs.ts, tabEditions). The school's games say whose they are:
// "Niwot volleyball vs …".
const week = general(8 + TAB_DAYS_AHEAD);
const editions = tabEditions((asOf) => {
  const days = weekDays({ events: week, sports: data, teamHref, now: asOf, start: 'today', limit: 99, picked, isSeries: isFill });
  return homeTabs(school ? labelGames(days, school.maxprepsName) : days, asOf, TAB_LIMIT, later);
}, now);
const open = defaultTab(now);

// 3a. A town with a rec center schedule file (data/<town>/rec-center.json;
// src/lib/rec-center.ts): one line at the top of the Today tab to its
// listing, which has the hours and the pool schedule (the owner, 21
// November 2026: the week's table stood between the tabs and the listings).
const recFiles = import.meta.glob<RecCenterData>('../../../data/*/rec-center.json', { eager: true, import: 'default' });
const rec = recCenterFor(recFiles, town.slug);


// 6. Worth knowing: the two local changes still current, in currentUpdates'
// order: a featured change first, then the newest. A re-sort by published
// alone sat here and put two routine notices above Berthoud's featured
// election result (flagship audit, 4 November 2026).
const updates = await getTownEntries('updates');
const current = currentUpdates(updates, now);
/**
 * The audit of 13 November 2026: a change that matters now (featured,
 * starting within the fortnight, or under way and just published) goes
 * high on the page, under the week's tabs, rather than in Worth knowing at
 * its foot; the rest stay there. On a quiet guide every current change
 * leads the page, the new ones first.
 */
const timely = quietGuide ? [] : current.filter((u) => isTimely(u, now)).slice(0, 2);
const know = quietGuide ? current.slice(0, 5) : current.filter((u) => !timely.includes(u)).slice(0, 2);
const fresh = quietGuide ? know.filter((u) => isNew(u, now)) : [];
const older = quietGuide ? know.filter((u) => !fresh.includes(u)) : [];

// 5. For families: the hub's three timeliest lines, where the town has them on.
const familyRows = town.families?.onHome
  ? familyLines({ programs: await getTownEntries('programs'), breaks: town.families.breaks, events: general(10), now, isSeries: weeklyTest(allEvents) })
  : [];

// 6. The places with a photograph, for the three tiles; a closed place is not a next stop.
const places = (await getTownEntries('places')).filter(isListed);

// 3c. The quick answers under the tabs never repeat a link the page has
// (src/components/home/QuickAnswers.astro): the pages linked from the
// families block and Worth knowing, where each is on the page. Not the rec
// line's "Schedule & passes": it is inside the Today tab, which is closed
// from Friday to Sunday, so on the weekend the quick answers' rec center
// link was the page's only one (the owner, 9 November 2026).
const linked = new Set<string>([
  ...(rec ? [`/places/${rec.place}/`] : []),
  ...(familyRows.length > 0 ? ['/families/'] : []),
  ...(know.length > 0 || timely.length > 0 ? ['/updates/'] : []),
]);
const hasGuides = (await getTownEntries('articles')).length > 0;

// 3. Don't miss, its own section after What's happening: the next featured listing within three
// weeks (src/lib/home-tabs.ts), with a photograph: its own, else its venue's
// where the venue is a listed place with one ("Niwot Hall and Downtown
// Niwot" finds Niwot Hall), else none: the town's hero is already at the top
// of the page (the design audit, 10 November 2026).
const heroSrc = resolveSiteImage(town.slug, town.hero.image).src;
const featured = dontMiss(general(DONT_MISS_DAYS + 1), now);
let feature: Feature | undefined;
if (featured) {
  const row = eventItem(featured);
  const { title, start, end, allDay, timeNote, venue, cost, image, imageAlt } = featured.data;
  const spot = places
    .filter((p) => p.data.image && p.data.image.src !== heroSrc && venue.toLowerCase().includes(p.data.title.toLowerCase()))
    .sort((a, b) => b.data.title.length - a.data.title.length)[0];
  feature = {
    title,
    href: row.href,
    when: `${formatDayShort(start)} · ${timeNote ?? formatTimeRange(start, end && dayKey(end) === dayKey(start) ? end : undefined, allDay)}`,
    where: [venue, cost].filter(Boolean).join(' · '),
    blurb: firstSentence(eventDescription(featured.body) ?? '') || undefined,
    image: image ?? spot?.data.image,
    alt: image ? (imageAlt ?? '') : (spot?.data.imageAlt ?? ''),
    eventDay: row.eventDay,
    end: row.end,
  };
}
/*
 * On this page: the home's sections, in the order they are drawn below, as
 * the hub's town pages list theirs (src/routes/hub/town.astro; the owner,
 * 20 November 2026: one navigation for the eleven guides). Each link is to
 * a section's own heading, and a section the page does not draw is not
 * listed: the conditions are the template's own, kept beside it here.
 */
const families = familyRows.length > 0;
const datesHeading = quietGuide ? 'Things to know' : dates.lead === 'outdoor' ? 'Outdoor dates' : `Every year in ${town.name}`;
const onThisPage: Array<{ id: string; label: string }> = (
  [
    quietGuide ? know.length > 0 && { id: 'updates-home', label: 'Updates' } : { id: 'happening', label: 'What’s happening' },
    !quietGuide && (timely.length > 0 || know.length > 0) && { id: 'know', label: 'Worth knowing' },
    !quietGuide && feature && { id: 'dont-miss', label: 'Don’t miss' },
    outdoorPlaces.length > 0 && { id: 'outdoors-home', label: 'Trails and parks' },
    families && { id: 'families-home', label: 'For families' },
    { id: 'next-stop', label: 'Find your next stop' },
    (quietGuide || anyDates) && { id: quietGuide ? 'things-to-know' : 'outdoor-lead', label: datesHeading },
    (emailOn || quietGuide) && { id: 'signup', label: quietGuide ? 'Updates by email' : 'The Thursday email' },
  ]
).filter((s): s is { id: string; label: string } => !!s);

---
{/* The guide's name as the hub's index gives it: a guide named for its own
    town adds the others it covers ("Windsor and Severance"; the owner,
    13 November 2026). Carbon Valley, named for a region, stays as it is. */}
<Hero compact title={guideName(town, coveredTowns(town))} pick={!quietGuide && !!pick} changes={know.length > 0 || timely.length > 0} />

{/* On this page, one slim row under the photograph: the sections below,
    each a link to its heading. A section the browser hides once its last
    row is over (src/lib/expiry.ts) takes its link with it. */}
<nav aria-labelledby="otp" class="border-b border-line-soft bg-raised" data-on-this-page data-pagefind-ignore>
  <div class="container-page flex flex-wrap items-baseline gap-x-5 pt-3 text-[0.9375rem] sm:pt-0">
    <h2 id="otp" class="eyebrow text-ink-muted">On this page</h2>
    <ol class="flex flex-wrap items-baseline gap-x-5">
      {onThisPage.map((s) => <li><a href={`#${s.id}`} class="inline-block py-3 font-semibold text-primary underline" data-otp-link={s.id}>{s.label}</a></li>)}
    </ol>
  </div>
</nav>

{/* 2. What is on now. A quiet guide (Niwot): Updates, only when there is
    one; no events, so no tabs and no empty week. Any other: the week's
    tabs, the quick answers tucked under them, the school's strip, and the
    local changes. */}
{quietGuide && know.length > 0 && (
  <section class="band-compact band-paper" aria-labelledby="updates-home" data-quiet-updates>
    <div class="container-page">
      <h2 id="updates-home" class="display-md text-[2rem] md:text-[2.5rem]">Updates</h2>
      {/* Each with its date and its summary, the new ones apart from the
          older notices still in effect (the audit of 13 November 2026). */}
      {[{ label: 'New this week', list: fresh }, { label: 'Still in effect', list: older }].filter((g) => g.list.length > 0).map((g, i, groups) => (
        <div class:list={[i > 0 && 'mt-6']} data-updates-group={g.label}>
          {groups.length > 1 && <h3 class="eyebrow mt-4">{g.label}</h3>}
          <ul class="mt-2 divide-y divide-line-soft">
            {g.list.map((u) => (
              <li class="py-3">
                <a href={`/updates/#${u.slug}`} class="text-[1.0625rem] font-medium leading-snug text-primary no-underline hover:underline">{u.data.title}</a>
                <p class="mt-1 text-[0.9375rem] leading-snug">{u.data.summary}</p>
                <p class="mt-1 text-[0.875rem] text-ink-muted">
                  Published <time datetime={dayKey(u.data.published)}>{formatDate(u.data.published)}</time>{u.data.verified && dayKey(u.data.verified) !== dayKey(u.data.published) && <Fragment> · checked <time datetime={dayKey(u.data.verified)}>{formatDate(u.data.verified)}</time></Fragment>}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="mt-3 text-[1.0625rem]"><a href="/updates/" class="inline-block -my-3 py-3 font-semibold text-primary underline">Every local change →</a></p>
    </div>
  </section>
)}

{!quietGuide && (
  <WhatsHappening town={town} editions={editions} open={open}>
    {/* The rec center's hours and pool schedule are on its own listing: one
        line to it here, where the week's table stood between the tabs and
        the listings (the owner, 21 November 2026). */}
    {rec && <p slot="today" class="text-[1.0625rem]" data-rec-link><a href={`/places/${rec.place}/`} class="inline-block -my-2 py-2 font-semibold text-primary underline">Rec center hours and pool schedule →</a></p>}
  </WhatsHappening>
)}

<QuickAnswers town={town} recPlace={rec?.place} hasUpdates={updates.length > 0} {hasGuides} hasPlaces={places.length > 0} {linked} tuck={!quietGuide} />

{school && !quietGuide && <SportsBar town={town} />}

{/* A guide that follows several schools: the week's games, under the
    events (the owner, 10 November 2026). */}
{!school && schools.length > 1 && (
  <section class="band-compact band-paper">
    <div class="container-page"><SportsStrip town={town.slug} class="max-w-3xl" limit={2} /></div>
  </section>
)}

{/* Worth knowing: the local changes, the timely ones first (WorthKnowing.astro). */}
{!quietGuide && (timely.length > 0 || know.length > 0) && <WorthKnowing {timely} {know} />}

{/* 3. The next big event: Don't miss. */}
{!quietGuide && feature && <DontMiss {feature} />}

{/* 4. Things to do. An outdoors-led guide (Lyons): its trails, river and
    parks (the owner, 17 November 2026). */}
{outdoorPlaces.length > 0 && (
  <section class="band-compact band-paper" aria-labelledby="outdoors-home" data-outdoors-home>
    <div class="container-page">
      <h2 id="outdoors-home" class="display-md text-[2rem] md:text-[2.5rem]">Trails and parks</h2>
      <ul class="mt-3 divide-y divide-line-soft">
        {outdoorPlaces.slice(0, OUTDOOR_ROWS).map((p) => (
          <li class="py-3">
            <p class="text-[1.0625rem] leading-snug"><a href={`/places/${p.slug}/`} class="font-medium no-underline hover:text-primary hover:underline" data-track="outdoors-home">{p.data.title}</a></p>
            <p class="mt-0.5 text-[0.9375rem] leading-snug text-ink-muted">{p.data.summary}</p>
          </li>
        ))}
      </ul>
      <p class="mt-3 flex flex-wrap gap-x-6 text-[1.0625rem]">
        {outdoorPages.map((t) => (
          <a href={PLACE_TYPE_PAGES[t].path} class="inline-block -my-3 py-3 font-semibold text-primary underline">{t === 'trail' ? 'Every trail' : 'Every park'} →</a>
        ))}
        {outdoorPages.length === 0 && <a href="/things-to-do/" class="inline-block -my-3 py-3 font-semibold text-primary underline">Things to do →</a>}
      </p>
    </div>
  </section>
)}

{familyRows.length > 0 && (
  <section class="band-compact band-paper" aria-labelledby="families-home" data-hide-when-empty>
    <div class="container-page">
      <h2 id="families-home" class="display-md text-[2rem] md:text-[2.5rem]">For families</h2>
      <ul class="mt-3 divide-y divide-line-soft">
        {familyRows.map((r) => (
          <li class="py-3" data-event-day={r.day} data-end={r.end}>
            <p class="text-[0.9375rem] font-semibold text-ink-muted">{r.when}</p>
            <p class="text-[1.0625rem] leading-snug"><a href={r.href} class="font-medium no-underline hover:text-primary hover:underline" data-track="family-home">{r.title}</a></p>
            {r.facts.length > 0 && <p class="mt-0.5 text-[0.9375rem] leading-snug text-ink-muted">{r.facts.join(' · ')}</p>}
          </li>
        ))}
      </ul>
      <p class="mt-3 text-[1.0625rem]"><a href="/families/" class="inline-block -my-3 py-3 font-semibold text-primary underline">Everything for families →</a></p>
    </div>
  </section>
)}

{/* 5. Eat, drink and explore: Find your next stop. */}
<NextStop town={town} places={places} />

{/* 7. The annual calendar: the guide's dates, the outdoor ones first when
    two or more have a date set, else its traditions, the statewide ones
    last (HomeDates). On a quiet guide, Things to know. */}
{(quietGuide || anyDates) && (
  <section class="band-compact band-paper" aria-labelledby={quietGuide ? 'things-to-know' : 'outdoor-lead'} data-things-to-know={quietGuide ? '' : undefined} data-outdoor-lead={quietGuide ? undefined : ''}>
    <div class="container-page">
      <h2 id={quietGuide ? 'things-to-know' : 'outdoor-lead'} class="display-md text-[2rem] md:text-[2.5rem]">{datesHeading}</h2>
      {anyDates && <div class="mt-4"><HomeDates {dates} town={town.name} lines={localLines} track={quietGuide ? 'things-to-know' : 'outdoor-lead'} firstLabelled={!quietGuide} /></div>}
    </div>
  </section>
)}

{/* 9. The email, last before the footer: the page's one form. A quiet
    guide's is occasional updates, not the weekly email. */}
{(emailOn || quietGuide) && (
  <section class="band-paper py-4 md:py-6">
    <div class="container-page">
      <NewsletterSignup town={town} id="home" variant="home" anchor="signup" />
    </div>
  </section>
)}
