---
/**
 * The family hub on the home page: the deadlines first, each a row with
 * the date, the action in the title ("Holiday Card Art Contest: entries
 * due Sat Nov 7") and one line of detail; then four cards, one per age
 * section of the hub and one for the next school day off. Every card and
 * row goes to its program's own anchor on /families/, or to the organizer's
 * registration page where the program has one.
 */
import type { TownConfig } from '@/config';
import type { TownEntry } from '@/lib/content';
import { dayKey, formatDayRange, formatDayShort, monthDay, parseLocal, toIsoLocal } from '@/lib/dates';
import { shorten } from '@/lib/text';
import { deadlineTitle, familyAgeGroups, isForFamilies, onePerProgram, upcomingDeadlines } from '@/lib/programs';

interface Props {
  town: TownConfig;
  programs: TownEntry<'programs'>[];
  events: TownEntry<'events'>[];
  now: Date;
  class?: string;
}

const { town, programs, events, now, class: className } = Astro.props;
const families = town.families!;
const family = programs.filter(isForFamilies);
const deadlines = onePerProgram(upcomingDeadlines(programs, { now, days: 45 })).slice(0, 3);
const anchor = (p: TownEntry<'programs'>) => `/families/#program-${p.slug}`;
/** The deadline's own listing, where it has one on the day. */
const listingFor = (d: (typeof deadlines)[number]) => {
  const e = d.program.data.nextEvent ? events.find((x) => x.slug === d.program.data.nextEvent) : undefined;
  return e && dayKey(e.data.start) === dayKey(d.on) ? e : undefined;
};
const rowHref = (d: (typeof deadlines)[number]) => d.program.data.registration?.url ?? (listingFor(d) ? `/events/${listingFor(d)!.slug}/` : anchor(d.program));
// One line: the organizer's own note where it is short, else the organizer.
const detail = (d: (typeof deadlines)[number]) => {
  const { organizer, price, registration } = d.program.data;
  const note = registration?.note;
  return note && note.length <= 70 ? note : `${organizer}${price && /\bfree\b/i.test(price) ? ' · Free' : ''}`;
};
/** "Sat Nov 7": the day without the comma the long form carries. */
const dayText = (on: Date) => {
  const b = monthDay(on);
  return `${b.weekday} ${b.month} ${b.day}`;
};
const groups = familyAgeGroups(family);
// The next day off, and the program open on it, where one says so (openOn).
const breaks = [...families.breaks]
  .map((b) => ({ ...b, fromDate: parseLocal(b.from), toDate: parseLocal(b.to) }))
  .filter((b) => b.toDate.getTime() >= now.getTime() - 86_400_000)
  .sort((a, b) => a.fromDate.getTime() - b.fromDate.getTime());
const nextBreak = breaks[0];
const openOn = nextBreak
  ? family.flatMap((p) => (p.data.openOn ?? []).filter((o) => o.from.getTime() <= nextBreak.toDate.getTime() && o.to.getTime() >= nextBreak.fromDate.getTime()).map((o) => ({ program: p, note: o.note })))[0]
  : undefined;
const card = 'flex min-h-28 flex-col justify-between rounded-lg bg-raised p-4 ring-1 ring-line-soft no-underline hover:ring-primary-line';
---
{(deadlines.length > 0 || groups.length > 0) && (
  <section class={className} aria-labelledby="families-block">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="families-block" class="display-md text-[1.75rem] md:text-[2rem]">{families.label.replace(`${town.name} `, '')}</h2>
      <a href="/families/" class="inline-block -my-2 shrink-0 py-2 text-[0.9375rem] font-semibold text-primary underline">The hub →</a>
    </div>
    {deadlines.length > 0 && (
      <ul class="mt-4 space-y-2">
        {deadlines.map((d) => {
          const badge = monthDay(d.on);
          // A hard deadline is in the amber a notice carries; an opening is plain.
          const hard = d.what === 'closes';
          return (
            <li>
              <a href={rowHref(d)} rel={rowHref(d).startsWith('http') ? 'noopener' : undefined} data-track={rowHref(d).startsWith('http') ? 'registration' : undefined} class:list={['flex items-center gap-4 rounded-lg p-4 no-underline ring-1', hard ? 'bg-highlight-soft ring-highlight' : 'bg-raised ring-line-soft hover:ring-primary-line']}>
                <time datetime={toIsoLocal(d.on)} class:list={['flex size-12 shrink-0 flex-col items-center justify-center rounded-full text-center leading-none', hard ? 'bg-highlight text-ink' : 'bg-paper text-ink ring-1 ring-line-soft']}>
                  <span class="text-[0.625rem] font-bold uppercase tracking-[0.08em]">{badge.month}</span>
                  <span class="mt-0.5 text-[0.9375rem] font-bold">{badge.day}</span>
                </time>
                <span class="min-w-0 flex-1">
                  <span class="block font-semibold leading-snug">{deadlineTitle(d, dayText(d.on), listingFor(d)?.data.title)}</span>
                  <span class="mt-0.5 block text-[0.875rem] leading-snug text-ink-muted">{detail(d)}</span>
                </span>
                <span class="shrink-0 text-primary" aria-hidden="true">→</span>
              </a>
            </li>
          );
        })}
      </ul>
    )}
    <div class="mt-4 grid grid-cols-2 gap-3">
      {groups.slice(0, 3).map(({ group, programs: list }) => {
        const lead = list[0]!;
        return (
          <a href={anchor(lead)} class={card}>
            <span class="eyebrow">{group.label}</span>
            <span class="mt-1 block font-semibold leading-snug">{lead.data.title}</span>
            <span class="mt-1 block text-[0.875rem] leading-snug text-ink-muted">{list.length > 1 ? `and ${list.length - 1} more` : lead.data.organizer}</span>
          </a>
        );
      })}
      {nextBreak && (
        <a href={openOn ? anchor(openOn.program) : '/families/#breaks'} class={card}>
          <span class="eyebrow">Days off</span>
          <span class="mt-1 block font-semibold leading-snug">
            {nextBreak.from === nextBreak.to ? formatDayShort(nextBreak.fromDate) : formatDayRange(nextBreak.fromDate, nextBreak.toDate)} no school{openOn ? `: ${openOn.note}` : ''}
          </span>
          <span class="mt-1 block text-[0.875rem] leading-snug text-ink-muted">{openOn ? nextBreak.label : `${nextBreak.label} · ${nextBreak.district} calendar`}</span>
        </a>
      )}
    </div>
  </section>
)}
