---
/**
 * The events page's filters: when, then what.
 *
 * Readers arrive with a time in mind — tonight, this weekend — and a category
 * second, if at all. The first row is "when", the second is the category,
 * with "Free" at its end: the other question a reader asks, and one that
 * combines with both rows (free music this weekend is a real thing to ask
 * for).
 *
 * There is no switch between the one-offs and everything any more. The date
 * list holds the one-time events and the town meetings (under Civic); the
 * weekly regulars live in their own section below it, once each, so the list
 * never has to hide them.
 *
 * "Today" and "This weekend" are decided in the reader's browser from the
 * Denver date, not at build time, for the reason Freshness.astro gives: a
 * build is a snapshot and the page must stay right after it. The server
 * renders every pill unpressed and every row visible, so a crawler and a
 * reader without JavaScript see the whole list.
 *
 * On a guide that covers several towns (Carbon Valley) a third row, "Where",
 * narrows to one of them; EventCard carries data-sub-town for it.
 *
 * The chosen filters live in the URL (?when=weekend&category=music&free=1,
 * and &where=firestone on a multi-town guide),
 * so a reader can bookmark "free things this weekend", share it, and find it
 * still applied after a reload — and the weekly email can link straight to it.
 * The older ?when=free is still read.
 *
 * Works with EventList's markup: [data-filter-item] rows carrying
 * data-category, data-start-day, data-event-day and data-free, grouped in
 * [data-filter-group] sections inside the nearest [data-filter-root].
 */
interface Props {
  categories: Array<{ value: string; label: string }>;
  /** On a multi-town guide, the places a reader can narrow to: a third row, "Where". */
  subTowns?: Array<{ slug: string; label: string }>;
}

const { categories, subTowns = [] } = Astro.props;
const when = [
  { value: 'today', label: 'Today' },
  { value: 'weekend', label: 'This weekend' },
  { value: 'week', label: 'Next 7 days' },
];
const pill =
  'rounded-full border border-primary-line bg-raised px-4 py-2 text-sm sm:py-1.5 font-medium text-ink-muted transition-colors hover:border-primary hover:text-primary aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-white';
// Which rows a phone folds away (design pass, 26 October 2026): the "when"
// row is always out, it being what a reader asks first; the category and
// town rows sit behind one "Filter by type" button below the sm width, and
// open on their own when a shared link has one of them set. From sm up
// every row is out, as before.
const foldable = categories.length > 1 || subTowns.length > 1;
---
<div class="mb-8 space-y-3 md:mb-10" data-event-filters>
  <div class="filter-row" role="group" aria-label="Filter events by time">
    <span class="eyebrow text-ink-muted">When</span>
    <div class="filter-pills">
      <button type="button" data-when="any" aria-pressed="true" class={pill}>Anytime</button>
      {when.map((o) => (
        <button type="button" data-when={o.value} aria-pressed="false" class={pill}>{o.label}</button>
      ))}
    </div>
  </div>
  {foldable && (
    <p class="sm:hidden">
      <button type="button" class="inline-flex min-h-11 items-center gap-1.5 text-[0.9375rem] font-semibold text-primary underline" aria-expanded="false" aria-controls="event-filter-more" data-filter-more>
        Filter by type<span data-filter-more-count></span>
      </button>
    </p>
  )}
  <div id="event-filter-more" class:list={['space-y-3', foldable && 'max-sm:hidden']} data-filter-fold>
  <div class="filter-row" role="group" aria-label="Filter events by category">
    <span class="eyebrow text-ink-muted">What</span>
    <div class="filter-pills">
      {categories.length > 1 && <button type="button" data-category="all" aria-pressed="true" class={pill}>All</button>}
      {categories.length > 1 &&
        categories.map((o) => (
          <button type="button" data-category={o.value} aria-pressed="false" class={pill}>{o.label}</button>
        ))}
      <button type="button" data-free aria-pressed="false" class:list={[pill, 'border-dashed']}>Free</button>
    </div>
  </div>
  {subTowns.length > 1 && (
    <div class="filter-row" role="group" aria-label="Filter events by town">
      <span class="eyebrow text-ink-muted">Where</span>
      <div class="filter-pills">
        <button type="button" data-where="all" aria-pressed="true" class={pill}>All</button>
        {subTowns.map((t) => (
          <button type="button" data-where={t.slug} aria-pressed="false" class={pill}>{t.label}</button>
        ))}
      </div>
    </div>
  )}
  </div>
  {/* What is set, and the way back to the whole list, in view whenever a
      filter is on: the only reset was in the empty state before, so a reader
      with a shared "free music this weekend" link had to find the pressed
      pills to undo it. */}
  <p class="text-[0.9375rem] text-ink-muted" data-filter-active hidden aria-live="polite">
    Showing <span data-filter-active-words></span>. <button type="button" class="inline-block -my-2 py-2 font-semibold text-primary underline" data-filter-reset>Clear filters</button>
  </p>
  <p class="sr-only" role="status" data-filter-status></p>
</div>

<script>
  import { dayKey, addDays, startOfDay } from '@/lib/dates';
  import { weekendWindow } from '@/lib/events';
  import { initScrollRows } from '@/lib/scroll-rows';

  // Edge fades, and the chosen button kept in view, on a phone's one-line rows.
  initScrollRows();

  // A block that sits among the listings but is not one of them ("Nearby
  // this weekend", data-filter-ignore) is left out of the filtering.
  const ITEM = '[data-filter-item]:not([data-filter-ignore] *)';
  const bar = document.querySelector<HTMLElement>('[data-event-filters]');
  if (bar) {
    const root = bar.closest<HTMLElement>('[data-filter-root]') ?? document.body;
    const whenButtons = bar.querySelectorAll<HTMLButtonElement>('[data-when]');
    const catButtons = bar.querySelectorAll<HTMLButtonElement>('[data-category]');
    const freeButton = bar.querySelector<HTMLButtonElement>('[data-free]');
    const whereButtons = bar.querySelectorAll<HTMLButtonElement>('[data-where]');
    const status = bar.querySelector<HTMLElement>('[data-filter-status]');
    const active = bar.querySelector<HTMLElement>('[data-filter-active]');
    const activeWords = bar.querySelector<HTMLElement>('[data-filter-active-words]');
    const fold = bar.querySelector<HTMLElement>('[data-filter-fold]');
    const more = bar.querySelector<HTMLButtonElement>('[data-filter-more]');
    const moreCount = bar.querySelector<HTMLElement>('[data-filter-more-count]');
    const setFold = (open: boolean) => {
      fold?.classList.toggle('max-sm:hidden', !open);
      more?.setAttribute('aria-expanded', String(open));
    };
    more?.addEventListener('click', () => setFold(more.getAttribute('aria-expanded') !== 'true'));

    const WHEN = new Set([...whenButtons].map((b) => b.dataset.when));
    const CATS = new Set([...catButtons].map((b) => b.dataset.category));
    const WHERE = new Set([...whereButtons].map((b) => b.dataset.where));

    // Denver days, as the listings store them. `now` is read once per apply so
    // a page left open overnight recomputes on the next click.
    const windowFor = (when: string) => {
      const now = new Date();
      const today = dayKey(startOfDay(now));
      if (when === 'today') return { from: today, to: today };
      if (when === 'week') return { from: today, to: dayKey(addDays(startOfDay(now), 6)) };
      if (when === 'weekend') {
        const { start, sunday } = weekendWindow(now);
        return { from: dayKey(start), to: dayKey(sunday) };
      }
      return null;
    };

    const matches = (item: HTMLElement, when: string, category: string, free: boolean, where: string) => {
      if (category !== 'all' && item.dataset.category !== category) return false;
      if (free && item.dataset.free !== 'true') return false;
      if (where !== 'all' && item.dataset.subTown !== where) return false;
      const window = windowFor(when);
      if (!window) return true;
      // An event overlaps the window when it starts no later than the window
      // ends and is still on when the window begins — so a ten-day run shows
      // under Today, and Saturday's fair shows under This weekend.
      const start = item.dataset.startDay ?? '';
      const last = item.dataset.eventDay ?? start;
      return start <= window.to && last >= window.from;
    };

    const apply = (when: string, category: string, free: boolean, where: string, push: boolean) => {
      for (const b of whenButtons) b.setAttribute('aria-pressed', String(b.dataset.when === when));
      for (const b of catButtons) b.setAttribute('aria-pressed', String(b.dataset.category === category));
      freeButton?.setAttribute('aria-pressed', String(free));
      for (const b of whereButtons) b.setAttribute('aria-pressed', String(b.dataset.where === where));
      const items = root.querySelectorAll<HTMLElement>(ITEM);
      for (const item of items) item.hidden = !matches(item, when, category, free, where);
      for (const group of root.querySelectorAll<HTMLElement>('[data-filter-group]')) {
        group.hidden = !group.querySelector(`${ITEM}:not([hidden])`);
      }
      // A whole section (the fortnight, "further out") with nothing left says
      // so once, rather than leaving a heading over nothing.
      for (const section of root.querySelectorAll<HTMLElement>('[data-filter-section]')) {
        section.hidden = !section.querySelector(`${ITEM}:not([hidden])`);
      }
      // A day in the strip whose listings are all hidden would scroll to nothing.
      for (const link of root.querySelectorAll<HTMLElement>('[data-day-link]')) {
        const day = root.querySelector<HTMLElement>(`[data-filter-group][data-day="${link.dataset.dayLink}"]`);
        link.hidden = !!day && day.hidden;
      }
      const empty = root.querySelector<HTMLElement>('[data-filter-empty]');
      if (empty) empty.hidden = !!root.querySelector(`${ITEM}:not([hidden])`);
      const whenLabel = bar.querySelector(`[data-when="${when}"]`)?.textContent?.trim().toLowerCase() ?? '';
      const catLabel = category === 'all' ? 'all categories' : (bar.querySelector(`[data-category="${category}"]`)?.textContent?.trim().toLowerCase() ?? category);
      const whereLabel = where === 'all' ? '' : `, in ${bar.querySelector(`[data-where="${where}"]`)?.textContent?.trim() ?? where}`;
      const on = when !== 'any' || category !== 'all' || free || where !== 'all';
      if (status) {
        const shown = root.querySelectorAll(`${ITEM}:not([hidden])`).length;
        status.textContent = `${shown} ${shown === 1 ? 'event' : 'events'}, ${whenLabel}, ${catLabel}${free ? ', free' : ''}${whereLabel}`;
      }
      // The line under the pills: what is set, and the way back.
      if (active) active.hidden = !on;
      if (activeWords) activeWords.textContent = [when !== 'any' ? whenLabel : '', category !== 'all' ? catLabel : '', free ? 'free' : '', whereLabel.replace(/^, /, '')].filter(Boolean).join(', ');
      // The highlights lead the whole list only; a filtered list is the list alone.
      const highlights = root.querySelector<HTMLElement>('[data-filter-highlights]');
      if (highlights) highlights.hidden = on;
      // A phone's folded rows: how many of them are set, on the button.
      const folded = (category !== 'all' ? 1 : 0) + (free ? 1 : 0) + (where !== 'all' ? 1 : 0);
      if (moreCount) moreCount.textContent = folded > 0 ? ` (${folded} on)` : '';
      if (push) {
        const url = new URL(location.href);
        if (when === 'any') url.searchParams.delete('when');
        else url.searchParams.set('when', when);
        if (category === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', category);
        if (free) url.searchParams.set('free', '1');
        else url.searchParams.delete('free');
        if (where === 'all') url.searchParams.delete('where');
        else url.searchParams.set('where', where);
        history.replaceState(null, '', url);
      }
    };

    let when = 'any';
    let category = 'all';
    let free = false;
    // Which of a multi-town guide's towns; 'all' on every other guide.
    let where = 'all';
    for (const b of whenButtons) {
      b.addEventListener('click', () => {
        when = b.dataset.when ?? 'any';
        apply(when, category, free, where, true);
      });
    }
    for (const b of catButtons) {
      b.addEventListener('click', () => {
        category = b.dataset.category ?? 'all';
        apply(when, category, free, where, true);
      });
    }
    freeButton?.addEventListener('click', () => {
      free = !free;
      apply(when, category, free, where, true);
    });
    for (const b of whereButtons) {
      b.addEventListener('click', () => {
        where = b.dataset.where ?? 'all';
        apply(when, category, free, where, true);
      });
    }

    // "Everything, any time" means exactly that, from either button.
    for (const reset of root.querySelectorAll<HTMLButtonElement>('[data-filter-reset]')) {
      reset.addEventListener('click', () => {
        when = 'any';
        category = 'all';
        free = false;
        where = 'all';
        apply(when, category, free, where, true);
        whenButtons[0]?.focus();
      });
    }

    // A shared or bookmarked link. Unknown values fall back to the defaults
    // rather than pressing nothing. ?when=free is the old spelling of ?free=1;
    // ?where=firestone is a sub-town on a multi-town guide.
    const params = new URLSearchParams(location.search);
    const w = params.get('when');
    const c = params.get('category');
    const sub = params.get('where');
    if (w && WHEN.has(w)) when = w;
    if (w === 'free' || params.get('free') === '1') free = true;
    if (c && CATS.has(c)) category = c;
    if (sub && WHERE.has(sub)) where = sub;
    if (category !== 'all' || free || where !== 'all') setFold(true);
    apply(when, category, free, where, false);
  }
</script>
