---
/**
 * The weekly email signup: the one form, wherever a reader meets it.
 *
 * For this model the email is the product: a brewery will pay for nine hundred
 * verified Erie inboxes long before it pays for an unknown number of
 * pageviews, and it is the number that goes on the media kit. Every visit
 * without it is a cold acquisition.
 *
 * Inline, never a modal. A popup on a community guide reads as spam and costs
 * the trust the independence framing buys — which is the whole asset.
 *
 * The boxes are the email's editions (src/lib/editions.ts), one per issue a
 * reader can get: most are one guide, a few are guides that share an issue
 * ("Windsor, Severance and Timnath"). Each box posts a town tag, and an
 * edition goes to every tag in it. On a guide the reader's edition starts
 * ticked, posting that guide's own tag so the tags still say where readers
 * signed up, and the rest sit behind "Show all towns"; elsewhere a shared
 * edition's box posts its lead town's tag, and on the hub nothing is ticked. No
 * form sends without at least one town, the hub's rule everywhere: an
 * untagged subscriber gets no issue at all.
 *
 * On a guide the address comes first and the town is already ticked, so
 * the usual signup is an address and a press. Where the site's build has a
 * Buttondown key, the press posts to the site's own /api/subscribe and the
 * page stays put: Buttondown sends its confirmation email and the page says
 * to click it (src/lib/subscribe.ts). Without a key, or when that call does
 * not go through, the form posts to the provider's hosted flow in a new tab
 * (no key in the page, no address in a URL), its "Verify and Subscribe"
 * page and then the email, as every form did before (owner, 25 October
 * 2026: too many steps lost readers). Either way the page never says the
 * reader is subscribed, which it cannot see (src/lib/signup.ts).
 *
 * Dark until `newsletter` is set on the hub config, so nothing here is a
 * half-built promise while the provider account is being sorted. Dark too
 * on a guide the email does not cover (a quiet guide, a visitor guide), and
 * such a guide is no box on anyone else's: the email is a weekly promise,
 * and that guide is not being covered weekly.
 */
import { editionFor, emailEditions, getNetworkHub, liveTowns, type TownConfig } from '@/config';
import { inlineSignup, SIGNUP_MESSAGES } from '@/lib/signup';
import { EMAIL_PROMISE, PRIVACY_LINE } from '@/lib/privacy';
import { nextSendDay } from '@/lib/newsletter';
import { latestIssueFor } from '@/lib/issues';
import { dayKey, formatMonthDay, parseLocal } from '@/lib/dates';
import { nextIssueWords, sendInstant } from '@/lib/next-issue';

interface Props {
  /** On a town site: pre-tick that town and write the copy about it. */
  town?: TownConfig;
  /** A quieter version for the foot of a page. */
  compact?: boolean;
  /** Where on the page it sits, when two forms share one: keeps the field ids apart. */
  id?: string;
  /**
   * The flagship home page's panel (redesign of 22 October 2026): the
   * town's colour behind white type, the button in the amber. The same
   * form, the same boxes; only the surface and the opening line change.
   */
  dark?: boolean;
  /**
   * The home page's card (the homepage brief, 25 October 2026; the design
   * pass, 26 October 2026): beside "Things to know", the reader's own town
   * only and no town picker, with `anchor` as its id for the week's email
   * item. The same form, the same post and the same script as every other.
   *
   * `home` (the homepage redesign brief, 27 October 2026): the card with
   * the short words: "Your Thursday local.", one line, the field, the
   * button and "Free. Unsubscribe anytime." with the word privacy linked;
   * the privacy paragraph is the privacy page's.
   *
   * `hub` (the hub home's redesign, 13 November 2026; on its blue band
   * since the publication redesign of 14 November): one town from a list
   * of the weekly editions, the address and "Sign up", white on the hub's
   * primary. Until 14 November it subscribed to every town by default;
   * the owner's board has a reader start with one and add others from any
   * form, which adds towns to an address already on the list. The page
   * sets the heading above it, and its line about the towns goes in the
   * slot. The full town picker stays on /newsletter/.
   */
  variant?: 'card' | 'home' | 'hub';
  anchor?: string;
  /**
   * The form alone: no heading, no opening line and no card around it, for
   * a page that sets those itself. The hub's home (the fixes brief of 13
   * November 2026) puts its heading beside the form on a wide screen and
   * draws the card around both on a phone, so the one form serves both.
   */
  bare?: boolean;
  /** The space around it, where the page has no wrapper of its own: nothing is drawn on a guide the email does not cover, so a wrapper's margin would be left standing. */
  class?: string;
}

const { town, compact = false, id, dark = false, variant, anchor, bare = false, class: className } = Astro.props;
const hub = getNetworkHub();
const config = hub.newsletter;
// A to Z by name, as on the hub's home page and in the footer, so the same
// names are in the same order wherever a reader meets them.
const editions = emailEditions();
const mine = town ? editionFor(town.slug, editions) : undefined;
const others = mine ? editions.filter((e) => e !== mine) : editions;
// Which towns a box stands for, for the hub's ?towns= link to tick it.
const covers = (e: (typeof editions)[number]) => e.towns.map((t) => t.slug).join(' ');
const day = config?.sendDay ?? 'Thursday';
const card = variant === 'card' || variant === 'home';
const hubHome = variant === 'hub' && !town;
const home = variant === 'home';
const sendTime = config?.sendTime;
const emailField = config?.emailField ?? 'email';
const tagField = config?.tagField ?? 'tag';
const where = mine ? mine.name : 'the towns';
/**
 * A guide that lists no events (`lead: 'updates'`, Niwot) has no weekly
 * issue, and until 12 November 2026 no form: a reader could not ask to be
 * told when an update was posted. It has the short form now, under other
 * words: occasional updates, never "every Thursday" or a next issue. The
 * tag is the town's own, and an issue filed with `towns: [niwot]` goes to
 * it (scripts/lib/send-newsletter.ts).
 */
const updatesOnly = !!town && !mine && town.lead === 'updates';
// Two of these can sit on one page (an issue page shows the compact one), and
// two inputs sharing an id is a broken label, not a cosmetic slip.
const fieldKey = id ?? (compact ? 'compact' : 'main');
const inputId = `newsletter-email-${fieldKey}-${town?.slug ?? 'network'}`;
const errorId = `newsletter-towns-${fieldKey}-${town?.slug ?? 'network'}`;
const emailErrorId = `newsletter-email-error-${fieldKey}-${town?.slug ?? 'network'}`;
const selectId = `newsletter-town-${fieldKey}-${town?.slug ?? 'network'}`;
// Sign up from the page where the build has a Buttondown key; only whether
// it is set is read here (src/lib/signup.ts). From the build's own
// environment: Astro's import.meta.env carries only the variables it knows
// of, and a reference to this one would write its value into the build.
const inline = inlineSignup(process.env);
const field = [
  'block h-12 w-full rounded-md border border-field-line bg-raised px-3 text-[1.0625rem] font-normal text-ink',
  !home && 'mt-1.5',
];
const muted = dark ? 'text-white' : 'text-ink-muted';
/**
 * The reason to come back, as a date: "Thursday, November 12 at 7 am", the
 * next send day on or after the build's day (the sites rebuild every
 * morning, so the day is right; on the send day itself the words are
 * "today", true before and after the hour). And the evidence beside it on
 * a guide: the last issue that went out for this town, on the hub's
 * archive, read from the files (src/lib/issues.ts). No issue yet, no link
 * (the sweep of 10 November 2026: every form said "every Thursday" and none
 * said which, or showed one).
 */
const now = new Date();
// The send as an instant, so "today" ends at 7 am, not at midnight, and the
// page's script can say it again for the reader's moment (src/lib/next-issue.ts;
// the audit of 13 November 2026).
const sendAt = sendInstant(nextSendDay(now, day), sendTime);
const nextIssue = nextIssueWords(sendAt, now, sendTime);
// Not on a guide whose form is for occasional updates: its last issue in
// the archive is a weekly one from before (Niwot, 5 November 2026), and
// "last Thursday's issue" promised a product it no longer has (the audit
// of 13 November 2026).
const lastIssue = town && !(town.lead === 'updates' && !editionFor(town.slug, editions)) ? latestIssueFor(town.slug, dayKey(now)) : undefined;
/**
 * What the weekly email holds, in one set of words on every form (the
 * audit of 13 November 2026: the home's strip, the card and the full form
 * each said it differently).
 */
const what = `the weekend’s events${town?.school ? ', the scores' : ''}, places that opened or closed${town ? ` in ${where}` : ''}, and a new article when there is one`;
/**
 * On the hub's form: the guides whose email is not the weekly one but
 * occasional local updates (Niwot), with the way to their own signup.
 */
const occasional = town ? [] : liveTowns().filter((t) => t.lead === 'updates' && !editionFor(t.slug, editions));
const lastIssueHref = lastIssue ? `https://${hub.domain}/newsletter/${lastIssue.slug}/` : undefined;
// "Last Thursday's" only when it was: Carbon Valley's form said it of the
// 29 October issue on 14 November (the review of that day). An older one
// is named by its date.
const lastIssueWords = lastIssue
  ? (Date.parse(`${dayKey(now)}T12:00:00Z`) - Date.parse(`${lastIssue.date}T12:00:00Z`)) / 86_400_000 <= 7
    ? `Read last ${day}’s issue`
    : `Read the ${formatMonthDay(parseLocal(lastIssue.date))} issue`
  : undefined;
const link = dark ? 'text-white underline' : 'text-primary underline';
// Every row a full 44px to tap, the box itself 20px.
const row = 'flex min-h-11 items-center gap-2.5 text-[0.9375rem]';
const box = 'size-5 shrink-0 rounded border-line';
---
{/* One width and one alignment wherever it appears: it was centred at 630px
    on the home page, the full width of the events page with its right half
    empty, and left at 715px on This Weekend.

    The short form (`home`) is a strip, not a card: the owner, 7 November
    2026, on the live home page, where the card stood 424px tall on a
    desktop and 457px on a phone, taller than the photographs under it. It
    takes the width of the column it sits in, and where that column is
    48rem or more the words sit on the left and the field and the button on
    the right, on one row (a container query, so This week, Events and
    Families, whose columns differ, each get the row only where it fits). */}
{/* The updates form is the short one only: the fuller layouts list a weekly edition's towns. */}
{config && hubHome && (
  <section id={anchor} data-signup-section data-pagefind-ignore class={className}>
    <form action={config.action} method="POST" target="_blank" data-signup data-hub="" data-inline={inline ? '' : undefined} data-send-day={day}>
      {/* One town to start (the owner's home board, 14 November 2026): each
          edition once, posting its lead town's tag as the hub's full picker
          does. An address already on the list has the new town added, never
          one taken away (src/lib/subscribe.ts, existing), so a reader adds
          the others from any form, /newsletter/'s picker or a guide's. */}
      <label for={selectId} class="mt-5 block text-[0.9412rem] font-[650] text-white">Your town</label>
      <div class="relative mt-2">
        <select id={selectId} name={tagField} required aria-describedby={errorId} class="block h-12 w-full cursor-pointer appearance-none rounded-[2px] border-0 bg-raised pl-3.5 pr-10 text-[0.9412rem] text-ink">
          <option value="">Choose a town</option>
          {[...editions].sort((a, b) => a.name.localeCompare(b.name)).map((e) => <option value={e.towns[0]!.slug} data-towns={covers(e)}>{e.name}</option>)}
        </select>
        <svg class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-ink" width="12" height="8" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1 1.5l5 5 5-5"></path></svg>
      </div>
      <p id={errorId} data-towns-error hidden aria-live="polite" class="mt-2 text-base font-semibold text-white">{SIGNUP_MESSAGES['need-town']}</p>
      <label for={inputId} class="mt-3.5 block text-[0.9412rem] font-[650] text-white">Your email</label>
      <div class="mt-2 flex">
        <input id={inputId} type="email" name={emailField} required autocomplete="email" placeholder="you@example.com" aria-describedby={emailErrorId} class="block h-12 min-w-0 flex-1 rounded-l-[2px] border-0 bg-raised px-3.5 text-[0.9412rem] text-ink placeholder:text-ink-muted" />
        <button type="submit" data-signup-button class="h-12 shrink-0 cursor-pointer rounded-r-[2px] border-0 bg-paper px-[18px] text-base font-[650] text-primary hover:bg-raised">Sign up</button>
      </div>
      <p id={emailErrorId} data-email-error hidden aria-live="polite" class="mt-2 text-base font-semibold text-white">{SIGNUP_MESSAGES.invalid}</p>
      <slot />
    </form>
    <div data-signup-done hidden tabindex="-1" class="mt-5 text-white">
      <p class="text-base font-semibold leading-[1.45]" data-signup-title>{SIGNUP_MESSAGES.opened}</p>
      <p class="mt-2 text-meta leading-[1.5]" data-signup-help>{SIGNUP_MESSAGES.openedHelp}</p>
      <p class="mt-2 flex flex-wrap gap-x-6">
        <button type="button" class="inline-flex min-h-11 cursor-pointer items-center border-0 bg-transparent p-0 text-meta font-semibold text-white underline decoration-1 underline-offset-[3px]" data-signup-reopen>{SIGNUP_MESSAGES.reopen}</button>
        <button type="button" class="inline-flex min-h-11 cursor-pointer items-center border-0 bg-transparent p-0 text-meta font-semibold text-white underline decoration-1 underline-offset-[3px]" data-signup-edit>Change your details</button>
      </p>
    </div>
  </section>
)}
{config && !hubHome && (!town || mine || (updatesOnly && home)) && (
  <section id={anchor} data-signup-section data-pagefind-ignore class:list={bare ? [className, 'scroll-mt-6'] : [className, home ? '@container rounded-lg px-4 py-4 sm:px-6 sm:py-5' : 'max-w-3xl rounded-lg p-6 md:p-8', 'scroll-mt-6', dark ? 'on-dark bg-primary text-white' : ['bg-raised ring-1', compact ? 'ring-line-soft' : 'ring-primary-line']]}>
    {/*
      A new tab keeps the reader on the page they were reading, and the
      browser opens it from target="_blank" itself (src/lib/signup.ts says
      why the script no longer does). No rel="noopener": Astro's
      FormHTMLAttributes does not carry it, Buttondown's page sends
      Cross-Origin-Opener-Policy: same-origin, which cuts the tie anyway,
      and the only host this can ever post to is one the CSP form-action
      allowlist names, which validate-content.ts checks against the config
      on every build.
    */}
    <form action={config.action} method="POST" target="_blank" class:list={[home ? '@3xl:grid @3xl:grid-cols-[minmax(0,1fr)_minmax(0,29rem)] @3xl:items-center @3xl:gap-x-6' : 'max-w-xl']} data-signup data-hub={town ? undefined : ''} data-inline={inline ? '' : undefined} data-send-day={day}>
      {home ? (
        <Fragment>
          <div class="@3xl:row-span-3">
            {updatesOnly ? (
              <Fragment>
                <h2 class="display-md text-[1.5rem] leading-tight @3xl:text-[1.75rem]">{town!.name} updates, by email.</h2>
                <p class="mt-1 text-[1rem] leading-snug text-balance text-ink-muted" data-updates-signup>An occasional email, sent only when there is a local update: a closure, a vote, a change to a service. Not weekly, and no events.</p>
              </Fragment>
            ) : (
              <Fragment>
                <h2 class="display-md text-[1.5rem] leading-tight @3xl:text-[1.75rem]">Your {day} local.</h2>
                <p class="mt-1 text-[1rem] leading-snug text-balance text-ink-muted">Next issue <span data-next-issue data-send-at={sendAt.toISOString()} data-send-time={sendTime}>{nextIssue}</span>: {what}.</p>
              </Fragment>
            )}
          </div>
          {town && mine && <input type="checkbox" name={tagField} value={town.slug} checked hidden data-towns={covers(mine)} />}
          {updatesOnly && <input type="checkbox" name={tagField} value={town!.slug} checked hidden data-towns={town!.slug} />}
        </Fragment>
      ) : card ? (
        <Fragment>
          <p class="eyebrow">Every {day}{sendTime && `, ${sendTime}`}</p>
          <h2 class="display-md mt-2 text-[1.75rem] leading-tight">The week ahead in {town?.name}, in one email.</h2>
          {/* What the email is and how often, in plain words: the week, the
              scores where the guide follows a school, what opened and
              closed. No claim about coverage the edition does not make. */}
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-muted">Once a week, every {day}: {what}. Written by people who checked.</p>
          {/* The card is this town's email and nothing else: its one tag
              rides as a checked box the reader is not asked about, so the
              form's rule (no send without a town) holds as it does
              everywhere. */}
          {town && mine && <input type="checkbox" name={tagField} value={town.slug} checked hidden data-towns={covers(mine)} />}
        </Fragment>
      ) : bare ? null : (
        <Fragment><h2 class="display-md text-[1.75rem] leading-tight">{dark ? `${day} email: the week, the scores, what closed.` : `What’s on in ${where}, every ${day}`}</h2>
      <p class:list={['mt-2 text-[0.9375rem] leading-relaxed', muted]}>
        {/* The same promise /advertise/, /for-businesses/ and the privacy
            page make, in the same words: a sponsor line may sit beside the
            listings, labeled; the list is never shared. It said "No ads"
            while the partnership page sold a sponsor line in the email
            (audit, 22 October 2026). */}
        {dark ? EMAIL_PROMISE : <Fragment>One email a week, every {day}: {what}. Next issue <span data-next-issue data-send-at={sendAt.toISOString()} data-send-time={sendTime}>{nextIssue}</span>.</Fragment>}
      </p></Fragment>
      )}

      {/* On the hub the towns come first: there is no town to assume. */}
      {!town && (
        <fieldset class:list={[!bare && 'mt-5']} aria-describedby={errorId}>
          <legend class:list={['eyebrow', dark && 'text-white']}>Which towns?</legend>
          <Fragment>
            <p class="mt-1 text-[0.875rem] text-ink-muted">Pick as many as you like, or take the lot.</p>
            {/* "All towns" first and set apart, since it is not a town; the
                towns in columns, A to Z, each a full-height row to tap. */}
            {config.allTag && (
              <label class:list={[row, 'mt-3 border-b border-primary-line pb-2 font-semibold']}>
                <input type="checkbox" name={tagField} value={config.allTag} class={box} />
                All towns
              </label>
            )}
            <div class="mt-2 grid grid-cols-2 gap-x-5 sm:grid-cols-3">
              {others.map((e) => (
                <label class={row}>
                  <input type="checkbox" name={tagField} value={e.towns[0]!.slug} class={box} data-towns={covers(e)} />
                  {e.name}
                </label>
              ))}
            </div>
            <p id={errorId} data-towns-error hidden aria-live="polite" class="mt-2 text-[0.9375rem] font-semibold text-ink">
              {SIGNUP_MESSAGES['need-town-hub']}
            </p>
            {/* A guide with no weekly issue is not a box here; its own occasional updates are one link away (the audit of 13 November 2026). */}
            {occasional.map((t) => (
              <p class="mt-3 text-[0.875rem] leading-relaxed text-ink-muted" data-occasional={t.slug}>
                {t.name} has no weekly issue: its guide sends occasional local updates instead. <a href={`https://${t.domain}/#signup`} class="text-primary underline">Sign up on {t.siteTitle}</a>.
              </p>
            ))}
          </Fragment>
        </fieldset>
      )}

      {/* The short form names the field for a screen reader only: the
          placeholder and the button beside it say what it is for. */}
      <div class:list={[home ? 'mt-3 flex items-end gap-2 sm:gap-3 @3xl:col-start-2 @3xl:mt-0' : 'mt-5 sm:flex sm:items-end sm:gap-3']}>
        <div class:list={[home ? 'min-w-0 flex-1' : 'sm:flex-1']}>
          <label for={inputId} class:list={[home ? 'sr-only' : 'block text-sm font-semibold', dark && 'eyebrow text-white']}>{dark ? 'Email' : 'Your email'}</label>
          <input
            id={inputId}
            type="email"
            name={emailField}
            required
            autocomplete="email"
            placeholder="you@example.com"
            aria-describedby={emailErrorId}
            class:list={field}
          />
        </div>
        {/* The same height as the field beside it: the pill was 40px against a
            52px field, aligned at the bottom only. On the strip the button
            stays beside the field on a phone too, so there it says "Sign up"
            and the full words return from the sm width; the heading above
            already says which email. */}
        <button type="submit" data-signup-button class:list={[home ? 'btn h-12 shrink-0 justify-center px-4 sm:px-6' : 'btn mt-3 h-12 w-full justify-center px-6 sm:mt-0 sm:w-auto', dark ? 'bg-highlight text-ink hover:bg-highlight-ink' : 'btn-primary']}>{home ? (
          <Fragment><span class="sm:hidden">Sign up</span><span class="hidden sm:inline">{updatesOnly ? `Send me ${town!.name} updates` : `Send me ${day}’s email`}</span></Fragment>
        ) : <Fragment>Send me {dark || card ? `${day}’s` : `the ${day}`} email</Fragment>}</button>
      </div>
      <p id={emailErrorId} data-email-error hidden aria-live="polite" class:list={['mt-2 text-[0.9375rem] font-semibold', home && '@3xl:col-start-2']}>
        {SIGNUP_MESSAGES.invalid}
      </p>

      {/* On a guide its own town is ticked, so it follows the address: the
          usual answer needs nothing done, and the rest are one press away. */}
      {town && !card && (
        <fieldset class="mt-4" aria-describedby={errorId}>
          <legend class:list={['eyebrow', dark && 'text-white']}>Which towns?</legend>
          <Fragment>
            <label class:list={[row, 'mt-2 font-semibold']}>
              <input type="checkbox" name={tagField} value={town.slug} checked class={box} data-towns={covers(mine!)} />
              {mine!.name}
            </label>
            {/* The other guides, a disclosure rather than a dozen rows on every
                page: the reader's own town is the usual answer. Native, so it
                works without the script and with a keyboard. */}
            <details class="mt-1">
              <summary class:list={['inline-flex min-h-11 cursor-pointer items-center text-[0.9375rem] font-semibold', link]}>
                Show all towns
              </summary>
              <div class="mt-1 grid grid-cols-2 gap-x-5 sm:grid-cols-3">
                {others.map((e) => (
                  <label class={row}>
                    <input type="checkbox" name={tagField} value={e.towns[0]!.slug} class={box} data-towns={covers(e)} />
                    {e.name}
                  </label>
                ))}
                {config.allTag && (
                  <label class:list={[row, 'font-semibold']}>
                    <input type="checkbox" name={tagField} value={config.allTag} class={box} />
                    All towns
                  </label>
                )}
              </div>
            </details>
            <p id={errorId} data-towns-error hidden aria-live="polite" class="mt-2 text-[0.9375rem] font-semibold text-ink">
              {SIGNUP_MESSAGES['need-town']}
            </p>
          </Fragment>
        </fieldset>
      )}

      {home ? (
        <p class:list={['mt-2 text-[0.875rem] leading-relaxed @3xl:col-start-2', muted]}>
          Free. Unsubscribe anytime. <a href={`https://${hub.domain}/privacy/`} class:list={['inline-block -my-3 py-3', link]}>Privacy</a>.
          {lastIssueHref && <Fragment>{' '}<a href={lastIssueHref} class:list={['inline-block -my-3 py-3', link]}>{lastIssueWords}</a>.</Fragment>}
        </p>
      ) : (
        <p class:list={['mt-3 text-[0.875rem] leading-relaxed', muted]}>
          Free. One email a week. Unsubscribe any time. {PRIVACY_LINE} See the
          <a href={`https://${hub.domain}/privacy/`} class:list={['inline-block -my-3 py-3', link]}>privacy page</a>.
          {lastIssueHref && <Fragment>{' '}<a href={lastIssueHref} class:list={['inline-block -my-3 py-3', link]}>{lastIssueWords}</a>.</Fragment>}
        </p>
      )}
      {/* A page's own line about the email (the hub's "See a sample issue"),
          inside the card rather than loose underneath it. */}
      <slot />
    </form>
    {/* Shown in place of the form once it has been sent. Its words are the
        answer's (src/lib/signup.ts, SIGNUP_MESSAGES): check your email when
        Buttondown sent its confirmation; added, or already on the list,
        only when Buttondown says the subscriber is active; or finish on
        Buttondown's own page, in a new tab, when that is where it went or
        the page's own call did not go through. Never a success this page
        cannot see, and always the way back to the form. */}
    <div data-signup-done hidden tabindex="-1" class="max-w-xl text-[1.0625rem] leading-relaxed">
      <p class="font-semibold" data-signup-title>{SIGNUP_MESSAGES.opened}</p>
      <p class:list={['mt-2 text-[0.9375rem]', muted]} data-signup-help>{SIGNUP_MESSAGES.openedHelp}</p>
      <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-[0.9375rem]">
        <button type="button" class:list={['inline-flex min-h-11 items-center font-semibold', link]} data-signup-reopen>{SIGNUP_MESSAGES.reopen}</button>
        <button type="button" class:list={['inline-flex min-h-11 items-center font-semibold', link]} data-signup-edit>Change your details</button>
      </p>
    </div>
  </section>
)}

<script>
  // The next issue for the reader's moment, not the build's: after the
  // send, "today" becomes next week (src/lib/next-issue.ts).
  import { nextIssueWords } from '@/lib/next-issue';
  for (const el of document.querySelectorAll<HTMLElement>('[data-next-issue]')) {
    const at = new Date(el.dataset.sendAt ?? '');
    if (!Number.isNaN(at.getTime())) el.textContent = nextIssueWords(at, new Date(), el.dataset.sendTime || undefined);
  }
</script>

<script>
  import { panelFor, readAnswer, SIGNUP_MESSAGES, SIGNUP_RESULT_EVENT, signupOutcome, type SignupPanel, type SignupResult } from '@/lib/signup';

  const PANEL: Record<SignupPanel, { title: string; help: string; button?: string }> = {
    confirm: { title: SIGNUP_MESSAGES.confirm, help: SIGNUP_MESSAGES.confirmHelp },
    added: { title: SIGNUP_MESSAGES.added, help: SIGNUP_MESSAGES.addedHelp },
    already: { title: SIGNUP_MESSAGES.already, help: SIGNUP_MESSAGES.alreadyHelp },
    fallback: { title: SIGNUP_MESSAGES.fallback, help: SIGNUP_MESSAGES.fallbackHelp, button: SIGNUP_MESSAGES.continue },
    opened: { title: SIGNUP_MESSAGES.opened, help: SIGNUP_MESSAGES.openedHelp, button: SIGNUP_MESSAGES.reopen },
  };

  // No form sends without a town. Where the build has a Buttondown key
  // (data-inline) the press goes to the site's own /api/subscribe and the
  // page says what is left; otherwise, and whenever that call does not go
  // through, the browser posts the form to Buttondown's page in a new tab.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-signup]')) {
    const boxes = () => [...form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
    // The hub home's form names one town from a list rather than ticking boxes.
    const lists = () => [...form.querySelectorAll<HTMLSelectElement>('select[name]')];
    const towns = () => [...boxes().filter((b) => b.checked).map((b) => b.value), ...lists().map((l) => l.value).filter(Boolean)];
    const email = form.querySelector<HTMLInputElement>('input[type="email"]');
    const button = form.querySelector<HTMLButtonElement>('[data-signup-button]');
    const error = form.querySelector<HTMLElement>('[data-towns-error]');
    const emailError = form.querySelector<HTMLElement>('[data-email-error]');
    const done = form.parentElement?.querySelector<HTMLElement>('[data-signup-done]');
    const inline = form.dataset.inline !== undefined;
    let sending = false;
    // What became of a send, for TrackClicks to count (src/lib/signup.ts,
    // SignupResult): the result alone, never the address.
    const report = (result: SignupResult) => form.dispatchEvent(new CustomEvent(SIGNUP_RESULT_EVENT, { bubbles: true, detail: { result } }));
    // The next send goes to Buttondown's own page: the panel's button, or no key.
    let direct = false;
    const showForm = () => {
      if (done) done.hidden = true;
      form.hidden = false;
    };
    const showPanel = (panel: SignupPanel) => {
      if (!done) return;
      const words = PANEL[panel];
      const fill = (text: string) => text.replace('{email}', email?.value.trim() || 'your address').replace('{day}', form.dataset.sendDay ?? 'Thursday');
      const title = done.querySelector<HTMLElement>('[data-signup-title]');
      const help = done.querySelector<HTMLElement>('[data-signup-help]');
      const reopen = done.querySelector<HTMLButtonElement>('[data-signup-reopen]');
      if (title) title.textContent = fill(words.title);
      if (help) help.textContent = fill(words.help);
      if (reopen) {
        reopen.hidden = !words.button;
        reopen.textContent = words.button ?? '';
      }
      form.hidden = true;
      done.hidden = false;
      done.focus();
    };
    // An error is said, not only shown: a live region that goes from hidden
    // to shown with its words already in it is not read out by most screen
    // readers (the review of 14 November 2026), so the words go in after.
    const say = (el: HTMLElement | null, show: boolean) => {
      if (!el) return;
      if (!show) {
        el.hidden = true;
        return;
      }
      const words = (el.dataset.words ??= el.textContent?.trim() ?? '');
      el.textContent = '';
      el.hidden = false;
      setTimeout(() => (el.textContent = words), 50);
    };
    for (const box of [...boxes(), ...lists()]) {
      box.addEventListener('change', () => {
        if (error && towns().length > 0) say(error, false);
      });
    }
    email?.addEventListener('input', () => {
      say(emailError, false);
      email.removeAttribute('aria-invalid');
    });
    form.addEventListener('submit', async (event) => {
      const outcome = signupOutcome({ towns: towns(), sending });
      if (outcome === 'busy') {
        event.preventDefault();
        return;
      }
      say(error, outcome === 'need-town');
      if (outcome === 'need-town') {
        event.preventDefault();
        showForm();
        (lists()[0] ?? boxes()[0])?.focus();
        return;
      }
      sending = true;
      if (inline && !direct) {
        // From the page: the form's own fields, and the page it was on for
        // Buttondown's referrer. No answer at all is `unavailable`.
        event.preventDefault();
        // The markup, not the text: the strip's button holds two labels, one per width.
        const label = button?.innerHTML ?? '';
        if (button) {
          button.disabled = true;
          button.textContent = 'Sending…';
        }
        const body = new URLSearchParams();
        for (const [name, value] of new FormData(form)) if (typeof value === 'string') body.append(name, value);
        body.set('page', location.href.split('#')[0]!);
        let answer = readAnswer(null);
        try {
          // With the slash: the sites redirect a path without one (vercel.json trailingSlash).
          const res = await fetch('/api/subscribe/', { method: 'POST', body, headers: { Accept: 'application/json' } });
          answer = readAnswer(await res.json());
        } catch {
          // No answer: Buttondown's own form is offered below.
        }
        sending = false;
        if (button) {
          button.disabled = false;
          button.innerHTML = label;
        }
        report(answer);
        if (answer === 'invalid') {
          say(emailError, true);
          email?.setAttribute('aria-invalid', 'true');
          email?.focus();
          return;
        }
        showPanel(panelFor(answer));
        return;
      }
      // To Buttondown's page: the browser posts the form into a new tab once
      // this returns. The page changes after that, so nothing here can get in
      // the post's way, and `sending` turns away the second press of a
      // double click.
      direct = false;
      report('handed-off');
      setTimeout(() => showPanel('opened'));
    });
    // The panel's button: the same form, to Buttondown's own page, from the
    // press itself, so the browser opens the tab as it would for a link.
    done?.querySelector('[data-signup-reopen]')?.addEventListener('click', () => {
      sending = false;
      if (!form.checkValidity()) {
        showForm();
        form.reportValidity();
        return;
      }
      direct = true;
      form.requestSubmit();
    });
    done?.querySelector('[data-signup-edit]')?.addEventListener('click', () => {
      sending = false;
      showForm();
      email?.focus();
    });
  }
</script>
