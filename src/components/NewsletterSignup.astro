---
/**
 * The weekly email signup: the one form, wherever a reader meets it.
 *
 * For this model the email is the product: a brewery will pay for nine hundred
 * verified Erie inboxes long before it pays for an unknown number of
 * pageviews, and it is the number that goes on the media kit. Every visit
 * without it is a cold acquisition.
 *
 * Inline, never a modal. A popup on a community guide reads as spam and costs
 * the trust the independence framing buys — which is the whole asset.
 *
 * The towns are checkboxes everywhere now, one per live guide, each posting
 * the town's tag to the provider. On a guide the reader's town starts ticked
 * and the rest sit behind "Show all towns"; on the hub nothing is ticked. No
 * form sends without at least one town, the hub's rule everywhere: an
 * untagged subscriber gets no issue at all. It posts to the provider's hosted
 * flow in a new tab (no key in the page, no address in a URL), and this page
 * then says what is left to do there and never that the reader is subscribed,
 * which it cannot see (src/lib/signup.ts).
 *
 * Dark until `newsletter` is set on the hub config, so nothing here is a
 * half-built promise while the provider account is being sorted.
 */
import { getNetworkHub, liveTowns, type TownConfig } from '@/config';
import { SIGNUP_MESSAGES } from '@/lib/signup';
import { PRIVACY_LINE } from '@/lib/privacy';

interface Props {
  /** On a town site: pre-tick that town and write the copy about it. */
  town?: TownConfig;
  /** A quieter version for the foot of a page. */
  compact?: boolean;
  /** Where on the page it sits, when two forms share one: keeps the field ids apart. */
  id?: string;
}

const { town, compact = false, id } = Astro.props;
const hub = getNetworkHub();
const config = hub.newsletter;
// A to Z, as on the hub's home page and in the footer, so the same names are
// in the same order wherever a reader meets them.
const towns = [...liveTowns()].sort((a, b) => a.name.localeCompare(b.name));
const others = town ? towns.filter((t) => t.slug !== town.slug) : towns;
const day = config?.sendDay ?? 'Thursday';
const emailField = config?.emailField ?? 'email';
const tagField = config?.tagField ?? 'tag';
const where = town ? town.name : 'the Front Range';
// Two of these can sit on one page (an issue page shows the compact one), and
// two inputs sharing an id is a broken label, not a cosmetic slip.
const variant = id ?? (compact ? 'compact' : 'main');
const inputId = `newsletter-email-${variant}-${town?.slug ?? 'network'}`;
const errorId = `newsletter-towns-${variant}-${town?.slug ?? 'network'}`;
const field =
  'mt-1.5 block h-12 w-full rounded-md border border-line bg-raised px-3 text-[1.0625rem] font-normal';
// Every row a full 44px to tap, the box itself 20px.
const row = 'flex min-h-11 items-center gap-2.5 text-[0.9375rem]';
const box = 'size-5 shrink-0 rounded border-line';
---
{/* One width and one alignment wherever it appears: it was centred at 630px
    on the home page, the full width of the events page with its right half
    empty, and left at 715px on This Weekend. */}
{config && (
  <section class:list={['max-w-3xl rounded-lg bg-raised p-6 ring-1 md:p-8', compact ? 'ring-line-soft' : 'ring-primary-line']}>
    {/*
      A new tab keeps the reader on the page they were reading. No rel="noopener":
      Astro's FormHTMLAttributes does not carry it, and the only host this can
      ever post to is one the CSP form-action allowlist names, which
      validate-content.ts checks against the config on every build.
    */}
    <form action={config.action} method="POST" target="_blank" class="max-w-xl" data-signup data-hub={town ? undefined : ''}>
      <h2 class="display-md text-[1.75rem] leading-tight">What’s on in {where}, every {day}</h2>
      <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-muted">
        One email a week: the weekend’s events, places new to the guide or closed, and a new article when there is one.
      </p>

      <fieldset class="mt-5" aria-describedby={errorId}>
        <legend class="eyebrow">Which towns?</legend>
        {town ? (
          <Fragment>
            <label class:list={[row, 'mt-2 font-semibold']}>
              <input type="checkbox" name={tagField} value={town.slug} checked class={box} />
              {town.name}
            </label>
            {/* The other guides, a disclosure rather than a dozen rows on every
                page: the reader's own town is the usual answer. Native, so it
                works without the script and with a keyboard. */}
            <details class="mt-1">
              <summary class="inline-flex min-h-11 cursor-pointer items-center text-[0.9375rem] font-semibold text-primary underline">
                Show all towns
              </summary>
              <div class="mt-1 grid grid-cols-2 gap-x-5 sm:grid-cols-3">
                {others.map((t) => (
                  <label class={row}>
                    <input type="checkbox" name={tagField} value={t.slug} class={box} />
                    {t.name}
                  </label>
                ))}
                {config.allTag && (
                  <label class:list={[row, 'font-semibold']}>
                    <input type="checkbox" name={tagField} value={config.allTag} class={box} />
                    All towns
                  </label>
                )}
              </div>
            </details>
            <p id={errorId} data-towns-error hidden aria-live="polite" class="mt-2 text-[0.9375rem] font-semibold text-ink">
              {SIGNUP_MESSAGES['need-town']}
            </p>
          </Fragment>
        ) : (
          <Fragment>
            <p class="mt-1 text-[0.875rem] text-ink-muted">Pick as many as you like, or take the lot.</p>
            {/* "All towns" first and set apart, since it is not a town; the
                towns in columns, A to Z, each a full-height row to tap. */}
            {config.allTag && (
              <label class:list={[row, 'mt-3 border-b border-primary-line pb-2 font-semibold']}>
                <input type="checkbox" name={tagField} value={config.allTag} class={box} />
                All towns
              </label>
            )}
            <div class="mt-2 grid grid-cols-2 gap-x-5 sm:grid-cols-3">
              {others.map((t) => (
                <label class={row}>
                  <input type="checkbox" name={tagField} value={t.slug} class={box} />
                  {t.name}
                </label>
              ))}
            </div>
            <p id={errorId} data-towns-error hidden aria-live="polite" class="mt-2 text-[0.9375rem] font-semibold text-ink">
              {SIGNUP_MESSAGES['need-town-hub']}
            </p>
          </Fragment>
        )}
      </fieldset>

      <div class="mt-5 sm:flex sm:items-end sm:gap-3">
        <div class="sm:flex-1">
          <label for={inputId} class="block text-sm font-semibold">Your email</label>
          <input
            id={inputId}
            type="email"
            name={emailField}
            required
            autocomplete="email"
            placeholder="you@example.com"
            class={field}
          />
        </div>
        {/* The same height as the field beside it: the pill was 40px against a
            52px field, aligned at the bottom only. */}
        <button type="submit" class="btn btn-primary mt-3 h-12 w-full justify-center px-6 sm:mt-0 sm:w-auto">Send me the {day} email</button>
      </div>

      {/* Shown when the browser refuses the new tab: nothing has been sent. */}
      <div data-signup-blocked hidden role="alert" class="mt-4 rounded-md border border-line bg-raised px-4 py-3 text-[0.9375rem] leading-relaxed">
        <p>{SIGNUP_MESSAGES.blocked}</p>
        <button type="button" class="mt-2 inline-flex min-h-11 items-center font-semibold text-primary underline" data-signup-here>Continue in this tab</button>
      </div>

      <p class="mt-3 text-[0.8125rem] leading-relaxed text-ink-muted">
        Free. One email a week. Unsubscribe any time. {PRIVACY_LINE} See the
        <a href={`https://${hub.domain}/privacy/`} class="inline-block -my-3 py-3 text-primary underline">privacy page</a>.
      </p>
      {/* A page's own line about the email (the hub's "See a sample issue"),
          inside the card rather than loose underneath it. */}
      <slot />
    </form>
    {/* Shown in place of the form once it has gone to the provider. The
        provider's page, in a new tab, is where the signup actually finishes
        (a "Verify and Subscribe" step, then an email to confirm), so this
        says that rather than claiming a success this page cannot see, and
        keeps the way back: the tab again, or the form. */}
    <div data-signup-done hidden tabindex="-1" class="max-w-xl text-[1.0625rem] leading-relaxed">
      <p class="font-semibold">{SIGNUP_MESSAGES.opened}</p>
      <p class="mt-2 text-[0.9375rem] text-ink-muted">{SIGNUP_MESSAGES.openedHelp}</p>
      <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-[0.9375rem]">
        <button type="button" class="inline-flex min-h-11 items-center font-semibold text-primary underline" data-signup-reopen>Open the signup tab again</button>
        <button type="button" class="inline-flex min-h-11 items-center font-semibold text-primary underline" data-signup-edit>Change your details</button>
      </p>
    </div>
  </section>
)}

<script>
  import { submitSignup } from '@/lib/signup';

  // The provider's hosted page opens in a new tab and finishes the signup;
  // this page says what is left to do there. No form sends without a town.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-signup]')) {
    const boxes = () => [...form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
    const error = form.querySelector<HTMLElement>('[data-towns-error]');
    const blocked = form.querySelector<HTMLElement>('[data-signup-blocked]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const done = form.parentElement?.querySelector<HTMLElement>('[data-signup-done]');
    let sending = false;
    for (const box of boxes()) {
      box.addEventListener('change', () => {
        if (error && boxes().some((b) => b.checked)) error.hidden = true;
      });
    }
    const send = () => {
      const outcome = submitSignup(
        {
          towns: boxes().filter((b) => b.checked).map((b) => b.value),
          sending,
          openTab: (name) => window.open('about:blank', name),
          post: (target) => {
            form.target = target;
            // submit() sends without firing "submit" again; the checks above
            // are the ones a submit event would have made.
            form.submit();
          },
        },
        `signup-${Date.now()}`,
      );
      if (outcome === 'busy') return;
      if (error) error.hidden = outcome !== 'need-town';
      if (blocked) blocked.hidden = outcome !== 'blocked';
      if (outcome === 'need-town') {
        boxes()[0]?.focus();
        return;
      }
      if (outcome === 'blocked') return;
      // Sent: the second press of a double click finds the form gone and
      // the button off, and `sending` turns away anything already queued.
      sending = true;
      if (button) button.disabled = true;
      form.hidden = true;
      if (done) {
        done.hidden = false;
        done.focus();
      }
    };
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      send();
    });
    // Blocked: the same post, in this tab.
    form.querySelector('[data-signup-here]')?.addEventListener('click', () => {
      if (!form.reportValidity()) return;
      if (!boxes().some((b) => b.checked)) return send();
      form.target = '_self';
      form.submit();
    });
    // Sent: open the provider's tab again, or go back to the form.
    done?.querySelector('[data-signup-reopen]')?.addEventListener('click', () => {
      sending = false;
      if (!form.checkValidity()) {
        done.hidden = true;
        form.hidden = false;
        form.reportValidity();
        return;
      }
      send();
    });
    done?.querySelector('[data-signup-edit]')?.addEventListener('click', () => {
      sending = false;
      if (button) button.disabled = false;
      done.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>('input[type="email"]')?.focus();
    });
  }
</script>
