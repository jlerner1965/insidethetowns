---
/**
 * The weekly email signup: the one form, wherever a reader meets it.
 *
 * For this model the email is the product: a brewery will pay for nine hundred
 * verified Erie inboxes long before it pays for an unknown number of
 * pageviews, and it is the number that goes on the media kit. Every visit
 * without it is a cold acquisition.
 *
 * Inline, never a modal. A popup on a community guide reads as spam and costs
 * the trust the independence framing buys — which is the whole asset.
 *
 * The boxes are the email's editions (src/lib/editions.ts), one per issue a
 * reader can get: most are one guide, a few are guides that share an issue
 * ("Windsor, Severance and Timnath"). Each box posts a town tag, and an
 * edition goes to every tag in it. On a guide the reader's edition starts
 * ticked, posting that guide's own tag so the tags still say where readers
 * signed up, and the rest sit behind "Show all towns"; elsewhere a shared
 * edition's box posts its lead town's tag, and on the hub nothing is ticked. No
 * form sends without at least one town, the hub's rule everywhere: an
 * untagged subscriber gets no issue at all.
 *
 * On a guide the address comes first and the town is already ticked, so
 * the usual signup is an address and a press. Where the site's build has a
 * Buttondown key, the press posts to the site's own /api/subscribe and the
 * page stays put: Buttondown sends its confirmation email and the page says
 * to click it (src/lib/subscribe.ts). Without a key, or when that call does
 * not go through, the form posts to the provider's hosted flow in a new tab
 * (no key in the page, no address in a URL), its "Verify and Subscribe"
 * page and then the email, as every form did before (owner, 25 October
 * 2026: too many steps lost readers). Either way the page never says the
 * reader is subscribed, which it cannot see (src/lib/signup.ts).
 *
 * Dark until `newsletter` is set on the hub config, so nothing here is a
 * half-built promise while the provider account is being sorted. Dark too
 * on a guide the email does not cover (a quiet guide, a visitor guide), and
 * such a guide is no box on anyone else's: the email is a weekly promise,
 * and that guide is not being covered weekly.
 */
import { editionFor, emailEditions, getNetworkHub, type TownConfig } from '@/config';
import { inlineSignup, SIGNUP_MESSAGES } from '@/lib/signup';
import { EMAIL_PROMISE, PRIVACY_LINE } from '@/lib/privacy';

interface Props {
  /** On a town site: pre-tick that town and write the copy about it. */
  town?: TownConfig;
  /** A quieter version for the foot of a page. */
  compact?: boolean;
  /** Where on the page it sits, when two forms share one: keeps the field ids apart. */
  id?: string;
  /**
   * The flagship home page's panel (redesign of 22 October 2026): the
   * town's colour behind white type, the button in the amber. The same
   * form, the same boxes; only the surface and the opening line change.
   */
  dark?: boolean;
  /**
   * The home page's card (the homepage brief, 25 October 2026; the design
   * pass, 26 October 2026): beside "Things to know", the reader's own town
   * only and no town picker, with `anchor` as its id for the week's email
   * item. The same form, the same post and the same script as every other.
   */
  variant?: 'card';
  anchor?: string;
}

const { town, compact = false, id, dark = false, variant, anchor } = Astro.props;
const hub = getNetworkHub();
const config = hub.newsletter;
// A to Z by name, as on the hub's home page and in the footer, so the same
// names are in the same order wherever a reader meets them.
const editions = emailEditions();
const mine = town ? editionFor(town.slug, editions) : undefined;
const others = mine ? editions.filter((e) => e !== mine) : editions;
// Which towns a box stands for, for the hub's ?towns= link to tick it.
const covers = (e: (typeof editions)[number]) => e.towns.map((t) => t.slug).join(' ');
const day = config?.sendDay ?? 'Thursday';
const card = variant === 'card';
const sendTime = config?.sendTime;
const emailField = config?.emailField ?? 'email';
const tagField = config?.tagField ?? 'tag';
const where = mine ? mine.name : 'the towns';
// Two of these can sit on one page (an issue page shows the compact one), and
// two inputs sharing an id is a broken label, not a cosmetic slip.
const fieldKey = id ?? (compact ? 'compact' : 'main');
const inputId = `newsletter-email-${fieldKey}-${town?.slug ?? 'network'}`;
const errorId = `newsletter-towns-${fieldKey}-${town?.slug ?? 'network'}`;
const emailErrorId = `newsletter-email-error-${fieldKey}-${town?.slug ?? 'network'}`;
// Sign up from the page where the build has a Buttondown key; only whether
// it is set is read here (src/lib/signup.ts). From the build's own
// environment: Astro's import.meta.env carries only the variables it knows
// of, and a reference to this one would write its value into the build.
const inline = inlineSignup(process.env);
const field =
  'mt-1.5 block h-12 w-full rounded-md border border-line bg-raised px-3 text-[1.0625rem] font-normal text-ink';
const muted = dark ? 'text-white/80' : 'text-ink-muted';
const link = dark ? 'text-white underline' : 'text-primary underline';
// Every row a full 44px to tap, the box itself 20px.
const row = 'flex min-h-11 items-center gap-2.5 text-[0.9375rem]';
const box = 'size-5 shrink-0 rounded border-line';
---
{/* One width and one alignment wherever it appears: it was centred at 630px
    on the home page, the full width of the events page with its right half
    empty, and left at 715px on This Weekend. */}
{config && (!town || mine) && (
  <section id={anchor} class:list={['max-w-3xl rounded-lg p-6 md:p-8', card && 'scroll-mt-6', dark ? 'on-dark bg-primary text-white' : ['bg-raised ring-1', compact ? 'ring-line-soft' : 'ring-primary-line']]}>
    {/*
      A new tab keeps the reader on the page they were reading, and the
      browser opens it from target="_blank" itself (src/lib/signup.ts says
      why the script no longer does). No rel="noopener": Astro's
      FormHTMLAttributes does not carry it, Buttondown's page sends
      Cross-Origin-Opener-Policy: same-origin, which cuts the tie anyway,
      and the only host this can ever post to is one the CSP form-action
      allowlist names, which validate-content.ts checks against the config
      on every build.
    */}
    <form action={config.action} method="POST" target="_blank" class="max-w-xl" data-signup data-hub={town ? undefined : ''} data-inline={inline ? '' : undefined} data-send-day={day}>
      {card ? (
        <Fragment>
          <p class="eyebrow">Every {day}{sendTime && `, ${sendTime}`}</p>
          <h2 class="display-md mt-2 text-[1.75rem] leading-tight">The week ahead in {town?.name}, in one email.</h2>
          {/* What the email is and how often, in plain words: the week, the
              scores where the guide follows a school, what opened and
              closed. No claim about coverage the edition does not make. */}
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-muted">Once a week, every {day}: the week’s events{town?.school ? ', the scores' : ''}, and what opened or closed in {town?.name}. Written by people who checked.</p>
          {/* The card is this town's email and nothing else: its one tag
              rides as a checked box the reader is not asked about, so the
              form's rule (no send without a town) holds as it does
              everywhere. */}
          {town && mine && <input type="checkbox" name={tagField} value={town.slug} checked hidden data-towns={covers(mine)} />}
        </Fragment>
      ) : (
        <Fragment><h2 class="display-md text-[1.75rem] leading-tight">{dark ? `${day} email: the week, the scores, what closed.` : `What’s on in ${where}, every ${day}`}</h2>
      <p class:list={['mt-2 text-[0.9375rem] leading-relaxed', muted]}>
        {/* The same promise /advertise/, /for-businesses/ and the privacy
            page make, in the same words: a sponsor line may sit beside the
            listings, labeled; the list is never shared. It said "No ads"
            while the partnership page sold a sponsor line in the email
            (audit, 22 October 2026). */}
        {dark ? EMAIL_PROMISE : 'One email a week: the weekend’s events, places new to the guide or closed, and a new article when there is one.'}
      </p></Fragment>
      )}

      {/* On the hub the towns come first: there is no town to assume. */}
      {!town && (
        <fieldset class="mt-5" aria-describedby={errorId}>
          <legend class:list={['eyebrow', dark && 'text-white']}>Which towns?</legend>
          <Fragment>
            <p class="mt-1 text-[0.875rem] text-ink-muted">Pick as many as you like, or take the lot.</p>
            {/* "All towns" first and set apart, since it is not a town; the
                towns in columns, A to Z, each a full-height row to tap. */}
            {config.allTag && (
              <label class:list={[row, 'mt-3 border-b border-primary-line pb-2 font-semibold']}>
                <input type="checkbox" name={tagField} value={config.allTag} class={box} />
                All towns
              </label>
            )}
            <div class="mt-2 grid grid-cols-2 gap-x-5 sm:grid-cols-3">
              {others.map((e) => (
                <label class={row}>
                  <input type="checkbox" name={tagField} value={e.towns[0]!.slug} class={box} data-towns={covers(e)} />
                  {e.name}
                </label>
              ))}
            </div>
            <p id={errorId} data-towns-error hidden aria-live="polite" class="mt-2 text-[0.9375rem] font-semibold text-ink">
              {SIGNUP_MESSAGES['need-town-hub']}
            </p>
          </Fragment>
        </fieldset>
      )}

      <div class="mt-5 sm:flex sm:items-end sm:gap-3">
        <div class="sm:flex-1">
          <label for={inputId} class:list={['block text-sm font-semibold', dark && 'eyebrow text-white']}>{dark ? 'Email' : 'Your email'}</label>
          <input
            id={inputId}
            type="email"
            name={emailField}
            required
            autocomplete="email"
            placeholder="you@example.com"
            aria-describedby={emailErrorId}
            class={field}
          />
        </div>
        {/* The same height as the field beside it: the pill was 40px against a
            52px field, aligned at the bottom only. */}
        <button type="submit" data-signup-button class:list={['btn mt-3 h-12 w-full justify-center px-6 sm:mt-0 sm:w-auto', dark ? 'bg-highlight text-ink hover:bg-highlight-ink' : 'btn-primary']}>Send me {dark || card ? `${day}’s` : `the ${day}`} email</button>
      </div>
      <p id={emailErrorId} data-email-error hidden aria-live="polite" class="mt-2 text-[0.9375rem] font-semibold">
        {SIGNUP_MESSAGES.invalid}
      </p>

      {/* On a guide its own town is ticked, so it follows the address: the
          usual answer needs nothing done, and the rest are one press away. */}
      {town && !card && (
        <fieldset class="mt-4" aria-describedby={errorId}>
          <legend class:list={['eyebrow', dark && 'text-white']}>Which towns?</legend>
          <Fragment>
            <label class:list={[row, 'mt-2 font-semibold']}>
              <input type="checkbox" name={tagField} value={town.slug} checked class={box} data-towns={covers(mine!)} />
              {mine!.name}
            </label>
            {/* The other guides, a disclosure rather than a dozen rows on every
                page: the reader's own town is the usual answer. Native, so it
                works without the script and with a keyboard. */}
            <details class="mt-1">
              <summary class:list={['inline-flex min-h-11 cursor-pointer items-center text-[0.9375rem] font-semibold', link]}>
                Show all towns
              </summary>
              <div class="mt-1 grid grid-cols-2 gap-x-5 sm:grid-cols-3">
                {others.map((e) => (
                  <label class={row}>
                    <input type="checkbox" name={tagField} value={e.towns[0]!.slug} class={box} data-towns={covers(e)} />
                    {e.name}
                  </label>
                ))}
                {config.allTag && (
                  <label class:list={[row, 'font-semibold']}>
                    <input type="checkbox" name={tagField} value={config.allTag} class={box} />
                    All towns
                  </label>
                )}
              </div>
            </details>
            <p id={errorId} data-towns-error hidden aria-live="polite" class="mt-2 text-[0.9375rem] font-semibold text-ink">
              {SIGNUP_MESSAGES['need-town']}
            </p>
          </Fragment>
        </fieldset>
      )}

      <p class:list={['mt-3 text-[0.875rem] leading-relaxed', muted]}>
        Free. One email a week. Unsubscribe any time. {PRIVACY_LINE} See the
        <a href={`https://${hub.domain}/privacy/`} class:list={['inline-block -my-3 py-3', link]}>privacy page</a>.
      </p>
      {/* A page's own line about the email (the hub's "See a sample issue"),
          inside the card rather than loose underneath it. */}
      <slot />
    </form>
    {/* Shown in place of the form once it has been sent. Its words are the
        answer's (src/lib/signup.ts, SIGNUP_MESSAGES): check your email when
        Buttondown sent its confirmation; added, only when Buttondown says
        the subscriber is active; Buttondown has the address already; or finish on
        Buttondown's own page, in a new tab, when that is where it went or
        the page's own call did not go through. Never a success this page
        cannot see, and always the way back to the form. */}
    <div data-signup-done hidden tabindex="-1" class="max-w-xl text-[1.0625rem] leading-relaxed">
      <p class="font-semibold" data-signup-title>{SIGNUP_MESSAGES.opened}</p>
      <p class:list={['mt-2 text-[0.9375rem]', muted]} data-signup-help>{SIGNUP_MESSAGES.openedHelp}</p>
      <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-[0.9375rem]">
        <button type="button" class:list={['inline-flex min-h-11 items-center font-semibold', link]} data-signup-reopen>{SIGNUP_MESSAGES.reopen}</button>
        <button type="button" class:list={['inline-flex min-h-11 items-center font-semibold', link]} data-signup-edit>Change your details</button>
      </p>
    </div>
  </section>
)}

<script>
  import { panelFor, readAnswer, SIGNUP_MESSAGES, signupOutcome, type SignupPanel } from '@/lib/signup';

  const PANEL: Record<SignupPanel, { title: string; help: string; button?: string }> = {
    confirm: { title: SIGNUP_MESSAGES.confirm, help: SIGNUP_MESSAGES.confirmHelp },
    added: { title: SIGNUP_MESSAGES.added, help: SIGNUP_MESSAGES.addedHelp },
    already: { title: SIGNUP_MESSAGES.already, help: SIGNUP_MESSAGES.alreadyHelp, button: SIGNUP_MESSAGES.continue },
    fallback: { title: SIGNUP_MESSAGES.fallback, help: SIGNUP_MESSAGES.fallbackHelp, button: SIGNUP_MESSAGES.continue },
    opened: { title: SIGNUP_MESSAGES.opened, help: SIGNUP_MESSAGES.openedHelp, button: SIGNUP_MESSAGES.reopen },
  };

  // No form sends without a town. Where the build has a Buttondown key
  // (data-inline) the press goes to the site's own /api/subscribe and the
  // page says what is left; otherwise, and whenever that call does not go
  // through, the browser posts the form to Buttondown's page in a new tab.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-signup]')) {
    const boxes = () => [...form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
    const email = form.querySelector<HTMLInputElement>('input[type="email"]');
    const button = form.querySelector<HTMLButtonElement>('[data-signup-button]');
    const error = form.querySelector<HTMLElement>('[data-towns-error]');
    const emailError = form.querySelector<HTMLElement>('[data-email-error]');
    const done = form.parentElement?.querySelector<HTMLElement>('[data-signup-done]');
    const inline = form.dataset.inline !== undefined;
    let sending = false;
    // The next send goes to Buttondown's own page: the panel's button, or no key.
    let direct = false;
    const showForm = () => {
      if (done) done.hidden = true;
      form.hidden = false;
    };
    const showPanel = (panel: SignupPanel) => {
      if (!done) return;
      const words = PANEL[panel];
      const fill = (text: string) => text.replace('{email}', email?.value.trim() || 'your address').replace('{day}', form.dataset.sendDay ?? 'Thursday');
      const title = done.querySelector<HTMLElement>('[data-signup-title]');
      const help = done.querySelector<HTMLElement>('[data-signup-help]');
      const reopen = done.querySelector<HTMLButtonElement>('[data-signup-reopen]');
      if (title) title.textContent = fill(words.title);
      if (help) help.textContent = fill(words.help);
      if (reopen) {
        reopen.hidden = !words.button;
        reopen.textContent = words.button ?? '';
      }
      form.hidden = true;
      done.hidden = false;
      done.focus();
    };
    for (const box of boxes()) {
      box.addEventListener('change', () => {
        if (error && boxes().some((b) => b.checked)) error.hidden = true;
      });
    }
    email?.addEventListener('input', () => {
      if (emailError) emailError.hidden = true;
    });
    form.addEventListener('submit', async (event) => {
      const outcome = signupOutcome({ towns: boxes().filter((b) => b.checked).map((b) => b.value), sending });
      if (outcome === 'busy') {
        event.preventDefault();
        return;
      }
      if (error) error.hidden = outcome !== 'need-town';
      if (outcome === 'need-town') {
        event.preventDefault();
        showForm();
        boxes()[0]?.focus();
        return;
      }
      sending = true;
      if (inline && !direct) {
        // From the page: the form's own fields, and the page it was on for
        // Buttondown's referrer. No answer at all is `unavailable`.
        event.preventDefault();
        const label = button?.textContent ?? '';
        if (button) {
          button.disabled = true;
          button.textContent = 'Sending…';
        }
        const body = new URLSearchParams();
        for (const [name, value] of new FormData(form)) if (typeof value === 'string') body.append(name, value);
        body.set('page', location.href.split('#')[0]!);
        let answer = readAnswer(null);
        try {
          // With the slash: the sites redirect a path without one (vercel.json trailingSlash).
          const res = await fetch('/api/subscribe/', { method: 'POST', body, headers: { Accept: 'application/json' } });
          answer = readAnswer(await res.json());
        } catch {
          // No answer: Buttondown's own form is offered below.
        }
        sending = false;
        if (button) {
          button.disabled = false;
          button.textContent = label;
        }
        if (answer === 'invalid') {
          if (emailError) emailError.hidden = false;
          email?.focus();
          return;
        }
        showPanel(panelFor(answer));
        return;
      }
      // To Buttondown's page: the browser posts the form into a new tab once
      // this returns. The page changes after that, so nothing here can get in
      // the post's way, and `sending` turns away the second press of a
      // double click.
      direct = false;
      setTimeout(() => showPanel('opened'));
    });
    // The panel's button: the same form, to Buttondown's own page, from the
    // press itself, so the browser opens the tab as it would for a link.
    done?.querySelector('[data-signup-reopen]')?.addEventListener('click', () => {
      sending = false;
      if (!form.checkValidity()) {
        showForm();
        form.reportValidity();
        return;
      }
      direct = true;
      form.requestSubmit();
    });
    done?.querySelector('[data-signup-edit]')?.addEventListener('click', () => {
      sending = false;
      showForm();
      email?.focus();
    });
  }
</script>
