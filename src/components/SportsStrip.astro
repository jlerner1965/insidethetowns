---
/**
 * The week's games in a compact module: every team with a game in the next
 * seven days, soonest first, the last result in a line, a link to the
 * scores page. The team's colour stays inside this box (the school's
 * primary, set on the element), and a team out of season has no games and
 * is not here, so nothing is featured for being football in a month with no
 * football. Nothing to come at all, nothing rendered.
 */
import { schoolSportsFor, type SportsData } from '@/config/school-sports';
import { formatGameTime, latestResult, outcome, RESULT_WORD, schoolCssVars, sportsDataFor, weekGames, when, where } from '@/lib/school-sports';

interface Props {
  town: string;
  class?: string;
  /** How many games to list; the rest are on the sports page. */
  limit?: number;
}

const { town, class: className, limit = 4 } = Astro.props;
const files = import.meta.glob<SportsData>('../../data/*/sports*.json', { eager: true, import: 'default' });
const school = schoolSportsFor(town);
const data = school && sportsDataFor(school, files);
const games = data ? weekGames(data) : [];
const last = data ? latestResult(data) : undefined;
const now = new Date();
---
{school && data && (games.length > 0 || last) && (
  <section class:list={['rounded-lg bg-raised p-5 ring-1 ring-line-soft', className]} aria-labelledby="sports-strip" style={schoolCssVars(school)}>
    <h2 id="sports-strip" class="eyebrow border-b-2 border-primary-line pb-2">{school.mascot} this week</h2>
    {games.length > 0 ? (
      <ul class="mt-3 space-y-2.5">
        {games.slice(0, limit).map(({ team, game }) => (
          <li class="text-[0.9375rem] leading-snug">
            <span class="font-semibold">{team.name}</span> {where(game)} {game.opponent}
            <span class="block text-ink-muted">{when(game, now)}{game.time && ` · ${formatGameTime(game)}`}{game.site === 'home' ? ' · Home' : game.site === 'away' ? ' · Away' : ''}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-3 text-[0.9375rem] text-ink-muted">No games in the next seven days.</p>
    )}
    {last?.game.result && (
      <p class="mt-3 border-t border-line-soft pt-3 text-[0.875rem] text-ink-muted">
        Last out: {last.team.name.toLowerCase()} {RESULT_WORD[last.game.result].toLowerCase()} {outcome(last.game)}{last.team.overall && `, ${last.team.overall} this season`}
      </p>
    )}
    <p class="mt-3 text-[0.9375rem]"><a href="/sports/" class="inline-block -my-1 py-1 font-semibold text-primary underline">Scores and schedules →</a></p>
  </section>
)}
