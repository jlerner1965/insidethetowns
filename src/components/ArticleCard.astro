---
/**
 * Article teaser. `feature` lays the image beside the text for the home page.
 * `row` lays one story across the full width, a smaller picture beside the
 * text: the home page's second story, and a section of the guides page that
 * has only one, rather than a card stranded in the left half of a grid.
 *
 * A feature with no photograph is set as text across the full width, rather
 * than beside a tinted rectangle standing in for the picture that does not
 * exist. It used to sit under a heavy rule of its own, which doubled the
 * section header's rule just above it.
 */
import { Image } from 'astro:assets';
import type { TownEntry } from '@/lib/content';
import { formatDate, toIsoLocal } from '@/lib/dates';

interface Props {
  article: TownEntry<'articles'>;
  feature?: boolean;
  row?: boolean;
  /** Off under a heading that already names the category (the guides page). */
  showCategory?: boolean;
}

const { article, feature = false, row = false, showCategory = true } = Astro.props;
const { data, slug } = article;
const href = `/articles/${slug}/`;
const twoUp = feature && !!data.image;
const side = row && !feature && !!data.image;
---
<article
  class:list={[
    'group relative',
    twoUp && 'grid gap-6 md:grid-cols-[1.2fr_1fr] md:items-center md:gap-10',
    side && 'grid gap-4 sm:grid-cols-[2fr_3fr] sm:items-center sm:gap-8 md:grid-cols-[1fr_2fr] md:gap-10',
  ]}
>
  {data.image && (
    <div class:list={['overflow-hidden rounded-lg bg-accent-soft', feature ? 'aspect-[4/3]' : 'aspect-[16/10]']}>
      {/* h-full! for the same reason as the hero's: Astro's responsive image
          styles set height: auto outside any layer, which beats the utility,
          so a photograph wider than the box sat at the top of it over a band
          of empty tint. */}
      <Image
        src={data.image}
        alt={data.imageAlt ?? ''}
        width={feature ? 1200 : 800}
        height={feature ? 900 : 500}
        class="h-full! w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
      />
    </div>
  )}
  <div class:list={[!feature && !side && data.image && 'mt-4', feature && !data.image && 'max-w-3xl', row && 'max-w-2xl']}>
    <p class="eyebrow">
      {showCategory && <Fragment>{data.category} <span class="text-ink-faint">·</span> </Fragment>}<time datetime={toIsoLocal(data.date)} class="text-ink-muted">{formatDate(data.date)}</time>
    </p>
    {/* The feature steps down to 4xl on wide screens; a phone keeps 3xl,
        since at 2xl the tight display cut reads smaller than the 2xl title
        of the story under it. */}
    <h3 class:list={['mt-2 font-medium leading-tight', feature ? 'display text-3xl md:text-4xl' : 'text-2xl']}>
      <a href={href} class="stretch no-underline group-hover:text-accent-text">{data.title}</a>
    </h3>
    <p class:list={['mt-3 leading-relaxed text-ink-muted', feature ? 'text-lg' : 'text-[0.9375rem] line-clamp-3']}>{data.excerpt}</p>
    {feature && <p class="mt-5 text-[0.9375rem] font-semibold text-accent-text">Read the story →</p>}
  </div>
</article>
