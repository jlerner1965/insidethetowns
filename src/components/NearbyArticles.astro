---
/**
 * "Nearby": the hub's town-anchored articles for this place
 * (src/lib/curiosity.ts), as links and nothing else. On a hub town page
 * and at the foot of a standalone guide's /things-to-do/, beside "Near
 * <Town>". No line of an article is repeated here: the title, and where it
 * opens. Nothing is drawn for a place no article on the site names; a
 * draft is not on the site.
 */
import { getNetworkHub } from '@/config';
import { getCuriosity } from '@/lib/content';
import { TOPIC_INFO, articlePath, articlesFor, type CuriosityTopic } from '@/lib/curiosity';

interface Props {
  /** A hub town's slug or a standalone guide's key. */
  place: string;
  /** On the hub a link is a path; on a guide it is the hub's full address. */
  onHub?: boolean;
  class?: string;
}
const { place, onHub = false, class: className } = Astro.props;
const hub = getNetworkHub();
const articles = articlesFor(
  (await getCuriosity()).map((a) => a.data),
  place,
).map((a) => ({
  title: a.title,
  href: `${onHub ? '' : `https://${hub.domain}`}${articlePath(a)}`,
  label: a.kind === 'event' ? 'Event' : a.kind === 'story' ? 'News' : TOPIC_INFO[a.kind as CuriosityTopic].label,
}));
---
{articles.length > 0 && (
  <nav aria-labelledby="nearby-articles-h" class:list={['mb-12 md:mb-16', className]} data-nearby-articles>
    <h2 id="nearby-articles-h" class="eyebrow mb-3">Nearby</h2>
    <ul class="divide-y divide-line-soft rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
      {articles.map((a) => (
        <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5 py-3">
          <a href={a.href} class="font-heading text-xl font-medium text-ink no-underline hover:text-primary hover:underline">{a.title}</a>
          <span class="text-[0.9375rem] text-ink-muted">{a.label}{!onHub && ` · ${hub.siteTitle}`}</span>
        </li>
      ))}
    </ul>
  </nav>
)}
