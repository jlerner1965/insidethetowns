---
/**
 * "Nearby this weekend": a few picks from the towns next door, for the coming
 * Friday to Sunday. Nobody planning a Saturday cares which side of a town line
 * the market sits on.
 *
 * The neighbours are the town's own `neighbors` list, not a radius, and the
 * listings are theirs, read on purpose through getNeighborEntries: every card
 * says whose it is and opens on that town's own domain. The picks are
 * `nearbyPicks` (src/lib/events.ts): one-offs only, at most two per town.
 *
 * With no neighbours (Elizabeth) or nothing on, the block renders nothing at
 * all, not an empty state. Built days before it is read, the browser drops
 * what has passed (Freshness.astro), and removes the block too once nothing
 * is left in it.
 *
 * The sponsor slot at the top is the network sponsor, one value in the hub
 * config; unset, it is not there. A page that already carries the network
 * sponsor's line, /this-weekend/, passes `sponsor={false}` so it is not said
 * twice.
 */
import NetworkEventCard from './NetworkEventCard.astro';
import SectionHeader from './SectionHeader.astro';
import SponsorLine from './SponsorLine.astro';
import { getNetworkHub, neighborsOf, type TownConfig } from '@/config';
import { getNeighborEntries, type NetworkEntry } from '@/lib/content';
import { formatDayRange } from '@/lib/dates';
import { nearbyPicks, occurrences, weekendWindow } from '@/lib/events';

interface Props {
  town: TownConfig;
  /** Show the network sponsor's line at the top. */
  sponsor?: boolean;
  /** How many picks at most; the default is nearbyPicks's six. */
  limit?: number;
  /**
   * The picks, where the page has chosen them already (by the same
   * `nearbyPicks`) so that another block can leave them out: /this-week/
   * passes them here and keeps them out of the hill's strip. Otherwise
   * chosen here.
   */
  picks?: NetworkEntry<'events'>[];
  /**
   * The "Get your nearby towns every Thursday" link under the picks. Off on
   * a page that carries the email's form already (the home page, the events
   * page), so the email is offered once there, not three times.
   */
  signup?: boolean;
  class?: string;
}

const { town, sponsor = true, limit = 6, picks: given, signup: signupOn = true, class: className } = Astro.props;
const hub = getNetworkHub();
const neighbors = neighborsOf(town);
const now = new Date();
const picks =
  given ?? nearbyPicks(occurrences(await getNeighborEntries('events', neighbors), { now, horizonDays: 30 }), neighbors.map((t) => t.slug), { now, limit });
const { start, sunday } = weekendWindow(now);
const sponsorLine = sponsor ? hub.sponsors?.network : undefined;
// The signup preselects the towns named in `towns` (src/routes/hub/newsletter.astro).
const signup = signupOn && hub.newsletter
  ? `https://${hub.domain}/newsletter/?towns=${[town.slug, ...neighbors.map((t) => t.slug)].join(',')}`
  : undefined;
// The town's line ("Main Street, the St. Vrain Greenway and the breweries")
// under its first pick only; it was under every one, so Longmont's was read
// twice in a row.
const firstOf = new Set<string>();
const introduces = (slug: string) => (firstOf.has(slug) ? false : (firstOf.add(slug), true));
---
{picks.length > 0 && (
  <section class={className} data-hide-when-empty data-pagefind-ignore aria-labelledby="nearby-weekend">
    <SponsorLine sponsor={sponsorLine} label="Nearby this weekend, presented by" />
    <div class:list={[sponsorLine && 'mt-5']}>
      <SectionHeader id="nearby-weekend" eyebrow={formatDayRange(start, sunday)} title="Nearby this weekend" />
    </div>
    <div class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
      {picks.map((event) => <NetworkEventCard event={event} showDay showTagline={introduces(event.town.slug)} neutral />)}
    </div>
    {signup && (
      <p class="mt-4 text-[0.9375rem]">
        <a href={signup} class="inline-block -my-1 py-1 font-semibold text-primary underline">Get your nearby towns every {hub.newsletter?.sendDay ?? 'Thursday'} →</a>
      </p>
    )}
  </section>
)}
