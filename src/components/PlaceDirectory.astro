---
/**
 * The places on a page, as a directory.
 *
 * Any places that have been photographed lead the page, because a photograph
 * is the best thing on it, and the lead changes shape with how many there are
 * so it always fills the width. Everything, photographed or not, is then
 * listed as text rows, grouped by what kind of place it is: one flat run of
 * thirty-five rows is a wall, and the category headings give it a rhythm and
 * tell you how many of each the town has.
 */
import type { TownEntry } from '@/lib/content';
import { PLACE_TYPE_LABELS, PLACE_TYPE_PLURALS, PLACE_TYPES, type PlaceType } from '@/content/schemas';
import { PLACE_HUE } from '@/config/palette';
import { isOpen } from '@/lib/places';
import FilterBar from './FilterBar.astro';
import PlaceCard from './PlaceCard.astro';
import PlaceFeature from './PlaceFeature.astro';
import PlaceRow from './PlaceRow.astro';
import OpenStatus from './OpenStatus.astro';
import { getSite } from '@/config';
import { subTownsOf } from '@/lib/sub-towns';

interface Props {
  places: TownEntry<'places'>[];
  filterable?: boolean;
  emptyMessage?: string;
  /** Show up to this many photographed places above the list. */
  lead?: number;
  /** Names the list for screen readers, so the page does not jump h1 to h3. */
  heading?: string;
  /** A name search above the filters, part of the same filter (FilterBar.astro). */
  search?: boolean;
}

const { places, filterable = false, emptyMessage = 'Nothing listed yet.', lead = 3, heading, search = false } = Astro.props;

// PLACE_TYPES order, not the order the files happen to load in, so every town
// lists restaurants before bars before coffee.
const types = PLACE_TYPES.filter((t) => places.some((p) => p.data.type === t)) as PlaceType[];
const options = types.map((t) => ({ value: t, label: PLACE_TYPE_LABELS[t] }));
// The lead is the page's recommendation, and a closed place is not one.
const withPhoto = places.filter((p) => p.data.image && isOpen(p)).slice(0, lead);
const grouped = types.length > 1;
const groups = grouped
  ? types.map((type) => ({ type, label: PLACE_TYPE_PLURALS[type], items: places.filter((p) => p.data.type === type) }))
  : [{ type: types[0], label: '', items: places }];
const hueOf = (type: PlaceType | undefined) => (type ? PLACE_HUE[type] : undefined);
// On a multi-town guide the filter bar gets a second row, one pill per town.
const subTowns = subTownsOf(getSite());
---
<div data-filter-root>
  {heading && <h2 class="sr-only">{heading}</h2>}
  {withPhoto.length === 1 && <div class="mb-12"><PlaceFeature place={withPhoto[0]} /></div>}
  {withPhoto.length > 1 && (
    <div class:list={['mb-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:gap-x-8', withPhoto.length > 2 && 'lg:grid-cols-3']}>
      {withPhoto.map((place) => <PlaceCard place={place} />)}
    </div>
  )}
  {search && (
    <div class="mb-6 max-w-md">
      <label for="directory-search" class="eyebrow mb-2 block">Find by name</label>
      <input
        id="directory-search"
        type="search"
        autocomplete="off"
        placeholder="Start typing a name…"
        class="w-full rounded-md border border-line bg-raised px-4 py-2.5 text-[1rem] text-ink placeholder:text-ink-muted focus:border-primary"
        data-filter-search
      />
    </div>
  )}
  {filterable && <FilterBar options={options} label="Filter places" openNow subTowns={subTowns} />}
  <OpenStatus />
  {places.length === 0 ? (
    <p class="rounded-lg border border-dashed border-line px-6 py-10 text-center text-ink-muted">{emptyMessage}</p>
  ) : (
    groups.map((group) => (
      <section class="mt-10 first:mt-0" data-filter-group>
        {group.label && (
          <h3
            class="flex items-baseline justify-between gap-4 border-b-2 pb-2.5 text-[1.5rem] font-medium"
            style={`color:var(--cat-${hueOf(group.type)}-ink);border-color:var(--cat-${hueOf(group.type)}-dot)`}
          >
            {group.label}
            {/* On the category's ink, not its dot colour: white on the dot
                came to 3.9:1, short of the 4.5 small text needs. In the sans,
                like every other count on the site. */}
            <span class="rounded-full px-2.5 py-0.5 font-body text-[0.8125rem] font-semibold tabular-nums text-white" style={`background:var(--cat-${hueOf(group.type)}-ink)`} data-filter-count>
              {group.items.length}
            </span>
          </h3>
        )}
        <ul class="mt-4 rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
          {group.items.map((place) => <PlaceRow place={place} level={group.label ? 4 : 3} />)}
        </ul>
      </section>
    ))
  )}
  {/* What left nothing, said, with the way back: the filter writes the line. */}
  <div data-filter-empty hidden class="mt-6 rounded-lg border border-dashed border-line px-6 py-10 text-center text-ink-muted">
    <p data-filter-empty-text>Nothing in this category yet.</p>
    <p class="mt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      <button type="button" class="btn btn-outline min-h-11 text-primary" data-filter-reset>Clear the search and filters</button>
      {search && <a href="/contact/" class="font-semibold text-primary">Tell us what is missing</a>}
    </p>
  </div>
</div>
