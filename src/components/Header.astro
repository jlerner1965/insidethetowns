---
/**
 * The header: two bars, the same on every page of every site (the colours
 * and navigation work order of 20 November 2026), and under them, on a
 * guide's pages and the hub's town pages, the town bar.
 *
 * 1. The trust bar: "Listings checked daily" and the link to how.
 * 2. The masthead: "Inside the Towns" and its line, the six items of the
 *    site's menu (src/lib/nav.ts, SITE_NAV: six, never seven; nav rule 1),
 *    search, and the Thursday email as the one action button. Below the
 *    masthead breakpoint (66.25rem) the menu is a panel that drops from
 *    under the header on a button: the items under Explore, then the email.
 * The live town search is in the home page's hero (FindBar.astro), not a bar
 * above every page (the owner, 20 November 2026); every page has the
 * masthead's search link.
 *
 * One masthead on every site (one brand, 20 November 2026; until then a
 * guide's carried its own wordmark, "Inside Berthoud", and its own menu).
 * A guide's sections are the town bar's tabs now (TownBar.astro), in the
 * order its menu had, with "Switch town" at the end of the trail where the
 * "Towns" item was.
 *
 * The list is rendered once: a desktop copy and a mobile copy, one hidden,
 * puts every link in the page twice, which is duplicate anchor text on four
 * hundred pages and two things to keep in step.
 *
 * `section`: a hub page under /<town>/ that belongs to a full section (its
 * tradition pages): the town bar is that section's, each tab where the
 * merge puts the section's page (sectionHref, src/lib/section.ts).
 * `townBar`: a hub town page, which has no section: its trail alone.
 */
import { editionFor, emailEditions, fullSections, getNetworkHub, getSite, guideUrl, hubNeighborsOf, isMoved, neighborsOf, sectionHome, type FullSection } from '@/config';
import { hubCountyLine } from '@/config/hub-towns';
import { getTraditions } from '@/lib/content';
import { publishedHubTowns } from '@/lib/hub-towns';
import { EMAIL_NAV, SITE_NAV, siteNav, townNav } from '@/lib/nav';
import { pagePath, sectionHref } from '@/lib/section';
import { wordmarkEm as titleEm } from '@/lib/titles';
import TownBar from './TownBar.astro';
import Wordmark from './Wordmark.astro';
import { HUB_COLUMN } from './hub/pub';

interface Props {
  section?: FullSection;
  /** A hub town page: the town the trail names and the group it sits in. */
  townBar?: { name: string; region: string; slug?: string };
  /** The page's column (Base.astro), so the bars line up with the page. */
  column?: string;
}

const { section, townBar, column = HUB_COLUMN } = Astro.props;
const site = getSite();
const hub = getNetworkHub();
// The guide whose town bar this page carries: the section's on a hub page under its prefix, the site's own on a guide.
const guide = section?.site ?? (site.kind === 'town' ? site : undefined);
/** A path the town bar writes, as it is on this page: under the section's prefix when it is a section's. */
const at = (href: string) => (section ? sectionHref(href, section.base, isMoved(section.site)) : href);
/** A hub page, as it is from here: the path on the hub's own build, the hub's address from a guide's. */
const hubAt = (href: string) => (site.kind === 'hub' ? href : `https://${hub.domain}${href}`);
const hubTowns = publishedHubTowns(await getTraditions());
const published = new Set(hubTowns.map((h) => h.slug));
const path = pagePath(Astro.url);
// A link to a section of a page is never the current page: stripped to "/" it matched the home page.
const isActive = (href: string) => {
  if (href.includes('#')) return false;
  if (href === '/' || href === '') return path === '/';
  return path.startsWith(at(href));
};
/**
 * Roughly how wide the site title is, in em, at the wordmark's weights
 * (wordmarkEm in src/lib/titles.ts). The phone rule for .site-wordmark in
 * global.css divides the room beside the buttons by it.
 */
const wordmarkEm = titleEm(hub.siteTitle).toFixed(1);
// The six items, each where it is from here; the current one marked (nav rule 6).
const nav = SITE_NAV.map((item) => ({ ...item, href: hubAt(item.href), current: site.kind === 'hub' && isActive(item.href) }));
/**
 * The weekly email: the one action button in the masthead. On a guide the
 * email covers it goes to the hub's signup with this town ticked; the script
 * below sends it to the page's own form where there is one.
 */
const sendDay = hub.newsletter?.sendDay ?? 'Thursday';
const emailOn = !!hub.newsletter && (site.kind !== 'town' || !!editionFor(site.slug, emailEditions()));
const emailHref = site.kind === 'town' ? `https://${hub.domain}${EMAIL_NAV.href}?towns=${site.slug}` : EMAIL_NAV.href;
/**
 * The town bar's data. On a guide: its sections as tabs (the same items in
 * the same order its menu had, src/lib/nav.ts), its neighbours, and the
 * region the hub's search lists it under. On a hub town page: the trail.
 */
const tabs = guide
  ? (section ? townNav(guide, undefined, { folded: !isMoved(section.site) }) : siteNav(guide)).map((item) => ({ label: item.label, href: at(item.href), current: isActive(item.href) }))
  : [];
// A hub town page's neighbours are the other town pages in its group, A to Z, as a guide's are its neighbours.
const hubTown = townBar?.slug ? hubTowns.find((h) => h.slug === townBar.slug) : undefined;
const nearby = guide
  ? [...neighborsOf(guide).map((t) => ({ name: t.name, href: guideUrl(t) })), ...hubNeighborsOf(guide, published).map((t) => ({ name: t.name, href: t.href }))]
  : hubTown
    ? hubTowns.filter((h) => h.cluster === hubTown.cluster && h.slug !== hubTown.slug).sort((a, b) => a.name.localeCompare(b.name)).slice(0, 6).map((h) => ({ name: h.name, href: hubAt(`/${h.slug}/`) }))
    : [];
const town = guide ? { name: guide.name, region: guide.region } : townBar;
// The town in the trail is a link to its front page, except on that page (a hub town page is one).
const townHome = guide ? at('/') : undefined;
const onTownHome = !guide || path === '/' || path === at('/');
const regionHref = (region: string) => hubAt(`/search/?q=${encodeURIComponent(region)}`);
const rowLink = (on: boolean) => ['site-nav-link block whitespace-nowrap no-underline transition-colors', on && 'is-current'];
---
{/* 1. The trust bar: what the site promises, and the page that says how. */}
<div class="trust-bar" data-pagefind-ignore>
  <div class:list={[column, 'flex flex-wrap items-center justify-between gap-x-6']}>
    <span class="py-1.5">Listings checked daily</span>
    <a href={hubAt('/editorial/')} class="py-1.5">How we check listings</a>
  </div>
</div>
{/* 2. The masthead. */}
<header class="site-header relative" data-pagefind-ignore>
  <div class={column}>
    <div class="masthead-row" style={`--wordmark-em:${wordmarkEm}${emailOn ? ';--masthead-reserve:11.5rem' : ''};--wordmark-max:1.4118rem`}>
      <div class="masthead-brand">
        <Wordmark class="site-wordmark whitespace-nowrap text-[1.75rem] leading-none md:text-[2rem]" tone="ink" site={hub} href={hubAt('/')} />
        <p class="site-tagline">Independent Colorado town guide</p>
      </div>

      <div class="masthead-tools">
        {/* The email, one tap from every page on a phone (the sweep of 10 November 2026): below the row's breakpoint the panel is the only other way to it. */}
        {emailOn && (
          <a
            href={emailHref}
            data-email-link
            aria-label={`${sendDay} email: sign up`}
            class="site-email-link flex h-11 min-w-11 shrink-0 items-center justify-center gap-1.5 rounded-full px-2.5 no-underline masthead:hidden"
          >
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3.5 7 8.5 6 8.5-6"></path>
            </svg>
            <span class="hidden text-[0.875rem] font-semibold sm:inline" aria-hidden="true">{sendDay} email</span>
          </a>
        )}
        {/* The link's name is a word in the markup, not an aria-label: a crawler reads an icon link with only a label as a link with no anchor text. */}
        <a
          href={hubAt('/search/')}
          aria-current={path.startsWith('/search') ? 'page' : undefined}
          class="site-search-link flex size-11 shrink-0 items-center justify-center rounded-full no-underline"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <span class="sr-only">Search</span>
        </a>
        <button
          type="button"
          class="nav-toggle -mr-2 masthead:hidden"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Menu"
          data-nav-toggle
          data-wide="(min-width: 66.25rem)"
        >
          <span class="nav-toggle-bars" aria-hidden="true"></span>
        </button>
      </div>

      <nav id="site-nav" class="site-nav hub-row" aria-label="Primary">
        <ul class:list={['site-nav-list', column]}>
          {/* The panel's group heading on a phone; the row has none. The six in their order, Towns A–Z second
              (SITE_NAV, src/lib/nav.ts), in the row and the panel alike; the email is the button under them. */}
          <li class="site-nav-group" aria-hidden="true">Explore</li>
          {nav.map((item) => (
            <li><a href={item.href} aria-current={item.current ? 'page' : undefined} class:list={rowLink(item.current)}>{item.label}</a></li>
          ))}
          {emailOn && (
            <li class="site-nav-email">
              <a href={emailHref} data-email-link class="site-nav-link site-nav-email-link btn-action block whitespace-nowrap no-underline">{EMAIL_NAV.label}</a>
            </li>
          )}
        </ul>
      </nav>
    </div>
  </div>
</header>
{town && (
  <TownBar
    name={town.name}
    homeHref={onTownHome ? undefined : townHome}
    region={town.region}
    regionHref={regionHref(town.region)}
    townsHref={hubAt('/towns/')}
    {tabs}
    {nearby}
    allHref={hubAt('/towns/')}
    allLabel="All towns, A to Z →"
    {column}
  />
)}

<script>
  // The masthead's email links go to the form on this page where the page
  // has one that can be seen (NewsletterSignup marks its section), and put
  // the cursor in its field; otherwise they keep their href, the hub's signup.
  const signup = [...document.querySelectorAll<HTMLElement>('[data-signup-section]')].find((el) => el.offsetParent !== null);
  if (signup) {
    if (!signup.id) signup.id = 'signup';
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-email-link]')) {
      link.href = `#${signup.id}`;
      link.addEventListener('click', () => {
        // After the jump, so the browser's own scroll to the anchor wins.
        setTimeout(() => signup.querySelector<HTMLElement>('select, input[type="email"]')?.focus({ preventScroll: true }), 0);
      });
    }
  }

  const button = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('site-nav');
  if (button && nav) {
    const open = () => button.getAttribute('aria-expanded') === 'true';
    const header = button.closest('header');
    const set = (next: boolean) => {
      button.setAttribute('aria-expanded', String(next));
      // The lock lives on <html> so the panel's own rules and the scroll lock
      // are one state, not two that can disagree.
      document.documentElement.classList.toggle('nav-open', next);
      // Everything outside the masthead is out of reach while the panel is
      // open, so Tab stays in the menu rather than walking into the dimmed
      // page under it (WCAG 2.4.3, 2.4.11).
      for (const el of document.body.children) {
        if (el !== header && !el.contains(header) && el instanceof HTMLElement && !(el instanceof HTMLScriptElement)) el.inert = next;
      }
    };
    button.addEventListener('click', () => {
      const next = !open();
      set(next);
      if (next) nav.querySelector<HTMLAnchorElement>('a')?.focus();
    });
    // Following a link closes it; so does Escape, which puts focus back where it came from.
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) set(false);
    });
    // A tap on the dimmed page closes it, as a menu is expected to.
    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (open() && !nav.contains(target) && !button.contains(target)) set(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open()) {
        set(false);
        button.focus();
      }
    });
    // Rotating to a width that shows the row must not leave the page locked.
    const wide = window.matchMedia(button.dataset.wide ?? '(min-width: 66.25rem)');
    wide.addEventListener('change', (event) => {
      if (event.matches) set(false);
    });
  }

  // The current tab in view: on a phone the tabs scroll sideways, and on a page further along the
  // row (Eat & drink, Living here) its tab sat off the right edge, so the reader could not see where they were.
  for (const tabs of document.querySelectorAll<HTMLElement>('[data-town-tabs]')) {
    const current = tabs.querySelector<HTMLElement>('[aria-current="page"]');
    if (!current) continue;
    const left = current.getBoundingClientRect().left - tabs.getBoundingClientRect().left + tabs.scrollLeft;
    if (left + current.offsetWidth > tabs.clientWidth - 24) tabs.scrollLeft = left - 16;
  }

  // "Switch town" (TownBar.astro) opens on its own; this only closes it, the
  // way a menu is expected to close: Escape (focus back on its button), a
  // click or a tab anywhere else.
  for (const switcher of document.querySelectorAll<HTMLDetailsElement>('[data-town-switch]')) {
    const close = () => switcher.removeAttribute('open');
    document.addEventListener('click', (event) => {
      if (switcher.open && !switcher.contains(event.target as Node)) close();
    });
    document.addEventListener('focusin', (event) => {
      if (switcher.open && !switcher.contains(event.target as Node)) close();
    });
    switcher.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && switcher.open) {
        event.stopPropagation();
        close();
        switcher.querySelector<HTMLElement>('summary')?.focus();
      }
    });
  }
</script>
