---
/**
 * The masthead: wordmark, the navigation, search and, on a flagship guide,
 * the email button. One treatment on every page of every guide (docs/
 * DESIGN.md, "The header", fixed by the owner on 26 October 2026): the
 * guide's paper, the wordmark in ink and the town's primary, the menu in
 * small capitals. There is no per-template colour switch: the flagship
 * home page and its inner pages had a band in two different colours (the
 * 26 October audit, priority 6), and test/design.test.ts keeps it one.
 *
 * - The rule above it is the town's: the primary running into the accent,
 *   or, on a guide that follows a school, the school's main colour, a line
 *   with no words on it (src/config/school-colors.ts, `rule`).
 * - The menu is src/lib/nav.ts's: the six destinations (townNav), then
 *   "More", a native disclosure holding the sections a resident looks for
 *   by name (moreNav: Things to do, Get involved, This weekend, Local
 *   changes) and the nearby guides. On a phone the panel lists "More" open.
 * - Search, then the email button, at the end of the row; on a phone,
 *   search and the menu button beside the wordmark.
 *
 * The list is rendered once. Below the xl breakpoint (80rem) it becomes a
 * panel that drops from under the header on a button; at and above it, it
 * is a row. Rendering it twice (a desktop copy and a mobile copy, one
 * hidden) puts every link in the page twice.
 */
import { editionFor, emailEditions, getNetworkHub, getSite, liveTowns, neighborsOf } from '@/config';
import Wordmark from './Wordmark.astro';
import { moreNav, siteNav } from '@/lib/nav';
import { wordmarkEm as titleEm } from '@/lib/titles';
import { schoolTheme } from '@/config/school-colors';
import { getTownEntries } from '@/lib/content';

interface Props {
  /** On the home page itself: the email button goes to the signup on this page. */
  home?: boolean;
}

const site = getSite();
const hub = getNetworkHub();
const nearby = site.kind === 'town' ? neighborsOf(site) : [];
const guideCount = liveTowns().length;
const path = Astro.url.pathname;
// A link to a section of a page (the hub's "/#towns") is never the current
// page: stripped to "/" it matched the home page and showed "Towns" as where
// the reader already was.
const isActive = (href: string) => {
  if (href.includes('#')) return false;
  if (href === '/' || href === '') return path === '/';
  return path.startsWith(href);
};
/**
 * Roughly how wide the site title is, in em, at the wordmark's weights
 * (wordmarkEm in src/lib/titles.ts). The phone rule for .site-wordmark in
 * global.css divides the room beside the buttons by it.
 */
const wordmarkEm = titleEm(site.siteTitle).toFixed(1);
const nav = siteNav(site);
const hasUpdates = site.kind === 'town' && (await getTownEntries('updates')).length > 0;
const more = site.kind === 'town' ? moreNav(site, { updates: hasUpdates }) : [];
// The current page, in the row and in the panel: the primary, and in the
// row a 2px underline under the word.
const rowLink = (on: boolean) => [
  'site-nav-link block whitespace-nowrap text-[0.8125rem] font-semibold uppercase tracking-[0.1em] no-underline transition-colors xl:tracking-[0.07em]',
  on ? 'text-primary xl:underline xl:decoration-2 xl:underline-offset-[0.6em]' : 'text-ink-muted hover:text-ink',
];
const panelLink = (on: boolean) => [
  'inline-block py-1.5 text-[0.9375rem] normal-case tracking-normal no-underline hover:text-primary hover:underline',
  on ? 'font-semibold text-primary' : 'font-medium text-ink',
];
// The rule along the top: the school's colour where the guide follows one.
const school = site.kind === 'town' && site.school ? schoolTheme(site.school) : undefined;
const ruleStyle = school ? `background:${school.rule}` : undefined;
// The email button, on a flagship guide the email covers: to the signup at
// the foot of the home page, from every page.
const sendDay = hub.newsletter?.sendDay ?? 'Thursday';
const emailOn = site.kind === 'town' && !!site.home && !!hub.newsletter && !!editionFor(site.slug, emailEditions());
const emailHref = Astro.props.home ? '#signup' : '/#signup';
---
{/* The first thing on every page is a 6px rule in the town's colours. */}
<div class:list={['h-1.5', !school && 'bg-gradient-to-r from-primary to-accent']} style={ruleStyle} data-site-rule></div>
<header class="relative bg-paper" data-pagefind-ignore data-site-header>
  <div class="container-page">
    <div class="flex items-center justify-between gap-4 py-5 sm:gap-6 md:py-7 xl:gap-4" style={`--wordmark-em:${wordmarkEm}`}>
      <Wordmark class="site-wordmark whitespace-nowrap text-[1.75rem] leading-none md:text-[2rem]" tone="ink" />

      <nav id="site-nav" class="site-nav" aria-label="Primary">
        <ul class="site-nav-list container-page xl:gap-2.5 xl:px-0 2xl:gap-5">
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class:list={rowLink(isActive(item.href))}>{item.label}</a>
            </li>
          ))}
          {site.kind === 'town' && (
            <li class="site-nav-switch">
              <details data-town-switch>
                <summary class:list={['site-nav-link cursor-pointer whitespace-nowrap text-[0.8125rem] font-semibold uppercase tracking-[0.1em] transition-colors xl:tracking-[0.07em] hover:text-ink', more.some((m) => isActive(m.href)) ? 'text-primary' : 'text-ink-muted']}>More</summary>
                <div class="site-nav-panel text-ink">
                  {more.length > 0 && (
                    <Fragment>
                      <p class="eyebrow text-ink-muted">In {site.name}</p>
                      <ul class="mt-2 grid gap-1">
                        {more.map((m) => (
                          <li><a href={m.href} aria-current={isActive(m.href) ? 'page' : undefined} class:list={panelLink(isActive(m.href))}>{m.label}</a></li>
                        ))}
                      </ul>
                    </Fragment>
                  )}
                  {nearby.length > 0 && (
                    <Fragment>
                      <p class:list={['eyebrow text-ink-muted', more.length > 0 && 'mt-3 border-t border-line-soft pt-3']}>Nearby guides</p>
                      <ul class="mt-2 grid gap-1">
                        {nearby.map((t) => (
                          <li>
                            <a href={`https://${t.domain}/`} class:list={panelLink(false)}>{t.siteTitle}</a>
                          </li>
                        ))}
                      </ul>
                    </Fragment>
                  )}
                  <p class="mt-3 border-t border-line-soft pt-3 text-[0.9375rem]">
                    <a href={`https://${hub.domain}/#towns`} class="inline-block py-1.5 font-semibold normal-case tracking-normal text-primary underline">All {guideCount} guides →</a>
                  </p>
                  {emailOn && (
                    <p class="mt-3 border-t border-line-soft pt-3 sm:hidden">
                      <a href={emailHref} class="inline-flex min-h-11 items-center rounded-full bg-primary px-4 text-[0.9375rem] font-semibold normal-case tracking-normal text-white no-underline">Get the {sendDay} email</a>
                    </p>
                  )}
                </div>
              </details>
            </li>
          )}
        </ul>
      </nav>

      {/* After the menu in the source, so the tab order is the order on screen: the wordmark, the menu, search, the email, and on a phone the menu button. */}
      <div class="flex items-center gap-1 xl:gap-2">
        <a
          href="/search/"
          aria-label="Search"
          aria-current={path.startsWith('/search') ? 'page' : undefined}
          class="site-search-link flex size-11 shrink-0 items-center justify-center rounded-full text-ink-muted no-underline hover:bg-raised hover:text-primary"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </a>
        {/* From a tablet's width up; on a phone the signup is in the menu's foot. */}
        {emailOn && (
          <a href={emailHref} class="ml-1 hidden min-h-11 items-center whitespace-nowrap rounded-full bg-primary px-4 text-[0.875rem] font-semibold text-white no-underline hover:bg-primary-hover sm:inline-flex">{sendDay} email</a>
        )}
        <button
          type="button"
          class="nav-toggle -mr-2 xl:hidden"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Menu"
          data-nav-toggle
        >
          <span class="nav-toggle-bars" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>
  <div class="h-px bg-line-soft"></div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('site-nav');
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const wide = window.matchMedia('(min-width: 80rem)');
  const switcher = document.querySelector<HTMLDetailsElement>('[data-town-switch]');
  // In the phone panel "More" is listed open under the six, so what it
  // holds is in plain sight; in the row it is a disclosure that starts shut.
  const settleMore = () => switcher?.toggleAttribute('open', !wide.matches);
  settleMore();

  if (button && nav) {
    const open = () => button.getAttribute('aria-expanded') === 'true';
    const set = (next: boolean) => {
      button.setAttribute('aria-expanded', String(next));
      button.setAttribute('aria-label', next ? 'Close menu' : 'Menu');
      // The lock lives on <html> so the panel's own rules and the scroll lock
      // are one state, not two that can disagree.
      document.documentElement.classList.toggle('nav-open', next);
    };
    button.addEventListener('click', () => {
      const next = !open();
      set(next);
      if (next) nav.querySelector<HTMLAnchorElement>('a')?.focus();
    });
    // Following a link closes it; so does Escape, which puts focus back on
    // the button rather than at the top of the document.
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open()) {
        set(false);
        button.focus();
      }
    });
    // Tabbing out of the header (past the last link of the panel) closes the
    // panel, so focus never moves on under a dimmed, scroll-locked page.
    header?.addEventListener('focusout', (event) => {
      if (open() && !header.contains(event.relatedTarget as Node | null) && event.relatedTarget) set(false);
    });
    // Rotating to a width that shows the row must not leave the page locked.
    wide.addEventListener('change', (event) => {
      if (event.matches) set(false);
    });
  }

  // "More" in the row opens on its own; this only closes it, the way a menu
  // is expected to close: Escape (focus back on its button), a click or a
  // tab anywhere else. In the phone panel it stays open.
  if (switcher) {
    const close = () => {
      if (wide.matches) switcher.removeAttribute('open');
    };
    document.addEventListener('click', (event) => {
      if (switcher.open && !switcher.contains(event.target as Node)) close();
    });
    document.addEventListener('focusin', (event) => {
      if (switcher.open && !switcher.contains(event.target as Node)) close();
    });
    switcher.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && switcher.open && wide.matches) {
        close();
        switcher.querySelector<HTMLElement>('summary')?.focus();
      }
    });
    wide.addEventListener('change', settleMore);
  }
</script>
