---
/**
 * The masthead: wordmark, and the navigation. One masthead on every page of
 * every site (design pass, 26 October 2026): the paper, the wordmark with
 * the town's name in its primary, the menu in sentence case, the town
 * switcher at the end of the row, search. It used to come in three: this
 * one, a dark band with pills on the flagship guides' interior pages, and
 * the school's band with its own menu on their home pages. The school's
 * colour is on the home page's scoreboard and the sports pages now, where
 * it means something, and the menu is the same list everywhere
 * (src/lib/nav.ts).
 *
 * The list is rendered once. Below the xl breakpoint (80rem) it becomes a
 * panel that drops from under the header on a button; at and above it, it is
 * a row. Not lg: at 1024px the row, with the longer titles beside it, was
 * wider than the screen on ten of the thirteen sites and pushed the search
 * button off the edge. Inside Carbon Valley's needs about 1,150px.
 * Rendering it twice — a desktop copy and a mobile copy, one hidden — is the
 * usual way to do this and it puts every link in the page twice, which is
 * duplicate anchor text on four hundred pages and two things to keep in step.
 */
import { editionFor, emailEditions, getNetworkHub, getSite, liveTowns, neighborsOf } from '@/config';
import Wordmark from './Wordmark.astro';
import { siteNav } from '@/lib/nav';
import { wordmarkEm as titleEm } from '@/lib/titles';

const site = getSite();
const hub = getNetworkHub();
/**
 * On a guide, the last item in the row is a switcher: the neighbouring
 * guides, then the hub's full list. The primary navigation was all about
 * the current town and the sister guides sat only in the footer, two
 * screens of taglines down on a phone (follow-up audit, 8 October 2026). A
 * native disclosure, so it opens without the script and the script only
 * closes it: on Escape, on a click elsewhere, and on a width change.
 */
const nearby = site.kind === 'town' ? neighborsOf(site) : [];
const guideCount = liveTowns().length;
const path = Astro.url.pathname;
// A link to a section of a page (the hub's "/#towns") is never the current
// page: stripped to "/" it matched the home page and showed "Towns" as where
// the reader already was.
const isActive = (href: string) => {
  if (href.includes('#')) return false;
  if (href === '/' || href === '') return path === '/';
  return path.startsWith(href);
};
/**
 * Roughly how wide the site title is, in em, at the wordmark's weights
 * (wordmarkEm in src/lib/titles.ts). The phone rule for .site-wordmark in
 * global.css divides the room beside the buttons by it.
 */
const wordmarkEm = titleEm(site.siteTitle).toFixed(1);
const nav = siteNav(site);
// Sentence case at reading weight, the current section in the primary. In
// the row the words are what the phone panel shows, at the row's size.
const rowLink = (on: boolean) => [
  'site-nav-link block whitespace-nowrap no-underline transition-colors xl:text-[0.9375rem] xl:font-medium',
  on ? 'text-primary xl:font-semibold' : 'text-ink-muted hover:text-ink',
];
const summaryClass = 'site-nav-link cursor-pointer whitespace-nowrap text-ink-muted transition-colors hover:text-ink xl:text-[0.9375rem] xl:font-medium';
/**
 * The weekly email, as one small link in the masthead of every page of a
 * guide the email covers (the newsletter rule of 26 October 2026: a header
 * link to the signup, and at most one form on a page). It goes to the hub's
 * signup page with this town ticked, so it is the same destination from
 * every page, whether or not the page carries a form of its own.
 */
const sendDay = hub.newsletter?.sendDay ?? 'Thursday';
const emailOn = site.kind === 'town' && !!hub.newsletter && !!editionFor(site.slug, emailEditions());
const emailHref = site.kind === 'town' ? `https://${hub.domain}/newsletter/?towns=${site.slug}` : '/newsletter/';
---
{/* The first thing on every page is a band of the town's colours, the
   primary running into the accent. It costs six pixels and it is what stops
   the site opening on plain paper. A rule, so the accent may be in it. */}
<div class="h-1.5 bg-gradient-to-r from-primary to-accent"></div>
<header class="relative bg-paper" data-pagefind-ignore>
  <div class="container-page">
    <div class="flex items-center justify-between gap-4 py-5 sm:gap-6 md:py-6" style={`--wordmark-em:${wordmarkEm}`}>
      <Wordmark class="site-wordmark whitespace-nowrap text-[1.75rem] leading-none md:text-[2rem]" tone="ink" />

      <div class="flex items-center gap-1 xl:order-last xl:gap-2">
        <a
          href="/search/"
          aria-label="Search"
          aria-current={path.startsWith('/search') ? 'page' : undefined}
          class="site-search-link flex size-11 shrink-0 items-center justify-center rounded-full text-ink-muted no-underline hover:bg-raised hover:text-primary"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </a>
        <button
          type="button"
          class="nav-toggle -mr-2 xl:hidden"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Menu"
          data-nav-toggle
        >
          <span class="nav-toggle-bars" aria-hidden="true"></span>
        </button>
      </div>

      <nav id="site-nav" class="site-nav" aria-label="Primary">
        <ul class="site-nav-list container-page xl:gap-3 xl:px-0 2xl:gap-6">
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class:list={rowLink(isActive(item.href))}>{item.label}</a>
            </li>
          ))}
          {site.kind === 'town' && (
            <li class="site-nav-switch">
              <details data-town-switch>
                {/* "Towns" in the row, where every pixel counts; "Other towns"
                    in the phone menu, where it reads better. */}
                <summary class={summaryClass}><span class="xl:hidden">Other towns</span><span class="hidden xl:inline">Towns</span></summary>
                <div class="site-nav-panel text-ink">
                  {nearby.length > 0 && (
                    <Fragment>
                      <p class="eyebrow text-ink-muted">Nearby</p>
                      <ul class="mt-2 grid gap-1">
                        {nearby.map((t) => (
                          <li>
                            <a href={`https://${t.domain}/`} class="inline-block py-1.5 text-[0.9375rem] font-medium text-ink no-underline hover:text-primary hover:underline">{t.siteTitle}</a>
                          </li>
                        ))}
                      </ul>
                    </Fragment>
                  )}
                  <p class:list={['text-[0.9375rem]', nearby.length > 0 && 'mt-3 border-t border-line-soft pt-3']}>
                    <a href={`https://${hub.domain}/#towns`} class="inline-block py-1.5 font-semibold text-primary underline">All {guideCount} guides →</a>
                  </p>
                </div>
              </details>
            </li>
          )}
          {emailOn && (
            <li class="site-nav-email">
              <a href={emailHref} class="site-nav-link site-nav-email-link block whitespace-nowrap no-underline xl:inline-flex xl:min-h-10 xl:items-center xl:rounded-full xl:border xl:border-primary-line xl:px-3.5 xl:text-[0.875rem] xl:font-semibold xl:text-primary xl:hover:border-primary">
                {sendDay} email
              </a>
            </li>
          )}
        </ul>
      </nav>
    </div>
  </div>
  <div class="h-px bg-line-soft"></div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('site-nav');
  if (button && nav) {
    const open = () => button.getAttribute('aria-expanded') === 'true';
    const set = (next: boolean) => {
      button.setAttribute('aria-expanded', String(next));
      // The lock lives on <html> so the panel's own rules and the scroll lock
      // are one state, not two that can disagree.
      document.documentElement.classList.toggle('nav-open', next);
    };
    button.addEventListener('click', () => {
      const next = !open();
      set(next);
      if (next) nav.querySelector<HTMLAnchorElement>('a')?.focus();
    });
    // Following a link closes it; so does Escape, which puts focus back where
    // it came from rather than at the top of the document.
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open()) {
        set(false);
        button.focus();
      }
    });
    // Rotating to a width that shows the row must not leave the page locked.
    const wide = window.matchMedia('(min-width: 80rem)');
    wide.addEventListener('change', (event) => {
      if (event.matches) set(false);
    });
  }

  // The town switcher opens on its own; this only closes it, the way a menu
  // is expected to close: Escape (focus back on its button), a click or a
  // tab anywhere else, and the row-to-panel width change.
  for (const switcher of document.querySelectorAll<HTMLDetailsElement>('[data-town-switch]')) {
    const close = () => switcher.removeAttribute('open');
    document.addEventListener('click', (event) => {
      if (switcher.open && !switcher.contains(event.target as Node)) close();
    });
    document.addEventListener('focusin', (event) => {
      if (switcher.open && !switcher.contains(event.target as Node)) close();
    });
    switcher.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && switcher.open) {
        close();
        switcher.querySelector<HTMLElement>('summary')?.focus();
      }
    });
    window.matchMedia('(min-width: 80rem)').addEventListener('change', close);
  }
</script>
