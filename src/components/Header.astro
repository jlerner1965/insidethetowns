---
/**
 * The masthead: wordmark, and the navigation.
 *
 * The list is rendered once. Below the xl breakpoint (80rem) it becomes a
 * panel that drops from under the header on a button; at and above it, it is
 * a row. Not lg: at 1024px the row, with the longer titles beside it, was
 * wider than the screen on ten of the thirteen sites and pushed the search
 * button off the edge. Inside Carbon Valley's needs about 1,150px.
 * Rendering it twice — a desktop copy and a mobile copy, one hidden — is the
 * usual way to do this and it puts every link in the page twice, which is
 * duplicate anchor text on four hundred pages and two things to keep in step.
 */
import { getNetworkHub, getSite, liveTowns, neighborsOf } from '@/config';
import Wordmark from './Wordmark.astro';
import TownSwitcher from './TownSwitcher.astro';
import { wordmarkEm as titleEm } from '@/lib/titles';

const site = getSite();
const hub = getNetworkHub();
/**
 * On a guide, the last item in the row is a switcher: the neighbouring
 * guides, then the hub's full list. The primary navigation was all about
 * the current town and the sister guides sat only in the footer, two
 * screens of taglines down on a phone (follow-up audit, 8 October 2026). A
 * native disclosure, so it opens without the script and the script only
 * closes it: on Escape, on a click elsewhere, and on a width change.
 */
const nearby = site.kind === 'town' ? neighborsOf(site) : [];
const guideCount = liveTowns().length;
const path = Astro.url.pathname;
// A link to a section of a page (the hub's "/#towns") is never the current
// page: stripped to "/" it matched the home page and showed "Towns" as where
// the reader already was.
const isActive = (href: string) => {
  if (href.includes('#')) return false;
  if (href === '/' || href === '') return path === '/';
  return path.startsWith(href);
};
/**
 * Roughly how wide the site title is, in em, at the wordmark's weights
 * (wordmarkEm in src/lib/titles.ts). The phone rule for .site-wordmark in
 * global.css divides the room beside the buttons by it.
 */
const wordmarkEm = titleEm(site.siteTitle).toFixed(1);
const flagship = site.kind === 'town' && !!site.home ? site : undefined;
const pill = 'inline-flex min-h-11 items-center whitespace-nowrap rounded-full px-4 text-[0.9375rem] font-semibold no-underline transition-colors';
const pillOn = 'bg-white text-primary';
const pillOff = 'text-white ring-1 ring-white/35 hover:bg-white/15';
---
{/* The first thing on every page is a band of the town's colours, the
   primary running into the accent. It costs six pixels and it is what stops
   the site opening on plain paper. A rule, so the accent may be in it. */}
<div class="h-1.5 bg-gradient-to-r from-primary to-accent"></div>
{/*
   The flagship masthead (redesign of 22 October 2026, TownConfig.home): a
   band in the town's colour with the wordmark, search and the navigation
   as a row of pills, five of them, each a 44px target. On a phone the row
   scrolls sideways under the wordmark; from xl it sits beside it. No menu
   button: five pills fit, and a row that scrolls says so by running off
   the edge. The sister guides keep their switcher, as the last pill.
 */}
{flagship ? (
  <header class="on-dark relative bg-primary text-white" data-pagefind-ignore>
    <div class="container-page">
      <div class="flex items-center justify-between gap-4 py-4 md:py-5 xl:gap-8" style={`--wordmark-em:${wordmarkEm}`}>
        <Wordmark class="site-wordmark whitespace-nowrap text-[1.75rem] leading-none md:text-[2rem]" tone="light" />
        <nav class="hidden min-w-0 flex-1 xl:block" aria-label="Primary">
          <ul class="flex flex-wrap items-center gap-2">
            {site.nav.map((item) => (
              <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class:list={[pill, isActive(item.href) ? pillOn : pillOff]}>{item.label}</a></li>
            ))}
            <li class="site-nav-switch"><TownSwitcher town={flagship!} summaryClass={`${pill} ${pillOff} cursor-pointer`} /></li>
          </ul>
        </nav>
        <a href="/search/" aria-label="Search" aria-current={path.startsWith('/search') ? 'page' : undefined} class="site-search-link flex size-11 shrink-0 items-center justify-center rounded-full bg-white/15 text-white no-underline hover:bg-white/25">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </a>
      </div>
      <nav class="pb-4 xl:hidden" aria-label="Primary">
        <ul class="pill-row flex gap-2">
          {site.nav.map((item) => (
            <li class="shrink-0"><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class:list={[pill, isActive(item.href) ? pillOn : pillOff]}>{item.label}</a></li>
          ))}
          <li class="site-nav-switch shrink-0"><TownSwitcher town={flagship!} summaryClass={`${pill} ${pillOff} cursor-pointer`} /></li>
        </ul>
      </nav>
    </div>
  </header>
) : (
<header class="relative bg-paper" data-pagefind-ignore>
    <div class="container-page">
      <div class="flex items-center justify-between gap-4 py-5 sm:gap-6 md:py-7" style={`--wordmark-em:${wordmarkEm}`}>
        <Wordmark class="site-wordmark whitespace-nowrap text-[1.75rem] leading-none md:text-[2rem]" />
  
        <div class="flex items-center gap-1 xl:order-last xl:gap-2">
          <a
            href="/search/"
            aria-label="Search"
            aria-current={path.startsWith('/search') ? 'page' : undefined}
            class="site-search-link flex size-11 items-center justify-center rounded-full text-ink-muted no-underline hover:bg-raised hover:text-primary"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
          </a>
        <button
          type="button"
          class="nav-toggle -mr-2 xl:hidden"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Menu"
          data-nav-toggle
        >
          <span class="nav-toggle-bars" aria-hidden="true"></span>
        </button>
        </div>
  
        <nav id="site-nav" class="site-nav" aria-label="Primary">
          <ul class="site-nav-list container-page xl:gap-4 xl:px-0 2xl:gap-7">
            {site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'site-nav-link block whitespace-nowrap text-[0.8125rem] font-semibold uppercase tracking-[0.1em] no-underline transition-colors',
                    isActive(item.href) ? 'text-primary' : 'text-ink-muted hover:text-ink',
                  ]}
                >{item.label}</a>
              </li>
            ))}
            {site.kind === 'town' && (
              <li class="site-nav-switch">
                <details data-town-switch>
                  {/* "Towns" in the row, where every pixel counts (the row and
                      the longer titles meet at the xl breakpoint; "Other towns"
                      pushed the search button off a 1280px screen on twelve of
                      the guides, pre-launch audit, 8 October 2026); "Other
                      towns" in the phone menu, where it reads better. */}
                  <summary class="site-nav-link cursor-pointer whitespace-nowrap text-[0.8125rem] font-semibold uppercase tracking-[0.1em] text-ink-muted transition-colors hover:text-ink"><span class="xl:hidden">Other towns</span><span class="hidden xl:inline">Towns</span></summary>
                  <div class="site-nav-panel">
                    {nearby.length > 0 && (
                      <Fragment>
                        <p class="eyebrow text-ink-muted">Nearby</p>
                        <ul class="mt-2 grid gap-1">
                          {nearby.map((t) => (
                            <li>
                              <a href={`https://${t.domain}/`} class="inline-block py-1.5 text-[0.9375rem] font-medium normal-case tracking-normal text-ink no-underline hover:text-primary hover:underline">{t.siteTitle}</a>
                            </li>
                          ))}
                        </ul>
                      </Fragment>
                    )}
                    <p class:list={['text-[0.9375rem]', nearby.length > 0 && 'mt-3 border-t border-line-soft pt-3']}>
                      <a href={`https://${hub.domain}/#towns`} class="inline-block py-1.5 font-semibold normal-case tracking-normal text-primary underline">All {guideCount} guides →</a>
                    </p>
                  </div>
                </details>
              </li>
            )}
          </ul>
        </nav>
      </div>
    </div>
    <div class="h-px bg-line-soft"></div>
  </header>
)}

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('site-nav');
  if (button && nav) {
    const open = () => button.getAttribute('aria-expanded') === 'true';
    const set = (next: boolean) => {
      button.setAttribute('aria-expanded', String(next));
      // The lock lives on <html> so the panel's own rules and the scroll lock
      // are one state, not two that can disagree.
      document.documentElement.classList.toggle('nav-open', next);
    };
    button.addEventListener('click', () => {
      const next = !open();
      set(next);
      if (next) nav.querySelector<HTMLAnchorElement>('a')?.focus();
    });
    // Following a link closes it; so does Escape, which puts focus back where
    // it came from rather than at the top of the document.
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open()) {
        set(false);
        button.focus();
      }
    });
    // Rotating to a width that shows the row must not leave the page locked.
    const wide = window.matchMedia('(min-width: 80rem)');
    wide.addEventListener('change', (event) => {
      if (event.matches) set(false);
    });
  }

  // The town switcher opens on its own; this only closes it, the way a menu
  // is expected to close: Escape (focus back on its button), a click or a
  // tab anywhere else, and the row-to-panel width change.
  // The flagship masthead renders two (the row beside the wordmark, the
  // row under it on a phone), so each is handled on its own.
  for (const switcher of document.querySelectorAll<HTMLDetailsElement>('[data-town-switch]')) {
    const close = () => switcher.removeAttribute('open');
    document.addEventListener('click', (event) => {
      if (switcher.open && !switcher.contains(event.target as Node)) close();
    });
    document.addEventListener('focusin', (event) => {
      if (switcher.open && !switcher.contains(event.target as Node)) close();
    });
    switcher.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && switcher.open) {
        close();
        switcher.querySelector<HTMLElement>('summary')?.focus();
      }
    });
    window.matchMedia('(min-width: 80rem)').addEventListener('change', close);
  }
</script>
