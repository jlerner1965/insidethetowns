---
import { getSite } from '@/config';
import Wordmark from './Wordmark.astro';

const site = getSite();
const path = Astro.url.pathname;
const isActive = (href: string) => {
  const clean = href.split('#')[0] ?? href;
  if (clean === '/' || clean === '') return path === '/';
  return path.startsWith(clean);
};
const linkClass = (href: string) =>
  [
    'block whitespace-nowrap py-1 text-[0.8125rem] font-semibold uppercase tracking-[0.1em] no-underline transition-colors',
    isActive(href) ? 'text-accent-dark' : 'text-ink-muted hover:text-ink',
  ].join(' ');
---
{/* The first thing on every page is a band of the town's colour. It costs
   six pixels and it is what stops the site opening on plain tan. */}
<div class="h-1.5 bg-gradient-to-r from-accent-dark via-accent to-highlight"></div>
<header class="bg-paper">
  <div class="container-page">
    <div class="flex items-center justify-between gap-8 py-5 md:py-7">
      <Wordmark class="whitespace-nowrap text-[1.75rem] leading-none md:text-[2rem]" />
      <nav aria-label="Primary" class="hidden lg:block">
        <ul class="flex gap-7">
          {site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class={linkClass(item.href)}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <nav aria-label="Primary" class="-mx-5 overflow-x-auto border-t border-line-soft px-5 [scrollbar-width:none] sm:-mx-8 sm:px-8 lg:hidden">
      <ul class="flex gap-6 py-3">
        {site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class={linkClass(item.href)}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="h-px bg-line-soft"></div>
</header>
