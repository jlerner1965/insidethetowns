---
/**
 * A place as a directory row: name, type and summary on the left, address and
 * hours on the right, a hairline underneath.
 *
 * A directory does not need a photograph of every listing the way a card grid
 * does, so a town whose shops have not been photographed still reads as
 * finished. Photographs lead the page above the directory instead.
 *
 * The right column carries only what you need before you set off — where it is
 * and whether it is open. The phone number and the rest are on the place's own
 * page; repeating them here turned every row into six lines of grey text.
 */
import type { TownEntry } from '@/lib/content';
import { PLACE_TYPE_LABELS } from '@/content/schemas';
import { PLACE_HUE } from '@/config/palette';

interface Props {
  place: TownEntry<'places'>;
  /** 3 under a page heading, 4 under a category heading. */
  level?: 3 | 4;
}

const { place, level = 3 } = Astro.props;
const { data, slug } = place;
const href = `/places/${slug}/`;
const Heading = `h${level}` as 'h3' | 'h4';
const hue = PLACE_HUE[data.type];
---
<li
  class="group relative grid gap-x-10 gap-y-2 border-b border-line-soft py-6 last:border-b-0 sm:grid-cols-[minmax(0,1fr)_minmax(8rem,14rem)]"
  data-filter-item
  data-category={data.type}
>
  <div>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <Heading class="text-[1.25rem] font-medium leading-tight">
        <a href={href} class="stretch no-underline group-hover:text-accent-text">{data.title}</a>
      </Heading>
      {data.featured && (
        <span class="rounded-full bg-highlight px-2.5 py-0.5 text-[0.6875rem] font-semibold uppercase tracking-[0.1em] text-ink">
          Our pick
        </span>
      )}
    </div>
    <p class="eyebrow mt-1.5 flex items-center gap-2" style={`color:var(--cat-${hue}-ink)`}>
      <span class="inline-block size-2 shrink-0 rounded-full" style={`background:var(--cat-${hue}-dot)`} aria-hidden="true"></span>
      {PLACE_TYPE_LABELS[data.type]}{data.priceRange && <span class="ml-1 text-ink-faint">{data.priceRange}</span>}
    </p>
    <p class="mt-2 max-w-[58ch] text-[0.9375rem] leading-relaxed text-ink-muted">{data.summary}</p>
  </div>
  <div class="grid content-start gap-1 text-[0.875rem] leading-snug text-ink-muted">
    {data.address && <p class="text-ink">{data.address}</p>}
    {data.hours && <p>{data.hours}</p>}
  </div>
</li>
