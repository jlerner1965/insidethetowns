---
/**
 * A place as a directory row: name, type and summary on the left, address and
 * hours on the right, a hairline underneath.
 *
 * A directory does not need a photograph of every listing the way a card grid
 * does, so a town whose shops have not been photographed still reads as
 * finished. Photographs lead the page above the directory instead.
 *
 * The right column carries only what you need before you set off — where it is
 * and whether it is open. The phone number and the rest are on the place's own
 * page; repeating them here turned every row into six lines of grey text.
 */
import type { TownEntry } from '@/lib/content';
import { LAND_TYPES, PLACE_STATUS_LABELS, PLACE_TYPE_LABELS } from '@/content/schemas';
import { PLACE_HUE } from '@/config/palette';
import { seasonLabel } from '@/lib/freshness';
import { hoursLines, hoursWithMeridiem, openingHoursOf } from '@/lib/hours';
import { isOpen } from '@/lib/places';
import Provenance from './Provenance.astro';
import { subTownLabel } from '@/lib/sub-towns';
import { shorten } from '@/lib/text';

interface Props {
  place: TownEntry<'places'>;
  /** 3 under a page heading, 4 under a category heading. */
  level?: 3 | 4;
}

const { place, level = 3 } = Astro.props;
const { data, slug } = place;
const href = `/places/${slug}/`;
const Heading = `h${level}` as 'h3' | 'h4';
const hue = PLACE_HUE[data.type];
const open = isOpen(place);
const hours = openingHoursOf(data);
// A park or a trail keeps daylight or no hours; "Hours unknown" is a
// business's line, and is not put on open ground.
const land = LAND_TYPES.includes(data.type);
const hoursUnknown = open && !data.hours && !place.hoursHidden && !land;
// The season in one line, from the months or dates the operator gave:
// "Open May–Oct", or "Closed for the season" once the gate has taken the
// hours away (src/lib/freshness.ts, seasonLabel). A season the block cannot
// place on the calendar is shown on the page only.
const season = open ? seasonLabel(data.seasonal) : undefined;
---
<li
  class="group relative grid gap-x-10 gap-y-2 border-b border-line-soft py-6 last:border-b-0 sm:grid-cols-[minmax(0,1fr)_minmax(10rem,14rem)] lg:grid-cols-[minmax(0,1fr)_18rem]"
  data-filter-item
  data-category={data.type}
  data-sub-town={data.subTown}
  data-name={data.title}
  data-land={land ? 'true' : undefined}
>
  <div>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <Heading class="text-[1.25rem] font-medium leading-tight">
        <a href={href} class="stretch no-underline group-hover:text-primary">{data.title}</a>
      </Heading>
      {!open && (
        <span class="rounded-full bg-ink px-2.5 py-0.5 text-[0.75rem] font-semibold uppercase tracking-[0.1em] text-raised">
          {PLACE_STATUS_LABELS[data.status]}
        </span>
      )}
    </div>
    {/* "Our pick" rides the type line: beside a long name it dropped to a
        line of its own, so some rows had an extra line and others did not. */}
    <p class="eyebrow mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1" style={`color:var(--cat-${hue}-ink)`}>
      <span class="inline-block size-2 shrink-0 rounded-full" style={`background:var(--cat-${hue}-dot)`} aria-hidden="true"></span>
      {PLACE_TYPE_LABELS[data.type]}{data.priceRange && <span class="text-ink-muted">{data.priceRange}</span>}{data.subTown && <span class="font-medium normal-case tracking-normal text-ink-muted">{subTownLabel(data.subTown)}</span>}
      {data.featured && open && (
        <span class="rounded-full bg-highlight px-2.5 py-0.5 text-[0.75rem] font-semibold uppercase tracking-[0.1em] text-ink">Our pick</span>
      )}
    </p>
    {/* About three lines on a phone, where a long list of full summaries ran
        past twelve thousand pixels, shortened at a word or phrase; all of it
        from 40rem. The short copy is left out of the search index. */}
    <p class="mt-2 line-clamp-3 max-w-[58ch] text-[0.9375rem] leading-relaxed text-ink-muted sm:line-clamp-none">
      <span class="sm:hidden" data-pagefind-ignore>{shorten(data.summary, 110)}</span><span class="hidden sm:inline">{data.summary}</span>
    </p>
  </div>
  <div class="grid content-start gap-1 text-[0.875rem] leading-snug text-ink-muted" data-hours={hours ? JSON.stringify(hours) : undefined}>
    {/* The state stays with its ZIP: "Firestone, CO / 80504" was the usual break. */}
    {data.address && <p class="text-ink">{data.address.replace(/ (\d{5})$/, '\u00a0$1')}</p>}
    {/* A closed place's old hours are the one thing a reader must not act on. */}
    {open ? data.hours && hoursLines(hoursWithMeridiem(data.hours)).map((line) => <p>{line}</p>) : <p class="text-ink">{data.statusNote}</p>}
    {open && place.hoursHidden === 'stale' && <p class="text-ink-muted">Hours not recently checked; call ahead</p>}
    {season && <p class:list={[place.hoursHidden === 'season' ? 'text-ink' : 'text-ink-muted']}>{season}</p>}
    {hoursUnknown && <p class="text-ink-muted">Hours unknown</p>}
    {hours && <p class="open-status font-semibold" data-open-status hidden></p>}
    <p class="text-[0.75rem]"><Provenance compact verified={data.verified} item={`place/${slug}`} title={data.title} /></p>
  </div>
</li>
