---
/**
 * Thin strip at the very bottom of every site, saying where this guide sits.
 *
 * On a guide: the hub, then "Sister guides", every other live guide by name,
 * A to Z, generated from the town configs. An earlier version carried only
 * the hub link, on the reasoning that a permanent list of towns on every page
 * reads as a link network; the owner chose the list (5 October 2026) so a
 * reader on one guide can see the others exist.
 *
 * On the hub the strip is the directory, listing every guide — the parent site
 * saying it is "part of" itself was the one place the shared component gave
 * itself away.
 *
 * The "Site by" credit sits at the end of the strip, small and apart from
 * the editorial, when the hub config sets one.
 */
import { getNetworkHub, getSite, liveTowns } from '@/config';

const site = getSite();
const hub = getNetworkHub();
const guides = site.kind === 'hub' ? liveTowns() : [];
const sisters = site.kind === 'town'
  ? liveTowns().filter((t) => t.slug !== site.slug).sort((a, b) => a.name.localeCompare(b.name, 'en'))
  : [];
const link = 'no-underline hover:text-white hover:underline';
---
<div class="border-t border-white/15 bg-black/30 text-[0.8125rem] text-white/70">
  <div class="container-page flex flex-wrap items-center gap-x-5 gap-y-1 py-3.5">
    {site.kind === 'hub' ? (
      <Fragment>
        <span><strong class="font-semibold text-highlight-ink">The guides</strong></span>
        <ul class="flex flex-wrap gap-x-4 gap-y-1">
          {guides.map((t) => (
            <li>
              <a href={`https://${t.domain}/`} class="no-underline hover:text-white hover:underline">{t.siteTitle}</a>
            </li>
          ))}
        </ul>
      </Fragment>
    ) : (
      <Fragment>
        <p class="w-full">
          Part of
          <a href={`https://${hub.domain}/`} class="ml-1 font-semibold text-highlight-ink no-underline hover:underline"
            >{hub.siteTitle}</a
          >, an independent network of guides to {liveTowns().length} Front Range towns.
        </p>
        {sisters.length > 0 && (
          <nav aria-label="Sister guides" class="flex flex-wrap gap-x-4 gap-y-1">
            <span><strong class="font-semibold text-highlight-ink">Sister guides</strong></span>
            <ul class="flex flex-wrap gap-x-4 gap-y-1">
              {sisters.map((t) => (
                <li><a href={`https://${t.domain}/`} class={link}>{t.name}</a></li>
              ))}
            </ul>
          </nav>
        )}
      </Fragment>
    )}
    {hub.credit && (
      <p class="sm:ml-auto">Site by <a href={hub.credit.url} class={link}>{hub.credit.label}</a></p>
    )}
  </div>
</div>
