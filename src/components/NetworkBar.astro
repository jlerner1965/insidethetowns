---
/**
 * Thin strip at the very bottom of every site, saying where this guide sits.
 *
 * On a guide: the hub, then "Sister guides", every other live guide by name,
 * A to Z, generated from the town configs. An earlier version carried only
 * the hub link, on the reasoning that a permanent list of towns on every page
 * reads as a link network; the owner chose the list (5 October 2026) so a
 * reader on one guide can see the others exist.
 *
 * On the hub the strip is the directory, listing every guide — the parent site
 * saying it is "part of" itself was the one place the shared component gave
 * itself away.
 *
 * The "Site by" credit sits at the end of the strip, smaller and fainter than
 * the guides and ruled off from them on a phone, so it does not read as one
 * more guide in the list, when the hub config sets one.
 *
 * On a phone the sister guides, with their taglines, ran to several screens
 * at the foot of every page (follow-up audit, 8 October 2026), so there the
 * list sits behind a native disclosure that says how many it holds. The
 * markup ships open, as it was; the script closes it on a narrow screen,
 * and from `sm` up the summary is not shown. A reader without the script
 * sees the list as before.
 */
import { getNetworkHub, getSite, liveTowns } from '@/config';

const site = getSite();
const hub = getNetworkHub();
// A to Z on the hub as on the guides, so a town is in the same place in both lists.
const byName = (a: { name: string }, b: { name: string }) => a.name.localeCompare(b.name, 'en');
const guides = site.kind === 'hub' ? [...liveTowns()].sort(byName) : [];
const sisters = site.kind === 'town'
  ? liveTowns().filter((t) => t.slug !== site.slug).sort(byName)
  : [];
// The links get a taller hit area on phones, where they are thumbed, and keep
// the strip compact from `sm` up, where they are clicked.
const link = 'inline-block py-2 no-underline hover:text-white hover:underline sm:py-0.5';
// A label, not a second headline: the amber is kept for the one link that
// matters most, the hub's name.
const label = 'text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-white/70';
---
<div class="border-t border-white/15 bg-black/30 text-[0.8125rem] text-white/70">
  <div class="container-page flex flex-wrap items-center gap-x-5 gap-y-1 py-3.5">
    {site.kind === 'hub' ? (
      <nav aria-label="The guides" class="flex flex-col sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-4">
        <span class={label}>The guides</span>
        <ul class="flex flex-wrap gap-x-4">
          {guides.map((t) => (
            <li><a href={`https://${t.domain}/`} class={link}>{t.siteTitle}</a></li>
          ))}
        </ul>
      </nav>
    ) : (
      <Fragment>
        <p class="w-full">
          Part of
          <a href={`https://${hub.domain}/`} class="font-semibold text-highlight-ink no-underline hover:underline"
            >{hub.siteTitle}</a
          >, an independent network of {liveTowns().length} Front Range town guides.
        </p>
        {sisters.length > 0 && (
          <nav aria-label="Sister guides" class="mt-2 w-full sm:mt-0">
            <details open data-sisters class="sm:flex sm:flex-wrap sm:items-baseline sm:gap-x-4">
              <summary class:list={[label, 'cursor-pointer py-2 sm:pointer-events-none sm:py-0 [&::-webkit-details-marker]:hidden']}>
                Sister guides<span class="sm:hidden"> ({sisters.length})</span>
              </summary>
              <ul class="flex flex-wrap gap-x-4 sm:contents">
                {sisters.map((t) => (
                  <li>
                    <a href={`https://${t.domain}/`} class={link}>{t.name}</a>{t.shortTagline && <span class="text-white/70"> · {t.shortTagline}</span>}
                  </li>
                ))}
              </ul>
            </details>
          </nav>
        )}
      </Fragment>
    )}
    {sisters.length > 0 && (
      <script>
        // Closed on a phone, open from `sm` up; the markup is open to start with.
        const sisters = document.querySelector<HTMLDetailsElement>('[data-sisters]');
        const narrow = window.matchMedia('(width < 40rem)');
        const settle = () => sisters?.toggleAttribute('open', !narrow.matches);
        settle();
        narrow.addEventListener('change', settle);
      </script>
    )}
    {(hub.publisher || hub.credit) && (
      <p class="mt-2 w-full border-t border-white/10 pt-3 text-[0.75rem] text-white/70 sm:mt-0 sm:ml-auto sm:w-auto sm:border-0 sm:pt-0">
        {hub.publisher ? (
          <Fragment>Published by <a href={hub.publisher.url} class="no-underline hover:text-white hover:underline">{hub.publisher.name}</a></Fragment>
        ) : (
          <Fragment>Site by <a href={hub.credit!.url} class="no-underline hover:text-white hover:underline">{hub.credit!.label}</a></Fragment>
        )}
      </p>
    )}
  </div>
</div>
