---
/**
 * "By town: Frederick · Firestone · Dacono", the line a multi-town guide's
 * list pages carry under their intro, each name linking to that town's
 * section page. Renders nothing on a single-town guide, so every page can
 * include it without asking first.
 */
import { getSite } from '@/config';
import { subTownsOf } from '@/lib/sub-towns';

interface Props {
  /** The section page is the default; `/events/` and `/directory/` link their own filtered view. */
  hrefFor?: (slug: string) => string;
  class?: string;
}

const { hrefFor = (slug: string) => `/${slug}/`, class: className = '' } = Astro.props;
const subTowns = subTownsOf(getSite());
---
{/* Named for what they are, pages, so they do not read as a second set of
   the "Where" filter buttons further down. */}
{subTowns.length > 1 && (
  <p class:list={['flex flex-wrap items-baseline gap-x-4 gap-y-1 text-[0.9375rem] text-ink-muted', className]}>
    <span class="eyebrow text-ink-muted">Town pages</span>
    {subTowns.map((t) => <a href={hrefFor(t.slug)} class="py-1 font-semibold text-primary underline">{t.label}</a>)}
  </p>
)}
