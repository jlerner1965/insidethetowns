---
/**
 * A place as a photo-led card with no box: image, eyebrow, serif title,
 * two-line summary.
 *
 * Places without a photo do not get an empty photo frame, which reads as a
 * missing image. They get a panel in the town's accent carrying what a photo
 * cannot: what kind of place it is, and its hours or price band. Every place
 * has tags, so the panel is never empty.
 */
import { Image } from 'astro:assets';
import type { TownEntry } from '@/lib/content';
import { PLACE_TYPE_LABELS } from '@/content/schemas';

interface Props {
  place: TownEntry<'places'>;
}

const { place } = Astro.props;
const { data, slug } = place;
const href = `/places/${slug}/`;
const facts = [data.priceRange, data.hours].filter(Boolean).join(' · ');
---
<article class="group relative flex flex-col" data-filter-item data-category={data.type}>
  <div class="aspect-[4/3] overflow-hidden rounded-lg bg-accent-soft">
    {data.image ? (
      <Image
        src={data.image}
        alt={data.imageAlt ?? ''}
        width={720}
        height={540}
        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
      />
    ) : (
      <div class="flex h-full flex-col p-5">
        <span
          class="display flex flex-1 items-center justify-center text-[5.5rem] leading-none text-accent-dark/25"
          aria-hidden="true"
        >
          {data.title.charAt(0)}
        </span>
        <div class="space-y-1.5">
          {data.tags.length > 0 && (
            <ul class="flex flex-wrap gap-1.5">
              {data.tags.slice(0, 3).map((tag) => (
                <li class="rounded-full bg-white/70 px-2.5 py-1 text-[0.6875rem] font-medium uppercase tracking-wide text-accent-dark">
                  {tag}
                </li>
              ))}
            </ul>
          )}
          {facts && <p class="line-clamp-2 text-[0.8125rem] leading-snug text-ink-muted">{facts}</p>}
        </div>
      </div>
    )}
  </div>
  <div class="mt-4">
    <p class="eyebrow">
      {PLACE_TYPE_LABELS[data.type]}{data.priceRange && <span class="ml-2 text-ink-faint">{data.priceRange}</span>}{data.area && <span class="ml-2 font-medium normal-case tracking-normal text-ink-faint">{data.area}</span>}
    </p>
    <h3 class="mt-1.5 text-[1.375rem] font-medium leading-tight">
      <a href={href} class="stretch no-underline group-hover:text-accent-dark">{data.title}</a>
    </h3>
    <p class="mt-2 line-clamp-2 text-[0.9375rem] leading-relaxed text-ink-muted">{data.summary}</p>
  </div>
</article>
