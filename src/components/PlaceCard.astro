---
/**
 * A place as a photo-led card with no box: image, eyebrow, serif title,
 * two-line summary.
 *
 * A card is the shape a photograph goes in. Without one there is nothing to
 * put in the frame, and a tinted rectangle where a photograph should be reads
 * as a page that failed to load, so the frame is simply not drawn. Pages lead
 * with the places they have photographs of and list the rest as directory
 * rows.
 *
 * The one exception is a pick the home page makes on purpose (owner,
 * 26 October 2026: "Eat, drink, wander" is to show a place to eat or drink,
 * a place outdoors and a place of the town's culture, and few guides hold a
 * licensed photograph of a café). Without a photograph the card is a panel
 * on the paper with the facts a photograph would otherwise earn its place
 * with: the whole summary, the price, the address and the hours. Not a
 * coloured tile, not an initial: words.
 */
import { Image } from 'astro:assets';
import type { TownEntry } from '@/lib/content';
import { PLACE_STATUS_LABELS, PLACE_TYPE_LABELS } from '@/content/schemas';
import { PLACE_HUE } from '@/config/palette';
import { seasonLabel } from '@/lib/freshness';
import { hoursWithMeridiem } from '@/lib/hours';
import { isOpen } from '@/lib/places';
import { subTownLabel } from '@/lib/sub-towns';
import { shorten } from '@/lib/text';

interface Props {
  place: TownEntry<'places'>;
}

const { place } = Astro.props;
const { data, slug } = place;
const href = `/places/${slug}/`;
const hue = PLACE_HUE[data.type];
const open = isOpen(place);
// "Open May–Oct" or "Closed for the season", where the operator gave the months or dates (src/lib/freshness.ts).
const season = open ? seasonLabel(data.seasonal) : undefined;
// Without a photograph: the facts the photograph's place would have carried.
const panel = !data.image;
const facts = panel ? [data.address, open ? data.hours && hoursWithMeridiem(data.hours) : data.statusNote].filter(Boolean) : [];
---
<article class:list={['group relative flex flex-col', panel && 'self-start rounded-lg bg-paper p-6 ring-1 ring-line-soft']} data-filter-item data-category={data.type} data-sub-town={data.subTown}>
  {data.image && (
    <div class="aspect-[4/3] overflow-hidden rounded-lg bg-accent-soft">
      {/* h-full!, as in ArticleCard: Astro's unlayered height: auto beats the
          utility, and a source wider than 4:3 left a band of tint under it. */}
      <Image
        src={data.image}
        alt={data.imageAlt ?? ''}
        width={720}
        height={540}
        class="h-full! w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
      />
    </div>
  )}
  <div class:list={[data.image && 'mt-4']}>
    <p class="eyebrow" style={`color:var(--cat-${hue}-ink)`}>
      {!open && <span class="mr-2 rounded-full bg-ink px-2 py-0.5 text-[0.75rem] text-raised">{PLACE_STATUS_LABELS[data.status]}</span>}
      {PLACE_TYPE_LABELS[data.type]}{data.priceRange && <span class="ml-2 text-ink-muted">{data.priceRange}</span>}{(data.area || data.subTown) && <span class="ml-2 font-medium normal-case tracking-normal text-ink-muted">{[data.area, data.subTown && subTownLabel(data.subTown)].filter(Boolean).join(', ')}</span>}
    </p>
    <h3 class="mt-1.5 text-[1.375rem] font-medium leading-tight">
      <a href={href} class="stretch no-underline group-hover:text-primary">{data.title}</a>
    </h3>
    {/* Shortened at a word or phrase to about two lines, rather than cut
        mid-word by the clamp, which stays as a net for a narrow card. */}
    {panel ? (
      <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-muted">{shorten(data.summary, 180)}</p>
    ) : (
      <p class="mt-2 line-clamp-2 text-[0.9375rem] leading-relaxed text-ink-muted">{shorten(data.summary, 80)}</p>
    )}
    {season && <p class:list={['mt-1.5 text-[0.875rem] font-medium', place.hoursHidden === 'season' ? 'text-ink' : 'text-ink-muted']}>{season}</p>}
    {facts.length > 0 && (
      <ul class="mt-4 space-y-1 border-t border-line-soft pt-3 text-[0.875rem] leading-snug text-ink-muted">
        {facts.map((f) => <li>{f}</li>)}
      </ul>
    )}
  </div>
</article>
