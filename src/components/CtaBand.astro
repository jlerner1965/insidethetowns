---
/**
 * A closing panel in the town's primary: a heading, a line, and somewhere to go
 * next.
 *
 * The short pages — about, contact — ran out of content halfway down the
 * screen and ended in a page-height gap above the footer. This gives them a
 * foot, and an onward link instead of a dead end.
 *
 * A full-width band, like the home page's "Moving here", rather than the
 * rounded card it was: the two closing panels of the site looked like two
 * different designs. It goes in Page's `after` slot, outside the page's
 * container, and as the last thing on the page it meets the footer.
 */
interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  links: Array<{ label: string; href: string; primary?: boolean }>;
}

const { eyebrow, title, body, links } = Astro.props;
---
<section class="on-dark mt-20 bg-primary text-white md:mt-24">
  <div class="container-page grid gap-8 py-16 md:grid-cols-[3fr_2fr] md:items-end md:py-20">
    <div>
      {eyebrow && <p class="eyebrow text-white">{eyebrow}</p>}
      <h2 class="display-md mt-3 text-[2.25rem] lg:text-5xl">{title}</h2>
    </div>
    <div>
      {body && <p class="leading-relaxed">{body}</p>}
      <div class="mt-6 flex flex-wrap gap-3">
        {links.map((l) => (
          <a href={l.href} class:list={['btn', l.primary ? 'btn-light' : 'btn-outline text-white']}>{l.label}</a>
        ))}
      </div>
    </div>
  </div>
</section>
