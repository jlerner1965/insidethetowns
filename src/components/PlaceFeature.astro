---
/**
 * One place across the full width: photograph on the left, the write-up on the
 * right.
 *
 * A three-column card grid holding a single photographed place leaves two
 * empty thirds, which reads as a broken page rather than a short one. Most of
 * these towns have only a handful of licensed photographs, so the lead has to
 * work at one and at two as well as at three.
 */
import { Image } from 'astro:assets';
import type { TownEntry } from '@/lib/content';
import { PLACE_TYPE_LABELS } from '@/content/schemas';

interface Props {
  place: TownEntry<'places'>;
}

const { place } = Astro.props;
const { data, slug } = place;
const href = `/places/${slug}/`;
const facts = [data.priceRange, data.address, data.hours].filter(Boolean);
---
<article class="group relative grid gap-6 overflow-hidden rounded-lg bg-white ring-1 ring-line-soft md:grid-cols-[5fr_4fr] md:gap-0">
  {data.image && (
    <Image
      src={data.image}
      alt={data.imageAlt ?? ''}
      width={880}
      height={660}
      class="aspect-[4/3] h-full w-full object-cover md:aspect-auto"
    />
  )}
  <div class="flex flex-col justify-center px-6 pb-7 md:px-9 md:py-9">
    <p class="eyebrow">
      {PLACE_TYPE_LABELS[data.type]}{data.area && <span class="ml-2 font-medium normal-case tracking-normal text-ink-faint">{data.area}</span>}
    </p>
    <h3 class="display-md mt-2 text-[2rem]">
      <a href={href} class="stretch no-underline group-hover:text-accent-dark">{data.title}</a>
    </h3>
    <p class="mt-3 max-w-[46ch] leading-relaxed text-ink-muted">{data.summary}</p>
    {facts.length > 0 && (
      <ul class="mt-5 space-y-1 border-t border-line-soft pt-4 text-[0.875rem] leading-snug text-ink-muted">
        {facts.map((f) => <li>{f}</li>)}
      </ul>
    )}
  </div>
</article>
