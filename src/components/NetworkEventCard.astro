---
/**
 * An event on the hub: the same editorial row as a town's own listing, plus
 * the town it belongs to, and a link that crosses to that town's domain.
 *
 * The town badge carries that town's accent. It is the one place the seven
 * palettes work together rather than separately, and it is what tells you at a
 * glance that the farmers market you want is in Lyons and not in Erie.
 */
import type { NetworkEntry } from '@/lib/content';
import { formatTimeRange, toIsoLocal } from '@/lib/dates';
import { CATEGORY_LABELS } from '@/content/schemas';

interface Props {
  event: NetworkEntry<'events'>;
}

const { event } = Astro.props;
const { data, slug, town } = event;
const href = `https://${town.domain}/events/${slug}/`;
const time = data.timeNote ?? formatTimeRange(data.start, data.end, data.allDay);
---
<article
  class="group relative grid grid-cols-1 gap-x-7 border-t border-line-soft py-5 first:border-t-0 sm:grid-cols-[7rem_1fr] md:py-6"
  data-filter-item
  data-category={town.slug}
>
  <p class="mb-1.5 sm:mb-0 sm:pt-1">
    <span
      class="inline-block rounded-full px-2.5 py-1 text-[0.6875rem] font-semibold uppercase tracking-[0.1em] text-white"
      style={`background:${town.colors.accentDark}`}
    >{town.name}</span>
  </p>
  <div class="min-w-0">
    <p class="eyebrow flex items-center gap-2" style={`color:var(--cat-${data.category}-ink)`}>
      <span class="inline-block size-2 shrink-0 rounded-full" style={`background:var(--cat-${data.category}-dot)`} aria-hidden="true"></span>
      {CATEGORY_LABELS[data.category]}
    </p>
    <h3 class="mt-1.5 text-xl font-medium leading-tight md:text-2xl">
      <a href={href} class="stretch no-underline group-hover:text-accent-text">{data.title}</a>
    </h3>
    <p class="mt-2 text-[0.9375rem] leading-snug text-ink-muted">
      <time datetime={toIsoLocal(data.start)}>{time}</time> · {data.venue}{data.cost && <span> · {data.cost}</span>}
    </p>
  </div>
</article>
