---
/**
 * An event on the hub: the same editorial row as a town's own listing, plus
 * the town it belongs to, and a link that crosses to that town's domain.
 *
 * The town badge carries that town's accent, on one line: in a 7rem column
 * "Fort Collins" and "Carbon Valley" wrapped into lozenges twice the height of
 * the rest. It is the one place the towns'
 * palettes work together rather than separately, and it is what tells you at a
 * glance that the farmers market you want is in Lyons and not in Erie.
 */
import type { NetworkEntry } from '@/lib/content';
import { dayKey, formatDayRange, formatDayShort, formatMonthDay, formatTimeRange, toIsoLocal } from '@/lib/dates';
import { eventEnd, isCanceled, isInProgress, lastDay } from '@/lib/events';
import { EVENT_STATUS_LABELS, shownCategoryLabel } from '@/content/schemas';

interface Props {
  event: NetworkEntry<'events'>;
  /**
   * Say which day, for a list that is not under day headings: "Sat, Oct 10 ·
   * 10 am – 2 pm". A run already on still says "Now through…".
   */
  showDay?: boolean;
  /** Say what the town is, under its badge: the Nearby block, where the reader may not know it. */
  showTagline?: boolean;
}

const { event, showDay = false, showTagline = false } = Astro.props;
const { data, slug, town } = event;
const href = `https://${town.domain}/events/${slug}/`;
const canceled = isCanceled(event);
const statusLabel = data.status !== 'scheduled' ? EVENT_STATUS_LABELS[data.status] : undefined;
// The same reading of a run of days as EventCard: "Now through October 31"
// while it is on, the range before it starts.
const multiDay = !!data.end && dayKey(data.start) !== dayKey(data.end);
const running = multiDay && !canceled && isInProgress(event);
const when =
  data.timeNote ??
  (running
    ? `Now through ${formatMonthDay(data.end!)}`
    : multiDay && data.allDay
      ? formatDayRange(data.start, data.end!)
      : formatTimeRange(data.start, data.end, data.allDay));
// "Other" is filed but not labelled, as on a town's own list (EventCard).
const categoryLabel = shownCategoryLabel(data.category);
// A multi-day time range already names its days, and a run says "Now through".
const time = showDay && !running && !multiDay ? `${formatDayShort(data.start)} · ${when}` : when;
---
<article
  class="group relative grid grid-cols-1 gap-x-7 border-t border-line-soft py-5 first:border-t-0 sm:grid-cols-[9rem_1fr] md:py-6"
  data-filter-item
  data-category={town.slug}
  data-event-day={lastDay(event)}
  data-start={toIsoLocal(data.start)}
  data-end={toIsoLocal(eventEnd(event))}
>
  <p class="mb-1.5 sm:mb-0 sm:pt-1">
    <span
      class="inline-block whitespace-nowrap rounded-full px-2.5 py-1 text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-white"
      style={`background:${town.colors.accentDark}`}
    >{town.name}</span>
    {showTagline && town.shortTagline && <span class="mt-1 block text-[0.8125rem] leading-snug text-ink-faint">{town.shortTagline}</span>}
  </p>
  <div class="min-w-0">
    {(categoryLabel || statusLabel) && (
      <p class="eyebrow mb-1.5 flex flex-wrap items-center gap-2" style={`color:var(--cat-${data.category}-ink)`}>
        {categoryLabel && (
          <span class="inline-block size-2 shrink-0 rounded-full" style={`background:var(--cat-${data.category}-dot)`} aria-hidden="true"></span>
        )}
        {categoryLabel}
        {statusLabel && (
          <span class="rounded-full bg-ink px-2 py-0.5 text-[0.75rem] font-semibold uppercase tracking-[0.1em] text-raised">{statusLabel}</span>
        )}
      </p>
    )}
    <h3 class="text-xl font-medium leading-tight md:text-2xl">
      <a href={href} class:list={['stretch no-underline group-hover:text-accent-text', canceled && 'line-through decoration-ink-faint decoration-2']}>{data.title}</a>
    </h3>
    <p class="mt-2 text-[0.9375rem] leading-snug text-ink-muted">
      <time datetime={toIsoLocal(data.start)}>{time}</time> · {data.venue}{data.cost && <span> · {data.cost}</span>}
    </p>
    {statusLabel && data.statusNote && <p class="mt-1 text-sm text-ink">{data.statusNote}</p>}
  </div>
</article>
