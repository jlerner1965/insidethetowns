---
/**
 * The numbered list of a long read's sections. A rail beside the text on a
 * wide screen; on a phone, a closed panel above the text, because as a rail
 * it fell to the very end of the page, after the sources, where a contents
 * list is no use.
 */
interface Props {
  headings: Array<{ slug: string; text: string }>;
  /** "In this article", "In this guide". */
  label: string;
  /** `rail` beside the text from lg; `panel` before it below lg. */
  variant: 'rail' | 'panel';
  id: string;
}

const { headings, label, variant, id } = Astro.props;
const list = 'space-y-2 text-[0.9375rem] leading-snug';
// An article that numbers its own headings ("01 · Coal Creek Park", the
// Explore guides' stops) keeps its numbers, shown once in the number column;
// the list adds none of its own there, or every stop read "01 01 · …" and the
// unnumbered sections after the stops got numbers the article never gave.
const OWN_NUMBER = /^(\d{1,2}) · (.+)$/;
const ownNumbers = headings.some((h) => OWN_NUMBER.test(h.text));
const items = headings.map((h, i) => {
  const own = h.text.match(OWN_NUMBER);
  return {
    slug: h.slug,
    text: own ? own[2]! : h.text,
    number: own ? own[1]!.padStart(2, '0') : ownNumbers ? '' : String(i + 1).padStart(2, '0'),
  };
});
---
{variant === 'panel' ? (
  <details class="rounded-lg bg-raised px-5 ring-1 ring-line-soft lg:hidden">
    <summary class="eyebrow flex min-h-12 cursor-pointer items-center justify-between gap-4" id={id}>
      {label} · {headings.length}
      <span aria-hidden="true" class="text-ink-muted">＋</span>
    </summary>
    <nav aria-labelledby={id} class="border-t border-line-soft pb-4 pt-3">
      <ol class={list}>
        {items.map((h) => (
          <li class="flex gap-3">
            <span class="min-w-[2ch] shrink-0 tabular-nums text-ink-muted">{h.number}</span>
            <a href={`#${h.slug}`} class="py-0.5 no-underline hover:text-primary hover:underline">{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
) : (
  <nav aria-labelledby={id} class="hidden lg:block">
    <p class="eyebrow border-b border-line-soft pb-3" id={id}>{label}</p>
    <ol class:list={['mt-3', list]}>
      {items.map((h) => (
        <li class="flex gap-3">
          <span class="min-w-[2ch] shrink-0 tabular-nums text-ink-muted">{h.number}</span>
          <a href={`#${h.slug}`} class="no-underline hover:text-primary hover:underline">{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
