---
import { getNetworkHub, getSite } from '@/config';
import { getTownEntries } from '@/lib/content';
import { siteNav } from '@/lib/nav';
import { schoolsFor } from '@/config/school-sports';
import NetworkBar from './NetworkBar.astro';
import Wordmark from './Wordmark.astro';

interface Props {
  /**
   * The flagship home page's footer (Base `chrome="home"`): one list of
   * seven links (the homepage brief, 25 October 2026), the Independent
   * statement and the network line, set to the home page's reading sizes by
   * its stylesheet. Every other page keeps the full footer.
   */
  home?: boolean;
}

const site = getSite();
const hub = getNetworkHub();
const year = new Date().getFullYear();
// A phone gets a taller line to tap: the links were 19px high, under the 24px
// minimum, a few pixels apart.
const linkClass = 'inline-block py-1 no-underline text-white hover:underline sm:py-0';
// Every section of the guide the menu leaves out (src/lib/nav.ts), so each
// is one click from any page and none is reachable only from an aside.
const inMenu = new Set(siteNav(site).map((n) => n.href));
const hasUpdates = site.kind === 'town' && (await getTownEntries('updates')).length > 0;
const sections = site.kind === 'town'
  ? [
      { label: 'This weekend', href: '/this-weekend/' },
      { label: 'Things to do', href: '/things-to-do/' },
      { label: 'Guides', href: '/guides/' },
      { label: 'Every place, A to Z', href: '/directory/' },
      { label: 'Moving here', href: '/moving-here/' },
      ...(site.participation ? [{ label: 'Get involved', href: '/get-involved/' }] : []),
      ...(hasUpdates ? [{ label: 'Local changes', href: '/updates/' }] : []),
    ].filter((l) => !inMenu.has(l.href))
  : [];
const homeTown = Astro.props.home && site.kind === 'town' && site.home ? site : undefined;
const mascot = homeTown?.school && schoolsFor(homeTown.slug).length > 0 ? homeTown.school.mascot : undefined;
const homeLinks = homeTown
  ? [
      { label: 'This week', href: '/this-week/' },
      ...(mascot ? [{ label: mascot, href: '/sports/' }] : []),
      { label: 'Eat & drink', href: '/eat-drink/' },
      homeTown.livingHere ? { label: 'Living here', href: '/living-here/' } : { label: 'Moving here', href: '/moving-here/' },
      { label: 'Submit an event', href: '/submit-event/' },
      { label: 'For businesses', href: '/for-businesses/' },
      { label: 'Contact', href: '/contact/' },
    ]
  : [];
---
{homeTown ? (
  <footer class="fh-footer on-dark bg-primary text-white" data-pagefind-ignore>
    <div class="container-page fh-footer-grid">
      <div>
        <Wordmark class="text-3xl leading-none" tone="light" />
        <p class="fh-footer-tagline">{homeTown.tagline}</p>
        <ul class="fh-footer-links">
          {homeLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div class="fh-footer-independent">
        <p class="fh-footer-label">Independent</p>
        <p>
          {homeTown.siteTitle} is an independent community guide, not a government website.
          For official information see
          <a href={homeTown.officialLinks.townSite} rel="noopener">{homeTown.officialLinks.townSiteLabel ?? `the official ${homeTown.name} site`}</a>{(homeTown.officialLinks.also ?? []).map((g, i, all) => (
            <Fragment>{i === all.length - 1 ? ' and ' : ', '}<a href={g.url} rel="noopener">{g.label}</a></Fragment>
          ))}.
        </p>
        <p>© {year} {homeTown.siteTitle}</p>
      </div>
    </div>
    <NetworkBar home />
  </footer>
) : (
<footer class="on-dark mt-24 bg-primary text-white" data-pagefind-ignore>
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 md:py-20 lg:grid-cols-[1.5fr_1fr_1fr_1.3fr] lg:gap-12">
    <div>
      <Wordmark class="text-3xl leading-none" tone="light" />
      <p class="mt-4 max-w-sm text-[0.9375rem] leading-relaxed">{site.tagline}</p>
      {sections.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-x-5 text-[0.9375rem] font-semibold">
          {sections.map((l) => <li><a href={l.href} class={linkClass}>{l.label}</a></li>)}
        </ul>
      )}
    </div>
    <div>
      <p class="eyebrow text-white">Get in touch</p>
      <ul class="mt-3 space-y-0.5 text-[0.9375rem] sm:mt-4 sm:space-y-2">
        <li><a href="/contact/" class={linkClass}>Contact</a></li>
        {/* The address itself, on every page: it was on /about/ and the
            contact form alone (network audit, 14 October 2026). The
            network's one address, which is where every town's mail goes. */}
        <li><a href={`mailto:${hub.social.email}`} class={linkClass}>{hub.social.email}</a></li>
        {site.kind === 'town' && (
          <li><a href="/submit-event/" class={linkClass}>Submit an event</a></li>
        )}
        {site.kind === 'town' && (
          <li><a href="/for-businesses/" class={linkClass}>For businesses</a></li>
        )}
        {hub.newsletter && (
          <li><a href={`https://${hub.domain}/newsletter/`} class={linkClass}>Weekly email</a></li>
        )}
        <li>
          <a href={site.kind === 'hub' ? '/advertise/' : `https://${hub.domain}/advertise/`} class={linkClass}>
            Partner with us
          </a>
        </li>
        {site.social.instagram && <li><a href={site.social.instagram} rel="noopener" class={linkClass}>Instagram</a></li>}
        {site.social.facebook && <li><a href={site.social.facebook} rel="noopener" class={linkClass}>Facebook</a></li>}
      </ul>
    </div>
    {/* Out of "Get in touch", where ten links ran under a heading that fitted
        the first six: these say what the site is and how it works. */}
    <div>
      <p class="eyebrow text-white">{site.kind === 'town' ? 'This guide' : 'This site'}</p>
      <ul class="mt-3 space-y-0.5 text-[0.9375rem] sm:mt-4 sm:space-y-2">
        <li><a href="/about/" class={linkClass}>About</a></li>
        <li><a href="/editorial/" class={linkClass}>Editorial policy</a></li>
        <li><a href="/credits/" class={linkClass}>Photo credits</a></li>
        <li><a href="/privacy/" class={linkClass}>Privacy</a></li>
      </ul>
    </div>
    <div class="text-[0.875rem] leading-relaxed">
      <p class="eyebrow text-white">Independent</p>
      {site.kind === 'town' ? (
        <p class="mt-4">
          {site.siteTitle} is an independent community guide, not a government website.
          For official information see
          <a href={site.officialLinks.townSite} rel="noopener" class="text-white underline">{site.officialLinks.townSiteLabel ?? `the official ${site.name} site`}</a>{(site.officialLinks.also ?? []).map((g, i, all) => (
            <Fragment>{i === all.length - 1 ? ' and ' : ', '}<a href={g.url} rel="noopener" class="text-white underline">{g.label}</a></Fragment>
          ))}.
        </p>
      ) : (
        <p class="mt-4">{site.siteTitle} publishes independent community guides. None of its sites is affiliated with a town government.</p>
      )}
      <p class="mt-4">© {year} {site.siteTitle}</p>
    </div>
  </div>
  <NetworkBar />
</footer>
)}
