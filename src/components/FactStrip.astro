---
/**
 * A row of labeled facts: population, county, what the guide holds.
 *
 * Pages that are nothing but prose read as unfinished no matter how good the
 * prose is, because there is no shape to look at before you start reading.
 * This gives one, out of numbers the site already knows, and fills the width
 * that a single column of text leaves empty.
 */
interface Props {
  facts: Array<{ label: string; value: string; href?: string }>;
  /** Numbers get the display face at size; sentences stay at reading size. */
  size?: 'number' | 'text';
  /** Where the figures come from. A sourced number beats an asserted one. */
  note?: string;
}

const { facts, size = 'text', note } = Astro.props;
const value = size === 'number' ? 'display-md mt-2 text-[2rem] text-primary' : 'mt-2 text-[1.0625rem] leading-snug';
// Written out rather than interpolated so Tailwind can see the class names.
// Two to a row from the smallest screen: one to a row, four facts took a whole
// phone screen. An odd last fact spans the row.
const columns: Record<number, string> = {
  1: 'grid-cols-1',
  2: 'grid-cols-2',
  3: 'grid-cols-2 lg:grid-cols-3 [&>:last-child]:col-span-2 lg:[&>:last-child]:col-span-1',
  4: 'grid-cols-2 lg:grid-cols-4',
};
---
{facts.length > 0 && (
  <div>
  <dl class:list={['grid gap-px overflow-hidden rounded-lg bg-primary-line ring-1 ring-primary-line', columns[Math.min(facts.length, 4)]]}>
    {facts.map((f) => (
      <div class="min-w-0 bg-raised px-4 py-4 sm:px-5 sm:py-5">
        <dt class="eyebrow">{f.label}</dt>
        <dd class={value}>
          {f.href ? <a href={f.href} rel="noopener" class="text-primary no-underline hover:underline">{f.value}</a> : f.value}
        </dd>
      </div>
    ))}
  </dl>
  {note && <p class="mt-3 text-[0.8125rem] text-ink-muted">{note}</p>}
  </div>
)}
