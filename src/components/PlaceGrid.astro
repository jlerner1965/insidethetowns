---
import type { TownEntry } from '@/lib/content';
import { PLACE_TYPE_LABELS, type PlaceType } from '@/content/schemas';
import FilterBar from './FilterBar.astro';
import PlaceCard from './PlaceCard.astro';

interface Props {
  places: TownEntry<'places'>[];
  filterable?: boolean;
  emptyMessage?: string;
}

const { places, filterable = false, emptyMessage = 'Nothing listed yet.' } = Astro.props;
const types = [...new Set(places.map((p) => p.data.type))] as PlaceType[];
const options = types.map((t) => ({ value: t, label: PLACE_TYPE_LABELS[t] }));
---
<div data-filter-root>
  {filterable && <FilterBar options={options} label="Filter places" />}
  {places.length === 0 ? (
    <p class="rounded-lg border border-dashed border-line p-6 text-center text-ink-muted">{emptyMessage}</p>
  ) : (
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {places.map((place) => <PlaceCard place={place} />)}
    </div>
  )}
  <p data-filter-empty hidden class="rounded-lg border border-dashed border-line p-6 text-center text-ink-muted">Nothing in this category yet.</p>
</div>
