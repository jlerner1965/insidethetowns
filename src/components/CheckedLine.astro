---
/**
 * A list page's one provenance line, under its title: "Checked by James,
 * October 21, 2026", or "Checked by James, October 7 to October 21, 2026"
 * when the items were read on different days. Each row keeps its own
 * source link; the date is said once rather than under every row
 * (navigation audit, 22 October 2026, item 5: fifteen "checked Oct 21"
 * lines on one page read like an audit log).
 *
 * The dates are the items' own `verified` days, never the build's: a page
 * whose items were read last week says last week.
 */
import { formatDate, formatMonthDay, parseLocal } from '@/lib/dates';
import { checkedBy } from '@/lib/editor';

interface Props {
  /** Each item's check date: a Date, or "2026-10-21" from a config. */
  dates: (Date | string | undefined)[];
  class?: string;
}

const { dates, class: className } = Astro.props;
const days = dates
  .filter((d): d is Date | string => !!d)
  .map((d) => (typeof d === 'string' ? parseLocal(d) : d))
  .sort((a, b) => a.getTime() - b.getTime());
const first = days[0];
const last = days.at(-1);
const sameDay = first && last && formatDate(first) === formatDate(last);
const sameYear = first && last && first.getFullYear() === last.getFullYear();
const text = !first || !last ? undefined : sameDay ? formatDate(last) : `${sameYear ? formatMonthDay(first) : formatDate(first)} to ${formatDate(last)}`;
---
{text && (
  <p class:list={['mt-3 text-[0.875rem] text-ink-muted', className]}>
    {checkedBy(text)} · <a href="/editorial/" class="underline">How we check</a>
  </p>
)}
