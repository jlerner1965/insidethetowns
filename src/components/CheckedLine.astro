---
/**
 * A list page's one provenance line, under its title: "Checked October
 * 22, 2026: every item here was read against its own source that day", or
 * "Checked item by item, October 7 to October 22, 2026, not all on one
 * day; each row gives the day its source was read" when the items were
 * read on different days. Each row keeps its own source link, and its own
 * date where the row shows one (`perItem`); the line never speaks for a
 * row as if it had been read the day the page was (navigation audit, 22
 * October 2026, item 5; Lyons audit, 26 October 2026). The wording is
 * src/lib/checked.ts.
 *
 * The dates are the items' own `verified` days, never the build's: a page
 * whose items were read last week says last week.
 */
import { checkedLineText } from '@/lib/checked';

interface Props {
  /** Each item's check date: a Date, or "2026-10-21" from a config. */
  dates: (Date | string | undefined)[];
  /** Each row on the page shows its own check date. */
  perItem?: boolean;
  class?: string;
}

const { dates, perItem = false, class: className } = Astro.props;
const text = checkedLineText(dates, { perItem });
---
{text && (
  <p class:list={['mt-3 text-[0.875rem] text-ink-muted', className]}>
    {text} <a href="/editorial/" class="underline">How we check</a>
  </p>
)}
