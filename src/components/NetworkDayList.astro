---
/**
 * Events grouped under day headings, for the hub, where each listing also has
 * to say which town it is in and link across to that town's site.
 */
import type { NetworkEntry } from '@/lib/content';
import { groupByDay } from '@/lib/events';
import { formatDayLong, toIsoLocal } from '@/lib/dates';
import NetworkEventCard from './NetworkEventCard.astro';

interface Props {
  events: NetworkEntry<'events'>[];
  emptyMessage: string;
}

const { events, emptyMessage } = Astro.props;
const days = groupByDay(events);
---
{days.length === 0 ? (
  <p class="rounded-lg border border-dashed border-line px-6 py-10 text-center text-ink-muted">{emptyMessage}</p>
) : (
  <div class="space-y-10 md:space-y-12">
    {days.map((day) => (
      <section data-filter-group class="md:grid md:grid-cols-[15rem_1fr] md:gap-8 lg:gap-10">
        <h3 class="mb-2 md:mb-0 md:pt-6">
          <time datetime={toIsoLocal(day.date)} class="display-md block text-3xl text-accent-text md:text-[2.25rem]">
            {formatDayLong(day.date).split(', ').map((part, i) => (
              <span class:list={[i === 0 ? 'eyebrow block mb-2' : 'block']}>{part}</span>
            ))}
          </time>
        </h3>
        <div class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
          {day.events.map((event) => <NetworkEventCard event={event} />)}
        </div>
      </section>
    ))}
  </div>
)}
