---
/**
 * "This week in [Town]": what to know, the editor's pick, the week's
 * listings, what is closing for registration, what is new or closed, a
 * resident's question answered, a local feature, then the neighbours and
 * the hill, with the signup under it. One component in two sizes: the whole
 * of /this-week/, and a compact version the shared home page shows.
 *
 * Every section is shown only with something in it; a week with no pick
 * and no listings says so in one line and still offers the email. The
 * town's own content comes first, every time: the neighbours' weekend and
 * the mountain guides' sit below it, on the full page only, and the hill is
 * labelled as the day trip it is (flagship brief, 21 October 2026: Niwot's
 * page led with Evergreen, Manitou Springs and Golden on a thin week).
 *
 * The pick and the New & closed items are the editor's weekly notes
 * (content/<town>/weekly/, src/lib/weekly.ts); the listings are the
 * calendar every other page reads; "Things to know" is the local-changes
 * collection (src/lib/updates.ts) and the deadlines the programs
 * (src/lib/programs.ts). A change the guide found long after it happened
 * is set apart as a correction with both dates, not as the week's news.
 *
 * Everything under the week's heading is on inside that week. The pick is
 * dated by the listing it links to (`currentPick`): one for a later date is
 * not this week's pick, and goes under "Coming up" with its own date. With no
 * pick for the week the top listing of the home page's ranking leads instead
 * (`highlights`), as a Highlight: nobody picked it, so it is not Our pick.
 * In the compact version the pick's own listing is not repeated in the rows
 * under it.
 *
 * Every date is decided at build time, in Denver, and the nightly rebuild
 * keeps it current; the browser also clears a listing whose day has passed
 * (Freshness.astro), so a build older than the weekend shows fewer rows
 * rather than wrong ones.
 */
import DeadlineList from './DeadlineList.astro';
import NearbyWeekend from './NearbyWeekend.astro';
import NewsletterSignup from './NewsletterSignup.astro';
import SectionHeader from './SectionHeader.astro';
import SubHeading from './SubHeading.astro';
import CheckedLine from './CheckedLine.astro';
import UpdateRow from './UpdateRow.astro';
import UpTheHill from './UpTheHill.astro';
import WeekEventRow from './WeekEventRow.astro';
import { neighborsOf, type TownConfig } from '@/config';
import { getNeighborEntries, getTownEntries } from '@/lib/content';
import { formatDate, formatDayLong, formatDayRange, toIsoLocal } from '@/lib/dates';
import { highlights, isMultiDay, lastDay, listedUntil, nearbyPicks, occurrences, recommendationKeys, timeText, weekendWindow } from '@/lib/events';
import { activeChanges, briefingUpdates, corrections, currentNotes, currentPick, isWeekend, weekEvents, weekWindow } from '@/lib/weekly';
import { currentUpdates, isLateNotice } from '@/lib/updates';
import { subTownLabel } from '@/lib/sub-towns';
import { UPDATE_KIND_LABELS } from '@/content/schemas';
import { schoolsFor, schoolTeamName, sportsPath, type SportsData } from '@/config/school-sports';
import { formatGameTime, resultText, sportsDataFor, weekAhead, when as gameWhen, where } from '@/lib/school-sports';

interface Props {
  town: TownConfig;
  /** The home page's version: the first few of each, and a link to the rest. */
  compact?: boolean;
  /** The signup under it; off where the page places its own. */
  signup?: boolean;
  class?: string;
}

const { town, compact = false, signup = true, class: className } = Astro.props;
const now = new Date();
const { monday, sunday } = weekWindow(now);
const range = formatDayRange(monday, sunday);
const weekend = weekendWindow(now);
// Friday to Sunday the listings are the weekend's; earlier in the week they
// run from today to Sunday, and the heading says which.
const onWeekend = isWeekend(now);
const listingsLabel = onWeekend ? 'This weekend' : 'Rest of the week';
const listingsRange = onWeekend ? formatDayRange(weekend.start, weekend.sunday) : formatDayRange(now, sunday);

const notes = await getTownEntries('weekly');
const calendar = occurrences(await getTownEntries('events'), { now, horizonDays: 30 });
const { thisWeek: pick, comingUp } = currentPick(notes, calendar, now);
const allChanges = activeChanges(notes, now);
const current = currentNotes(notes, now)?.data;
const qa = current?.qa;
const feature = current?.feature;
const allEvents = weekEvents(calendar, now);
// No editor's pick this week: the week leads with the listing the home page
// would, the top of the same ranking, so one confirmed with its organizer and
// neither canceled nor flagged. Only the listing's own facts are shown; a
// weekly note's pick still takes its place.
const highlight = pick ? undefined : highlights(allEvents, { now, limit: 1 })[0];
const lead = pick?.event ?? highlight;
// The pick is not listed again under it, on the home page or the full page
// (Timnath's week was one farmers market, shown as the Highlight and again
// as the only row: navigation audit, 22 October 2026).
const rows = lead ? allEvents.filter((e) => e.slug !== lead.slug) : allEvents;
const events = compact ? rows.slice(0, 3) : rows;
const fresh = allChanges.filter((c) => !c.backlog);
const backlog = allChanges.filter((c) => c.backlog);
const changes = compact ? fresh.slice(0, 2) : fresh;
// The briefing is the week's: a change the guide only just caught up with
// (an old closure, a move in September) is a correction, below, never a
// thing to know this week, however recently its source was read.
const updateEntries = await getTownEntries('updates');
const allUpdates = currentUpdates(updateEntries, now);
const updates = briefingUpdates(allUpdates, now);
const know = compact ? updates.slice(0, 2) : updates.slice(0, 5);
// Corrections to the guide: the late-noticed changes and the notes'
// backlog, each business once (src/lib/weekly.ts, corrections).
const corrected = corrections(backlog, allUpdates.filter((u) => isLateNotice(u)));
const programs = await getTownEntries('programs');
// The /updates/ route builds only where the guide has the folder (town-routes.ts).
const hasUpdates = updateEntries.length > 0;
// Nothing on this week: the week leads with what is next on the calendar
// instead, so a page never opens on an apology (Niwot's home did); the line
// saying the week is empty shows only when nothing later is listed either.
const quiet = !pick && allEvents.length === 0;
const sundayEnd = new Date(sunday.getTime() + 86_400_000);
const seen = new Set<string>();
const later = quiet
  ? [...calendar]
      .sort((x, y) => x.data.start.getTime() - y.data.start.getTime())
      .filter((e) => e.data.start.getTime() >= sundayEnd.getTime() && !seen.has(e.slug) && seen.add(e.slug))
      .slice(0, compact ? 3 : 5)
  : [];
// The pick's own day and time, from its listing: "Friday, October 9 · 7 pm".
const when = (event: typeof calendar[number]) =>
  [isMultiDay(event) ? undefined : formatDayLong(event.data.start), timeText(event, now)].filter(Boolean).join(' · ');

// The school's games this week, after the pick (or the highlight standing
// in for it) and before the listings: the strip's own selection (football
// first, src/lib/school-sports.ts weekAhead), each with the team's record,
// then the last result. On the full page only: the home page has the strip
// beside this block already. Nothing drawn for a week with no games; a
// town's several schools each get a line group.
const sportsFiles = import.meta.glob<SportsData>('../../data/*/sports*.json', { eager: true, import: 'default' });
const schoolWeeks = compact
  ? []
  : schoolsFor(town.slug).flatMap((school) => {
      const data = sportsDataFor(school, sportsFiles);
      const week = data ? weekAhead(data, now) : undefined;
      return week && week.games.length > 0 ? [{ school, week }] : [];
    });

// Under the page's own h1 the sections are h2s, in the site's one h2 style
// (SectionHeader); under the home page's section heading they step down one.
const Heading = compact ? SubHeading : SectionHeader;

// The neighbours' weekend and the hill, on the full page: chosen here so the
// hill's strip leaves out what Nearby already shows. One event was both on
// Lyons' page, the Stanley's DeVotchKa ball (audit, 26 October 2026).
const neighbors = neighborsOf(town);
const nearby = compact
  ? []
  : nearbyPicks(occurrences(await getNeighborEntries('events', neighbors), { now, horizonDays: 30 }), neighbors.map((t) => t.slug), { now, limit: 4 });
const shownNearby = new Set(nearby.flatMap(recommendationKeys));
const block = compact ? 'mt-10' : 'mt-12 md:mt-14';
const v = compact ? 'compact' : 'full';
const hubHref = town.families ? '/families/' : town.participation ? '/get-involved/' : undefined;
---
<section class={className} data-this-week>
  {compact ? (
    <SectionHeader eyebrow={`This week in ${town.name}`} title={range} href="/this-week/" linkLabel="See the full week" />
  ) : (
    <div>
      <p class="eyebrow">{range}</p>
      <CheckedLine dates={[...allEvents.map((e) => e.data.verified), ...know.map((u) => u.data.verified)]} class="mt-2" />
    </div>
  )}

  {know.length > 0 && (
    <section class={block} aria-labelledby={`know-${v}`}>
      <Heading id={`know-${v}`} title="Things to know this week" />
      <div class="mt-2 rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
        {know.map((u) => <UpdateRow update={u} compact />)}
      </div>
      {updates.length > know.length && (
        <p class="mt-4 text-[0.9375rem]"><a href="/updates/" class="inline-block -my-2.5 py-2.5 font-semibold text-primary underline">All {updates.length} current changes →</a></p>
      )}
    </section>
  )}

  {/* What is on this week, in one scope: the browser clears what has ended
     from a build older than it (Freshness.astro), and once nothing is left
     the empty line shows instead. */}
  <div data-events-scope>
  {later.length > 0 && (
    <section class={block} data-hide-when-empty aria-labelledby={`later-${v}-cal`}>
      <Heading id={`later-${v}-cal`} title="Next on the calendar" />
      <div class="mt-2 rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
        {later.map((event) => <WeekEventRow event={event} />)}
      </div>
      <p class="mt-4 text-[0.9375rem]"><a href="/events/" class="inline-block -my-2.5 py-2.5 font-semibold text-primary underline">Every event →</a></p>
    </section>
  )}
  <div data-events-empty hidden={!quiet || later.length > 0} class="mt-8 rounded-lg border border-dashed border-line px-6 py-8 text-center text-ink-muted">
    {/* "Nothing listed" is a fact about this guide; "nothing happening" would be a claim about the town. */}
    <p>Nothing verified on the {town.name} calendar for the rest of this week yet.</p>
    <p class="mt-2 text-[0.9375rem]">
      Know something that should be here? <a href="/submit-event/" class="inline-block -my-2 py-2 text-primary underline">Send it in</a> and it goes up once it is checked.
    </p>
  </div>

  {pick && (
    <section class={block} aria-labelledby={`pick-${v}`} data-event-day={lastDay(pick.event)} data-end={toIsoLocal(listedUntil(pick.event))}>
      <Heading id={`pick-${v}`} title="Our pick" />
      <div class="mt-5 max-w-2xl">
        <p class="display-md text-[1.75rem] md:text-[2rem]">
          {pick.url ? <a href={pick.url} rel="noopener" class="inline-block -my-2 py-2 no-underline hover:text-primary">{pick.title}</a> : pick.title}
        </p>
        <p class="mt-2 font-medium"><time datetime={toIsoLocal(pick.event.data.start)}>{when(pick.event)}</time></p>
        {pick.body && <p class="mt-3 text-[1.0625rem] leading-relaxed text-ink-muted">{pick.body}</p>}
      </div>
    </section>
  )}

  {highlight && (
    <section class={block} aria-labelledby={`highlight-${v}`} data-event-day={lastDay(highlight)} data-end={toIsoLocal(listedUntil(highlight))}>
      <Heading id={`highlight-${v}`} title="Highlight" />
      <div class="mt-5 max-w-2xl">
        <p class="display-md text-[1.75rem] md:text-[2rem]">
          <a href={`/events/${highlight.slug}/`} class="inline-block -my-2 py-2 no-underline hover:text-primary">{highlight.data.title}</a>
        </p>
        <p class="mt-2 font-medium"><time datetime={toIsoLocal(highlight.data.start)}>{when(highlight)}</time></p>
        <p class="mt-3 text-[1.0625rem] leading-relaxed text-ink-muted">
          {highlight.data.venue}{highlight.data.subTown && <span>, {subTownLabel(highlight.data.subTown)}</span>}{highlight.data.cost && <span> · {highlight.data.cost}</span>}
        </p>
      </div>
    </section>
  )}

  {schoolWeeks.length > 0 && (
    <section class={block} aria-labelledby={`games-${v}`}>
      <Heading id={`games-${v}`} title="Games this week" />
      {schoolWeeks.map(({ school, week }) => (
        <div class="mt-2 rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
          {schoolWeeks.length > 1 && <p class="eyebrow pt-4"><a href={sportsPath(school)} class="underline underline-offset-2">{schoolTeamName(school)}</a></p>}
          <ul>
            {week.games.map(({ team, game }) => (
              <li class="border-t border-line-soft py-4 first:border-t-0">
                <p class="text-xl font-medium leading-tight">
                  <a href={game.url} rel="noopener" class="no-underline hover:text-primary">{team.name} {where(game)} {game.opponent}</a>
                  {team.overall && <span class="ml-2 text-[0.9375rem] font-normal text-ink-muted">{team.overall}</span>}
                </p>
                <p class="mt-1 text-[0.9375rem] leading-snug text-ink-muted">
                  <time datetime={game.time ? `${game.date}T${game.time}` : game.date}>{gameWhen(game, now)}{game.time && ` · ${formatGameTime(game)}`}</time>
                  {game.stage && ` · ${game.stage}`}
                  {game.venue ? ` · ${game.venue}` : game.site === 'home' ? ' · Home' : game.site === 'away' ? ' · Away' : ''}
                </p>
              </li>
            ))}
          </ul>
          {week.last?.game.result && (
            <p class="border-t border-line-soft py-4 text-[0.9375rem] text-ink-muted">Last out: {resultText(week.last)}.</p>
          )}
        </div>
      ))}
      <p class="mt-4 text-[0.9375rem]"><a href="/sports/" class="inline-block -my-2.5 py-2.5 font-semibold text-primary underline">Scores and schedules →</a></p>
    </section>
  )}

  {events.length > 0 && (
    <section class={block} data-hide-when-empty aria-labelledby={`weekend-${v}`}>
      <Heading id={`weekend-${v}`} title={listingsLabel} eyebrow={listingsRange} />
      <div class="mt-2 rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
        {events.map((event) => <WeekEventRow event={event} />)}
      </div>
      {compact && rows.length > events.length && (
        <p class="mt-4 text-[0.9375rem]">
          <a href="/this-week/" class="inline-block -my-2.5 py-2.5 font-semibold text-primary underline">
            All {allEvents.length} {onWeekend ? 'this weekend' : 'this week'} →
          </a>
        </p>
      )}
    </section>
  )}
  </div>

  {/* The editor's pick for a later date: kept, but under its own label and
     date, outside the week's heading it does not belong to. */}
  {comingUp && (
    <section class={block} aria-labelledby={`later-${v}`} data-event-day={lastDay(comingUp.event)} data-end={toIsoLocal(listedUntil(comingUp.event))}>
      <Heading id={`later-${v}`} title="Coming up" />
      <div class="mt-5 max-w-2xl">
        <p class="font-medium"><time datetime={toIsoLocal(comingUp.event.data.start)}>{when(comingUp.event)}</time></p>
        <p class="display-md mt-1 text-[1.5rem] md:text-[1.75rem]">
          {comingUp.url ? <a href={comingUp.url} rel="noopener" class="inline-block -my-2 py-2 no-underline hover:text-primary">{comingUp.title}</a> : comingUp.title}
        </p>
        {comingUp.body && <p class="mt-3 text-[1.0625rem] leading-relaxed text-ink-muted">{comingUp.body}</p>}
      </div>
    </section>
  )}

  {!compact && programs.length > 0 && (
    <section class={block} aria-labelledby={`deadlines-${v}`}>
      <Heading id={`deadlines-${v}`} title="Registration deadlines and ways to join" />
      <DeadlineList programs={programs} limit={5} class="mt-2 rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7" moreHref={hubHref} />
      {hubHref && (
        <p class="mt-4 text-[0.9375rem]">
          <a href={hubHref} class="inline-block -my-2.5 py-2.5 font-semibold text-primary underline">{town.families ? town.families.label : town.participation!.label} →</a>
          {town.families && town.participation && (
            <Fragment>{' · '}<a href="/get-involved/" class="inline-block -my-2.5 py-2.5 font-semibold text-primary underline">{town.participation.label} →</a></Fragment>
          )}
        </p>
      )}
    </section>
  )}

  {changes.length > 0 && (
    <section class={block} aria-labelledby={`changes-${v}`}>
      <Heading id={`changes-${v}`} title="New & closed" />
      <ul class="mt-2 rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
        {changes.map((c) => (
          <li class="border-t border-line-soft py-4 first:border-t-0">
            <p class="eyebrow">{c.label}{c.effective && <span class="ml-2 font-medium normal-case tracking-normal text-ink-muted">{formatDate(c.effective)}</span>}</p>
            <p class="mt-1 text-xl font-medium leading-tight">{c.name}</p>
            <p class="mt-1 text-[0.9375rem] leading-snug text-ink-muted">{c.detail}</p>
            {c.source && (
              <p class="mt-1 text-sm">
                <a href={c.source} rel="noopener" class="inline-block -my-3 py-3 text-primary underline [overflow-wrap:anywhere]">Source: {new URL(c.source).hostname.replace(/^www\./, '')}</a>
              </p>
            )}
          </li>
        ))}
      </ul>
      {compact && fresh.length > changes.length && (
        <p class="mt-4 text-[0.9375rem]">
          <a href="/this-week/" class="inline-block -my-2.5 py-2.5 font-semibold text-primary underline">
            All {fresh.length} new &amp; closed →
          </a>
        </p>
      )}
    </section>
  )}

  {/* An old change the guide only just caught: a correction to the guide,
     with the day it happened, the day it was noticed and the day its source
     was read, never the week's news. On the full page only; each leaves with
     its own expiry and stays in the archive of local changes. */}
  {!compact && (corrected.updates.length > 0 || corrected.changes.length > 0) && (
    <section class={block} aria-labelledby={`backlog-${v}`}>
      <Heading id={`backlog-${v}`} title="Corrections to the guide" />
      <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-muted">Changes that happened well before this guide noticed them. The first date is when it happened; nothing here is this week's news.</p>
      <ul class="mt-3 rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
        {corrected.updates.map((u) => (
          <li class="border-t border-line-soft py-4 first:border-t-0">
            <p class="eyebrow">{UPDATE_KIND_LABELS[u.data.kind]} <span class="ml-1 font-medium normal-case tracking-normal text-ink-muted">{formatDate(u.data.effective)} · noticed {formatDate(u.data.published)}{u.data.verified && ` · source read ${formatDate(u.data.verified)}`}</span></p>
            <p class="mt-1 text-xl font-medium leading-tight">{u.data.title}</p>
            <p class="mt-1 text-[0.9375rem] leading-snug text-ink-muted">{u.data.summary}</p>
            {u.data.action && <p class="mt-1 text-[0.9375rem] leading-snug"><span class="eyebrow text-ink-muted">Now</span> {u.data.action}</p>}
            <p class="mt-1 flex flex-wrap gap-x-4 text-sm">
              {u.data.source && <a href={u.data.source} rel="noopener" class="inline-block -my-3 py-3 text-primary underline [overflow-wrap:anywhere]">Source: {u.data.sourceLabel ?? new URL(u.data.source).hostname.replace(/^www\./, '')}</a>}
              {u.data.item && <a href={u.data.item} class="inline-block -my-3 py-3 text-primary underline [overflow-wrap:anywhere]">On this guide</a>}
            </p>
          </li>
        ))}
        {corrected.changes.map((c) => (
          <li class="border-t border-line-soft py-4 first:border-t-0">
            <p class="eyebrow">{c.label} <span class="ml-1 font-medium normal-case tracking-normal text-ink-muted">{formatDate(c.effective!)} · noticed {formatDate(c.checked)}</span></p>
            <p class="mt-1 text-xl font-medium leading-tight">{c.name}</p>
            <p class="mt-1 text-[0.9375rem] leading-snug text-ink-muted">{c.detail}</p>
            {c.source && (
              <p class="mt-1 text-sm">
                <a href={c.source} rel="noopener" class="inline-block -my-3 py-3 text-primary underline [overflow-wrap:anywhere]">Source: {new URL(c.source).hostname.replace(/^www\./, '')}</a>
              </p>
            )}
          </li>
        ))}
      </ul>
      {hasUpdates && (
        <p class="mt-4 text-[0.9375rem]"><a href="/updates/" class="inline-block -my-2.5 py-2.5 font-semibold text-primary underline">Every local change, current and archived →</a></p>
      )}
    </section>
  )}

  {!compact && qa && (
    <section class={block} aria-labelledby={`qa-${v}`}>
      <Heading id={`qa-${v}`} title="A resident asks" />
      <div class="mt-5 max-w-2xl">
        <p class="text-xl font-medium leading-tight md:text-2xl">{qa.question}</p>
        <p class="mt-3 text-[1.0625rem] leading-relaxed">{qa.answer}</p>
        {qa.source && (
          <p class="mt-2 text-sm text-ink-muted"><a href={qa.source} rel="noopener" class="inline-block -my-3 py-3 text-primary underline [overflow-wrap:anywhere]">Source: {qa.sourceLabel ?? new URL(qa.source).hostname.replace(/^www\./, '')}</a></p>
        )}
      </div>
    </section>
  )}

  {!compact && feature && (
    <section class={block} aria-labelledby={`feature-${v}`}>
      <Heading id={`feature-${v}`} title={`From around ${town.name}`} />
      <div class="mt-5 max-w-2xl">
        <p class="display-md text-[1.75rem] md:text-[2rem]">
          {feature.url ? <a href={feature.url} class="inline-block -my-2 py-2 no-underline hover:text-primary">{feature.title}</a> : feature.title}
        </p>
        <p class="mt-3 text-[1.0625rem] leading-relaxed text-ink-muted">{feature.body}</p>
        <p class="mt-2 text-sm text-ink-muted">{feature.basis}</p>
      </div>
    </section>
  )}

  {/* The neighbours' weekend and the hill, after everything of the town's
     own, on the full page only: the neighbours as "nearby", the mountain
     guides as the day trips they are. Each renders nothing with nothing on. */}
  {!compact && <NearbyWeekend town={town} class={block} limit={4} picks={nearby} />}
  {!compact && <UpTheHill town={town} class={block} label="Day trips up the hill" exclude={shownNearby} />}

  {signup && (
    <div class={block}>
      <NewsletterSignup town={town} compact id={compact ? 'this-week-compact' : 'this-week'} />
    </div>
  )}
</section>
