---
/**
 * Counts the clicks the resident hubs exist for, with the analytics the
 * sites already use and no new vendor: a link marked `data-track` sends one
 * custom event named for what it is (registration, participation, service)
 * through Vercel Web Analytics and, on a guide that has it, Plausible. Both
 * are no-ops where their script is not on the page. The newsletter form's
 * own submit is counted the same way from NewsletterSignup.astro, and so is
 * what became of it (`newsletter-result`, src/lib/signup.ts): Buttondown's
 * answer and the page, never the address. A form marked `data-track` (the
 * hub home's search) is counted when it is sent, by its page alone: what
 * was typed is never sent. The sending itself is src/lib/track.ts.
 */
---
<script>
  import { SIGNUP_RESULT_EVENT, signupResultProps, type SignupResult } from '@/lib/signup';
  import { sendEvent as send } from '@/lib/track';

  document.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-track]');
    if (!link || !link.dataset.track) return;
    send(link.dataset.track, { href: link.href, from: location.pathname });
  });
  document.addEventListener('submit', (event) => {
    const form = (event.target as HTMLElement).closest<HTMLFormElement>('form[data-track]');
    if (form?.dataset.track) send(form.dataset.track, { from: location.pathname });
  });
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-signup]')) {
    form.addEventListener('submit', () => send('newsletter-signup', { from: location.pathname }));
  }
  document.addEventListener(SIGNUP_RESULT_EVENT, (event) => {
    const detail = (event as CustomEvent<{ result?: SignupResult }>).detail;
    if (detail?.result) send(SIGNUP_RESULT_EVENT, signupResultProps(detail.result, location.pathname));
  });
</script>
