---
/**
 * "Near this town" (the additions of 12 November 2026): the nearest four
 * to six other towns with a page, by road, each linked to its page, and
 * the passes and named routes that connect them (src/lib/near.ts,
 * src/config/passes.ts). On every hub town page and on each guide's
 * /things-to-do/, from the one shared file, so two pages never print
 * different miles for the same pair.
 *
 * Nothing is drawn where the file has no pair for the place. A pass shows
 * its usual seasonal closure only where the agency that keeps the road
 * gives one, and its COtrip link only where one was read.
 */
import { findTown, getNetworkHub } from '@/config';
import { STANDALONE_GUIDES, findHubTown } from '@/config/hub-towns';
import { PASSES } from '@/config/passes';
import { getTraditions } from '@/lib/content';
import { formatShortDate, parseLocal } from '@/lib/dates';
import { publishedHubTowns } from '@/lib/hub-towns';
import { formatMiles, nearestPlaces, passesFor, type RoadMiles } from '@/lib/near';

interface Props {
  /** The place the block is for: a hub town's slug or a standalone guide's key. */
  place: string;
  name: string;
  /** On the hub a town page's link is a path; on a guide it is the hub's full address. */
  onHub?: boolean;
  class?: string;
}
const { place, name, onHub = false, class: className } = Astro.props;
const files = import.meta.glob<RoadMiles>('../../data/hub/road-miles.json', { eager: true, import: 'default' });
const roads = Object.values(files)[0];
const hub = getNetworkHub();
const published = publishedHubTowns(await getTraditions()).map((t) => t.slug);
const withPage = new Set([...published, ...Object.keys(STANDALONE_GUIDES)]);
const link = (slug: string): { name: string; href: string } | undefined => {
  const hubTown = findHubTown(slug);
  if (hubTown) return { name: hubTown.name, href: onHub ? `/${slug}/` : `https://${hub.domain}/${slug}/` };
  const guide = findTown(STANDALONE_GUIDES[slug]?.guide ?? '');
  return guide ? { name: guide.name, href: `https://${guide.domain}/` } : undefined;
};
const near = roads ? nearestPlaces(roads, place, withPage).flatMap((n) => { const l = link(n.place); return l ? [{ ...n, ...l }] : []; }) : [];
const passes = passesFor(PASSES, place, withPage).map(({ pass }) => ({
  pass,
  ends: pass.connects.map((s) => link(s)).filter((l): l is { name: string; href: string } => !!l),
}));
---
{near.length > 0 && roads && (
  <section aria-labelledby="near-heading" class:list={['mb-12 md:mb-16', className]} data-near-town>
    <h2 id="near-heading" class="mb-6 border-b-2 border-accent pb-3 text-3xl font-medium">Near {name}</h2>
    <div class="rounded-lg bg-raised px-5 py-1 ring-1 ring-line-soft sm:px-7">
      <ul class="divide-y divide-line-soft">
        {near.map((n) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5 py-3" data-near={n.place} data-miles={n.miles}>
            <a href={n.href} class="font-heading text-xl font-medium text-ink no-underline hover:text-primary hover:underline">{n.name}</a>
            <span class="text-[0.9375rem] text-ink-muted">{formatMiles(n.miles)} by road</span>
          </li>
        ))}
      </ul>
      {passes.length > 0 && (
        <div class="border-t border-line-soft py-4" data-passes>
          <h3 class="eyebrow mb-2">Passes and routes</h3>
          <ul class="space-y-3">
            {passes.map(({ pass, ends }) => (
              <li class="text-[0.9375rem] leading-snug text-ink-muted" data-pass={pass.slug}>
                <span class="font-semibold text-ink">{pass.name}</span>{pass.highway && <Fragment> · {pass.highway}</Fragment>}
                {ends.length === 2 && <Fragment> · between {ends.map((e, i) => (<Fragment>{i > 0 && ' and '}<a href={e.href} class="text-primary underline">{e.name}</a></Fragment>))}</Fragment>}
                {pass.seasonalClosure && <span class="block">Usual seasonal closure: {pass.seasonalClosure}</span>}
                {pass.statusUrl && <span class="block"><a href={pass.statusUrl} rel="noopener" class="text-primary underline">{pass.statusLabel ?? "COtrip"}</a> for today’s status · checked <time datetime={pass.checked}>{formatShortDate(parseLocal(pass.checked))}</time></span>}
              </li>
            ))}
          </ul>
        </div>
      )}
      <p class="border-t border-line-soft py-3.5 text-sm leading-relaxed text-ink-muted">
        Road miles between town centers, every pair from one router. A road shut for the season is not taken out of the miles.
        Checked <time datetime={roads.checked}>{formatShortDate(parseLocal(roads.checked))}</time> · Source:
        <a href={roads.source.url} rel="noopener" class="text-primary underline">{roads.source.name}</a>
      </p>
    </div>
  </section>
)}
