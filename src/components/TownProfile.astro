---
/**
 * What a hub town page says beside its dates (the additions of 12
 * November 2026), in the brief's order and below what the page already
 * had: the facts strip, Getting there, Where to stay, and the heritage
 * card. Hub town pages only; a standalone guide stays resident-first.
 *
 * Every value is from a file with its source and the day it was read
 * (src/lib/town-profile.ts for the profile; src/lib/near.ts for the bulk
 * facts and the miles), and each block prints both. A value nobody
 * confirmed is not in the file, and a block with nothing in it is not
 * drawn: there is no placeholder and no "not available".
 */
import FactStrip from '@/components/FactStrip.astro';
import { hubCountyLine, type HubTown } from '@/config/hub-towns';
import { formatShortDate, parseLocal } from '@/lib/dates';
import { formatDrive, formatMiles, type Airports, type RoadMiles, type TownFacts } from '@/lib/near';
import { newestCheck, sourceHost, type TownProfile } from '@/lib/town-profile';

interface Props {
  town: HubTown;
}
const { town } = Astro.props;
const one = <T,>(files: Record<string, T>) => Object.values(files)[0];
const facts = one(import.meta.glob<TownFacts>('../../data/hub/town-facts.json', { eager: true, import: 'default' }));
const roads = one(import.meta.glob<RoadMiles>('../../data/hub/road-miles.json', { eager: true, import: 'default' }));
const airports = one(import.meta.glob<Airports>('../../data/hub/airports.json', { eager: true, import: 'default' }));
const bustang = one(import.meta.glob<{ checked: string; stops: Array<{ town: string; service: string; detail?: string; seasonal?: string; url: string; source: string; checked: string }> }>('../../data/hub/bustang.json', { eager: true, import: 'default' }));
const profiles = import.meta.glob<TownProfile>('../../data/hub/towns/*.json', { eager: true, import: 'default' });
const profile = Object.entries(profiles).find(([file]) => file.endsWith(`/${town.slug}.json`))?.[1];

const bulk = facts?.towns[town.slug];
const elevation = profile?.facts?.elevationFt?.value ?? bulk?.elevationFt;
const incorporated = profile?.facts?.incorporated;
const strip = [
  elevation !== undefined && { label: 'Elevation', value: `${elevation.toLocaleString('en-US')} ft` },
  bulk?.population !== undefined && facts && { label: `Population, ${facts.sources.population.year}`, value: bulk.population.toLocaleString('en-US') },
  { label: town.counties.length > 1 ? 'Counties' : 'County', value: hubCountyLine(town).replace(/ (County|counties)$/, '') },
  incorporated && { label: 'Incorporated', value: String(incorporated.year) },
].filter((f): f is { label: string; value: string } => !!f);
const stripSources = [
  elevation !== undefined && (profile?.facts?.elevationFt ? { name: sourceHost(profile.facts.elevationFt.source), url: profile.facts.elevationFt.source } : facts && { name: `${facts.sources.elevation.name}, at the town’s point in the Geographic Names Information System`, url: facts.sources.elevation.url }),
  bulk?.population !== undefined && facts && { name: `${facts.sources.population.name} (1 July ${facts.sources.population.year})`, url: facts.sources.population.url },
  incorporated && { name: sourceHost(incorporated.source), url: incorporated.source },
].filter((s): s is { name: string; url: string } => !!s);

const fromDenver = roads?.fromDenver[town.slug];
const nearestAirport = roads?.airport[town.slug];
const airport = nearestAirport ? airports?.airports.find((a) => a.code === nearestAirport.code) : undefined;
const transit = [
  ...(bustang?.stops.filter((s) => s.town === town.slug).map((s) => ({ name: s.service, detail: [s.detail, s.seasonal].filter(Boolean).join('. '), url: s.url, checked: s.checked })) ?? []),
  ...(profile?.transit ?? []).map((t) => ({ name: t.name, detail: t.detail, url: t.url, checked: t.checked })),
];
const hasGetting = !!fromDenver || transit.length > 0 || !!airport;

const lodging = profile?.lodging ?? [];
const h = profile?.heritage;
const sites = h?.sites ?? [];
const timeline = [...(h?.timeline ?? [])].sort((a, b) => a.year - b.year);
const ghostTowns = h?.ghostTowns ?? [];
const makers = h?.makers ?? [];
const hasHeritage = !!h && (!!h.nameOrigin || !!h.founded || timeline.length > 0 || sites.length > 0 || ghostTowns.length > 0 || makers.length > 0);
const heritageSources = h ? [...new Map([h.nameOrigin, h.founded, ...timeline, ...sites, ...ghostTowns, ...makers].filter((i) => !!i).map((i) => [sourceHost(i!.source), i!.source])).entries()] : [];
const heritageChecked = h ? newestCheck([h.nameOrigin, h.founded, ...timeline, ...sites, ...ghostTowns, ...makers]) : undefined;
const lodgingChecked = newestCheck(lodging);
const short = (d: string) => formatShortDate(parseLocal(d));
const h2 = 'mb-6 border-b-2 border-accent pb-3 text-3xl font-medium';
const card = 'rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7';
const foot = 'border-t border-line-soft py-3.5 text-sm leading-relaxed text-ink-muted';
---
{strip.length > 1 && (
  <section aria-labelledby="facts-heading" class="mb-12 md:mb-16" data-town-facts>
    <h2 id="facts-heading" class={h2}>{town.name} at a glance</h2>
    <FactStrip facts={strip} />
    {stripSources.length > 0 && facts && (
      <p class="mt-3 text-sm leading-relaxed text-ink-muted">
        Checked <time datetime={facts.checked}>{short(facts.checked)}</time> · Sources:
        {stripSources.map((s, i) => (<Fragment>{i > 0 && '; '}<a href={s.url} rel="noopener" class="text-primary underline">{s.name}</a></Fragment>))}
      </p>
    )}
  </section>
)}

{hasGetting && (
  <section aria-labelledby="getting-heading" class="mb-12 md:mb-16" data-getting-there>
    <h2 id="getting-heading" class={h2}>Getting to {town.name}</h2>
    <div class={card}>
      <dl class="divide-y divide-line-soft">
        {fromDenver && roads && (
          <div class="py-3.5">
            <dt class="eyebrow">From Denver</dt>
            <dd class="mt-1 text-[1.0625rem] leading-snug text-ink">{formatMiles(fromDenver.miles)} by road, {formatDrive(fromDenver.minutes)} without traffic or stops</dd>
          </div>
        )}
        {transit.length > 0 && (
          <div class="py-3.5">
            <dt class="eyebrow">Bus and transit</dt>
            <dd class="mt-1 space-y-1.5">
              {transit.map((t) => (
                <p class="text-[0.9375rem] leading-snug text-ink-muted"><a href={t.url} rel="noopener" class="font-semibold text-primary underline">{t.name}</a>{t.detail && <Fragment>: {t.detail}</Fragment>}</p>
              ))}
            </dd>
          </div>
        )}
        {airport && nearestAirport && (
          <div class="py-3.5">
            <dt class="eyebrow">Nearest commercial airport</dt>
            <dd class="mt-1 text-[1.0625rem] leading-snug text-ink">
              {airport.url ? <a href={airport.url} rel="noopener" class="text-primary underline">{airport.name}</a> : airport.name} ({airport.code}), {airport.city}: {formatMiles(nearestAirport.miles)} by road
            </dd>
          </div>
        )}
      </dl>
      {roads && (
        <p class={foot}>
          Checked <time datetime={roads.checked}>{short(roads.checked)}</time> · Sources:
          <a href={roads.source.url} rel="noopener" class="text-primary underline">{roads.source.name}</a> for the miles and the time{transit.length > 0 && <Fragment>; the operator’s own page for each service</Fragment>}{airport && airports && <Fragment>; <a href={airports.listSource} rel="noopener" class="text-primary underline">Federal Aviation Administration, commercial service airports</a></Fragment>}
        </p>
      )}
    </div>
  </section>
)}

{lodging.length > 0 && (
  <section aria-labelledby="stay-heading" class="mb-12 md:mb-16" data-where-to-stay>
    <h2 id="stay-heading" class={h2}>Where to stay in {town.name}</h2>
    <div class={card}>
      <ul class="divide-y divide-line-soft">
        {lodging.map((l) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5 py-3.5">
            <a href={l.url} rel="noopener" class="font-heading text-xl font-medium text-ink no-underline hover:text-primary hover:underline">{l.name}</a>
            <span class="text-[0.9375rem] text-ink-muted">{[l.kind, l.season].filter(Boolean).join(' · ')}</span>
          </li>
        ))}
      </ul>
      <p class={foot}>Each links to the property’s own site; none is a paid or affiliate link.{lodgingChecked && <Fragment> Checked <time datetime={lodgingChecked}>{short(lodgingChecked)}</time> against each property’s site.</Fragment>}</p>
    </div>
  </section>
)}

{hasHeritage && h && (
  <section aria-labelledby="heritage-heading" class="mb-12 md:mb-16" data-heritage>
    <h2 id="heritage-heading" class={h2}>{town.name}’s history</h2>
    <div class:list={[card, 'py-1']}>
      {(h.nameOrigin || h.founded) && (
        <dl class="divide-y divide-line-soft">
          {h.nameOrigin && (
            <div class="py-3.5"><dt class="eyebrow">The name</dt><dd class="mt-1 text-[1.0625rem] leading-snug text-ink">{h.nameOrigin.text}</dd></div>
          )}
          {h.founded && (
            <div class="py-3.5"><dt class="eyebrow">Founded</dt><dd class="mt-1 text-[1.0625rem] leading-snug text-ink">{h.founded.year}{h.founded.text && <Fragment>: {h.founded.text}</Fragment>}</dd></div>
          )}
        </dl>
      )}
      {timeline.length > 0 && (
        <div class="border-t border-line-soft py-4 first:border-t-0">
          <h3 class="eyebrow mb-2">Dates</h3>
          <ol class="space-y-2">
            {timeline.map((t) => (
              <li class="grid grid-cols-[3.25rem_minmax(0,1fr)] gap-x-3 text-[0.9375rem] leading-snug"><span class="font-semibold text-ink">{t.year}</span><span class="text-ink-muted">{t.text}</span></li>
            ))}
          </ol>
        </div>
      )}
      {sites.length > 0 && (
        <div class="border-t border-line-soft py-4 first:border-t-0">
          <h3 class="eyebrow mb-2">Museums and landmarks</h3>
          <ul class="space-y-3">
            {sites.map((s) => (
              <li class="text-[0.9375rem] leading-snug">
                {s.url ? <a href={s.url} rel="noopener" class="font-semibold text-primary underline">{s.name}</a> : <span class="font-semibold text-ink">{s.name}</span>}
                {[s.hours && `Hours: ${s.hours}`, s.cost && `Cost: ${s.cost}`, s.season && `Season: ${s.season}`].filter(Boolean).map((line) => <span class="block text-ink-muted">{line}</span>)}
              </li>
            ))}
          </ul>
        </div>
      )}
      {ghostTowns.length > 0 && (
        <div class="border-t border-line-soft py-4 first:border-t-0">
          <h3 class="eyebrow mb-2">Ghost towns nearby</h3>
          <ul class="space-y-2">
            {ghostTowns.map((g) => (
              <li class="text-[0.9375rem] leading-snug text-ink-muted">{g.url ? <a href={g.url} rel="noopener" class="font-semibold text-primary underline">{g.name}</a> : <span class="font-semibold text-ink">{g.name}</span>}{g.text && <Fragment>: {g.text}</Fragment>}</li>
            ))}
          </ul>
        </div>
      )}
      {makers.length > 0 && (
        <div class="border-t border-line-soft py-4 first:border-t-0">
          <h3 class="eyebrow mb-2">Made in {town.name}</h3>
          <ul class="space-y-2">
            {makers.map((m) => (
              <li class="text-[0.9375rem] leading-snug text-ink-muted"><a href={m.url} rel="noopener" class="font-semibold text-primary underline">{m.name}</a>: {m.what}</li>
            ))}
          </ul>
        </div>
      )}
      <p class={foot}>
        {heritageChecked && <Fragment>Checked <time datetime={heritageChecked}>{short(heritageChecked)}</time> · </Fragment>}Sources:
        {heritageSources.map(([host, url], i) => (<Fragment>{i > 0 && ', '}<a href={url} rel="noopener" class="text-primary underline">{host}</a></Fragment>))}
      </p>
    </div>
  </section>
)}
