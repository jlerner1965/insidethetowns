---
/**
 * The flagship masthead: the town's name and its purpose beside a
 * photograph, about a third of the old hero's height, so the week's first
 * rows are in view on a laptop before any scroll and one short scroll away
 * on a phone. The split, not a wash over a photo: the photograph stays a
 * photograph, with its credit, and the type sits on paper.
 *
 * The purpose line is the enduring one from `home.purpose`. A dated civic
 * topic (the vote, the bond) is the `notice` the page passes in, under the
 * buttons with its date, and it leaves with its date rather than living in
 * the tagline (flagship brief, 21 October 2026).
 */
import { Image } from 'astro:assets';
import { countyLabel, type TownConfig } from '@/config';
import { resolveSiteImage } from '@/lib/images';

interface Props {
  town: TownConfig;
  /** A dated line under the buttons: the current civic notice, if one is current. */
  notice?: { text: string; href: string; date: string };
}

const { town, notice } = Astro.props;
const home = town.home!;
const photo = resolveSiteImage(town.slug, home.photo.image);
---
<section class="border-b border-line-soft bg-raised" aria-labelledby="town-name">
  <div class="container-page grid items-center gap-6 py-7 md:grid-cols-[minmax(0,11fr)_minmax(0,9fr)] md:gap-12 md:py-9 lg:py-10">
    <div class="min-w-0">
      <p class="eyebrow">{countyLabel(town)}, Colorado</p>
      <h1 id="town-name" class="display mt-2 text-[3.25rem] sm:text-[4rem] lg:text-[5rem]">{town.name}</h1>
      <p class="mt-3 max-w-xl text-[1.125rem] leading-snug text-ink-muted md:text-[1.25rem]">{home.purpose}</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/this-week/" class="btn btn-primary">This week</a>
        <a href={home.secondary.href} class="btn btn-outline text-primary">{home.secondary.label}</a>
      </div>
      {notice && (
        <p class="mt-5 max-w-xl text-[0.9375rem] leading-snug text-ink-muted">
          <span class="font-semibold text-ink">{notice.date}:</span> <a href={notice.href} class="text-primary underline">{notice.text}</a>
        </p>
      )}
    </div>
    <figure class="min-w-0">
      {/* A fixed frame at every width, so the photograph is cropped to a
          deliberate focal point and never stretched: 2:1 on a phone, where
          it sits under the words, 5:4 beside them. */}
      <div class="aspect-[2/1] overflow-hidden rounded-lg bg-accent-soft md:aspect-[5/4] md:max-h-[22rem]">
        <Image src={photo} alt={home.photo.alt} widths={[480, 720, 960, 1200]} sizes="(min-width: 768px) 45vw, 100vw" priority class="h-full! w-full object-cover" />
      </div>
      {home.photo.credit && <figcaption class="mt-1.5 text-[0.75rem] text-ink-muted">Photo: {home.photo.credit}</figcaption>}
    </figure>
  </div>
</section>
