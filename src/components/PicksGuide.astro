---
/**
 * A picks guide above a directory (/eat-drink/, /things-to-do/): the
 * guide's heading, the day its facts were checked, then the picks in
 * order, each linking to the place's own page with who or when it suits and
 * why it is there (content/<town>/pages/eat-drink.md and things-to-do.md;
 * pickSchema). The page's body, which says how the picks were chosen and
 * what is left out, comes after the picks: above them it was 150 to 200
 * words a reader on a phone had to scroll past before the first pick
 * (James, 11 November 2026).
 *
 * The search audit of 7 November 2026 found both pages were filterable
 * directories with no picks, no date and no criteria, ranking on page three
 * for "things to do in <town>" and "restaurants in <town>"; Johnstown's
 * eat-drink page ranked tenth with nothing on it but the list. The directory
 * stays under this, whole.
 *
 * A pick whose place is not on the page's list (closed, delisted, moved to
 * staging since) is left out rather than shown as a dead link; the validator
 * fails the build on one first (validate-content.ts).
 */
import { render } from 'astro:content';
import type { TownEntry } from '@/lib/content';
import { PLACE_TYPE_LABELS } from '@/content/schemas';
import { formatDate, toIsoLocal } from '@/lib/dates';
import { checkedBy } from '@/lib/editor';
import { picksFor } from '@/lib/picks';

interface Props {
  page: TownEntry<'pages'>;
  /** The published places the page lists, to resolve each pick against. */
  places: TownEntry<'places'>[];
  /** The id of the directory under the guide, for the jump link. */
  directoryId?: string;
  /**
   * Which picks (the audit of 13 November 2026: ten picks of forty words
   * each stood between the reader and the filters). `lead`: the first
   * LEAD_PICKS, above the directory, with links to the list and to the
   * rest; `rest`: the others, after the directory, under the guide's own
   * title, numbered on, with how they were chosen. `all`, as before.
   */
  part?: 'all' | 'lead' | 'rest';
}

const LEAD_PICKS = 3;
const { page, places, directoryId = 'directory', part = 'all' } = Astro.props;
const { data } = page;
const { Content } = await render(page);
const every = picksFor(data.picks ?? [], places);
const split = part !== 'all' && every.length > LEAD_PICKS;
const shown = part === 'rest' ? (split ? every.slice(LEAD_PICKS) : []) : part === 'lead' && split ? every.slice(0, LEAD_PICKS) : every;
const first = part === 'rest' ? LEAD_PICKS + 1 : 1;
const restCount = every.length - LEAD_PICKS;
// The fine print on how they were chosen goes with the last picks shown.
const finePrint = part !== 'lead' || !split;
const headingId = part === 'rest' ? 'more-picks-h' : 'picks-h';
const heading = part === 'lead' && split ? `${LEAD_PICKS} picks to start with` : part === 'rest' ? `${shown.length} more ${shown.length === 1 ? 'pick' : 'picks'}` : data.title;
---
{shown.length > 0 && (
  <section aria-labelledby={headingId} id={part === 'rest' ? 'more-picks' : 'picks'} class:list={['max-w-3xl scroll-mt-6', part === 'rest' ? 'mt-16' : 'mb-8 md:mb-14']}>
    <h2 id={headingId} class="display-md text-[1.75rem] leading-tight md:text-[2.25rem]">{heading}</h2>
    {data.verified && (
      <p class="mt-2 text-[0.875rem] text-ink-muted">
        <time datetime={toIsoLocal(data.verified).slice(0, 10)}>{checkedBy(formatDate(data.verified))}</time>{' '}
        <a href="/editorial/" class="underline">How we check</a>
      </p>
    )}
    <ol start={first} class="mt-5 divide-y divide-line-soft rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
      {shown.map(({ pick, place }, i) => (
        <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 py-5 sm:grid-cols-[2.5rem_minmax(0,1fr)]">
          <span class="display-md text-[1.75rem] leading-none text-primary" aria-hidden="true">{first + i}</span>
          <div class="min-w-0">
            <h3 class="text-lg font-semibold leading-snug"><a href={`/places/${place.slug}/`} class="text-primary underline">{place.data.title}</a></h3>
            <p class="mt-0.5 text-[0.875rem] text-ink-muted">{[PLACE_TYPE_LABELS[place.data.type], place.data.area, pick.for].filter(Boolean).join(' · ')}</p>
            <p class="mt-1.5 text-[0.9375rem] leading-relaxed">{pick.why}</p>
          </div>
        </li>
      ))}
    </ol>
    {/* Fine print, not a lead: `.prose` sets a first paragraph large, which
        with a rule and its padding left most of a phone screen empty between
        the picks and the directory (James, 12 November 2026). */}
    {finePrint && <div class="mt-3 text-[0.875rem] leading-relaxed text-ink-muted [&_a]:text-primary [&_a]:underline [&_p+p]:mt-2"><Content /></div>}
    {part !== 'rest' && (
      <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-[0.9375rem]">
        <a href={`#${directoryId}`} class="-my-2.5 inline-block py-2.5 font-semibold text-primary underline">Every place we list, with filters ↓</a>
        {split && <a href="#more-picks" class="-my-2.5 inline-block py-2.5 font-semibold text-primary underline">{restCount} more {restCount === 1 ? 'pick' : 'picks'}, after the list ↓</a>}
      </p>
    )}
  </section>
)}
