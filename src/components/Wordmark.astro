---
/**
 * "Inside Niwot" set as a two-weight wordmark: a light italic "Inside" and a
 * medium town name. Any site title without that shape renders plainly.
 */
import { getSite } from '@/config';

interface Props {
  class?: string;
}

const site = getSite();
const { class: className = '' } = Astro.props;
const match = /^(Inside)\s+(.+)$/.exec(site.siteTitle);
---
<a href="/" class:list={['font-heading tracking-tight no-underline', className]} aria-label={`${site.siteTitle} home`}>
  {match ? (
    <Fragment>
      <span class="font-light italic">{match[1]}</span>{' '}
      <span class="font-semibold">{match[2]}</span>
    </Fragment>
  ) : (
    <span class="font-semibold">{site.siteTitle}</span>
  )}
</a>
