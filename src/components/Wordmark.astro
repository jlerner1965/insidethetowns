---
/**
 * "Inside Niwot" set as a two-weight wordmark: a light italic "Inside" and a
 * medium town name in the town's own color. Longmont's "Longmont · Inside the
 * Towns" is the same two weights the other way round (wordmarkParts), the
 * network's name on a smaller second line. Any site title without either
 * shape renders plainly.
 *
 * `tone` is "ink" on light grounds and "light" inside the footer, where the
 * town's primary would vanish into the primary band. The light "Inside" is
 * white at 70%, which is display-size text and needs 3:1, not 4.5:1;
 * scripts/check-colors.ts holds it to that on every band.
 */
import { getSite, type SiteConfig } from '@/config';
import { WORDMARK_AFTER_SCALE, homeLinkLabel, wordmarkParts } from '@/lib/titles';

interface Props {
  class?: string;
  tone?: 'ink' | 'light';
  /** Another site's wordmark: a full section's, in its masthead over a hub page under /<town>/ (Header.astro). */
  site?: SiteConfig;
  /** Where it goes: that section's home ("/erie/"). This site's home, "/", by default. */
  href?: string;
}

const { class: className = '', tone = 'ink', site = getSite(), href = '/' } = Astro.props;
// The hub's masthead sets the whole name in its blue, "Inside" in the
// regular italic (the publication redesign of 14 November 2026); a guide's
// keeps the light italic in the ink.
const hubInk = site.kind === 'hub' && tone === 'ink';
const first = tone === 'light' ? 'text-white/70' : hubInk ? 'text-primary' : 'text-ink';
const second = tone === 'light' ? 'text-white' : 'text-primary';
// The smaller second line is body-size, so it needs 4.5:1, not the display
// 3:1: full white in the footer (white/70 on Longmont's primary is 4.09:1).
const after = tone === 'light' ? 'text-white' : 'text-ink';
const parts = wordmarkParts(site.siteTitle);
---
{/* Its name is the title and the word "home": "Inside the Towns home" on the hub (the owner's navigation brief of 18 November 2026), "Inside Erie home" on a section; the visible words begin it, as WCAG 2.5.3 asks. */}
<a href={href} class:list={['-my-2 py-2 font-heading tracking-tight no-underline', className]} aria-label={homeLinkLabel(site.siteTitle)}>
  {parts.before && (
    <Fragment>
      <span class:list={[hubInk ? 'font-normal italic' : 'font-light italic', first]}>{parts.before}</span>{' '}
    </Fragment>
  )}
  <span class:list={['font-semibold', second]}>{parts.name}</span>
  {/* On a second line, smaller: on one line Longmont's title pushed the
      desktop nav off the side of the page. Without the dot that joins the
      two on one line: it opened the second line on its own. */}
  {parts.after && (
    <span class:list={['mt-[0.3em] block font-light italic', after]} style={`font-size:${WORDMARK_AFTER_SCALE}em`}>{parts.after.replace(/^·\s*/, '')}</span>
  )}
</a>
