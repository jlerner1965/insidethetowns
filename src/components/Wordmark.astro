---
/**
 * "Inside Niwot" set as a two-weight wordmark: a light italic "Inside" and a
 * medium town name in the town's own color. Longmont's "Longmont · Inside the
 * Towns" is the same two weights the other way round (wordmarkParts), the
 * network's name on a smaller second line. Any site title without either
 * shape renders plainly.
 *
 * `tone` is "ink" on light grounds and "light" inside the footer, where the
 * accent would be unreadable on the accent-dark fill.
 */
import { getSite } from '@/config';
import { WORDMARK_AFTER_SCALE, wordmarkParts } from '@/lib/titles';

interface Props {
  class?: string;
  tone?: 'ink' | 'light';
}

const site = getSite();
const { class: className = '', tone = 'ink' } = Astro.props;
const first = tone === 'light' ? 'text-white/70' : 'text-ink';
const second = tone === 'light' ? 'text-white' : 'text-accent-text';
const parts = wordmarkParts(site.siteTitle);
---
<a href="/" class:list={['font-heading tracking-tight no-underline', className]} aria-label={`${site.siteTitle} home`}>
  {parts.before && (
    <Fragment>
      <span class:list={['font-light italic', first]}>{parts.before}</span>{' '}
    </Fragment>
  )}
  <span class:list={['font-semibold', second]}>{parts.name}</span>
  {/* On a second line, smaller: on one line Longmont's title pushed the
      desktop nav off the side of the page. */}
  {parts.after && (
    <span class:list={['mt-[0.3em] block font-light italic', first]} style={`font-size:${WORDMARK_AFTER_SCALE}em`}>{parts.after}</span>
  )}
</a>
