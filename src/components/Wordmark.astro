---
/**
 * "Inside Niwot" set as a two-weight wordmark: a light italic "Inside" and a
 * medium town name in the town's own color. Any site title without that shape
 * renders plainly.
 *
 * `tone` is "ink" on light grounds and "light" inside the footer, where the
 * town's primary would vanish into the primary band. The light "Inside" is
 * white at 70%, which is display-size text and needs 3:1, not 4.5:1;
 * scripts/check-colors.ts holds it to that on every band.
 */
import { getSite } from '@/config';

interface Props {
  class?: string;
  tone?: 'ink' | 'light';
}

const site = getSite();
const { class: className = '', tone = 'ink' } = Astro.props;
const first = tone === 'light' ? 'text-white/70' : 'text-ink';
const second = tone === 'light' ? 'text-white' : 'text-primary';
const match = /^(Inside)\s+(.+)$/.exec(site.siteTitle);
---
<a href="/" class:list={['font-heading tracking-tight no-underline', className]} aria-label={`${site.siteTitle} home`}>
  {match ? (
    <Fragment>
      <span class:list={['font-light italic', first]}>{match[1]}</span>{' '}
      <span class:list={['font-semibold', second]}>{match[2]}</span>
    </Fragment>
  ) : (
    <span class:list={['font-semibold', second]}>{site.siteTitle}</span>
  )}
</a>
