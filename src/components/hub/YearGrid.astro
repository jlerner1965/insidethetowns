---
/**
 * The year at a glance on a hub town page: twelve months, each tradition a
 * mark in the month of its date (src/lib/hub-town-page.ts, yearGrid). A dot
 * is a date set; a ring is the month it was last held, its next date not
 * announced; the legend says which in words (visual rule 5). The current
 * month is washed and says "now". A month with marks links to the list its
 * entries are under and says what it holds (src/lib/year-grid.ts).
 *
 * The build's month and dates are put right in the reader's browser
 * (src/lib/tradition-expiry.ts): a passed date's dot turns to a ring, and
 * "now" moves with the calendar. The marks' looks follow their data
 * attributes, so the script changes data, not classes.
 */
import type { yearGrid } from '@/lib/hub-town-page';

interface Props {
  cells: ReturnType<typeof yearGrid>;
}
const { cells } = Astro.props;
const anySet = cells.some((c) => c.marks.some((m) => m.set));
// A date set can pass in the reader's browser and become a ring, so the ring is explained wherever there is a mark.
const anyMark = cells.some((c) => c.marks.length > 0);
const dot = 'inline-block size-[9px] rounded-full';
const mark = `${dot} bg-primary data-[mark=held]:border-[1.5px] data-[mark=held]:border-primary data-[mark=held]:bg-transparent`;
const cell = 'flex min-h-[60px] flex-col items-center gap-1.5 pb-2 pt-[9px] text-meta font-semibold leading-none';
---
<div data-year-grid>
  <p class="mt-2.5 flex flex-wrap gap-x-[18px] gap-y-1.5 text-meta leading-[1.5] text-ink-muted">
    {anySet && <span><span class:list={[dot, 'mr-1.5 bg-primary']} aria-hidden="true"></span>Date set</span>}
    {anyMark && <span><span class:list={[dot, 'mr-1.5 border-[1.5px] border-primary']} aria-hidden="true"></span>Last held; next date not yet announced</span>}
  </p>
  <ol class="mt-2.5 grid grid-cols-6 border-l border-t border-l-hairline border-t-ink bg-raised md:grid-cols-12">
    {cells.map((c) => (
      <li class="group border-b border-r border-hairline data-[now=true]:bg-highlight-soft" data-month-cell={c.month} data-now={String(c.now)}>
        {c.marks.length > 0 ? (
          <a href={`#${c.target}`} aria-label={c.label} class:list={[cell, 'text-primary no-underline']}>
            {/* The month is the underlined word; "now" under it is not part of the link's look. */}
            <span class="underline decoration-1 underline-offset-[3px]">{c.short}</span>
            <span class="flex flex-wrap justify-center gap-[3px] px-1" aria-hidden="true">
              {c.marks.map((m) => (
                <span class={mark} data-mark={m.set ? 'set' : 'held'} data-slug={m.slug} data-year={m.year} data-held-year={m.heldYear} data-next-year={m.nextYear}></span>
              ))}
            </span>
            <span class="text-cap font-normal text-ink-muted" data-now-label hidden={!c.now}>{c.now ? 'now' : ''}</span>
          </a>
        ) : (
          <span class:list={[cell, 'text-ink-muted group-data-[now=true]:text-ink']}>
            {c.short}
            <span class="text-cap font-normal text-ink-muted" data-now-label hidden={!c.now}>{c.now ? 'now' : ''}</span>
          </span>
        )}
      </li>
    ))}
  </ol>
</div>
