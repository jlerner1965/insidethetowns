---
/**
 * One date on a hub town page, compact since 18 November 2026 (the owner:
 * "date, name, status, and time and place on as few lines as possible,
 * with source and checked date on one short line"; Leadville ran to 17,000
 * pixels on a phone). The date set in type in a narrow column; the name
 * with its kind; one status line that also carries the time, the place and
 * the cost; the organizer's note, the local line and the sub-events only
 * where there are any; and the check line with the source and the other
 * pages. The same words and facts as before, on fewer lines.
 *
 * The statuses, each a word as well as a look (visual rule 5):
 * - confirmed: a blue square, "Confirmed" and the date; "Tentative" where
 *   the source calls the date tentative (dateLabel, src/lib/traditions.ts).
 * - moved: a blue square, "Moved" and the new date; the old one and the
 *   organizer's reason under it, quoted and attributed.
 * - canceled: a grey square, "Canceled" and the date it had; the name
 *   struck through.
 * A date not yet announced is a one-line item on the page itself, not this.
 *
 * "Today" is the build's. A date set carries the day it ends (`data-ends`)
 * and, hidden and with its words in `data-past-text` only, what it reads
 * once that day has passed; the page's script swaps the two by the
 * reader's Denver date (src/lib/tradition-expiry.ts).
 */
import { pub } from './pub';
import { dateBlock } from '@/lib/date-block';
import { formatDayLong, formatDayShort, formatShortDate, parseLocal, publishedTime } from '@/lib/dates';
import { typeset } from '@/lib/text';
import { TRADITION_TYPE_INFO, dateLabel, sourceLink, type TraditionRow } from '@/lib/traditions';

interface Props {
  row: TraditionRow;
  /** The record's own page, where it has one: the name links to it. */
  href?: string;
  /** What the date means in this place (src/lib/hub-towns.ts, lineFor). */
  line?: string;
  /** The record's other showings, as links. */
  also?: ReadonlyArray<{ label: string; href: string }>;
  /** An agency's date (a road, a park, a free day), for the script's tie-break with an event on the same day. */
  agency?: boolean;
}

const { row, href, line, also = [], agency = false } = Astro.props;
const { record, entry, source } = row;
const name = typeset(record.name);
const organizer = typeset(record.organizer);
const quoted = (words: string | undefined) => typeset(words, { inner: true });
const type = TRADITION_TYPE_INFO[record.type];
const day = (d: string) => parseLocal(d);
/** "Sat, Dec 5, 2026": always with the year, since a page lists this winter's dates beside next summer's. */
const dayText = (d: string) => `${formatDayShort(day(d))}, ${d.slice(0, 4)}`;
/** "Fri, Jun 18 to Sun, Jun 21, 2027", the year once where both share it. */
const spanText = (from: string, to?: string) => {
  if (!to || to === from) return dayText(from);
  return from.slice(0, 4) === to.slice(0, 4) ? `${formatDayShort(day(from))} to ${dayText(to)}` : `${dayText(from)} to ${dayText(to)}`;
};
const canceled = entry.status === 'canceled';
const past = !!row.past;
const dated = !past && (entry.status === 'confirmed' || entry.status === 'moved');
const ordinal = (n: number) => `${n}${n % 100 >= 11 && n % 100 <= 13 ? 'th' : (['th', 'st', 'nd', 'rd'][n % 10] ?? 'th')}`;
const subEvents = dated && !canceled ? (entry.subEvents ?? []) : [];
const closedDays = dated && !canceled ? (entry.closedDays ?? []) : [];
/** The time, the place and the cost on the status line, in the site's style (src/lib/dates.ts, publishedTime). */
const details = dated ? [publishedTime(entry.startTime), typeset(entry.place), typeset(entry.cost)].filter(Boolean) : [];
// Where to sign up, after the details, when the source links a registration page of its own.
const registration = dated && !canceled ? entry.registration : undefined;
const lastWord = record.type === 'outdoor' || record.type === 'free-day' ? 'Most recent' : 'Last held';
const block = dateBlock(row);
const expires = dated && !canceled ? (entry.endDate ?? entry.date) : undefined;
const pastBlock = expires ? dateBlock({ ...row, past: true }) : undefined;
const square = 'mr-1.5 inline-block size-2 align-[1px]';
const blockMonth = `${pub.cap} text-primary`;
const blockDay = 'mt-0.5 whitespace-nowrap font-heading text-[1.6471rem] leading-none tracking-[-0.02em] text-primary [font-variation-settings:normal]';
const blockOpen = 'whitespace-nowrap font-heading text-base leading-[1.3] text-ink-muted [font-variation-settings:normal]';
const blockFoot = 'mt-0.5 text-meta leading-tight text-ink-muted';
const status = 'mt-1 text-meta leading-[1.5] text-ink';
const note = `mt-1 ${pub.meta}`;
---
<article
  id={record.slug}
  class:list={['grid scroll-mt-12 grid-cols-[56px_minmax(0,1fr)] gap-x-3 py-3 desk:scroll-mt-4 desk:grid-cols-[72px_minmax(0,1fr)]', pub.rule]}
  data-tradition-row
  data-town={record.town?.name ?? (record.statewide ? 'Statewide' : '')}
  data-status={past ? 'not-announced' : entry.status}
  data-agency={agency ? '' : undefined}
  data-fixture={record.fixture ? '' : undefined}
  data-starts={expires ? entry.date : undefined}
  data-ends={expires}
  data-name={expires ? record.name : undefined}
  data-day-text={expires ? `${formatDayLong(day(entry.date!))}, ${entry.date!.slice(0, 4)}` : undefined}
>
  {/* The date in type. It repeats the status line, so a screen reader hears the line and not this. */}
  <div aria-hidden="true" data-date-block={block.set ? 'set' : 'open'} data-when-set={expires ? '' : undefined}>
    {block.set ? (
      <Fragment>
        <p class:list={[blockMonth, canceled && 'line-through']}>{block.top.toUpperCase()}</p>
        <p class:list={[blockDay, canceled && 'text-ink-muted line-through']}>{block.main}</p>
        {block.foot && <p class={blockFoot}>{block.foot}</p>}
      </Fragment>
    ) : (
      <Fragment>
        <p class={blockOpen}>{block.main}</p>
        {block.foot && <p class={blockFoot}>{block.foot}</p>}
      </Fragment>
    )}
  </div>
  {pastBlock && (
    <div aria-hidden="true" data-date-block="open" data-when-past hidden>
      <p class={blockOpen} data-past-text={pastBlock.main}></p>
    </div>
  )}

  <div class="min-w-0">
    <h4 class="text-base font-medium leading-[1.3] text-ink [font-variation-settings:normal]">
      {href ? <a href={href} class:list={[pub.link, canceled && 'line-through']}>{name}</a> : <span class:list={[canceled && 'line-through decoration-ink-muted']}>{name}</span>}
      <span class="text-meta font-normal text-ink-muted"> · <span style={`color:var(--cat-${type.category}-ink)`}>{type.label}</span>{record.firstYear && <Fragment> · since {record.firstYear}</Fragment>}{dated && entry.edition && <span data-when-set={expires ? '' : undefined}> · {ordinal(entry.edition)} year</span>}</span>
    </h4>

    {dated && (
      <p class={status} data-when-set={expires ? '' : undefined}>
        <span class:list={[square, 'bg-primary']} aria-hidden="true"></span><strong class="font-semibold">{dateLabel(entry)}</strong> · <time datetime={entry.date}>{spanText(entry.date!, entry.endDate)}</time>{details.map((d) => <Fragment> · {d}</Fragment>)}{registration && <Fragment> · <a href={registration.url} rel="noopener" class={pub.link} data-registration>Register on {registration.label}</a></Fragment>}
      </p>
    )}
    {dated && entry.status === 'moved' && <p class={note} data-when-set={expires ? '' : undefined}>Was <time datetime={entry.previousDate}>{dayText(entry.previousDate!)}</time>. {organizer}: “{quoted(entry.reason)}”</p>}
    {dated && entry.note && <p class={note} data-when-set={expires ? '' : undefined}>{organizer}: “{quoted(entry.note)}”</p>}
    {!dated && !canceled && (
      <p class={status}>
        <span class:list={[square, 'bg-highlight']} aria-hidden="true"></span><strong class="font-semibold">Not yet announced</strong>{row.lastHeld && <Fragment> · {lastWord} <time datetime={row.lastHeld}>{spanText(row.lastHeld, past ? entry.endDate : record.years.find((y) => y.date === row.lastHeld)?.endDate)}</time></Fragment>}
      </p>
    )}
    {entry.continues && entry.status === 'not-announced' && <p class={note}>{organizer}: “{quoted(entry.continues)}”</p>}
    {entry.typicalWindow && (entry.status === 'typical' || entry.status === 'not-announced') && <p class={note}><span class="font-semibold text-ink">Typical window, not a date:</span> {typeset(entry.typicalWindow)}</p>}
    {canceled && (
      <Fragment>
        <p class={status}>
          <span class:list={[square, 'bg-ink-muted']} aria-hidden="true"></span><strong class="font-semibold">Canceled</strong>{entry.date && <Fragment> · was set for <time datetime={entry.date}>{dayText(entry.date)}</time></Fragment>}
        </p>
        {entry.reason && <p class={note}>{organizer}: “{quoted(entry.reason)}”</p>}
      </Fragment>
    )}

    {/* After the date, in the reader's browser only: the words wait in data-past-text. */}
    {expires && (
      <div data-when-past hidden>
        <p class={status}>
          <span class:list={[square, 'bg-highlight']} aria-hidden="true"></span><strong class="font-semibold" data-past-text="Not yet announced"></strong><span data-past-text={` · ${lastWord} ${spanText(entry.date!, entry.endDate)}`}></span>
        </p>
      </div>
    )}
    {closedDays.length > 0 && <p class={note} data-when-set={expires ? '' : undefined} data-closed-days>Closed: {typeset(closedDays.join(', '))}</p>}
    {subEvents.length > 0 && (
      <ul class:list={['mt-1 space-y-0.5', pub.meta]} data-when-set={expires ? '' : undefined} data-sub-events>
        {subEvents.map((e) => (
          <li><span class="font-semibold text-ink">{typeset(e.name)}</span>{[e.date && formatDayShort(day(e.date)), publishedTime(e.time), typeset(e.place)].filter(Boolean).map((part) => <Fragment> · {part}</Fragment>)}</li>
        ))}
      </ul>
    )}
    {line && <p class:list={['mt-1', pub.meta, 'text-ink']} data-local-line>{typeset(line)}</p>}
    <p class:list={['mt-1', pub.meta]}>
      Checked <time datetime={entry.checked}>{formatShortDate(day(entry.checked))}</time> · {sourceLink(record, entry) ? <Fragment>Source: <a href={source} rel="noopener" class={pub.link}>{organizer}</a>{entry.alsoSource && <Fragment> and <a href={entry.alsoSource.url} rel="noopener" class={pub.link} data-also-source>{entry.alsoSource.label}</a></Fragment>}</Fragment> : <span data-source-offline>{record.sourceOffline}</span>}{also.length > 0 && <span data-also-on> · Also on: {also.map((a, i) => (<Fragment>{i > 0 && ' · '}<a href={a.href} class={pub.link}>{a.label}</a></Fragment>))}</span>}
    </p>
    {record.fixture && <p class="mt-1 text-meta font-semibold text-ink">Sample record (test fixture): not a real event, never on the live site.</p>}
  </div>
</article>
