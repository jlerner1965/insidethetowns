---
/**
 * An event as an editorial row: date (or time) in the left column, category
 * eyebrow, serif title, meta line. The whole row is the link.
 *
 * A run of days is shown as a run. A corn maze open from September 23 to
 * October 31 used to lead the home page as "Wed 23 Sep" for five weeks, which
 * read as a date that had passed; while it is on, the row says "Now through
 * October 31", and before it starts, the range.
 *
 * A canceled or postponed listing stays in the list — the reader who planned
 * to go is exactly who needs to see it — with the label and the title struck
 * through, so nobody drives to a meeting the Town has called off.
 */
import { Image } from 'astro:assets';
import type { TownEntry } from '@/lib/content';
import { dayKey, formatDate, formatDayRange, formatMonthDay, formatTimeRange, formatWeekday, monthDay, toIsoLocal } from '@/lib/dates';
import { isCanceled, isInProgress, lastDay } from '@/lib/events';
import { CATEGORY_LABELS, EVENT_STATUS_LABELS } from '@/content/schemas';

interface Props {
  event: TownEntry<'events'>;
  /** Show the calendar date in the left column; off when under a day heading. */
  showDate?: boolean;
  /**
   * A weekly regular or one of a series, as the events page works out across
   * its whole list. Marked on the row so the default view can lead with the
   * one-offs; see EventFilters.astro.
   */
  regular?: boolean;
}

const { event, showDate = true, regular = false } = Astro.props;
const { data, slug } = event;
const href = `/events/${slug}/`;
const canceled = isCanceled(event);
const statusLabel = data.status !== 'scheduled' ? EVENT_STATUS_LABELS[data.status] : undefined;
// A listing spanning more than one day: a festival weekend, a six-week run.
const multiDay = !!data.end && dayKey(data.start) !== dayKey(data.end);
// Decided at build, like everything else dated on these pages; the daily
// rebuild keeps it right, and the row never claims more than "now".
const running = multiDay && !canceled && isInProgress(event);
const badge = monthDay(running ? data.end! : data.start);
const time =
  data.timeNote ??
  (running
    ? `Now through ${formatMonthDay(data.end!)}`
    : multiDay && data.allDay
      ? formatDayRange(data.start, data.end!)
      : formatTimeRange(data.start, data.end, data.allDay));
const note =
  data.recurring ??
  (data.repeat === 'weekly' && data.until ? `Every ${formatWeekday(data.start)} through ${formatDate(data.until)}` : undefined);
---
<article
  class="group relative grid grid-cols-[4.25rem_1fr] gap-x-4 border-t border-line-soft py-5 first:border-t-0 md:grid-cols-[4.5rem_1fr_auto] md:gap-x-7 md:py-6"
  data-filter-item
  data-category={data.category}
  data-start-day={dayKey(data.start)}
  data-event-day={lastDay(event)}
  data-free={/^free\b/i.test(data.cost ?? '') ? 'true' : undefined}
  data-regular={regular ? 'true' : undefined}
  data-status={statusLabel ? data.status : undefined}
>
  {showDate ? (
    <time datetime={toIsoLocal(data.start)} class="flex flex-col pt-0.5">
      <span class="eyebrow">{running ? 'Now' : badge.weekday}</span>
      <span class="font-heading text-[2.25rem] font-medium leading-none tabular-nums text-accent-text md:text-[2.5rem]">{badge.day}</span>
      <span class="text-xs font-medium uppercase tracking-[0.1em] text-ink-muted">{badge.month}</span>
    </time>
  ) : (
    <time
      datetime={toIsoLocal(data.start)}
      class:list={['pt-1 text-sm font-semibold tabular-nums leading-snug text-ink-muted', data.timeNote ? 'break-words' : 'whitespace-nowrap']}
    >
      {time.split(' – ')[0]}
      {data.end && !data.allDay && !data.timeNote && <span class="block text-ink-faint">to {time.split(' – ')[1]}</span>}
    </time>
  )}
  <div class="min-w-0">
    <p class="eyebrow flex flex-wrap items-center gap-2" style={`color:var(--cat-${data.category}-ink)`}>
      <span class="inline-block size-2 shrink-0 rounded-full" style={`background:var(--cat-${data.category}-dot)`} aria-hidden="true"></span>
      {CATEGORY_LABELS[data.category]}
      {statusLabel && (
        <span class="rounded-full bg-ink px-2 py-0.5 text-[0.625rem] font-semibold uppercase tracking-[0.1em] text-raised">{statusLabel}</span>
      )}
    </p>
    <h3 class="mt-1.5 text-xl font-medium leading-tight md:text-2xl">
      <a href={href} class:list={['stretch no-underline group-hover:text-accent-text', canceled && 'line-through decoration-ink-faint decoration-2']}>{data.title}</a>
    </h3>
    <p class="mt-2 text-[0.9375rem] leading-snug text-ink-muted">
      {showDate && <span>{time} · </span>}{data.venue}{data.cost && <span> · {data.cost}</span>}
    </p>
    {statusLabel && data.statusNote && <p class="mt-1 text-sm text-ink">{data.statusNote}</p>}
    {note && !canceled && <p class="mt-1 text-sm text-ink-faint">{note}</p>}
  </div>
  {data.image && (
    <Image src={data.image} alt={data.imageAlt ?? ''} width={224} height={168} class="hidden aspect-[4/3] w-28 rounded-md object-cover md:block" />
  )}
</article>
