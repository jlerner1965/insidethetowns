---
/**
 * An event as an editorial row: date (or time) in the left column, category
 * eyebrow, serif title, meta line. The whole row is the link.
 *
 * A run of days is shown as a run. A corn maze open from September 23 to
 * October 31 used to lead the home page as "Wed 23 Sep" for five weeks, which
 * read as a date that had passed; while it is on, the row says "Now through
 * October 31", and before it starts, the range. The date block over it says
 * "Until 31 Oct": "Now" over the end date read as if it happened that day.
 *
 * "Other" is the category for what fits none of the rest, so it is not
 * printed: a label that says nothing is noise above the title.
 *
 * A canceled or postponed listing stays in the list — the reader who planned
 * to go is exactly who needs to see it — with the label and the title struck
 * through, so nobody drives to a meeting the Town has called off.
 */
import { Image } from 'astro:assets';
import type { TownEntry } from '@/lib/content';
import { dayKey, formatDate, formatDayRange, formatMonthDay, formatTime, formatTimeRange, formatWeekday, monthDay, toIsoLocal } from '@/lib/dates';
import { isCanceled, isInProgress, lastDay, listedUntil } from '@/lib/events';
import { EVENT_STATUS_LABELS, shownCategoryLabel } from '@/content/schemas';
import { subTownLabel } from '@/lib/sub-towns';

interface Props {
  event: TownEntry<'events'>;
  /** Show the calendar date in the left column; off when under a day heading. */
  showDate?: boolean;
}

const { event, showDate = true } = Astro.props;
const { data, slug } = event;
const href = `/events/${slug}/`;
const canceled = isCanceled(event);
const statusLabel = data.status !== 'scheduled' ? EVENT_STATUS_LABELS[data.status] : undefined;
// A listing spanning more than one day: a festival weekend, a six-week run.
const multiDay = !!data.end && dayKey(data.start) !== dayKey(data.end);
// Decided at build, like everything else dated on these pages; the daily
// rebuild keeps it right, and the row never claims more than "now".
const running = multiDay && !canceled && isInProgress(event);
const badge = monthDay(running ? data.end! : data.start);
const time =
  data.timeNote ??
  (running
    ? `Now through ${formatMonthDay(data.end!)}`
    : multiDay && data.allDay
      ? formatDayRange(data.start, data.end!)
      : formatTimeRange(data.start, data.end, data.allDay));
// Under a day heading the time sits in a 4.5rem column. "7 pm" and "to 9 pm"
// fit it; "Now through October 31" did not, and as one unbreakable line it ran
// over the category. A run of days is given there as short words that wrap
// ("Now through" / "Oct 31"), with the first day left to the heading above.
const shortDay = (d: Date) => `${monthDay(d).month} ${monthDay(d).day}`;
const [cellTime, cellTo] = data.timeNote
  ? [data.timeNote]
  : running
    ? ['Now through', shortDay(data.end!)]
    : multiDay && data.allDay
      ? ['Through', shortDay(data.end!)]
      : multiDay
        ? [formatTime(data.start), `to ${monthDay(data.end!).weekday} ${formatTime(data.end!)}`]
        : data.end && !data.allDay
          ? [formatTime(data.start), `to ${formatTime(data.end)}`]
          : [time];
// A free-text time ("Evening; time on the ticket page", "During library
// hours, through October 22") stacked five and six lines deep in that column,
// taller than the event. A long one goes on the line under the title; the
// column keeps its first clause where that is short ("Evening"), else nothing.
const longNote = !!data.timeNote && data.timeNote.length > 14;
const firstClause = data.timeNote?.split(/[;,(]/)[0].trim();
const cell = longNote ? (firstClause && firstClause.length <= 14 ? [firstClause] : []) : [cellTime, cellTo];
// "Other" is filed but not labelled; a status still shows on its own.
const categoryLabel = shownCategoryLabel(data.category);
const note =
  data.recurring ??
  (data.repeat === 'weekly' && data.until ? `Every ${formatWeekday(data.start)} through ${formatDate(data.until)}` : undefined);
---
{/* Under a day heading on a phone the row is one column, the time a line
    above the title: beside a time column the titles had about 215px and ran
    to three lines. The date block (showDate) is narrow enough to keep. */}
<article
  class:list={[
    'group relative grid gap-x-4 border-t border-line-soft py-5 first:border-t-0 md:grid-cols-[4.5rem_1fr_auto] md:gap-x-7 md:py-6',
    showDate ? 'grid-cols-[4.25rem_1fr]' : 'grid-cols-1 sm:grid-cols-[4.25rem_1fr]',
  ]}
  data-filter-item
  data-category={data.category}
  data-start-day={dayKey(data.start)}
  data-event-day={lastDay(event)}
  data-end={toIsoLocal(listedUntil(event))}
  data-free={/^free\b/i.test(data.cost ?? '') ? 'true' : undefined}
  data-status={statusLabel ? data.status : undefined}
  data-sub-town={data.subTown}
>
  {showDate ? (
    <time datetime={toIsoLocal(data.start)} class="flex flex-col pt-0.5">
      <span class="eyebrow">{running ? 'Until' : badge.weekday}</span>
      <span class="font-heading text-[2.25rem] font-medium leading-none tabular-nums text-primary md:text-[2.5rem]">{badge.day}</span>
      <span class="text-xs font-medium uppercase tracking-[0.1em] text-ink-muted">{badge.month}</span>
    </time>
  ) : (
    <time
      datetime={toIsoLocal(data.start)}
      class:list={[
        'text-sm font-semibold tabular-nums leading-snug text-ink-muted sm:pt-1',
        'mb-1.5 sm:mb-0',
        data.timeNote || multiDay ? 'break-words' : 'sm:whitespace-nowrap',
      ]}
    >
      {longNote ? (
        <Fragment>
          {/* On a phone this is a line above the title, room enough for all of it. */}
          <span class="sm:hidden">{data.timeNote}</span>
          {cell[0] && <span class="hidden sm:inline">{cell[0]}</span>}
        </Fragment>
      ) : (
        <Fragment>
          {cell[0]}
          {cell[1] && <span class="text-ink-muted sm:block">{' '}{cell[1]}</span>}
        </Fragment>
      )}
    </time>
  )}
  <div class="min-w-0">
    {(categoryLabel || statusLabel) && (
      <p class="eyebrow mb-1.5 flex flex-wrap items-center gap-2" style={`color:var(--cat-${data.category}-ink)`}>
        {categoryLabel && (
          <span class="inline-block size-2 shrink-0 rounded-full" style={`background:var(--cat-${data.category}-dot)`} aria-hidden="true"></span>
        )}
        {categoryLabel}
        {statusLabel && (
          <span class="rounded-full bg-ink px-2 py-0.5 text-[0.75rem] font-semibold uppercase tracking-[0.1em] text-raised">{statusLabel}</span>
        )}
      </p>
    )}
    <h3 class="text-xl font-medium leading-tight md:text-2xl">
      <a href={href} class:list={['stretch no-underline group-hover:text-primary', canceled && 'line-through decoration-ink-muted decoration-2']}>{data.title}</a>
    </h3>
    <p class="mt-2 text-[0.9375rem] leading-snug text-ink-muted">
      {showDate ? <span>{time} · </span> : longNote && <span class="hidden sm:inline">{time} · </span>}{data.venue}{data.subTown && <span>, {subTownLabel(data.subTown)}</span>}{data.cost && <span> · {data.cost}</span>}
    </p>
    {statusLabel && data.statusNote && <p class="mt-1 text-sm text-ink">{data.statusNote}</p>}
    {note && !canceled && <p class="mt-1 text-sm text-ink-muted">{note}</p>}
  </div>
  {data.image && (
    <Image src={data.image} alt={data.imageAlt ?? ''} width={224} height={168} class="hidden aspect-[4/3] w-28 rounded-md object-cover md:block" />
  )}
</article>
