---
import { Image } from 'astro:assets';
import type { TownEntry } from '@/lib/content';
import { formatTimeRange, monthDay, toIsoLocal } from '@/lib/dates';
import { CATEGORY_LABELS } from '@/content/schemas';

interface Props {
  event: TownEntry<'events'>;
  /** Hide the date badge when the card sits under a day heading. */
  showDate?: boolean;
}

const { event, showDate = true } = Astro.props;
const { data, slug } = event;
const badge = monthDay(data.start);
const href = `/events/${slug}/`;
---
<article
  class="flex gap-4 rounded-lg border border-line bg-white p-4 transition hover:border-accent"
  data-filter-item
  data-category={data.category}
>
  {showDate && (
    <time datetime={toIsoLocal(data.start)} class="flex w-14 shrink-0 flex-col items-center rounded-md bg-neutral-bg py-2 text-center">
      <span class="text-xs font-semibold uppercase tracking-wide text-accent-dark">{badge.month}</span>
      <span class="text-2xl font-bold leading-none">{badge.day}</span>
      <span class="text-xs text-ink-muted">{badge.weekday}</span>
    </time>
  )}
  {data.image && (
    <Image src={data.image} alt={data.imageAlt ?? ''} width={160} height={120} class="hidden h-24 w-32 shrink-0 rounded-md object-cover sm:block" />
  )}
  <div class="min-w-0 flex-1">
    <p class="text-xs font-semibold uppercase tracking-wide text-accent-dark">{CATEGORY_LABELS[data.category]}</p>
    <h3 class="mt-1 text-lg font-bold leading-snug">
      <a href={href} class="hover:underline">{data.title}</a>
    </h3>
    <p class="mt-1 text-sm text-ink-muted">
      {formatTimeRange(data.start, data.end, data.allDay)} · {data.venue}
      {data.cost && <span> · {data.cost}</span>}
    </p>
    {data.recurring && <p class="mt-1 text-xs text-ink-muted">{data.recurring}</p>}
  </div>
</article>
