---
/**
 * Hub only. A static SVG of the northern Front Range with a pin per town.
 * Lat/lng come from each town's config; the projection is a plain linear
 * fit over the bounding box, which is fine at this scale.
 */
import { LIVE_TOWNS, type TownConfig } from '@/config';

interface Props {
  towns: TownConfig[];
}

const { towns } = Astro.props;
const W = 640;
const H = 520;
const pad = 56;
const lngs = towns.map((t) => t.lng);
const lats = towns.map((t) => t.lat);
const minLng = Math.min(...lngs) - 0.1;
const maxLng = Math.max(...lngs) + 0.1;
const minLat = Math.min(...lats) - 0.08;
const maxLat = Math.max(...lats) + 0.08;
const x = (lng: number) => pad + ((lng - minLng) / (maxLng - minLng)) * (W - pad * 2);
const y = (lat: number) => H - pad - ((lat - minLat) / (maxLat - minLat)) * (H - pad * 2);
const pins = towns.map((t) => ({ t, cx: x(t.lng), cy: y(t.lat), live: LIVE_TOWNS.includes(t.slug) }));
---
<figure class="overflow-hidden rounded-lg bg-white ring-1 ring-line-soft">
  {/* No role="img": that prunes descendants from the accessibility tree,
     which would leave the seven town links focusable but unnamed. */}
  <svg viewBox={`0 0 ${W} ${H}`} aria-labelledby="town-map-title" class="h-auto w-full font-body">
    <title id="town-map-title">Map of the towns in the network</title>
    <rect width={W} height={H} fill="#ffffff"></rect>
    <path d={`M 0 0 L ${pad * 1.2} ${H * 0.12} L ${pad * 0.6} ${H * 0.5} L ${pad * 1.4} ${H} L 0 ${H} Z`} fill="var(--color-accent-soft)"></path>
    <text x={pad * 0.35} y={H * 0.5} font-size="11" fill="var(--color-ink-faint)" transform={`rotate(-90 ${pad * 0.35} ${H * 0.5})`} text-anchor="middle" letter-spacing="2">FOOTHILLS</text>
    {pins.map(({ t, cx, cy, live }) => (
      <g>
        {live ? (
          <a href={`https://${t.domain}/`} aria-label={`${t.name} — ${t.domain}`}>
            <circle cx={cx} cy={cy} r="20" fill={t.colors.accent} fill-opacity="0.15"></circle>
            <circle cx={cx} cy={cy} r="8" fill={t.colors.accent}></circle>
            <text x={cx + 18} y={cy + 5} font-size="15" font-weight="600" fill="var(--color-ink)">{t.name}</text>
          </a>
        ) : (
          <g>
            <circle cx={cx} cy={cy} r="6" fill="none" stroke="var(--color-ink-faint)" stroke-width="2"></circle>
            <text x={cx + 16} y={cy + 5} font-size="14" fill="var(--color-ink-muted)">{t.name}</text>
          </g>
        )}
      </g>
    ))}
    <text x={W - pad * 0.4} y={H - 18} font-size="11" fill="var(--color-ink-faint)" text-anchor="end" letter-spacing="2">NORTHERN FRONT RANGE · COLORADO</text>
  </svg>
</figure>
