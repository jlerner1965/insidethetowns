---
/**
 * Hub only. A static SVG map of where the towns are.
 *
 * The projection is a plain linear fit, but longitude is scaled by cos(lat) so
 * a degree east reads as the shorter distance it really is, and the viewBox is
 * sized to the data rather than to a fixed rectangle. Without both, the towns
 * span more than twice as much latitude as longitude and the map draws a thin
 * strip of pins down one side of a wide empty box.
 *
 * The reference cities and the interstate are what make the space between the
 * towns mean something: all but one sit north-west of Denver and Elizabeth sits
 * south-east of it, which is a fact about the network, not a hole in the map.
 */
import { LIVE_TOWNS, type TownConfig } from '@/config';

interface Props {
  towns: TownConfig[];
}

const { towns } = Astro.props;

/** Cities with no guide of their own, drawn faintly so the towns have somewhere to be. */
const CONTEXT = [
  // Fort Collins and Longmont used to be here; each has a guide of its own now.
  // Castle Rock stays listed for the day its guide is not live, and drops out
  // when it is, rather than drawing a faint label under its own pin.
  { name: 'Boulder', lat: 40.015, lng: -105.2705, side: 'right' },
  { name: 'Denver', lat: 39.7392, lng: -104.9903, side: 'left' },
  { name: 'Castle Rock', lat: 39.3722, lng: -104.8561, side: 'right' },
].filter((c) => !towns.some((t) => t.name === c.name));

/** I-25, the road that ties the whole thing together, as a rough polyline. */
const I25 = [
  { lat: 40.64, lng: -104.99 },
  { lat: 40.4, lng: -104.99 },
  { lat: 40.17, lng: -104.98 },
  { lat: 39.87, lng: -104.98 },
  { lat: 39.74, lng: -104.99 },
  { lat: 39.56, lng: -104.88 },
  { lat: 39.31, lng: -104.86 },
];

const all = [...towns, ...CONTEXT, ...I25];
const minLat = Math.min(...all.map((p) => p.lat)) - 0.05;
const maxLat = Math.max(...all.map((p) => p.lat)) + 0.05;
const minLng = Math.min(...all.map((p) => p.lng)) - 0.05;
const maxLng = Math.max(...all.map((p) => p.lng)) + 0.05;

// A degree of longitude covers less ground than a degree of latitude up here.
const shrink = Math.cos(((minLat + maxLat) / 2) * (Math.PI / 180));
const spanLat = maxLat - minLat;
const spanLng = (maxLng - minLng) * shrink;

// The foothills band needs the left edge, the longest label needs the right,
// and the caption needs a strip at the foot. Without the left margin the
// westernmost pin is drawn half outside the frame.
const marginL = 78;
const marginR = 132;
const footer = 30;
const PLOT_H = 540;
const scale = PLOT_H / spanLat;
const W = Math.round(spanLng * scale + marginL + marginR);
const H = PLOT_H + footer;

const x = (lng: number) => marginL + (lng - minLng) * shrink * scale;
const y = (lat: number) => (maxLat - lat) * scale;

const context = CONTEXT.map((c) => ({ ...c, cx: x(c.lng), cy: y(c.lat) }));

// Labels go to the right of their pins unless that lands on something.
// Berthoud and Johnstown are nine miles apart on one line of latitude; Timnath
// sits between Fort Collins and Severance, Carbon Valley beside Fort Lupton.
// A left-or-right rule ran out of room once those clusters filled in, so each
// label tries right, left, above, then below, and takes the first spot that
// clears every pin, every label already placed and the frame. The most
// crowded pins choose first, while there is still room to choose. Widths are
// estimated from the character count, generously, since the SVG cannot measure
// its own text here.
type Box = { x0: number; y0: number; x1: number; y1: number };
type Spot = { dx: number; dy: number; anchor: 'start' | 'end' | 'middle' };
const SPOTS: Spot[] = [
  { dx: 13, dy: 5, anchor: 'start' },
  { dx: -13, dy: 5, anchor: 'end' },
  { dx: 0, dy: -17, anchor: 'middle' },
  { dx: 0, dy: 27, anchor: 'middle' },
  { dx: 6, dy: -15, anchor: 'start' },
  { dx: -6, dy: -15, anchor: 'end' },
  { dx: 6, dy: 25, anchor: 'start' },
  { dx: -6, dy: 25, anchor: 'end' },
];
const textBox = (tx: number, ty: number, text: string, anchor: Spot['anchor'], size: number): Box => {
  const w = text.length * size * 0.56;
  const x0 = anchor === 'start' ? tx : anchor === 'end' ? tx - w : tx - w / 2;
  return { x0, y0: ty - size * 0.8, x1: x0 + w, y1: ty + size * 0.25 };
};
const overlap = (a: Box, b: Box) =>
  Math.max(0, Math.min(a.x1, b.x1) - Math.max(a.x0, b.x0)) * Math.max(0, Math.min(a.y1, b.y1) - Math.max(a.y0, b.y0));

const points = towns.map((t) => ({ t, cx: x(t.lng), cy: y(t.lat) }));
const obstacles: Box[] = [
  // A pin's halo is a 13px circle; a 10px square covers it without its empty corners.
  ...points.map(({ cx, cy }) => ({ x0: cx - 10, y0: cy - 10, x1: cx + 10, y1: cy + 10 })),
  ...context.flatMap((c) => [
    { x0: c.cx - 3, y0: c.cy - 3, x1: c.cx + 3, y1: c.cy + 3 },
    textBox(c.cx + (c.side === 'right' ? -9 : 9), c.cy + 4, c.name, c.side === 'right' ? 'end' : 'start', 12),
  ]),
  // The foothills band down the left edge.
  { x0: 0, y0: 0, x1: 28, y1: H },
];
const crowding = (p: (typeof points)[number]) =>
  points.filter((q) => q !== p && Math.abs(q.cx - p.cx) < 120 && Math.abs(q.cy - p.cy) < 30).length;
const spotFor = new Map<string, Spot>();
for (const p of [...points].sort((a, b) => crowding(b) - crowding(a))) {
  let best = SPOTS[0]!;
  let bestCost = Infinity;
  for (const s of SPOTS) {
    const box = textBox(p.cx + s.dx, p.cy + s.dy, p.t.name, s.anchor, 15);
    const outside = box.x0 < 0 || box.x1 > W || box.y0 < 0 || box.y1 > H - footer ? 1e6 : 0;
    const cost = outside + obstacles.reduce((sum, o) => sum + overlap(box, o), 0);
    if (cost < bestCost) [best, bestCost] = [s, cost];
    if (cost === 0) break;
  }
  spotFor.set(p.t.slug, best);
  obstacles.push(textBox(p.cx + best.dx, p.cy + best.dy, p.t.name, best.anchor, 15));
}
const pins = points.map(({ t, cx, cy }) => ({ t, cx, cy, spot: spotFor.get(t.slug)!, live: LIVE_TOWNS.includes(t.slug) }));
const road = I25.map((p) => `${x(p.lng).toFixed(1)},${y(p.lat).toFixed(1)}`).join(' ');
---
<figure class="overflow-hidden rounded-lg bg-raised ring-1 ring-line-soft">
  {/* No role="img": that prunes descendants from the accessibility tree,
     which would leave the town links focusable but unnamed. */}
  <svg viewBox={`0 0 ${W} ${H}`} aria-labelledby="town-map-title" class="h-auto w-full font-body">
    <title id="town-map-title">
      Map of Colorado's Front Range showing the {towns.length} towns in the network, with{' '}
      {context.map((c) => c.name).join(', ')} and Interstate 25 for reference
    </title>
    <rect width={W} height={H} fill="var(--color-raised)"></rect>

    {/* The mountains are the western edge of everything here. */}
    <path
      d={`M 0 0 L 24 ${H * 0.16} L 11 ${H * 0.4} L 27 ${H * 0.62} L 14 ${H * 0.82} L 26 ${H} L 0 ${H} Z`}
      fill="var(--color-accent-soft)"
    ></path>
    <text
      x="12"
      y={H * 0.5}
      font-size="11"
      fill="var(--color-ink-faint)"
      transform={`rotate(-90 12 ${H * 0.5})`}
      text-anchor="middle"
      letter-spacing="2">FOOTHILLS</text>

    <polyline
      points={road}
      fill="none"
      stroke="var(--color-ink-faint)"
      stroke-width="2"
      stroke-dasharray="1 5"
      stroke-linecap="round"
      opacity="0.7"></polyline>
    <text x={x(-104.98) + 9} y={y(39.98)} font-size="11" fill="var(--color-ink-faint)" letter-spacing="1.5">I-25</text>

    {context.map((c) => (
      <g>
        <circle cx={c.cx} cy={c.cy} r="3" fill="var(--color-ink-faint)"></circle>
        <text
          x={c.cx + (c.side === 'right' ? -9 : 9)}
          y={c.cy + 4}
          font-size="12"
          fill="var(--color-ink-faint)"
          text-anchor={c.side === 'right' ? 'end' : 'start'}>{c.name}</text>
      </g>
    ))}

    {pins.map(({ t, cx, cy, spot, live }) => (
      <g>
        {live ? (
          <a href={`https://${t.domain}/`} aria-label={`${t.name} — ${t.domain}`}>
            {/* A 13px halo, not 17: the larger ones ran into each other along
                the Longmont–Niwot–Erie and Fort Collins–Timnath clusters. */}
            <circle cx={cx} cy={cy} r="13" fill={t.colors.accent} fill-opacity="0.14"></circle>
            <circle cx={cx} cy={cy} r="7" fill={t.colors.accent}></circle>
            <text
              x={cx + spot.dx}
              y={cy + spot.dy}
              font-size="15"
              font-weight="600"
              fill="var(--color-ink)"
              text-anchor={spot.anchor}>{t.name}</text>
          </a>
        ) : (
          <g>
            <circle cx={cx} cy={cy} r="5.5" fill="none" stroke="var(--color-ink-faint)" stroke-width="2"></circle>
            <text
              x={cx + spot.dx}
              y={cy + spot.dy}
              font-size="14"
              fill="var(--color-ink-muted)"
              text-anchor={spot.anchor}>{t.name}</text>
          </g>
        )}
      </g>
    ))}

    <text x={W - 10} y={H - 11} font-size="11" fill="var(--color-ink-faint)" text-anchor="end" letter-spacing="2">COLORADO’S FRONT RANGE</text>
  </svg>
</figure>
