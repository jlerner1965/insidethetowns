---
/**
 * One program, club or way in, as a row: what it is, who it is for, when,
 * where, what it costs, how to register, and the source with its check
 * date. Every fact is the organizer's; a line the organizer did not give
 * is not drawn. The deadline is said plainly, and said to have passed when
 * it has. Where the program stands (open, not started yet, full, on a
 * break, ended) is a labelled pill beside the title, in words, with the
 * date that decides it (src/lib/programs.ts, programStatus); a program the
 * file says nothing about gets no pill rather than a guessed "open". The
 * row's own check date sits with its source, so a page's "Checked" line
 * never has to speak for every row (Lyons audit, 26 October 2026).
 * A program whose sign-ups have closed, that is full or that has ended
 * links "Organizer's page", not "Register": a closed futsal clinic offered
 * "Register →" under its "Registration closed" pill (Berthoud analysis,
 * 8 November 2026). The link is a button since 9 November 2026, and the
 * row's labels are bold black, so a row reads as parts, not a paragraph.
 */
import type { TownEntry } from '@/lib/content';
import { dayKey, formatDate, formatDayShort, formatShortDate, toIsoLocal } from '@/lib/dates';
import { ageText, breakAhead, deadlinePassed, programStatus } from '@/lib/programs';
import { PROGRAM_ACCESS_LABELS, PROGRAM_KIND_LABELS } from '@/content/schemas';
import { getTownEntries } from '@/lib/content';
import { occurrences, upcoming } from '@/lib/events';
import { whenMarks } from '@/lib/when-marks';

interface Props {
  program: TownEntry<'programs'>;
  /** Show the organizer and the kind over the title (off under a heading that already says). */
  showKind?: boolean;
  /** The title's weight in place of font-medium: the family hub sets its program names semibold (and black, global.css .family-titles) to stand apart from the facts. */
  titleClass?: string;
}

const { program, showKind = true, titleClass } = Astro.props;
const { data } = program;
const now = new Date();
const passed = deadlinePassed(program, now);
const status = programStatus(program, now);
const pause = breakAhead(program, now);
// Words carry the meaning; the colour only groups them: a notice (full, a
// break) on the amber wash, ended greyed, the rest plain.
const pill = {
  open: 'bg-raised text-primary ring-primary-line',
  upcoming: 'bg-raised text-ink ring-line',
  full: 'bg-highlight-soft text-ink ring-highlight',
  closed: 'bg-paper text-ink-muted ring-line',
  paused: 'bg-highlight-soft text-ink ring-highlight',
  ended: 'bg-paper text-ink-muted ring-line',
}[status?.state ?? 'upcoming'];
// The labels of the row's parts ("Who", "When", "Season", "Cost", "Volunteer
// need", "Next") in bold black, a size up from an eyebrow, with room between
// the parts: in the grey eyebrow a row read as one long paragraph on a phone
// (the owner, 9 November 2026).
const label = 'eyebrow text-[0.8125rem] font-bold text-title';
// The next date of the listing the program points at, so "next" is a date
// the calendar agrees with rather than a line typed here.
const next = data.nextEvent ? (await getTownEntries('events')).find((e) => e.slug === data.nextEvent) : undefined;
const nextWhen = next ? upcoming(occurrences([next], { now, horizonDays: 400 }), { now, limit: 1 })[0] : undefined;
// A cost the organizer did not publish is said to be missing, not left
// blank: a blank reads as free (family audit, 22 October 2026). It is set
// in the supporting ink so it does not read as an answer.
const NOT_STATED = 'Not stated on the organizer’s page';
const facts: Array<[string, string | undefined]> = [
  ['Who', ageText(program)],
  ['When', data.schedule],
  ['Season', data.season],
  ['Where', data.location],
  ['Cost', data.price ?? NOT_STATED],
  ['Bring', data.equipment],
  ['Access', data.access !== 'public' ? PROGRAM_ACCESS_LABELS[data.access] : undefined],
];
const shown = facts.filter((f): f is [string, string] => !!f[1]);
const reg = data.registration;
const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');
const canRegister = !['closed', 'full', 'ended'].includes(status?.state ?? '');
// An opening day already behind reads "open since", not "opens": "opens
// November 1" on November 8 read as still to come (Berthoud analysis).
const opened = !!data.registration?.opens && dayKey(data.registration.opens) <= dayKey(now);
const track = data.kind === 'league' || data.kind === 'class' || data.kind === 'program' ? 'registration' : 'participation';
---
<article id={`program-${program.slug}`} data-status={status?.state} class="min-w-0 scroll-mt-20 border-t border-line-soft py-5 first:border-t-0 md:py-6 [overflow-wrap:anywhere]">
  {showKind && (
    <p class="eyebrow text-ink-muted">{PROGRAM_KIND_LABELS[data.kind]} · {data.organizer}</p>
  )}
  <h3 class:list={['mt-1 text-xl leading-tight md:text-[1.375rem]', titleClass ?? 'font-medium', status?.state === 'ended' && 'text-ink-muted']}>
    {data.url ? <a href={data.url} rel="noopener" data-track={track} class="no-underline hover:text-primary hover:underline">{data.title}</a> : data.title}
  </h3>
  {status && (
    <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.9375rem]">
      <span class:list={['rounded-full px-2.5 py-0.5 text-[0.8125rem] font-semibold ring-1', pill]}><span class="sr-only">Status: </span>{status.label}</span>
      {status.detail && <span class="text-ink-muted">{status.detail}</span>}
    </p>
  )}
  {pause && (
    <p class="mt-2 rounded-md bg-highlight-soft px-3 py-1.5 text-[0.9375rem] ring-1 ring-highlight">{pause}</p>
  )}
  <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-muted">{data.summary}</p>
  {shown.length > 0 && (
    <dl class="mt-4 grid gap-x-6 gap-y-1 text-[0.9375rem] leading-snug sm:grid-cols-[6rem_1fr] sm:gap-y-2.5">
      {shown.map(([k, v]) => (
        <Fragment>
          <dt class:list={[label, 'sm:pt-0.5']}>{k}</dt>
          {/* The days and hours in the When line in bold, what a parent
              scans the row for (src/lib/when-marks.ts; the owner, 9
              November 2026). */}
          <dd class:list={['mb-3 last:mb-0 sm:mb-0', v === NOT_STATED && 'text-ink-muted']}>{k === 'When' ? whenMarks(v).map((s) => (s.mark ? <strong class="font-semibold text-title">{s.text}</strong> : s.text)) : v}</dd>
        </Fragment>
      ))}
    </dl>
  )}
  <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-[0.9375rem]">
    {reg && (
      <li class:list={[passed && 'text-ink-muted']}>
        <span class:list={[!passed && 'font-semibold text-title']}>{reg.required ? 'Registration required' : 'No registration'}</span>{reg.deadline && (
          <Fragment>{' · '}<time datetime={toIsoLocal(reg.deadline)} class:list={[!passed && 'font-semibold text-title']}>{passed ? `deadline was ${formatDate(reg.deadline)}` : `by ${formatDate(reg.deadline)}`}</time></Fragment>
        )}{reg.opens && !reg.deadline && <Fragment>{opened ? ' · open since ' : ' · opens '}<time datetime={toIsoLocal(reg.opens)}>{formatDate(reg.opens)}</time></Fragment>}
        {reg.how && <span class="block text-ink-muted">{reg.how}</span>}
        {reg.note && <span class="block text-ink-muted">{reg.note}</span>}
      </li>
    )}
    {data.beginners && <li class="text-ink-muted">Beginners welcome, the organizer says</li>}
    {data.newcomers && <li class="text-ink-muted">Newcomers welcome, the organizer says</li>}
  </ul>
  {data.volunteerNeed && <p class="mt-4 text-[0.9375rem]"><span class={label}>Volunteer need</span> <span class="block">{data.volunteerNeed}</span></p>}
  {nextWhen && (
    <p class="mt-4 text-[0.9375rem]">
      <span class={label}>Next</span>{' '}
      <a href={`/events/${next!.slug}/`} class="text-primary underline">{nextWhen.data.title}</a>, <time datetime={toIsoLocal(nextWhen.data.start)}>{formatDayShort(nextWhen.data.start)}</time>
    </p>
  )}
  {/* The way in as a button, the row's one action, on its own line: as a
      small link it sat beside the contact line and was easy to miss (the
      owner, 9 November 2026). A program that cannot be joined now gets the
      organizer's page in outline, not a filled "Register". */}
  {reg?.url && (
    <p class="mt-5">
      <a href={reg.url} rel="noopener" data-track={track} class:list={['btn', canRegister ? 'btn-primary' : 'btn-outline text-primary']}>{canRegister ? 'Register' : 'Organizer’s page'}</a>
    </p>
  )}
  <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-[0.875rem] text-ink-muted">
    {data.contact && <span>Contact: {data.contact}</span>}
    {data.source && (
      <span>
        <a href={data.source} rel="noopener" class="inline-block -my-2 py-2 underline">Source: {host(data.source)}</a>{data.verified && (
          <Fragment>, read <time datetime={toIsoLocal(data.verified).slice(0, 10)}>{formatShortDate(data.verified)}</time></Fragment>
        )}
      </span>
    )}
  </p>
</article>
