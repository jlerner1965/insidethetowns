---
/**
 * Category buttons that show/hide [data-filter-item] elements inside the
 * nearest [data-filter-root]. The only client-side JS on town sites.
 *
 * One filter, applied to the rows themselves: category, town, "Open now" and,
 * where the root has a [data-filter-search] input, the name. Every count the
 * page shows (a group's badge, "Show N more", the status line, the empty box
 * and what "Open now" left out) is read from that one result
 * (src/lib/filters.ts).
 */
interface Props {
  options: Array<{ value: string; label: string }>;
  label?: string;
  /** The visible name of the first row, in the label column: "What", "Town". */
  rowLabel?: string;
  /**
   * Offer an "Open now" toggle. It appears only once OpenStatus.astro has
   * worked out which listings are open, so a page without JavaScript never
   * shows a button that does nothing.
   */
  openNow?: boolean;
  /** On a multi-town guide, a second row narrowing to one of its towns; rows carry data-sub-town. */
  subTowns?: Array<{ slug: string; label: string }>;
}

const { options, label = 'Filter', rowLabel = 'What', openNow = false, subTowns = [] } = Astro.props;
const pill =
  'rounded-full border border-accent-line bg-raised px-4 py-2 text-sm sm:py-1.5 font-medium text-ink-muted transition-colors hover:border-accent hover:text-accent-text aria-pressed:border-accent-dark aria-pressed:bg-accent-dark aria-pressed:text-white';
---
{/* Held at the top of the screen while its list scrolls: a directory on a
   phone runs to many screens, and the filters used to scroll away with the
   first of them. The negative margins carry its paper to the page edge. */}
{(options.length > 1 || openNow || subTowns.length > 1) && (
  <div class="sticky top-0 z-20 -mx-5 mb-5 space-y-3 bg-paper/95 px-5 py-3 shadow-[0_1px_0_var(--color-line-soft)] backdrop-blur-sm sm:-mx-8 sm:px-8 md:mb-7 lg:-mx-10 lg:px-10" data-filter-bar>
    {/* Every row is labelled, so "Where" no longer sits under an unlabelled
        first row whose buttons started further left (see .filter-row). */}
    <div class="filter-row" role="group" aria-label={label}>
      <span class="eyebrow text-ink-faint">{rowLabel}</span>
      <div class="filter-pills">
        {options.length > 1 && <button type="button" data-filter="all" aria-pressed="true" class={pill}>All</button>}
        {options.length > 1 && options.map((o) => (
          <button type="button" data-filter={o.value} aria-pressed="false" class={pill}>{o.label}</button>
        ))}
        {openNow && (
          <button type="button" data-filter-open aria-pressed="false" hidden class:list={[pill, 'border-dashed']}>
            <span class="mr-1.5 inline-block size-2 rounded-full bg-[#2f9e5b] align-middle" aria-hidden="true"></span>Open now
          </button>
        )}
      </div>
    </div>
    {subTowns.length > 1 && (
      <div class="filter-row" role="group" aria-label="Filter by town">
        <span class="eyebrow text-ink-faint">Where</span>
        <div class="filter-pills">
          <button type="button" data-where="all" aria-pressed="true" class={pill}>All three</button>
          {subTowns.map((t) => (
            <button type="button" data-where={t.slug} aria-pressed="false" class={pill}>{t.label}</button>
          ))}
        </div>
      </div>
    )}
    {openNow && <p class="text-[0.875rem] text-ink-muted" data-filter-unknown hidden></p>}
    <p class="sr-only" role="status" data-filter-status></p>
  </div>
)}

<script>
  import { collapsePlan, emptyText, filterRows, statusText, unknownNote } from '@/lib/filters';

  const bars = document.querySelectorAll<HTMLElement>('[data-filter-bar]');
  for (const bar of bars) {
    const root = bar.closest<HTMLElement>('[data-filter-root]') ?? document.body;
    const buttons = bar.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const openToggle = bar.querySelector<HTMLButtonElement>('[data-filter-open]');
    const whereButtons = bar.querySelectorAll<HTMLButtonElement>('[data-where]');
    const search = root.querySelector<HTMLInputElement>('[data-filter-search]');
    let value = 'all';
    let openOnly = false;
    // Which of a multi-town guide's towns; 'all' everywhere else.
    let where = 'all';
    // Each row's place in the page as built, so folding and unfolding a day
    // can always put its rows back in their order.
    root.querySelectorAll<HTMLElement>('[data-filter-item]').forEach((item, i) => (item.dataset.order = String(i)));
    const order = (item: HTMLElement) => Number(item.dataset.order ?? 0);
    const labelOf = (selector: string) => bar.querySelector(selector)?.textContent?.trim();

    const apply = () => {
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === value));
      openToggle?.setAttribute('aria-pressed', String(openOnly));
      for (const b of whereButtons) b.setAttribute('aria-pressed', String(b.dataset.where === where));
      const query = search?.value ?? '';
      const items = [...root.querySelectorAll<HTMLElement>('[data-filter-item]')].sort((a, b) => order(a) - order(b));
      const result = filterRows(
        items.map((item) => ({
          category: item.dataset.category,
          subTown: item.dataset.subTown,
          name: item.dataset.name ?? item.querySelector('h3, h4')?.textContent ?? '',
          open: item.dataset.open,
          land: item.dataset.land === 'true',
        })),
        { value, openOnly, where, query },
      );
      items.forEach((item, i) => (item.hidden = !result.shown[i]));

      for (const group of root.querySelectorAll<HTMLElement>('[data-filter-group]')) {
        const rows = items.filter((item) => group.contains(item));
        const shown = rows.filter((item) => !item.hidden);
        group.hidden = shown.length === 0;
        const badge = group.querySelector<HTMLElement>('[data-filter-count]');
        if (badge) badge.textContent = String(shown.length);
        // A folded day: the shown rows first, the fold after the first few of
        // them, so a match is never left behind "Show N more".
        const list = group.querySelector<HTMLElement>('[data-collapse-list]');
        const more = group.querySelector<HTMLDetailsElement>('[data-collapse-more]');
        const rest = more?.querySelector<HTMLElement>('[data-collapse-rest]');
        if (list && more && rest) {
          const plan = collapsePlan(rows.map((item) => !item.hidden), Number(more.dataset.collapseMore || 6));
          for (const i of plan.above) list.insertBefore(rows[i]!, more);
          for (const i of plan.below) rest.append(rows[i]!);
          for (const item of rows) if (item.hidden) rest.append(item);
          const count = more.querySelector<HTMLElement>('[data-collapse-count]');
          if (count) count.textContent = String(plan.below.length);
          more.hidden = plan.below.length === 0;
          if (plan.below.length === 0) more.open = false;
        }
      }

      const label = value === 'all' ? undefined : labelOf(`[data-filter="${value}"]`) ?? value;
      const whereLabel = where === 'all' ? undefined : labelOf(`[data-where="${where}"]`) ?? where;
      const empty = root.querySelector<HTMLElement>('[data-filter-empty]');
      if (empty) {
        empty.hidden = result.count > 0;
        const text = empty.querySelector<HTMLElement>('[data-filter-empty-text]');
        if (text) text.textContent = emptyText({ label, openOnly, whereLabel, query });
      }
      const unknown = bar.querySelector<HTMLElement>('[data-filter-unknown]');
      if (unknown) {
        unknown.textContent = openOnly ? unknownNote(result) : '';
        unknown.hidden = !unknown.textContent;
      }
      // aria-pressed reports the button; this reports the result, by name.
      const status = bar.querySelector<HTMLElement>('[data-filter-status]');
      if (status) status.textContent = statusText(result.count, { label, openOnly, whereLabel, query });
      // For a page whose sections need more than their groups hidden.
      root.dispatchEvent(new CustomEvent('filter:change', { detail: { value, label } }));
    };
    for (const b of buttons) {
      b.addEventListener('click', () => {
        value = b.dataset.filter ?? 'all';
        apply();
      });
    }
    for (const b of whereButtons) {
      b.addEventListener('click', () => {
        where = b.dataset.where ?? 'all';
        const url = new URL(location.href);
        if (where === 'all') url.searchParams.delete('where');
        else url.searchParams.set('where', where);
        history.replaceState(null, '', url);
        apply();
      });
    }
    // Everything back as built: the buttons, the toggle, the search.
    for (const reset of root.querySelectorAll<HTMLButtonElement>('[data-filter-reset]')) {
      reset.addEventListener('click', () => {
        value = 'all';
        openOnly = false;
        where = 'all';
        if (search) search.value = '';
        const url = new URL(location.href);
        url.searchParams.delete('where');
        url.searchParams.delete('q');
        history.replaceState(null, '', url);
        apply();
        search?.focus();
      });
    }
    // A section page links here with ?where=firestone; a value the bar does
    // not offer is ignored rather than pressing nothing.
    const params = new URLSearchParams(location.search);
    const wanted = params.get('where');
    if (wanted && [...whereButtons].some((b) => b.dataset.where === wanted)) where = wanted;
    if (search) {
      search.addEventListener('input', apply);
      const q = params.get('q');
      if (q) search.value = q;
    }
    if (openToggle) {
      openToggle.addEventListener('click', () => {
        openOnly = !openOnly;
        apply();
      });
      // Shown once something on the page has hours to be open by; a page of
      // parks and trails has none, and the button stays away.
      const reveal = () => {
        if (root.querySelector('[data-filter-item][data-open]')) openToggle.hidden = false;
      };
      document.addEventListener('hours:ready', reveal);
      reveal();
    }
    if (where !== 'all' || search?.value) apply();
  }
</script>
