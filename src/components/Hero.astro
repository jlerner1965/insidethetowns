---
/**
 * Full-bleed town photograph with the town name set large in Fraunces.
 * The photo is the town's identity; the type stays the same across sites.
 */
import { Image } from 'astro:assets';
import { countyLabel, getSite } from '@/config';
import { resolveSiteImage } from '@/lib/images';

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  links?: Array<{ label: string; href: string; primary?: boolean }>;
}

const site = getSite();
const {
  eyebrow = site.kind === 'town' ? `${countyLabel(site)}, Colorado` : 'Colorado’s northern Front Range',
  title = site.name,
  subtitle = site.tagline,
  links = site.kind === 'town'
    ? [
        { label: 'This week’s events', href: '/events/', primary: true },
        { label: 'Eat & drink', href: '/eat-drink/' },
      ]
    : [],
} = Astro.props;
const hero = resolveSiteImage(site.slug, site.hero.image);
---
<section class="on-dark relative isolate overflow-hidden bg-accent-dark text-white">
  <Image
    src={hero}
    alt={site.hero.alt}
    widths={[640, 960, 1280, 1920]}
    sizes="100vw"
    layout="full-width"
    {/* Most of the hero sits under a scrim, so a lower quality is invisible
        here and saves about a fifth of one of the largest assets a desktop
        visitor downloads. The scrim now clears at the top of the frame, so
        this is the one place to look first if a sky ever bands. */}
    quality={72}
    priority
    class="absolute inset-0 -z-20 h-full! w-full object-cover"
  />
  {/*
    Two layers, and the second one is the reason a hero without a bright sky
    used to read as a coloured panel rather than a photograph: the town's
    accentDark at 35%, multiplied over every pixel, pulls every hue in the
    frame toward one navy. It is 20% now — enough to tie the picture to the
    palette, not enough to repaint it.

    The scrim is what carries legibility, so it is not simply lightened to
    match. Its stops are set so that (1 − scrim) × wash is never greater than
    it was at any height the type reaches — the eyebrow tops out around three
    quarters of the way up — which is the property that matters: no line of
    type sits on a lighter background than it did before. Above that band it
    clears completely, so the top of the frame is the photograph rather than
    the photograph under a 5% black veil.
  */}
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgba(0,0,0,0.88)_0%,rgba(0,0,0,0.5)_50%,rgba(0,0,0,0.36)_74%,transparent_100%)]"></div>
  <div class="absolute inset-0 -z-10 bg-accent-dark/20 mix-blend-multiply"></div>
  {/* Capped as well as proportional: on a tall desktop monitor 78svh is well
      over a thousand pixels of sky before the page starts. */}
  <div class="container-page relative flex min-h-[min(70svh,600px)] flex-col justify-end pb-10 pt-40 md:min-h-[min(78svh,760px)] md:pb-16">
    {/*
      White, not the amber every other dark band uses for this line.
      `check-colors` proves the amber clears 4.5:1 on accentDark, and it does —
      but this is the one eyebrow that sits on a photograph rather than on that
      flat fill, and a photograph has no guaranteed value. Measured against the
      rendered heroes it came in between 2.88:1 and 3.90:1 on six of the seven
      towns, at 12.75px, which is a fail. White clears 4.69:1 on the worst of
      them. The amber stays everywhere it is provably safe.
    */}
    <p class="eyebrow text-white">{eyebrow}</p>
    <h1 class="display mt-4 text-[4.25rem] sm:text-8xl lg:text-[9rem]">{title}</h1>
    <p class="mt-5 max-w-xl text-lg leading-snug text-white/85 md:mt-7 md:text-2xl">{subtitle}</p>
    {links.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-3 md:mt-10">
        {links.map((l) => (
          <a href={l.href} class:list={['btn', l.primary ? 'btn-light' : 'btn-outline text-white']}>{l.label}</a>
        ))}
      </div>
    )}
    {site.hero.credit && <p class="mt-8 text-xs text-white/70">Photo: {site.hero.credit}</p>}
  </div>
</section>
