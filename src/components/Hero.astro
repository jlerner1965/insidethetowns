---
/**
 * Full-bleed town photograph with the town name set large in Fraunces.
 * The photo is the town's identity; the type stays the same across sites.
 */
import { Image } from 'astro:assets';
import { countyLabel, getSite } from '@/config';
import { resolveSiteImage } from '@/lib/images';

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  links?: Array<{ label: string; href: string; primary?: boolean }>;
}

const site = getSite();
const {
  eyebrow = site.kind === 'town' ? `${countyLabel(site)}, Colorado` : 'Colorado’s northern Front Range',
  title = site.name,
  subtitle = site.tagline,
  links = site.kind === 'town'
    ? [
        { label: 'This week’s events', href: '/events/', primary: true },
        { label: 'Eat & drink', href: '/eat-drink/' },
      ]
    : [],
} = Astro.props;
const hero = resolveSiteImage(site.slug, site.hero.image);
---
<section class="on-dark relative isolate overflow-hidden bg-accent-dark text-white">
  <Image
    src={hero}
    alt={site.hero.alt}
    widths={[640, 960, 1280, 1920]}
    sizes="100vw"
    layout="full-width"
    {/* The hero sits under a heavy black gradient, so a lower quality is
        invisible here and saves about a fifth of the largest asset a
        desktop visitor downloads. */}
    quality={72}
    priority
    class="absolute inset-0 -z-20 h-full! w-full object-cover"
  />
  {/* Tinted with the town's color rather than neutral black, so the
      photograph sits in the same palette as the rest of the page. */}
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/85 via-black/35 to-black/5"></div>
  <div class="absolute inset-0 -z-10 bg-accent-dark/35 mix-blend-multiply"></div>
  {/* Capped as well as proportional: on a tall desktop monitor 78svh is well
      over a thousand pixels of sky before the page starts. */}
  <div class="container-page relative flex min-h-[min(70svh,600px)] flex-col justify-end pb-10 pt-40 md:min-h-[min(78svh,760px)] md:pb-16">
    <p class="eyebrow text-highlight">{eyebrow}</p>
    <h1 class="display mt-4 text-[4.25rem] sm:text-8xl lg:text-[9rem]">{title}</h1>
    <p class="mt-5 max-w-xl text-lg leading-snug text-white/85 md:mt-7 md:text-2xl">{subtitle}</p>
    {links.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-3 md:mt-10">
        {links.map((l) => (
          <a href={l.href} class:list={['btn', l.primary ? 'btn-light' : 'btn-outline text-white']}>{l.label}</a>
        ))}
      </div>
    )}
    {site.hero.credit && <p class="mt-8 text-xs text-white/50">Photo: {site.hero.credit}</p>}
  </div>
</section>
