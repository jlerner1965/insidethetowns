---
/**
 * Full-bleed town photograph with the town name set large in Fraunces.
 * The photo is the town's identity; the type stays the same across sites.
 *
 * Sized by what is in it (design pass, 26 October 2026): the county, the
 * name, the town's own line and three ways in, with the photograph behind
 * them, and no minimum height. It was capped at about half the screen and
 * still pushed the week below the fold on a phone; now the week starts
 * where the type ends, and a long name or enlarged text makes the panel
 * taller rather than clipping or shrinking the buttons.
 *
 * `compact` (the homepage redesign brief, 27 October 2026): the three ways
 * in become the one subhead line, and on a phone the hero is a band, not
 * a screen: the photograph at a fixed short height with the name and the
 * line under it on the town's colour, so What's happening starts within
 * the first screen and a half. On a wide screen the type stays over the
 * photograph, with less room above it.
 */
import { Image } from 'astro:assets';
import { countyLabel, getSite } from '@/config';
import { resolveSiteImage } from '@/lib/images';
import { getTownEntries } from '@/lib/content';
import { heroSecondLink, heroThirdLink } from '@/lib/places';
import { EAT_DRINK_TYPES, THINGS_TO_DO_TYPES } from '@/content/schemas';
import { shorten } from '@/lib/text';
import { heroCreditOnImage } from '@/lib/photo-credits';

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  links?: Array<{ label: string; href: string; primary?: boolean }>;
  /** No links, and on a phone the photograph as a short band with the type below it. */
  compact?: boolean;
}

const site = getSite();
// What the two section pages list, closed places left out as they are there.
const listed = site.kind === 'town' ? (await getTownEntries('places')).filter((p) => !p.delisted) : [];
const second: NonNullable<Props['links']>[number] = heroSecondLink({
  eatDrink: listed.filter((p) => EAT_DRINK_TYPES.includes(p.data.type) || p.data.type === 'shop').length,
  thingsToDo: listed.filter((p) => THINGS_TO_DO_TYPES.includes(p.data.type) || p.data.type === 'lodging').length,
});
const {
  eyebrow = site.kind === 'town' ? `${countyLabel(site)}, Colorado` : 'Colorado’s Front Range and mountains',
  title = site.name,
  // The short tagline, written to fit, when the site has one; the full
  // tagline is a sentence with a colon clause and clipped with "…" at
  // every width, which read as a truncation error on the first line of
  // the site. The full tagline stays in the meta description and the footer.
  subtitle = site.kind === 'town' ? site.shortTagline ?? site.tagline : site.tagline,
  // This week, then the bigger of the two place sections, then the
  // resident's page the guide has: Living here where it exists, else Moving
  // here. The same three everywhere, so a reader who knows one guide knows
  // them all; which pages they are is the guide's.
  compact = false,
  links = site.kind === 'town' && !compact ? [{ label: 'This week', href: '/this-week/', primary: true }, second, heroThirdLink(site)] as NonNullable<Props['links']> : [],
} = Astro.props;
const hero = resolveSiteImage(site.slug, site.hero.image);
const creditOnImage = heroCreditOnImage();
// A soft shade under the eyebrow and the tagline, the width of their words,
// so a bright patch of sky or a white wall behind a line cannot wash it out;
// off on a phone in the compact band, where the type is on the town's colour.
const lineShade = [
  'relative w-fit before:pointer-events-none before:absolute before:-inset-x-8 before:-inset-y-2 before:-z-10 before:rounded-[2rem] before:bg-black/40 before:blur-[18px]',
  compact && 'max-sm:before:hidden',
];
// The tagline in two lines at most, shortened at a phrase (src/lib/text.ts)
// rather than by the clamp alone, which put its ellipsis wherever the second
// line ran out. A phone's budget is smaller than a wide screen's, so there
// are two; the clamp stays as a net.
const subtitleShort = shorten(subtitle, 64);
const subtitleLong = shorten(subtitle, 88);
---
<section class="on-dark relative isolate overflow-hidden bg-primary text-white">
  <div class:list={[compact ? 'relative h-52 overflow-hidden sm:absolute sm:inset-0 sm:-z-20 sm:h-auto' : 'contents']}>
  <Image
    src={hero}
    alt={site.hero.alt}
    widths={[640, 960, 1280, 1920]}
    sizes="100vw"
    layout="full-width"
    {/* Most of the hero sits under a scrim, so a lower quality is invisible
        here and saves about a fifth of one of the largest assets a desktop
        visitor downloads. The scrim now clears at the top of the frame, so
        this is the one place to look first if a sky ever bands. */}
    quality={72}
    priority
    class="absolute inset-0 -z-20 h-full! w-full object-cover"
    style={site.hero.position ? `object-position: ${site.hero.position}` : undefined}
  />
  </div>
  {/*
    The photograph at full colour, shaded only where the type is (28
    October 2026, the owner: "more bright, less of black gloss over").
    Until then a black scrim covered the whole band, 0.88 at the foot, and
    the town's colour sat over every pixel at 20%: the type read at 9:1 to
    15:1 and the pictures read as dusk. Now there are three soft shades: a
    light one along the foot, where the band meets the sports strip; a pool
    behind the text column, darkest behind the name and gone well before
    the middle of the picture, which follows the column at any width; and
    a shade the width of its words under the eyebrow and under the tagline
    (lineShade). Measured on all twenty guides' built home pages at 768,
    1,024, 1,280, 1,440 and 1,920 px, against all but the brightest 5% of
    the picture behind each line: eyebrow at least 6.1:1, tagline 6.2:1,
    the name 4.9:1 (large type needs 3:1), and the picture away from the
    type about two and a half times as bright as before. On a phone the
    type is on the town's colour and none of this shows.
  */}
  <div class:list={['absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgba(0,0,0,0.35)_0%,transparent_40%)]', compact && 'max-sm:hidden']}></div>
  {/* The one exception to "no caption on the photograph": a licence that
      wants its credit beside the picture (an editorial stock photograph;
      heroCreditOnImage). In the photograph's bottom corner: on a phone in
      the compact band that is the foot of the 13rem photograph above the
      type, elsewhere the foot of the band. It sits outside the
      photograph's layer, which the shades cover. No box around it (the
      owner, 28 October 2026: the dark box looked bad); a soft glow behind
      the words and a faint shadow keep it legible on a light patch, the
      way a magazine credits a photograph. 10px, the owner's call (28
      October): smaller than the 14px floor for supporting text, and the
      smallest that still reads as a credit, which the licence needs. */}
  {creditOnImage && (
    <p class:list={['absolute right-2 z-10 text-[0.625rem] leading-tight tracking-wide text-white/90 [text-shadow:0_1px_2px_rgb(0_0_0/0.7)] before:pointer-events-none before:absolute before:-inset-x-2 before:-inset-y-1 before:-z-10 before:rounded-full before:bg-black/35 before:blur-[8px] max-sm:before:bg-black/70 sm:right-3', compact ? 'top-52 -translate-y-[calc(100%+0.5rem)] sm:top-auto sm:bottom-3 sm:translate-y-0' : 'bottom-2 sm:bottom-3']}>{creditOnImage}</p>
  )}
  {/* No minimum height: the padding and the type set it. In the compact
      band the type sits under the photograph on a phone, on the town's
      colour, and over it from a tablet up. */}
  <div class:list={['container-page relative flex flex-col justify-end', compact ? 'pb-6 pt-5 sm:pb-8 sm:pt-20 md:pb-9 md:pt-24' : 'pb-7 pt-12 sm:pt-16 md:pb-9 md:pt-20']}>
    {/* The pool behind the text column (see the shades above). */}
    <div
      aria-hidden="true"
      class:list={['pointer-events-none absolute bottom-0 -left-[17rem] -z-10 h-full w-[64rem]', compact && 'max-sm:hidden']}
      style="background: radial-gradient(ellipse 50% 78% at 50% 68%, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.5) 48%, rgba(0, 0, 0, 0.22) 76%, rgba(0, 0, 0, 0) 100%)"
    ></div>
    {/*
      White, as on every band. The amber this line once shared with the
      other bands came in between 2.88:1 and 3.90:1 against the rendered
      heroes, at 12.75px, which is a fail; white clears 4.69:1 on the worst
      of them. Since Color System 2.0 the bands' eyebrows are white too.
    */}
    <p class:list={['eyebrow text-white', lineShade]}>{eyebrow}</p>
    {/* Smaller than the poster size it was (6rem on a desktop), so "Carbon
        Valley" and "Manitou Springs" hold one line on a tablet and wrap
        cleanly on a phone, and the week is a scroll closer. The whole
        tagline is in the meta description and the footer. */}
    <h1 class:list={['display mt-2 [overflow-wrap:anywhere] sm:text-[3.25rem] lg:text-[4.25rem]', compact ? 'text-[2.25rem]' : 'text-[2.5rem]']}>{title}</h1>
    {/* Full white on the town's colour in the phone band: at 85% the line
        measured 4.17:1 on Golden's colour, 4.27:1 on Niwot's and 4.31:1 on
        Timnath's, under the 4.5:1 it needs; full white is 5.07:1 or more. */}
    <p class:list={['mt-3 max-w-xl text-[1.0625rem] leading-snug text-white/85 md:text-xl', compact && 'max-sm:text-white', lineShade]}>
      <span class="sm:hidden">{subtitleShort}</span><span class="hidden sm:inline">{subtitleLong}</span>
    </p>
    {links.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2.5 md:mt-6">
        {links.map((l) => (
          <a href={l.href} class:list={['btn', l.primary ? 'btn-light' : 'btn-outline text-white']}>{l.label}</a>
        ))}
      </div>
    )}
    {/* No caption on the photograph (owner, 26 October 2026: a line of
        small type over the picture looked bad). The credit is on
        /credits/, which names every photograph with its author, its
        license and a link to the original; every Creative Commons
        license accepts attribution given that way, and the footer links
        the page from every page. */}
  </div>
</section>
