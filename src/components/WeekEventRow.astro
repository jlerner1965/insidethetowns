---
/**
 * One listing in "This week in [Town]" and in the strip under an article:
 * the day, the title (to the event's own page), the time and venue, and a
 * link to the organizer's page the listing was read from.
 *
 * Two links, so the row is not one stretched link the way EventCard is; each
 * is its own 44px target. The day it falls on and the moment it comes off
 * the page ride along for Freshness.astro, which clears a finished listing
 * out of a build that is older than it.
 */
import type { TownEntry } from '@/lib/content';
import { monthDay, parseLocal, startOfDay, toIsoLocal } from '@/lib/dates';
import { isMultiDay, lastDay, listedUntil, timeText } from '@/lib/events';
import { shownCategoryLabel } from '@/content/schemas';
import { subTownLabel } from '@/lib/sub-towns';

interface Props {
  event: TownEntry<'events'>;
}

const { event } = Astro.props;
const { data, slug } = event;
// A run that began before today is dated by the day it ends, marked "Until",
// so a festival in its fourth week does not sit under this weekend with a
// date from last month.
const inProgress = isMultiDay(event) && data.start.getTime() < startOfDay(new Date()).getTime();
const badge = inProgress ? { ...monthDay(parseLocal(lastDay(event))), weekday: 'Until' } : monthDay(data.start);
const categoryLabel = shownCategoryLabel(data.category);
// The organizer's page: where the listing was read, else the page it links.
const source = data.source ?? data.url;
const host = source ? new URL(source).hostname.replace(/^www\./, '') : undefined;
---
<article class="grid grid-cols-[4.25rem_1fr] gap-x-4 border-t border-line-soft py-4 first:border-t-0" data-event-day={lastDay(event)} data-end={toIsoLocal(listedUntil(event))}>
  <time datetime={toIsoLocal(data.start)} class="flex flex-col pt-1">
    <span class="eyebrow">{badge.weekday}</span>
    <span class="font-heading text-[2rem] font-medium leading-none tabular-nums text-accent-text">{badge.day}</span>
    <span class="text-xs font-medium uppercase tracking-[0.1em] text-ink-muted">{badge.month}</span>
  </time>
  <div class="min-w-0">
    {categoryLabel && (
      <p class="eyebrow mb-1 flex items-center gap-2" style={`color:var(--cat-${data.category}-ink)`}>
        <span class="inline-block size-2 shrink-0 rounded-full" style={`background:var(--cat-${data.category}-dot)`} aria-hidden="true"></span>
        {categoryLabel}
      </p>
    )}
    <h3 class="text-xl font-medium leading-tight">
      <a href={`/events/${slug}/`} class="inline-block -my-2 py-2 no-underline hover:text-accent-text">{data.title}</a>
    </h3>
    <p class="mt-1 text-[0.9375rem] leading-snug text-ink-muted">
      {timeText(event)} · {data.venue}{data.subTown && <span>, {subTownLabel(data.subTown)}</span>}{data.cost && <span> · {data.cost}</span>}
    </p>
    {source && (
      <p class="mt-1 text-sm">
        <a href={source} rel="noopener" class="inline-block -my-3 py-3 text-accent-text underline">Source: {host}</a>
      </p>
    )}
  </div>
</article>
