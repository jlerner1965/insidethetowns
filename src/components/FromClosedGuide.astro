---
/**
 * One line on a hub page for a reader a closed guide sent here (the review
 * of 14 November 2026; src/lib/closed-guides.ts): "Inside Golden has
 * closed. Golden's annual events and outdoor dates are kept here; the
 * nearest full guide is Inside Erie." Hidden until the script finds a
 * `?from=` it knows, which it then takes off the address, so a shared or
 * bookmarked link is the page's own.
 *
 * The notes ride on the line itself as data, and the script is a file of
 * its own, as every script on the sites is: it was an inline script until
 * 14 November 2026, which the CSP in vercel.json (script-src 'self')
 * refuses, so on the live hub the line never showed. The site check now
 * refuses an inline script on any page (scripts/lib/site-check.ts).
 */
import { allTowns, liveTowns } from '@/config';
import { closedGuideNotes } from '@/lib/closed-guides';
import { FROM_PARAM } from '@/lib/fold';

const notes = closedGuideNotes(
  allTowns.filter((t) => t.hubPage),
  liveTowns(),
);
---
<div data-from-closed-guide data-notes={JSON.stringify(notes)} data-param={FROM_PARAM} hidden class="border-b border-line-soft bg-highlight-soft">
  <p class="container-page py-3 text-[0.9375rem] leading-snug text-ink">
    <strong class="font-semibold" data-guide></strong> has closed. <span data-town></span>’s annual events and outdoor dates are kept here<span data-nearest hidden>; the nearest full guide is <a class="font-semibold underline" href="/"></a></span>.
  </p>
</div>
<script>
  import type { ClosedGuideNote } from '@/lib/closed-guides';

  const box = document.querySelector<HTMLElement>('[data-from-closed-guide]');
  const param = box?.dataset.param;
  let url: URL | undefined;
  try {
    url = new URL(location.href);
  } catch {
    url = undefined;
  }
  const from = url && param ? url.searchParams.get(param) : null;
  if (box && url && param && from) {
    // Off the address first, known or not, so a shared or bookmarked link is the page's own.
    url.searchParams.delete(param);
    try {
      history.replaceState(history.state, '', url.pathname + (url.search || '') + url.hash);
    } catch {
      // A browser that refuses replaceState keeps the address as it was.
    }
    let notes: Record<string, ClosedGuideNote> = {};
    try {
      notes = JSON.parse(box.dataset.notes ?? '{}') as Record<string, ClosedGuideNote>;
    } catch {
      notes = {};
    }
    const note = Object.prototype.hasOwnProperty.call(notes, from) ? notes[from] : undefined;
    if (note) {
      const guide = box.querySelector('[data-guide]');
      const town = box.querySelector('[data-town]');
      if (guide) guide.textContent = note.guide;
      if (town) town.textContent = note.town;
      if (note.nearest) {
        const near = box.querySelector<HTMLElement>('[data-nearest]');
        const link = near?.querySelector('a');
        if (near && link) {
          link.textContent = note.nearest.name;
          link.href = note.nearest.url;
          near.hidden = false;
        }
      }
      box.hidden = false;
    }
  }
</script>
