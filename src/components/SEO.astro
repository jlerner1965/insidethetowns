---
/**
 * Every <head> tag that search engines and social cards care about.
 * Title pattern: "[Page] | Inside [Town]"; the home page passes no title.
 */
import { getImage } from 'astro:assets';
import { getSite } from '@/config';
import { resolveSiteImage } from '@/lib/images';
import { pageTitle } from '@/lib/titles';
import { clampText, markdownToText } from '@/lib/plain-text';

interface Props {
  title?: string;
  /**
   * The whole <title>, used as it is, in place of "[Page] | Inside [Town]":
   * the sports pages write theirs the way people search ("Berthoud Spartans
   * Football Scores & Schedule 2026 · Inside Berthoud").
   */
  fullTitle?: string;
  description?: string;
  /** Absolute or site-relative URL of the share image. Falls back to the hero. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
}

const site = getSite();
const { title, description = site.tagline, type = 'website', jsonLd, noindex = false } = Astro.props;
const fullTitle = Astro.props.fullTitle ?? pageTitle(site, title);

/**
 * Search results cut a description around 155 characters. Page copy is written
 * for the page, not for the snippet, so clamp here rather than shortening the
 * copy itself: at the end of a sentence when one closes past the halfway
 * mark, so the snippet reads as a whole thought, else at a word with an
 * ellipsis (network audit, 14 October 2026). A description is plain text:
 * some pages build theirs from a listing's Markdown (an event's first
 * sentence), so any link, emphasis or escape in it becomes its words first
 * (src/lib/plain-text.ts; audit, 26 October 2026).
 */
const metaDescription = clampText(markdownToText(description), 155);
const canonical = new URL(Astro.url.pathname, Astro.site);

let ogImage = Astro.props.image;
let ogAlt = Astro.props.imageAlt;
if (!ogImage) {
  const hero = resolveSiteImage(site.slug, site.hero.image);
  const generated = await getImage({ src: hero, width: 1200, height: 630, format: 'jpg' });
  ogImage = generated.src;
  ogAlt = site.hero.alt;
}
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<title>{fullTitle}</title>
{/* `summary` is the site search's line under a result (src/pages/search.astro):
    the page's own description, rather than whatever words sat near the match. */}
<meta name="description" content={metaDescription} data-pagefind-meta="summary[content]" />
{/* A page kept out of the index has nothing to be canonical for; the 404
    page in particular was declaring /404/, a URL that itself 404s. */}
{!noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:site_name" content={site.siteTitle} />
<meta property="og:type" content={type} />
<meta property="og:title" content={Astro.props.fullTitle ?? title ?? site.siteTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{ogAlt && <meta property="og:image:alt" content={ogAlt} />}
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={Astro.props.fullTitle ?? title ?? site.siteTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImageUrl} />

{jsonLdList.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)}></script>)}
