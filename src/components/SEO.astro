---
/**
 * Every <head> tag that search engines and social cards care about.
 * Title pattern: "[Page] | Inside [Town]"; the home page passes no title.
 */
import { getImage } from 'astro:assets';
import { getSite } from '@/config';
import { resolveSiteImage } from '@/lib/images';
import { pageTitle } from '@/lib/titles';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative URL of the share image. Falls back to the hero. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
}

const site = getSite();
const { title, description = site.tagline, type = 'website', jsonLd, noindex = false } = Astro.props;
const fullTitle = pageTitle(site, title);

/**
 * Search results cut a description around 155 characters. Page copy is written
 * for the page, not for the snippet, so clamp here rather than shortening the
 * copy itself: at the end of a sentence when one closes past the halfway
 * mark, so the snippet reads as a whole thought, else at a word with an
 * ellipsis. Every article and section page used to end "…" mid-sentence
 * (network audit, 14 October 2026).
 */
function clamp(text: string, limit = 155): string {
  const flat = text.replace(/\s+/g, ' ').trim();
  if (flat.length <= limit) return flat;
  const cut = flat.slice(0, limit);
  // The last full stop that ends a sentence: not "St. Vrain", "Mt. Evans",
  // "Hwy. 86", "U.S. 36" or an initial.
  const ABBREVIATION = /(?:\b(?:St|Mt|Dr|Mr|Mrs|Ms|Ave|Rd|Blvd|Hwy|No|vs|Co|Inc|Jr|Sr)|\b[A-Z]|\b[A-Z]\.[A-Z])$/;
  let sentence = -1;
  for (const m of cut.matchAll(/[.!?] /g)) {
    if (m[0] === '. ' && ABBREVIATION.test(cut.slice(0, m.index))) continue;
    sentence = m.index;
  }
  if (sentence > limit * 0.5) return cut.slice(0, sentence + 1);
  const short = cut.slice(0, limit - 1);
  const space = short.lastIndexOf(' ');
  return `${(space > limit * 0.6 ? short.slice(0, space) : short).replace(/[\s,;:.]+$/, '')}…`;
}
const metaDescription = clamp(description);
const canonical = new URL(Astro.url.pathname, Astro.site);

let ogImage = Astro.props.image;
let ogAlt = Astro.props.imageAlt;
if (!ogImage) {
  const hero = resolveSiteImage(site.slug, site.hero.image);
  const generated = await getImage({ src: hero, width: 1200, height: 630, format: 'jpg' });
  ogImage = generated.src;
  ogAlt = site.hero.alt;
}
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
{/* A page kept out of the index has nothing to be canonical for; the 404
    page in particular was declaring /404/, a URL that itself 404s. */}
{!noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:site_name" content={site.siteTitle} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? site.siteTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{ogAlt && <meta property="og:image:alt" content={ogAlt} />}
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? site.siteTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImageUrl} />

{jsonLdList.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)}></script>)}
