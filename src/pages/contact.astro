---
/**
 * No backend: a Formspree form when `formspreeId` is configured, otherwise
 * mailto links. Events have their own form at /submit-event/, because its ten
 * fields are the ones the event schema needs and a general message box is not.
 */
import Page from '@/layouts/Page.astro';
import { getSite } from '@/config';

const site = getSite();
const email = site.social.email;
const subject = (s: string) => `mailto:${email}?subject=${encodeURIComponent(`${s} — ${site.siteTitle}`)}`;
const formAction = site.formspreeId ? `https://formspree.io/f/${site.formspreeId}` : undefined;
---
<Page title="Contact" eyebrow="Say hello" description={`Corrections, event submissions and questions for ${site.siteTitle}.`} narrow>
  <div class="prose">
    <p>Email <a href={`mailto:${email}`}>{email}</a>, or use the shortcuts below.</p>

    <h2 id="submit-event">Submit an event</h2>
    {site.kind === 'town' ? (
      <Fragment>
        <p>
          Anything open to the public in and around {site.name} is welcome, and there is a form for it with the
          fields we need.
        </p>
        <p><a href="/submit-event/" class="btn btn-primary no-underline">Submit an event</a></p>
      </Fragment>
    ) : (
      <p>
        Events belong on their town’s own guide — each one has a form for it. Not sure which?
        <a href={subject('Event submission')}>Email it here</a> and we’ll put it where it goes.
      </p>
    )}

    <h2>Suggest a place or a correction</h2>
    <p><a href={subject('Listing or correction')}>Email a listing or correction</a></p>

    {formAction && (
      <form action={formAction} method="POST" class="mt-10 space-y-5 rounded-lg bg-raised p-6 ring-1 ring-line-soft md:p-8">
        <h2 class="mt-0">Or send a message</h2>
        <label class="block text-sm font-medium">
          Your email
          <input type="email" name="email" required class="mt-1.5 block w-full rounded-md border border-line bg-paper px-3 py-2.5 font-normal" />
        </label>
        <label class="block text-sm font-medium">
          Subject
          <input type="text" name="_subject" class="mt-1.5 block w-full rounded-md border border-line bg-paper px-3 py-2.5 font-normal" />
        </label>
        <label class="block text-sm font-medium">
          Message
          <textarea name="message" rows="6" required class="mt-1.5 block w-full rounded-md border border-line bg-paper px-3 py-2.5 font-normal"></textarea>
        </label>
        <button type="submit" class="btn btn-primary">Send</button>
      </form>
    )}
  </div>
</Page>
