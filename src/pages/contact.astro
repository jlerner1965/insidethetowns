---
/**
 * No backend: a Formspree form when `formspreeId` is configured, otherwise
 * mailto links. Events have their own form at /submit-event/, because its ten
 * fields are the ones the event schema needs and a general message box is not.
 *
 * `_next` sends a sender to our own /message-sent/ rather than Formspree's
 * default confirmation, which is a stranger's page with a stranger's branding
 * at the one moment someone has just trusted us with something. `_gotcha` is
 * Formspree's honeypot, as on the event form: no CAPTCHA, because a CAPTCHA
 * costs messages from exactly the readers least likely to send a second one.
 *
 * `_subject` carries a default rather than shipping blank. Eight sites post
 * to eight Formspree inboxes, and a blank subject leaves the sender's own
 * words in the preview line — which is the wrong thing to see when the
 * question is only which of the eight this one is. It is a visible field, so
 * anyone with a better subject can overwrite it.
 */
import Page from '@/layouts/Page.astro';
import { getSite } from '@/config';

const site = getSite();
const email = site.social.email;
const formAction = site.formspreeId ? `https://formspree.io/f/${site.formspreeId}` : undefined;
const contactHref = (topic: string) =>
  formAction
    ? `/contact/?subject=${encodeURIComponent(topic)}#send-message`
    : `mailto:${email}?subject=${encodeURIComponent(`${topic} — ${site.siteTitle}`)}`;
---
<Page title="Contact" eyebrow="Say hello" description={`Corrections, event submissions and questions for ${site.siteTitle}.`} narrow>
  <div class="prose">
    <p>{formAction ? 'Use the form below for questions, suggestions and corrections.' : <Fragment>Email <a href={`mailto:${email}`}>{email}</a>.</Fragment>}</p>

    <h2 id="submit-event">Submit an event</h2>
    {site.kind === 'town' ? (
      <Fragment>
        <p>
          Anything open to the public in and around {site.name} is welcome, and there is a form for it with the
          fields we need.
        </p>
        <p><a href="/submit-event/" class="btn btn-primary no-underline">Submit an event</a></p>
      </Fragment>
    ) : (
      <p>
        Events belong on their town’s own guide — each one has a form for it. Not sure which?
        <a href={contactHref('Event submission')}>Send the details here</a> and we’ll put it where it goes.
      </p>
    )}

    <h2 id="report-correction">Suggest a place or report a correction</h2>
    <p>
      For a correction, include the page, what appears wrong and a supporting source where possible.
      <a href={contactHref('Listing or correction')}>Send a listing or correction</a>.
    </p>

    {formAction && (
      <form id="send-message" action={formAction} method="POST" class="mt-10 space-y-5 rounded-lg bg-raised p-6 ring-1 ring-line-soft md:p-8">
        <input type="hidden" name="_next" value={`https://${site.domain}/message-sent/`} />
        <p class="hidden" aria-hidden="true">
          <label>Leave this blank <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        </p>
        <h2 class="mt-0">Send a message</h2>
        <label class="block text-sm font-medium">
          Your email
          <input type="email" name="email" required class="mt-1.5 block w-full rounded-md border border-line bg-paper px-3 py-2.5 font-normal" />
        </label>
        <label class="block text-sm font-medium">
          Subject
          <input type="text" name="_subject" value={`Message — ${site.siteTitle}`} data-contact-subject data-site-title={site.siteTitle} class="mt-1.5 block w-full rounded-md border border-line bg-paper px-3 py-2.5 font-normal" />
        </label>
        <label class="block text-sm font-medium">
          Message
          <textarea name="message" rows="6" required data-contact-message class="mt-1.5 block w-full rounded-md border border-line bg-paper px-3 py-2.5 font-normal"></textarea>
        </label>
        <button type="submit" class="btn btn-primary">Send</button>
      </form>
    )}
  </div>
</Page>

<script>
  const params = new URLSearchParams(window.location.search);
  const subject = document.querySelector<HTMLInputElement>('[data-contact-subject]');
  const message = document.querySelector<HTMLTextAreaElement>('[data-contact-message]');
  const topic = params.get('subject');
  const article = params.get('article');

  if (subject && topic) subject.value = `${topic} — ${subject.dataset.siteTitle}`;
  if (message && article) {
    message.value = `Article: ${article}\n\nWhat appears to be wrong:\n\nSource or supporting information:\n`;
  }
</script>
