---
/**
 * No backend: a Formspree form when `formspreeId` is configured, otherwise
 * mailto links. "Submit an event" from the events page lands on #submit-event.
 */
import Page from '@/layouts/Page.astro';
import { getSite } from '@/config';

const site = getSite();
const email = site.social.email;
const subject = (s: string) => `mailto:${email}?subject=${encodeURIComponent(`${s} — ${site.siteTitle}`)}`;
const formAction = site.formspreeId ? `https://formspree.io/f/${site.formspreeId}` : undefined;
---
<Page title="Contact" description={`Corrections, event submissions and questions for ${site.siteTitle}.`} narrow>
  <div class="prose">
    <p>Email <a href={`mailto:${email}`}>{email}</a>, or use the shortcuts below.</p>

    <h2 id="submit-event">Submit an event</h2>
    <p>
      Send the event name, date and time, venue, cost, and a link to the organizer’s page.
      Free and open-to-the-public events in {site.kind === 'town' ? site.name : 'any of our towns'} are always welcome.
    </p>
    <p><a href={subject('Event submission')} class="inline-block rounded-md bg-accent px-4 py-2 font-semibold text-white no-underline hover:bg-accent-dark">Email an event</a></p>

    <h2>Suggest a place or a correction</h2>
    <p><a href={subject('Listing or correction')}>Email a listing or correction</a></p>

    {formAction && (
      <form action={formAction} method="POST" class="mt-8 space-y-4 rounded-lg border border-line bg-white p-6">
        <h2 class="mt-0">Or send a message</h2>
        <label class="block text-sm font-medium">
          Your email
          <input type="email" name="email" required class="mt-1 block w-full rounded-md border border-line px-3 py-2" />
        </label>
        <label class="block text-sm font-medium">
          Subject
          <input type="text" name="_subject" class="mt-1 block w-full rounded-md border border-line px-3 py-2" />
        </label>
        <label class="block text-sm font-medium">
          Message
          <textarea name="message" rows="6" required class="mt-1 block w-full rounded-md border border-line px-3 py-2"></textarea>
        </label>
        <button type="submit" class="rounded-md bg-accent px-4 py-2 font-semibold text-white hover:bg-accent-dark">Send</button>
      </form>
    )}
  </div>
</Page>
