---
/**
 * Site search, over the built pages.
 *
 * Pagefind indexes `dist/` after every build (see scripts/run.ts) and writes a
 * static index under /pagefind/ that the browser loads in pieces as it
 * searches, so there is no search server and no third party: a query for
 * "pizza" fetches a few kilobytes from our own host. The CSP allows the WebAssembly
 * it runs on and nothing else new.
 *
 * The page is a box and a list, in the site's own type, rather than
 * Pagefind's bundled UI. Only pages that mark a [data-pagefind-body] are
 * indexed — every ordinary page does, through Base.astro — so past events,
 * the thank-you pages and this one stay out of the results.
 *
 * On the hub the index also holds every guide's places, guides, upcoming
 * events and Moving Here pages, each linking to the guide's own domain
 * (src/lib/network-search.ts), so a search on the network's front door finds
 * what is in the network. Each result says what it is, which town, and where
 * the link goes.
 *
 * In `astro dev` there is no index yet, and the page says so.
 */
import Page from '@/layouts/Page.astro';
import { getSite, listsEvents } from '@/config';
import { getTraditions } from '@/lib/content';
import { publishedHubTowns } from '@/lib/hub-towns';
import { townSearchIndex } from '@/lib/town-search-index';

const site = getSite();
/**
 * Exact town-name searches (src/lib/town-search.ts): the towns, their other
 * names and the regions, carried on the page for the script to match the
 * query against before Pagefind answers. On a guide, the guide alone.
 */
const townIndex = townSearchIndex(site, site.kind === 'hub' ? publishedHubTowns(await getTraditions()) : []);
// What a guide's search holds: no events on a guide that lists none (Niwot).
const things = site.kind === 'town' && !listsEvents(site) ? 'place and guide' : 'event, place and guide';
const browse =
  site.kind === 'town'
    ? [
        ...(listsEvents(site) ? [{ label: 'This weekend', href: '/this-weekend/' }, { label: 'Events', href: '/events/' }] : []),
        { label: 'Eat & drink', href: '/eat-drink/' },
        { label: 'Things to do', href: '/things-to-do/' },
        { label: 'Guides', href: '/guides/' },
      ]
    : [
        { label: 'This weekend', href: '/this-weekend/' },
        { label: 'The towns', href: '/#towns' },
        { label: 'Moving', href: '/moving/' },
        { label: 'Newsletter', href: '/newsletter/' },
      ];
---
<Page
  title="Search"
  seoTitle={`Search ${site.siteTitle}`}
  eyebrow={site.name}
  description={site.kind === 'town' ? `Search every ${things} on ${site.siteTitle}.` : `Search every event, place and guide on every ${site.siteTitle} guide.`}
  intro={site.kind === 'town' ? `Every ${things} on ${site.siteTitle}.` : 'Every event, place and guide on every town’s guide, and the network’s own pages.'}
  noindex
  narrow
>
  {/* In the masthead, where the page begins: below it the page was a tall
     tinted band, then a field, then very little. */}
  <form slot="after-header" role="search" action="/search/" method="get" class="mt-8 max-w-2xl" data-search-form>
    <label for="q" class="eyebrow mb-2 block">What are you looking for?</label>
    <div class="flex gap-3">
      <input
        id="q"
        name="q"
        type="search"
        autocomplete="off"
        autofocus
        placeholder="pizza, trail, storytime…"
        class="min-w-0 flex-1 rounded-md border border-field-line bg-raised px-4 py-3 text-[1.0625rem] text-ink placeholder:text-ink-muted focus:border-primary"
      />
      <button type="submit" class="btn btn-primary">Search</button>
    </div>
  </form>

  {/* Somewhere to go before the first word is typed: the empty page was a
     field and then 170px of nothing above the footer. */}
  <p class="mb-8 flex flex-wrap items-baseline gap-x-4 gap-y-1 text-[0.9375rem]">
    <span class="eyebrow text-ink-muted">Or browse</span>
    {browse.map((l) => <a href={l.href} class="-my-2 inline-block py-3 font-semibold text-primary underline">{l.label}</a>)}
  </p>
  {/* A query that is a town's name, one of its other names or a region:
      the town's own destinations first, each with its sections, filled
      by the script below (src/lib/town-search.ts). */}
  <section data-town-match hidden aria-labelledby="town-match-h" class="mb-10" data-town-index={JSON.stringify(townIndex)}>
    <h2 id="town-match-h" class="eyebrow mb-3" data-town-match-title>Town</h2>
    <ul class="grid gap-3" data-town-match-list></ul>
  </section>
  <p data-search-status class="text-ink-muted" aria-live="polite"></p>
  {/* By type, once a search has results in more than one: a button for each, with its count. */}
  <div data-search-filters hidden role="group" aria-label="Show results of one type" class="mt-4 flex flex-wrap gap-2"></div>
  <ol data-search-results class="mt-6 divide-y divide-line-soft border-y border-line-soft empty:border-0"></ol>
  <p data-search-more hidden class="mt-8">
    <button type="button" class="btn btn-outline text-primary">Show more</button>
  </p>
</Page>

<script>
  import { SEARCH_RANKING, SEARCH_TYPES } from '@/lib/network-search';
  import { DESTINATION_LABELS, matchTown, type TownDestination, type TownSearchIndex } from '@/lib/town-search';

  type Result = { url: string; meta: { title?: string; kind?: string; town?: string; domain?: string; summary?: string }; excerpt: string };
  type Search = { results: Array<{ data: () => Promise<Result> }>; totalFilters?: Record<string, Record<string, number>> };
  type Pagefind = {
    options: (o: object) => Promise<void>;
    init: () => Promise<void>;
    search: (q: string, o?: { filters?: Record<string, string> }) => Promise<Search>;
  };

  const form = document.querySelector<HTMLFormElement>('[data-search-form]')!;
  const input = form.querySelector<HTMLInputElement>('input[name="q"]')!;
  const status = document.querySelector<HTMLElement>('[data-search-status]')!;
  const list = document.querySelector<HTMLOListElement>('[data-search-results]')!;
  const more = document.querySelector<HTMLElement>('[data-search-more]')!;
  const moreButton = more.querySelector('button')!;
  const townBox = document.querySelector<HTMLElement>('[data-town-match]')!;
  const townList = townBox.querySelector<HTMLUListElement>('[data-town-match-list]')!;
  const townTitle = townBox.querySelector<HTMLElement>('[data-town-match-title]')!;
  const filterBox = document.querySelector<HTMLElement>('[data-search-filters]')!;
  const townIndex = JSON.parse(townBox.dataset.townIndex ?? '{"towns":[],"regions":[]}') as TownSearchIndex;
  const PAGE = 12;
  /** The type the results are narrowed to, from ?type= or a filter button. */
  let type = new URLSearchParams(location.search).get('type') ?? '';
  /** The matched towns' own pages, left out of the results under them. */
  let shown = new Set<string>();
  // "Town" on the hub's records is a whole community guide.
  const KIND_LABELS: Record<string, string> = { Town: 'Community guide', 'Annual dates': 'Annual dates' };
  const bare = (url: string) => url.replace(/[#?].*$/, '').replace(/\/$/, '');

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string): HTMLElementTagNameMap[K] => {
    const node = document.createElement(tag);
    node.className = className;
    if (text) node.textContent = text;
    return node;
  };

  /** One destination: what it is, its name, its line, and its sections as links. */
  function destination(d: TownDestination): HTMLLIElement {
    const li = el('li', 'rounded-lg bg-raised px-5 py-4 ring-1 ring-line-soft');
    li.append(el('p', 'eyebrow', DESTINATION_LABELS[d.kind]));
    const title = el('a', 'mt-1 inline-block font-heading text-2xl font-medium leading-tight text-ink no-underline hover:text-primary', d.title);
    title.href = d.url;
    li.append(title);
    li.append(el('p', 'mt-1 text-[0.9375rem] leading-relaxed text-ink-muted', d.description));
    if (d.covers) li.append(el('p', 'mt-1 text-[0.9375rem] text-ink', `Covers ${d.covers}.`));
    if (d.shortcuts.length > 0) {
      const links = el('ul', 'mt-3 flex flex-wrap gap-2');
      for (const s of d.shortcuts) {
        const a = el('a', 'inline-flex min-h-11 items-center rounded-full px-4 text-[0.9375rem] font-semibold text-primary no-underline ring-1 ring-primary-line hover:ring-primary', s.label);
        a.href = s.href;
        const item = el('li', '');
        item.append(a);
        links.append(item);
      }
      li.append(links);
    }
    return li;
  }

  /** The town, its other name or the region the whole query names; nothing when it names none. */
  function showTown(q: string) {
    const { towns, region } = matchTown(q, townIndex);
    townList.replaceChildren();
    shown = new Set(towns.map((t) => bare(t.url)));
    if (towns.length > 0) {
      townTitle.textContent = towns.length === 1 ? towns[0]!.name : `${towns[0]!.name}: ${towns.length} places to start`;
      for (const t of towns) townList.append(destination(t));
    } else if (region) {
      townTitle.textContent = `Towns in ${region.name}`;
      const li = el('li', 'rounded-lg bg-raised px-5 py-4 ring-1 ring-line-soft');
      const links = el('ul', 'flex flex-wrap gap-2');
      for (const t of region.towns) {
        const a = el('a', 'inline-flex min-h-11 items-baseline gap-2 rounded-full px-4 py-2.5 no-underline ring-1 ring-line-soft hover:ring-line');
        a.href = t.url;
        a.append(el('span', 'text-[0.9375rem] font-semibold text-ink', t.name), el('span', 'text-[0.8125rem] text-ink-muted', t.kind === 'guide' ? 'Community guide' : 'Annual dates'));
        const item = el('li', '');
        item.append(a);
        links.append(item);
      }
      li.append(links);
      townList.append(li);
    }
    townBox.hidden = townList.childElementCount === 0;
  }

  /** The type buttons, from the search's counts before any filter; none when every result is one type. */
  function showFilters(search: Search, q: string) {
    filterBox.replaceChildren();
    const counts = search.totalFilters?.type ?? {};
    const types = SEARCH_TYPES.filter((t) => (counts[t] ?? 0) > 0);
    if (types.length < 2) {
      filterBox.hidden = true;
      return;
    }
    const button = (label: string, value: string, count?: number) => {
      const b = el('button', 'inline-flex min-h-11 items-center gap-1.5 rounded-full px-4 text-[0.9375rem] font-semibold ring-1');
      b.type = 'button';
      const on = type === value;
      b.setAttribute('aria-pressed', String(on));
      b.className += on ? ' bg-primary text-white ring-primary' : ' bg-raised text-ink ring-line-soft hover:ring-line';
      b.append(label);
      if (count !== undefined) b.append(el('span', on ? 'text-white' : 'text-ink-muted', String(count)));
      b.addEventListener('click', () => {
        type = value;
        const url = new URL(location.href);
        if (value) url.searchParams.set('type', value);
        else url.searchParams.delete('type');
        history.replaceState(null, '', url);
        void run(q);
      });
      filterBox.append(b);
    };
    button('All', '');
    for (const t of types) button(t, t, counts[t]);
    filterBox.hidden = false;
  }

  let pagefind: Pagefind | null = null;
  let pending: Array<{ data: () => Promise<Result> }> = [];
  // Typing searches after a pause and Enter searches at once, so two searches
  // can be in flight together. Each takes a number; one that a later search
  // has overtaken drops its results rather than adding them to the list.
  let latest = 0;

  async function load(): Promise<Pagefind | null> {
    if (pagefind) return pagefind;
    try {
      // A variable, not a literal, so neither Vite nor the type checker tries
      // to resolve a file that exists only after the build.
      const indexUrl = '/pagefind/pagefind.js';
      const mod = (await import(/* @vite-ignore */ indexUrl)) as Pagefind;
      // A place's name over the events at it; the summary shown, not searched (SEARCH_RANKING).
      await mod.options({ ranking: SEARCH_RANKING });
      await mod.init();
      // The type buttons' counts: Pagefind fills a search's filter counts only once its filter index is loaded.
      await (mod as Pagefind & { filters: () => Promise<unknown> }).filters();
      pagefind = mod;
      return mod;
    } catch {
      status.textContent = 'Search runs on the published site; the index is built with it.';
      return null;
    }
  }

  function item(r: Result): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'py-5';
    // On the hub a result can be on any guide: "Place · Niwot", and the
    // guide's domain under the title, so a reader knows where the link goes.
    const label = [r.meta.kind && (KIND_LABELS[r.meta.kind] ?? r.meta.kind), r.meta.town].filter(Boolean).join(' · ');
    if (label) {
      const kind = document.createElement('p');
      kind.className = 'eyebrow mb-1';
      kind.textContent = label;
      li.append(kind);
    }
    const title = document.createElement('a');
    title.href = r.url;
    title.className = 'text-xl font-medium leading-tight no-underline hover:text-primary';
    title.textContent = r.meta.title ?? r.url;
    li.append(title);
    if (r.meta.domain) {
      const domain = document.createElement('p');
      domain.className = 'mt-1 text-sm text-ink-muted';
      domain.textContent = r.meta.domain;
      li.append(domain);
    }
    const excerpt = document.createElement('p');
    excerpt.className = 'mt-2 text-[0.9375rem] leading-relaxed text-ink-muted';
    // A place, an event or a guide says what it is in its own words: its
    // summary (the page's description: a place's, an event's day, time,
    // venue and first sentence, an article's excerpt), not the forty words
    // that happened to sit around the match, which on a venue were its
    // upcoming events (audit, 26 October 2026). Any other page, a list or
    // a section, shows where on it the words are, as Pagefind's excerpt,
    // which carries <mark> around the matched words and nothing else.
    const summary = r.meta.kind ? r.meta.summary : undefined;
    if (summary) excerpt.textContent = summary;
    else excerpt.innerHTML = r.excerpt;
    li.append(excerpt);
    return li;
  }

  async function showMore(search = latest) {
    const batch = pending.slice(0, PAGE);
    pending = pending.slice(PAGE);
    const data = await Promise.all(batch.map((r) => r.data()));
    if (search !== latest) return;
    // A matched town's own page is already at the top, with its sections.
    for (const r of data) if (!shown.has(bare(r.url))) list.append(item(r));
    more.hidden = pending.length === 0;
  }

  async function run(q: string) {
    const search = ++latest;
    list.replaceChildren();
    more.hidden = true;
    showTown(q);
    if (!q.trim()) {
      status.textContent = '';
      filterBox.hidden = true;
      return;
    }
    const pf = await load();
    if (!pf || search !== latest) return;
    status.textContent = 'Searching…';
    let found = await pf.search(q, type ? { filters: { type } } : undefined);
    // A type left in the address that this search has nothing of: all results instead.
    if (type && found.results.length === 0) {
      type = '';
      found = await pf.search(q);
    }
    if (search !== latest) return;
    const results = found.results;
    pending = results;
    showFilters(found, q);
    const what = !townBox.hidden ? 'more' : '';
    status.textContent = results.length === 0 ? (townBox.hidden ? `Nothing found for “${q}”.` : '') : `${results.length} ${what ? 'more ' : ''}${results.length === 1 ? 'result' : 'results'} for “${q}”${type ? `, ${type.toLowerCase()}` : ''}`;
    await showMore(search);
  }

  let timer = 0;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    clearTimeout(timer);
    const q = input.value;
    const url = new URL(location.href);
    if (q.trim()) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    void run(q);
  });
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(() => form.requestSubmit(), 250);
  });
  moreButton.addEventListener('click', () => void showMore());

  const initial = new URLSearchParams(location.search).get('q');
  if (initial) {
    input.value = initial;
    void run(initial);
  } else {
    void load();
  }
</script>
