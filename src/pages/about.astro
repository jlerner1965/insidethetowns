---
import { Image } from 'astro:assets';
import Page from '@/layouts/Page.astro';
import FactStrip from '@/components/FactStrip.astro';
import TipsLink from '@/components/TipsLink.astro';
import { resolveSiteImage } from '@/lib/images';
import { countiesCovered, countyLabel, getNetworkHub, getSite, liveTowns } from '@/config';
import CtaBand from '@/components/CtaBand.astro';
import { getTownEntries } from '@/lib/content';
import { eventTotals, describeTotals } from '@/lib/event-totals';
import { isOpen } from '@/lib/places';
import { formatShortDate } from '@/lib/dates';

const site = getSite();
const live = liveTowns();
/**
 * The one member that is a city rather than a town, if it is live. Read off
 * the configs so nothing here names a town, and dark until it launches.
 */
const city = live.find((t) => (t.population ?? 0) >= 100_000);
// Who runs it. Dark until an editor is configured; see EditorConfig for why
// the slot exists unfilled rather than carrying a plausible name. A value in
// brackets is a placeholder the owner has yet to fill, shown as written.
const editor = getNetworkHub().editor;
const photo = editor?.photo ? resolveSiteImage('hub', editor.photo) : undefined;
const corrections = getNetworkHub().correctionsEmail;
// Who is accountable: the organisation in the hub config, named here on the
// town pages and the hub's alike (owner's direction, 8 October 2026).
const publisher = getNetworkHub().publisher;
const siblings = live.filter((t) => t.slug !== site.slug);

// What the guide actually holds, which is the one thing an About page can say
// that no other site's About page can.
const allPlaces = await getTownEntries('places');
const places = allPlaces.filter(isOpen);
const allEvents = await getTownEntries('events');
/**
 * Listings, not occurrences, and one definition for every page that prints
 * a count (src/lib/event-totals.ts): a trivia night is one listing however
 * many weeks it runs, a canceled one is not a listing a reader can go to,
 * and the number says what it counts.
 */
const totals = eventTotals(allEvents);
// The guide's own account of who runs it, where the config carries one.
const who = site.kind === 'town' ? site.about : undefined;
const people = site.kind === 'town' ? await getTownEntries('profiles') : [];
// The most recent check on any listing: the one number that says the guide is
// being kept rather than published once and left.
const checks = [...allPlaces, ...allEvents].map((e) => e.data.verified).filter((d): d is Date => !!d);
const lastChecked = checks.length > 0 ? new Date(Math.max(...checks.map((d) => d.getTime()))) : null;
const panel = 'rounded-lg bg-raised p-6 ring-1 ring-line-soft';
const panelTitle = 'eyebrow border-b border-line-soft pb-3';
// A town's About page: the h1 names the guide, the <title> does not, because
// the site title is appended to every page's and "About Inside Lyons | Inside
// Lyons" said it twice (Longmont's read "About Longmont · Inside the Towns |
// Longmont · Inside the Towns"). Search-visibility phase 2, 15 October 2026.
---
{site.kind === 'town' ? (
  <Page title={`About ${site.siteTitle}`} seoTitle="About this guide" eyebrow="Independent, local" description={`What ${site.siteTitle} is, who runs it, and what it is not.`}>
    <FactStrip
      size="number"
      facts={[
        { label: 'Places listed', value: String(places.length) },
        { label: 'Upcoming listings', value: String(totals.listings) },
        { label: 'Sister towns', value: String(siblings.length) },
        ...(lastChecked ? [{ label: 'Last checked', value: formatShortDate(lastChecked) }] : []),
      ]}
      note={`${describeTotals(totals)}; ${totals.datesNextTwoWeeks} dates in the next two weeks. Each page says which it counts.`}
    />
    <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-16">
      <div class="prose">
        <p>
          {site.siteTitle} is an independent community and visitor guide to {site.name}, {site.state}: what’s on this
          week, where to eat and drink, where to walk, and what it’s like to live here.
        </p>
        {who && (
          <Fragment>
            <h2>Who runs it</h2>
            {who.photo && <Image src={resolveSiteImage('hub', who.photo)} alt={who.photoAlt ?? ''} width={320} height={320} class="not-prose size-32 rounded-full object-cover" />}
            {who.who.map((paragraph) => <p>{paragraph}</p>)}
          </Fragment>
        )}
        {editor && (
          <Fragment>
            <h2>Who runs it</h2>
            {photo && <Image src={photo} alt={editor.photoAlt ?? editor.name} width={320} height={320} class="not-prose size-32 rounded-full object-cover" />}
            <p>
              <strong>{editor.name}</strong>{editor.role ? `, ${editor.role}` : ', Editor'}.
              {' '}{editor.bio}
            </p>
            {(editor.email || editor.url) && (
              <p>
                {editor.email && <Fragment>Corrections and questions: <a href={`mailto:${editor.email}`}>{editor.email}</a>. </Fragment>}
                {editor.url && <Fragment><a href={editor.url} rel="me">More about {editor.name.split(' ')[0]}</a>.</Fragment>}
              </p>
            )}
          </Fragment>
        )}
        <h2>Independent, not official</h2>
        <p>
          {publisher && (
            <Fragment>
              {site.siteTitle} is published by <a href={publisher.url} rel="noopener">{publisher.name}</a>, which is
              accountable for everything on it; corrections reach it through the <a href="/contact/">contact page</a>.{' '}
            </Fragment>
          )}
          This site is not the town government, a chamber of commerce, or any public body, and it does not speak for
          them. Anything civic — notices, permits, meetings, services — belongs to the official sources listed
          alongside. Where a page explains it, the explanation is a summary written here from those sources and
          linked to them, and the official record controls wherever the two differ.
        </p>
        <h2>How the listings are made</h2>
        <p>
          Every place and every event is checked against the operator’s own page or a public calendar before it goes
          up, and carries the date it was last checked. Nothing is copied from a review site. Listings are free and
          editorial: nobody pays to be here, and nobody can pay to be higher up.
          The <a href="/editorial/">editorial policy</a> sets out the whole of it.
        </p>
        <h2>Corrections and listings</h2>
        <p>
          Spotted something wrong, or run a business or event here that should be listed?
          <a href="/contact/">Get in touch</a> — a correction takes a day or two. <TipsLink class="" />.
        </p>
        {site.kind === 'town' && (site.families || site.participation) && (
          <Fragment>
            <h2>The people behind {site.name}</h2>
            <p>
              {people.length > 0 ? (
                <Fragment>Short profiles of the people who run the shops, the programs and the volunteer hours are on the <a href="/people/">people page</a>, each from an interview or words they supplied and approved. </Fragment>
              ) : (
                <Fragment>Short profiles of business owners, volunteers, artists, coaches, longtime residents and the people running community programs are a part of this guide that publishes only from an interview or from words the subject supplies and approves; none is written from a search result, and none is up yet. </Fragment>
              )}
              Know someone who should be here, or are you one of them? <a href="/contact/">Write and say so</a>; a profile takes a conversation and your say on the words before it goes up.
            </p>
          </Fragment>
        )}
      </div>
      <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
        <div class={panel}>
          <p class={panelTitle}>Official sources</p>
          <ul class="mt-4 space-y-3 text-[0.9375rem] leading-snug">
            <li>
              <a href={site.officialLinks.townSite} rel="noopener" class="inline-block -my-1 py-1 font-semibold text-primary underline">
                {site.officialLinks.townSiteLabel ?? `The official ${site.name} site`} →
              </a>
            </li>
            {(site.officialLinks.also ?? []).map((g) => (
              <li>
                <a href={g.url} rel="noopener" class="inline-block -my-1 py-1 font-semibold text-primary underline">{g.label} →</a>
              </li>
            ))}
            {site.officialLinks.policeNonEmergency && (
              <li>
                <a href={site.officialLinks.policeNonEmergency} rel="noopener" class="inline-block -my-1 py-1 font-semibold text-primary underline">
                  {site.officialLinks.policeNonEmergencyLabel ?? `${site.name} police`} →
                </a>
                <span class="block text-ink-muted">Non-emergency contact. In an emergency, call 911.</span>
              </li>
            )}
          </ul>
        </div>
        {siblings.length > 0 && (
          <div class={panel}>
            <p class={panelTitle}>The rest of the network</p>
            {/* Names only, two to a row and A to Z: with a county line under
                each, eleven guides made the sidebar 400px taller than the page
                beside it. Their counties are on the hub. */}
            <ul class="mt-3 grid grid-cols-2 gap-x-4 text-[0.9375rem]">
              {[...siblings].sort((a, b) => a.name.localeCompare(b.name)).map((t) => (
                <li>
                  <a href={`https://${t.domain}/`} class="block py-1 font-semibold no-underline hover:text-primary hover:underline">{t.name}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
    <CtaBand
      slot="after"
      eyebrow={`Coming up in ${site.name}`}
      title="Start with what’s on"
      body={`${describeTotals(totals)} in ${site.name} right now, from markets and live music to town meetings.`}
      links={[
        { label: 'See the events', href: '/events/', primary: true },
        { label: 'Eat & drink', href: '/eat-drink/' },
      ]}
    />
  </Page>
) : (
  <Page title="About the network" eyebrow="Inside the Towns" description="What Inside the Towns is and how the guides are made.">
    <FactStrip
      size="number"
      facts={[
        { label: 'Guides live', value: String(live.length) },
        { label: 'Counties', value: String(countiesCovered(live).length) },
        { label: 'Population of the towns', value: live.reduce((n, t) => n + (t.population ?? 0), 0).toLocaleString('en-US') },
      ]}
      note="Population at the 2020 census, summed across the live guides: the towns' size, not a count of readers."
    />
    <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-16">
      <div class="prose">
        <p>
          Inside the Towns publishes independent community guides to Colorado towns, on the Front Range and in the
          mountains: a guide for each town, or for a few neighboring communities together, each with the week’s
          events, places to eat and drink, things to do outdoors, and a plain account of what it’s like to move there.
        </p>
        {city && (
          <p>
            One of them, {city.name}, is a city of {(Math.round((city.population ?? 0) / 10_000) * 10_000).toLocaleString('en-US')} rather than a
            town. It is here because it is the city the rest look to, and a network of guides to northern
            Colorado that left it out would have a hole in the middle.
          </p>
        )}
        <h2>Independent</h2>
        <p>
          None of the guides is a government site or a chamber of commerce. Each one links to the official town or
          county site for anything civic, and says so on every page.
        </p>
        <h2>How the listings are made</h2>
        <p>
          Every place and every event is checked against the operator’s own page or a public calendar before it goes
          up, and carries the date it was last checked. Listings are free and editorial; we don’t sell placement.
          The <a href="/editorial/">editorial policy</a> sets out the whole of it.
        </p>
        {editor && (
          <Fragment>
            <h2>Who runs it</h2>
            {photo && <Image src={photo} alt={editor.photoAlt ?? editor.name} width={320} height={320} class="not-prose size-32 rounded-full object-cover" />}
            <p>
              <strong>{editor.name}</strong>{editor.role ? `, ${editor.role}` : ', Editor'}.
              {' '}{editor.bio}
            </p>
            {(editor.email || editor.url) && (
              <p>
                {editor.email && <Fragment>Corrections and questions: <a href={`mailto:${editor.email}`}>{editor.email}</a>. </Fragment>}
                {editor.url && <Fragment><a href={editor.url} rel="me">More about {editor.name.split(' ')[0]}</a>.</Fragment>}
              </p>
            )}
          </Fragment>
        )}
        <h2>Who’s behind this</h2>
        <p>
          {publisher ? (
            <Fragment>{site.siteTitle} and every guide in the network are published by <a href={publisher.url} rel="noopener">{publisher.name}</a>, which is accountable for all of them.</Fragment>
          ) : (
            <Fragment>{site.siteTitle} is independently owned and published.</Fragment>
          )}
          {' '}It is not owned by, or answerable to, any town government, chamber of commerce or advertiser.
          What the guides say rests on checked sources, not on visits, unless a page says so in its own words; the{' '}
          <a href="/editorial/">editorial policy</a> sets out the whole of it.
          {corrections && <Fragment> Corrections and tips go to <a href={`mailto:${corrections}`}>{corrections}</a>. <TipsLink class="" />.</Fragment>}
        </p>
        <p>More towns are on the way. <a href="/contact/">Suggest one</a>.</p>
      </div>
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class={panel}>
          <p class={panelTitle}>Live guides</p>
          <ul class="mt-4 space-y-2.5 text-[0.9375rem]">
            {[...live].sort((a, b) => a.name.localeCompare(b.name)).map((t) => (
              <li>
                <a href={`https://${t.domain}/`} class="font-semibold no-underline hover:text-primary hover:underline">{t.siteTitle}</a>
                <span class="block text-ink-muted">{countyLabel(t)}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
    <CtaBand
      slot="after"
      eyebrow="Inside the Towns"
      title="Find your town"
      body="Each guide is written for the people who live there, with the week’s events, the places worth your time, and what it is really like to move in."
      links={[{ label: 'All the guides', href: '/', primary: true }, { label: 'Suggest a town', href: '/contact/' }]}
    />
  </Page>
)}
