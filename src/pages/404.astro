---
import Page from '@/layouts/Page.astro';
import { getSite, listsEvents } from '@/config';

const site = getSite();
const links =
  site.kind === 'town'
    ? [
        ...(listsEvents(site) ? [{ label: 'This weekend', href: '/this-weekend/' }, { label: 'Events', href: '/events/' }] : []),
        { label: 'Eat & drink', href: '/eat-drink/' },
        { label: 'Directory', href: '/directory/' },
        { label: 'Guides', href: '/guides/' },
      ]
    : [
        { label: 'This weekend', href: '/this-weekend/' },
        { label: 'The towns', href: '/#towns' },
        { label: 'Moving', href: '/moving/' },
      ];
---
<Page title="Page not found" eyebrow="404" intro="That page doesn’t exist or has moved." description="That page doesn’t exist or has moved. Start again from the home page." noindex narrow>
  {/* A way back in besides the home page: the main sections. Search is the masthead's Search button (one search box a page, 21 November 2026). */}
  <p class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-[0.9375rem]">
    <span class="eyebrow text-ink-muted">Or go to</span>
    {links.map((l) => <a href={l.href} class="-my-2 inline-block py-3 font-semibold text-primary underline">{l.label}</a>)}
  </p>
  <p class="mt-10"><a href="/" class="btn btn-outline text-primary">Back to the home page</a></p>
</Page>
