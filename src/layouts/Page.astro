---
/**
 * A standard interior page: eyebrow, title, optional intro, then content.
 */
import Base from './Base.astro';

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  intro?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
  /** Constrain the body to prose width. */
  narrow?: boolean;
}

const { title, eyebrow, intro, narrow = false, ...seo } = Astro.props;
---
<Base title={title} {...seo}>
  <div class="container-page pb-8 pt-10 md:pt-16">
    <header class="border-b border-line-soft pb-8 md:pb-10">
      <div class="max-w-3xl">
        {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
        <h1 class="display-md text-[2.75rem] md:text-6xl">{title}</h1>
        {intro && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted md:text-xl">{intro}</p>}
        <slot name="after-header" />
      </div>
    </header>
    <div class:list={['pt-10', narrow && 'max-w-2xl']}>
      <slot />
    </div>
  </div>
</Base>
