---
/**
 * A standard interior page: title block, optional intro, then content.
 */
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  intro?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
  /** Constrain the body to prose width. */
  narrow?: boolean;
}

const { title, intro, narrow = false, ...seo } = Astro.props;
---
<Base title={title} {...seo}>
  <div class="container-page py-10 md:py-14">
    <header class:list={['mb-8', narrow && 'max-w-2xl']}>
      <h1 class="text-4xl font-bold md:text-5xl">{title}</h1>
      {intro && <p class="mt-3 text-lg text-ink-muted">{intro}</p>}
    </header>
    <slot name="after-header" />
    <div class:list={[narrow && 'max-w-2xl']}>
      <slot />
    </div>
  </div>
</Base>
