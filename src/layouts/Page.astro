---
/**
 * A standard interior page: a masthead band carrying eyebrow, title and
 * intro, then the content on paper.
 *
 * The band is what keeps the site from opening on plain paper on all four
 * hundred interior pages. It is white, under a rule in the town's accent: the
 * guide allows only the two papers and white as surfaces, and the eyebrow in
 * the primary sits on it, which Golden's primary can do on white (5.07:1) and
 * on its paper (4.66:1) but not on anything darker.
 *
 * Compact since 26 October 2026 (the audit, priority 7: the results began
 * below the first screen on a phone): the band's padding 1.5rem (2.25rem
 * from md), the title 2.25rem (3rem from md), the intro at reading size,
 * and the content 2rem under it.
 */
import Base from './Base.astro';

interface Props {
  title: string;
  /** Title for <title> and social cards when the h1 alone would be ambiguous. */
  seoTitle?: string;
  eyebrow?: string;
  /** "Canceled", "Permanently closed": a dark pill ahead of the eyebrow, so the
      masthead does not read like an ordinary listing's. */
  status?: string;
  description?: string;
  intro?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
  /** Constrain the body to prose width. */
  narrow?: boolean;
  /** What the page is, for search results: "Event", "Place", "Guide". */
  kind?: string;
}

const { title, seoTitle, eyebrow, status, intro, narrow = false, ...seo } = Astro.props;
---
<Base title={seoTitle ?? title} {...seo}>
  <header class="border-b-2 border-accent bg-raised">
    <div class="container-page py-6 md:py-9">
      <div class="max-w-3xl">
        {(eyebrow || status) && (
          <p class="eyebrow mb-3 flex flex-wrap items-center gap-x-2 gap-y-1">
            {status && <span class="rounded-full bg-ink px-2.5 py-0.5 text-[0.75rem] text-raised">{status}</span>}
            {eyebrow}
          </p>
        )}
        <h1 class="display-md text-[2.25rem] md:text-5xl">{title}</h1>
        {intro && <p class="mt-3 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-muted md:text-lg">{intro}</p>}
        <slot name="after-header" />
      </div>
    </div>
  </header>
  <div class="container-page pb-8 pt-8 md:pt-10">
    <div class:list={[narrow && 'max-w-2xl']}>
      <slot />
    </div>
  </div>
  {/* After the page's container, full bleed: the closing CtaBand. Inside a
      narrow body it broke its own two columns (thanks, message-sent). */}
  <slot name="after" />
</Base>
