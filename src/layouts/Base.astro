---
/**
 * The document shell for every page on every site. Design tokens from the
 * town config are set as CSS variables on <html>; see styles/global.css.
 */
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/instrument-sans/index.css';
import '@fontsource-variable/instrument-sans/wght-italic.css';
import '@/styles/global.css';
/*
 * The two Latin faces the top of every page is set in, as URLs so they can be
 * preloaded. Fontsource's stylesheet declares them with font-display: swap, so
 * without this the browser only discovers the files after the CSS has parsed,
 * paints the page in a fallback and then reflows when they arrive — worth
 * 0.14 of cumulative layout shift on a town home page, most of it under the
 * large date numerals in the events list.
 *
 * Only these two subsets: latin-ext, Vietnamese and the italic are real files
 * too, but nothing above the fold uses them, and preloading a font that is not
 * needed costs exactly what preloading one that is saves.
 */
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import instrumentLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import Analytics from '@vercel/analytics/astro';
import { getNetworkHub, getSite, listsEvents, plausibleDomain, type FullSection } from '@/config';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Freshness from '@/components/Freshness.astro';
import Plausible from '@/components/Plausible.astro';
import TrackClicks from '@/components/TrackClicks.astro';
import HeroWarm from '@/components/HeroWarm.astro';
import SEO from '@/components/SEO.astro';
import { siteJsonLd } from '@/lib/seo';
import { searchType } from '@/lib/network-search';
import { verificationTags } from '@/lib/verification';
import { categoryCss, paletteVars } from '@/config/palette';
import { pagePath } from '@/lib/section';

interface Props {
  title?: string;
  /** The whole <title>, as it is (SEO.astro). */
  fullTitle?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
  /** What the page is, for the site search's result list: "Event", "Place", "Guide". */
  kind?: string;
  /**
   * The fonts to preload, where a page is set in other faces than the
   * network's. Every page preloads the two below; since the publication
   * redesign of 14 November 2026 the hub's home is in them too.
   */
  preload?: string[];
  /** A class on <body>, for a page with a stylesheet of its own. */
  bodyClass?: string;
  /**
   * A full section's masthead in place of the site's: a hub page under
   * /<town>/ that belongs to that section, its tradition pages
   * (fullSectionAt, src/config/index.ts; the owner's navigation brief of 18
   * November 2026). Only the masthead changes: the page is the hub's.
   */
  masthead?: FullSection;
  /** A hub town page: the town bar's trail, the town and the group it sits in (Header.astro). */
  townBar?: { name: string; region: string; slug?: string };
}

const site = getSite();
const analytics = getNetworkHub().analytics === true;
// The site Plausible counts this page under: the hub's domain on every hub and section page, a guide's own on a guide that has it (src/config/index.ts).
const plausible = plausibleDomain(site);
const { jsonLd, kind, preload = [frauncesLatin, instrumentLatin], bodyClass, masthead, townBar, ...props } = Astro.props;
/**
 * The column the header bars and the footer sit on: the page's own, so their left edges line up with
 * the page's (the live check of 20 November 2026). The hub's home and its town pages are drawn on the
 * 1200px column (HUB_COLUMN); every other page, a guide's and the hub's Page.astro pages, on container-page.
 */
// Between phone and desktop those two pages read in a 720px column (src/routes/hub/index.astro, `wide`), so the bars do too.
const column = site.kind === 'hub' && (pagePath(Astro.url) === '/' || !!townBar) ? 'mx-auto w-full max-w-[760px] px-[20px] desk:max-w-[1200px] desk:px-[40px]' : 'container-page';
// A town that has not launched serves a holding page; nothing on it, nor the
// shared pages around it, should be indexed before the guide exists.
const seo = site.kind === 'town' && site.status !== 'live' ? { ...props, noindex: true } : props;
// Site search (src/pages/search.astro) indexes what is inside <main> on every
// page that is not noindex; the header, footer and signup box are the same
// on every page and would match every query.
const searchable = !seo.noindex;
// The publisher graph belongs on every page; pages add their own on top.
const structured = [siteJsonLd(site), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
// Search Console and Bing verification, from the Vercel project's environment
// (src/lib/verification.ts; docs/SEARCH-VISIBILITY.md). Nothing unless set.
// From the build's own environment, where Vercel puts the project's
// variables: Astro's import.meta.env carries only the variables it knows
// of, so a token set in Vercel never reached the page this way (found 25
// October 2026, when the signup's key switch met the same wall).
const verification = verificationTags(process.env);
const cssVars = paletteVars(site.colors);
---
<!doctype html>
<html lang="en" style={cssVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    {preload.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <SEO {...seo} jsonLd={structured} />
    {verification.map((tag) => <meta name={tag.name} content={tag.content} />)}
    {/* ?v= busts the week-long /favicons/ cache in vercel.json; bump it when the marks change. */}
    <link rel="icon" href={`/favicons/${site.slug}/favicon.svg?v=7`} type="image/svg+xml" />
    {/* Asked for by name regardless of what the page links; see src/lib/icons.ts. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#36536B" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Discovery: an aggregator that lands on any page finds the feeds. */}
    {listsEvents(site) && <link rel="alternate" type="application/rss+xml" title={`${site.siteTitle} — what’s on`} href="/events.rss" />}
    {site.kind === 'town' && (
      <link rel="alternate" type="application/rss+xml" title={`${site.siteTitle} — guides`} href="/rss.xml" />
    )}
    {/* One definition of the category hues, from src/config/palette.ts. */}
    <style is:inline set:html={categoryCss()}></style>
  </head>
  <body class={bodyClass}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-raised focus:px-4 focus:py-2">
      Skip to content
    </a>
    {/* A page may draw its own masthead and footer (the hub's home); every other page has the site's. */}
    {Astro.slots.has('header') ? <slot name="header" /> : <Header section={masthead} {townBar} {column} />}
    {/* The kind labels a result ("Place · Niwot"); the filter puts it under the search page's type buttons (src/lib/network-search.ts). */}
    <main id="main" class="flex-1" data-pagefind-body={searchable ? '' : undefined} data-pagefind-meta={searchable && kind ? `kind:${kind}` : undefined} data-pagefind-filter={searchable && searchType(kind) ? `type:${searchType(kind)}` : undefined}>
      <slot />
    </main>
    {Astro.slots.has('footer') ? <slot name="footer" /> : <Footer {column} />}
    <Freshness />
    {analytics && <Analytics />}
    {plausible && <Plausible domain={plausible} />}
    <TrackClicks />
    {/* The hub's town pages open with their photograph in the cache (src/components/HeroWarm.astro). */}
    {site.kind === 'hub' && <HeroWarm />}
  </body>
</html>
