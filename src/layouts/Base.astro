---
/**
 * The document shell for every page on every site. Design tokens from the
 * town config are set as CSS variables on <html>; see styles/global.css.
 */
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/instrument-sans/index.css';
import '@fontsource-variable/instrument-sans/wght-italic.css';
import '@/styles/global.css';
/*
 * The two Latin faces the top of every page is set in, as URLs so they can be
 * preloaded. Fontsource's stylesheet declares them with font-display: swap, so
 * without this the browser only discovers the files after the CSS has parsed,
 * paints the page in a fallback and then reflows when they arrive — worth
 * 0.14 of cumulative layout shift on a town home page, most of it under the
 * large date numerals in the events list.
 *
 * Only these two subsets: latin-ext, Vietnamese and the italic are real files
 * too, but nothing above the fold uses them, and preloading a font that is not
 * needed costs exactly what preloading one that is saves.
 */
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import instrumentLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import Analytics from '@vercel/analytics/astro';
import { getNetworkHub, getSite } from '@/config';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Freshness from '@/components/Freshness.astro';
import SEO from '@/components/SEO.astro';
import { siteJsonLd } from '@/lib/seo';
import { categoryCss } from '@/config/palette';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
}

const site = getSite();
const analytics = getNetworkHub().analytics === true;
const { jsonLd, ...seo } = Astro.props;
// The publisher graph belongs on every page; pages add their own on top.
const structured = [siteJsonLd(site), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
const cssVars = [
  `--town-accent:${site.colors.accent}`,
  `--town-accent-dark:${site.colors.accentDark}`,
  `--town-neutral-bg:${site.colors.neutralBg}`,
].join(';');
---
<!doctype html>
<html lang="en" style={cssVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" as="font" type="font/woff2" href={frauncesLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={instrumentLatin} crossorigin />
    <SEO {...seo} jsonLd={structured} />
    <link rel="icon" href={`/favicons/${site.slug}/favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content={site.colors.accentDark} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Discovery: an aggregator that lands on any page finds the feeds. */}
    <link rel="alternate" type="application/rss+xml" title={`${site.siteTitle} — what’s on`} href="/events.rss" />
    {site.kind === 'town' && (
      <link rel="alternate" type="application/rss+xml" title={`${site.siteTitle} — guides`} href="/rss.xml" />
    )}
    {/* One definition of the category hues, from src/config/palette.ts. */}
    <style is:inline set:html={categoryCss()}></style>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-raised focus:px-4 focus:py-2">
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Freshness />
    {analytics && <Analytics />}
  </body>
</html>
