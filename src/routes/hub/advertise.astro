---
import Page from '@/layouts/Page.astro';
import { getHub, liveTowns } from '@/config';

const hub = getHub();
const live = liveTowns();
---
<Page title="Advertise & partner" eyebrow="Work with us" description="Reach residents and visitors of Colorado Front Range towns through Inside the Towns." narrow>
  <div class="prose">
    <p>
      Inside the Towns reaches people who live in, visit, or are about to move to the small towns of the northern
      Front Range. Placements are clearly labelled and never mixed into editorial listings.
    </p>
    <h2>What’s available</h2>
    <ul>
      <li>A labelled “presented by” slot on a town’s events page</li>
      <li>A sponsor block on a town’s Moving Here page — agents, lenders, movers</li>
      <li>Network-wide sponsorship across {live.length === 1 ? 'the live guide' : `all ${live.length} live guides`}</li>
    </ul>
    <h2>What isn’t</h2>
    <p>
      Placement in the listings. Every guide tells its readers that nobody pays to be listed and nobody can pay to be
      higher up, and that is worth more to both of us than a featured slot would be. Sponsorship sits beside the
      editorial, labelled as sponsorship, and never inside it.
    </p>
    <p>
      Rates, audience numbers and a current media kit are available on request. We keep placements to a small number
      per town so they don’t compete with each other.
    </p>
    <p><a href={`mailto:${hub.social.email}?subject=${encodeURIComponent('Advertising enquiry')}`}>Email {hub.social.email}</a></p>
  </div>
</Page>
