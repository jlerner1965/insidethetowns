---
/**
 * /colorados-secret-trails/ on the hub: the series page for Colorado's
 * Secret Trails (the owner, 19 November 2026). Plain and static: a line
 * about the series, then each issue with its link, added here by hand.
 * Not in the menu; the home's block and each issue link here.
 */
import Page from '@/layouts/Page.astro';
import { pub } from '@/components/hub/pub';
---
<Page
  title="Colorado’s Secret Trails"
  description="Colorado’s Secret Trails, from Inside the Towns: one trail an issue, with the official maps, how to get there, when it’s open and the nearest town."
  intro="One trail an issue: the official maps, how to get there, when it’s open and the nearest town, each fact checked against the land manager’s own pages."
  narrow
>
  <section aria-labelledby="issues-h">
    <h2 id="issues-h" class="sr-only">Issues</h2>
    <article class:list={['py-4', pub.rule]}>
      <p class={pub.meta}>Issue 1 · November 19, 2026</p>
      <h3 class:list={[pub.title, 'mt-1']}><a href="/articles/bent-rock-trail-red-mountain-open-space/" class={pub.titleLink}>Bent Rock Trail at Red Mountain Open Space</a></h3>
      <p class:list={['mt-1', pub.t]}>Nearest town: Wellington</p>
    </article>
  </section>

  <p class:list={['mt-8', pub.t]}>Past trails will be listed here by nearest town.</p>
</Page>
