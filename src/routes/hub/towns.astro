---
/**
 * /towns/ on the hub: every town page in one list, A to Z, with the seven
 * guides first and the season pages after. The home page groups the towns
 * by where they are; this is the plain index, one link to each page, so
 * that every town page is one click from every page of the hub (the
 * footer links here) and a crawler finds them all in one place. Built from
 * the same lists the home page reads: liveTowns() for the guides and
 * publishedHubTowns() for the town pages, so a town reaches this page the
 * day it reaches its own.
 */
import Page from '@/layouts/Page.astro';
import { getHub, liveTowns } from '@/config';
import { hubCountyLine } from '@/config/hub-towns';
import { getTraditions } from '@/lib/content';
import { dayKey } from '@/lib/dates';
import { publishedHubTowns } from '@/lib/hub-towns';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';
import { TRADITION_TYPES, TRADITION_TYPE_INFO, seasonRows } from '@/lib/traditions';

const hub = getHub();
const records = await getTraditions();
const today = dayKey(new Date());
const guides = liveTowns();
const pages = [...publishedHubTowns(records)].sort((a, b) => a.name.localeCompare(b.name));
const seasons = TRADITION_TYPES.filter((t) => seasonRows(records, t, today).length > 0);
const path = '/towns/';
const description = `Every Colorado town on ${hub.siteTitle}, A to Z: ${guides.length} full guides and ${pages.length} town pages with each town’s annual events and outdoor dates.`;
const structured = [
  collectionPageJsonLd(hub, {
    name: 'Every town, A to Z',
    description,
    path,
    items: [...guides.map((g) => ({ name: g.siteTitle, url: `https://${g.domain}/` })), ...pages.map((t) => ({ name: t.name, url: `https://${hub.domain}/${t.slug}/` }))],
  }),
  breadcrumbJsonLd(hub, [
    { name: hub.siteTitle, path: '/' },
    { name: 'Every town', path },
  ]),
];
const h2 = 'mb-5 border-b-2 border-accent pb-3 text-2xl font-medium';
const link = 'font-semibold text-primary underline';
---
<Page title="Every town, A to Z" seoTitle="Colorado towns A to Z: guides and town pages" eyebrow="Colorado" {description} intro={`${guides.length} guides and ${pages.length} town pages, each one link.`} jsonLd={structured}>
  <section aria-labelledby="guides-heading" class="mb-12">
    <h2 id="guides-heading" class={h2}>The guides</h2>
    <p class="mb-4 max-w-2xl text-[0.9375rem] text-ink-muted">A guide is a whole site for one town: the week’s events, places to eat, trails and services.</p>
    <ul class="grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3" data-index="guides">
      {guides.map((g) => (
        <li><a href={`https://${g.domain}/`} class={link}>{g.siteTitle}</a> <span class="text-[0.875rem] text-ink-muted">{g.domain}</span></li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="pages-heading" class="mb-12">
    <h2 id="pages-heading" class={h2}>Town pages</h2>
    <p class="mb-4 max-w-2xl text-[0.9375rem] text-ink-muted">A town page lists the town’s annual events and the outdoor dates around it, each with the page it was read from.</p>
    <ul class="grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3" data-index="town-pages">
      {pages.map((t) => (
        <li><a href={`/${t.slug}/`} class={link}>{t.name}</a> <span class="text-[0.875rem] text-ink-muted">{hubCountyLine(t)}</span></li>
      ))}
    </ul>
  </section>

  {seasons.length > 0 && (
    <section aria-labelledby="seasons-heading" class="mb-12">
      <h2 id="seasons-heading" class={h2}>Dates across the towns</h2>
      <ul class="grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3" data-index="seasons">
        {seasons.map((t) => (
          <li><a href={TRADITION_TYPE_INFO[t].path} class={link}>{TRADITION_TYPE_INFO[t].plural}</a></li>
        ))}
      </ul>
    </section>
  )}
</Page>
