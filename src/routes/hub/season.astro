---
/**
 * The hub's season page for one kind of tradition: /parades-of-lights/,
 * /tree-lightings/ (src/lib/traditions.ts). Permanent addresses with no
 * year in them; the season and year are in the eyebrow and the title, and
 * change when CURRENT_SEASONS does.
 *
 * Top to bottom: the eyebrow ("Colorado · winter 2026"), the title, one
 * line of counts from the records, "Find your town", the pills to the
 * other season pages, the rows A to Z by town, and the correction line.
 * A row for a town with a guide links to that guide's /traditions/; any
 * other links to the organizer's own page.
 *
 * The town filter is the page's only script, and the field is hidden until
 * it runs: without it the page is the whole list, which is complete.
 *
 * One file at several fixed paths (src/integrations/town-routes.ts,
 * seasonRoutes), reading its type off its own URL, as the place-type pages do.
 */
import Page from '@/layouts/Page.astro';
import TraditionRow from '@/components/TraditionRow.astro';
import DateCorrection from '@/components/DateCorrection.astro';
import CalendarSubscribe from '@/components/CalendarSubscribe.astro';
import { findTown, getHub } from '@/config';
import { STANDALONE_GUIDES, findHubTown } from '@/config/hub-towns';
import { eventPage, eventPath, homeOf, placeKey, publishedHubTowns, showings, type ShowingContext } from '@/lib/hub-towns';
import { getTraditions } from '@/lib/content';
import { dayKey } from '@/lib/dates';
import { breadcrumbJsonLd, collectionPageJsonLd, traditionEventJsonLd } from '@/lib/seo';
import { CURRENT_SEASONS, TRADITION_TYPES, TRADITION_TYPE_INFO, rowsByState, seasonCounts, seasonRows, type TraditionType } from '@/lib/traditions';
import { googleCalendarUrl } from '@/lib/ics';
import { traditionCalendarEvent } from '@/lib/tradition-calendar';

const hub = getHub();
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const type = TRADITION_TYPES.find((t) => TRADITION_TYPE_INFO[t].path === path);
if (!type) throw new Error(`season.astro was built at ${path}, which is no tradition type's page (src/lib/traditions.ts).`);
const info = TRADITION_TYPE_INFO[type];
const season = CURRENT_SEASONS[type]!;
const today = dayKey(new Date());
const records = await getTraditions();
const rows = seasonRows(records, type, today);
const counts = seasonCounts(rows);
const published = publishedHubTowns(records);
const ctx: ShowingContext = {
  hubDomain: hub.domain,
  published: new Set(published.map((t) => t.slug)),
  guideDomain: (key) => findTown(STANDALONE_GUIDES[key]?.guide ?? '')?.domain,
  guideName: (key) => findTown(STANDALONE_GUIDES[key]?.guide ?? '')?.siteTitle ?? key,
};
/** Every other place the record shows: the town pages and the guides. */
const alsoFor = (row: (typeof rows)[number]) => showings(row.record, ctx).filter((s) => s.key !== 'season');
/** A shared record's eyebrow: the towns it names, or that it is statewide. */
const townLabel = (row: (typeof rows)[number]): string | undefined => {
  if (row.record.town) return undefined;
  if (row.record.statewide) return 'Statewide';
  const names = (row.record.towns ?? []).map((t) => {
    const key = placeKey(t.slug);
    return key ? findHubTown(key)?.name ?? findTown(STANDALONE_GUIDES[key]?.guide ?? '')?.name : undefined;
  });
  return names.filter(Boolean).join(', ');
};

/** The other season pages that are built: the types with a season and a row for it. */
const pages = TRADITION_TYPES.filter((t: TraditionType) => seasonRows(records, t, today).length > 0);

/** The name links to the record's home: its own page on the hub where it has one (13 November 2026), else its town's page or guide, else the source. */
const hrefFor = (row: (typeof rows)[number]): string => {
  const own = eventPath(row.record, ctx.published);
  if (own) return `https://${hub.domain}${own}`;
  const home = homeOf(row.record);
  return (home && alsoFor(row).find((s) => s.key === home)?.href) || row.source;
};
const dated = season.year !== undefined;
const when = dated ? `${season.season} ${season.year}` : season.season;

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;


const title = dated ? `${info.plural}, town by town` : `${info.plural} in Colorado`;
const seoTitle = `${info.plural} in Colorado, ${when}`;
const agency = type === 'outdoor' || type === 'free-day';
const description = dated
  ? `Colorado ${info.plural.toLowerCase()} for ${when}, town by town: the date each organizer has published, or that it has not yet, with the page it was read from.`
  : type === 'outdoor'
    ? `Colorado ${info.plural.toLowerCase()} ${when}: road and pass openings, park entry seasons, campgrounds, ski areas and licence windows, each with the date its agency has published, or that it has not yet.`
    : type === 'free-day'
      ? 'Free-admission days in Colorado: state parks, national parks and public lands, and museums, each a dated day read on the agency’s or the museum’s own page. A day that has passed drops off.'
      : `${info.plural} in Colorado, town by town: the next date each organizer has published, or that it has not yet and when it was last held, with the page it was read from.`;
const pageUrl = `https://${hub.domain}${path}`;
const structured = [
  breadcrumbJsonLd(hub, [
    { name: hub.siteTitle, path: '/' },
    { name: 'Annual events', path: '/towns/' },
    { name: info.plural, path },
  ]),
  collectionPageJsonLd(hub, {
    name: seoTitle,
    description,
    path,
    items: rows.map((r) => ({ name: r.record.town ? `${r.record.name} — ${r.record.town.name}` : r.record.name, url: hrefFor(r) })),
  }),
  // Never an Event for a date that has passed.
  // An event is marked up on one page: here only where it has no page of its own (eventPage).
  ...rows.map((r) => (r.past || eventPage(r.record, ctx) !== 'season' ? undefined : traditionEventJsonLd(r.record, r.entry, pageUrl))).filter((e) => !!e),
];
const subject = `[Correction] ${info.plural}, ${when}`;
const mailto = `mailto:${hub.correctionsEmail ?? hub.social.email}?subject=${encodeURIComponent(subject)}`;
/**
 * The page in four groups, one state each (src/lib/traditions.ts,
 * rowState): the dates still to come, soonest first; the ones not
 * announced yet; the ones canceled this season; and the ones already held.
 * A canceled row is never with the dates to come or the ones awaiting a
 * date (the audit of 13 November 2026: Wellington's canceled parade sat
 * under "Not announced yet"); it has a group of its own, with its pill.
 */
const byDate = (a: (typeof rows)[number], b: (typeof rows)[number]) =>
  (a.entry.date ?? '9999').localeCompare(b.entry.date ?? '9999') || (a.record.town?.name ?? '').localeCompare(b.record.town?.name ?? '') || a.record.name.localeCompare(b.record.name);
const byTown = (a: (typeof rows)[number], b: (typeof rows)[number]) => (a.record.town?.name ?? a.record.name).localeCompare(b.record.town?.name ?? b.record.name) || a.record.name.localeCompare(b.record.name);
const states = rowsByState(rows);
const upcoming = states.upcoming.sort(byDate);
// A free-admission day that has passed drops off the page (the brief of 12 November 2026).
const gone = states.past.sort((a, b) => byDate(b, a));
const waiting = states.waiting;
const canceled = states.canceled.sort(byTown);
const shown = upcoming.length + waiting.length + canceled.length + gone.length;
/**
 * A group of more than this many rows with no date to come is folded under
 * its heading, the dates to come staying open above it: /outdoor-dates/ ran
 * to about 61 phone screens, 85 of its 123 rows with nothing coming up (the
 * owner's hub review, 13 November 2026). Every row is still on the page.
 */
const FOLD_AFTER = 12;
const summary = 'flex min-h-12 cursor-pointer list-none items-center rounded-lg bg-raised px-5 py-3 text-[0.9375rem] font-semibold text-primary ring-1 ring-line-soft sm:px-7 [&::-webkit-details-marker]:hidden';
/** "Add to calendar" for a date still ahead: the entry's file on this site, and the same entry as a Google link. */
const calendarFor = (row: (typeof rows)[number]) => {
  const event = traditionCalendarEvent(row, { domain: hub.domain, pageUrl });
  return event ? { ics: `/dates/${row.record.slug}.ics`, google: googleCalendarUrl(event) } : undefined;
};
const rowProps = (row: (typeof rows)[number]) => ({ row, eyebrow: 'town' as const, href: hrefFor(row), townLabel: townLabel(row), also: alsoFor(row) });
const sortButton =
  'inline-flex min-h-11 items-center rounded-full border border-primary-line bg-raised px-4 text-sm font-medium text-ink-muted transition-colors hover:border-primary hover:text-primary aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-white';
const pill =
  'inline-flex min-h-11 items-center rounded-full border border-primary-line bg-raised px-4 text-sm font-medium text-ink-muted no-underline transition-colors hover:border-primary hover:text-primary aria-[current=page]:border-primary aria-[current=page]:bg-primary aria-[current=page]:text-white';
---
<Page title={title} {seoTitle} eyebrow={`Colorado · ${when}`} {description} jsonLd={structured} kind="Seasonal dates">
  {/* The count line, with the number of dates still to come in a span the
      page corrects for the reader's own day (DateCorrection). */}
  <p slot="after-header" class="mt-3 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-muted md:text-lg" data-count-line>
    {dated ? (
      <Fragment>{plural(counts.towns, 'town', 'towns')} listed · <span data-date-count="dates">{plural(counts.confirmed, 'date', 'dates')}</span> confirmed</Fragment>
    ) : (
      <Fragment>{plural(shown, agency ? 'date' : 'event', agency ? 'dates' : 'events')} listed · <span data-date-count="ahead">{counts.confirmed}</span> with a date ahead</Fragment>
    )}
  </p>
  <div data-town-filter hidden class="mb-5 max-w-sm">
    <label for="town-filter" class="block text-sm font-semibold">Find your town</label>
    <input
      id="town-filter"
      type="search"
      autocomplete="off"
      class="mt-1.5 block w-full rounded-md border border-field-line bg-raised px-3 py-2.5 text-[1.0625rem]"
      data-town-filter-input
    />
    <p class="sr-only" role="status" data-town-filter-status></p>
  </div>

  {pages.length > 1 && (
    <nav aria-label="Other traditions this season" class="mb-10 flex flex-wrap gap-2">
      {pages.map((t) => (
        <a href={TRADITION_TYPE_INFO[t].path} aria-current={t === type ? 'page' : undefined} class={pill}>{TRADITION_TYPE_INFO[t].plural}</a>
      ))}
    </nav>
  )}

  <CalendarSubscribe name={info.path.replace(/\//g, '')} what={dated ? `every date on this page` : 'these dates'} class="mb-8" />

  <section aria-labelledby="rows-heading" class="mb-12" data-season-group="upcoming" data-drop-past={type === 'free-day' ? '' : undefined}>
    <div class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-3 border-b border-line-soft pb-3">
      <h2 id="rows-heading" class="text-2xl font-medium">Dates to come</h2>
      {upcoming.length > 1 && (
        <div role="group" aria-label="Order the dates to come" class="flex flex-wrap gap-2" data-season-sort hidden>
          <button type="button" class={sortButton} aria-pressed="true" data-sort="date">Soonest first</button>
          <button type="button" class={sortButton} aria-pressed="false" data-sort="town">A to Z by town</button>
        </div>
      )}
    </div>
    {upcoming.length > 0 ? (
      <div class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7" data-town-rows data-sortable>
        {upcoming.map((row) => <TraditionRow {...rowProps(row)} calendar={calendarFor(row)} />)}
      </div>
    ) : (
      <p class="rounded-lg border border-dashed border-line px-6 py-8 text-center text-ink-muted">No date still to come has been published yet.</p>
    )}
  </section>

  {waiting.length > 0 && (
    <section aria-labelledby="waiting-heading" class="mb-12" data-season-group="waiting">
      <h2 id="waiting-heading" class="mb-6 border-b border-line-soft pb-3 text-2xl font-medium">Not announced yet</h2>
      {waiting.length > FOLD_AFTER ? (
        <details class="group/fold" data-season-fold>
          <summary class={summary}><span class="group-open/fold:hidden">Show all {waiting.length}</span><span class="hidden group-open/fold:inline">Hide them</span></summary>
          <div class="mt-4 rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7" data-town-rows>
            {waiting.map((row) => <TraditionRow {...rowProps(row)} />)}
          </div>
        </details>
      ) : (
        <div class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7" data-town-rows>
          {waiting.map((row) => <TraditionRow {...rowProps(row)} />)}
        </div>
      )}
    </section>
  )}

  {canceled.length > 0 && (
    <section aria-labelledby="canceled-heading" class="mb-12" data-season-group="canceled">
      <h2 id="canceled-heading" class="mb-2 border-b border-line-soft pb-3 text-2xl font-medium">{dated ? 'Canceled this season' : 'Canceled'}</h2>
      <p class="mb-6 text-[0.9375rem] text-ink-muted">Called off, as the organizer’s own page says.</p>
      <div class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7" data-town-rows>
        {canceled.map((row) => <TraditionRow {...rowProps(row)} />)}
      </div>
    </section>
  )}

  {gone.length > 0 && (
    <section aria-labelledby="gone-heading" class="mb-12" data-season-group="past">
      <h2 id="gone-heading" class="mb-6 border-b border-line-soft pb-3 text-2xl font-medium">{dated ? 'Already held this season' : agency ? 'Passed; the next date is not announced' : 'Held; the next date is not announced'}</h2>
      {gone.length > FOLD_AFTER ? (
        <details class="group/fold" data-season-fold>
          <summary class={summary}><span class="group-open/fold:hidden">Show all {gone.length}</span><span class="hidden group-open/fold:inline">Hide them</span></summary>
          <div class="mt-4 rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7" data-town-rows>
            {gone.map((row) => <TraditionRow {...rowProps(row)} />)}
          </div>
        </details>
      ) : (
        <div class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7" data-town-rows>
          {gone.map((row) => <TraditionRow {...rowProps(row)} />)}
        </div>
      )}
    </section>
  )}

  <p data-town-filter-empty hidden class="mt-6 rounded-lg border border-dashed border-line px-6 py-10 text-center text-ink-muted">
    No town by that name on this page yet.
  </p>

  <p class="mt-12 rounded-lg border border-highlight bg-highlight-soft px-5 py-4 text-[0.9375rem] leading-relaxed text-ink">
    Town missing, or a date wrong? <a href={mailto} class="font-semibold underline">Tell us</a>. Every date links to the page it was read from.
  </p>
  <DateCorrection />
</Page>

<script>
  // A free-admission day that has passed since the build drops off for the reader's own Denver day.
  const drop = document.querySelector<HTMLElement>('[data-drop-past]');
  if (drop) {
    const today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Denver' });
    for (const row of drop.querySelectorAll<HTMLElement>('[data-tradition-row][data-ends]')) if ((row.dataset.ends ?? '') < today) row.hidden = true;
  }
</script>

<script>
  /*
   * "Find your town": hides the rows whose town does not contain what the
   * reader types. The page's only script; the field stays hidden without it.
   */
  const box = document.querySelector<HTMLElement>('[data-town-filter]');
  const input = document.querySelector<HTMLInputElement>('[data-town-filter-input]');
  const status = document.querySelector<HTMLElement>('[data-town-filter-status]');
  const empty = document.querySelector<HTMLElement>('[data-town-filter-empty]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-tradition-row]')];
  if (box && input) {
    box.hidden = false;
    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();
    input.addEventListener('input', () => {
      const q = norm(input.value);
      let shown = 0;
      for (const row of rows) {
        const match = !q || norm(row.dataset.town ?? '').includes(q);
        row.hidden = !match;
        if (match) shown++;
      }
      if (empty) empty.hidden = shown > 0;
      if (status) status.textContent = q ? `${shown} of ${rows.length} shown` : '';
    });
  }
</script>

<script>
  /*
   * The order of "Dates to come": soonest first, as built, or A to Z by
   * town. The buttons stay hidden without the script, and the order is
   * the rows' own, so nothing is lost.
   */
  const group = document.querySelector<HTMLElement>('[data-season-sort]');
  const list = document.querySelector<HTMLElement>('[data-sortable]');
  if (group && list) {
    group.hidden = false;
    const built = [...list.querySelectorAll<HTMLElement>(':scope > [data-tradition-row]')];
    const name = (row: HTMLElement) => `${row.dataset.town ?? ''} ${row.querySelector('h3')?.textContent ?? ''}`.trim().toLowerCase();
    for (const button of group.querySelectorAll<HTMLButtonElement>('button[data-sort]')) {
      button.addEventListener('click', () => {
        const rows = button.dataset.sort === 'town' ? [...built].sort((a, b) => name(a).localeCompare(name(b))) : built;
        for (const row of rows) list.append(row);
        for (const other of group.querySelectorAll('button[data-sort]')) other.setAttribute('aria-pressed', String(other === button));
      });
    }
  }
</script>

<script>
  // A link to a row inside a folded group (another page's "Also on") opens
  // the fold and brings the row into view, on load and on every hash change,
  // as the town pages' statewide fold does (src/routes/hub/town.astro); and a
  // town typed in the filter opens the folds, so a match is never hidden.
  const reveal = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    const fold = target?.closest('details');
    if (target && fold && !fold.open) {
      fold.open = true;
      target.scrollIntoView();
    }
  };
  reveal();
  window.addEventListener('hashchange', reveal);
  document.querySelector<HTMLInputElement>('[data-town-filter-input]')?.addEventListener('input', (e) => {
    if ((e.target as HTMLInputElement).value.trim()) for (const fold of document.querySelectorAll<HTMLDetailsElement>('[data-season-fold]')) fold.open = true;
  });
</script>
