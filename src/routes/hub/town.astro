---
/**
 * A town's page on the hub: /<town>/ (the restructure of 12 November 2026;
 * src/config/hub-towns.ts, src/lib/hub-towns.ts). Dates only: the town's
 * traditions and its outdoor dates, every row from one record with the
 * page it was read from and the day it was read. No listings, no weekly
 * events.
 *
 * Top to bottom, phone first: the county and the town's name, Traditions,
 * Outdoor dates (the town's own and the shared ones that name it, then
 * the statewide ones), the nearby pages in its cluster, and the
 * correction line. Built only for a town with three verified dated items
 * of its own; any other town has no page and nothing links to one.
 *
 * The showpiece layout (Estes Park and Salida) is this page with three
 * things more: a hero photograph, one tradition spotlighted, and the
 * year's traditions laid out by season in place of the one list.
 *
 * The look (the design pass of 12 November 2026): the name sits on the
 * town's own landscape, a photograph where one is licensed and otherwise
 * a drawn horizon for the country it is in (src/lib/ridgeline.ts); under
 * it the year at a glance, twelve months with a mark for each tradition
 * in the month it falls; then Traditions beside Outdoor dates from the lg
 * breakpoint, one column below it. The statewide dates, the same six on
 * every page, are folded under a summary so the town's own lead.
 *
 * The two section ids, #traditions and #outdoor-dates, are where a folded
 * guide's old addresses land (vercel.json), so they are on every page
 * even when a section is empty.
 */
import { Image, getImage } from 'astro:assets';
import Page from '@/layouts/Page.astro';
import TraditionRow from '@/components/TraditionRow.astro';
import DateCorrection from '@/components/DateCorrection.astro';
import { findTown, getHub } from '@/config';
import { HUB_TOWNS, STANDALONE_GUIDES, findHubTown, hubCountyLine } from '@/config/hub-towns';
import { getTraditions } from '@/lib/content';
import { dayKey } from '@/lib/dates';
import { findSiteImage } from '@/lib/images';
import { recentlyStocked, STOCKING_SOURCE, STOCKING_SOURCE_NAME, type StockingData } from '@/lib/fish-stocking';
import { bySeason, eventPage, eventPath, lineFor, nearbyPages, nextUp as nextRowUp, placeRows, publishedHubTowns, showings, statewideSummary, townSearchText, type ShowingContext } from '@/lib/hub-towns';
import { breadcrumbJsonLd, collectionPageJsonLd, traditionEventJsonLd } from '@/lib/seo';
import { FLOW_SOURCES, SNOW_SOURCE, formatCfs, percentOfMedian, riverFlow, snowpack, type FlowData, type SnowData } from '@/lib/town-signals';
import { ridgeline, RIDGE_HEIGHT, RIDGE_WIDTH } from '@/lib/ridgeline';
import { formatDayLong, formatDayShort, formatShortDate, parseLocal } from '@/lib/dates';
import { CURRENT_SEASONS, TRADITION_TYPES, TRADITION_TYPE_INFO, isUpcoming, rowsByState, seasonRows, type TraditionRow as Row } from '@/lib/traditions';
import CalendarSubscribe from '@/components/CalendarSubscribe.astro';
import NearThisTown from '@/components/NearThisTown.astro';
import OpenNow from '@/components/OpenNow.astro';
import TownProfile from '@/components/TownProfile.astro';
import NearbyArticles from '@/components/NearbyArticles.astro';
import { appliesTo } from '@/lib/hub-towns';

export async function getStaticPaths() {
  return publishedHubTowns(await getTraditions()).map((t) => ({ params: { town: t.slug } }));
}

const hub = getHub();
const town = findHubTown(Astro.params.town as string)!;
const records = await getTraditions();
const published = publishedHubTowns(records);
const today = dayKey(new Date());
const { traditions, outdoor, statewide } = placeRows(records, town.slug, today);
const nearby = nearbyPages(town, published);

const ctx: ShowingContext = {
  hubDomain: hub.domain,
  published: new Set(published.map((t) => t.slug)),
  guideDomain: (key) => findTown(STANDALONE_GUIDES[key]?.guide ?? '')?.domain,
  guideName: (key) => findTown(STANDALONE_GUIDES[key]?.guide ?? '')?.siteTitle ?? key,
};
const alsoFor = (row: Row) => showings(row.record, ctx).filter((s) => s.key !== town.slug);
/** The record's own page, where it has one (the brief of 13 November 2026): the row's name links to it. */
const pageOf = (row: Row) => eventPath(row.record, ctx.published);
/** A shared record's eyebrow on this page is its kind, never another town's name. */
const rowProps = (row: Row) => ({ row, eyebrow: 'category' as const, href: pageOf(row), line: lineFor(row.record, town.slug), also: alsoFor(row) });

const show = town.showpiece;
const spotlight = show ? traditions.find((r) => r.record.slug === show.spotlight) : undefined;
const year = show ? bySeason(traditions.filter((r) => r !== spotlight)) : undefined;
// The photograph, where the file is in content/hub/images/ and its alt is
// written (HubTown.showpiece.hero): Salida's entry waits for the owner's
// picture, and until it arrives the page draws the town's horizon.
const heroFile = show?.hero && show.hero.alt.trim() ? findSiteImage('hub', show.hero.image) : undefined;
const hero = heroFile ? { src: heroFile, ...show!.hero! } : undefined;

// What a shared link shows: the town's own photograph where it has one,
// else its text card (src/routes/hub/town-share.png.ts). Before this every
// town page shared the hub's one picture.
const shareImage = hero ? (await getImage({ src: hero.src, width: 1200, height: 630, format: 'jpg' })).src : `/share/${town.slug}.png`;
const shareAlt = hero ? hero.alt : `${town.name}, Colorado: annual events and outdoor dates`;
const path = `/${town.slug}/`;
const pageUrl = `https://${hub.domain}${path}`;
const county = hubCountyLine(town);
const title = town.name;
// What a search result says: the town, the year, and the next two or three
// traditions with a date set, by name and day (src/lib/hub-towns.ts,
// townSearchText). A town with none ahead keeps the plain line.
const { seoTitle, description } = townSearchText(town.name, traditions);
const all = [...traditions, ...outdoor, ...statewide];
const structured = [
  // Each item is the record's own page where it has one, else its row here.
  collectionPageJsonLd(hub, { name: seoTitle, description, path, items: all.map((r) => ({ name: r.record.name, url: pageOf(r) ? `https://${hub.domain}${pageOf(r)}` : `${pageUrl}#${r.record.slug}` })) }),
  breadcrumbJsonLd(hub, [
    { name: hub.siteTitle, path: '/' },
    { name: town.name, path },
  ]),
  // An event is marked up on one page. Since 13 November 2026 a record whose
  // home is this town has a page of its own, which carries its Event; this
  // page marks up none. (A record shown here with another home is marked
  // up there.)
  ...traditions.map((r) => (r.past || pageOf(r) || eventPage(r.record, ctx) !== town.slug ? undefined : traditionEventJsonLd(r.record, r.entry, pageUrl))).filter((e) => !!e),
];
// The season pages this town has a row on: each is linked from here, as
// each row there links back (the links pass, 12 November 2026).
const seasonPages = TRADITION_TYPES.filter((t) => CURRENT_SEASONS[t] && seasonRows(records, t, today).some((r) => all.some((mine) => mine.record.slug === r.record.slug && !mine.record.statewide)));
const subject = `[Correction] ${town.name}`;
const mailto = `mailto:${hub.correctionsEmail ?? hub.social.email}?subject=${encodeURIComponent(subject)}`;
const card = 'rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7';
const h2 = 'mb-6 border-b-2 border-accent pb-3 text-3xl font-medium';
const pill =
  'inline-flex min-h-11 items-center rounded-full border border-primary-line bg-raised px-4 text-sm font-medium text-ink-muted no-underline transition-colors hover:border-primary hover:text-primary';
const clusterNote = HUB_TOWNS.length;
const intro = show?.intro ?? 'The events this town holds every year and the outdoor dates around it, each with the page it was read from.';
const ridge = hero ? undefined : ridgeline(town.slug, town.cluster, town.terrain);

/**
 * The first line of facts under the name: what is next, from the rows the
 * page already lists. The soonest date set among the traditions and the
 * town's outdoor dates, whichever kind it is (src/lib/hub-towns.ts,
 * nextUp); nothing where no date ahead has been published.
 */
const nextUp = nextRowUp(traditions, outdoor);

/**
 * The next 90 days (the audit of 13 November 2026): every date set within
 * them among the town's traditions and its own outdoor dates, soonest
 * first, before the year and the full lists. The statewide dates stay in
 * their fold below. Each carries its last day, so a stale build drops it
 * once it has passed (Freshness.astro).
 */
const NEXT_DAYS = 90;
const horizon = dayKey(new Date(parseLocal(today).getTime() + NEXT_DAYS * 86_400_000));
const soon = [...traditions, ...outdoor]
  .filter((r) => isUpcoming(r) && r.entry.date! <= horizon)
  .sort((a, b) => a.entry.date!.localeCompare(b.entry.date!) || a.record.name.localeCompare(b.record.name));
/**
 * The town's annual events by state (src/lib/traditions.ts, rowState):
 * dates set and ahead; no date yet; held, the next date not announced;
 * canceled. One list for a page with one state, as before.
 */
const traditionStates = rowsByState(traditions);
const traditionGroups = [
  { key: 'upcoming', label: 'Coming up', rows: traditionStates.upcoming },
  { key: 'waiting', label: 'Date not announced yet', rows: traditionStates.waiting },
  { key: 'past', label: 'Held; next date not announced', rows: traditionStates.past },
  { key: 'canceled', label: 'Canceled', rows: traditionStates.canceled },
].filter((g) => g.rows.length > 0);
const nextDay = nextUp ? `${formatDayLong(parseLocal(nextUp.entry.date!))}, ${nextUp.entry.date!.slice(0, 4)}` : undefined;

/**
 * The year at a glance: each tradition in the month of its date. A date
 * set is a filled mark; a tradition whose next date is not announced sits
 * in the month it was last held, as a ring, and the legend says which is
 * which in words (visual rule 5). One with no date in any year is left
 * off the strip and stays in the list.
 */
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const thisMonth = Number(today.slice(5, 7)) - 1;
const marks = traditions.flatMap((r) => {
  const set = isUpcoming(r);
  const date = set ? r.entry.date : r.lastHeld;
  if (!date) return [];
  const label = `${r.record.name}: ${set ? '' : 'last held '}${formatDayLong(parseLocal(date))}, ${date.slice(0, 4)}${set ? '' : '; next date not yet announced'}`;
  // What the mark says once its date has passed, for the reader's own day (DateCorrection).
  const labelPast = `${r.record.name}: last held ${formatDayLong(parseLocal(date))}, ${date.slice(0, 4)}; next date not yet announced`;
  return [{ slug: r.record.slug, month: Number(date.slice(5, 7)) - 1, set, label, labelPast, name: r.record.name }];
});
const months = MONTHS.map((name, i) => ({ name, now: i === thisMonth, marks: marks.filter((m) => m.month === i) }));
const hasRings = marks.some((m) => !m.set);

/**
 * The page's signature (HubTown.signature): the town's waters on CPW's
 * stocking report lately, from the file the scheduled job writes. Nothing
 * out of season, when no water matches, or when the file is missing or old
 * (src/lib/fish-stocking.ts); a build never reads the network for it.
 */
const stockingFiles = import.meta.glob<StockingData>('../../../data/hub/fish-stocking.json', { eager: true, import: 'default' });
const stocking = Object.values(stockingFiles)[0];
const stocked = town.signature?.kind === 'fish-stocking' ? recentlyStocked(town.signature.waters, stocking, today) : [];
// The river at the town's gauge, or the snowpack at its station, the same
// way: from the file the daily job writes, and only while the reading is
// fresh (src/lib/town-signals.ts).
const flowFiles = import.meta.glob<FlowData>('../../../data/hub/river-flow.json', { eager: true, import: 'default' });
const snowFiles = import.meta.glob<SnowData>('../../../data/hub/snowpack.json', { eager: true, import: 'default' });
const gauge = town.signature?.kind === 'river-flow' ? town.signature.gauge : undefined;
const flow = gauge ? riverFlow(gauge, Object.values(flowFiles)[0], new Date()) : undefined;
const station = town.signature?.kind === 'snowpack' ? town.signature.station : undefined;
const snow = station ? snowpack(station, Object.values(snowFiles)[0], today) : undefined;
const snowPercent = snow ? percentOfMedian(snow) : undefined;
const measuredAt = (iso: string) =>
  new Date(iso).toLocaleString('en-US', { timeZone: 'America/Denver', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
const inches = (n: number) => `${n} ${n === 1 ? 'inch' : 'inches'}`;
---
<Page {title} {seoTitle} {description} jsonLd={structured} image={shareImage} imageAlt={shareAlt} kind="Annual dates">
  <header slot="header" class="on-dark relative isolate overflow-hidden bg-primary text-white" data-town-hero={hero ? 'photo' : ridge!.terrain}>
    {hero ? (
      <Fragment>
        <Image
          src={hero.src}
          alt={hero.alt}
          widths={[640, 960, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 -z-20 h-full w-full object-cover"
          style={hero.position ? `object-position:${hero.position}` : undefined}
          data-showpiece-hero
        />
        {/* Shade only where the words are: the foot and the left, the picture clear above and to the right. */}
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/75 via-black/30 to-transparent" aria-hidden="true"></div>
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/45 to-transparent" aria-hidden="true"></div>
      </Fragment>
    ) : (
      <svg
        class="pointer-events-none absolute inset-x-0 -bottom-px -z-10 h-[62%] w-full sm:h-[70%]"
        viewBox={`0 0 ${RIDGE_WIDTH} ${RIDGE_HEIGHT}`}
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d={ridge!.layers[0]} fill="#fff" fill-opacity="0.07" />
        <path d={ridge!.layers[1]} fill="#fff" fill-opacity="0.11" />
        {/* The nearest line is the page's own paper, so the band ends on the land and not on a rule. */}
        <path d={ridge!.layers[2]} fill="var(--color-paper)" />
      </svg>
    )}
    {/* Less height than before the audit of 13 November 2026 (it was up to 18rem above the name), so the next 90 days start sooner. */}
    <div class:list={['container-page', hero ? 'pb-8 pt-28 sm:pt-36 md:pb-10 md:pt-44' : 'pb-16 pt-8 sm:pb-20 md:pb-24 md:pt-12']}>
      <p class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-white/85">{county} · Colorado</p>
      <h1 class="display mt-3 text-[3rem] leading-[0.95] sm:text-7xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-[1.0625rem] leading-relaxed text-white/90 md:text-xl md:leading-relaxed">{intro}</p>
      {nextUp && (
        <p class="mt-6 inline-flex max-w-full flex-wrap items-baseline gap-x-2 gap-y-1 rounded-lg bg-white/12 px-4 py-2.5 text-[0.9375rem] ring-1 ring-white/25 backdrop-blur-sm" data-next-up>
          <span class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-white/85">Next</span>
          <a href={`#${nextUp.record.slug}`} class="font-semibold text-white underline decoration-white/50 underline-offset-4 hover:decoration-white">{nextUp.record.name}</a>
          <span class="text-white/90" data-next-day>{nextDay}</span>
        </p>
      )}
    </div>
  </header>

  <section aria-labelledby="next90-heading" class="mb-12 md:mb-14" data-next-90>
    <h2 id="next90-heading" class="eyebrow mb-3">The next {NEXT_DAYS} days</h2>
    {soon.length > 0 ? (
      <ol class="divide-y divide-line-soft rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
        {soon.map((r) => (
          <li class="grid gap-y-0.5 py-3 sm:grid-cols-[10rem_minmax(0,1fr)_auto] sm:items-baseline sm:gap-x-4" data-event-day={r.entry.endDate ?? r.entry.date}>
            {/* Stacked on a phone (date, name, kind), three columns from sm: side by side at 390px the names were squeezed to a word a line and ran into the kind. */}
            <time datetime={r.entry.date} class="text-[0.9375rem] font-semibold tabular-nums text-ink">
              {formatDayShort(parseLocal(r.entry.date!))}{r.entry.endDate && r.entry.endDate !== r.entry.date && ` – ${formatDayShort(parseLocal(r.entry.endDate))}`}
            </time>
            <a href={`#${r.record.slug}`} class="min-w-0 text-[1.0625rem] font-medium leading-snug text-primary no-underline hover:underline">{r.record.name}</a>
            <span class="text-[0.875rem] text-ink-muted">{TRADITION_TYPE_INFO[r.record.type].label}</span>
          </li>
        ))}
      </ol>
    ) : (
      <p class="rounded-lg border border-dashed border-line px-5 py-4 text-[0.9375rem] text-ink-muted">No date in the next {NEXT_DAYS} days has been published yet. The year, and every event with its last date, are below.</p>
    )}
  </section>

  {marks.length > 0 && (
    <section aria-labelledby="year-heading" class="mb-12 md:mb-16" data-year-strip>
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
        <h2 id="year-heading" class="eyebrow">The year at a glance</h2>
        <p class="text-sm text-ink-muted">
          {marks.some((m) => m.set) && (
            <span class="mr-4 inline-block"><span class="mr-1 inline-block size-2.5 rounded-full bg-primary align-baseline" aria-hidden="true"></span>Date set</span>
          )}
          {hasRings && (
            <span class="inline-block"><span class="mr-1 inline-block size-2.5 rounded-full border-2 border-primary align-baseline" aria-hidden="true"></span>Last held; next date not yet announced</span>
          )}
        </p>
      </div>
      <ol class="grid grid-cols-6 gap-px overflow-hidden rounded-lg bg-line-soft ring-1 ring-line-soft md:grid-cols-12">
        {months.map((m) => (
          <li class:list={['flex min-h-24 flex-col items-center gap-2 px-1 pb-3 pt-2.5 md:min-h-28', m.now ? 'bg-highlight-soft' : 'bg-raised']} data-month={m.name} data-now={m.now ? '' : undefined}>
            <span class:list={['text-[0.75rem] font-semibold uppercase tracking-[0.12em]', m.now ? 'text-ink' : 'text-ink-muted']}>{m.name}</span>
            <span class="-mt-1.5 text-[0.75rem] leading-none text-ink" data-now-label hidden={!m.now}>now</span>
            {/* Each mark is a 24px target around a 16px dot (the dot alone was under the minimum for a thumb). */}
            <span class="flex flex-wrap justify-center">
              {m.marks.map((k) => (
                <a href={`#${k.slug}`} title={k.label} aria-label={k.label} data-mark={k.set ? 'set' : 'held'} data-label-past={k.set ? k.labelPast : undefined} class="group/mark flex size-6 items-center justify-center">
                  <span data-dot class:list={['block size-4 rounded-full transition-transform group-hover/mark:scale-125', k.set ? 'bg-primary' : 'border-2 border-primary bg-raised']}></span>
                </a>
              ))}
            </span>
          </li>
        ))}
      </ol>
      {/* A dot's name was a hover title, which a thumb never sees: where
          there is no hover, and on a narrow screen, the same marks as
          words, by month, each a link to its row. */}
      <ul class="mt-4 space-y-1.5 text-[0.9375rem] leading-snug text-ink-muted md:hidden pointer-coarse:block" data-year-list>
        {months.filter((m) => m.marks.length > 0).map((m) => (
          <li>
            <span class="mr-1.5 inline-block w-9 text-[0.75rem] font-semibold uppercase tracking-[0.12em] text-ink">{m.name}</span>
            {m.marks.map((k, i) => (
              <span data-mark-name={k.slug}>{i > 0 && ' · '}<a href={`#${k.slug}`} class="inline-block py-1.5 text-primary underline">{k.name}</a><span data-held-note hidden={k.set}> (last held)</span></span>
            ))}
          </li>
        ))}
      </ul>
    </section>
  )}

  {stocked.length > 0 && (
    <section aria-labelledby="stocked-heading" class="mb-12 md:mb-16" data-signature="fish-stocking">
      <h2 id="stocked-heading" class="eyebrow mb-3">Recently stocked near {town.name}</h2>
      <div class="rounded-lg bg-raised px-5 py-1 ring-1 ring-line-soft sm:px-7">
        <ul class="divide-y divide-line-soft">
          {stocked.map((w) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3.5">
              <a href={w.atlas} rel="noopener" class="font-heading text-xl font-medium text-ink no-underline hover:text-primary hover:underline">{w.name}</a>
              <span class="text-[0.9375rem] text-ink-muted">Added to the report <time datetime={w.added}>{formatDayLong(parseLocal(w.added))}, {w.added.slice(0, 4)}</time></span>
            </li>
          ))}
        </ul>
        <p class="border-t border-line-soft py-3.5 text-sm leading-relaxed text-ink-muted">
          Catchable trout, about ten inches. The date is the day the water was added to the report; the stocking may have been earlier that week.
          Checked <time datetime={stocking!.fetched}>{formatShortDate(parseLocal(stocking!.fetched))}</time> · Source:
          <a href={STOCKING_SOURCE} rel="noopener" class="text-primary underline">{STOCKING_SOURCE_NAME}, stocking report</a>
        </p>
      </div>
    </section>
  )}

  {spotlight && (
    <section aria-labelledby="spotlight-heading" class="mb-14 md:mb-16" data-spotlight>
      <h2 id="spotlight-heading" class="eyebrow mb-3">The one to know</h2>
      <div class="rounded-lg border-2 border-primary bg-raised px-5 shadow-[0_18px_40px_-24px_rgb(0_0_0/0.35)] sm:px-7">
        <TraditionRow {...rowProps(spotlight)} />
      </div>
    </section>
  )}

  {gauge && flow && (
    <section aria-labelledby="flow-heading" class="mb-12 md:mb-16" data-signature="river-flow" data-measured={flow.measured}>
      <h2 id="flow-heading" class="eyebrow mb-3">The {gauge.river} {gauge.where}</h2>
      <div class="rounded-lg bg-raised px-5 py-5 ring-1 ring-line-soft sm:px-7">
        <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="font-heading text-[2.5rem] font-medium leading-none text-ink">{formatCfs(flow.cfs)}</span>
          <span class="text-[1.0625rem] text-ink">cubic feet a second</span>
        </p>
        <p class="mt-2 text-[0.9375rem] text-ink-muted">Measured <time datetime={flow.measured}>{measuredAt(flow.measured)}</time>. Provisional, and subject to revision by the agency.</p>
        <p class="mt-3 border-t border-line-soft pt-3 text-sm text-ink-muted">
          Checked <time datetime={Object.values(flowFiles)[0]!.fetched}>{formatShortDate(parseLocal(Object.values(flowFiles)[0]!.fetched))}</time> · Source:
          <a href={gauge.page} rel="noopener" class="text-primary underline">{FLOW_SOURCES[gauge.agency].name}, gauge {gauge.id}</a>
        </p>
      </div>
    </section>
  )}

  {station && snow && (
    <section aria-labelledby="snow-heading" class="mb-12 md:mb-16" data-signature="snowpack" data-day={snow.date}>
      <h2 id="snow-heading" class="eyebrow mb-3">Snowpack at {station.name}, {station.elevationFt.toLocaleString('en-US')} feet</h2>
      <div class="rounded-lg bg-raised px-5 py-5 ring-1 ring-line-soft sm:px-7">
        <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="font-heading text-[2.5rem] font-medium leading-none text-ink">{inches(snow.swe)}</span>
          <span class="text-[1.0625rem] text-ink">of water in the snow (snow water equivalent)</span>
        </p>
        <p class="mt-2 text-[0.9375rem] text-ink-muted">
          On <time datetime={snow.date}>{formatDayLong(parseLocal(snow.date))}, {snow.date.slice(0, 4)}</time>.
          {snow.median !== undefined && <Fragment> The station’s median for the date, 1991 to 2020, is {inches(snow.median)}{snowPercent !== undefined && <Fragment>: this is {snowPercent}% of it</Fragment>}.</Fragment>}
          {' '}Provisional, and subject to revision.
        </p>
        <p class="mt-3 border-t border-line-soft pt-3 text-sm text-ink-muted">
          Checked <time datetime={Object.values(snowFiles)[0]!.fetched}>{formatShortDate(parseLocal(Object.values(snowFiles)[0]!.fetched))}</time> · Source:
          <a href={station.page} rel="noopener" class="text-primary underline">{SNOW_SOURCE}, station {station.triplet.split(':')[0]}</a>
        </p>
      </div>
    </section>
  )}

  <div class="lg:grid lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)] lg:items-start lg:gap-x-12">
  <section id="traditions" aria-labelledby="traditions-heading" class="mb-14 scroll-mt-4 md:mb-16">
    <h2 id="traditions-heading" class={h2}>{show ? `The year in ${town.name}` : `Annual events in ${town.name}`}</h2>
    {year ? (
      <Fragment>
        {year.seasons.map((group) => (
          <div class="mb-8" data-season={group.season}>
            <h3 class="eyebrow mb-3">{group.season}</h3>
            <div class={card}>{group.rows.map((row) => <TraditionRow {...rowProps(row)} />)}</div>
          </div>
        ))}
        {year.undated.length > 0 && (
          <div class="mb-8">
            <h3 class="eyebrow mb-3">No date published yet</h3>
            <div class={card}>{year.undated.map((row) => <TraditionRow {...rowProps(row)} />)}</div>
          </div>
        )}
      </Fragment>
    ) : traditionGroups.length > 1 ? (
      traditionGroups.map((g) => (
        <div class="mb-8" data-tradition-group={g.key}>
          <h3 class="eyebrow mb-3">{g.label}</h3>
          <div class={card}>{g.rows.map((row) => <TraditionRow {...rowProps(row)} />)}</div>
        </div>
      ))
    ) : traditions.length > 0 ? (
      <div class={card}>{traditions.map((row) => <TraditionRow {...rowProps(row)} />)}</div>
    ) : (
      <p class="text-ink-muted">No tradition here has a date we have read on its organizer’s page yet.</p>
    )}
  </section>

  <section id="outdoor-dates" aria-labelledby="outdoor-heading" class="mb-14 scroll-mt-4 md:mb-16">
    <h2 id="outdoor-heading" class={h2}>Outdoor dates near {town.name}</h2>
    {outdoor.length > 0 && <div class={card}>{outdoor.map((row) => <TraditionRow {...rowProps(row)} />)}</div>}
    {statewide.length > 0 && (
      <details class:list={['group rounded-lg bg-raised ring-1 ring-line-soft', outdoor.length > 0 && 'mt-6']} data-statewide>
        <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 sm:px-7 [&::-webkit-details-marker]:hidden">
          <span>
            <span class="eyebrow block">Across Colorado</span>
            <span class="mt-0.5 block text-[0.9375rem] text-ink-muted">{statewideSummary(statewide)}</span>
          </span>
          <span class="shrink-0 text-sm font-semibold text-primary underline group-open:hidden">Show</span>
          <span class="hidden shrink-0 text-sm font-semibold text-primary underline group-open:inline">Hide</span>
        </summary>
        <div class="border-t border-line-soft px-5 sm:px-7">{statewide.map((row) => <TraditionRow {...rowProps(row)} />)}</div>
      </details>
    )}
    {outdoor.length === 0 && statewide.length === 0 && <p class="text-ink-muted">No outdoor date for this town has been read on its agency’s page yet.</p>}
    <OpenNow records={records.filter((r) => !r.statewide && appliesTo(r, town.slug))} {today} class="mt-6" />
  </section>
  </div>

  <CalendarSubscribe name={town.slug} what={`${town.name}’s dates`} class="mb-10" />

  {seasonPages.length > 0 && (
    <nav aria-labelledby="seasons-heading" class="mb-12">
      <h2 id="seasons-heading" class="mb-4 text-2xl font-medium">{town.name} and the other towns</h2>
      <ul class="flex flex-wrap gap-2" data-season-links>
        {seasonPages.map((t) => (
          <li><a href={TRADITION_TYPE_INFO[t].path} class={pill}>{TRADITION_TYPE_INFO[t].plural} across Colorado</a></li>
        ))}
      </ul>
    </nav>
  )}

  {/* The additions of 12 November 2026, below what the page had, in the brief's order. */}
  <NearThisTown place={town.slug} name={town.name} onHub />
  {/* The hub's articles anchored to this town, as links only (the brief of 13 November 2026). */}
  <NearbyArticles place={town.slug} onHub />
  <TownProfile {town} />

  {nearby.length > 0 && (
    <nav aria-labelledby="nearby-heading" class="mb-12">
      <h2 id="nearby-heading" class="mb-4 text-2xl font-medium">More in {town.cluster}</h2>
      <ul class="flex flex-wrap gap-2" data-nearby data-of={clusterNote}>
        {nearby.map((t) => (
          <li><a href={`/${t.slug}/`} class={pill}>{t.name}</a></li>
        ))}
      </ul>
    </nav>
  )}

  <p class="rounded-lg border border-highlight bg-highlight-soft px-5 py-4 text-[0.9375rem] leading-relaxed text-ink">
    Something missing, or a date wrong? <a href={mailto} class="font-semibold underline">Tell us</a>. Every date links to the page it was read from.
  </p>
  <DateCorrection />
</Page>

<script>
  // A link to a row inside the folded "Across Colorado" list (from another
  // page's "Also on", or the year strip) has to open the fold: Chrome does
  // that on its own, and Safari on an iPhone is not relied on to. On load
  // and on every hash change: find the row, open the fold it is in, and
  // bring it into view.
  const reveal = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    const fold = target?.closest('details');
    if (target && fold && !fold.open) {
      fold.open = true;
      target.scrollIntoView();
    }
  };
  reveal();
  window.addEventListener('hashchange', reveal);
</script>
