        Every date links to the page it was read from. Organizing an event in {town.name}? <a href={mailto} class={pub.link}>Send us your dates</a>.
      </p>
    </div>
  </section>
  </div>
    </div>
  </div>
</Base>

<script>
  // "On this page" marks the section in view (aria-current="location"):
  // the last one whose top has passed a third of the way down the window,
  // and the last of all once the page is scrolled to its foot. Without this
  // script the rail is the plain list of links it was.
  const railLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-otp-link]')];
  const railTargets = railLinks.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
  // The section bar on a phone marks the same section, and scrolls itself so the mark is in view.
  const barLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-bar-link]')];
  if (railLinks.length > 0) {
    let queued = false;
    const mark = () => {
      queued = false;
      const line = window.innerHeight / 3;
      let current = -1;
      railTargets.forEach((t, i) => {
        if (t && t.getBoundingClientRect().top <= line) current = i;
      });
      const atFoot = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      if (atFoot && current >= 0) current = railTargets.length - 1;
      railLinks.forEach((a, i) => (i === current ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
      barLinks.forEach((a, i) => {
        if (i === current) {
          if (!a.hasAttribute('aria-current')) a.scrollIntoView({ block: 'nearest', inline: 'center' });
          a.setAttribute('aria-current', 'location');
        } else a.removeAttribute('aria-current');
      });
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(mark);
    };
    mark();
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    window.addEventListener('hashchange', queue);
  }

  // The statewide dates past the next two, and the one-time events past the
  // next ten, fold away behind a button. Without this script they are all
  // on the page and the button stays hidden.
  const fold = (toggle: HTMLButtonElement | null, rest: HTMLElement | null) => {
    if (!toggle || !rest) return;
    const set = (open: boolean) => {
      rest.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = (open ? toggle.dataset.less : toggle.dataset.more) ?? '';
    };
    set(false);
    toggle.hidden = false;
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    // A link to a date inside the fold (another page's "Also on", an
    // "Open now" item) opens it and brings the date into view, on load and
    // on every hash change.
    const reveal = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const target = id ? document.getElementById(id) : null;
      if (target && rest.contains(target) && rest.hidden) {
        set(true);
        target.scrollIntoView();
      }
    };
    reveal();
    window.addEventListener('hashchange', reveal);
  };
  fold(document.querySelector<HTMLButtonElement>('[data-statewide-toggle]'), document.getElementById('statewide-rest'));
  fold(document.querySelector<HTMLButtonElement>('[data-carried-toggle]'), document.getElementById('carried-rest'));
</script>
