          ("Microtel Inn & Suites by Wyndham Georgetown Lake") does not push the page wider than a phone.
          A name that fits keeps its note truncated beside it, as before. */}
      <ul class="mt-3.5 border-t border-hairline">
        {stayList.slice(0, staySlice).map((l) => (
          <li class:list={['flex min-h-11 flex-wrap items-baseline gap-x-2 py-1.5', pub.rule]} data-stay={l.name}>
            <a href={l.href} rel={l.external ? 'noopener' : undefined} class:list={[pub.link, 'max-w-full shrink-0 text-base font-medium']}>{typeset(l.name)}</a>{l.note && <span class:list={['min-w-0 grow basis-0 truncate', pub.meta]}>{typeset(l.note)}</span>}
          </li>
        ))}
      </ul>
      {stayMoreHref && stayList.length > STAY_SHOWN && <a href={stayMoreHref} class:list={[pub.go, 'mt-3']} data-all-stay>All {stayList.length} places to stay in {town.name} →</a>}
      <p class:list={['mt-3', pub.meta]}>A listing here links its page on this site; the others link the property’s own site. None is a paid or affiliate link.{profile.lodgingChecked && <Fragment> Checked <time datetime={profile.lodgingChecked}>{short(profile.lodgingChecked)}</time> against each property’s site.</Fragment>}</p>
    </PubSection>
  )}

  {section.getting && (
    <PubSection id={section.getting.id} number={section.getting.number} title={section.getting.title} tone={section.getting.tone} top="#top" data={{ 'getting-there': '' }}>
      {(profile.fromDenver || profile.transit.length > 0 || profile.airport || passes.length > 0) && (
        <dl class="mt-3.5 border-t border-hairline">
          {profile.fromDenver && (
            <div class={pub.dl}><dt class={pub.dt}>From Denver</dt><dd class={pub.t}>{formatMiles(profile.fromDenver.miles)} by road, {formatDrive(profile.fromDenver.minutes)} without traffic or stops{profile.fromDenverWinter && <span class:list={['block', pub.meta]} data-winter-route>{typeset(profile.fromDenverWinter.line)}</span>}</dd></div>
          )}
          {profile.transit.length > 0 && (
            <div class={pub.dl}>
              <dt class={pub.dt}>Bus and transit</dt>
              <dd class="space-y-1.5">
                {profile.transit.map((t) => <p class={pub.t}><a href={t.url} rel="noopener" class={pub.link}>{typeset(t.name)}</a>{t.detail && <Fragment>: {typeset(t.detail)}</Fragment>}</p>)}
              </dd>
            </div>
          )}
          {profile.airports.length > 0 && (
            <div class={pub.dl} data-airports>
              <dt class={pub.dt}>Airports</dt>
              <dd class="space-y-2.5">
                {profile.airports.map((a) => (
                  <p class={pub.t} data-airport={a.code}>
                    {a.url ? <a href={a.url} rel="noopener" class={pub.link}>{typeset(a.name)}</a> : typeset(a.name)} ({a.code}), {typeset(a.city)}: {formatMiles(a.miles)} by road, {formatDrive(a.minutes)}{a.nearest && ' · nearest by road'}
                    {a.winter && <span class:list={['block', pub.meta]} data-winter-route>{typeset(a.winter.line)}</span>}
                  </p>
                ))}
              </dd>
            </div>
          )}
          {passes.length > 0 && (
            <div class={pub.dl} data-passes>
              <dt class={pub.dt}>Passes and routes</dt>
              <dd class="space-y-2.5">
                {passes.map(({ pass, ends }) => (
                  <p class={pub.t} data-pass={pass.slug}>
                    {typeset(pass.name)}{pass.highway && <Fragment> · {typeset(pass.highway)}</Fragment>}
                    {ends.length === 2 && <Fragment> · between {ends.map((e, i) => (<Fragment>{i > 0 && ' and '}<a href={e.href} class={pub.link}>{e.name}</a></Fragment>))}</Fragment>}
                    {pass.seasonalClosure && roadsOf(pass.name).length === 0 && <span class:list={['block', pub.meta]}>Usual seasonal closure: {typeset(pass.seasonalClosure)}</span>}
                    {roadsOf(pass.name).map((r) => (
                      <span id={r.record.slug} class:list={['block scroll-mt-12 desk:scroll-mt-4', pub.meta]} data-road-date data-status={r.past ? 'not-announced' : r.entry.status}>
                        {pageOf(r) ? <a href={pageOf(r)} class={pub.link}>{roadLine(r).edge}</a> : roadLine(r).edge} {roadLine(r).when} · <a href={r.source} rel="noopener" class={pub.link}>{typeset(r.record.organizer)}</a>, checked <time datetime={r.entry.checked}>{short(r.entry.checked)}</time>
                      </span>
                    ))}
                    {pass.statusUrl && <span class:list={['block', pub.meta]}><a href={pass.statusUrl} rel="noopener" class={pub.link}>{pass.statusLabel ?? 'COtrip'}</a> for today’s status · checked <time datetime={pass.checked}>{short(pass.checked)}</time></span>}
                  </p>
                ))}
              </dd>
            </div>
          )}
