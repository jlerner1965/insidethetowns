---
/**
 * A town's page on the hub: /<town>/ (the restructure of 12 November 2026;
 * src/config/hub-towns.ts, src/lib/hub-towns.ts), on the publication
 * design the owner approved on 14 November 2026 (the town page board).
 * Every non-guide town on the hub has this page, about ninety-five of them.
 *
 * Top to bottom: the hero (the county, the town's name, one line and the
 * next date the town has), "On this page", then the numbered sections,
 * each a full-width band on paper or white:
 *
 *   Events      the town's dates: the ones set, soonest first; the ones
 *               not yet announced, with when each was last held; what is
 *               open now; the year at a glance; the calendar links.
 *   Places to know and Trails and parks (the owner's brief of 18 November
 *   2026), each fact read on the manager's page with the day it was read;
 *   Where to stay, Getting here (with the towns near it, by road),
 *   Outdoor dates (the statewide ones, the next two and the rest behind a
 *   button), and About (the figures, the town's live signature, its
 *   history, museums and landmarks, and the articles that name it);
 *
 * and last "More in <area>" (three to five town pages, nearest by road),
 * the way back to the contents on a phone and the correction line. A section or a block with nothing in the town's files
 * is not drawn, and the sections drawn are numbered and listed in order
 * (src/lib/hub-town-page.ts). Every fact is the files' own, in the words
 * the page used before the redesign, with its source and its check date.
 *
 * Where the town names a lead guide (`leadGuide`, the same brief), "Start
 * here" sits between the hero and the contents: the article's own title
 * and excerpt, and the link to it.
 *
 * Built only for a town with a dated item of its own (publishedHubTowns);
 * any other town has no page and nothing links to one. The events and
 * outdoor sections keep their anchors, #traditions and #outdoor-dates,
 * where a folded guide's old addresses land (vercel.json).
 *
 * Above 900px (the owner's desktop boards, 14 November 2026) the hero's
 * words and the next date sit side by side, On this page moves into a rail
 * that stays in view beside a 720px column of the sections, and the year,
 * the towns near it and the figures use the width. Below it, the phone's
 * page.
 *
 * Any town may have a photograph behind the name (HubTown.hero, 14
 * November 2026); the rest draw their horizon. The showpiece towns (Estes
 * Park, and Salida once its picture comes) also keep their own line under
 * the name; their dates take the same layout as every other town's. Their
 * spotlight (Estes Park: Frozen Dead Guy Days) is back since the audit of
 * 17 November 2026, as the first subhead of Events: the same entry, first
 * and once, with what the record says the event is.
 */
import { Image, getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PubSection from '@/components/hub/PubSection.astro';
import DateEntry from '@/components/hub/DateEntry.astro';
import YearGrid from '@/components/hub/YearGrid.astro';
import { pub } from '@/components/hub/pub';
import DateCorrection from '@/components/DateCorrection.astro';
import CalendarSubscribe from '@/components/CalendarSubscribe.astro';
import OpenNow from '@/components/OpenNow.astro';
import NearbyArticles from '@/components/NearbyArticles.astro';
import { allTowns, findTown, guideOrigin, getHub } from '@/config';
import { sectionFor } from '@/lib/section-index';
import { clusterName, STANDALONE_GUIDES, findHubTown, hubCountyLine } from '@/config/hub-towns';
import { getCuriosity, getSectionEntries, getTraditions } from '@/lib/content';
import { parseLeadGuide, sectionArticleSegment } from '@/lib/lead-guide';
import { dayKey, formatDayLong, formatShortDate, parseLocal, publishedTime } from '@/lib/dates';
import { exportWhen, isCanceled, isOver } from '@/lib/events';
import { hubTownPhoto } from '@/lib/images';
import { recentlyStocked, STOCKING_SOURCE, STOCKING_SOURCE_NAME, type StockingData } from '@/lib/fish-stocking';
import { appliesTo, eventPage, eventPath, lineFor, nextUp as nextRowUp, placeRows, publishedHubTowns, showings, townSearchText, type ShowingContext } from '@/lib/hub-towns';
import { foundedLine, milesShort, monthAnchor, notYetLine, moreHeading, moreInRegion, pageSections, profileView, timelineText, yearGrid, yearMarks, type ProfileFiles } from '@/lib/hub-town-page';
import { MONTH_NAMES } from '@/lib/year-grid';
import { articlePath, articlesFor, historyStory, isStandalone } from '@/lib/curiosity';
import { PLACE_TYPE_PLURALS, type PlaceType } from '@/content/schemas';
import { formatDrive, formatMiles, type Airports, type RoadMiles, type TownFacts } from '@/lib/near';
import { nearView } from '@/lib/near-view';
import { openNow } from '@/lib/open-now';
import { breadcrumbJsonLd, collectionPageJsonLd, traditionEventJsonLd } from '@/lib/seo';
import { FLOW_SOURCES, SNOW_SOURCE, formatCfs, percentOfMedian, riverFlow, snowpack, type FlowData, type SnowData } from '@/lib/town-signals';
import { ridgeline, RIDGE_HEIGHT, RIDGE_WIDTH } from '@/lib/ridgeline';
import { typeset } from '@/lib/text';
import { CURRENT_SEASONS, TRADITION_TYPES, TRADITION_TYPE_INFO, isAgencyDate, isUnderWay, isUpcoming, rowState, seasonRows, type TraditionRow as Row } from '@/lib/traditions';
import type { TownProfile } from '@/lib/town-profile';
// The italic of the heading face, for the subheads and the decks: the guides' pages do not use it, so it is loaded here only.
import '@fontsource-variable/fraunces/opsz-italic.css';

export async function getStaticPaths() {
  return publishedHubTowns(await getTraditions()).map((t) => ({ params: { town: t.slug } }));
}

const hub = getHub();
const town = findHubTown(Astro.params.town as string)!;
const records = await getTraditions();
const published = publishedHubTowns(records);
const today = dayKey(new Date());
const { traditions, outdoor, statewide } = placeRows(records, town.slug, today);

const ctx: ShowingContext = {
  hubDomain: hub.domain,
  published: new Set(published.map((t) => t.slug)),
  guideOrigin: (key) => {
    const guide = findTown(STANDALONE_GUIDES[key]?.guide ?? '');
    return guide && guideOrigin(guide);
  },
  guideName: (key) => findTown(STANDALONE_GUIDES[key]?.guide ?? '')?.siteTitle ?? key,
};
/** The record's own page, where it has one: the entry's name links to it. */
const pageOf = (row: Row) => eventPath(row.record, ctx.published);
/** A shared record's other showings, as links; never another town's name as the label over it. */
const entryProps = (row: Row) => ({
  row,
  href: pageOf(row),
  line: lineFor(row.record, town.slug),
  also: showings(row.record, ctx).filter((s) => s.key !== town.slug),
  agency: isAgencyDate(row.record.type),
});

const show = town.showpiece;
// The photograph, where the file is on disk and its alt is written
// (HubTown.hero, or a showpiece's); until then the page draws the town's horizon.
const hero = hubTownPhoto(town);
const ridge = hero ? undefined : ridgeline(town.slug, town.cluster, town.terrain);
// No blurred stand-in (the owner, 15 November 2026: "like Inside Berthoud"); the hub's links start the photograph before the page (src/components/HeroWarm.astro).
const heroStyle = hero?.position ? `object-position: ${hero.position}` : undefined;

// What a shared link shows: the town's own photograph where it has one, else its text card (town-share.png.ts).
const shareImage = hero ? (await getImage({ src: hero.src, width: 1200, height: 630, format: 'jpg' })).src : `/share/${town.slug}.png`;
const shareAlt = hero ? hero.alt : `${town.name}, Colorado: annual events and outdoor dates`;
const path = `/${town.slug}/`;
const pageUrl = `https://${hub.domain}${path}`;
const county = hubCountyLine(town);
const all = [...traditions, ...outdoor, ...statewide];

/* ------------------------------------------------------------ 01 Events */

/** A road's or a pass's opening or closing (CDOT's dates): under Getting here, not among the events (the owner, 18 November 2026). */
const isRoad = (r: Row) => r.record.type === 'outdoor' && r.record.outdoor?.kind === 'road';
const roadRows = [...traditions, ...outdoor].filter(isRoad).sort((a, b) => a.record.name.localeCompare(b.record.name));
/** A road's date on one line: "opens · Not yet announced, usually around Memorial Day · CDOT, checked Nov 12, 2026". */
const roadLine = (r: Row) => {
  const set = !r.past && (r.entry.status === 'confirmed' || r.entry.status === 'moved');
  const edge = r.record.outdoor?.edge === 'closes' ? 'Closes' : r.record.outdoor?.edge === 'opens' ? 'Opens' : 'Open';
  const when = set ? `${formatShortDate(parseLocal(r.entry.date!))}${r.entry.startTime ? `, ${publishedTime(r.entry.startTime)}` : ''}` : r.entry.status === 'canceled' ? 'canceled' : notYetLine(r.entry.typicalWindow, r.lastHeld ? formatShortDate(parseLocal(r.lastHeld)) : undefined);
  return { edge, when };
};

/** The town's own dates: its events and the outdoor dates that name it (not the statewide ones, which have their section, nor the roads). */
const own = [...traditions, ...outdoor].filter((r) => !isRoad(r));
/** A showpiece's one to know (HubTown.showpiece.spotlight): drawn first under Events, and left out of the lists below it. */
const spotlight = show ? own.find((r) => r.record.slug === show.spotlight) : undefined;
const listed = own.filter((r) => r !== spotlight);
/** The next date the town has, under its name: its own events' soonest date set; an outdoor date only where no event of its has one (src/lib/hub-towns.ts, nextUp). */
const nextUp = nextRowUp(traditions, outdoor.filter((r) => !isRoad(r)));
/** Its day, or for a run already under way the day it ends: "On now, through Saturday, October 31, 2026" (src/lib/traditions.ts, isUnderWay). */
const nextDay = nextUp
  ? isUnderWay(nextUp.entry, today)
    ? `On now, through ${formatDayLong(parseLocal(nextUp.entry.endDate!))}, ${nextUp.entry.endDate!.slice(0, 4)}`
    : `${formatDayLong(parseLocal(nextUp.entry.date!))}, ${nextUp.entry.date!.slice(0, 4)}`
  : undefined;
/** No date set in the next 90 days: the page says so, above the lists. */
const NEXT_DAYS = 90;
const horizon = dayKey(new Date(parseLocal(today).getTime() + NEXT_DAYS * 86_400_000));
const quiet = !own.some((r) => isUpcoming(r) && r.entry.date! <= horizon);
/** Set dates, soonest first; then those not yet announced, in the order of the year they were last held; then any canceled. */
const comingUp = listed.filter((r) => rowState(r) === 'upcoming').sort((a, b) => a.entry.date!.localeCompare(b.entry.date!) || a.record.name.localeCompare(b.record.name));
// A season that is open (Moraine Park's winter camping, "October 19 to
// mid-May") is in "Open now" below; it is not also "not yet announced" here
// because its opening day has passed (the owner, 17 November 2026: show it
// once). It comes back to this list the day its closing date passes.
const openRecords = records.filter((r) => !r.statewide && appliesTo(r, town.slug) && !(r.type === 'outdoor' && r.outdoor?.kind === 'road'));
const openSlugs = new Set(openNow(openRecords, today).open.map((o) => o.slug));
const waiting = listed
  .filter((r) => (rowState(r) === 'waiting' || rowState(r) === 'past') && !openSlugs.has(r.record.slug))
  .sort((a, b) => (a.lastHeld?.slice(5) ?? '99').localeCompare(b.lastHeld?.slice(5) ?? '99') || a.record.name.localeCompare(b.record.name));
const canceled = listed.filter((r) => rowState(r) === 'canceled');
/**
 * "Open now" carries a record's anchor only where no list above already
 * draws it. On its opening day a season is both open and in "Coming up"
 * (dated today), and both carried its slug as an id: the check refused
 * Durango, Grand Junction and Telluride on 20 November 2026, the day
 * Purgatory, Powderhorn and the Telluride gondola opened. That day "Open
 * now" links to the entry instead.
 */
const drawnSlugs = new Set([spotlight, ...comingUp, ...canceled].flatMap((r) => (r ? [r.record.slug] : [])));
const openAnchors = new Set([...openSlugs].filter((s) => !drawnSlugs.has(s)));
const groupOf = (r: Row) => (r === spotlight ? 'one-to-know' : rowState(r) === 'upcoming' ? 'coming-up' : rowState(r) === 'canceled' ? 'canceled' : 'not-announced');
/**
 * Each month's anchor sits on the first entry of that month in the lists, a
 * date set before one not yet announced, and the year's grid links there
 * (the owner, 18 November 2026: every month had gone to the top of "Coming
 * up"). `anchorOf` names the entry that carries each month.
 */
const monthOf = (d: string) => Number(d.slice(5, 7)) - 1;
const anchorOf = new Map<string, number>();
const taken = new Set<number>();
for (const r of comingUp) {
  const m = monthOf(r.entry.date!);
  if (!taken.has(m)) { taken.add(m); anchorOf.set(r.record.slug, m); }
}
for (const r of waiting) {
  if (!r.lastHeld) continue;
  const m = monthOf(r.lastHeld);
  if (!taken.has(m)) { taken.add(m); anchorOf.set(r.record.slug, m); }
}
const monthIdFor = (r: Row) => (anchorOf.has(r.record.slug) ? monthAnchor(anchorOf.get(r.record.slug)!) : undefined);
/** A date not yet announced, on one line: the month it usually falls in, from the record's window or its last date. */
const usualMonth = (r: Row) => {
  const start = r.record.dateWindow?.start ?? r.lastHeld?.slice(5);
  return start ? MONTH_NAMES[Number(start.slice(0, 2)) - 1] : undefined;
};
const cells = yearGrid(yearMarks(traditions, groupOf), Number(today.slice(5, 7)) - 1, taken);
const marked = cells.some((c) => c.marks.length > 0);
const hasOpen = (() => {
  const { open, next } = openNow(openRecords, today);
  return open.length + next.length > 0;
})();
/** The season pages this town has a row on, each linked from here as each row there links back. */
const seasonPages = TRADITION_TYPES.filter((t) => CURRENT_SEASONS[t] && seasonRows(records, t, today).some((r) => all.some((mine) => mine.record.slug === r.record.slug && !mine.record.statewide)));

/* ---------------------------------------- the profile: stay, getting, about */

const one = <T,>(files: Record<string, T>) => Object.values(files)[0];
const files: ProfileFiles = {
  facts: one(import.meta.glob<TownFacts>('../../../data/hub/town-facts.json', { eager: true, import: 'default' })),
  roads: one(import.meta.glob<RoadMiles>('../../../data/hub/road-miles.json', { eager: true, import: 'default' })),
  airports: one(import.meta.glob<Airports>('../../../data/hub/airports.json', { eager: true, import: 'default' })),
  bustang: one(import.meta.glob<NonNullable<ProfileFiles['bustang']>>('../../../data/hub/bustang.json', { eager: true, import: 'default' })),
  profile: Object.entries(import.meta.glob<TownProfile>('../../../data/hub/towns/*.json', { eager: true, import: 'default' })).find(([file]) => file.endsWith(`/${town.slug}.json`))?.[1],
};
const profile = profileView(town, files);
const roads = files.roads;
const withPage = new Set([...published.map((t) => t.slug), ...Object.keys(STANDALONE_GUIDES)]);
const { near, passes } = nearView(town.slug, roads, withPage, true);
/** The road rows that belong to a listed pass, by the pass's name, go on its row; the rest are their own list (the owner, 18 November 2026: one line per road, repeated nowhere). */
const roadsOf = (passName: string) => roadRows.filter((r) => r.record.outdoor?.facility === passName);
const roadsListed = roadRows.filter((r) => !passes.some(({ pass }) => pass.name === r.record.outdoor?.facility));
const short = (d: string) => formatShortDate(parseLocal(d));
/** The figures at a glance: two across on a phone, all of them in one row from 900px (four at most). Written out so Tailwind sees each class. */
const figureColumns: Record<number, string> = { 2: 'desk:grid-cols-2', 3: 'desk:grid-cols-3', 4: 'desk:grid-cols-4' };

/* The town's signature: the waters stocked lately, the river at its gauge, or the snow at its station, only while the reading is fresh. */
const stockingFiles = import.meta.glob<StockingData>('../../../data/hub/fish-stocking.json', { eager: true, import: 'default' });
const stocking = Object.values(stockingFiles)[0];
const stocked = town.signature?.kind === 'fish-stocking' ? recentlyStocked(town.signature.waters, stocking, today) : [];
const flowFiles = import.meta.glob<FlowData>('../../../data/hub/river-flow.json', { eager: true, import: 'default' });
const snowFiles = import.meta.glob<SnowData>('../../../data/hub/snowpack.json', { eager: true, import: 'default' });
const gauge = town.signature?.kind === 'river-flow' ? town.signature.gauge : undefined;
const flow = gauge ? riverFlow(gauge, Object.values(flowFiles)[0], new Date()) : undefined;
const station = town.signature?.kind === 'snowpack' ? town.signature.station : undefined;
const snow = station ? snowpack(station, Object.values(snowFiles)[0], today) : undefined;
const snowPercent = snow ? percentOfMedian(snow) : undefined;
const measuredAt = (iso: string) =>
  new Date(iso).toLocaleString('en-US', { timeZone: 'America/Denver', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
const inches = (n: number) => `${n} ${n === 1 ? 'inch' : 'inches'}`;
const hasSignature = stocked.length > 0 || (!!gauge && !!flow) || (!!station && !!snow);
const townArticles = articlesFor((await getCuriosity()).map((a) => a.data), town.slug);
/** The town's history story, featured at the top of About with "Read the story" (the owner, 18 November 2026). */
const history = historyStory(townArticles);
const hasArticles = townArticles.length > 0;

/* ------------------------------------------- the guide's places, on this page */

// The guide folded into this page, where some of it lives on under it (the
// move of 17 November 2026): a full section's main pages, or the pages
// kept one by one (src/lib/section-index.ts).
const folded = allTowns.find((t) => t.hubPage?.town === town.slug && t.section);
const kept = folded?.section?.mode === 'pages' ? await sectionFor(town.slug) : undefined;
/**
 * The one-time events carried from a guide folded page by page, those not
 * yet over, soonest first (src/lib/section-index.ts): each has a page under
 * /<town>/events/ that only the sitemap reached (the site audit of 19
 * November 2026: 245 such pages, Golden's 48 the most). Listed under
 * Events, after the annual dates; a page whose date has passed is noindex
 * and needs no link.
 */
const carried = kept ? kept.eventEntries.filter((e) => !isOver(e)).map((e) => ({ e, start: exportWhen(e).start })).sort((a, b) => a.start.getTime() - b.start.getTime()) : [];
/**
 * The next ten show; the rest fold behind a button, as the statewide dates
 * do (the owner, 20 November 2026: Golden's list ran to about 45). Folded,
 * not dropped: every link stays in the page, so no event page goes back to
 * being reachable from the sitemap alone.
 */
const CARRIED_SHOWN = 10;
const carriedFirst = carried.slice(0, CARRIED_SHOWN);
const carriedRest = carried.slice(CARRIED_SHOWN);
const placeEntries = folded ? [...(await getSectionEntries('places', folded))].sort((a, b) => a.data.title.localeCompare(b.data.title)) : [];
const placesHref = folded?.section?.mode === 'full' ? `/${town.slug}/directory/` : `/${town.slug}/places/`;
const placeHref = (slug: string) => `/${town.slug}/places/${slug}/`;
/**
 * Places, a few by kind (the owner, 18 November 2026): museums and history,
 * eat and drink, outdoors, where to stay, shops and services; three of each
 * at most, then every one on the places page.
 */
type PlaceEntry = (typeof placeEntries)[number];
const hasTag = (p: PlaceEntry, ...tags: string[]) => (p.data.tags ?? []).some((t: string) => tags.includes(t));
const PLACE_GROUPS: Array<{ label: string; pick: (p: PlaceEntry) => boolean }> = [
  { label: 'Museums and history', pick: (p) => p.data.type === 'venue' && hasTag(p, 'museum', 'history', 'historic', 'mining-history', 'tours') },
  { label: 'Eat and drink', pick: (p) => (['restaurant', 'coffee', 'bar'] as PlaceType[]).includes(p.data.type) },
  { label: 'Outdoors', pick: (p) => (['trail', 'trailhead', 'park'] as PlaceType[]).includes(p.data.type) },
  { label: 'Places to stay', pick: (p) => p.data.type === 'lodging' },
  { label: 'Shops and services', pick: (p) => (['shop', 'service'] as PlaceType[]).includes(p.data.type) },
];
/** Six at most, one line each (the owner, 18 November 2026), one from each kind in turn so the six span the town; the full list is the places page's. */
const PLACE_PICK = 6;
const placePicks = (() => {
  const used = new Set<string>();
  const kinds = [...PLACE_GROUPS, { label: PLACE_TYPE_PLURALS.venue, pick: (p: PlaceEntry) => p.data.type === 'venue' }];
  const pools = kinds.map((g) => ({ label: g.label, items: placeEntries.filter((p) => g.pick(p)) }));
  const out: Array<{ label: string; p: PlaceEntry }> = [];
  for (let round = 0; out.length < PLACE_PICK; round++) {
    let added = false;
    for (const pool of pools) {
      const next = pool.items.find((p) => !used.has(p.slug));
      if (!next || out.length >= PLACE_PICK) continue;
      used.add(next.slug);
      out.push({ label: pool.label, p: next });
      added = true;
    }
    if (!added) break;
  }
  return out;
})();
/** A lodging listing's one line: its summary's first clause ("The 1886 hotel on Harrison Avenue"). */
const oneLine = (summary: string) => {
  const first = summary.split(/[.;:](?:\s|$)/)[0]!.trim();
  return first.length <= 110 ? first : `${first.slice(0, 110).replace(/\s+\S*$/, '')}…`;
};
/** Where to stay: the guide's lodging places, then the profile's, each on one line with what it is; three on the page and the rest behind a link (the owner, 18 November 2026). */
const STAY_SHOWN = 3;
/** Where the rest of the lodging is: the places page's lodging group where the guide lists any, else the places page; a town with no places page shows every line. */
const stayMoreHref = folded ? (folded.section?.mode !== 'full' && placeEntries.some((p) => p.data.type === 'lodging') ? `${placesHref}#type-lodging` : placesHref) : undefined;
const staySlice = stayMoreHref ? STAY_SHOWN : undefined;
const stayList = [
  ...placeEntries.filter((p) => p.data.type === 'lodging').map((p) => ({ name: p.data.title, href: placeHref(p.slug), external: false, note: oneLine(p.data.summary), area: p.data.area as string | undefined })),
  ...profile.lodging.filter((l) => !placeEntries.some((p) => p.data.type === 'lodging' && p.data.title.toLowerCase() === l.name.toLowerCase())).map((l) => ({ name: l.name, href: l.url, external: true, note: [l.kind, l.season].filter(Boolean).join(' · '), area: undefined })),
];

/* ------------------------------------------------------------- sections */

const sections = pageSections(town.name, {
  events: own.length > 0 || hasOpen,
  places: profile.places.length > 0,
  trails: profile.trails.length > 0,
  directory: placePicks.length > 0,
  stay: stayList.length > 0,
  getting: !!profile.fromDenver || profile.transit.length > 0 || !!profile.airport || passes.length > 0 || near.length > 0 || roadsListed.length > 0,
  outdoor: statewide.length > 0,
  about: profile.strip.length > 0 || hasSignature || !!profile.heritage || hasArticles,
});
const has = (k: string) => sections.some((x) => x.key === k);
// A full section's page is one of the eleven guides' homes and takes their
// one title formula, the guide's own `seoTagline` ("Estes Park, CO events
// this weekend & things to do"; the owner, 20 November 2026). Every other
// town page keeps the title made from what it covers.
const { seoTitle: coversTitle, description } = townSearchText(town.name, traditions, show?.spotlight, today, { trails: has('trails'), stay: has('stay'), history: !!profile.heritage || !!history });
const seoTitle = folded?.section?.mode === 'full' && folded.seoTagline ? folded.seoTagline : coversTitle;
const structured = [
  collectionPageJsonLd(hub, { name: seoTitle, description, path, items: all.map((r) => ({ name: r.record.name, url: pageOf(r) ? `https://${hub.domain}${pageOf(r)}` : `${pageUrl}#${r.record.slug}` })) }),
  breadcrumbJsonLd(hub, [
    { name: hub.siteTitle, path: '/' },
    { name: town.name, path },
  ]),
  // An event is marked up on one page: a record whose home is this town has a page of its own since 13 November 2026.
  ...traditions.map((r) => (r.past || pageOf(r) || eventPage(r.record, ctx) !== town.slug ? undefined : traditionEventJsonLd(r.record, r.entry, pageUrl))).filter((e) => !!e),
];
/** The line under the name says what the page covers (the owner, 18 November 2026). */
const covers = [has('events') && 'annual events and their dates', has('trails') && 'trails and parks', has('directory') && 'places', has('stay') && 'where to stay', has('getting') && 'getting here', has('about') && (profile.heritage || history ? 'its history' : 'the town')].filter(Boolean) as string[];
