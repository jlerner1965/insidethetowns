---
/**
 * A town's page on the hub: /<town>/ (the restructure of 12 November 2026;
 * src/config/hub-towns.ts, src/lib/hub-towns.ts), on the publication
 * design the owner approved on 14 November 2026 (the town page board).
 * Every non-guide town on the hub has this page, about ninety-five of them.
 *
 * Top to bottom: the hero (the county, the town's name, one line and the
 * next date the town has), "On this page", then the numbered sections,
 * each a full-width band on paper or white:
 *
 *   Events      the town's dates: the ones set, soonest first; the ones
 *               not yet announced, with when each was last held; what is
 *               open now; the year at a glance; the calendar links.
 *   Where to stay, Getting here (with the towns near it, by road),
 *   Outdoor dates (the statewide ones, the next two and the rest behind a
 *   button), and About (the figures, the town's live signature, its
 *   history, museums and landmarks, and the articles that name it);
 *
 * and last "More in <area>", the way back to the contents and the
 * correction line. A section or a block with nothing in the town's files
 * is not drawn, and the sections drawn are numbered and listed in order
 * (src/lib/hub-town-page.ts). Every fact is the files' own, in the words
 * the page used before the redesign, with its source and its check date.
 *
 * Built only for a town with a dated item of its own (publishedHubTowns);
 * any other town has no page and nothing links to one. The events and
 * outdoor sections keep their anchors, #traditions and #outdoor-dates,
 * where a folded guide's old addresses land (vercel.json).
 *
 * Above 900px (the owner's desktop boards, 14 November 2026) the hero's
 * words and the next date sit side by side, On this page moves into a rail
 * that stays in view beside a 720px column of the sections, and the year,
 * the towns near it and the figures use the width. Below it, the phone's
 * page.
 *
 * Any town may have a photograph behind the name (HubTown.hero, 14
 * November 2026); the rest draw their horizon. The showpiece towns (Estes
 * Park, and Salida once its picture comes) also keep their own line under
 * the name; their dates take the same layout as every other town's.
 */
import { Image, getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PubSection from '@/components/hub/PubSection.astro';
import DateEntry from '@/components/hub/DateEntry.astro';
import YearGrid from '@/components/hub/YearGrid.astro';
import { pub } from '@/components/hub/pub';
import DateCorrection from '@/components/DateCorrection.astro';
import CalendarSubscribe from '@/components/CalendarSubscribe.astro';
import OpenNow from '@/components/OpenNow.astro';
import NearbyArticles from '@/components/NearbyArticles.astro';
import { findTown, getHub } from '@/config';
import { STANDALONE_GUIDES, clusterName, findHubTown, hubCountyLine } from '@/config/hub-towns';
import { getCuriosity, getTraditions } from '@/lib/content';
import { articlesFor } from '@/lib/curiosity';
import { dayKey, formatDayLong, formatShortDate, parseLocal } from '@/lib/dates';
import { hubTownPhoto } from '@/lib/images';
import { recentlyStocked, STOCKING_SOURCE, STOCKING_SOURCE_NAME, type StockingData } from '@/lib/fish-stocking';
import { appliesTo, eventPage, eventPath, lineFor, nextUp as nextRowUp, placeRows, publishedHubTowns, showings, townSearchText, type ShowingContext } from '@/lib/hub-towns';
import { milesShort, nextInCluster, pageSections, profileView, yearGrid, yearMarks, type ProfileFiles } from '@/lib/hub-town-page';
import { formatDrive, formatMiles, type Airports, type RoadMiles, type TownFacts } from '@/lib/near';
import { nearView } from '@/lib/near-view';
import { openNow } from '@/lib/open-now';
import { breadcrumbJsonLd, collectionPageJsonLd, traditionEventJsonLd } from '@/lib/seo';
import { FLOW_SOURCES, SNOW_SOURCE, formatCfs, percentOfMedian, riverFlow, snowpack, type FlowData, type SnowData } from '@/lib/town-signals';
import { ridgeline, RIDGE_HEIGHT, RIDGE_WIDTH } from '@/lib/ridgeline';
import { CURRENT_SEASONS, TRADITION_TYPES, TRADITION_TYPE_INFO, isAgencyDate, isUpcoming, rowState, seasonRows, type TraditionRow as Row } from '@/lib/traditions';
import type { TownProfile } from '@/lib/town-profile';
// The italic of the heading face, for the subheads and the decks: the guides' pages do not use it, so it is loaded here only.
import '@fontsource-variable/fraunces/opsz-italic.css';

export async function getStaticPaths() {
  return publishedHubTowns(await getTraditions()).map((t) => ({ params: { town: t.slug } }));
}

const hub = getHub();
const town = findHubTown(Astro.params.town as string)!;
const records = await getTraditions();
const published = publishedHubTowns(records);
const today = dayKey(new Date());
const { traditions, outdoor, statewide } = placeRows(records, town.slug, today);

const ctx: ShowingContext = {
  hubDomain: hub.domain,
  published: new Set(published.map((t) => t.slug)),
  guideDomain: (key) => findTown(STANDALONE_GUIDES[key]?.guide ?? '')?.domain,
  guideName: (key) => findTown(STANDALONE_GUIDES[key]?.guide ?? '')?.siteTitle ?? key,
};
/** The record's own page, where it has one: the entry's name links to it. */
const pageOf = (row: Row) => eventPath(row.record, ctx.published);
/** A shared record's other showings, as links; never another town's name as the label over it. */
const entryProps = (row: Row) => ({
  row,
  href: pageOf(row),
  line: lineFor(row.record, town.slug),
  also: showings(row.record, ctx).filter((s) => s.key !== town.slug),
  agency: isAgencyDate(row.record.type),
});

const show = town.showpiece;
// The photograph, where the file is on disk and its alt is written
// (HubTown.hero, or a showpiece's); until then the page draws the town's horizon.
const hero = hubTownPhoto(town);
const ridge = hero ? undefined : ridgeline(town.slug, town.cluster, town.terrain);

// What a shared link shows: the town's own photograph where it has one, else its text card (town-share.png.ts).
const shareImage = hero ? (await getImage({ src: hero.src, width: 1200, height: 630, format: 'jpg' })).src : `/share/${town.slug}.png`;
const shareAlt = hero ? hero.alt : `${town.name}, Colorado: annual events and outdoor dates`;
const path = `/${town.slug}/`;
const pageUrl = `https://${hub.domain}${path}`;
const county = hubCountyLine(town);
const { seoTitle, description } = townSearchText(town.name, traditions);
const all = [...traditions, ...outdoor, ...statewide];
const structured = [
  collectionPageJsonLd(hub, { name: seoTitle, description, path, items: all.map((r) => ({ name: r.record.name, url: pageOf(r) ? `https://${hub.domain}${pageOf(r)}` : `${pageUrl}#${r.record.slug}` })) }),
  breadcrumbJsonLd(hub, [
    { name: hub.siteTitle, path: '/' },
    { name: town.name, path },
  ]),
  // An event is marked up on one page: a record whose home is this town has a page of its own since 13 November 2026.
  ...traditions.map((r) => (r.past || pageOf(r) || eventPage(r.record, ctx) !== town.slug ? undefined : traditionEventJsonLd(r.record, r.entry, pageUrl))).filter((e) => !!e),
];
const intro = show?.intro ?? 'The events this town holds every year and the outdoor dates around it, each with the page it was read from.';

/* ------------------------------------------------------------ 01 Events */

/** The town's own dates: its events and the outdoor dates that name it (not the statewide ones, which have their section). */
const own = [...traditions, ...outdoor];
/** The next date the town has, under its name: the soonest set, an event before an outdoor date on the same day. */
const nextUp = nextRowUp(traditions, outdoor);
const nextDay = nextUp ? `${formatDayLong(parseLocal(nextUp.entry.date!))}, ${nextUp.entry.date!.slice(0, 4)}` : undefined;
/** No date set in the next 90 days: the page says so, above the lists. */
const NEXT_DAYS = 90;
const horizon = dayKey(new Date(parseLocal(today).getTime() + NEXT_DAYS * 86_400_000));
const quiet = !own.some((r) => isUpcoming(r) && r.entry.date! <= horizon);
/** Set dates, soonest first; then those not yet announced, in the order of the year they were last held; then any canceled. */
const comingUp = own.filter((r) => rowState(r) === 'upcoming').sort((a, b) => a.entry.date!.localeCompare(b.entry.date!) || a.record.name.localeCompare(b.record.name));
const waiting = own
  .filter((r) => rowState(r) === 'waiting' || rowState(r) === 'past')
  .sort((a, b) => (a.lastHeld?.slice(5) ?? '99').localeCompare(b.lastHeld?.slice(5) ?? '99') || a.record.name.localeCompare(b.record.name));
const canceled = own.filter((r) => rowState(r) === 'canceled');
const groupOf = (r: Row) => (rowState(r) === 'upcoming' ? 'coming-up' : rowState(r) === 'canceled' ? 'canceled' : 'not-announced');
const cells = yearGrid(yearMarks(traditions, groupOf), Number(today.slice(5, 7)) - 1);
const marked = cells.some((c) => c.marks.length > 0);
const openRecords = records.filter((r) => !r.statewide && appliesTo(r, town.slug));
const hasOpen = (() => {
  const { open, next } = openNow(openRecords, today);
  return open.length + next.length > 0;
})();
/** The season pages this town has a row on, each linked from here as each row there links back. */
const seasonPages = TRADITION_TYPES.filter((t) => CURRENT_SEASONS[t] && seasonRows(records, t, today).some((r) => all.some((mine) => mine.record.slug === r.record.slug && !mine.record.statewide)));

/* ---------------------------------------- the profile: stay, getting, about */

const one = <T,>(files: Record<string, T>) => Object.values(files)[0];
const files: ProfileFiles = {
  facts: one(import.meta.glob<TownFacts>('../../../data/hub/town-facts.json', { eager: true, import: 'default' })),
  roads: one(import.meta.glob<RoadMiles>('../../../data/hub/road-miles.json', { eager: true, import: 'default' })),
  airports: one(import.meta.glob<Airports>('../../../data/hub/airports.json', { eager: true, import: 'default' })),
  bustang: one(import.meta.glob<NonNullable<ProfileFiles['bustang']>>('../../../data/hub/bustang.json', { eager: true, import: 'default' })),
  profile: Object.entries(import.meta.glob<TownProfile>('../../../data/hub/towns/*.json', { eager: true, import: 'default' })).find(([file]) => file.endsWith(`/${town.slug}.json`))?.[1],
};
const profile = profileView(town, files);
const roads = files.roads;
const withPage = new Set([...published.map((t) => t.slug), ...Object.keys(STANDALONE_GUIDES)]);
const { near, passes } = nearView(town.slug, roads, withPage, true);
const short = (d: string) => formatShortDate(parseLocal(d));
/** The figures at a glance: two across on a phone, all of them in one row from 900px (four at most). Written out so Tailwind sees each class. */
const figureColumns: Record<number, string> = { 2: 'desk:grid-cols-2', 3: 'desk:grid-cols-3', 4: 'desk:grid-cols-4' };

/* The town's signature: the waters stocked lately, the river at its gauge, or the snow at its station, only while the reading is fresh. */
const stockingFiles = import.meta.glob<StockingData>('../../../data/hub/fish-stocking.json', { eager: true, import: 'default' });
const stocking = Object.values(stockingFiles)[0];
const stocked = town.signature?.kind === 'fish-stocking' ? recentlyStocked(town.signature.waters, stocking, today) : [];
const flowFiles = import.meta.glob<FlowData>('../../../data/hub/river-flow.json', { eager: true, import: 'default' });
const snowFiles = import.meta.glob<SnowData>('../../../data/hub/snowpack.json', { eager: true, import: 'default' });
const gauge = town.signature?.kind === 'river-flow' ? town.signature.gauge : undefined;
const flow = gauge ? riverFlow(gauge, Object.values(flowFiles)[0], new Date()) : undefined;
const station = town.signature?.kind === 'snowpack' ? town.signature.station : undefined;
const snow = station ? snowpack(station, Object.values(snowFiles)[0], today) : undefined;
const snowPercent = snow ? percentOfMedian(snow) : undefined;
const measuredAt = (iso: string) =>
  new Date(iso).toLocaleString('en-US', { timeZone: 'America/Denver', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
const inches = (n: number) => `${n} ${n === 1 ? 'inch' : 'inches'}`;
const hasSignature = stocked.length > 0 || (!!gauge && !!flow) || (!!station && !!snow);
const hasArticles = articlesFor((await getCuriosity()).map((a) => a.data), town.slug).length > 0;

/* ------------------------------------------------------------- sections */

const sections = pageSections(town.name, {
  events: own.length > 0 || hasOpen,
  stay: profile.lodging.length > 0,
  getting: !!profile.fromDenver || profile.transit.length > 0 || !!profile.airport || passes.length > 0 || near.length > 0,
  outdoor: statewide.length > 0,
  about: profile.strip.length > 0 || hasSignature || !!profile.heritage || hasArticles,
});
const section = Object.fromEntries(sections.map((s, i) => [s.key, { ...s, tone: (i % 2 === 0 ? 'paper' : 'white') as 'paper' | 'white' }]));
const closingTone = sections.length % 2 === 0 ? 'paper' : 'white';

/** The statewide dates: the next two, and the rest behind a button (shown in full without the script). */
const STATEWIDE_SHOWN = 2;
const statewideFirst = statewide.slice(0, STATEWIDE_SHOWN);
const statewideRest = statewide.slice(STATEWIDE_SHOWN);

/** The one town after this one in its area, coming round to the first, and the area's name as a reader sees it. */
const nextTown = nextInCluster(town, published);
const subject = `[Correction] ${town.name}`;
const mailto = `mailto:${hub.correctionsEmail ?? hub.social.email}?subject=${encodeURIComponent(subject)}`;
---
<Base title={seoTitle} {description} jsonLd={structured} image={shareImage} imageAlt={shareAlt} kind="Annual dates">
  {/* The hero: the name on the primary, over the town's own horizon or its photograph. */}
  <section class="on-dark relative isolate overflow-hidden bg-primary text-white" data-town-hero={hero ? 'photo' : ridge!.terrain} data-band aria-labelledby="town-name">
    {hero ? (
      <Fragment>
        <Image
          src={hero.src}
          alt={hero.alt}
          widths={[640, 960, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 -z-20 h-full w-full object-cover"
          style={hero.position ? `object-position:${hero.position}` : undefined}
          data-showpiece-hero
        />
        {/* Shade only where the words are: the foot and the left. */}
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/75 via-black/30 to-transparent" aria-hidden="true"></div>
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/45 to-transparent" aria-hidden="true"></div>
      </Fragment>
    ) : (
      <svg class="pointer-events-none absolute inset-x-0 -bottom-px -z-10 h-[72px] w-full desk:h-[96px]" viewBox={`0 0 ${RIDGE_WIDTH} ${RIDGE_HEIGHT}`} preserveAspectRatio="none" aria-hidden="true">
        <path d={ridge!.layers[1]} class="fill-hero-mountain" />
        {/* The nearest line is the band below, so the hero ends on the land: the contents' white on a phone, the first section's paper from 900px. */}
        <path d={ridge!.layers[2]} class="fill-raised desk:fill-paper" />
      </svg>
    )}
    {/* From 900px the words take 7 parts and the next date 5, their feet aligned, in the 1200px column. */}
    <div class:list={['px-[20px] desk:px-0', hero ? 'pb-[40px] pt-[120px] md:pt-[176px] desk:pb-[56px]' : 'pb-[76px] pt-[30px] desk:pb-[128px] desk:pt-[56px]']}>
      <div class:list={[pub.wide, 'desk:grid desk:grid-cols-[7fr_5fr] desk:items-end desk:gap-x-[56px]']}>
        <div class="min-w-0">
          <p class:list={[pub.cap, 'text-white']}>{county} · Colorado</p>
          <h1 id="town-name" class="mt-3 text-[3.5294rem] font-medium leading-[0.95] tracking-[-0.03em] text-white [font-variation-settings:normal] desk:text-[4.9412rem]">{town.name}</h1>
          <p class="mt-3.5 max-w-[40rem] text-base leading-[1.55] text-white">{intro}</p>
        </div>
        {nextUp && (
          <div class="mt-5 min-w-0 border-t border-white/50 pt-3 desk:mt-0" data-next-up>
            <p class:list={[pub.cap, 'text-white']}>Next {town.name} date</p>
            <p class="mt-1.5 font-heading text-sub leading-[1.25] [font-variation-settings:normal] desk:text-[1.4118rem]"><a href={`#${nextUp.record.slug}`} class="text-white underline decoration-1 underline-offset-[3px]">{nextUp.record.name}</a></p>
            <p class="mt-1 text-base text-white" data-next-day>{nextDay}</p>
          </div>
        )}
      </div>
    </div>
  </section>

  {/*
    The body. On a phone, On this page and then each section, a band of its
    own. From 900px (the desktop boards) a 240px rail holds On this page,
    kept in view as the page scrolls and above the paper bands, beside a
    720px column of the sections, 88px apart, in the 1200px column.
  */}
  <div class="bg-raised" data-band>
    <div class="desk:mx-auto desk:grid desk:max-w-[1200px] desk:grid-cols-[240px_minmax(0,720px)] desk:items-start desk:gap-x-[88px] desk:px-[40px]">
  <nav aria-labelledby="otp" class="scroll-mt-4 bg-raised px-[20px] pb-6 pt-3.5 desk:sticky desk:top-[24px] desk:z-[1] desk:self-start desk:bg-transparent desk:px-0 desk:pb-6 desk:pt-[56px]" id="contents">
    <div class={pub.col}>
      <div class={pub.open}><h2 id="otp" class={pub.h2s}>On this page</h2></div>
      <ol class="grid grid-cols-2 gap-x-[18px] sm:grid-cols-3 desk:grid-cols-1">
        {sections.map((s, i) => (
          <li>
            <a href={`#${s.id}`} class="flex min-h-12 items-center gap-2.5 border-b border-hairline font-heading text-[1.1176rem] font-medium leading-tight text-primary [font-variation-settings:normal]">
              <span class="inline-block w-3.5 shrink-0 font-normal no-underline" aria-hidden="true">{i + 1}</span>
              <span class="underline decoration-1 underline-offset-[3px]">{s.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>
  <div class="min-w-0">

  {section.events && (
    <PubSection id={section.events.id} number={section.events.number} title={section.events.title} tone={section.events.tone}>
      {quiet && <p class:list={['mt-3 italic', pub.meta]} data-quiet>No {town.name} event date in the next {NEXT_DAYS} days has been published yet.</p>}
      {comingUp.length > 0 && (
        <Fragment>
          <h3 id="coming-up" class:list={[pub.h3, 'mt-[22px]']}>Coming up</h3>
          {comingUp.map((r) => <DateEntry {...entryProps(r)} />)}
        </Fragment>
      )}
      {waiting.length > 0 && (
        <Fragment>
          <h3 id="not-announced" class:list={[pub.h3, comingUp.length === 0 && 'mt-[22px]']}>Date not yet announced</h3>
          {waiting.map((r) => <DateEntry {...entryProps(r)} />)}
        </Fragment>
      )}
      {canceled.length > 0 && (
        <Fragment>
          <h3 id="canceled" class={pub.h3}>Canceled</h3>
          {canceled.map((r) => <DateEntry {...entryProps(r)} />)}
        </Fragment>
      )}
      <OpenNow records={openRecords} {today} variant="pub" />
      {marked && (
        <Fragment>
          <h3 class={pub.h3}>The year at a glance</h3>
          <YearGrid {cells} />
        </Fragment>
      )}
      <CalendarSubscribe name={town.slug} what={`${town.name}’s dates`} size="text" class="mt-[22px]" />
      {seasonPages.length > 0 && (
        <nav aria-labelledby="seasons-heading">
          <h3 id="seasons-heading" class={pub.h3}>{town.name} and the other towns</h3>
          <ul class={pub.linkGrid} data-season-links>
            {seasonPages.map((t) => (
              <li><a href={TRADITION_TYPE_INFO[t].path} class:list={[pub.link, 'flex min-h-12 items-center border-b border-hairline text-base no-underline']}><span class="underline decoration-1 underline-offset-[3px]">{TRADITION_TYPE_INFO[t].plural} across Colorado</span></a></li>
            ))}
          </ul>
        </nav>
      )}
    </PubSection>
  )}

  {section.stay && (
    <PubSection id={section.stay.id} number={section.stay.number} title={section.stay.title} tone={section.stay.tone} data={{ 'where-to-stay': '' }}>
      <ul class="mt-3.5 border-t border-hairline">
        {profile.lodging.map((l) => (
          <li class:list={['py-3.5', pub.rule]}>
            <h3 class={pub.title}><a href={l.url} rel="noopener" class={pub.titleLink}>{l.name}</a></h3>
            {(l.kind || l.season) && <p class:list={['mt-0.5', pub.meta]}>{[l.kind, l.season].filter(Boolean).join(' · ')}</p>}
          </li>
        ))}
      </ul>
      <p class:list={['mt-3', pub.meta]}>Each links to the property’s own site; none is a paid or affiliate link.{profile.lodgingChecked && <Fragment> Checked <time datetime={profile.lodgingChecked}>{short(profile.lodgingChecked)}</time> against each property’s site.</Fragment>}</p>
    </PubSection>
  )}

  {section.getting && (
    <PubSection id={section.getting.id} number={section.getting.number} title={section.getting.title} tone={section.getting.tone} data={{ 'getting-there': '' }}>
      {(profile.fromDenver || profile.transit.length > 0 || profile.airport || passes.length > 0) && (
        <dl class="mt-3.5 border-t border-hairline">
          {profile.fromDenver && (
            <div class={pub.dl}><dt class={pub.dt}>From Denver</dt><dd class={pub.t}>{formatMiles(profile.fromDenver.miles)} by road, {formatDrive(profile.fromDenver.minutes)} without traffic or stops</dd></div>
          )}
          {profile.transit.length > 0 && (
            <div class={pub.dl}>
              <dt class={pub.dt}>Bus and transit</dt>
              <dd class="space-y-1.5">
                {profile.transit.map((t) => <p class={pub.t}><a href={t.url} rel="noopener" class={pub.link}>{t.name}</a>{t.detail && <Fragment>: {t.detail}</Fragment>}</p>)}
              </dd>
            </div>
          )}
          {profile.airport && (
            <div class={pub.dl}>
              <dt class={pub.dt}>Nearest commercial airport</dt>
              <dd class={pub.t}>{profile.airport.url ? <a href={profile.airport.url} rel="noopener" class={pub.link}>{profile.airport.name}</a> : profile.airport.name} ({profile.airport.code}), {profile.airport.city}: {formatMiles(profile.airport.miles)} by road</dd>
            </div>
          )}
          {passes.length > 0 && (
            <div class={pub.dl} data-passes>
              <dt class={pub.dt}>Passes and routes</dt>
              <dd class="space-y-2.5">
                {passes.map(({ pass, ends }) => (
                  <p class={pub.t} data-pass={pass.slug}>
                    {pass.name}{pass.highway && <Fragment> · {pass.highway}</Fragment>}
                    {ends.length === 2 && <Fragment> · between {ends.map((e, i) => (<Fragment>{i > 0 && ' and '}<a href={e.href} class={pub.link}>{e.name}</a></Fragment>))}</Fragment>}
                    {pass.seasonalClosure && <span class:list={['block', pub.meta]}>Usual seasonal closure: {pass.seasonalClosure}</span>}
                    {pass.statusUrl && <span class:list={['block', pub.meta]}><a href={pass.statusUrl} rel="noopener" class={pub.link}>{pass.statusLabel ?? 'COtrip'}</a> for today’s status · checked <time datetime={pass.checked}>{short(pass.checked)}</time></span>}
                  </p>
                ))}
              </dd>
            </div>
          )}
        </dl>
      )}
      {roads && (profile.fromDenver || profile.transit.length > 0 || profile.airport) && (
        <p class:list={['mt-2.5', pub.meta]}>
          Checked <time datetime={roads.checked}>{short(roads.checked)}</time> · Sources:
          <a href={roads.source.url} rel="noopener" class={pub.link}>{roads.source.name}</a> for the miles and the time{profile.transit.length > 0 && <Fragment>; the operator’s own page for each service</Fragment>}{profile.airport && profile.airportList && <Fragment>; <a href={profile.airportList} rel="noopener" class={pub.link}>Federal Aviation Administration, commercial service airports</a></Fragment>}
        </p>
      )}
      {near.length > 0 && roads && (
        <div data-near-town>
          <h3 class={pub.h3}>Near {town.name}</h3>
          <ul class="grid grid-cols-2 gap-x-[18px] desk:grid-cols-3 desk:gap-x-[28px]">
            {near.map((n) => (
              <li data-near={n.place} data-miles={n.miles}>
                <a href={n.href} class="flex min-h-12 items-center justify-between gap-2 border-b border-hairline text-base text-primary no-underline">
                  <span class="underline decoration-1 underline-offset-[3px]">{n.name}</span>
                  <span class="shrink-0 text-ink-muted" aria-label={`${formatMiles(n.miles)} by road`}>{milesShort(n.miles)}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class:list={['mt-3', pub.meta]}>
            Road miles between town centers, every pair from one router. A road shut for the season is not taken out of the miles.
            Checked <time datetime={roads.checked}>{short(roads.checked)}</time> · Source:
            <a href={roads.source.url} rel="noopener" class={pub.link}>{roads.source.name}</a>
          </p>
        </div>
      )}
    </PubSection>
  )}

  {section.outdoor && (
    <PubSection id={section.outdoor.id} number={section.outdoor.number} title={section.outdoor.title} tone={section.outdoor.tone}>
      <p class:list={['mt-3', pub.meta]}>These are statewide dates, not {town.name} events.</p>
      <div data-statewide>
        <h3 id="next-two" class:list={[pub.h3, 'mt-5']}>The next two</h3>
        {statewideFirst.map((r) => <DateEntry {...entryProps(r)} />)}
        {statewideRest.length > 0 && (
          <Fragment>
            <div id="statewide-rest" data-statewide-rest>
              {statewideRest.map((r) => <DateEntry {...entryProps(r)} />)}
            </div>
            {/* Shown by the script, which folds the rest away behind it; without the script every date is on the page and the button is not. */}
            <button type="button" hidden aria-expanded="true" aria-controls="statewide-rest" data-statewide-toggle data-more={`Show all ${statewide.length} statewide dates`} data-less="Show fewer statewide dates" class="mt-1.5 min-h-11 cursor-pointer border-0 bg-transparent p-0 text-left text-base font-[650] text-primary underline decoration-1 underline-offset-[3px]">Show all {statewide.length} statewide dates</button>
          </Fragment>
        )}
      </div>
    </PubSection>
  )}

  {section.about && (
    <PubSection id={section.about.id} number={section.about.number} title={section.about.title} tone={section.about.tone} data={{ 'town-facts': '' }}>
      {profile.strip.length > 0 && (
        <Fragment>
          <h3 class:list={[pub.h3, 'mt-[22px]']}>At a glance</h3>
          <dl class:list={['grid grid-cols-2', figureColumns[profile.strip.length]]}>
            {profile.strip.map((f, i) => (
              <div class:list={['border-b border-hairline pb-3.5 pt-3 desk:col-span-1', i % 2 === 0 ? 'border-r pr-3.5' : 'pl-3.5', profile.strip.length % 2 === 1 && i === profile.strip.length - 1 && 'col-span-2 border-r-0', i < profile.strip.length - 1 ? 'desk:border-r desk:pr-3.5' : 'desk:border-r-0 desk:pr-0', i > 0 ? 'desk:pl-3.5' : 'desk:pl-0']}>
                <dt class={pub.meta}>{f.label}</dt>
                <dd class="mt-1 font-heading text-date leading-[1.05] text-ink [font-variation-settings:normal]">{f.value}</dd>
              </div>
            ))}
          </dl>
          {profile.stripSources.length > 0 && profile.factsChecked && (
            <p class:list={['mt-2.5', pub.meta]}>
              Checked <time datetime={profile.factsChecked}>{short(profile.factsChecked)}</time> · Sources:
              {profile.stripSources.map((s, i) => (<Fragment>{i > 0 && '; '}<a href={s.url} rel="noopener" class={pub.link}>{s.name}</a></Fragment>))}
            </p>
          )}
        </Fragment>
      )}

      {stocked.length > 0 && (
        <div data-signature="fish-stocking">
          <h3 class={pub.h3}>Recently stocked near {town.name}</h3>
          <ul>
            {stocked.map((w) => (
              <li class:list={['py-3', pub.rule]}>
                <a href={w.atlas} rel="noopener" class:list={[pub.title, pub.titleLink, 'font-heading']}>{w.name}</a>
                <p class:list={['mt-0.5', pub.meta]}>Added to the report <time datetime={w.added}>{formatDayLong(parseLocal(w.added))}, {w.added.slice(0, 4)}</time></p>
              </li>
            ))}
          </ul>
          <p class:list={['mt-2.5', pub.meta]}>
            Catchable trout, about ten inches. The date is the day the water was added to the report; the stocking may have been earlier that week.
            Checked <time datetime={stocking!.fetched}>{short(stocking!.fetched)}</time> · Source:
            <a href={STOCKING_SOURCE} rel="noopener" class={pub.link}>{STOCKING_SOURCE_NAME}, stocking report</a>
          </p>
        </div>
      )}
      {gauge && flow && (
        <div data-signature="river-flow" data-measured={flow.measured}>
          <h3 class={pub.h3}>The {gauge.river} {gauge.where}</h3>
          <p class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="font-heading text-date leading-none text-ink [font-variation-settings:normal]">{formatCfs(flow.cfs)}</span>
            <span class={pub.t}>cubic feet a second</span>
          </p>
          <p class:list={['mt-2', pub.meta]}>Measured <time datetime={flow.measured}>{measuredAt(flow.measured)}</time>. Provisional, and subject to revision by the agency.</p>
          <p class:list={['mt-1', pub.meta]}>
            Checked <time datetime={Object.values(flowFiles)[0]!.fetched}>{short(Object.values(flowFiles)[0]!.fetched)}</time> · Source:
            <a href={gauge.page} rel="noopener" class={pub.link}>{FLOW_SOURCES[gauge.agency].name}, gauge {gauge.id}</a>
          </p>
        </div>
      )}
      {station && snow && (
        <div data-signature="snowpack" data-day={snow.date}>
          <h3 class={pub.h3}>Snowpack at {station.name}, {station.elevationFt.toLocaleString('en-US')} feet</h3>
          <p class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="font-heading text-date leading-none text-ink [font-variation-settings:normal]">{inches(snow.swe)}</span>
            <span class={pub.t}>of water in the snow (snow water equivalent)</span>
          </p>
          <p class:list={['mt-2', pub.meta]}>
            On <time datetime={snow.date}>{formatDayLong(parseLocal(snow.date))}, {snow.date.slice(0, 4)}</time>.
            {snow.median !== undefined && <Fragment> The station’s median for the date, 1991 to 2020, is {inches(snow.median)}{snowPercent !== undefined && <Fragment>: this is {snowPercent}% of it</Fragment>}.</Fragment>}
            {' '}Provisional, and subject to revision.
          </p>
          <p class:list={['mt-1', pub.meta]}>
            Checked <time datetime={Object.values(snowFiles)[0]!.fetched}>{short(Object.values(snowFiles)[0]!.fetched)}</time> · Source:
            <a href={station.page} rel="noopener" class={pub.link}>{SNOW_SOURCE}, station {station.triplet.split(':')[0]}</a>
          </p>
        </div>
      )}

      {profile.heritage && (
        <div data-heritage>
          {(profile.heritage.nameOrigin || profile.heritage.founded || profile.heritage.timeline.length > 0) && (
            <Fragment>
              <h3 class={pub.h3}>History</h3>
              <dl>
                {profile.heritage.nameOrigin && <div class={pub.dlHistory}><dt class={pub.dt}>The name</dt><dd class={pub.t}>{profile.heritage.nameOrigin.text}</dd></div>}
                {profile.heritage.founded && <div class={pub.dlHistory}><dt class={pub.dt}>Founded</dt><dd class={pub.t}>{profile.heritage.founded.year}{profile.heritage.founded.text && <Fragment>: {profile.heritage.founded.text}</Fragment>}</dd></div>}
                {profile.heritage.timeline.map((t) => (
                  <div class={pub.dlYear}><dt class="font-heading text-sub leading-[1.35] text-primary tabular-nums [font-variation-settings:normal]">{t.year}</dt><dd class={pub.t}>{t.text}</dd></div>
                ))}
              </dl>
            </Fragment>
          )}
          {profile.heritage.sites.length > 0 && (
            <Fragment>
              <h3 class={pub.h3}>Museums and landmarks</h3>
              {profile.heritage.sites.map((s) => (
                <Fragment>
                  <h4 class:list={['mt-3.5', pub.title]}>{s.url ? <a href={s.url} rel="noopener" class={pub.titleLink}>{s.name}</a> : s.name}</h4>
                  {(s.hours || s.cost || s.season) && (
                    <dl class="mt-2 border-t border-hairline">
                      {s.hours && <div class={pub.dlMuseum}><dt class={pub.dt}>Hours</dt><dd class={pub.t}>{s.hours}</dd></div>}
                      {s.cost && <div class={pub.dlMuseum}><dt class={pub.dt}>Cost</dt><dd class={pub.t}>{s.cost}</dd></div>}
                      {s.season && <div class={pub.dlMuseum}><dt class={pub.dt}>Season</dt><dd class={pub.t}>{s.season}</dd></div>}
                    </dl>
                  )}
                </Fragment>
              ))}
            </Fragment>
          )}
          {profile.heritage.ghostTowns.length > 0 && (
            <Fragment>
              <h3 class={pub.h3}>Ghost towns nearby</h3>
              <ul>
                {profile.heritage.ghostTowns.map((g) => (
                  <li class:list={['py-3', pub.rule, pub.t]}>{g.url ? <a href={g.url} rel="noopener" class={pub.link}>{g.name}</a> : <span class="font-semibold">{g.name}</span>}{g.text && <Fragment>: {g.text}</Fragment>}</li>
                ))}
              </ul>
            </Fragment>
          )}
          {profile.heritage.makers.length > 0 && (
            <Fragment>
              <h3 class={pub.h3}>Made in {town.name}</h3>
              <ul>
                {profile.heritage.makers.map((m) => (
                  <li class:list={['py-3', pub.rule, pub.t]}><a href={m.url} rel="noopener" class={pub.link}>{m.name}</a>: {m.what}</li>
                ))}
              </ul>
            </Fragment>
          )}
          <p class:list={['mt-3.5', pub.meta]}>
            {profile.heritageChecked && <Fragment>Checked <time datetime={profile.heritageChecked}>{short(profile.heritageChecked)}</time> · </Fragment>}Sources:
            {profile.heritageSources.map(([host, url], i) => (<Fragment>{i > 0 && ', '}<a href={url} rel="noopener" class={pub.link}>{host}</a></Fragment>))}
          </p>
        </div>
      )}
      {/* The hub's articles that name this town, as links only (the brief of 13 November 2026). */}
      <NearbyArticles place={town.slug} onHub variant="pub" />
    </PubSection>
  )}

  {/* The page's dates put right to the reader's own day (src/lib/tradition-expiry.ts). Before the close, so the close is the last band and the footer meets it. */}
  <DateCorrection />

  {/* The close: the next town in the area, the way back up, and the correction line. */}
  <section id="more" aria-labelledby={nextTown ? 'more-heading' : undefined} aria-label={nextTown ? undefined : 'Contents and corrections'} data-band class:list={['scroll-mt-4 px-[20px] pb-[56px] pt-[36px] desk:px-0 desk:pb-[64px] desk:pt-[56px]', closingTone === 'paper' ? pub.paperBleed : pub.white]}>
    <div class={pub.col}>
      <div class={pub.open}>
        {nextTown && <h2 id="more-heading" class={pub.h2s}>More in {clusterName(town.cluster)}</h2>}
        {nextTown && <a href={`/${nextTown.slug}/`} class:list={[pub.go, 'mt-2']} data-nearby>{nextTown.name} →</a>}
        <a href="#contents" class={pub.go}>Back to contents ↑</a>
      </div>
      <p class:list={['mt-3', pub.meta]}>
        Something missing, or a date wrong? <a href={mailto} class={pub.link}>Tell us</a>. Every date links to the page it was read from.
      </p>
    </div>
  </section>
  </div>
    </div>
  </div>
</Base>

<script>
  // The statewide dates past the next two fold away behind a button. Without
  // this script they are all on the page and the button stays hidden.
  const toggle = document.querySelector<HTMLButtonElement>('[data-statewide-toggle]');
  const rest = document.getElementById('statewide-rest');
  if (toggle && rest) {
    const set = (open: boolean) => {
      rest.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = (open ? toggle.dataset.less : toggle.dataset.more) ?? '';
    };
    set(false);
    toggle.hidden = false;
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    // A link to a date inside the fold (another page's "Also on", an
    // "Open now" item) opens it and brings the date into view, on load and
    // on every hash change.
    const reveal = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const target = id ? document.getElementById(id) : null;
      if (target && rest.contains(target) && rest.hidden) {
        set(true);
        target.scrollIntoView();
      }
    };
    reveal();
    window.addEventListener('hashchange', reveal);
  }
</script>
