---
/**
 * Every event across every live guide, for the weekend and the week around it.
 *
 * This is the hub's reason to be visited more than once. Nobody planning a
 * Saturday cares which municipal boundary a farmers market sits inside, and no
 * single town site can answer "what's on near me" — only this page can.
 *
 * Because every town lives in this repository, the page reads their content
 * directly at build time: no per-town JSON feed and no cross-domain fetch.
 *
 * "This weekend" is decided when the page is built, which on a static site is
 * a promise it cannot keep on its own. A scheduled rebuild keeps it true
 * (.github/workflows/scheduled-rebuild.yml) but a rebuild can fail, and GitHub
 * turns scheduled workflows off by itself after sixty days without a push.
 *
 * So the page does not rely on it. It bakes three weeks of listings and works
 * out in the reader's browser which of them is this weekend, which means a
 * build days or weeks old still shows the right ones. The server renders the
 * partition for its own build date, so a crawler and a reader without
 * JavaScript get a coherent page too.
 *
 * The emptiness notice is decided from the listings that are left on the page,
 * across all four sections — not from the dated ones alone. Reading only the
 * day groups is what produced the fault this page was rebuilt to fix: a ten-week
 * theatre run sat in "still running" while the notice above it announced that
 * everything had already happened.
 */
import Page from '@/layouts/Page.astro';
import FilterBar from '@/components/FilterBar.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import DayStrip from '@/components/DayStrip.astro';
import NetworkDayList from '@/components/NetworkDayList.astro';
import NetworkEventCard from '@/components/NetworkEventCard.astro';
import SponsorLine from '@/components/SponsorLine.astro';
import { getHub, liveTowns } from '@/config';
import { getNetworkEntries } from '@/lib/content';
import { groupByDay, occurrences, weekendSections, weekendWindow } from '@/lib/events';
import { formatDate, formatDayRange, formatTime } from '@/lib/dates';
import { collectionPageJsonLd } from '@/lib/seo';

const hub = getHub();
const towns = liveTowns();

// The moment the data behind this page was last read, which the foot of the
// page states plainly. Not "today" — the actual refresh.
const refreshedAt = new Date();

// Three weeks, so the page survives a long gap between deploys rather than
// only the days until the next one.
const sections = weekendSections(
  occurrences(await getNetworkEntries('events'), { now: refreshedAt, horizonDays: 30 }),
  { now: refreshedAt, horizonDays: 15 },
);
const { now, weekend, continuing, next } = sections;
const everything = [...now, ...weekend, ...continuing, ...next];

const options = towns
  .filter((t) => everything.some((e) => e.town.slug === t.slug))
  .map((t) => ({ value: t.slug, label: t.name }));

const { start: weekendStart, sunday } = weekendWindow(refreshedAt);
// "Next week" it is not: the horizon runs two weeks past the weekend. The
// heading names the days it actually holds, and the script below renames it
// for the days left once the reader's clock has moved some of them. `next`
// is in start order.
const laterLabel = next.length ? formatDayRange(next[0].data.start, next.at(-1)!.data.start) : 'The two weeks after';
const weekendLabel =
  weekendStart.getTime() === sunday.getTime()
    ? formatDate(sunday)
    : `${formatDate(weekendStart)} – ${formatDate(sunday)}`;

/**
 * The page as a CollectionPage, carrying the listings it shows.
 *
 * The Event markup itself stays on the town pages that own each listing; this
 * says only that the hub collects them, which is what it does. `isPartOf` ties
 * the page to the hub's own WebSite node.
 */
const structured = collectionPageJsonLd(hub, {
  name: `What’s on across ${hub.siteTitle}`,
  description: `Every event across ${towns.length} Front Range town guides this weekend.`,
  path: '/this-weekend/',
  items: everything.map((e) => ({ name: `${e.data.title} — ${e.town.name}`, url: `https://${e.town.domain}/events/${e.slug}/` })),
});
---
<Page
  title="This weekend on the Front Range"
  seoTitle={`This weekend on Colorado’s Front Range — ${weekendLabel}`}
  eyebrow="Across the network"
  description={`Every event across ${towns.length} Front Range town guides this weekend: markets, music, festivals and trails in ${towns.map((t) => t.name).join(', ')}.`}
  intro={`Everything on across all ${towns.length} guides, ${weekendLabel}, and the two weeks after it. Each listing opens on that town’s own site.`}
  jsonLd={structured}
>
  <SponsorLine slot="after-header" sponsor={hub.sponsors?.network} label="This weekend, presented by" />
  <p
    class="mb-8 hidden rounded-lg border border-highlight bg-highlight-soft px-5 py-4 text-[0.9375rem] leading-relaxed text-ink"
    data-stale-notice
  >
    <strong class="font-semibold">Nothing here is current.</strong> This page was last refreshed on {formatDate(refreshedAt)} and
    everything it was carrying has now happened. That is a fault at our end, not a quiet weekend. Each town's guide
    keeps its own calendar — they are linked from <a href="/#towns" class="text-accent-text">the map</a>.
  </p>

  <div data-filter-root>
    <FilterBar options={options} label="Filter by town" rowLabel="Town" />
    {/* Straight to a day, as on a town's events page. */}
    <DayStrip days={groupByDay(weekend)} more={next.length ? [{ href: '#coming-up', label: 'Coming up' }] : []} />

    <section class="mb-20 md:mb-24" data-section="now" hidden={now.length === 0}>
      <SectionHeader eyebrow="Under way" title="Happening now" />
      <div data-filter-group class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7" data-section-body>
        {now.map((event) => <NetworkEventCard event={event} />)}
      </div>
      <p class="mt-4 text-[0.875rem] text-ink-faint">Under way as this page loaded.</p>
    </section>

    <section data-section="weekend">
      {/* Like SectionHeader; the eyebrow carries the dates, which the script
          below rewrites for the reader's own day. */}
      <div class="mb-8 border-b-2 border-accent pb-5 md:mb-10">
        <p class="eyebrow mb-2" data-weekend-heading>{weekendLabel}</p>
        <h2 class="display-md text-4xl md:text-5xl">The weekend</h2>
      </div>
      <div data-weekend-list data-section-body>
        <NetworkDayList events={weekend} emptyMessage="Nothing listed across the network for this weekend yet." />
      </div>
      <p data-weekend-filtered hidden class="rounded-lg border border-dashed border-line px-6 py-10 text-center text-ink-muted"></p>
    </section>

    <section class="mt-20 md:mt-24" data-section="continuing" hidden={continuing.length === 0}>
      <SectionHeader eyebrow="Through the weekend" title="Still running" />
      <div data-filter-group class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7" data-section-body>
        {continuing.map((event) => <NetworkEventCard event={event} />)}
      </div>
      <p class="mt-4 text-[0.875rem] text-ink-faint">
        Runs and exhibitions that started earlier and are on through the weekend.
      </p>
    </section>

    <section id="coming-up" class="mt-20 scroll-mt-40 md:mt-24" data-section="next">
      <div class="mb-8 border-b-2 border-accent pb-5 md:mb-10">
        <p class="eyebrow mb-2" data-later-heading>{laterLabel}</p>
        <h2 class="display-md text-4xl md:text-5xl">Coming up</h2>
      </div>
      <div data-later-list data-section-body>
        <NetworkDayList events={next} emptyMessage="Nothing listed yet." collapseAfter={6} />
      </div>
    </section>

    <p data-filter-empty hidden class="mt-6 rounded-lg border border-dashed border-line px-6 py-10 text-center text-ink-muted">
      Nothing coming up in that town.
    </p>
  </div>

  <p class="mt-14 text-[0.875rem] text-ink-faint">
    Listings refreshed <time datetime={refreshedAt.toISOString()}>{formatDate(refreshedAt)} at {formatTime(refreshedAt)}</time>.
    Every event links to the town guide that keeps it.
  </p>
</Page>

<script>
  /*
   * Re-decide, from the reader's clock rather than the build's, which listings
   * are still on and which of the baked days is "this weekend".
   *
   * It does its own removal of finished listings rather than depending on
   * having run after Freshness.astro: module scripts have no ordering
   * guarantee worth relying on, and both operations are idempotent.
   */
  const TZ = 'America/Denver';
  const todayKey = new Date().toLocaleDateString('en-CA', { timeZone: TZ });
  const nowMs = Date.now();

  // Noon UTC stands in for a Denver calendar day: far enough from either
  // midnight that no offset can push it onto the wrong date.
  const key = (date: Date) => date.toISOString().slice(0, 10);
  const noon = (k: string) => new Date(`${k}T12:00:00Z`);
  const shift = (from: Date, days: number) => {
    const out = new Date(from);
    out.setUTCDate(out.getUTCDate() + days);
    return out;
  };

  const today = noon(todayKey);
  const dow = today.getUTCDay(); // 0 Sunday … 6 Saturday
  const sunday = shift(today, dow === 0 ? 0 : 7 - dow);
  const start = dow === 0 || dow >= 5 ? today : shift(sunday, -2);

  // 1. Anything that has finished goes, whether or not its day has turned over.
  //    `data-end` is the exclusive end as an instant, so this catches a run
  //    that ended two hours ago as well as one that ended last month.
  for (const card of document.querySelectorAll<HTMLElement>('[data-filter-item][data-end]')) {
    const ends = Date.parse(card.dataset.end!);
    const lastDay = card.dataset.eventDay;
    if ((!Number.isNaN(ends) && ends <= nowMs) || (lastDay && lastDay < todayKey)) card.remove();
  }

  // 2. A day heading with nothing left under it is worse than no heading.
  for (const day of document.querySelectorAll<HTMLElement>('[data-day]')) {
    if (!day.querySelector('[data-filter-item]')) day.remove();
  }

  // 3. Move the surviving days into the section the reader's clock puts them in.
  const weekendList = document.querySelector<HTMLElement>('[data-weekend-list] > *');
  const laterList = document.querySelector<HTMLElement>('[data-later-list] > *');
  if (weekendList && laterList) {
    for (const day of document.querySelectorAll<HTMLElement>('[data-day]')) {
      const when = day.dataset.day!;
      const target = when >= key(start) && when <= key(sunday) ? weekendList : laterList;
      if (day.parentElement !== target) target.append(day);
    }
    // Days arrive in whatever order they were moved; put them back in date order.
    for (const list of [weekendList, laterList]) {
      const days = [...list.querySelectorAll<HTMLElement>('[data-day]')];
      days.sort((a, b) => a.dataset.day!.localeCompare(b.dataset.day!));
      for (const day of days) list.append(day);
    }

    const label = (date: Date) =>
      date.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric' });
    const heading = document.querySelector<HTMLElement>('[data-weekend-heading]');
    if (heading) {
      const range = key(start) === key(sunday) ? label(sunday) : `${label(start)} – ${label(sunday)}`;
      heading.textContent = range;
    }

    // The same "October 12–25" the build wrote, for the days actually left.
    const later = document.querySelector<HTMLElement>('[data-later-heading]');
    const left = [...laterList.querySelectorAll<HTMLElement>('[data-day]')].map((d) => d.dataset.day!);
    if (later) {
      const monthDay = (k: string) => noon(k).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric' });
      const month = (k: string) => noon(k).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long' });
      const first = left[0];
      const last = left.at(-1);
      const range = !first || !last
        ? ''
        : first === last
          ? monthDay(first)
          : month(first) === month(last)
            ? `${monthDay(first)}–${noon(last).getUTCDate()}`
            : `${monthDay(first)} – ${monthDay(last)}`;
      later.textContent = range || 'The two weeks after';
    }
  }

  // 4. Hide any section that has emptied out. The two dated sections keep their
  //    "nothing listed" line, so they are only hidden when the whole page is.
  for (const section of document.querySelectorAll<HTMLElement>('[data-section="now"], [data-section="continuing"]')) {
    section.hidden = !section.querySelector('[data-filter-item]');
  }

  // 5. Only now, with everything removed and re-sorted, is "there is nothing
  //    left" a thing the page can truthfully say — and it is true only when no
  //    listing survives in ANY section, dated or running.
  const remaining = document.querySelectorAll('[data-filter-item]').length;
  const notice = document.querySelector<HTMLElement>('[data-stale-notice]');
  if (notice && remaining === 0) notice.classList.remove('hidden');
  for (const section of document.querySelectorAll<HTMLElement>('[data-section="weekend"], [data-section="next"]')) {
    if (remaining === 0) section.hidden = true;
  }

  // 6. Filtered to one town, a section with nothing of that town's in it goes,
  //    heading and all, rather than standing empty under its heading. The
  //    weekend stays and says so in words, since "nothing this weekend" is the
  //    answer the reader came for; what that town has coming up is below it.
  const root = document.querySelector<HTMLElement>('[data-filter-root]');
  root?.addEventListener('filter:change', (e) => {
    if (remaining === 0) return;
    const value = (e as CustomEvent<{ value: string }>).detail.value;
    const any = !!root.querySelector('[data-filter-item]:not([hidden])');
    for (const section of root.querySelectorAll<HTMLElement>('[data-section]')) {
      const has = !!section.querySelector('[data-filter-item]:not([hidden])');
      const items = !!section.querySelector('[data-filter-item]');
      const kind = section.dataset.section;
      if (kind === 'weekend') {
        section.hidden = !any;
        const note = section.querySelector<HTMLElement>('[data-weekend-filtered]');
        if (note) {
          const name = root.querySelector(`[data-filter="${value}"]`)?.textContent?.trim() ?? 'that town';
          note.textContent = `Nothing listed in ${name} for the weekend itself.`;
          note.hidden = has || !items;
        }
      } else if (kind === 'next') {
        // With nothing at all to show it keeps its "nothing listed" line, as unfiltered.
        section.hidden = !any || (items && !has);
      } else {
        section.hidden = !has;
      }
    }
  });
</script>
