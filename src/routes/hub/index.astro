---
/**
 * The hub home, in the owner's order (6 October 2026):
 *
 *   1. a compact introduction ending in the town picker
 *   2. this weekend across the towns (four to six picks)
 *   3. one featured story
 *   4. the latest guides, as a compact grid
 *   5. new around the towns: places added to the guides or closed
 *   6. the newsletter signup beside what this week's issue would hold
 *   7. the towns: map and directory
 *
 * The point is that the hub has something of its own to read and a reason to
 * come back, rather than being a list of links to the guides. Everything on it
 * is drawn from the towns' own listings at build time; nothing is written for
 * the hub by hand, so it cannot disagree with the guides.
 *
 * The census-population strip and the "How it's made" band are gone: the
 * population is the geography covered, not readers, and the independence line
 * now sits in the introduction.
 */
import Base from '@/layouts/Base.astro';
import TownMap from '@/components/TownMap.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import NetworkEventCard from '@/components/NetworkEventCard.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import { getNetworkEntries } from '@/lib/content';
import { addDays, formatDate, formatDayRange, startOfDay } from '@/lib/dates';
import { highlights, isCanceled, occurrences, oneOffs, weekendSections, weekendWindow } from '@/lib/events';
import { isNewlyClosed, isNewPlace, nextSendDay, openingDay } from '@/lib/newsletter';
import { isOpen } from '@/lib/places';
import { LIVE_TOWNS, countyLabel, getHub } from '@/config';
import { groupByRegion } from '@/lib/regions';

const hub = getHub();
/**
 * Only live guides reach this page: the picker, the cards, the map and every
 * block read `live`. A town whose status is not `live` is not named here at
 * all until the owner flips it (6 October 2026).
 */
const live = hub.towns.filter((t) => LIVE_TOWNS.includes(t.slug));
const atoz = [...live].sort((a, b) => a.name.localeCompare(b.name, 'en'));
const regions = groupByRegion(live);
const now = new Date();

/**
 * 2. The weekend across every guide, ranked the way a town's home page ranks
 * its listings. One-offs lead; regulars fill in only when the weekend is
 * quiet. An empty weekend (a Sunday night) falls back to the week ahead and
 * says which it is.
 */
const events = await getNetworkEntries('events');
const network = occurrences(events, { now, horizonDays: 30 });
const sections = weekendSections(network, { now, horizonDays: 15 });
const onThisWeekend = [...sections.now, ...sections.weekend];
const picks = highlights(oneOffs(onThisWeekend, network), { now, limit: 6 });
const weekend = picks.length >= 4 ? picks : highlights(onThisWeekend, { now, limit: 6 });
const leadIsWeekend = weekend.length > 0;
const lead = leadIsWeekend ? weekend : highlights(sections.next, { now, limit: 6 });
const { start: weekendStart, sunday } = weekendWindow(now);

/**
 * 3 and 4. Articles across the network, newest first. The featured story is
 * the newest one with a photograph, because the block exists to show a real
 * picture of a real place; the grid is the next six. An article without a
 * photograph still appears in the grid as text.
 */
const articles = (await getNetworkEntries('articles')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || a.town.name.localeCompare(b.town.name, 'en'),
);
const featured = articles.find((a) => a.data.image) ?? articles[0];
const latest = articles.filter((a) => a !== featured).slice(0, 6);

/**
 * 5. New around the towns: the last 30 days of places added to a guide or
 * recorded as closed, from the same `added` and `closed` dates the weekly
 * email reads. A guide's opening-day places are the guide itself, not news,
 * so they are left out (src/lib/newsletter.ts). "Added to the guide" is what
 * the date records, so that is what the page says: it is not an opening date.
 */
const RECENT_DAYS = 30;
const since = addDays(startOfDay(now), -RECENT_DAYS);
const places = await getNetworkEntries('places');
const openings = new Map(live.map((t) => [t.slug, openingDay(places.filter((p) => p.town.slug === t.slug))]));
const added = places
  .filter((p) => {
    const opened = openings.get(p.town.slug);
    if (!isOpen(p) || p.delisted || !p.data.added) return false;
    if (opened && p.data.added.getTime() <= opened.getTime()) return false;
    return p.data.added.getTime() >= since.getTime();
  })
  .sort((a, b) => b.data.added!.getTime() - a.data.added!.getTime())
  .slice(0, 6);
const closed = places
  .filter((p) => !isOpen(p) && !!p.data.closed && p.data.closed.getTime() >= since.getTime())
  .sort((a, b) => b.data.closed!.getTime() - a.data.closed!.getTime())
  .slice(0, 4);
const closedNote = (p: (typeof closed)[number]) =>
  p.data.statusNote ?? (p.data.status === 'closed' ? 'Permanently closed.' : 'Temporarily closed.');

/**
 * 6. What the next issue would hold, counted with the same rules as the
 * sample issue (/newsletter/sample/), so the preview and the sample agree.
 */
const sendDay = hub.newsletter?.sendDay ?? 'Thursday';
const send = nextSendDay(now, sendDay);
const issueListings = occurrences(events.filter((e) => !isCanceled(e)), { now: send, horizonDays: 14 });
const issueWeekend = weekendSections(issueListings, { now: send, horizonDays: 5 }).weekend;
const issueTowns = new Set(issueWeekend.map((e) => e.town.slug)).size;
const issueNew = places.filter((p) => isNewPlace(p, send, openings.get(p.town.slug))).length;
const issueClosed = places.filter((p) => isNewlyClosed(p, send)).length;
const { start: issueStart, sunday: issueSunday } = weekendWindow(send);
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

const description = `Independent guides to ${live.length} towns on Colorado’s Front Range: the week’s events, where to eat and drink, the trails, and what it’s like to live there.`;
---
<Base {description}>
  {/* 1. Compact introduction and town selector. */}
  <section class="container-page pb-10 pt-8 sm:pb-12 sm:pt-12 md:pt-16">
    <p class="eyebrow">Colorado’s Front Range</p>
    <h1 class="display mt-3 max-w-3xl text-[2.5rem] sm:text-5xl lg:text-6xl">
      Independent guides to the towns worth knowing.
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-muted sm:text-lg">
      What’s on this weekend, where to go, and what’s changing, one guide per town. Listings are editorial; nobody pays to be in them.
    </p>
    <nav aria-labelledby="town-picker" class="mt-7 sm:mt-8">
      <p id="town-picker" class="eyebrow">Pick your town</p>
      <ul class="mt-3 grid max-w-4xl grid-cols-3 gap-2 sm:grid-cols-4 lg:grid-cols-6">
        {atoz.map((t) => (
          <li class="flex">
            <a
              href={`https://${t.domain}/`}
              class="flex min-h-11 w-full items-center justify-center rounded-full bg-raised px-1 text-center text-[0.8125rem] font-semibold leading-tight text-ink no-underline ring-1 ring-line-soft transition hover:text-accent-text hover:ring-line sm:px-3 sm:text-sm md:text-[0.9375rem]"
            >{t.name}</a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  {/* 2. This weekend. */}
  {lead.length > 0 && (
    <section class="band-white py-12 md:py-16">
      {/* Below 640px: the first three, then "Everything on" after them. Hidden,
         not dropped, so Freshness can remove a past event and the next moves up. */}
      <div class="container-page max-sm:[&>:first-child>a]:hidden" data-events-scope>
        <SectionHeader
          eyebrow={leadIsWeekend ? `Across the towns · ${formatDayRange(weekendStart, sunday)}` : 'Across the towns'}
          title={leadIsWeekend ? 'This weekend' : 'What’s on next'}
          href="/this-weekend/"
          linkLabel="Everything on"
        />
        <div class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7 max-sm:[&>:nth-child(n+4)]:hidden">
          {lead.map((event) => <NetworkEventCard event={event} />)}
        </div>
        <p data-events-empty hidden class="rounded-lg border border-dashed border-line px-6 py-10 text-center text-ink-muted">
          Those dates have passed. <a href="/this-weekend/" class="font-semibold text-accent-text">See what’s on now.</a>
        </p>
        <a href="/this-weekend/" class="mt-3 inline-flex min-h-11 items-center text-[0.9375rem] font-semibold text-accent-text no-underline hover:underline sm:hidden">Everything on →</a>
      </div>
    </section>
  )}

  {/* 3. Featured story, then 4. the latest guides. */}
  {featured && (
    <section class="band-tint py-12 md:py-16">
      <div class="container-page">
        <SectionHeader eyebrow="From the guides" title="Featured story" />
        <ArticleCard article={featured} town={featured.town} feature />

        {latest.length > 0 && (
          <div class="mt-14 md:mt-20">
            <h2 class="display-md border-b border-line pb-4 text-3xl md:text-4xl">Latest guides</h2>
            <div class="mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
              {latest.map((article) => <ArticleCard article={article} town={article.town} compact />)}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  {/* 5. New around the towns. Not drawn when there is nothing to report. */}
  {(added.length > 0 || closed.length > 0) && (
    <section class="band-white py-12 md:py-16">
      <div class="container-page">
        <SectionHeader eyebrow={`The last ${RECENT_DAYS} days`} title="New around the towns" />
        <div class:list={['grid gap-10', added.length > 0 && closed.length > 0 && 'lg:grid-cols-[3fr_2fr] lg:gap-14']}>
          {added.length > 0 && (
            <div>
              <h3 class="text-xl">Added to the guides</h3>
              <ul class="mt-4 divide-y divide-line-soft border-y border-line-soft">
                {added.map((p) => (
                  <li class="py-4">
                    <p class="eyebrow" style={`color:${p.town.colors.accentDark}`}>
                      {p.town.name} <span class="text-ink-faint">·</span> <span class="text-ink-muted">{formatDate(p.data.added!)}</span>
                    </p>
                    <a href={`https://${p.town.domain}/places/${p.slug}/`} class="mt-1 block text-lg font-semibold text-ink no-underline hover:text-accent-text">{p.data.title}</a>
                    <p class="mt-1 text-[0.9375rem] leading-relaxed text-ink-muted line-clamp-2">{p.data.summary}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {closed.length > 0 && (
            <div>
              <h3 class="text-xl">Closed</h3>
              <ul class="mt-4 divide-y divide-line-soft border-y border-line-soft">
                {closed.map((p) => (
                  <li class="py-4">
                    <p class="eyebrow" style={`color:${p.town.colors.accentDark}`}>
                      {p.town.name} <span class="text-ink-faint">·</span> <span class="text-ink-muted">{formatDate(p.data.closed!)}</span>
                    </p>
                    <a href={`https://${p.town.domain}/places/${p.slug}/`} class="mt-1 block text-lg font-semibold text-ink no-underline hover:text-accent-text">{p.data.title}</a>
                    <p class="mt-1 text-[0.9375rem] leading-relaxed text-ink-muted">{closedNote(p)}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {/* 6. The newsletter, beside what this week's issue would hold. */}
  <section class="band-tint py-12 md:py-16">
    <div class="container-page grid items-start gap-8 lg:grid-cols-[3fr_2fr] lg:gap-12">
      <NewsletterSignup />
      <aside class="rounded-lg bg-raised p-6 ring-1 ring-line-soft md:p-8" aria-labelledby="issue-preview">
        <p class="eyebrow">What subscribers get</p>
        <h2 id="issue-preview" class="display-md mt-2 text-2xl leading-tight">
          {sendDay}’s issue, {formatDate(send)}
        </h2>
        <ul class="mt-5 divide-y divide-line-soft border-y border-line-soft text-[0.9375rem]">
          <li class="py-3">
            <strong class="font-semibold">The weekend, {formatDayRange(issueStart, issueSunday)}</strong>
            <span class="block text-ink-muted">
              {issueWeekend.length > 0
                ? `${plural(issueWeekend.length, 'listing', 'listings')} across ${plural(issueTowns, 'town', 'towns')}, a few picks from each`
                : 'Picks town by town as the listings fill in'}
            </span>
          </li>
          <li class="py-3">
            <strong class="font-semibold">New on the guides and closed</strong>
            <span class="block text-ink-muted">
              {issueNew + issueClosed > 0
                ? `${plural(issueNew, 'place', 'places')} added, ${plural(issueClosed, 'closure', 'closures')} so far this week`
                : 'Places added or closed since the last issue, when there are any'}
            </span>
          </li>
          <li class="py-3">
            <strong class="font-semibold">A new article</strong>
            <span class="block text-ink-muted">When there is one</span>
          </li>
        </ul>
        <a href="/newsletter/sample/" class="mt-5 inline-flex min-h-11 items-center text-[0.9375rem] font-semibold text-accent-text no-underline hover:underline">Read this week’s sample issue →</a>
      </aside>
    </div>
  </section>

  {/* 7. The towns: map and directory. */}
  <section id="towns" class="band band-white">
    <div class="container-page">
    <SectionHeader eyebrow="The network" title="The towns" />
    <div class="grid items-start gap-10 lg:grid-cols-[3fr_2fr] lg:gap-14">
      {/* Not on a phone: at 375px its labels are too small to read or tap. */}
      <div class="hidden sm:block">
        <TownMap towns={live} />
      </div>
      <div class="grid content-start gap-8 sm:gap-10">
        {regions.map(({ region, towns }) => (
          <div>
            <h3 class="mb-4 text-xl sm:mb-5 sm:text-2xl">{region}</h3>
            <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-1">
              {towns.map((t) => (
                <a
                  href={`https://${t.domain}/`}
                  class="group flex flex-col rounded-lg border-l-4 bg-raised p-4 no-underline ring-1 ring-line-soft transition hover:ring-line sm:block sm:p-6"
                  style={`border-color:${t.colors.accent}`}
                >
                  <p class="eyebrow" style={`color:${t.colors.accentDark}`}>{countyLabel(t)}</p>
                  <h4 class="mt-auto pt-1.5 text-xl font-medium leading-none sm:mt-2 sm:pt-0 sm:text-3xl">
                    <span class="hidden font-light italic sm:inline">Inside</span> <span class="font-semibold">{t.name}</span>
                  </h4>
                  <p class="mt-3 hidden text-[0.9375rem] leading-relaxed text-ink-muted sm:block">{t.tagline}</p>
                  <p class="mt-4 hidden text-sm font-semibold group-hover:underline sm:block" style={`color:${t.colors.accentDark}`}>{t.domain} →</p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
    </div>
  </section>
</Base>
