---
/**
 * The hub home opens typographically rather than with a photo: the map and
 * the town cards are the picture. Each card borrows its town's accent.
 *
 * It leads with the weekend. The network's numbers — guides, counties, people
 * — are a publisher's facts, and they used to sit where a reader looks first.
 * What a reader wants from the front page of a network of event guides is
 * what is on, so that comes straight after the headline and the numbers move
 * down under the map.
 */
import Base from '@/layouts/Base.astro';
import TownMap from '@/components/TownMap.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FactStrip from '@/components/FactStrip.astro';
import NetworkEventCard from '@/components/NetworkEventCard.astro';
import { getNetworkEntries } from '@/lib/content';
import { formatDayRange } from '@/lib/dates';
import { highlights, occurrences, oneOffs, weekendSections, weekendWindow } from '@/lib/events';
import { LIVE_TOWNS, countiesCovered, countyLabel, getHub } from '@/config';
import { groupByRegion } from '@/lib/regions';

const hub = getHub();
/**
 * Only live guides reach this page: the picker, the cards, the map and the
 * counts all read `live`. A town whose status is not `live` is not named
 * here at all until the owner flips it (6 October 2026); its domain serves a
 * holding page and the hub does not point at it.
 */
const live = hub.towns.filter((t) => LIVE_TOWNS.includes(t.slug));
/**
 * Most visitors came for one town. On a phone the cards were two screens of
 * events and a map away, so the hero ends in a row of names, A to Z, drawn
 * from the same live list as the cards so the two cannot disagree.
 */
const atoz = [...live].sort((a, b) => a.name.localeCompare(b.name, 'en'));
/** The cards, one group per region in TOWN_REGIONS order, A to Z within each; an empty region is not drawn. */
const regions = groupByRegion(live);
/**
 * The weekend across every guide, ranked the way a town's own home page ranks
 * its listings (highlights). On a Sunday night, or in a quiet week, the
 * weekend can be empty, and an empty band under the headline is worse than
 * none, so the block falls back to the week ahead and says which it is.
 *
 * One-offs lead: a festival is a reason to cross a county line and a weekly
 * trivia night is not. Only when the weekend is so quiet that regulars are
 * nearly all there is do they fill the block.
 */
const now = new Date();
const network = occurrences(await getNetworkEntries('events'), { now, horizonDays: 30 });
const sections = weekendSections(network, { now, horizonDays: 15 });
const onThisWeekend = [...sections.now, ...sections.weekend];
const picks = highlights(oneOffs(onThisWeekend, network), { now, limit: 6 });
const weekend = picks.length >= 3 ? picks : highlights(onThisWeekend, { now, limit: 6 });
const leadIsWeekend = weekend.length > 0;
const lead = leadIsWeekend ? weekend : highlights(sections.next, { now, limit: 6 });
const { start: weekendStart, sunday } = weekendWindow(now);
/**
 * The hub's own snippet. Without it the page falls back to `hub.tagline`,
 * which is 74 characters and says what the network is but not what is on a
 * town guide — the thing a searcher is deciding whether to click. The tagline
 * stays short because it is also the hero line and the Organization
 * description; this is written for the search result.
 */
const description = `Independent guides to ${live.length} towns on Colorado’s Front Range: the week’s events, where to eat and drink, the trails, and what it’s like to live there.`;
---
<Base {description}>
  {/* Set a little tighter below 640px so the whole picker fits on a phone's
     first screen; from sm up it is the hero it always was. */}
  <section class="container-page pb-14 pt-10 sm:pt-16 md:pt-28">
    <p class="eyebrow">Colorado’s Front Range</p>
    <h1 class="display mt-4 max-w-4xl text-[2.75rem] sm:mt-5 sm:text-7xl lg:text-8xl">
      Independent guides to the towns worth knowing.
    </h1>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-muted sm:mt-7 sm:text-lg md:text-2xl md:leading-relaxed">
      {hub.tagline} One site per town: the week’s events, where to eat and drink, the trails, and a straight
      account of what it’s like to live there.
    </p>
    <nav aria-labelledby="town-picker" class="mt-8 sm:mt-10 md:mt-14">
      <p id="town-picker" class="eyebrow">Pick your town</p>
      <ul class="mt-3 grid max-w-4xl grid-cols-3 gap-2 sm:grid-cols-4 lg:grid-cols-6">
        {atoz.map((t) => (
          <li class="flex">
            <a
              href={`https://${t.domain}/`}
              class="flex min-h-11 w-full items-center justify-center rounded-full bg-raised px-1 text-center text-[0.8125rem] font-semibold leading-tight text-ink no-underline ring-1 ring-line-soft transition hover:text-accent-text hover:ring-line sm:px-3 sm:text-sm md:text-[0.9375rem]"
            >{t.name}</a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  {lead.length > 0 && (
    <section class="band band-white">
      {/* Below 640px: the first three, then "Everything on" after them rather
         than in the header. Hidden, not dropped, so Freshness can still remove
         a past event and the next one moves up into the three. */}
      <div class="container-page max-sm:[&>:first-child>a]:hidden" data-events-scope>
        <SectionHeader
          eyebrow={leadIsWeekend ? `Across the towns · ${formatDayRange(weekendStart, sunday)}` : 'Across the towns'}
          title={leadIsWeekend ? 'This weekend' : 'What’s on next'}
          href="/this-weekend/"
          linkLabel="Everything on"
        />
        <div class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7 max-sm:[&>:nth-child(n+4)]:hidden">
          {lead.map((event) => <NetworkEventCard event={event} />)}
        </div>
        <p data-events-empty hidden class="rounded-lg border border-dashed border-line px-6 py-10 text-center text-ink-muted">
          Those dates have passed. <a href="/this-weekend/" class="font-semibold text-accent-text">See what’s on now.</a>
        </p>
        <a href="/this-weekend/" class="mt-3 inline-flex min-h-11 items-center text-[0.9375rem] font-semibold text-accent-text no-underline hover:underline sm:hidden">Everything on →</a>
      </div>
    </section>
  )}

  <section id="towns" class="band band-tint">
    <div class="container-page">
    <SectionHeader eyebrow="The network" title="The towns" />
    <div class="grid items-start gap-10 lg:grid-cols-[3fr_2fr] lg:gap-14">
      {/* Not on a phone: at 375px its labels are too small to read or tap. */}
      <div class="hidden sm:block">
        <TownMap towns={live} />
      </div>
      <div class="grid content-start gap-8 sm:gap-10">
        {regions.map(({ region, towns }) => (
          <div>
            <h3 class="mb-4 text-xl sm:mb-5 sm:text-2xl">{region}</h3>
            {/* A phone gets name and county only, two across, the names level along
               each row however the county line wraps; the card is still the link. */}
            <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-1">
              {towns.map((t) => (
                <a
                  href={`https://${t.domain}/`}
                  class="group flex flex-col rounded-lg border-l-4 bg-raised p-4 no-underline ring-1 ring-line-soft transition hover:ring-line sm:block sm:p-6"
                  style={`border-color:${t.colors.accent}`}
                >
                  <p class="eyebrow" style={`color:${t.colors.accentDark}`}>{countyLabel(t)}</p>
                  <h4 class="mt-auto pt-1.5 text-xl font-medium leading-none sm:mt-2 sm:pt-0 sm:text-3xl">
                    <span class="hidden font-light italic sm:inline">Inside</span> <span class="font-semibold">{t.name}</span>
                  </h4>
                  <p class="mt-3 hidden text-[0.9375rem] leading-relaxed text-ink-muted sm:block">{t.tagline}</p>
                  <p class="mt-4 hidden text-sm font-semibold group-hover:underline sm:block" style={`color:${t.colors.accentDark}`}>{t.domain} →</p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
    </div>
  </section>

  <section class="band band-white">
    <div class="container-page">
      <div class="max-w-4xl">
        <FactStrip
          size="number"
          facts={[
            { label: 'Guides live', value: String(live.length) },
            { label: 'Counties', value: String(countiesCovered(live).length) },
            { label: 'People covered', value: live.reduce((n, t) => n + (t.population ?? 0), 0).toLocaleString('en-US') },
          ]}
          note="Population at the 2020 census, summed across the live guides. Several of these towns have grown a long way since."
        />
      </div>
    </div>
  </section>

  <section class="on-dark bg-accent-dark text-white">
    <div class="container-page grid gap-8 py-16 md:grid-cols-[3fr_2fr] md:items-end md:py-24">
      <div>
        <p class="eyebrow text-highlight-ink">How it’s made</p>
        <h2 class="display-md mt-4 text-4xl lg:text-6xl">One guide per town, made the same careful way.</h2>
      </div>
      <div>
        <p class="text-lg leading-relaxed text-white/85">
          Never the town government, always linking to it. Editorial listings, not paid placement.
        </p>
        <a href="/about/" class="btn btn-light mt-6">About the network</a>
      </div>
    </div>
  </section>
</Base>
