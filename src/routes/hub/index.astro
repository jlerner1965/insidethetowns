---
/**
 * The hub's home, on the publication design the owner approved on 14
 * November 2026 (the home board), which replaced the home's own look of
 * 13 November: the hub's masthead and footer, its colours, and the
 * network's two faces, Fraunces and Instrument Sans. Top to bottom, each a
 * full-width band, paper and white in turn, in the owner's order (the
 * content order brief of 21 November 2026), the same on a phone and from
 * 900px:
 *
 *   1. The hero: the kicker, the headline and its line, the page's one
 *      search box, the way to the sections below, and the owner's
 *      photograph of the Flatirons.
 *   2. This weekend: a heading a day, Friday to Sunday, and under each the
 *      day's listings from the guides: a guide editor's pick first, else
 *      the best the organizers have confirmed, never two from one town
 *      (src/lib/hub-home.ts, weekendPicksByDay), and Friday's high-school
 *      game where the scores data has one, until Friday is over.
 *   3. This season: each annual-events season the owner has opened, its
 *      next date, the event on it, and how many towns hold it.
 *   4. Find your town: the full sections together, the seven guides and
 *      the four folded guides kept whole (fullSections), and the A to Z.
 *   5. Featured: the newest featured article and Colorado's Secret Trails,
 *      the current issue, static, its words changed by hand each issue.
 *   6. More stories: the next four featured articles.
 *   7. The Thursday email, on the hub's blue.
 *
 * High school scores have no section here since 21 November 2026: each
 * school's are on its town's sports pages. From 900px the column is
 * 1200px, the hero's photograph sits beside its words, the story and the
 * trail sit side by side, and the guides run four across.
 *
 * Every list reads what the rest of the hub reads: liveTowns() for the
 * guides, fullSections() for the sections, publishedHubTowns() for the town pages, the tradition records,
 * the guides' listings, weekly notes and changes, and the scores files.
 * Each dated row carries its last day, so the page's own script takes it
 * down once it has passed (Freshness.astro), and a block left with nothing
 * goes with it. "Today" on a season's next date is the reader's own day,
 * written by the script below and never in the built page. A section with
 * nothing to show is not drawn. The sections' links carry `data-track`
 * (home-…), so TrackClicks.astro counts which part of the page is used.
 */
import { Image, getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import { pub } from '@/components/hub/pub';
import { coverageLine, emailEditions, fullSections, getHub, guideUrl, listsEvents, liveTowns, sectionHome } from '@/config';
import { hubCountyLine } from '@/config/hub-towns';
import { schoolsFor, teamPath, type SportsData } from '@/config/school-sports';
import { getCuriosity, getNetworkEntries, getSectionArticles, getTraditions } from '@/lib/content';
import { ARTICLES_INDEX_PATH, articlePath, kindLabel } from '@/lib/curiosity';
import { placeName } from '@/lib/curiosity-places';
import { typeset } from '@/lib/text';
import { dayKey, formatDayLong, formatDayRange, formatMonthDay, monthDay, parseLocal, toIsoLocal } from '@/lib/dates';
import { clockText, displayTitle, isInProgress, lastDay, listedUntil, occurrences } from '@/lib/events';
import { publishedHubTowns } from '@/lib/hub-towns';
import {
  HOME_PHOTO,
  annualRecordFor,
  capitalized,
  dayOrder,
  deadlineListings,
  fridayGame,
  gameRow,
  guideLine,
  guideName,
  homeDescription,
  listWords,
  listingKey,
  listingReasons,
  newsItems,
  nextLine,
  numberWord,
  seasonFeatureLine,
  seasonsNow,
  storySourceText,
  townFinder,
  weekendDays,
  weekendPicksByDay,
} from '@/lib/hub-home';
import { shortCost } from '@/lib/cost';
import { resolveSiteImage } from '@/lib/images';
import { FLAGSHIP_TEAM, hasData, sportsDataFor } from '@/lib/school-sports';
import { coveredTowns, pagesBeyondSections, townCount } from '@/lib/town-search-index';
import { subTownsOf } from '@/lib/sub-towns';
import { TRADITION_TYPE_INFO } from '@/lib/traditions';
import { currentPicks } from '@/lib/weekly';
import { fitTitle } from '@/lib/titles';
import { ANNUAL_EVENTS_HREF } from '@/lib/nav';
import { META_DESCRIPTION_LIMIT, breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';
import { shownCategoryLabel } from '@/content/schemas';
// The italic of the heading face, for the decks and the day headings: the guides' pages do not use it, so it is loaded here only.
import '@fontsource-variable/fraunces/opsz-italic.css';

const hub = getHub();
/** The seven guides, in the one order every list uses (liveTowns()), and the town pages that are published. */
const live = liveTowns();
const records = await getTraditions();
const pages = publishedHubTowns(records);
const now = new Date();
const todayKey = dayKey(now);

/**
 * Every town a reader might type, each with its page (src/lib/hub-home.ts,
 * townFinder): a guide's name and the towns it covers to the guide, a town
 * it covers as a section of its own to that section, as /towns/ links
 * them, and every other town to its page. The hero's search box suggests
 * these names; the town box under "Find your town" goes straight to the page.
 */
const finder = townFinder(
  live.map((t) => {
    const sections = subTownsOf(t).filter((s) => s.slug !== t.slug);
    return {
      name: t.name,
      href: guideUrl(t),
      covered: [
        ...sections.map((s) => ({ name: s.label, href: guideUrl(t, `/${s.slug}/`) })),
        ...coveredTowns(t).map((name) => ({ name, href: guideUrl(t) })),
      ],
    };
  }),
  pages,
);

/** The photograph under the hero, and the same picture as the page's share image. */
const photo = resolveSiteImage('hub', HOME_PHOTO.hero);
const shareImage = (await getImage({ src: resolveSiteImage('hub', HOME_PHOTO.file), width: 1200, height: 630, format: 'jpg' })).src;

/**
 * This season: the annual events whose season is open, each with its count
 * by town and its next date (src/lib/hub-home.ts, seasonsNow). The rest are
 * one link away, on the annual events list.
 */
const seasons = seasonsNow(records, todayKey).map(({ type, counts, next }) => {
  const info = TRADITION_TYPE_INFO[type];
  const md = monthDay(parseLocal(next.entry.date!));
  return {
    key: type,
    month: md.month,
    day: md.day,
    weekday: md.weekday,
    title: info.plural,
    next: nextLine(next.record),
    line: counts.towns > 0 ? seasonFeatureLine(counts) : undefined,
    href: info.path,
    starts: next.entry.date!,
    until: next.entry.endDate ?? next.entry.date!,
  };
});

/**
 * This weekend. The listings are every guide's, expanded to their dates
 * (a series is known as one); the scores are each followed school's file
 * with CHSAA's brackets merged in; the editors' picks are each guide's
 * current weekly notes (src/lib/weekly.ts, currentPicks).
 */
const days = weekendDays(now);
const friday = days[0]!.key;
const listings = occurrences(await getNetworkEntries('events'), { now, horizonDays: 21 });
const sportsFiles = import.meta.glob<SportsData>('../../../data/*/sports*.json', { eager: true, import: 'default' });
const gameSources = live.flatMap((guide) =>
  schoolsFor(guide.slug).flatMap((school) => {
    const team = sportsDataFor(school, sportsFiles, now)?.sports.find((s) => s.key === FLAGSHIP_TEAM && hasData(s));
    return team ? [{ guide, town: guide.slug, school, team }] : [];
  }),
);
const found = fridayGame(gameSources, friday, listings);
// The game shows until Friday is over: from Saturday it has been played, and its final is on its school's sports page.
const game = found && friday >= todayKey ? found : undefined;
const programs = await getNetworkEntries('programs');
const weeklyNotes = await getNetworkEntries('weekly');
const picked = new Set(
  live.flatMap((t) =>
    currentPicks(
      weeklyNotes.filter((n) => n.town.slug === t.slug),
      listings.filter((e) => e.town.slug === t.slug),
      now,
      Infinity,
    ).map(listingKey),
  ),
);
/** Up to three a day, never two from one town across the weekend. */
const PER_DAY = 3;
const picks = weekendPicksByDay(
  listings,
  days.filter((d) => d.key >= todayKey),
  { now, taken: new Set(game ? [game.guide.slug] : []), order: live.map((t) => t.slug), exclude: deadlineListings(programs, listings), picked, perDay: PER_DAY },
);

interface Item {
  /** "Longmont · Run". */
  label: string;
  title: string;
  href: string;
  /** Why it earned the space, in a few words from its fields or its `why`; none where none holds. */
  reasons: string[];
  /** "9 am · Altona Middle School". */
  meta: string[];
  /**
   * A game's school colour (SchoolSports.colors), drawn only as a dot beside
   * the label line: the title is a link like every other listing's, never in
   * the school's colour (the post-migration fixes, 18 November 2026).
   */
  dot?: string;
  /** The last day it shows, and the instant it comes off where it has one (src/lib/expiry.ts). */
  until: string;
  end?: string;
  /** Its place in the day's clock order (src/lib/hub-home.ts, dayOrder). */
  at: number;
}

const weekend = days.flatMap((d) => {
  const items: Item[] = [];
  if (game && d.key === friday) {
    const { guide, school, team, listing } = game;
    const row = gameRow(game, displayTitle, clockText);
    items.push({
      label: `${guide.name} · Friday night lights`,
      title: row.title,
      href: row.final || !listing ? guideUrl(guide, `${teamPath(school, team.key)}`) : guideUrl(guide, `/events/${listing.slug}/`),
      reasons: row.reasons,
      meta: row.meta,
      dot: school.colors?.primary,
      until: friday,
      at: listing ? dayOrder(listing, friday) : game.game.time ? parseLocal(`${game.game.date}T${game.game.time}`).getTime() : Number.MAX_SAFE_INTEGER,
    });
  }
  for (const e of picks.get(d.key) ?? []) {
    const { data } = e;
    const multiDay = !!data.end && dayKey(data.start) !== dayKey(data.end);
    // As the hub's weekend page words a listing (NetworkEventCard.astro).
    const when = data.timeNote ?? (multiDay && isInProgress(e, now) ? `Now through ${formatMonthDay(data.end!)}` : multiDay && data.allDay ? formatDayRange(data.start, data.end!) : clockText(e));
    const category = shownCategoryLabel(data.category);
    const title = displayTitle(e);
    const reasons = listingReasons(e, { pickedBy: picked.has(listingKey(e)) && !data.featured ? e.town.siteTitle : undefined, annual: annualRecordFor(e, title, records)?.entry });
    items.push({
      label: category ? `${e.town.name} · ${category}` : e.town.name,
      title,
      href: guideUrl(e.town, `/events/${e.slug}/`),
      reasons,
      // "Free" is said once, as the reason, where it is one; any other cost as a row can carry it,
      // "From $70" for a line of every ticket price (src/lib/cost.ts, shortCost). The listing's page has it whole.
      meta: [when, data.venue, reasons.includes('Free') ? undefined : shortCost(data.cost)].filter((s): s is string => !!s),
      until: lastDay(e),
      end: toIsoLocal(listedUntil(e)),
      at: dayOrder(e, d.key),
    });
  }
  // The game among the day's listings in the order of the clock, not ahead of them.
  items.sort((a, b) => a.at - b.at);
  return items.length > 0 ? [{ key: d.key, heading: formatDayLong(d.date), items }] : [];
});

/**
 * In the towns: the five newest featured articles (the owner, 18 November
 * 2026: `feature: true` in the article's file; every article is off until
 * the owner sets it), the hub's own and the full sections' alike, the
 * newest first (src/lib/hub-home.ts, newsItems). A featured section article
 * (Estes Park's) is here and stays in its section; an unfeatured one never
 * is (onHub, src/lib/curiosity-places.ts). A featured article with a
 * `homeUntil` leaves on that day, whatever its kind. A hub article's label
 * is its eyebrow where it has one ("News · Front Range", "History ·
 * Creede"), else its towns and its kind; a section article's is its town
 * and its subject. "All articles" keeps every article on the hub.
 */
const HOME_NEWS_LIMIT = 5;
const articlesOnSite = (await getCuriosity()).map((a) => a.data);
const sectionArticles = await getSectionArticles();
/** An article's address by its slug, for a `homeAfter` naming another hub article. */
const pathBySlug = new Map(articlesOnSite.map((a) => [a.slug, articlePath(a)]));
const news = newsItems(
  [
    ...articlesOnSite.map((a) => ({
      towns: a.towns,
      feature: a.feature,
      label: a.eyebrow ?? `${a.towns.slice(0, 2).map((t) => placeName(t) ?? t).join(' · ')} · ${kindLabel(a.kind)}`,
      title: a.title,
      line: a.description,
      href: articlePath(a),
      date: a.date,
      until: a.homeUntil,
      after: a.homeAfter && pathBySlug.get(a.homeAfter),
      source: storySourceText(a.sources),
    })),
    ...sectionArticles.map((a) => ({
      towns: [a.town.slug],
      feature: a.data.feature,
      label: `${a.town.name} · ${a.data.category}`,
      title: a.data.title,
      line: a.data.excerpt,
      href: `${sectionHome(a.town)}articles/${a.slug}/`,
      date: dayKey(a.data.date),
      until: a.data.homeUntil && dayKey(a.data.homeUntil),
      // The guide's sources were read on the day it was last verified.
      source: a.data.verified && storySourceText(a.data.sources.map((s) => ({ label: s.label, checked: dayKey(a.data.verified!) }))),
    })),
  ],
  todayKey,
  HOME_NEWS_LIMIT,
).map((i) => {
  const md = monthDay(parseLocal(i.date));
  return { ...i, byline: `${i.label} · ${md.month} ${md.day}` };
});

/**
 * Find your town: the full sections together (the owner's navigation brief
 * of 18 November 2026: the seven guides and Estes Park, Fort Collins,
 * Longmont and Loveland, src/config/index.ts, fullSections), each with the
 * towns it covers, its counties and its line, and its front page.
 */
const sectionList = fullSections();
const sections = sectionList.map((t) => ({ name: guideName(t, coveredTowns(t)), line: [hubCountyLine(t), guideLine(t)].join(' · '), coverage: coverageLine(t), href: sectionHome(t) }));
/** How many of the sections list events, said once over the cards, each card saying its own. */
const withCalendar = numberWord(sectionList.filter(listsEvents).length);
const sectionCount = numberWord(sections.length);
/**
 * "N more towns": the town pages for towns no full section covers. Severance
 * has a page of its own and is in "Windsor and Severance" too, and
 * Longmont's town page is its section's front page, so neither is counted
 * twice. /towns/ counts and lists by the same rule.
 */
const moreTowns = pagesBeyondSections(pages, sectionList).length;
// The whole count, as the A to Z link says it, by the one rule (townCount; the owner, 20 November 2026): 11 + 91 + Severance = 103.
const allTowns = townCount(pages, sectionList);

/** The email: one town to start, from the weekly editions (NewsletterSignup.astro, variant "hub"). */
const sendDay = hub.newsletter?.sendDay ?? 'Thursday';
/** The guides with no weekly edition, and so not in the list (src/config/index.ts, emailTowns): "Niwot has no weekly issue." */
const emailed = new Set(emailEditions().flatMap((e) => e.towns.map((t) => t.slug)));
/** The towns the email covers, by name, said in the band's line (the owner's review of 19 November 2026: "your town's" read as every town). */
const emailNames = live.filter((t) => emailed.has(t.slug)).map((t) => t.name);
const withEmail = numberWord(emailNames.length);
/** Every full section with no weekly issue, the folded guides as well as Niwot: a Longmont reader is told, not left to find out. */
const noWeekly = sectionList.filter((t) => !emailed.has(t.slug)).map((t) => t.name);
const noWeeklyLine = noWeekly.length > 0 ? ` ${listWords(noWeekly)} ${noWeekly.length === 1 ? 'has' : 'have'} no weekly issue.` : '';
/** The guides This weekend is drawn from: the ones that list events (getNetworkEntries), named in its line. */
const weekendNames = live.filter(listsEvents).map((t) => t.name);

/** The hero's way to the sections below, each to one the page draws. */
const jumps = [
  weekend.length > 0 && { label: 'This weekend', href: '#weekend' },
  seasons.length > 0 && { label: 'This season', href: '#season' },
  { label: 'Find your town', href: '#towns' },
].filter((j) => !!j);

/**
 * The title and description say what the page is: this weekend's events,
 * the full sections and the annual dates, the words people search with,
 * the longest form that fits 155 characters (src/lib/hub-home.ts,
 * homeDescription). The title is short enough to keep the site's
 * name (fitTitle drops it past 60 characters) and says "town" once:
 * "Colorado events this weekend, town by town" ran 61 with the name, so
 * it went out without it, and a checker counts the repeated word
 * (the Seobility check of 15 November 2026).
 */
const fullTitle = fitTitle('Colorado town events this weekend', hub.siteTitle);
const description = homeDescription({ sections: sections.length, moreTowns, seasons: seasons.map((r) => r.title) }, META_DESCRIPTION_LIMIT);

/** What the page lists, for search engines. Their Event markup stays on the pages that own them. */
// The CollectionPage, and a BreadcrumbList of one step: the only page of the site without one (the site audit of 19 November 2026).
const structured = [collectionPageJsonLd(hub, {
  name: 'What’s happening in Colorado’s towns',
  description,
  path: '/',
  items: [
    ...weekend.flatMap((d) => d.items.map((r) => ({ name: r.title, url: r.href }))),
    ...news.map((i) => (/^https?:/.test(i.href) ? { name: i.title, url: i.href } : { name: i.title, path: i.href })),
    ...seasons.map((r) => ({ name: r.title, path: r.href })),
    { name: 'Everything on this weekend', path: '/this-weekend/' },
  ],
}), breadcrumbJsonLd(hub, [{ name: hub.siteTitle, path: '/' }])];

const dek = 'mt-2 font-heading text-[1.0588rem] font-normal italic leading-[1.45] text-ink-muted [font-variation-settings:normal]';
const by = 'text-meta font-semibold leading-[1.4] text-ink-muted';
const hl = 'mt-1 text-[1.2941rem] font-medium leading-[1.2] tracking-normal text-ink [font-variation-settings:normal]';
const more = 'mt-2.5 flex min-h-11 items-center text-base font-[650] text-primary underline decoration-1 underline-offset-[3px]';
const dateMonth = `${pub.cap} text-primary`;
const dateDay = 'mt-0.5 whitespace-nowrap font-heading text-date leading-none tracking-[-0.02em] text-primary [font-variation-settings:normal]';
/*
 * The layout above 900px (the owner's desktop boards, 14 November 2026):
 * the column is 1200px with 40px sides, a band has 64px over it and 72px
 * under it, and each section is a band of its own, in the phone's order.
 * Below 900px every grid is one column.
 */
const band = 'px-[20px] pb-[48px] pt-[36px] desk:px-0 desk:pb-[72px] desk:pt-[64px]';
const wide = 'mx-auto w-full max-w-[720px] desk:max-w-[1200px] desk:px-[40px]';
---
<Base {fullTitle} {description} image={shareImage} imageAlt={HOME_PHOTO.alt} jsonLd={structured}>
  {/* The hero: what the page is, the search, and the way to the sections below; the photograph beside it from 900px. */}
  <section class="bg-paper px-[20px] pb-[30px] pt-6 desk:px-0 desk:pb-[64px] desk:pt-[56px]" aria-labelledby="hero-h" data-band>
    <div class:list={[wide, 'desk:grid desk:grid-cols-[7fr_5fr] desk:items-start desk:gap-x-[56px]']}>
      <div class="min-w-0">
        <p class:list={[pub.cap, 'text-ink-muted']}>Colorado, plains to peaks</p>
        <h1 id="hero-h" class="mt-2.5 text-[2.2353rem] font-medium leading-[1.04] tracking-[-0.025em] text-ink [font-variation-settings:normal] desk:max-w-[12em] desk:text-[3.4118rem] desk:leading-[1.02]">What’s happening in Colorado’s towns</h1>
        <p class="mt-2 font-heading text-[1.1176rem] font-normal italic leading-[1.45] text-ink [font-variation-settings:normal] desk:text-[1.2353rem]">Find Colorado’s town traditions, this weekend’s events and local stories — from parades of lights to Friday night games.</p>
        {/* The page's one search box (the content order brief of 21 November 2026): the site's search (src/pages/search.astro), which on the hub holds every guide's places, guides and events as well as the town pages; every town's name is offered as it is typed (`home-names`). */}
        <form role="search" action="/search/" method="get" class="mt-5 desk:mt-[22px] desk:max-w-[560px]" data-track="home-search">
          {/* On a phone the box and its button say what it is, so the label is for screen readers there; it shows from 900px. */}
          <label for="home-q" class="max-desk:sr-only block text-[0.9412rem] font-[650] text-ink">Search towns and events</label>
          <div class="flex desk:mt-2">
            <input id="home-q" name="q" type="search" list="home-names" autocomplete="off" placeholder="A town or an event" class="block h-12 min-w-0 flex-1 rounded-l-[2px] border border-r-0 border-ink-muted bg-raised px-3.5 text-[0.9412rem] text-ink placeholder:text-ink-muted" />
            <button type="submit" class="h-12 shrink-0 cursor-pointer rounded-r-[2px] border-0 bg-primary px-[18px] text-base font-semibold text-white hover:bg-primary-hover">Search</button>
          </div>
          <datalist id="home-names">
            {finder.map((t) => <option value={t.name} data-href={t.href} />)}
          </datalist>
        </form>
        {/*
          * One row at every width, between two hairlines: on a phone, three
          * rows of their own took a third of the screen. The phone's row is
          * the meta size with no arrows, spread to the column's edges: what
          * fits all three on a 360px phone.
          */}
        <ul class="mt-2.5 flex flex-wrap justify-between gap-x-3 border-y border-hairline desk:justify-start desk:gap-x-7" data-jumps>
          {jumps.map((j) => (
            <li><a href={j.href} class="flex min-h-[46px] items-center text-meta font-[650] leading-[1.3] text-primary underline decoration-1 underline-offset-[3px] desk:text-[0.9412rem]" data-jump={j.href.slice(1)} data-track="home-jump">{j.label}<span class="hidden desk:inline">&nbsp;→</span></a></li>
          ))}
        </ul>
      </div>
      {/* On a phone a 3:1 strip of the photograph, so it does not push the sections below the first screen; beside the words from 900px. */}
      <figure class="mt-5 desk:mt-0">
        <div class="aspect-[3/1] overflow-hidden bg-hairline desk:aspect-auto desk:h-[400px]">
          <Image src={photo} alt={HOME_PHOTO.alt} widths={[480, 640, 800, 960, 1280, 1600]} sizes="(min-width: 900px) 800px, (max-width: 760px) 100vw, 720px" layout="full-width" quality={78} priority class="block h-full! w-full object-cover" />
        </div>
        <figcaption class:list={['mt-2 italic', pub.meta]}>{HOME_PHOTO.caption}</figcaption>
      </figure>
    </div>
  </section>

  {/*
    * Below the hero, one band a section, in the owner's order (the content
    * order brief of 21 November 2026), the same on a phone and from 900px:
    * This weekend, This season, Find your town, the featured story and the
    * featured trail together, more stories, then the email. Paper and white
    * in turn.
    */}
  {weekend.length > 0 && (
    <section id="weekend" aria-labelledby="weekend-heading" data-band data-hide-when-empty class:list={[band, pub.white]}>
      <div class={wide}>
        <div class={pub.open}>
          <h2 id="weekend-heading" class={pub.h2}>This weekend</h2>
          <p class={dek}>From the calendars of {listWords(weekendNames)}. Each opens on that town’s page, with the source it was checked against.</p>
        </div>
        {weekend.map((d) => (
          <div data-day={d.key}>
            <h3 class={pub.h3}>{d.heading}</h3>
            {d.items.map((r) => (
              <article class:list={['py-4 desk:grid desk:grid-cols-[1.35fr_1fr] desk:gap-x-7', pub.rule]} data-event-day={r.until} data-end={r.end}>
                {/* What it is; from 900px, when and where beside it. */}
                <div class="min-w-0">
                  <p class:list={[by, r.dot && 'flex items-center gap-2']}>{r.dot && <span class="inline-block size-2.5 shrink-0 rounded-full" style={`background:${r.dot}`} aria-hidden="true" data-school-dot></span>}{r.label}</p>
                  <h4 class={hl}><a href={r.href} class={pub.titleLink} data-track="home-weekend">{typeset(r.title)}</a></h4>
                  {r.reasons.length > 0 && <p class:list={['mt-1.5', pub.t]}>{typeset(r.reasons.join(' · '))}</p>}
                </div>
                <div class="min-w-0">
                  {r.meta.length > 0 && <p class={pub.t}>{typeset(r.meta.join(' · '))}</p>}
                </div>
              </article>
            ))}
          </div>
        ))}
        <a href="/this-weekend/" class={more} data-track="home-weekend">Everything on this weekend →</a>
      </div>
    </section>
  )}

  {seasons.length > 0 && (
    <section id="season" aria-labelledby="season-heading" data-band data-hide-when-empty class:list={[band, pub.paper]}>
      <div class={wide}>
        <div class={pub.open}>
          <h2 id="season-heading" class={pub.h2}>This season</h2>
          <p class={dek}>Annual events coming up, and how many towns hold them.</p>
        </div>
        <div class="desk:grid desk:grid-cols-2 desk:gap-x-8">
          {seasons.map((r) => (
            <article class:list={['grid grid-cols-[58px_minmax(0,1fr)] gap-x-3.5 py-4', pub.rule]} data-event-day={r.until} data-season-row data-starts={r.starts} data-ends={r.until}>
              <div aria-hidden="true">
                <p class={dateMonth}>{r.month.toUpperCase()}</p>
                <p class={dateDay}>{r.day}</p>
                <p class:list={['mt-1', pub.meta]}>{r.weekday}</p>
              </div>
              <div class="min-w-0">
                <h3 class:list={[hl, 'mt-0']}><a href={r.href} class={pub.titleLink} data-track="home-season">{r.title}</a></h3>
                <p class:list={['mt-1', pub.t]}><span data-next-word>Next: </span>{typeset(r.next)}</p>
                {r.line && <p class:list={['mt-1', pub.meta]}>{r.line}</p>}
              </div>
            </article>
          ))}
        </div>
        <a href={ANNUAL_EVENTS_HREF} class={more} data-track="home-season">All annual events →</a>
      </div>
    </section>
  )}

  <section id="towns" aria-labelledby="towns-heading" data-band class:list={[band, pub.white]}>
    <div class={wide}>
      <div class={pub.open}>
        <h2 id="towns-heading" class={pub.h2}>Find your town</h2>
        <p class={dek}>{capitalized(sectionCount)} towns with a section of their own: {withCalendar} with an events calendar, {withEmail} of them in the Thursday email. Every other town has a page of annual dates.</p>
      </div>
      <h3 class={pub.h3}>{capitalized(sectionCount)} full sections</h3>
      <div class="sm:grid sm:grid-cols-2 sm:gap-x-8 desk:grid-cols-4" data-index="sections">
        {sections.map((g) => (
          <div class:list={['py-4', pub.rule]}>
            <h4 class:list={[hl, 'mt-0']}><a href={g.href} class={pub.titleLink} data-track="home-index">{g.name}</a></h4>
            <p class:list={['mt-0.5', pub.meta]}>{g.line}</p>
            <p class:list={['mt-0.5', pub.meta]} data-coverage>{g.coverage}</p>
          </div>
        ))}
      </div>
      {/* Every other town: its page from the A to Z, or its name in the search at the top of the page, which suggests every town as it is typed. */}
      <h3 class={pub.h3}>Every other town</h3>
      {/* `town-pages`: where the guides' About pages send a reader for "a page on Inside the Towns". */}
      {moreTowns > 0 && <a id="town-pages" href="/towns/" class={more} data-track="home-index">All {allTowns} towns, A to Z →</a>}
    </div>
  </section>

  {/*
    * The featured story and the featured trail, together: the newest
    * featured article (news, src/lib/hub-home.ts) and Colorado's Secret
    * Trails, text only and static, changed by hand each issue (the owner, 19
    * November 2026). The story first, the trail after it, on a phone and
    * from 900px alike (beside it there).
    */}
  <section id="featured" aria-labelledby="featured-heading" data-band class:list={[band, pub.paper]}>
    <div class:list={[wide, news.length > 0 && 'desk:grid desk:grid-cols-[8fr_4fr] desk:items-start desk:gap-x-[56px]']}>
      {news.slice(0, 1).map((i) => (
        <div class="min-w-0">
          <div class={pub.open}>
            <h2 id="featured-heading" class={pub.h2}>Featured story</h2>
          </div>
          <article class:list={['py-[18px]', pub.rule]} data-event-day={i.until}>
            <p class={by}>{i.byline}</p>
            <h3 class:list={[hl, 'text-[1.5294rem] leading-[1.15] desk:text-[1.8824rem]']}><a href={i.href} rel={/^https?:/.test(i.href) ? 'noopener' : undefined} class={pub.titleLink} data-track="home-news">{typeset(i.title)}</a></h3>
            <p class:list={['mt-2', pub.t]}>{typeset(i.line)}</p>
            {i.source && <p class:list={['mt-2', pub.meta]}>{i.source}</p>}
          </article>
        </div>
      ))}
      <div class:list={['min-w-0', news.length > 0 && 'mt-10 desk:mt-0']}>
        <div class={pub.open}>
          {news.length > 0 ? (
            <h3 class={pub.h2}>Colorado’s Secret Trails</h3>
          ) : (
            <h2 id="featured-heading" class={pub.h2}>Colorado’s Secret Trails</h2>
          )}
        </div>
        <article class:list={['py-4', pub.rule]}>
          <h3 class={hl}><a href="/articles/bent-rock-trail-red-mountain-open-space/" class={pub.titleLink} data-track="home-secret-trail">Bent Rock Trail at Red Mountain Open Space</a></h3>
          <p class:list={['mt-1.5', pub.t]}>Nearest town: Wellington. Red-rock country 25 miles north of Fort Collins. Closes for the winter Dec. 1.</p>
        </article>
        <a href="/colorados-secret-trails/" class={more} data-track="home-secret-trail">All secret trails →</a>
      </div>
    </div>
  </section>

  {news.length > 1 && (
    <section id="news" aria-labelledby="news-heading" data-band data-hide-when-empty class:list={[band, pub.white]}>
      <div class={wide}>
        <div class={pub.open}>
          <h2 id="news-heading" class={pub.h2}>More stories</h2>
          <p class={dek}>Stories from the towns, each with its sources.</p>
        </div>
        <div class="desk:grid desk:grid-cols-2 desk:gap-x-8">
          {news.slice(1).map((i) => (
            <article class:list={['py-4', pub.rule]} data-event-day={i.until}>
              <p class={by}>{i.byline}</p>
              <h3 class={hl}><a href={i.href} rel={/^https?:/.test(i.href) ? 'noopener' : undefined} class={pub.titleLink} data-track="home-news">{typeset(i.title)}</a></h3>
              {i.source && <p class:list={['mt-1.5', pub.meta]}>{i.source}</p>}
            </article>
          ))}
        </div>
        {articlesOnSite.length > 0 && <a href={ARTICLES_INDEX_PATH} class={more} data-track="home-news">All articles →</a>}
      </div>
    </section>
  )}

  {/*
    * The email last, after the towns (the owner's order of 13 November
    * 2026: the weekend, the season, the index, the email; the review of
    * 19 November 2026: a first-time reader was asked to sign up before seeing
    * a story or a town). The masthead's email link still lands on #signup.
    */}
  {hub.newsletter && (
    <section id="email" aria-labelledby="signup-heading" data-band class:list={['on-dark bg-primary text-white', band]}>
      <div class:list={[wide, 'desk:grid desk:grid-cols-[5fr_7fr] desk:items-start desk:gap-x-[56px]']}>
        <div class="border-t-2 border-white pt-3">
          <h2 id="signup-heading" class:list={[pub.h2, 'mt-0 text-white']}>The {sendDay} email</h2>
          {/* What an edition holds and when it goes, in the words the owner confirmed on 14 November 2026, and since 19 November 2026 for which towns; "7 am" kept on one line. */}
          <p class:list={[dek, 'text-white']}>For {listWords(emailNames)}: the weekend’s events, the scores, and what opened or closed. Every Thursday at 7&nbsp;am.</p>
        </div>
        {/* `signup`: the form's own anchor, where the masthead's email link lands (Header.astro). */}
        <NewsletterSignup variant="hub" id="home" anchor="signup">
          <p class="mt-3 text-meta leading-[1.5] text-white">One town to start; add others any time.{noWeeklyLine} Free, unsubscribe any time · <a class="text-white underline decoration-1 underline-offset-[3px]" href="/privacy/">Privacy</a></p>
        </NewsletterSignup>
      </div>
    </section>
  )}
</Base>

<script>
  // "Today" on a season's next date, by the reader's own Denver day: never
  // in the built page, which a stale build would leave saying it.
  const today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Denver' });
  for (const row of document.querySelectorAll<HTMLElement>('[data-season-row]')) {
    const { starts, ends } = row.dataset;
    const word = row.querySelector<HTMLElement>('[data-next-word]');
    if (!starts || !word || today < starts || today > (ends ?? starts)) continue;
    const tag = document.createElement('span');
    tag.className = 'mr-1.5 inline-block bg-highlight-soft px-1.5 py-px text-cap font-[650] uppercase tracking-[0.06em] text-ink';
    tag.textContent = 'Today';
    word.replaceWith(tag);
  }
  // A jump to a section the page's other script took away (its dates had all passed) goes with it.
  for (const jump of document.querySelectorAll<HTMLElement>('[data-jump]')) {
    if (!document.getElementById(jump.dataset.jump ?? '')) jump.closest('li')?.remove();
  }
</script>
