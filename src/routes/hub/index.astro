---
/**
 * The hub's home, on the approved design of 13 November 2026
 * (docs/design/hub-home-mockup.html), reordered the same day to lead with
 * what is changing: its own masthead, type, colours and footer
 * (src/styles/hub-home.css), the guides keeping theirs. Top to bottom:
 *
 *   1. The masthead: the wordmark and six links; a menu button on a phone.
 *   2. A compact hero: the headline, one line, the search, and the owner's
 *      photograph of the Flatirons beside it (under it on a phone).
 *   3. The guides as one line of links, and the count of the town pages.
 *   4. This weekend: one listing a day, Friday to Sunday, each with the
 *      reason it is there where a field supports one. Friday's is the
 *      high-school football game where the scores data has one, its final
 *      once posted; otherwise, and on Saturday and Sunday, a guide editor's
 *      pick first, else a one-off the organizer has confirmed, never two
 *      from one town (src/lib/hub-home.ts). Beside it: the nearest
 *      registration deadline (else the local change) and the schools'
 *      score pages.
 *   5. This season: the annual events whose season is open (a season the
 *      owner has set with a year), each with its count and next date, and
 *      the way to all the annual events.
 *   6. The seven guides as an index, and the town pages.
 *   7. The Thursday email, to every town.
 *   8. The footer: the independence line and five links.
 *
 * Every list reads what the rest of the hub reads: liveTowns() for the
 * guides, publishedHubTowns() for the town pages, the tradition records for
 * the seasons, the guides' own listings, weekly notes, changes and
 * programs, and the scores files. Each dated row carries its last day, so
 * the page's own script takes it down once it has passed (Freshness.astro),
 * and a block left with nothing goes with it. A section with nothing to
 * show is not drawn. The sections' links carry `data-track` (home-…), so
 * TrackClicks.astro counts which part of the page is used.
 */
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@/styles/hub-home.css';
import newsreaderLatin from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import { Image, getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import { emailEditions, getHub, liveTowns } from '@/config';
import { schoolTeamName, schoolsFor, sportsPath, teamPath, type SportsData } from '@/config/school-sports';
import { getNetworkEntries, getTraditions } from '@/lib/content';
import { dayKey, formatDayRange, formatMonthDay, monthDay, parseLocal, toIsoLocal } from '@/lib/dates';
import { clockText, displayTitle, isInProgress, lastDay, listedUntil, occurrences } from '@/lib/events';
import { publishedHubTowns } from '@/lib/hub-towns';
import {
  HOME_PHOTO,
  annualRecordFor,
  capitalized,
  changeSourceText,
  deadlineListings,
  deadlineSourceText,
  deadlineTitle,
  fridayGame,
  gameRow,
  guideLine,
  guideName,
  listingKey,
  listingReasons,
  nextLine,
  numberWord,
  pickDeadline,
  provenanceText,
  searchSuggestions,
  seasonFeatureLine,
  seasonsNow,
  sportsSourceText,
  weekendDays,
  weekendPicks,
} from '@/lib/hub-home';
import { resolveSiteImage } from '@/lib/images';
import { upcomingDeadlines } from '@/lib/programs';
import { FLAGSHIP_TEAM, hasData, sportsDataFor } from '@/lib/school-sports';
import { coveredTowns } from '@/lib/town-search-index';
import { TRADITION_TYPE_INFO } from '@/lib/traditions';
import { currentPicks } from '@/lib/weekly';
import { wordmarkParts } from '@/lib/titles';
import { expiresOn, networkChanges, timing } from '@/lib/updates';
import { shownCategoryLabel } from '@/content/schemas';

const hub = getHub();
/** The seven guides, in the one order every list uses (liveTowns()), and the town pages that are published. */
const live = liveTowns();
const records = await getTraditions();
const pages = publishedHubTowns(records);
const now = new Date();
const todayKey = dayKey(now);
const guideUrl = (t: { domain: string }) => `https://${t.domain}/`;

/** What the search box offers as a name is typed: the guides and the town pages. */
const names = searchSuggestions(live, pages);

/** The photograph beside the hero, and the same picture as the page's share image. */
const photo = resolveSiteImage('hub', HOME_PHOTO.file);
const shareImage = (await getImage({ src: photo, width: 1200, height: 630, format: 'jpg' })).src;

/**
 * 5. This season: the annual events whose season is open, each with its
 * count by town as of today and its next date (src/lib/hub-home.ts,
 * seasonsNow). The rest are one link away, on /towns/.
 */
const seasons = seasonsNow(records, todayKey).map(({ type, counts, next }) => {
  const info = TRADITION_TYPE_INFO[type];
  const day = parseLocal(next.entry.date!);
  const md = monthDay(day);
  return {
    key: type,
    dayLabel: md.month,
    dayNum: md.day,
    weekday: md.weekday,
    title: info.plural,
    next: nextLine(next.record),
    line: counts.towns > 0 ? seasonFeatureLine(counts) : undefined,
    href: info.path,
    until: next.entry.endDate ?? next.entry.date!,
  };
});

/**
 * 4. This weekend. The listings are every guide's, expanded to their
 * dates (a series is known as one); the scores are each followed school's
 * file with CHSAA's brackets merged in; the editors' picks are each guide's
 * current weekly notes (src/lib/weekly.ts, currentPicks).
 */
const days = weekendDays(now);
const friday = days[0]!.key;
const sunday = days[2]!.key;
const listings = occurrences(await getNetworkEntries('events'), { now, horizonDays: 21 });
const sportsFiles = import.meta.glob<SportsData>('../../../data/*/sports*.json', { eager: true, import: 'default' });
const gameSources = live.flatMap((guide) =>
  schoolsFor(guide.slug).flatMap((school) => {
    const team = sportsDataFor(school, sportsFiles, now)?.sports.find((s) => s.key === FLAGSHIP_TEAM && hasData(s));
    return team ? [{ guide, town: guide.slug, school, team }] : [];
  }),
);
const found = fridayGame(gameSources, friday, listings);
// A game still to come shows until Friday is over; its final, once the Saturday run posts it, through Sunday.
const game = found && (found.game.result || friday >= todayKey) ? found : undefined;
const programs = await getNetworkEntries('programs');
const weeklyNotes = await getNetworkEntries('weekly');
const picked = new Set(
  live.flatMap((t) =>
    currentPicks(
      weeklyNotes.filter((n) => n.town.slug === t.slug),
      listings.filter((e) => e.town.slug === t.slug),
      now,
      Infinity,
    ).map(listingKey),
  ),
);
const picks = weekendPicks(
  listings,
  days.filter((d) => d.key >= todayKey && !(game && d.key === friday)),
  { now, taken: new Set(game ? [game.guide.slug] : []), order: live.map((t) => t.slug), exclude: deadlineListings(programs, listings), picked },
);

interface Row {
  key: string;
  dayLabel: string;
  dayNum: string;
  label: string;
  title: string;
  href: string;
  meta: string[];
  /** Why it earned the space, in a few words from its fields; none where none holds. */
  reasons?: string[];
  check?: string;
  /** The last day it shows, and the instant it comes off where it has one (src/lib/expiry.ts). */
  until: string;
  end?: string;
}

const weekendRows: Row[] = days.flatMap((d): Row[] => {
  const md = monthDay(d.date);
  const head = { key: d.key, dayLabel: md.weekday, dayNum: md.day };
  if (game && d.key === friday) {
    const { guide, school, team, listing } = game;
    const row = gameRow(game, displayTitle, clockText);
    const source = row.final || !listing ? sportsSourceText(team, game.game, !!school.calendar) : provenanceText(listing);
    return [{
      ...head,
      label: `${guide.name} · Friday night lights`,
      title: row.title,
      href: row.final || !listing ? `https://${guide.domain}${teamPath(school, team.key)}` : `https://${guide.domain}/events/${listing.slug}/`,
      meta: row.meta,
      reasons: row.reasons,
      check: row.final ? source : [source, 'Final score here Saturday morning'].filter(Boolean).join(' · '),
      until: row.final ? sunday : friday,
    }];
  }
  const e = picks.get(d.key);
  if (!e) return [];
  const { data } = e;
  const multiDay = !!data.end && dayKey(data.start) !== dayKey(data.end);
  // As the hub’s weekend page words a listing (NetworkEventCard.astro).
  const when = data.timeNote ?? (multiDay && isInProgress(e, now) ? `Now through ${formatMonthDay(data.end!)}` : multiDay && data.allDay ? formatDayRange(data.start, data.end!) : clockText(e));
  const category = shownCategoryLabel(data.category);
  const title = displayTitle(e);
  const reasons = listingReasons(e, { pickedBy: picked.has(listingKey(e)) && !data.featured ? e.town.siteTitle : undefined, annual: annualRecordFor(e, title, records)?.entry });
  return [{
    ...head,
    label: category ? `${e.town.name} · ${category}` : e.town.name,
    title,
    href: `https://${e.town.domain}/events/${e.slug}/`,
    // "Free" is said once, as the reason, where it is one.
    meta: [when, data.venue, reasons.includes('Free') ? undefined : data.cost].filter((s): s is string => !!s),
    reasons,
    check: provenanceText(e),
    until: lastDay(e),
    end: toIsoLocal(listedUntil(e)),
  }];
});

/**
 * Beside the weekend, one date to act on: the nearest registration
 * deadline (pickDeadline: the soonest that closes, else the soonest that
 * opens), or, with none, the newest local change.
 */
const deadline = pickDeadline(upcomingDeadlines(programs, { now, days: 30 }));
const change = deadline ? undefined : networkChanges(await getNetworkEntries('updates'), now, { limit: 1 })[0];
// The program's own listing on the deadline's day, whose title the guide's card uses.
const deadlineListing = deadline && listings.find((e) => e.town.slug === deadline.program.town.slug && e.slug === deadline.program.data.nextEvent && dayKey(e.data.start) === dayKey(deadline.on));
const dated = (date: Date, row: Omit<Row, 'key' | 'dayLabel' | 'dayNum'>): Row => {
  const md = monthDay(date);
  return { key: dayKey(date), dayLabel: md.month, dayNum: md.day, ...row };
};
const aside = deadline
  ? {
      heading: 'Deadline',
      row: dated(deadline.on, {
        // A closing date needs no word under "Deadline"; an opening says so.
        label: deadline.what === 'opens' ? `${deadline.program.town.name} · Registration opens` : deadline.program.town.name,
        title: deadlineTitle(deadline.program.data.title, deadlineListing),
        href: deadline.program.data.registration?.url ?? deadline.program.data.url ?? deadline.program.data.organizerUrl ?? `https://${deadline.program.town.domain}/`,
        meta: [],
        check: deadlineSourceText(deadline.program.data),
        until: dayKey(deadline.on),
      }),
    }
  : change && {
      heading: 'Local change',
      // The day that matters: the start of a change still ahead, else the end of one under way, else the day it took effect.
      row: dated(timing(change, now) === 'ahead' ? change.data.effective : (change.data.effectiveEnd ?? change.data.effective), {
        label: change.town.name,
        title: change.data.title,
        href: `https://${change.town.domain}/updates/#${change.slug}`,
        meta: [],
        check: changeSourceText(change.data),
        until: dayKey(expiresOn(change)),
      }),
    };

/** The schools' score pages, on every guide that puts its sports in its menu (src/lib/nav.ts: not an outdoors-led guide). */
const scoreLinks = live
  .filter((t) => t.lead !== 'outdoors')
  .flatMap((t) => schoolsFor(t.slug).map((s) => ({ label: schoolTeamName(s), href: `https://${t.domain}${sportsPath(s)}` })));

/** 6. The index: each guide's name with the towns it covers, its counties and its line. */
const guides = live.map((t) => ({ name: guideName(t, coveredTowns(t)), counties: t.counties.join(' · '), line: guideLine(t), href: guideUrl(t) }));
// The span the mockup names, while both ends have a page.
const span = ['Estes Park', 'Durango'].every((n) => pages.some((p) => p.name === n));
const pagesLine = `${span ? 'Estes Park to Durango: p' : 'P'}arades, festivals, outdoor dates`;
const guideCount = numberWord(live.length);

/** 7. The email: every edition, by default. */
const sendDay = hub.newsletter?.sendDay ?? 'Thursday';
const sendTime = hub.newsletter?.sendTime;
const editionCount = emailEditions().length;

/** Every annual-events page, as /towns/ lists them under "Dates across the towns". */
const ALL_ANNUAL = '/towns/#seasons-heading';

/** The masthead's links, in the page's order, each to something on the page or a page that exists. */
const nav = [
  { label: 'This weekend', href: weekendRows.length > 0 ? '#weekend' : '/this-weekend/' },
  { label: 'Annual events', href: seasons.length > 0 ? '#annual' : ALL_ANNUAL },
  { label: 'Towns', href: '#towns' },
  { label: 'Moving here', href: '/moving/' },
  hub.newsletter && { label: 'Newsletter', href: '#signup' },
  { label: 'How we check', href: '/editorial/' },
].filter((l) => !!l);

const wordmark = wordmarkParts(hub.siteTitle);
const year = now.getFullYear();
const correction = `mailto:${hub.correctionsEmail ?? hub.social.email}?subject=${encodeURIComponent(`[Correction] ${hub.siteTitle}`)}`;

// Under 155 characters with a two-digit count, so the snippet ends at its
// full stop: the longer line was cut at "what it’s…" in every result.
const description = `${live.length} independent community guides to Colorado towns, and the annual events and seasonal dates of ${pages.length} more, from the Front Range to the mountains.`;
---
<Base {description} image={shareImage} imageAlt={HOME_PHOTO.alt} preload={[newsreaderLatin, interLatin, frauncesLatin]} bodyClass="hh">
  <header slot="header" class="hh-header" data-hh-header data-pagefind-ignore>
    <div class="hh-wrap hh-masthead">
      <a href="/" class="hh-wordmark" aria-label={`${hub.siteTitle} home`}>{wordmark.before && <Fragment><span class="hh-wm-before">{wordmark.before}</span>{' '}</Fragment>}<span class="hh-wm-name">{wordmark.name}</span></a>
      <button type="button" class="hh-menu" aria-label="Menu" aria-expanded="false" aria-controls="hh-nav" data-hh-menu>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line></svg>
      </button>
      <nav id="hh-nav" class="hh-nav" aria-label="Primary">
        {nav.map((l) => <a class="hh-navlink" href={l.href}>{l.label}</a>)}
      </nav>
    </div>
  </header>

  <div class="hh-wrap">
    <section class="hh-hero" aria-labelledby="hero-h">
      <div>
        <p class="hh-label hh-kicker">Plains to peaks · Colorado</p>
        <h1 id="hero-h" class="hh-h1">What’s happening in Colorado’s towns</h1>
        <p class="hh-intro">This weekend in {guideCount} towns, and annual dates across Colorado, each checked against its source.</p>
        {/* The site's search (src/pages/search.astro), which on the hub holds
            every guide's places, guides and events as well as the town pages;
            the names of the towns are offered as they are typed. */}
        <form role="search" action="/search/" method="get" class="hh-search">
          <label for="home-q" class="hh-label hh-field-label">Search towns and events</label>
          <div class="hh-fieldrow">
            <input id="home-q" name="q" type="search" list="home-names" autocomplete="off" placeholder="Town, parade, festival…" class="hh-field" />
            <button type="submit" class="hh-btn">Search</button>
          </div>
          <datalist id="home-names">
            {names.map((name) => <option value={name} />)}
          </datalist>
        </form>
      </div>
      <figure class="hh-figure">
        <div class="hh-photo">
          <Image src={photo} alt={HOME_PHOTO.alt} widths={[480, 640, 800, 960, 1280]} sizes="(max-width: 760px) 100vw, 500px" layout="full-width" quality={78} priority />
        </div>
        <figcaption class="hh-chk hh-cap">{HOME_PHOTO.caption}</figcaption>
      </figure>
    </section>

    <nav aria-label="Local guides" class="hh-guides">
      <span class="hh-label">Guides</span>
      {live.map((t) => <a class="hh-tl" href={guideUrl(t)} data-track="home-guides">{t.name}</a>)}
      {pages.length > 0 && <a class="hh-tl hh-strong" href="/towns/" data-track="home-guides">{pages.length} more towns →</a>}
    </nav>

    {(weekendRows.length > 0 || aside || scoreLinks.length > 0) && (
      <section id="weekend" class="hh-sec" aria-labelledby={weekendRows.length > 0 ? 'weekend-h' : undefined} aria-label={weekendRows.length > 0 ? undefined : 'Dates and scores'}>
        <div class="hh-now">
          {weekendRows.length > 0 && (
            <div data-hide-when-empty>
              <h2 id="weekend-h" class="hh-h2 hh-h2-rows">This weekend</h2>
              <div class="hh-rows">
                {weekendRows.map((r) => (
                  <a class="hh-row" href={r.href} data-event-day={r.until} data-end={r.end} data-track="home-weekend">
                    <span class="hh-day"><span class="hh-label">{r.dayLabel}</span><span class="hh-day-num">{r.dayNum}</span></span>
                    <span class="hh-stack">
                      <span class="hh-label">{r.label}</span>
                      <span class="hh-ttl">{r.title}</span>
                      {r.reasons && r.reasons.length > 0 && <span class="hh-why">{r.reasons.join(' · ')}</span>}
                      {r.meta.length > 0 && <span class="hh-meta">{r.meta.join(' · ')}</span>}
                      {r.check && <span class="hh-chk">{r.check}</span>}
                    </span>
                  </a>
                ))}
              </div>
              <a class="hh-tl hh-strong hh-all-weekend" href="/this-weekend/" data-track="home-weekend">Everything on this weekend →</a>
            </div>
          )}
          {(aside || scoreLinks.length > 0) && (
            <div class="hh-side">
              {aside && (
                <div data-hide-when-empty>
                  <h3 class="hh-h3">{aside.heading}</h3>
                  <div class="hh-rows">
                    <a class="hh-row" href={aside.row.href} rel={/^https?:/.test(aside.row.href) ? 'noopener' : undefined} data-event-day={aside.row.until} data-track="home-deadline">
                      <span class="hh-day"><span class="hh-label">{aside.row.dayLabel}</span><span class="hh-day-num">{aside.row.dayNum}</span></span>
                      <span class="hh-stack">
                        <span class="hh-label">{aside.row.label}</span>
                        <span class="hh-ttl hh-ttl-sm">{aside.row.title}</span>
                        {aside.row.check && <span class="hh-chk">{aside.row.check}</span>}
                      </span>
                    </a>
                  </div>
                </div>
              )}
              {scoreLinks.length > 0 && (
                <Fragment>
                  <h3 class="hh-h3 hh-h3-scores">High school scores</h3>
                  <p class="hh-meta hh-scores">
                    {scoreLinks.map((l, i) => <span class="hh-nw"><a class="hh-tl" href={l.href} data-track="home-scores">{l.label}</a>{i < scoreLinks.length - 1 && ','}</span>)}
                  </p>
                </Fragment>
              )}
            </div>
          )}
        </div>
      </section>
    )}

    {seasons.length > 0 && (
      <section id="annual" class="hh-sec" aria-labelledby="annual-h">
        <p class="hh-label hh-label-pine hh-kicker">Annual events</p>
        <h2 id="annual-h" class="hh-h2 hh-season-h">This season</h2>
        <div class="hh-seasons" data-hide-when-empty>
          {seasons.map((r) => (
            <a class="hh-row" href={r.href} data-event-day={r.until} data-track="home-season">
              <span class="hh-day"><span class="hh-label">{r.dayLabel}</span><span class="hh-day-num">{r.dayNum}</span><span class="hh-chk">{r.weekday}</span></span>
              <span class="hh-stack">
                <span class="hh-ttl">{r.title}</span>
                <span class="hh-meta">Next: {r.next}</span>
                {r.line && <span class="hh-chk">{r.line}</span>}
              </span>
            </a>
          ))}
        </div>
        <a class="hh-tl hh-strong hh-all-annual" href={ALL_ANNUAL} data-track="home-season">All annual events →</a>
      </section>
    )}

    <section id="towns" class="hh-sec" aria-labelledby="towns-h">
      <h2 id="towns-h" class="hh-h2 hh-h2-rows">{capitalized(guideCount)} local guides</h2>
      <div class="hh-index">
        {guides.map((g) => (
          <a class="hh-irow" href={g.href} data-track="home-index">
            <span class="hh-ihead"><span class="hh-iname">{g.name}</span><span class="hh-label">{g.counties}</span></span>
            <span class="hh-meta hh-idesc">{g.line}</span>
          </a>
        ))}
        {/* `town-pages`: where the guides' About pages send a reader for "a page on Inside the Towns". */}
        {pages.length > 0 && (
          <a id="town-pages" class="hh-irow" href="/towns/" data-track="home-index">
            <span class="hh-ihead"><span class="hh-iname">{pages.length} more towns, A to Z →</span><span class="hh-label">Annual dates</span></span>
            <span class="hh-meta hh-idesc">{pagesLine}</span>
          </a>
        )}
      </div>
    </section>

    {hub.newsletter && (
      <section id="signup" class="hh-sec" aria-labelledby="signup-h">
        <div class="hh-two">
          <div>
            <h2 id="signup-h" class="hh-h2">The {sendDay} email</h2>
            <p class="hh-signup-line">The weekend’s events, the scores, and what opened or closed. Every {sendDay}{sendTime && ` at ${sendTime}`}.</p>
          </div>
          <NewsletterSignup variant="hub" id="home">
            <p class="hh-chk hh-fine">All {numberWord(editionCount)} towns by default. <a class="hh-tap" href="/newsletter/">Choose towns</a> · Free, unsubscribe any time · <a class="hh-tap" href="/privacy/">Privacy</a></p>
          </NewsletterSignup>
        </div>
      </section>
    )}
  </div>

  <footer slot="footer" class="hh-wrap" data-pagefind-ignore>
    <div class="hh-footer">
      <p class="hh-chk hh-footer-line">{hub.siteTitle}: independent community guides, not affiliated with any town government. © {year}{hub.publisher && ` · Published by ${hub.publisher.name}`}</p>
      <div class="hh-meta hh-footer-links">
        <a class="hh-tl" href="/about/">About</a>
        <a class="hh-tl" href="/editorial/">How we check listings</a>
        <a class="hh-tl" href={correction}>Report a correction</a>
        <a class="hh-tl" href="/contact/">Contact</a>
        <a class="hh-tl" href="/advertise/">Partner with us</a>
      </div>
    </div>
  </footer>
</Base>

<script>
  // The phone's menu: the masthead's links as a column under it. Escape
  // closes it and puts focus back on the button; so does following a link,
  // and widening the window past the phone's layout.
  const header = document.querySelector<HTMLElement>('[data-hh-header]');
  const button = document.querySelector<HTMLButtonElement>('[data-hh-menu]');
  const nav = document.getElementById('hh-nav');
  if (header && button && nav) {
    const set = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      header.toggleAttribute('data-open', open);
    };
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      set(open);
      if (open) nav.querySelector<HTMLAnchorElement>('a')?.focus();
    });
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        set(false);
        button.focus();
      }
    });
    window.matchMedia('(min-width: 761px)').addEventListener('change', (event) => {
      if (event.matches) set(false);
    });
  }
</script>
