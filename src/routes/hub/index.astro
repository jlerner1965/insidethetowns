---
/**
 * The hub home opens typographically rather than with a photo: the map and
 * the town cards are the picture. Each card borrows its town's colours: a
 * rule in its accent and its county line in its primary.
 *
 * It leads with the weekend. The network's numbers — guides, counties, people
 * — are a publisher's facts, and they used to sit where a reader looks first.
 * What a reader wants from the front page of a network of event guides is
 * what is on, so that comes straight after the headline and the numbers move
 * down under the map.
 */
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { resolveSiteImage } from '@/lib/images';
import TownMap from '@/components/TownMap.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FactStrip from '@/components/FactStrip.astro';
import NetworkEventCard from '@/components/NetworkEventCard.astro';
import { getNetworkEntries, getTraditions } from '@/lib/content';
import { hubCountyLine } from '@/config/hub-towns';
import { byCluster, publishedHubTowns } from '@/lib/hub-towns';
import { CURRENT_SEASONS, TRADITION_TYPES, TRADITION_TYPE_INFO, seasonRows } from '@/lib/traditions';
import { dayKey } from '@/lib/dates';
import { formatDayRange } from '@/lib/dates';
import { forGeneralReaders, highlights, occurrences, oneOffs, weekendSections, weekendWindow } from '@/lib/events';
import { countiesCovered, getHub, liveTowns } from '@/config';
import { schoolsFor, schoolTeamName, sportsPath } from '@/config/school-sports';
import { groupByRegion } from '@/lib/regions';
import { wordmarkParts } from '@/lib/titles';

const hub = getHub();
const heroImage = resolveSiteImage('hub', hub.hero.image);
/**
 * The town pages (the restructure of 12 November 2026): every town that is
 * not a standalone guide and has three verified dated items of its own,
 * by cluster. The count and the names are the records', so a town joins
 * the list the day its third date is read and not before.
 */
const records = await getTraditions();
const pages = publishedHubTowns(records);
const clusters = byCluster(pages);
/** The season pages that are built: a tradition type with a season set and a row for it. */
const seasonPages = TRADITION_TYPES.filter((t) => CURRENT_SEASONS[t] && seasonRows(records, t, dayKey(new Date())).length > 0);
/**
 * Only the seven standalone guides reach this page, in the one order every
 * list uses (liveTowns()): the picker, the cards, the map and the counts
 * all read `live`. Any other town is a page under "Town pages" or is not
 * named here at all.
 */
const live = liveTowns();
/**
 * Most visitors came for one town. On a phone the cards were two screens of
 * events and a map away, so the hero ends in a row of names, drawn from
 * the same list as the cards so the two cannot disagree.
 */
const atoz = live;
/** The cards, one group per region in TOWN_REGIONS order, the guides' order within each; an empty region is not drawn. */
const regions = groupByRegion(live);
// The guides that follow a high school, and their schools: the network's
// scores and schedules, which the hub did not mention (navigation audit,
// 22 October 2026).
// Not an outdoors-led guide (`lead: 'outdoors'`, Lyons): sports are off its
// menu and its home page, so the hub does not send a reader there for them.
const sports = live
  .filter((t) => t.lead !== 'outdoors')
  .map((t) => ({ town: t, schools: schoolsFor(t.slug) }))
  .filter((s) => s.schools.length > 0);
const schoolCount = sports.reduce((n, s) => n + s.schools.length, 0);
const NUMBER: Record<number, string> = { 2: 'two', 3: 'three', 4: 'four', 5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine', 10: 'ten', 11: 'eleven', 12: 'twelve' };
/**
 * The weekend across every guide, ranked the way a town's own home page ranks
 * its listings (highlights). On a Sunday night, or in a quiet week, the
 * weekend can be empty, and an empty band under the headline is worse than
 * none, so the block falls back to the week ahead and says which it is.
 *
 * One-offs lead: a festival is a reason to cross a county line and a weekly
 * trivia night is not. Only when the weekend is so quiet that regulars are
 * nearly all there is do they fill the block.
 */
const now = new Date();
// The standing children's programs (standingFamilyTest) are off the
// network's front page altogether, the fallback to regulars included.
const networkEntries = await getNetworkEntries('events');
const network = forGeneralReaders(occurrences(networkEntries, { now, horizonDays: 30 }), networkEntries);
const sections = weekendSections(network, { now, horizonDays: 15 });
const onThisWeekend = [...sections.now, ...sections.weekend];
// Six picks from across the towns, at most two from one town while others
// have something on (the weekend of 24 October led with four from
// Johnstown); with fewer towns on, the best of the rest fill in, and with
// less than six there are fewer cards, never blank ones. The whole
// regional list is /this-weekend/, linked from the heading.
const spread = { now, limit: 6, group: (e: (typeof network)[number]) => e.town.slug, perGroup: 2 };
const picks = highlights(oneOffs(onThisWeekend, network), spread);
const weekend = picks.length >= 3 ? picks : highlights(onThisWeekend, spread);
const leadIsWeekend = weekend.length > 0;
const lead = leadIsWeekend ? weekend : highlights(sections.next, spread);
const { start: weekendStart, sunday } = weekendWindow(now);
/**
 * The hub's own snippet. Without it the page falls back to `hub.tagline`,
 * which is 74 characters and says what the network is but not what is on a
 * town guide — the thing a searcher is deciding whether to click. The tagline
 * stays short because it is also the Organization description; this is
 * written for the search result.
 */
// Under 155 characters with a two-digit count, so the snippet ends at its
// full stop: the longer line was cut at "what it’s…" in every result.
const description = `${live.length} independent guides to Colorado towns and ${pages.length} town pages of dates, on the Front Range and in the mountains: the week’s events, the traditions, and the outdoor dates.`;
/**
 * Where the towns are, for a visitor who does not know one from another: the
 * northernmost and southernmost by latitude, and the mountain guides by name,
 * all read from the live list so the sentence cannot name a town that is
 * not there (follow-up audit, 8 October 2026: the opening gave no location
 * cue). The three task links under it are the three things a visitor came
 * to do, ahead of the eighteen names.
 */
const byLat = [...live].sort((a, b) => b.lat - a.lat);
const north = byLat[0]!;
const south = byLat[byLat.length - 1]!;
// By elevation, not the freshness variant: Golden shares the mountain
// guides' shorter windows and sits at the foot of the foothills.
const mountains = live.filter((t) => (t.elevationFt ?? 0) >= 7000).map((t) => t.name).sort((a, b) => a.localeCompare(b, 'en'));
const list = (names: string[]) => (names.length > 1 ? `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}` : names[0] ?? '');
// "Guides", not "towns": two of them cover a few neighbouring communities
// together (hub audit, 22 October 2026), and the count is the live list's.
const where = `${live.length} guides around Denver: north to ${north.name}, south to ${south.name}${mountains.length ? `, and up in the mountains at ${list(mountains)}` : ''}.`;
const task = 'btn btn-outline min-h-11 px-4 text-[0.9375rem] text-ink';
---
<Base {description}>
  {/* Set a little tighter below 640px so the whole picker fits on a phone's
     first screen: with eighteen guides it is six rows there, and the last was
     cut off at 812px until the padding above and around it came down. From sm up it was a 96px headline under 112px of padding,
     with the tagline beneath it all but repeating the headline, and the
     weekend began below a laptop's first screen (983px at 1348×926; audit,
     7 October 2026). Smaller type and padding and one intro sentence bring
     the weekend's heading onto that screen. */}
  {/* One short line under the headline, then the picker: most visitors came
     for one town, and the two paragraphs and the three task buttons that sat
     between the headline and the names pushed the picker down a screen on a
     phone (hub audit, 22 October 2026). Where the towns are, and the three
     tasks, sit under the picker now. */}
  {/* From lg the hero is two columns: the words and the picker, and beside
     them the Front Range from the air (the design pass of 12 November 2026:
     the right half of a laptop's first screen was empty paper, and the
     network's own photograph was on no page). Below lg nothing changes, so
     the picker stays on a phone's first screen. */}
  <section class="container-page pb-12 pt-6 sm:pt-12 md:pt-14 lg:grid lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:items-center lg:gap-x-12">
    <div>
    <p class="eyebrow">Colorado’s Front Range and mountains</p>
    <h1 class="display mt-4 max-w-4xl text-[2.75rem] sm:mt-5 sm:text-6xl xl:text-7xl">
      Independent guides to the towns worth knowing.
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-muted sm:mt-5 sm:text-lg md:text-xl md:leading-relaxed">
      {live.length} guides: the week’s events, where to eat and drink, the trails, and what it’s like to live there. And {pages.length} <a href="#town-pages" class="text-primary underline">town pages</a>: each town’s traditions and outdoor dates.
    </p>
    <nav aria-labelledby="town-picker" class="mt-6 sm:mt-8">
      <p id="town-picker" class="eyebrow">Pick your town</p>
      <ul class="mt-3 grid max-w-4xl grid-cols-3 gap-2 sm:grid-cols-4">
        {atoz.map((t) => (
          <li class="flex">
            <a
              href={`https://${t.domain}/`}
              class="flex min-h-11 w-full items-center justify-center rounded-full bg-raised px-1 text-center text-[0.8125rem] font-semibold leading-tight text-ink no-underline ring-1 ring-line-soft transition hover:text-primary hover:ring-line sm:px-3 sm:text-sm md:text-[0.9375rem]"
            >{t.name}</a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="mt-6 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-muted">{where} A guide covers one town, or a few neighboring ones together.</p>
    <ul class="mt-4 flex flex-wrap gap-2.5" aria-label="Start here">
      <li><a href="/this-weekend/" class={task}>Find weekend plans</a></li>
      <li><a href="/moving/" class={task}>Compare a move</a></li>
    </ul>
    </div>
    <figure class="relative hidden overflow-hidden rounded-2xl shadow-[0_30px_60px_-30px_rgb(0_0_0/0.45)] lg:block" data-hub-hero>
      <Image
        src={heroImage}
        alt={hub.hero.alt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 46vw, 0px"
        loading="eager"
        class="aspect-[4/5] w-full object-cover xl:aspect-[5/6]"
      />
    </figure>
  </section>

  {lead.length > 0 && (
    <section class="band band-white md:pt-14">
      {/* Less padding above than a band's usual 6rem: straight under the
         hero, the extra only pushed the weekend's heading off a laptop's first
         screen. Below 640px: the first three, then "Everything on" after them rather
         than in the header. Hidden, not dropped, so Freshness can still remove
         a past event and the next one moves up into the three. */}
      <div class="container-page max-sm:[&>:first-child>a]:hidden" data-events-scope>
        <SectionHeader
          eyebrow={leadIsWeekend ? `Across the towns · ${formatDayRange(weekendStart, sunday)}` : 'Across the towns'}
          title={leadIsWeekend ? 'This weekend' : 'What’s on next'}
          href="/this-weekend/"
          linkLabel="Everything on"
        />
        <div class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7 max-sm:[&>:nth-child(n+4)]:hidden">
          {lead.map((event) => <NetworkEventCard event={event} />)}
        </div>
        <p data-events-empty hidden class="rounded-lg border border-dashed border-line px-6 py-10 text-center text-ink-muted">
          Those dates have passed. <a href="/this-weekend/" class="font-semibold text-primary underline">See what’s on now.</a>
        </p>
        <a href="/this-weekend/" class="mt-3 inline-flex min-h-11 items-center text-[0.9375rem] font-semibold text-primary underline sm:hidden">Everything on →</a>
      </div>
    </section>
  )}

  <section id="towns" class="band band-paper">
    <div class="container-page">
    <SectionHeader eyebrow="The network" title="The towns" />
    {/* The cards in a grid, three across on a wide screen and two on a
        tablet, under their regions (design pass, 26 October 2026): one
        column beside a sticky map ran to some 4,000px on a laptop. The map
        follows the cards, for the reader who wants to see where a town is
        once they have its name; not on a phone, where at 375px its labels
        are too small to read or tap. */}
    <div class="grid content-start gap-8 sm:gap-10">
        {regions.map(({ region, towns }) => (
          <div>
            <h3 class="mb-4 text-xl sm:mb-5 sm:text-2xl">{region}</h3>
            {/* A phone gets name and county only, two across, the names level along
               each row however the county line wraps; the card is still the link. */}
            <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3 [&>:last-child:nth-child(odd)]:col-span-2 lg:[&>:last-child:nth-child(odd)]:col-span-1">
              {towns.map((t) => { const title = wordmarkParts(t.siteTitle); return (
                <a
                  href={`https://${t.domain}/`}
                  class="group flex flex-col rounded-lg border-l-4 bg-raised p-4 no-underline ring-1 ring-line-soft transition hover:ring-line sm:block sm:p-6"
                  style={`border-color:${t.colors.accent}`}
                >
                  {/* On a phone the counties alone ("Weld · Boulder"): the full
                      "Weld and Boulder Counties" ran to three lines over a
                      one-word name. One run of text either way, so a reader
                      without the styles gets "Weld · Boulder counties", not
                      both labels run together. */}
                  <p class="eyebrow" style={`color:${t.colors.primary}`}>
                    {t.counties.join(' · ')}<span class="hidden sm:inline"> {t.counties.length > 1 ? 'counties' : 'County'}</span>
                  </p>
                  <h4 class="mt-auto pt-1.5 text-xl font-medium leading-none sm:mt-2 sm:pt-0 sm:text-3xl">
                    {title.before && <Fragment><span class="hidden font-light italic sm:inline">{title.before}</span>{' '}</Fragment>}<span class="font-semibold">{t.name}</span>{title.after && <span class="hidden font-light italic sm:inline">{' '}{title.after}</span>}
                  </h4>
                  <p class="mt-3 hidden text-[0.9375rem] leading-relaxed text-ink-muted sm:block">{t.tagline}</p>
                  <p class="mt-4 hidden text-sm font-semibold group-hover:underline sm:block" style={`color:${t.colors.primary}`}>{t.domain} →</p>
                </a>
              ); })}
            </div>
          </div>
        ))}
    </div>
    <div class="mt-12 hidden sm:block">
      <h3 class="mb-4 text-xl sm:text-2xl">Where they are</h3>
      <TownMap towns={live} />
    </div>
    </div>
  </section>

  {pages.length > 0 && (
    <section id="town-pages" class="band band-white" aria-labelledby="town-pages-h">
      <div class="container-page">
        <SectionHeader eyebrow="Dates, town by town" title="Town pages" id="town-pages-h" />
        <p class="-mt-2 mb-8 max-w-2xl text-lg leading-relaxed text-ink-muted">
          {pages.length} towns, one page each: the events the town holds every year and the outdoor dates around it, every date with the page it was read from.
        </p>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {clusters.map(({ cluster, towns }) => (
            <div>
              <h3 class="eyebrow mb-3">{cluster}</h3>
              <ul class="flex flex-wrap gap-2">
                {towns.map((t) => (
                  <li>
                    <a href={`/${t.slug}/`} title={hubCountyLine(t)} class="inline-flex min-h-11 items-center rounded-full bg-raised px-4 text-[0.9375rem] font-semibold text-ink no-underline ring-1 ring-line-soft transition hover:text-primary hover:ring-line">{t.name}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        {seasonPages.length > 0 && (
          <p class="mt-8 text-[1.0625rem]">
            Across every town: {seasonPages.map((t, i) => (<Fragment>{i > 0 && ' · '}<a href={TRADITION_TYPE_INFO[t].path} class="font-semibold text-primary underline">{TRADITION_TYPE_INFO[t].plural}</a></Fragment>))}
          </p>
        )}
      </div>
    </section>
  )}

  {sports.length > 0 && (
    <section class="band band-white" aria-labelledby="sports-h">
      <div class="container-page">
        <SectionHeader eyebrow="Across the towns" title="High school sports" id="sports-h" />
        <p class="-mt-2 mb-6 max-w-2xl text-lg leading-relaxed text-ink-muted">Scores and schedules for {NUMBER[schoolCount] ?? schoolCount} schools, on {NUMBER[sports.length] ?? sports.length} of the guides.</p>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {sports.flatMap(({ town: t, schools }) => schools.map((s) => (
            <li>
              <a href={`https://${t.domain}${sportsPath(s)}`} class="flex h-full items-center justify-between gap-4 rounded-lg border-l-4 bg-raised px-5 py-4 no-underline ring-1 ring-line-soft hover:ring-line" style={`border-color:${t.colors.accent}`}>
                <span class="min-w-0">
                  <span class="block font-semibold leading-snug">{schoolTeamName(s)}</span>
                  <span class="block text-[0.875rem] text-ink-muted">{t.siteTitle}</span>
                </span>
                <span aria-hidden="true" style={`color:${t.colors.primary}`}>→</span>
              </a>
            </li>
          )))}
        </ul>
      </div>
    </section>
  )}

  <section class="band band-paper">
    <div class="container-page">
      <div class="max-w-4xl">
        <FactStrip
          size="number"
          facts={[
            { label: 'Guides live', value: String(live.length) },
            { label: 'Town pages', value: String(pages.length) },
            { label: 'Counties', value: String(countiesCovered(live).length) },
            { label: 'Population of the towns', value: live.reduce((n, t) => n + (t.population ?? 0), 0).toLocaleString('en-US') },
          ]}
          note="Population at the 2020 census, summed across the live guides: the towns' size, not a count of readers. Several have grown a long way since."
        />
      </div>
    </div>
  </section>

  <section class="on-dark bg-primary text-white">
    <div class="container-page grid gap-8 py-16 md:grid-cols-[3fr_2fr] md:items-end md:py-24">
      <div>
        <p class="eyebrow text-white">How it’s made</p>
        <h2 class="display-md mt-4 text-4xl lg:text-6xl">Every guide made the same careful way.</h2>
      </div>
      <div>
        <p class="text-lg leading-relaxed">
          Never the town government, always linking to it. Editorial listings, not paid placement.
        </p>
        <a href="/about/" class="btn btn-light mt-6">About the network</a>
      </div>
    </div>
  </section>
</Base>
