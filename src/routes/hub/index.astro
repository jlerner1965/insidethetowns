---
/**
 * The hub's home, on the publication design the owner approved on 14
 * November 2026 (the home board), which replaced the home's own look of
 * 13 November: the hub's masthead and footer, its colours, and the
 * network's two faces, Fraunces and Instrument Sans. Top to bottom, each a
 * full-width band, paper and white in turn:
 *
 *   1. The hero: the kicker, the headline and its line, the search, the
 *      way to the three sections below, and the owner's photograph of the
 *      Flatirons.
 *   2. This season: each annual-events season the owner has opened, its
 *      next date, the event on it, and how many towns have set theirs.
 *   3. This weekend: a heading a day, Friday to Sunday, and under each the
 *      day's listings from the guides: a guide editor's pick first, else
 *      the best the organizers have confirmed, never two from one town
 *      (src/lib/hub-home.ts, weekendPicksByDay), and Friday's high-school
 *      game where the scores data has one, its final once posted.
 *   4. The Thursday email, on the hub's blue.
 *   5. High school scores: each school the guides follow, with its last
 *      result from the scores files.
 *   6. In the towns: the newest stories and local changes, the newest
 *      first and set larger.
 *   7. Find your town: the guides, and the town pages by area.
 *
 * Every list reads what the rest of the hub reads: liveTowns() for the
 * guides, publishedHubTowns() for the town pages, the tradition records,
 * the guides' listings, weekly notes and changes, and the scores files.
 * Each dated row carries its last day, so the page's own script takes it
 * down once it has passed (Freshness.astro), and a block left with nothing
 * goes with it. "Today" on a season's next date is the reader's own day,
 * written by the script below and never in the built page. A section with
 * nothing to show is not drawn. The sections' links carry `data-track`
 * (home-…), so TrackClicks.astro counts which part of the page is used.
 */
import { Image, getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import { pub } from '@/components/hub/pub';
import { emailEditions, getHub, listsEvents, liveTowns } from '@/config';
import { clusterName, hubCountyLine } from '@/config/hub-towns';
import { schoolTeamName, schoolsFor, sportsPath, teamPath, type SportsData } from '@/config/school-sports';
import { getCuriosity, getNetworkEntries, getTraditions } from '@/lib/content';
import { ARTICLES_INDEX_PATH, articlePath, storyHomeUntil } from '@/lib/curiosity';
import { placeName } from '@/lib/curiosity-places';
import { firstSentence } from '@/lib/plain-text';
import { shorten } from '@/lib/text';
import { dayKey, formatDayLong, formatDayRange, formatDayShort, formatMonthDay, monthDay, parseLocal, toIsoLocal } from '@/lib/dates';
import { clockText, displayTitle, isInProgress, lastDay, listedUntil, occurrences } from '@/lib/events';
import { byCluster, publishedHubTowns } from '@/lib/hub-towns';
import {
  HOME_PHOTO,
  annualRecordFor,
  capitalized,
  changeSourceText,
  deadlineListings,
  fridayGame,
  gameRow,
  guideLine,
  guideName,
  listWords,
  listingKey,
  listingReasons,
  newsItems,
  nextLine,
  numberWord,
  provenanceText,
  searchSuggestions,
  seasonFeatureLine,
  seasonsNow,
  sportsSourceText,
  storySourceText,
  weekendDays,
  weekendPicksByDay,
} from '@/lib/hub-home';
import { resolveSiteImage } from '@/lib/images';
import { FLAGSHIP_TEAM, RESULT_WORD, gameDay, hasData, latestResult, outcome, sportsDataFor } from '@/lib/school-sports';
import { coveredTowns } from '@/lib/town-search-index';
import { TRADITION_TYPE_INFO } from '@/lib/traditions';
import { currentPicks } from '@/lib/weekly';
import { fitTitle } from '@/lib/titles';
import { ANNUAL_EVENTS_HREF } from '@/lib/nav';
import { collectionPageJsonLd } from '@/lib/seo';
import { expiresOn, networkChanges } from '@/lib/updates';
import { shownCategoryLabel } from '@/content/schemas';
// The italic of the heading face, for the decks and the day headings: the guides' pages do not use it, so it is loaded here only.
import '@fontsource-variable/fraunces/opsz-italic.css';

const hub = getHub();
/** The seven guides, in the one order every list uses (liveTowns()), and the town pages that are published. */
const live = liveTowns();
const records = await getTraditions();
const pages = publishedHubTowns(records);
const now = new Date();
const todayKey = dayKey(now);
const guideUrl = (t: { domain: string }) => `https://${t.domain}/`;

/** What the search box offers as a name is typed: the guides and the town pages. */
const names = searchSuggestions(live, pages);

/** The photograph under the hero, and the same picture as the page's share image. */
const photo = resolveSiteImage('hub', HOME_PHOTO.hero);
const shareImage = (await getImage({ src: resolveSiteImage('hub', HOME_PHOTO.file), width: 1200, height: 630, format: 'jpg' })).src;

/**
 * This season: the annual events whose season is open, each with its count
 * by town and its next date (src/lib/hub-home.ts, seasonsNow). The rest are
 * one link away, on the annual events list.
 */
const seasons = seasonsNow(records, todayKey).map(({ type, counts, next }) => {
  const info = TRADITION_TYPE_INFO[type];
  const md = monthDay(parseLocal(next.entry.date!));
  return {
    key: type,
    month: md.month,
    day: md.day,
    weekday: md.weekday,
    title: info.plural,
    next: nextLine(next.record),
    line: counts.towns > 0 ? seasonFeatureLine(counts) : undefined,
    href: info.path,
    starts: next.entry.date!,
    until: next.entry.endDate ?? next.entry.date!,
  };
});

/**
 * This weekend. The listings are every guide's, expanded to their dates
 * (a series is known as one); the scores are each followed school's file
 * with CHSAA's brackets merged in; the editors' picks are each guide's
 * current weekly notes (src/lib/weekly.ts, currentPicks).
 */
const days = weekendDays(now);
const friday = days[0]!.key;
const sunday = days[2]!.key;
const listings = occurrences(await getNetworkEntries('events'), { now, horizonDays: 21 });
const sportsFiles = import.meta.glob<SportsData>('../../../data/*/sports*.json', { eager: true, import: 'default' });
const gameSources = live.flatMap((guide) =>
  schoolsFor(guide.slug).flatMap((school) => {
    const team = sportsDataFor(school, sportsFiles, now)?.sports.find((s) => s.key === FLAGSHIP_TEAM && hasData(s));
    return team ? [{ guide, town: guide.slug, school, team }] : [];
  }),
);
const found = fridayGame(gameSources, friday, listings);
// A game still to come shows until Friday is over; its final, once the Saturday run posts it, through Sunday.
const game = found && (found.game.result || friday >= todayKey) ? found : undefined;
const programs = await getNetworkEntries('programs');
const weeklyNotes = await getNetworkEntries('weekly');
const picked = new Set(
  live.flatMap((t) =>
    currentPicks(
      weeklyNotes.filter((n) => n.town.slug === t.slug),
      listings.filter((e) => e.town.slug === t.slug),
      now,
      Infinity,
    ).map(listingKey),
  ),
);
/** Up to three a day, never two from one town across the weekend. */
const PER_DAY = 3;
const picks = weekendPicksByDay(
  listings,
  days.filter((d) => d.key >= todayKey),
  { now, taken: new Set(game ? [game.guide.slug] : []), order: live.map((t) => t.slug), exclude: deadlineListings(programs, listings), picked, perDay: PER_DAY },
);

interface Item {
  /** "Longmont · Run". */
  label: string;
  title: string;
  href: string;
  /** Why it earned the space, in a few words from its fields or its `why`; none where none holds. */
  reasons: string[];
  /** "9 am · Altona Middle School". */
  meta: string[];
  check?: string;
  /** The last day it shows, and the instant it comes off where it has one (src/lib/expiry.ts). */
  until: string;
  end?: string;
}

const weekend = days.flatMap((d) => {
  const items: Item[] = [];
  if (game && d.key === friday) {
    const { guide, school, team, listing } = game;
    const row = gameRow(game, displayTitle, clockText);
    const source = row.final || !listing ? sportsSourceText(team, game.game, !!school.calendar) : provenanceText(listing);
    items.push({
      label: `${guide.name} · Friday night lights`,
      title: row.title,
      href: row.final || !listing ? `https://${guide.domain}${teamPath(school, team.key)}` : `https://${guide.domain}/events/${listing.slug}/`,
      reasons: row.reasons,
      meta: row.meta,
      // The record and the league place are MaxPreps's; the listing's check covers the date, time and place.
      // "On Saturday", not "Saturday morning": the scores run is at 7 am and the hub's rebuild follows mid-morning.
      check: row.final ? source : [source, listing && team.overall ? 'Record from MaxPreps' : undefined, 'Final score here on Saturday'].filter(Boolean).join(' · '),
      until: row.final ? sunday : friday,
    });
  }
  for (const e of picks.get(d.key) ?? []) {
    const { data } = e;
    const multiDay = !!data.end && dayKey(data.start) !== dayKey(data.end);
    // As the hub's weekend page words a listing (NetworkEventCard.astro).
    const when = data.timeNote ?? (multiDay && isInProgress(e, now) ? `Now through ${formatMonthDay(data.end!)}` : multiDay && data.allDay ? formatDayRange(data.start, data.end!) : clockText(e));
    const category = shownCategoryLabel(data.category);
    const title = displayTitle(e);
    const reasons = listingReasons(e, { pickedBy: picked.has(listingKey(e)) && !data.featured ? e.town.siteTitle : undefined, annual: annualRecordFor(e, title, records)?.entry });
    items.push({
      label: category ? `${e.town.name} · ${category}` : e.town.name,
      title,
      href: `https://${e.town.domain}/events/${e.slug}/`,
      reasons,
      // "Free" is said once, as the reason, where it is one.
      meta: [when, data.venue, reasons.includes('Free') ? undefined : data.cost].filter((s): s is string => !!s),
      check: provenanceText(e),
      until: lastDay(e),
      end: toIsoLocal(listedUntil(e)),
    });
  }
  return items.length > 0 ? [{ key: d.key, heading: formatDayLong(d.date), items }] : [];
});

/**
 * High school scores: each school a guide follows in its menu (src/lib/nav.ts:
 * not an outdoors-led guide), with its last result as its sports pages word
 * it. A school with no result read has no row: no placeholder, no score
 * that was not posted.
 */
const scores = live
  .filter((t) => t.lead !== 'outdoors')
  .flatMap((t) =>
    schoolsFor(t.slug).flatMap((s) => {
      const data = sportsDataFor(s, sportsFiles, now);
      const last = data ? latestResult(data) : undefined;
      if (!last?.game.result) return [];
      return [{
        name: schoolTeamName(s),
        href: `https://${t.domain}${sportsPath(s)}`,
        result: `${last.team.name} ${RESULT_WORD[last.game.result].toLowerCase()} ${outcome(last.game)}`,
        date: last.game.date,
        day: formatDayShort(gameDay(last.game)),
      }];
    }),
  );

/**
 * In the towns: the hub's stories and the guides' current local changes,
 * the newest first, one per town, three at most (src/lib/hub-home.ts,
 * newsItems). Each leaves on its own last day; "All articles" keeps every
 * article on the site after it leaves here.
 */
const articlesOnSite = (await getCuriosity()).map((a) => a.data);
const stories = articlesOnSite.filter((a) => a.kind === 'story');
const changes = networkChanges(await getNetworkEntries('updates'), now, { limit: 12, perTown: 1 });
const news = newsItems(
  [
    ...stories.map((a) => ({
      town: a.towns[0]!,
      label: `${a.towns.slice(0, 2).map((t) => placeName(t) ?? t).join(' · ')} · News`,
      title: a.title,
      line: a.description,
      href: articlePath(a),
      date: a.date,
      until: storyHomeUntil(a),
      source: storySourceText(a.sources),
    })),
    ...changes.map((c) => ({
      town: c.town.slug,
      label: `${c.town.name} · Local change`,
      title: c.data.title,
      // One line: the summary's first sentence, as a card shows it.
      line: shorten(firstSentence(c.data.summary) || c.data.summary, 170),
      href: `https://${c.town.domain}/updates/#${c.slug}`,
      date: dayKey(c.data.published),
      until: dayKey(expiresOn(c)),
      source: changeSourceText(c.data),
    })),
  ],
  todayKey,
).map((i) => {
  const md = monthDay(parseLocal(i.date));
  return { ...i, byline: `${i.label} · ${md.month} ${md.day}` };
});

/** Find your town: each guide's name with the towns it covers, its counties and its line. */
const guides = live.map((t) => ({ name: guideName(t, coveredTowns(t)), line: [hubCountyLine(t), guideLine(t)].join(' · '), href: guideUrl(t) }));
const guideCount = numberWord(live.length);
/**
 * "This weekend's events from six guides", not seven: Niwot lists no events
 * (`lead: 'updates'`), so the weekend comes from the six that do.
 */
const eventGuideCount = numberWord(live.filter(listsEvents).length);
/**
 * "N more towns": the town pages for towns no guide covers. Severance has a
 * page of its own and is in "Windsor and Severance" too, so it is not
 * counted twice. /towns/ still lists every page.
 */
const guideTowns = new Set(live.flatMap((t) => [t.name, ...coveredTowns(t)]));
const moreTowns = pages.filter((p) => !guideTowns.has(p.name)).length;
/** The town pages by area, A to Z by the area's name as a reader sees it, each town A to Z within it. */
const areas = byCluster(pages)
  .map((g) => ({ name: clusterName(g.towns[0]!.cluster), towns: [...g.towns].sort((a, b) => a.name.localeCompare(b.name)) }))
  .sort((a, b) => a.name.localeCompare(b.name));

/** The email: one town to start, from the weekly editions (NewsletterSignup.astro, variant "hub"). */
const sendDay = hub.newsletter?.sendDay ?? 'Thursday';
/** The guides with no weekly edition, and so not in the list (src/config/index.ts, emailTowns): "Niwot has no weekly issue." */
const emailed = new Set(emailEditions().flatMap((e) => e.towns.map((t) => t.slug)));
const noWeekly = live.filter((t) => !emailed.has(t.slug)).map((t) => t.name);
const noWeeklyLine = noWeekly.length > 0 ? ` ${listWords(noWeekly)} ${noWeekly.length === 1 ? 'has' : 'have'} no weekly issue.` : '';

/** The hero's way to the sections below, each to one the page draws. */
const jumps = [
  seasons.length > 0 && { label: 'This season', href: '#season' },
  weekend.length > 0 && { label: 'This weekend', href: '#weekend' },
  { label: 'Find your town', href: '#towns' },
].filter((j) => !!j);

/**
 * The title and description say what the page is: this weekend's events
 * and the annual dates, the words people search with, the longest form
 * that fits 155 characters.
 */
const fullTitle = fitTitle('Colorado events this weekend, town by town', hub.siteTitle);
const seasonWords = seasons.length > 0 ? `: ${listWords(seasons.map((r) => r.title.toLowerCase()))}` : '';
const description = [
  `This weekend’s events from ${eventGuideCount} Colorado town guides, and annual dates for ${moreTowns} more towns${seasonWords}, each checked against its source.`,
  `This weekend’s events from ${eventGuideCount} Colorado town guides, and annual dates for ${moreTowns} more towns${seasonWords}.`,
  `This weekend’s events from ${eventGuideCount} Colorado town guides, and annual dates for ${moreTowns} more towns, each checked against its source.`,
].find((d) => d.length <= 155)!;

/** What the page lists, for search engines. Their Event markup stays on the pages that own them. */
const structured = collectionPageJsonLd(hub, {
  name: 'What’s happening in Colorado’s towns',
  description,
  path: '/',
  items: [
    ...weekend.flatMap((d) => d.items.map((r) => ({ name: r.title, url: r.href }))),
    ...news.map((i) => (/^https?:/.test(i.href) ? { name: i.title, url: i.href } : { name: i.title, path: i.href })),
    ...seasons.map((r) => ({ name: r.title, path: r.href })),
    { name: 'Everything on this weekend', path: '/this-weekend/' },
  ],
});

const dek = 'mt-2 font-heading text-[1.0588rem] font-normal italic leading-[1.45] text-ink-muted [font-variation-settings:normal]';
const by = 'text-meta font-semibold leading-[1.4] text-ink-muted';
const hl = 'mt-1 text-[1.2941rem] font-medium leading-[1.2] tracking-normal text-ink [font-variation-settings:normal]';
const more = 'mt-2.5 flex min-h-11 items-center text-base font-[650] text-primary underline decoration-1 underline-offset-[3px]';
const lnk = 'flex min-h-[46px] items-center border-b border-hairline text-[0.9412rem] leading-[1.3]';
const dateMonth = `${pub.cap} text-primary`;
const dateDay = 'mt-0.5 whitespace-nowrap font-heading text-date leading-none tracking-[-0.02em] text-primary [font-variation-settings:normal]';
---
<Base {fullTitle} {description} image={shareImage} imageAlt={HOME_PHOTO.alt} jsonLd={structured} closedGuideBanner={false}>
  {/* The hero: what the page is, the search, and the way to the sections below. */}
  <section class="bg-paper px-[20px] pb-[30px] pt-6" aria-labelledby="hero-h" data-band>
    <div class={pub.col}>
      <p class:list={[pub.cap, 'text-ink-muted']}>Colorado, plains to peaks</p>
      <h1 id="hero-h" class="mt-2.5 text-[2.2353rem] font-medium leading-[1.04] tracking-[-0.025em] text-ink [font-variation-settings:normal]">What’s happening in Colorado’s towns</h1>
      <p class="mt-2 font-heading text-[1.1176rem] font-normal italic leading-[1.45] text-ink [font-variation-settings:normal]">Find Colorado’s town traditions, this weekend’s events and local stories — from parades of lights to Friday night games.</p>
      {/* The site's search (src/pages/search.astro), which on the hub holds every guide's places, guides and events as well as the town pages; the towns' names are offered as they are typed. */}
      <form role="search" action="/search/" method="get" class="mt-[22px]">
        <label for="home-q" class="block text-[0.9412rem] font-[650] text-ink">Search towns and events</label>
        <div class="mt-2 flex">
          <input id="home-q" name="q" type="search" list="home-names" autocomplete="off" placeholder="A town or an event" class="block h-12 min-w-0 flex-1 rounded-l-[2px] border border-r-0 border-ink-muted bg-raised px-3.5 text-[0.9412rem] text-ink placeholder:text-ink-muted" />
          <button type="submit" class="h-12 shrink-0 cursor-pointer rounded-r-[2px] border-0 bg-primary px-[18px] text-base font-semibold text-white hover:bg-primary-hover">Search</button>
        </div>
        <datalist id="home-names">
          {names.map((name) => <option value={name} />)}
        </datalist>
      </form>
      <ul class="mt-2.5 border-t border-hairline" data-jumps>
        {jumps.map((j) => (
          <li><a href={j.href} class:list={[lnk, 'text-base font-[650] text-primary underline decoration-1 underline-offset-[3px]']} data-jump={j.href.slice(1)}>{j.label} →</a></li>
        ))}
      </ul>
      <figure class="mt-5">
        <div class="aspect-[2/1] overflow-hidden bg-hairline">
          <Image src={photo} alt={HOME_PHOTO.alt} widths={[480, 640, 800, 960, 1280]} sizes="(max-width: 760px) 100vw, 720px" layout="full-width" quality={78} priority class="block h-full w-full object-cover" />
        </div>
        <figcaption class:list={['mt-2 italic', pub.meta]}>{HOME_PHOTO.caption}</figcaption>
      </figure>
    </div>
  </section>

  {seasons.length > 0 && (
    <section id="season" aria-labelledby="season-heading" data-band data-hide-when-empty class:list={[pub.band, pub.white]}>
      <div class={pub.col}>
        <div class={pub.open}>
          <h2 id="season-heading" class={pub.h2}>This season</h2>
          <p class={dek}>Annual events, and how many towns have set their dates.</p>
        </div>
        {seasons.map((r) => (
          <article class:list={['grid grid-cols-[58px_minmax(0,1fr)] gap-x-3.5 py-4', pub.rule]} data-event-day={r.until} data-season-row data-starts={r.starts} data-ends={r.until}>
            <div aria-hidden="true">
              <p class={dateMonth}>{r.month.toUpperCase()}</p>
              <p class={dateDay}>{r.day}</p>
              <p class:list={['mt-1', pub.meta]}>{r.weekday}</p>
            </div>
            <div class="min-w-0">
              <h3 class:list={[hl, 'mt-0']}><a href={r.href} class={pub.titleLink} data-track="home-season">{r.title}</a></h3>
              <p class:list={['mt-1', pub.t]}><span data-next-word>Next: </span>{r.next}</p>
              {r.line && <p class:list={['mt-1', pub.meta]}>{r.line}</p>}
            </div>
          </article>
        ))}
        <a href={ANNUAL_EVENTS_HREF} class={more} data-track="home-season">All annual events →</a>
      </div>
    </section>
  )}

  {weekend.length > 0 && (
    <section id="weekend" aria-labelledby="weekend-heading" data-band data-hide-when-empty class:list={[pub.band, pub.paper]}>
      <div class={pub.col}>
        <div class={pub.open}>
          <h2 id="weekend-heading" class={pub.h2}>This weekend</h2>
          <p class={dek}>Each listing opens on that town’s page.</p>
        </div>
        {weekend.map((d) => (
          <div data-day={d.key}>
            <h3 class={pub.h3}>{d.heading}</h3>
            {d.items.map((r) => (
              <article class:list={['py-4', pub.rule]} data-event-day={r.until} data-end={r.end}>
                <p class={by}>{r.label}</p>
                <h4 class={hl}><a href={r.href} class={pub.titleLink} data-track="home-weekend">{r.title}</a></h4>
                {r.reasons.length > 0 && <p class:list={['mt-1.5', pub.t]}>{r.reasons.join(' · ')}</p>}
                {r.meta.length > 0 && <p class={pub.t}>{r.meta.join(' · ')}</p>}
                {r.check && <p class:list={['mt-1.5', pub.meta]}>{r.check}</p>}
              </article>
            ))}
          </div>
        ))}
        <a href="/this-weekend/" class={more} data-track="home-weekend">Everything on this weekend →</a>
      </div>
    </section>
  )}

  {hub.newsletter && (
    <section id="signup" aria-labelledby="signup-heading" data-band class:list={['on-dark', pub.band, 'bg-primary text-white']}>
      <div class={pub.col}>
        <div class="border-t-2 border-white pt-3">
          <h2 id="signup-heading" class:list={[pub.h2, 'mt-0 text-white']}>The {sendDay} email</h2>
          {/* What an edition holds (NewsletterSignup.astro, `what`): the town's weekend events, the scores, what opened or closed. */}
          <p class:list={[dek, 'text-white']}>Your town’s weekend events, the scores, and what opened or closed.</p>
        </div>
        <NewsletterSignup variant="hub" id="home">
          <p class="mt-3 text-meta leading-[1.5] text-white">One town to start; add others any time.{noWeeklyLine} Free, unsubscribe any time · <a class="text-white underline decoration-1 underline-offset-[3px]" href="/privacy/">Privacy</a></p>
        </NewsletterSignup>
      </div>
    </section>
  )}

  {scores.length > 0 && (
    <section id="scores" aria-labelledby="scores-heading" data-band class:list={[pub.band, pub.white]}>
      <div class={pub.col}>
        <div class={pub.open}>
          <h2 id="scores-heading" class={pub.h2}>High school scores</h2>
          <p class={dek}>Each team’s last result.</p>
        </div>
        <ul class="mt-2">
          {scores.map((s) => (
            <li class:list={['grid min-h-[50px] grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] items-center gap-x-3 py-2', pub.rule]}>
              <a href={s.href} class={pub.link} data-track="home-scores">{s.name}</a>
              <span class:list={['text-right', pub.meta]}>{s.result}, <time datetime={s.date}>{s.day}</time></span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {news.length > 0 && (
    <section id="news" aria-labelledby="news-heading" data-band data-hide-when-empty class:list={[pub.band, pub.paper]}>
      <div class={pub.col}>
        <div class={pub.open}>
          <h2 id="news-heading" class={pub.h2}>In the towns</h2>
          <p class={dek}>News and changes, each with its sources.</p>
        </div>
        {news.map((i, n) => (
          <article class:list={[n === 0 ? 'py-[18px]' : 'py-4', pub.rule]} data-event-day={i.until}>
            <p class={by}>{i.byline}</p>
            <h3 class:list={[hl, n === 0 && 'text-[1.5294rem] leading-[1.15]']}><a href={i.href} rel={/^https?:/.test(i.href) ? 'noopener' : undefined} class={pub.titleLink} data-track="home-news">{i.title}</a></h3>
            {n === 0 && <p class:list={['mt-2', pub.t]}>{i.line}</p>}
            {i.source && <p class:list={[n === 0 ? 'mt-2' : 'mt-1.5', pub.meta]}>{i.source}</p>}
          </article>
        ))}
        {articlesOnSite.length > 0 && <a href={ARTICLES_INDEX_PATH} class={more} data-track="home-news">All articles →</a>}
      </div>
    </section>
  )}

  <section id="towns" aria-labelledby="towns-heading" data-band class:list={[pub.band, 'pb-[56px]', pub.white]}>
    <div class={pub.col}>
      <div class={pub.open}>
        <h2 id="towns-heading" class={pub.h2}>Find your town</h2>
        <p class={dek}>{capitalized(guideCount)} full local guides, and a page of annual dates for every other town.</p>
      </div>
      <h3 class={pub.h3}>{capitalized(guideCount)} local guides</h3>
      {guides.map((g) => (
        <div class:list={['py-4', pub.rule]}>
          <h4 class:list={[hl, 'mt-0']}><a href={g.href} class={pub.titleLink} data-track="home-index">{g.name}</a></h4>
          <p class:list={['mt-0.5', pub.meta]}>{g.line}</p>
        </div>
      ))}
      {areas.length > 0 && (
        <Fragment>
          <h3 class={pub.h3}>Town pages by area</h3>
          {/* Each area opens in place on its towns: no address of its own, so none changes. */}
          <ul class={pub.linkGrid} data-areas>
            {areas.map((a) => (
              <li>
                <details class="group">
                  <summary class:list={[lnk, 'cursor-pointer list-none justify-between gap-2 text-primary [&::-webkit-details-marker]:hidden']}>
                    <span class="underline decoration-1 underline-offset-[3px]">{a.name}</span>
                    <span class="shrink-0 text-meta text-ink-muted" aria-hidden="true"><span class="group-open:hidden">+</span><span class="hidden group-open:inline">−</span></span>
                  </summary>
                  <ul class="pb-2 pt-1">
                    {a.towns.map((t) => <li><a href={`/${t.slug}/`} class:list={[pub.link, 'flex min-h-11 items-center text-[0.9412rem]']} data-track="home-index">{t.name}</a></li>)}
                  </ul>
                </details>
              </li>
            ))}
          </ul>
        </Fragment>
      )}
      {/* `town-pages`: where the guides' About pages send a reader for "a page on Inside the Towns". */}
      {moreTowns > 0 && <a id="town-pages" href="/towns/" class={more} data-track="home-index">{moreTowns} more towns, A to Z →</a>}
    </div>
  </section>
</Base>

<script>
  // "Today" on a season's next date, by the reader's own Denver day: never
  // in the built page, which a stale build would leave saying it.
  const today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Denver' });
  for (const row of document.querySelectorAll<HTMLElement>('[data-season-row]')) {
    const { starts, ends } = row.dataset;
    const word = row.querySelector<HTMLElement>('[data-next-word]');
    if (!starts || !word || today < starts || today > (ends ?? starts)) continue;
    const tag = document.createElement('span');
    tag.className = 'mr-1.5 inline-block bg-highlight-soft px-1.5 py-px text-cap font-[650] uppercase tracking-[0.06em] text-ink';
    tag.textContent = 'Today';
    word.replaceWith(tag);
  }
  // A jump to a section the page's other script took away (its dates had all passed) goes with it.
  for (const jump of document.querySelectorAll<HTMLElement>('[data-jump]')) {
    if (!document.getElementById(jump.dataset.jump ?? '')) jump.closest('li')?.remove();
  }
</script>
