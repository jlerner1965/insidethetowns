---
/**
 * The live towns side by side, for someone deciding which one to move to.
 *
 * The parent site's first page that answers something people actually type:
 * "best small town near Boulder", "which Front Range town should I move to".
 * Nobody owns those searches because the answer is scattered across a
 * chamber site per town.
 *
 * Every column is a fact this network can source and keep current, and every
 * one comes off the town configs, so the table is a loop rather than a grid
 * somebody has to remember to update. Median home price is deliberately not
 * here: it is quarterly work with a licensing question attached, and a column
 * that cannot be filled for all of them is worse than a column that is absent.
 */
import Page from '@/layouts/Page.astro';
import CtaBand from '@/components/CtaBand.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { countyLabel, countyShort, getHub, liveTowns } from '@/config';
import { collectionPageJsonLd } from '@/lib/seo';
import { comparisonSlug, liveComparisons } from '@/content/comparisons';

const hub = getHub();
const comparisons = liveComparisons();
// Biggest first: it is the ordering a reader can hold in their head, and the
// range from 170,000 to 1,700 is the first thing worth knowing about them.
const towns = [...liveTowns()].sort((a, b) => (b.population ?? 0) - (a.population ?? 0));

/** "Thompson School District R2-J: Berthoud Elementary, …" -> the district. */
const district = (full?: string) => (full ? (full.split(/[:(]/)[0] ?? full).trim() : '—');
const num = (n?: number) => (n ? n.toLocaleString('en-US') : '—');
const growth = (t: (typeof towns)[number]) =>
  t.population && t.population2010 ? `+${Math.round((t.population / t.population2010 - 1) * 100)}%` : '—';

// All or none. A price column with gaps in it invites the reader to
// assume the gaps mean "cheap", and an unsourced one is worse than absent.
const pricesReady = towns.every((t) => t.medianHomePrice && t.medianHomePriceAsOf && t.medianHomePriceSource);

const columns = [
  { key: 'county', label: 'County', caption: 'county', kind: 'nowrap', get: (t: (typeof towns)[number]) => countyShort(t) },
  { key: 'population', label: 'Population 2020', caption: 'population at the 2020 census', kind: 'num', get: (t: (typeof towns)[number]) => num(t.population) },
  { key: 'growth', label: 'Growth 2010–20', caption: 'growth from 2010 to 2020', kind: 'num', get: growth },
  ...(pricesReady
    ? [
        {
          key: 'price',
          label: 'Median home',
          caption: 'median home price',
          kind: 'num',
          get: (t: (typeof towns)[number]) => `$${num(t.medianHomePrice)}`,
        },
      ]
    : []),
  { key: 'denver', label: 'To Denver', caption: 'drive to Denver', kind: 'nowrap', get: (t: (typeof towns)[number]) => t.driveToDenver ?? '—' },
  { key: 'schools', label: 'Schools', caption: 'school district', kind: 'text', get: (t: (typeof towns)[number]) => district(t.movingHere.schoolDistrict) },
  { key: 'character', label: 'In a line', caption: 'what each is like', kind: 'text', get: (t: (typeof towns)[number]) => t.character ?? '—' },
];
// Read from the columns, so it cannot promise one the table does not have.
const caption = `The ${towns.length} towns compared by ${columns
  .map((c) => c.caption)
  .join(', ')
  .replace(/, ([^,]*)$/, ' and $1')}`;

const SUITS: Record<string, string> = {
  "erie": "Suits people working in or near Boulder who want a newer house within reach of it, and a downtown they can walk to on a Friday. The catch is that most of Erie is subdivisions built since 2000 and only the old grid around Briggs Street is walkable, so where you buy decides whether you get the town or the commute. Ask which county, which school district and which metro district before you fall for a house: all three change from one street to the next.",
  "johnstown": "Suits northern Colorado commuters. The US 34 interchange is on the west edge, which puts Loveland at ten minutes, Greeley at fifteen, Fort Collins at twenty-five and Denver at fifty. Two school districts, as in Erie: most of town is Weld RE-5J, the north-west corner is Thompson. The trade is that the shopping has moved out to the interstate and Parish Avenue is quiet.",
  "berthoud": "Suits people who want a Main Street that is genuinely a main street, and the lakes. Fifteen minutes to Loveland or Longmont, twenty-five to Fort Collins, and the FLEX bus runs through it between Fort Collins, Loveland, Longmont and Boulder, so a commute without a car is possible if the timetable fits. It doubled in a decade, so a good deal of it is new.",
  "timnath": "Suits people who want to be minutes from Fort Collins in a town built almost entirely this century. It went from 625 people at the 2010 census to 6,487 at the 2020 census, which is the largest proportional change of any town here by a wide margin, and it shows: Old Town Main Street is a couple of blocks and everything else was built this decade around the Harmony Road retail. Come for the reservoir and the river trail, not for an old town center.",
  "niwot": "Suits people who want small and mean it. It is unincorporated — no town council, no municipal tax, county services, and an incorporation question on the November 3, 2026 ballot whose outcome is worth checking before you buy. Seven percent growth in a decade, which in this company is a rounding error. Twenty minutes to Boulder or Longmont on the Diagonal, and the BOLT bus stops at Niwot Road.",
  "lyons": "Suits people who want the mountains to start at the end of the street. It is the canyon mouth: sandstone, the St. Vrain, Planet Bluegrass, and a town that rebuilt itself after the 2013 flood and talks about it. Twenty minutes to Boulder and an hour to Denver, and one bus: the free Lyons Flyer, four trips each way to Boulder on weekdays. It has barely grown, so what is for sale at any moment is a handful of listings, and the river is both the reason to live there and the thing to ask a surveyor about.",
  "elizabeth": "Suits people who want acreage and sky and will trade an hour of driving for it. It is a Palmer Divide community at 6,477 feet, with the weather that implies. Inside town you get water and sewer; outside it you own a well and a septic system, and you should have both inspected and the well's yield documented before you buy. Forty-five minutes to the Tech Center, and Denver is not really the point.",
  "windsor": "Suits people who work anywhere in northern Colorado and want to be in the middle of it: Fort Collins, Loveland and Greeley are each about twenty minutes, and Harmony Road puts I-25 at ten. It went from 18,644 people at the 2010 census to 32,716 at the 2020 census and most of the housing is new, in metro districts east and south of the old sugar-beet town; the lake, Boardwalk Park and Main Street are the old center and the reason to live near it. Two counties and three school districts inside the town limits — Weld RE-4 for most of it, Poudre or Thompson on the Larimer County side — so check the address, not the town.",
  "longmont": "Suits people who want a full-size city with Boulder in reach: 98,885 people at the 2020 census, a Main Street downtown, the City's own electric utility and NextLight fiber, and local buses that are free to ride. Boulder is 15 miles south-west on Colorado 119, with RTD's BOLT bus between the two, and downtown Denver 34 miles south; RTD's trains do not reach it. The trade is cost: the City's 2023 housing study put the median sale at $611,421, affordable to 32 percent of households, and with little land left it is steering new building to infill and apartments. The county line runs through the city, so check whether a house is in Boulder or Weld County, and near a creek check the City's floodplain map.",
  "loveland": "Suits people who want the foothills and a city's services together: 76,378 people at the 2020 census, at the mouth of the Big Thompson Canyon, Boyd Lake State Park, a city-owned electric utility and Pulse fiber, and Fort Collins next door. I-25 and Centerra are on the east edge, where Bustang stops on its way to Denver, 46 miles south, and the FLEX bus runs to Fort Collins, Berthoud, Longmont and Boulder. The IRES median for a single-family home in the Loveland-Berthoud market was $535,000 in June 2026. Ask three things about any address: whether it is in a metro district and at what mill levy, who supplies the water, and how close it sits to the Big Thompson, which has flooded the city twice in living memory, in 1976 and 2013.",
  "carbon-valley": "Suits people who want a newer house between Denver and Boulder. It is three old Weld County coal towns side by side a couple of miles east of I-25 and north of Erie — Frederick, Firestone and Dacono, 37,191 people together at the 2020 census and more since — sharing a rec district and a library but little else. Frederick counts downtown Denver 35 minutes away and Boulder 22 miles; Bustang stops at Exit 240 in Firestone. Most homes are in subdivisions from the last twenty-five years and the old centers are a few blocks each. Oil and gas wells sit among the houses, more than 600 drilled inside Frederick alone, so look any address up on the well maps the towns link, and on Weld County's property portal for its metro district and whether it is in the parks district.",
  "golden": "Suits people who want a city with its own economy at the foot of the mountains, twelve miles west of Denver. Washington Avenue and Clear Creek run through the middle; the Colorado School of Mines, the Coors brewery and Jefferson County's government are all here; and RTD's W Line light rail runs from Golden to Union Station, which makes it the only one of these towns with a train into Denver. It grew eight percent in a decade, among the slowest on this list. Two things to check: whether an address is inside the city at all, since not every Golden mailing address is, and how close it sits to the open space, because the edges of town are wildfire country and the City adopted a wildfire building code in 2026. Jeffco Public Schools: Golden High, Bell Middle and five elementaries.",
  "evergreen": "Suits people who want to live in the mountains and still reach Denver, thirty to forty minutes down I-70. It is unincorporated: no mayor or town hall, the Jefferson County commissioners govern, and a fire district and a park district do much of what a town would. The census place counted 9,307 people in 2020, three percent more than in 2010, but the fire district serves nearly 26,000, which is closer to what people mean by Evergreen. The lake and Bear Creek are in the middle and the elk are in the meadows. A house in the hills is often on a well and a septic system, and since July 2026 the county's wildfire code applies to new building and exterior work, so find the parcel's wildfire class and get an insurance quote before you make an offer. Jeffco Public Schools; Evergreen Middle and Evergreen High are in town.",
  "fort-lupton": "Suits people who want an older working town on the South Platte, thirty-five to forty minutes from downtown Denver by US 85. Denver Avenue is the historic main street, the town grew from an 1830s trading post whose reconstruction stands at the South Platte Valley Historical Park, and the City's recreation center reopened in 2024 with a new gym and a warm-water pool. It grew only eight percent between 2010 and 2020, while Frederick, Firestone and Dacono to its west grew by more than sixty, but the City's 2025 estimate, 10,566, is about a third above the 2020 count, and new subdivisions are being platted. Weld Re-8 runs the schools. Check whether an address is inside the city line, where City services and the recreation center's resident rates stop, and whether it is in a metro district, which adds to the tax bill.",
  "severance": "Suits people who want a new house in northern Colorado and do not need a downtown yet. It is northeast of Windsor and has grown faster than any town on this list but Timnath: 3,165 people at the 2010 census, 7,683 at the 2020 census and 11,570 by the state's 2024 estimate, most of them in new subdivisions. The Mayor describes the town as still in its infancy for shops and in-town services, and it has no recreation center of its own; Windsor's is the nearest. Weld RE-4 runs the schools with Windsor, and Range View Elementary, Severance Middle and Severance High are in town. Before you buy, ask whether the house is in an HOA or a metro district and what each charges, and who supplies its water and sewer, which differs from one subdivision to the next.",
  "estes-park": "Suits people who want to live at the east entrance to Rocky Mountain National Park and can live with what that brings: timed-entry reservations for the park from late May to mid-October, elk in the meadows for the autumn rut, and a winter when Trail Ridge Road is closed and the park is a dead end. The town itself is small and has barely grown, 5,904 people at the 2020 census, but the library district serves more than 12,000 residents across the valley, much of which is unincorporated Larimer County. Denver is an hour and a half to two hours away by US 36 through Lyons or US 34 down the Big Thompson Canyon, which was rebuilt after the 2013 flood. It has its own school district and its own hospital, and the whole valley is wildland-urban interface: the fire district will assess any house for you.",
  "nederland": "Suits people who want a real mountain town, 8,200 feet up Boulder Canyon, with Boulder below and Eldora, Barker Reservoir and the Indian Peaks above. Full-time residents of the library district get an RTD EcoPass paid for by their property taxes, so the bus down to Boulder, and the rest of RTD, costs nothing to ride. It is small and has stayed that way: 1,471 people at the 2020 census, slightly fewer by the state's 2024 estimate. Winter is the real thing, about 140 inches of snow a year and plowing the Town itself says is not on a par with Boulder's, and wildfire is part of life here. Outside the town line a house may be on a septic system, which Boulder County must inspect and approve before a sale. Boulder Valley School District; Nederland Elementary and Nederland Middle-Senior are in town.",
  "fortcollins": "Suits people who want the city rather than a town near it: a downtown that is genuinely one, a university, the Poudre through the middle and Horsetooth Reservoir just west, Transfort buses and Bustang to Denver, and the jobs the other towns commute to. The trade is scale. It is the fourth-largest city in Colorado, 169,810 people at the 2020 census, and it grew eighteen percent in a decade, most of the new part south and east, a drive from Old Town. If you are choosing between Fort Collins and one of its towns, the question is whether you would drive in for everything anyway. If so, live here."
};

const structured = collectionPageJsonLd(hub, {
  name: `The ${towns.length} towns of ${hub.siteTitle}, compared`,
  description: `${towns.map((t) => t.name).join(', ')}: population, growth, schools, the commute and what each one is actually like.`,
  path: '/moving/',
  items: towns.map((t) => ({ name: t.name, url: `https://${t.domain}/` })),
});
---
<Page
  title="Which Front Range town?"
  seoTitle={`Moving to Colorado’s Front Range: ${towns.length} towns compared`}
  eyebrow="Moving here"
  description={`${towns.map((t) => t.name).join(', ')}: population, growth, schools, the commute and what each one is actually like.`}
  intro={`All ${towns.length} towns side by side, then a straight answer on who each one suits. Every name links to its own guide.`}
  jsonLd={structured}
>
  {/* Wide: one row per town. Narrow: one card per town, same markup, because
     relocation research happens on a phone and a seven-column table at 375px
     is a horizontal scroll nobody performs. */}
  <div class="compare">
    <table>
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr>
          <th scope="col">Town</th>
          {columns.map((c) => <th scope="col" class={c.kind}>{c.label}</th>)}
        </tr>
      </thead>
      <tbody>
        {towns.map((t) => (
          <tr>
            <th scope="row">
              <a href={`https://${t.domain}/`} class="no-underline hover:text-accent-text hover:underline">{t.name}</a>
              <span class="compare-domain">{t.domain}</span>
            </th>
            {columns.map((c) => (
              <td data-label={c.label} class={c.kind}><span>{c.get(t)}</span></td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <section class="mt-20 md:mt-24">
    <SectionHeader eyebrow="Beyond the figures" title="Who each one suits" />
    <p class="-mt-2 mb-10 max-w-2xl text-lg leading-relaxed text-ink-muted">
      The table is the easy half. This is the part a table cannot do.
    </p>
    <div class="space-y-12">
      {towns.map((t) => (
        <article class="grid gap-x-10 gap-y-3 md:grid-cols-[14rem_minmax(0,1fr)]">
          <h3 class="display-md text-[1.75rem]">
            <a href={`https://${t.domain}/`} class="no-underline hover:text-accent-text hover:underline">{t.name}</a>
            <span class="mt-1 block font-body text-[0.8125rem] font-normal tracking-normal text-ink-faint">
              {countyLabel(t)} · {num(t.population)} · {growth(t)}
            </span>
          </h3>
          <div>
            <p class="max-w-[62ch] leading-relaxed text-ink-muted">{SUITS[t.slug]}</p>
            <p class="mt-3 text-[0.9375rem]">
              <a href={`https://${t.domain}/moving-here/`} class="inline-block -my-1 py-1 font-semibold text-accent-text no-underline hover:underline">
                Moving to {t.name} →
              </a>
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  {comparisons.length > 0 && (
    <section class="mt-20 md:mt-24">
      <SectionHeader eyebrow="Two towns at a time" title="Head to head" />
      <ul>
        {comparisons.map((c) => {
          const a = towns.find((t) => t.slug === c.a);
          const b = towns.find((t) => t.slug === c.b);
          return (
            <li class="border-b border-line-soft py-5">
              <a href={`/moving/${comparisonSlug(c)}/`} class="font-heading text-[1.375rem] font-medium no-underline hover:text-accent-text hover:underline">
                {a?.name} or {b?.name}?
              </a>
              <p class="mt-1.5 max-w-[68ch] text-[0.9375rem] leading-relaxed text-ink-muted">{c.verdict}</p>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <div class="prose mt-20 md:mt-24">
    <h2>Where the figures come from</h2>
    <p>
      Population is the 2020 census, and growth is 2010 to 2020, so every town is measured the same way. Several of
      these towns have grown a long way since — Timnath and Johnstown especially — and each guide's Moving Here page
      carries the later estimate and the source for it. Drive times are off-peak estimates to downtown Denver from each
      town's own guide (Elizabeth's commuters mostly go to the Tech Center, so it has both), not a promise about the
      Boulder Turnpike at half past five.
    </p>
    <p>
      There is no median-home-price column. Getting it right means a named source and a quarterly re-check, and a
      figure that is eighteen months stale is worse than no figure at all. The listings links on each town's
      Moving Here page show what is actually on the market today.
    </p>
    <h2>How they are governed</h2>
    <p>
      Niwot has never incorporated. It is a census-designated place under Boulder
      County, which means county services, no town council and no municipal tax — and an incorporation question that
      is <a href="https://insideniwot.com/articles/2026-incorporation-election/">on the ballot in 2026</a>. Evergreen is
      unincorporated too: it has no mayor, council or town hall, the Jefferson County commissioners govern it, and a
      fire district and a park district do much of what a town hall does elsewhere. Carbon Valley is a guide to three
      municipalities, Frederick, Firestone and Dacono, each with its own government, and its population figures here
      are the three added together. If you are comparing towns on how they are governed, those are the differences on
      this page.
    </p>
  </div>

  <CtaBand
    slot="after"
    eyebrow="Across the network"
    title="See what’s on before you visit"
    body={`The surest way to judge a town is to turn up on a Saturday. Every event across all ${towns.length} guides is on one page.`}
    links={[
      { label: 'This weekend', href: '/this-weekend/', primary: true },
      { label: 'All the guides', href: '/#towns' },
    ]}
  />
</Page>
