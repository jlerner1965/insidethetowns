---
/**
 * The live towns side by side, for someone deciding which one to move to.
 *
 * The parent site's first page that answers something people actually type:
 * "best small town near Boulder", "which Front Range town should I move to".
 * Nobody owns those searches because the answer is scattered across a
 * chamber site per town.
 *
 * Every column is a fact this network can source and keep current, and every
 * one comes off the town configs, so the table is a loop rather than a grid
 * somebody has to remember to update. Median home price is deliberately not
 * here: it is quarterly work with a licensing question attached, and a column
 * that cannot be filled for all of them is worse than a column that is absent.
 */
import Page from '@/layouts/Page.astro';
import CtaBand from '@/components/CtaBand.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { censusGrowth, countyLabel, countyShort, getHub, liveTowns } from '@/config';
import { collectionPageJsonLd } from '@/lib/seo';
import { comparisonSlug, liveComparisons } from '@/content/comparisons';

const hub = getHub();
const comparisons = liveComparisons();
// Biggest first: it is the ordering a reader can hold in their head, and the
// range from 170,000 to 1,700 is the first thing worth knowing about them.
const towns = [...liveTowns()].sort((a, b) => (b.population ?? 0) - (a.population ?? 0));

/** "Thompson School District R2-J: Berthoud Elementary, …" -> the district. */
const district = (full?: string) => (full ? (full.split(/[:(]/)[0] ?? full).trim() : '—');
const num = (n?: number) => (n ? n.toLocaleString('en-US') : '—');
const growth = censusGrowth;

// All or none. A price column with gaps in it invites the reader to
// assume the gaps mean "cheap", and an unsourced one is worse than absent.
const pricesReady = towns.every((t) => t.medianHomePrice && t.medianHomePriceAsOf && t.medianHomePriceSource);

const columns = [
  { key: 'county', label: 'County', caption: 'county', kind: 'nowrap', get: (t: (typeof towns)[number]) => countyShort(t) },
  { key: 'population', label: 'Population 2020', caption: 'population at the 2020 census', kind: 'num', get: (t: (typeof towns)[number]) => num(t.population) },
  // Promised by every guide's Moving Here page ("population, elevation,
  // schools and the drive to Denver, side by side") and missing here until
  // the audit of 13 October 2026 (F05). Each config's figure is GNIS's for
  // the town's own point, the same reference for all of them.
  { key: 'elevation', label: 'Elevation', caption: 'elevation', kind: 'num', get: (t: (typeof towns)[number]) => (t.elevationFt ? `${num(t.elevationFt)} ft` : '—') },
  { key: 'growth', label: 'Growth 2010–20', caption: 'growth from 2010 to 2020', kind: 'num', get: growth },
  ...(pricesReady
    ? [
        {
          key: 'price',
          label: 'Median home',
          caption: 'median home price',
          kind: 'num',
          get: (t: (typeof towns)[number]) => `$${num(t.medianHomePrice)}`,
        },
      ]
    : []),
  { key: 'denver', label: 'To Denver', caption: 'drive to Denver', kind: 'nowrap', get: (t: (typeof towns)[number]) => t.driveToDenver ?? '—' },
  { key: 'schools', label: 'Schools', caption: 'school district', kind: 'text', get: (t: (typeof towns)[number]) => district(t.movingHere.schoolDistrict) },
  { key: 'character', label: 'In a line', caption: 'what each is like', kind: 'text', get: (t: (typeof towns)[number]) => t.character ?? '—' },
];
// Read from the columns, so it cannot promise one the table does not have.
const caption = `The ${towns.length} guides' towns compared by ${columns
  .map((c) => c.caption)
  .join(', ')
  .replace(/, ([^,]*)$/, ' and $1')}`;

const SUITS: Record<string, string> = {
  "erie": "Suits people working in or near Boulder who want a newer house within reach of it, and a downtown they can walk to on a Friday. The catch is that most of Erie is subdivisions built since 2000 and only the old grid around Briggs Street is walkable, so where you buy decides whether you get the town or the commute. Ask which county, which school district and which metro district before you fall for a house: all three change from one street to the next.",
  "johnstown": "Suits northern Colorado commuters. The US 34 interchange is on the west edge, which puts Loveland at ten minutes, Greeley at fifteen, Fort Collins at twenty-five and Denver at fifty. Johnstown spans two school districts, as Erie does. Most of town is in Weld RE-5J; the northwest corner is in Thompson, so check the address. The trade is that the shopping has moved out to the interstate and Parish Avenue is quiet.",
  "berthoud": "Suits people who want a Main Street that is genuinely a main street, and the lakes. Fifteen minutes to Loveland or Longmont, twenty-five to Fort Collins, and the FLEX bus runs through it between Fort Collins, Loveland, Longmont and Boulder, so a commute without a car is possible if the timetable fits. It doubled in a decade, so a good deal of it is new.",
  "niwot": "Suits people who want small and mean it. It is unincorporated — no town council, no municipal tax, county services, and it voted against incorporating on November 3, 2026, in the county’s unofficial count. Seven percent growth in a decade, which in this company is a rounding error. Twenty minutes to Boulder or Longmont on the Diagonal, and the BOLT bus stops at Niwot Road.",
  "lyons": "Suits people who want the mountains to start at the end of the street. It is the canyon mouth: sandstone, the St. Vrain, Planet Bluegrass, and a town that rebuilt itself after the 2013 flood and talks about it. Twenty minutes to Boulder and an hour to Denver, and one bus: the free Lyons Flyer, four trips each way to Boulder on weekdays. It has barely grown, so what is for sale at any moment is a handful of listings, and the river is both the reason to live there and the thing to ask a surveyor about.",
  "windsor": "Suits people who work anywhere in northern Colorado and want to be in the middle of it: Fort Collins, Loveland and Greeley are each about twenty minutes, and Harmony Road puts I-25 at ten. It went from 18,644 people at the 2010 census to 32,716 at the 2020 census and most of the housing is new, in metro districts east and south of the old sugar-beet town; the lake, Boardwalk Park and Main Street are the old center and the reason to live near it. Two counties and three school districts inside the town limits — Weld RE-4 for most of it, Poudre or Thompson on the Larimer County side — so check the address, not the town.",
  // Lafayette and Frederick, flagships from 2 November 2026, written from
  // their own Moving here pages and the sources those cite, read that day.
  // Frederick's became Carbon Valley's on 12 November 2026 (the same facts,
  // with the three towns' summed census figures from the config).
  "carbon-valley": "Suits people who want a newer house between Denver and Boulder and will drive for it. Frederick, Firestone and Dacono are three old Weld County coal towns in a row a couple of miles east of I-25 on Colorado 52: 37,191 people between them at the 2020 census and 22,978 in 2010. Frederick, the middle one, has a six-block old town on Fifth Street, Milavec Lake and the high school all three share, the Golden Eagles. Its Town puts downtown Denver 35 minutes away and Boulder 22 miles, and lists a 6.555 mill levy against Dacono's 26.401 and Erie's 16.567; no bus serves it. Most homes are in subdivisions from the last twenty-five years, and oil and gas wells sit among them, more than 600 drilled inside Frederick alone, so look any address up on its town's well map, and ask whether it pays a metropolitan district, an HOA and the parks district.",
  // Only the seven guides have a line here: the folded and retired guides'
  // went on 12 November 2026 (git history keeps them).
};

const structured = collectionPageJsonLd(hub, {
  name: `The ${towns.length} guides of ${hub.siteTitle}, compared`,
  description: `${towns.map((t) => t.name).join(', ')}: population, growth, schools, the commute and what each one is actually like.`,
  path: '/moving/',
  items: towns.map((t) => ({ name: t.name, url: `https://${t.domain}/` })),
});
---
<Page
  title="Which Colorado town?"
  seoTitle={`Moving to Colorado: ${towns.length} Front Range guides compared`}
  eyebrow="Moving here"
  description={`${towns.map((t) => t.name).join(', ')}: population, growth, schools, the commute and what each one is actually like.`}
  intro={`All ${towns.length} guides side by side, then a straight answer on who each one suits. Every name links to its own guide.`}
  jsonLd={structured}
>
  {/* Wide: one row per town. Narrow: one card per town, same markup, because
     relocation research happens on a phone and a seven-column table at 375px
     is a horizontal scroll nobody performs. */}
  <div class="compare">
    <table>
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr>
          <th scope="col">Town</th>
          {columns.map((c) => <th scope="col" class={c.kind}>{c.label}</th>)}
        </tr>
      </thead>
      <tbody>
        {towns.map((t) => (
          <tr>
            <th scope="row">
              <a href={`https://${t.domain}/`} class="no-underline hover:text-primary hover:underline">{t.name}</a>
              <span class="compare-domain">{t.domain}</span>
            </th>
            {columns.map((c) => (
              <td data-label={c.label} class={c.kind}><span>{c.get(t)}</span></td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <section class="mt-20 md:mt-24">
    <SectionHeader eyebrow="Beyond the figures" title="Who each one suits" />
    <p class="-mt-2 mb-10 max-w-2xl text-lg leading-relaxed text-ink-muted">
      The table is the easy half. This is the part a table cannot do.
    </p>
    <div class="space-y-12">
      {towns.map((t) => (
        <article class="grid gap-x-10 gap-y-3 md:grid-cols-[14rem_minmax(0,1fr)]">
          <h3 class="display-md text-[1.75rem]">
            <a href={`https://${t.domain}/`} class="no-underline hover:text-primary hover:underline">{t.name}</a>
            <span class="mt-1 block font-body text-[0.8125rem] font-normal tracking-normal text-ink-muted">
              {countyLabel(t)} · {num(t.population)} · {growth(t)}
            </span>
          </h3>
          <div>
            {/* Written per town, from its own sources; a town without one yet
               shows its link only. */}
            {SUITS[t.slug] && <p class="max-w-[62ch] leading-relaxed text-ink-muted">{SUITS[t.slug]}</p>}
            {/* The same two things for every town, side by side, from what its
                guide already sources (its config): the commute and the school
                district in full. No housing cost: no guide has a sourced,
                dated figure yet (TownConfig.medianHomePrice), and none is
                invented. */}
            {(t.movingHere.commuteNotes || t.movingHere.schoolDistrict) && (
              <dl class="mt-4 grid max-w-[62ch] gap-y-3 text-[0.9375rem] leading-relaxed sm:grid-cols-[6.5rem_minmax(0,1fr)] sm:gap-x-4" data-moving-facts>
                {t.movingHere.commuteNotes && (
                  <Fragment>
                    <dt class="eyebrow pt-0.5 text-ink-muted">Commute</dt>
                    <dd class="text-ink-muted">{t.movingHere.commuteNotes}</dd>
                  </Fragment>
                )}
                {t.movingHere.schoolDistrict && (
                  <Fragment>
                    <dt class="eyebrow pt-0.5 text-ink-muted">Schools</dt>
                    <dd class="text-ink-muted">{t.movingHere.schoolDistrict}</dd>
                  </Fragment>
                )}
              </dl>
            )}
            <p class:list={['text-[0.9375rem]', SUITS[t.slug] && 'mt-3']}>
              <a href={`https://${t.domain}/moving-here/`} class="inline-block -my-3 py-3 font-semibold text-primary underline">
                Moving to {t.name} →
              </a>
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  {comparisons.length > 0 && (
    <section class="mt-20 md:mt-24">
      <SectionHeader eyebrow="Two towns at a time" title="Head to head" />
      <ul>
        {comparisons.map((c) => {
          const a = towns.find((t) => t.slug === c.a);
          const b = towns.find((t) => t.slug === c.b);
          return (
            <li class="border-b border-line-soft py-5">
              <a href={`/moving/${comparisonSlug(c)}/`} class="font-heading text-[1.375rem] font-medium no-underline hover:text-primary hover:underline">
                {a?.name} or {b?.name}?
              </a>
              <p class="mt-1.5 max-w-[68ch] text-[0.9375rem] leading-relaxed text-ink-muted">{c.verdict}</p>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <div class="prose mt-20 md:mt-24">
    <h2>Where the figures come from</h2>
    <p>
      Population is the 2020 census, and growth is 2010 to 2020, so every town is measured the same way. Several of
      these towns have grown a long way since, and each guide's Moving here page
      carries the later estimate and the source for it. Drive times are off-peak estimates to downtown Denver from each
      town's own guide, not a promise about the
      Boulder Turnpike at half past five. Elevation is each town's own point as the federal gazetteer gives it, not
      the highest house. A dash means we have not yet researched that figure for that town, not that there is
      nothing to say.
    </p>
    <p>
      There is no median-home-price column. Getting it right means a named source and a quarterly re-check, and a
      figure that is eighteen months stale is worse than no figure at all. The listings links on each town's
      Moving here page show what is actually on the market today.
    </p>
    <h2>How they are governed</h2>
    <p>
      Niwot is unincorporated. It is a census-designated place under Boulder
      County, which means county services, no town council and no municipal tax. Its electors <a href="https://insideniwot.com/updates/#incorporation-vote-result">voted against incorporating</a> on November 3, 2026, 2,121 to 738 in the county’s unofficial count. Windsor's
      figures are Windsor's alone, though its guide covers Severance too
      (<a href="https://insidewindsorco.com/articles/moving-to-severance/">Moving to Severance</a>). If you are
      comparing towns on how they are governed, those are the differences on this page.
    </p>
  </div>

  <CtaBand
    slot="after"
    eyebrow="Across the network"
    title="See what’s on before you visit"
    body={`The surest way to judge a town is to turn up on a Saturday. Every event across all ${towns.length} guides is on one page.`}
    links={[
      { label: 'This weekend', href: '/this-weekend/', primary: true },
      { label: 'All the guides', href: '/#towns' },
    ]}
  />
</Page>
