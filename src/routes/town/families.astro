---
/**
 * The family hub (/families/): what closes soon, what a child can join by
 * age, what there is on a school day off, the free things, and which
 * school, from content/<town>/programs/ and the district calendar in the
 * town's config (the redesign of 22 October 2026). Three age sections,
 * each program once under the first it fits (src/lib/programs.ts,
 * familyAgeGroups), every program with its own anchor so the home page's
 * cards land on it. A section with nothing in it is not drawn.
 */
import Page from '@/layouts/Page.astro';
import DeadlineCard from '@/components/DeadlineCard.astro';
import ProgramRow from '@/components/ProgramRow.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import { getTown } from '@/config';
import { getTownEntries } from '@/lib/content';
import { formatDate, formatDayRange, formatDayShort, parseLocal } from '@/lib/dates';
import { familyAgeGroups, isForFamilies, onePerProgram, upcomingDeadlines } from '@/lib/programs';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';

const town = getTown();
const families = town.families!;
const now = new Date();
const all = await getTownEntries('programs');
const programs = all.filter(isForFamilies);
const events = await getTownEntries('events');
const deadlines = onePerProgram(upcomingDeadlines(all, { now, days: 60 }));
const eventFor = (slug?: string) => (slug ? events.find((e) => e.slug === slug) : undefined);
const groups = familyAgeGroups(programs);
const free = programs.filter((p) => /^free\b/i.test(p.data.price ?? '') || /\$5\b/.test(p.data.price ?? ''));
// School breaks still ahead, from the district calendar, in date order,
// each with the program that says it keeps hours on it (openOn), if one does.
const breaks = [...families.breaks]
  .map((b) => ({ ...b, fromDate: parseLocal(b.from), toDate: parseLocal(b.to) }))
  .filter((b) => b.toDate.getTime() >= now.getTime() - 86_400_000)
  .sort((a, b) => a.fromDate.getTime() - b.fromDate.getTime())
  .map((b) => ({
    ...b,
    open: programs.flatMap((p) => (p.data.openOn ?? []).filter((o) => o.from.getTime() <= b.toDate.getTime() && o.to.getTime() >= b.fromDate.getTime()).map((o) => ({ program: p, note: o.note })))[0],
  }));
const breakSources = [...new Map(breaks.map((b) => [b.source, b])).values()];
// The town's own outing guide, where it has one: the newest article filed under Families.
const outing = (await getTownEntries('articles')).filter((a) => a.data.category === 'Families').sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];
const description = `${families.label}: what a child can join in ${town.name}, Colorado, by age, with prices, registration deadlines and school-break dates, each from the organizer's own page.`;
const chips = [
  ...(deadlines.length > 0 ? [{ id: 'deadlines', label: 'Deadlines' }] : []),
  ...groups.map((g) => ({ id: `age-${g.group.id}`, label: g.group.label.replace('Ages ', '') })),
  ...(breaks.length > 0 ? [{ id: 'breaks', label: 'Days off' }] : []),
  ...(free.length > 0 ? [{ id: 'free', label: 'Free' }] : []),
];
const structured = [
  collectionPageJsonLd(town, { name: `${families.label}: ${town.name}, Colorado`, description, path: '/families/', items: programs.map((p) => ({ name: p.data.title, path: `/families/#program-${p.slug}` })) }),
  breadcrumbJsonLd(town, [
    { name: town.name, path: '/' },
    { name: families.label, path: '/families/' },
  ]),
];
const H2 = 'display-md text-[1.75rem] md:text-[2rem]';
const chip = 'inline-flex min-h-11 shrink-0 items-center whitespace-nowrap rounded-full px-4 text-[0.9375rem] font-semibold no-underline ring-1 ring-line transition-colors hover:bg-raised';
---
<Page title={families.label} seoTitle={`${families.label}: what kids can join in ${town.name}, CO`} eyebrow="Kids, teens and school breaks" {description} intro={families.intro} jsonLd={structured} kind="Guide" narrow>
  {/* The sections as chips, stuck under the top of the screen as the page
      scrolls; one line that scrolls sideways on a phone. */}
  <nav aria-label="On this page" class="sticky top-0 z-30 -mt-2 border-b border-line-soft bg-paper py-3">
    <ul class="flex flex-wrap gap-2">
      {chips.map((c) => <li><a href={`#${c.id}`} class={chip}>{c.label}</a></li>)}
    </ul>
  </nav>

  {deadlines.length > 0 && (
    <section id="deadlines" class="mt-10 scroll-mt-20" aria-labelledby="deadlines-h">
      <h2 id="deadlines-h" class={H2}>Closing soon</h2>
      <div class="mt-4 space-y-4">
        {deadlines.map((d) => <DeadlineCard deadline={d} event={eventFor(d.program.data.nextEvent)} now={now} />)}
      </div>
      <p class="mt-3 text-[0.875rem] text-ink-muted">Only deadlines the organizer has published. A program with none listed is open until it fills, or its organizer has not said.</p>
    </section>
  )}

  {groups.map(({ group, programs: list }) => (
    <section id={`age-${group.id}`} class="mt-12 scroll-mt-20" aria-labelledby={`age-${group.id}-h`}>
      <h2 id={`age-${group.id}-h`} class={H2}>{group.label}</h2>
      <div class="mt-4 rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
        {list.map((p) => <ProgramRow program={p} />)}
      </div>
    </section>
  ))}

  <p class="mt-6">
    <a href="/sports/" class="flex items-center justify-between rounded-lg bg-primary px-5 py-4 font-semibold text-white no-underline hover:bg-primary-hover">High-school sports: schedules and scores <span aria-hidden="true">→</span></a>
  </p>

  {breaks.length > 0 && (
    <section id="breaks" class="mt-12 scroll-mt-20" aria-labelledby="breaks-h">
      <h2 id="breaks-h" class={H2}>No-school days</h2>
      <p class="mt-2 text-[0.9375rem] text-ink-muted">
        {breakSources.map((b, i) => (
          <Fragment>{i > 0 && ' and '}<a href={b.source} rel="noopener" class="underline">{b.district}</a>, read {formatDate(parseLocal(b.verified))}</Fragment>
        ))}. A day with a program open on it says so; the rest go to the family listings.
      </p>
      <ul class="mt-4 divide-y divide-line-soft rounded-lg bg-raised px-5 ring-1 ring-line-soft">
        {breaks.map((b) => (
          <li class="flex items-center justify-between gap-4 py-3.5 text-[0.9375rem]">
            <span class="min-w-0">
              <span class="block font-semibold"><time datetime={b.from}>{b.from === b.to ? formatDayShort(b.fromDate) : formatDayRange(b.fromDate, b.toDate)}</time></span>
              <span class="block text-ink-muted">{b.label}</span>
            </span>
            {b.open ? (
              <a href={`#program-${b.open.program.slug}`} class="shrink-0 rounded-full bg-accent-soft px-3 py-2 text-[0.875rem] font-semibold text-ink no-underline ring-1 ring-primary-line hover:bg-raised">{b.open.note}</a>
            ) : (
              <a href="/events/?category=family" class="inline-block -my-2 shrink-0 py-2 text-[0.875rem] font-semibold text-primary underline">What’s open →</a>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  {free.length > 0 && (
    <section id="free" class="mt-12 scroll-mt-20" aria-labelledby="free-h">
      <h2 id="free-h" class={H2}>Free, any day</h2>
      <ul class="mt-4 grid grid-cols-2 gap-3">
        {free.map((p) => (
          <li>
            <a href={`#program-${p.slug}`} class="flex h-full flex-col rounded-lg bg-raised p-4 no-underline ring-1 ring-line-soft hover:ring-primary-line">
              <span class="font-semibold leading-snug">{p.data.title}</span>
              <span class="mt-1 block text-[0.875rem] leading-snug text-ink-muted">{[p.data.price, p.data.schedule].filter(Boolean).join(' · ')}</span>
            </a>
          </li>
        ))}
        {outing && (
          <li>
            <a href={`/articles/${outing.slug}/`} class="flex h-full flex-col rounded-lg bg-raised p-4 no-underline ring-1 ring-line-soft hover:ring-primary-line">
              <span class="font-semibold leading-snug">{outing.data.title}</span>
              <span class="mt-1 block text-[0.875rem] leading-snug text-ink-muted">The guide: parks, playgrounds and trails</span>
            </a>
          </li>
        )}
      </ul>
    </section>
  )}

  <section id="schools" class="mt-12 scroll-mt-20 rounded-lg bg-accent-soft p-5 sm:p-6" aria-labelledby="schools-h">
    <h2 id="schools-h" class="text-xl font-semibold leading-snug">Which school? It depends on the address.</h2>
    {families.schools.some((s) => s.note) && (
      <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-muted">
        {families.schools.map((s) => s.note && `${s.district}: ${s.note}.`).filter(Boolean).join(' ')}
      </p>
    )}
    <div class="mt-4 flex flex-wrap gap-2">
      {families.schools.map((s) => (
        <a href={s.url} rel="noopener" data-track="service" class="btn btn-outline text-primary">{s.district}</a>
      ))}
    </div>
  </section>

  <p class="mt-10 text-[0.9375rem] leading-relaxed text-ink-muted">
    Every line is the organizer’s own: ages, prices and deadlines as its page gives them, with the day it was read. A fact the organizer does not publish is left out. Registration links go to the organizer, never through this site.
  </p>
  <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[0.9375rem]">
    <a href="/correct/" class="inline-block -my-1 py-1 font-semibold text-primary underline">Something wrong? Send a correction</a>
    <a href="/submit-event/" class="inline-block -my-1 py-1 font-semibold text-primary underline">Suggest a program</a>
    <a href="/events/?category=family" class="inline-block -my-1 py-1 font-semibold text-primary underline">Family listings on the calendar</a>
  </p>

  <div class="mt-12">
    <NewsletterSignup town={town} compact id="families" />
  </div>
</Page>
