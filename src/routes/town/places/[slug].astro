---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import { getTown } from '@/config';
import EventCard from '@/components/EventCard.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import PlaceIndex from '@/components/PlaceIndex.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { getTownEntries, type TownEntry } from '@/lib/content';
import { occurrences, uniqueByEvent, upcoming } from '@/lib/events';
import { breadcrumbJsonLd, localBusinessJsonLd } from '@/lib/seo';
import { EAT_DRINK_TYPES, LAND_TYPES, PLACE_STATUS_LABELS, PLACE_TYPE_LABELS, PLACE_TYPE_PLURALS, THINGS_TO_DO_TYPES } from '@/content/schemas';
import { formatDate } from '@/lib/dates';
import { hoursLines, hoursWithMeridiem, openingHoursOf } from '@/lib/hours';
import { byProminence, isOpen } from '@/lib/places';
import OpenStatus from '@/components/OpenStatus.astro';
import Provenance from '@/components/Provenance.astro';
import TipsLink from '@/components/TipsLink.astro';
import { accessFresh, ageDays, openMonthsLabel, seasonLabel, seasonalHoursApply } from '@/lib/freshness';

export async function getStaticPaths() {
  const places = await getTownEntries('places');
  return places.map((place) => ({ params: { slug: place.slug }, props: { place } }));
}

interface Props {
  place: TownEntry<'places'>;
}

const town = getTown();
const { place } = Astro.props;
const { data } = place;
const { Content } = await render(place);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const shareImage = data.image ? (await getImage({ src: data.image, width: 1200, height: 630, format: 'jpg' })).src : undefined;
const back = EAT_DRINK_TYPES.includes(data.type) || data.type === 'shop' ? { href: '/eat-drink/', label: 'Eat & drink' } : { href: '/things-to-do/', label: 'Things to do' };
// Closed, for good or for now: said first, in the eyebrow, the description
// and a notice above the body, so no part of the page reads as an invitation.
const open = isOpen(place);
const statusLabel = open ? undefined : PLACE_STATUS_LABELS[data.status];
const eyebrow = `${PLACE_TYPE_LABELS[data.type]}${data.priceRange ? ` · ${data.priceRange}` : ''}`;
// A listing is a short page. Without somewhere to go next it ends a third of
// the way down the screen, and the other places of its kind are the obvious
// next thing — as is anything on at this venue.
const family: readonly string[] = EAT_DRINK_TYPES.includes(data.type)
  ? [...EAT_DRINK_TYPES, 'shop']
  : THINGS_TO_DO_TYPES.includes(data.type)
    ? [...THINGS_TO_DO_TYPES, 'lodging']
    : [data.type];
// Somewhere to go next, so only places a reader can go.
const others = (await getTownEntries('places')).filter((p) => p.slug !== place.slug && isOpen(p));
const sameType = others.filter((p) => p.data.type === data.type);
const nearbyAll = (sameType.length >= 3 ? sameType : others.filter((p) => family.includes(p.data.type)))
  .sort(byProminence)
  .slice(0, 6);
// Two columns: an odd count left one name alone on the last row.
const nearby = nearbyAll.length > 2 && nearbyAll.length % 2 === 1 ? nearbyAll.slice(0, -1) : nearbyAll;
const here = uniqueByEvent(upcoming(occurrences(await getTownEntries('events'))))
  .filter((e) => e.data.venue === data.title)
  .slice(0, 3);
/**
 * Directions without a map. Google's universal directions URL opens the app
 * on a phone that has one and the site on one that does not, and costs the
 * page no script and no third-party embed, which the CSP would refuse anyway.
 * The town and state are appended unless the address already carries a
 * state; looking for the town's name would not do, since Niwot Road runs
 * through Niwot and "7960 Niwot Road" is not a full address.
 */
const destination = /,\s*CO\b/.test(data.address) ? data.address : `${data.address}, ${town.name}, CO`;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(destination)}`;
// A park, a trail or a trailhead has no one to write in as its owner; everything else does.
const hasOperator = !LAND_TYPES.includes(data.type);
const hours = openingHoursOf(data);
// The gate (src/lib/content.ts) has already stripped the hours of a closed
// place and of one whose check is older than the hours window; here the page
// says so rather than leaving the row out, because "no hours" reads as "we
// never had them" and the truth is "we are not sure they still hold".
const hoursValue =
  place.hoursHidden === 'stale' && data.verified
    ? `Not shown: last checked ${ageDays(data.verified)} days ago. Call to confirm.`
    : place.hoursHidden === 'season'
      // "Closed for the season; reopens May", from the dates or the months (src/lib/freshness.ts).
      ? `${seasonLabel(data.seasonal) ?? 'Closed for the season'}.`
      : open
        ? data.hours ?? (hasOperator ? 'Hours unknown' : undefined)
        : undefined;
/**
 * The mountain variant's season, as one row: the operator's own words for
 * when it runs, then the dates where the page gives them. In a dated season
 * the hours row above already shows the season's hours (the gate swaps them
 * in) or says the place is closed for the season; an undated season's hours
 * cannot claim today, so they are shown here as text instead.
 */
const months = openMonthsLabel(data.seasonal);
const seasonValue = data.seasonal
  ? [
      data.seasonal.season,
      // The months the operator gave, where the season text does not already say them: "open May–Oct".
      months && !data.seasonal.season.toLowerCase().includes(months.toLowerCase()) ? `open ${months}` : undefined,
      // Hours the gate did not swap in (an undated season) are shown here as text.
      data.seasonal.hours && !seasonalHoursApply(data.seasonal) ? data.seasonal.hours : undefined,
      data.seasonal.opens && data.seasonal.closes
        ? `opens ${formatDate(data.seasonal.opens)}, closes ${formatDate(data.seasonal.closes)}`
        : data.seasonal.opens
          ? `opens ${formatDate(data.seasonal.opens)}`
          : data.seasonal.closes
            ? `closes ${formatDate(data.seasonal.closes)}`
            : undefined,
      // The operator's own line, "Closed in mud season", last.
      data.seasonal.note,
    ]
      .filter(Boolean)
      .join('; ')
  : undefined;
/**
 * Getting there, on a trail, trailhead or park: parking, permits and
 * closures, each a fact that goes stale fast, so the block carries its own
 * check date and the shortest window (FRESHNESS.accessDays). Past it the
 * notes are not shown and the page says so; the land manager's live page is
 * linked either way, because that link is the one thing here that cannot go
 * stale. The town's own road and closure links (config `conditionsLinks`)
 * follow on every such page of a mountain guide.
 */
const access = LAND_TYPES.includes(data.type) ? data.access : undefined;
const accessShown = access && accessFresh(access);
const accessNotes = accessShown
  ? [
      { label: 'Parking', value: access.parking },
      { label: 'Permit', value: access.permit },
      { label: 'Closures', value: access.closures },
    ].filter((n) => n.value)
  : [];
const conditionsLinks = LAND_TYPES.includes(data.type) ? town.conditionsLinks ?? [] : [];
const beforeYouGo = access || conditionsLinks.length > 0;
const correct = `/correct/?item=${encodeURIComponent(`place/${place.slug}`)}&title=${encodeURIComponent(data.title)}`;
const facts = [
  { label: 'Address', value: data.area ? `${data.address} · ${data.area}` : data.address },
  { label: 'Directions', value: 'Open in Google Maps', href: directions },
  { label: 'Hours', value: hoursValue, lines: hoursValue && hoursValue === data.hours ? hoursLines(hoursWithMeridiem(hoursValue)) : undefined, hours: hours ?? undefined },
  { label: 'Season', value: seasonValue },
  { label: 'Phone', value: data.phone, href: data.phone ? `tel:${data.phone.replace(/[^\d+]/g, '')}` : undefined },
  { label: 'Website', value: data.url ? new URL(data.url).hostname.replace(/^www\./, '') : undefined, href: data.url },
  { label: 'Trail map', value: data.mapUrl ? 'PDF, from the land manager' : undefined, href: data.mapUrl },
].filter((f) => f.value);
---
<Page
  title={data.title}
  kind="Place"
  eyebrow={eyebrow}
  status={statusLabel}
  intro={data.summary}
  description={statusLabel ? `${statusLabel}. ${data.summary}` : data.summary}
  noindex={place.delisted}
  image={shareImage}
  imageAlt={data.imageAlt}
  jsonLd={[
    localBusinessJsonLd(town, place, url, shareImage ? new URL(shareImage, Astro.site).toString() : undefined),
    breadcrumbJsonLd(town, [
      { name: town.name, path: '/' },
      { name: back.label, path: back.href },
      { name: place.data.title, path: `/places/${place.slug}/` },
    ]),
  ]}
>
  {/*
    Two columns on a wide screen, one on a phone, and on a phone the order
    changes: the notice, then the address, hours and phone, then the picture
    and the description. They used to come after the description, the tags
    and the back link. Each column's wrapper is `contents` below lg, so its
    children take part in the outer column's `order` (as on an event page).
  */}
  <div class="flex flex-col gap-10 lg:grid lg:grid-cols-[1fr_20rem] lg:items-start lg:gap-16">
    <div class="contents lg:block">
      {statusLabel && (
        <div class="order-1 max-w-[40rem] rounded-r-lg border-l-4 border-highlight bg-highlight-soft p-5 lg:mb-10" role="note">
          <p class="eyebrow text-ink">{statusLabel}</p>
          <p class="mt-2 leading-relaxed">
            {data.statusNote}
            {data.statusSource && (
              <Fragment>
                {' '}<a href={data.statusSource} rel="noopener" class="text-accent-text">Source →</a>
              </Fragment>
            )}
          </p>
          <p class="mt-2 text-[0.875rem] leading-relaxed text-ink-muted">
            Know different? <a href={correct} class="text-accent-text underline">Tell us</a> and the listing is corrected.
          </p>
        </div>
      )}
      <div class="order-3">
        {data.image && (
          <figure class:list={['mb-10', data.image.width < 800 && 'max-w-xl']}>
            <Image src={data.image} alt={data.imageAlt ?? ''} width={1200} height={800} class="rounded-lg" />
            {data.imageCredit && (
              <figcaption class="mt-2 text-[0.8125rem] text-ink-faint">Photo: {data.imageCredit}</figcaption>
            )}
          </figure>
        )}
        <div class="prose">
          <Content />
        </div>
        {/* Read as words, not as the bordered pills they were, which looked
            like filter buttons and showed the raw slugs ("no-dogs"). */}
        {data.tags.length > 0 && (
          <p class="mt-10 text-[0.9375rem] text-ink-muted">
            <span class="eyebrow mr-2 text-ink-faint">At a glance</span>
            {data.tags.map((tag) => tag.replace(/-/g, ' ')).join(' · ')}
          </p>
        )}
        {/* Without a photograph the column ended well above the facts beside
            it. The ask for one, which otherwise sits at the foot of the
            sidebar, goes where the photograph would be. */}
        {!data.image && (
          <p class="mt-10 rounded-lg border border-dashed border-line px-5 py-4 text-[0.9375rem] leading-snug">
            <a href={correct} class="font-semibold text-accent-text no-underline hover:underline">
              {hasOperator ? `Own or run ${data.title}?` : `Know ${data.title} well?`}
            </a>
            <span class="mt-1 block text-[0.875rem] leading-relaxed text-ink-muted">
              Send a photo, new hours or a correction. Listings are editorial and free; nobody pays to be here.
              {hasOperator && <a href="/for-businesses/" class="text-accent-text underline">How listings work.</a>}
              <TipsLink class="mt-1 block text-accent-text underline" />
            </span>
          </p>
        )}
      </div>
      <p class="order-5 text-[0.9375rem] lg:mt-12"><a href={back.href} class="inline-block -my-1 py-1 font-semibold text-accent-text no-underline hover:underline">← {back.label}</a></p>
    </div>
    <div class="contents lg:block lg:pt-1">
      <aside class="order-2">
        <dl class="divide-y divide-line-soft border-y border-line-soft">
          {facts.map((f) => (
            <div class="py-4" data-hours={f.hours ? JSON.stringify(f.hours) : undefined}>
              <dt class="eyebrow">{f.label}</dt>
              <dd class="mt-1.5 leading-snug">
                {f.href ? (
                  <a href={f.href} rel={f.href.startsWith('http') ? 'noopener' : undefined} class="inline-block -my-1 py-1 text-accent-text">{f.value}</a>
                ) : f.lines ? (
                  f.lines.map((line) => <span class="block">{line}</span>)
                ) : (
                  f.value
                )}
                {f.hours && <span class="open-status mt-1 block text-[0.9375rem] font-semibold" data-open-status hidden></span>}
              </dd>
            </div>
          ))}
        </dl>
        <OpenStatus />
        {beforeYouGo && (
          <section class="mt-6 border-t border-line-soft pt-6" aria-labelledby="before-you-go">
            <h2 id="before-you-go" class="eyebrow">Before you go</h2>
            {accessNotes.length > 0 && (
              <dl class="mt-3 grid gap-3 text-[0.9375rem] leading-snug">
                {accessNotes.map((n) => (
                  <div>
                    <dt class="font-semibold">{n.label}</dt>
                    <dd class="mt-0.5 text-ink-muted">{n.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            {access && !accessShown && (
              <p class="mt-3 text-[0.875rem] leading-relaxed text-ink-muted">
                Parking, permit and closure notes not shown: last checked {ageDays(access.verified)} days ago. Check the land manager’s page below.
              </p>
            )}
            {(access?.conditionsUrl || conditionsLinks.length > 0) && (
              <ul class="mt-3 grid gap-2 text-[0.9375rem] leading-snug">
                {access?.conditionsUrl && (
                  <li>
                    <a href={access.conditionsUrl} rel="noopener" class="font-semibold text-accent-text">{access.conditionsLabel ?? 'Current conditions'}</a>
                    <span class="block text-[0.875rem] text-ink-muted">The land manager’s own page; we link it rather than repeat it.</span>
                  </li>
                )}
                {conditionsLinks.map((l) => (
                  <li>
                    <a href={l.url} rel="noopener" class="font-semibold text-accent-text">{l.label}</a>
                    {l.note && <span class="block text-[0.875rem] text-ink-muted">{l.note}</span>}
                  </li>
                ))}
              </ul>
            )}
            {accessShown && (
              <p class="mt-3 text-xs leading-relaxed text-ink-faint">
                Access notes checked {formatDate(access.verified)} against <a href={access.source} rel="noopener" class="underline">{new URL(access.source).hostname.replace(/^www\./, '')}</a>.
              </p>
            )}
          </section>
        )}
      </aside>
      <div class="order-4 -mt-4 lg:mt-0">
        <Provenance
          verified={data.verified}
          source={data.source}
          item={`place/${place.slug}`}
          title={data.title}
          note="Hours and phone numbers change fastest, so the business’s own page is the record."
        />
        {/*
          Most of these listings have no photograph and many have no hours, and
          those gaps close fastest when the people who know are asked on the page
          where the gap shows. The link lands on the contact form with the
          place's name already in the subject line.
        */}
        {data.image && (
        <p class="mt-6 border-t border-line-soft pt-6 text-[0.9375rem] leading-snug">
          <a href={correct} class="font-semibold text-accent-text no-underline hover:underline">
            {hasOperator ? `Own or run ${data.title}?` : `Know ${data.title} well?`}
          </a>
          <span class="mt-1 block text-[0.875rem] leading-relaxed text-ink-muted">
            Send a photo, new hours or a correction. Listings are editorial and free; nobody pays to be here.
            {hasOperator && <a href="/for-businesses/" class="text-accent-text underline">How listings work.</a>}
            <TipsLink class="mt-1 block text-accent-text underline" />
          </span>
        </p>
        )}
      </div>
    </div>
  </div>

  {here.length > 0 && (
    <section class="mt-20 md:mt-24">
      <SectionHeader eyebrow={`On at ${data.title}`} title="What’s coming up" href="/events/" linkLabel="All events" />
      <div class="border-b border-line-soft">
        {here.map((event) => <EventCard event={event} />)}
      </div>
    </section>
  )}

  {nearby.length > 0 && (
    <section class="mt-20 md:mt-24">
      <SectionHeader
        eyebrow={`More in ${town.name}`}
        title={nearby.every((p) => p.data.type === data.type) ? PLACE_TYPE_PLURALS[data.type] : back.label}
        href={back.href}
        linkLabel={`All ${back.label.toLowerCase()}`}
      />
      <PlaceIndex places={nearby} />
    </section>
  )}
  <div class="mt-20 md:mt-24">
    <NewsletterSignup town={town} compact id="place-signup" />
  </div>
</Page>
