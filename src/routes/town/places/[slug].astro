---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import { getTown } from '@/config';
import EventCard from '@/components/EventCard.astro';
import PlaceIndex from '@/components/PlaceIndex.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { getTownEntries, type TownEntry } from '@/lib/content';
import { occurrences, uniqueByEvent, upcoming } from '@/lib/events';
import { breadcrumbJsonLd, localBusinessJsonLd } from '@/lib/seo';
import { EAT_DRINK_TYPES, PLACE_STATUS_LABELS, PLACE_TYPE_LABELS, PLACE_TYPE_PLURALS, THINGS_TO_DO_TYPES } from '@/content/schemas';
import { openingHoursOf } from '@/lib/hours';
import { byProminence, isOpen } from '@/lib/places';
import OpenStatus from '@/components/OpenStatus.astro';
import Provenance from '@/components/Provenance.astro';
import { ageDays } from '@/lib/freshness';

export async function getStaticPaths() {
  const places = await getTownEntries('places');
  return places.map((place) => ({ params: { slug: place.slug }, props: { place } }));
}

interface Props {
  place: TownEntry<'places'>;
}

const town = getTown();
const { place } = Astro.props;
const { data } = place;
const { Content } = await render(place);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const shareImage = data.image ? (await getImage({ src: data.image, width: 1200, height: 630, format: 'jpg' })).src : undefined;
const back = EAT_DRINK_TYPES.includes(data.type) || data.type === 'shop' ? { href: '/eat-drink/', label: 'Eat & drink' } : { href: '/things-to-do/', label: 'Things to do' };
// Closed, for good or for now: said first, in the eyebrow, the description
// and a notice above the body, so no part of the page reads as an invitation.
const open = isOpen(place);
const statusLabel = open ? undefined : PLACE_STATUS_LABELS[data.status];
const eyebrow = `${statusLabel ? `${statusLabel} · ` : ''}${PLACE_TYPE_LABELS[data.type]}${data.priceRange ? ` · ${data.priceRange}` : ''}`;
// A listing is a short page. Without somewhere to go next it ends a third of
// the way down the screen, and the other places of its kind are the obvious
// next thing — as is anything on at this venue.
const family: readonly string[] = EAT_DRINK_TYPES.includes(data.type)
  ? [...EAT_DRINK_TYPES, 'shop']
  : THINGS_TO_DO_TYPES.includes(data.type)
    ? [...THINGS_TO_DO_TYPES, 'lodging']
    : [data.type];
// Somewhere to go next, so only places a reader can go.
const others = (await getTownEntries('places')).filter((p) => p.slug !== place.slug && isOpen(p));
const sameType = others.filter((p) => p.data.type === data.type);
const nearby = (sameType.length >= 3 ? sameType : others.filter((p) => family.includes(p.data.type)))
  .sort(byProminence)
  .slice(0, 6);
const here = uniqueByEvent(upcoming(occurrences(await getTownEntries('events'))))
  .filter((e) => e.data.venue === data.title)
  .slice(0, 3);
/**
 * Directions without a map. Google's universal directions URL opens the app
 * on a phone that has one and the site on one that does not, and costs the
 * page no script and no third-party embed, which the CSP would refuse anyway.
 * The town and state are appended unless the address already carries a
 * state; looking for the town's name would not do, since Niwot Road runs
 * through Niwot and "7960 Niwot Road" is not a full address.
 */
const destination = /,\s*CO\b/.test(data.address) ? data.address : `${data.address}, ${town.name}, CO`;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(destination)}`;
// A park or a trail has no one to write in as its owner; everything else does.
const hasOperator = !['park', 'trail'].includes(data.type);
const hours = openingHoursOf(data);
// The gate (src/lib/content.ts) has already stripped the hours of a closed
// place and of one whose check is older than the hours window; here the page
// says so rather than leaving the row out, because "no hours" reads as "we
// never had them" and the truth is "we are not sure they still hold".
const hoursValue =
  place.hoursHidden === 'stale' && data.verified
    ? `Not shown: last checked ${ageDays(data.verified)} days ago. Call to confirm.`
    : open
      ? data.hours
      : undefined;
const correct = `/correct/?item=${encodeURIComponent(`place/${place.slug}`)}&title=${encodeURIComponent(data.title)}`;
const facts = [
  { label: 'Address', value: data.area ? `${data.address} · ${data.area}` : data.address },
  { label: 'Directions', value: 'Open in Google Maps', href: directions },
  { label: 'Hours', value: hoursValue, hours: hours ?? undefined },
  { label: 'Phone', value: data.phone, href: data.phone ? `tel:${data.phone.replace(/[^\d+]/g, '')}` : undefined },
  { label: 'Website', value: data.url ? new URL(data.url).hostname.replace(/^www\./, '') : undefined, href: data.url },
  { label: 'Trail map', value: data.mapUrl ? 'PDF, from the land manager' : undefined, href: data.mapUrl },
].filter((f) => f.value);
---
<Page
  title={data.title}
  kind="Place"
  eyebrow={eyebrow}
  intro={data.summary}
  description={statusLabel ? `${statusLabel}. ${data.summary}` : data.summary}
  noindex={place.delisted}
  image={shareImage}
  imageAlt={data.imageAlt}
  jsonLd={[
    localBusinessJsonLd(town, place, url, shareImage ? new URL(shareImage, Astro.site).toString() : undefined),
    breadcrumbJsonLd(town, [
      { name: town.name, path: '/' },
      { name: back.label, path: back.href },
      { name: place.data.title, path: `/places/${place.slug}/` },
    ]),
  ]}
>
  <div class="grid gap-12 lg:grid-cols-[1fr_20rem] lg:gap-16">
    <div>
      {statusLabel && (
        <div class="mb-10 rounded-lg border-l-4 border-ink bg-raised p-5 ring-1 ring-line-soft" role="note">
          <p class="eyebrow">{statusLabel}</p>
          <p class="mt-2 leading-relaxed">
            {data.statusNote}
            {data.statusSource && (
              <Fragment>
                {' '}<a href={data.statusSource} rel="noopener" class="text-accent-text">Source →</a>
              </Fragment>
            )}
          </p>
          <p class="mt-2 text-[0.875rem] leading-relaxed text-ink-muted">
            Know different? <a href={correct} class="text-accent-text underline">Tell us</a> and the listing is corrected.
          </p>
        </div>
      )}
      {data.image && (
        <figure class="mb-10">
          <Image src={data.image} alt={data.imageAlt ?? ''} width={1200} height={800} class="rounded-lg" />
          {data.imageCredit && (
            <figcaption class="mt-2 text-[0.8125rem] text-ink-faint">Photo: {data.imageCredit}</figcaption>
          )}
        </figure>
      )}
      <div class="prose">
        <Content />
      </div>
      {data.tags.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-2">
          {data.tags.map((tag) => <li class="rounded-full border border-line px-3 py-1 text-xs font-medium text-ink-muted">{tag}</li>)}
        </ul>
      )}
      <p class="mt-12 text-[0.9375rem]"><a href={back.href} class="font-semibold text-accent-text no-underline hover:underline">← {back.label}</a></p>
    </div>
    <aside class="lg:pt-1">
      <dl class="divide-y divide-line-soft border-y border-line-soft">
        {facts.map((f) => (
          <div class="py-4" data-hours={f.hours ? JSON.stringify(f.hours) : undefined}>
            <dt class="eyebrow">{f.label}</dt>
            <dd class="mt-1.5 leading-snug">
              {f.href ? <a href={f.href} rel={f.href.startsWith('http') ? 'noopener' : undefined} class="text-accent-text">{f.value}</a> : f.value}
              {f.hours && <span class="open-status mt-1 block text-[0.9375rem] font-semibold" data-open-status hidden></span>}
            </dd>
          </div>
        ))}
      </dl>
      <OpenStatus />
      <Provenance
        verified={data.verified}
        source={data.source}
        item={`place/${place.slug}`}
        title={data.title}
        note="Hours and phone numbers change fastest, so the business’s own page is the record."
      />
      {/*
        Most of these listings have no photograph and many have no hours, and
        those gaps close fastest when the people who know are asked on the page
        where the gap shows. The link lands on the contact form with the
        place's name already in the subject line.
      */}
      <p class="mt-6 border-t border-line-soft pt-6 text-[0.9375rem] leading-snug">
        <a href={correct} class="font-semibold text-accent-text no-underline hover:underline">
          {hasOperator ? `Own or run ${data.title}?` : `Know ${data.title} well?`}
        </a>
        <span class="mt-1 block text-[0.875rem] leading-relaxed text-ink-muted">
          Send a photo, new hours or a correction. Listings are editorial and free; nobody pays to be here.
          {hasOperator && <a href="/for-businesses/" class="text-accent-text underline">How listings work.</a>}
        </span>
      </p>
    </aside>
  </div>

  {here.length > 0 && (
    <section class="mt-20 md:mt-24">
      <SectionHeader eyebrow={`On at ${data.title}`} title="What’s coming up" href="/events/" linkLabel="All events" />
      <div class="border-b border-line-soft">
        {here.map((event) => <EventCard event={event} />)}
      </div>
    </section>
  )}

  {nearby.length > 0 && (
    <section class="mt-20 md:mt-24">
      <SectionHeader
        eyebrow={`More in ${town.name}`}
        title={nearby.every((p) => p.data.type === data.type) ? PLACE_TYPE_PLURALS[data.type] : back.label}
        href={back.href}
        linkLabel={`All ${back.label.toLowerCase()}`}
      />
      <PlaceIndex places={nearby} />
    </section>
  )}
</Page>
