---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import { getTown } from '@/config';
import { getTownEntries, type TownEntry } from '@/lib/content';
import { localBusinessJsonLd } from '@/lib/seo';
import { EAT_DRINK_TYPES, PLACE_TYPE_LABELS } from '@/content/schemas';

export async function getStaticPaths() {
  const places = await getTownEntries('places');
  return places.map((place) => ({ params: { slug: place.slug }, props: { place } }));
}

interface Props {
  place: TownEntry<'places'>;
}

const town = getTown();
const { place } = Astro.props;
const { data } = place;
const { Content } = await render(place);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const shareImage = data.image ? (await getImage({ src: data.image, width: 1200, height: 630, format: 'jpg' })).src : undefined;
const back = EAT_DRINK_TYPES.includes(data.type) ? { href: '/eat-drink/', label: 'Eat & drink' } : { href: '/things-to-do/', label: 'Things to do' };
const eyebrow = `${PLACE_TYPE_LABELS[data.type]}${data.priceRange ? ` · ${data.priceRange}` : ''}`;
const facts = [
  { label: 'Address', value: data.address },
  { label: 'Hours', value: data.hours },
  { label: 'Phone', value: data.phone, href: data.phone ? `tel:${data.phone.replace(/[^\d+]/g, '')}` : undefined },
  { label: 'Website', value: data.url ? new URL(data.url).hostname.replace(/^www\./, '') : undefined, href: data.url },
].filter((f) => f.value);
---
<Page
  title={data.title}
  eyebrow={eyebrow}
  intro={data.summary}
  description={data.summary}
  image={shareImage}
  imageAlt={data.imageAlt}
  jsonLd={localBusinessJsonLd(town, place, url, shareImage ? new URL(shareImage, Astro.site).toString() : undefined)}
>
  <div class="grid gap-12 lg:grid-cols-[1fr_20rem] lg:gap-16">
    <div>
      {data.image && <Image src={data.image} alt={data.imageAlt ?? ''} width={1200} height={800} class="mb-10 rounded-lg" />}
      <div class="prose">
        <Content />
      </div>
      {data.tags.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-2">
          {data.tags.map((tag) => <li class="rounded-full border border-line px-3 py-1 text-xs font-medium text-ink-muted">{tag}</li>)}
        </ul>
      )}
      <p class="mt-12 text-[0.9375rem]"><a href={back.href} class="font-semibold text-accent-dark no-underline hover:underline">← {back.label}</a></p>
    </div>
    <aside class="lg:pt-1">
      <dl class="divide-y divide-line-soft border-y border-line-soft">
        {facts.map((f) => (
          <div class="py-4">
            <dt class="eyebrow">{f.label}</dt>
            <dd class="mt-1.5 leading-snug">
              {f.href ? <a href={f.href} rel={f.href.startsWith('http') ? 'noopener' : undefined} class="text-accent-dark">{f.value}</a> : f.value}
            </dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>
</Page>
