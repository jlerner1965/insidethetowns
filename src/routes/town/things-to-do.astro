---
import Page from '@/layouts/Page.astro';
import PlaceDirectory from '@/components/PlaceDirectory.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import SubTownLinks from '@/components/SubTownLinks.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getTown } from '@/config';
import { getTownEntries } from '@/lib/content';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';
import { byProminence } from '@/lib/places';
import { THINGS_TO_DO_TYPES } from '@/content/schemas';

const town = getTown();
const all = (await getTownEntries('places')).filter((p) => !p.delisted);
const places = all.filter((p) => THINGS_TO_DO_TYPES.includes(p.data.type)).sort(byProminence);
const lodging = all.filter((p) => p.data.type === 'lodging').sort(byProminence);
const outdoors = (await getTownEntries('articles')).filter(
  (a) => a.data.tags.includes('outdoors') || a.data.category.toLowerCase() === 'outdoors',
);
const listing = [...places, ...lodging].map((p) => ({ name: p.data.title, path: `/places/${p.slug}/` }));
/** One line for the meta description and the CollectionPage markup; see /eat-drink/. */
const description = `Trails, parks and venues in and around ${town.name}, ${town.state}: where to go for an afternoon outdoors, what is there and who looks after it.`;
/**
 * A mountain guide's road and closure links (config `conditionsLinks`): the
 * reader checks CDOT, or the park, before driving up. Linked, never
 * restated. A Front Range config has none and the block is not drawn.
 */
const conditionsLinks = town.conditionsLinks ?? [];
const structured = [
  collectionPageJsonLd(town, {
    name: `Things to do in ${town.name}, Colorado`,
    description,
    path: '/things-to-do/',
    items: listing,
  }),
  breadcrumbJsonLd(town, [
    { name: town.name, path: '/' },
    { name: 'Things to Do', path: '/things-to-do/' },
  ]),
];
---
<Page title="Things to Do" jsonLd={structured} seoTitle={`Things to do in ${town.name}, Colorado`} eyebrow={town.name} {description} intro={`Trails, parks and places worth an afternoon in and around ${town.name}.`}>
  <SubTownLinks slot="after-header" class="mt-5" />
  {conditionsLinks.length > 0 && (
    <aside slot="after-header" class="mt-6 max-w-2xl rounded-lg border-l-4 border-accent bg-raised p-5 ring-1 ring-line-soft" aria-labelledby="roads">
      <p id="roads" class="eyebrow">Roads and closures</p>
      <ul class="mt-2 grid gap-1.5 text-[0.9375rem] leading-snug">
        {conditionsLinks.map((l) => (
          <li>
            <a href={l.url} rel="noopener" class="font-semibold text-primary">{l.label}</a>
            {l.note && <span class="text-ink-muted"> — {l.note}</span>}
          </li>
        ))}
      </ul>
      <p class="mt-2 text-[0.8125rem] leading-relaxed text-ink-muted">Official pages, linked live. This guide does not report road or trail conditions itself.</p>
    </aside>
  )}
  {/* Places to stay are one more group of the list, as the shops are on Eat
     & Drink: their own heading, count and filter button. */}
  <PlaceDirectory places={[...places, ...lodging]} heading="Trails, parks, venues and places to stay" filterable emptyMessage="No trails, parks or venues listed yet." />
  {outdoors.length > 0 && (
    <section class="mt-20">
      <SectionHeader eyebrow="From the guide" title="Outdoors, in depth" href="/guides/" linkLabel="All guides" />
      {outdoors.length === 1 ? (
        <ArticleCard article={outdoors[0]} row />
      ) : (
        <div class="grid gap-x-8 gap-y-10 md:grid-cols-2">
          {outdoors.map((article) => <ArticleCard article={article} />)}
        </div>
      )}
    </section>
  )}
</Page>
