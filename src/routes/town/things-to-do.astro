---
import Page from '@/layouts/Page.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import PlaceDirectory from '@/components/PlaceDirectory.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import SubTownLinks from '@/components/SubTownLinks.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getTown } from '@/config';
import { getTownEntries, getTownEntry } from '@/lib/content';
import PicksGuide from '@/components/PicksGuide.astro';
import { picksFirst } from '@/lib/picks';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';
import { byProminence } from '@/lib/places';
import { THINGS_TO_DO_TYPES } from '@/content/schemas';
import NearThisTown from '@/components/NearThisTown.astro';
import NearbyArticles from '@/components/NearbyArticles.astro';
import { placeKey } from '@/lib/hub-towns';
import { STANDALONE_GUIDES } from '@/config/hub-towns';

const town = getTown();
const all = (await getTownEntries('places')).filter((p) => !p.delisted);
const places = all.filter((p) => THINGS_TO_DO_TYPES.includes(p.data.type)).sort(byProminence);
const lodging = all.filter((p) => p.data.type === 'lodging').sort(byProminence);
const outdoors = (await getTownEntries('articles')).filter(
  (a) => a.data.tags.includes('outdoors') || a.data.category.toLowerCase() === 'outdoors',
);
const listing = [...places, ...lodging].map((p) => ({ name: p.data.title, path: `/places/${p.slug}/` }));
// The picks guide above the directory, where the guide has one
// (content/<town>/pages/things-to-do.md; PicksGuide.astro).
const guide = await getTownEntry('pages', 'things-to-do');
const pickPaths = (guide?.data.picks ?? []).map((p) => `/places/${p.place}/`);
/** One line for the meta description and the CollectionPage markup; see /eat-drink/. */
const description = guide?.data.description ?? `Trails, parks and venues in and around ${town.name}, ${town.state}: where to go for an afternoon outdoors, what is there and who looks after it.`;
/**
 * A mountain guide's road and closure links (config `conditionsLinks`): the
 * reader checks CDOT, or the park, before driving up. Linked, never
 * restated. A Front Range config has none and the block is not drawn.
 */
const conditionsLinks = town.conditionsLinks ?? [];
// "Near this town" (src/components/NearThisTown.astro), on a standalone guide only.
const nearKey = placeKey(town.slug);
const nearPlace = nearKey && STANDALONE_GUIDES[nearKey] ? nearKey : undefined;
const structured = [
  collectionPageJsonLd(town, {
    name: `Things to do in ${town.name}, Colorado`,
    description,
    path: '/things-to-do/',
    items: picksFirst(listing, pickPaths),
  }),
  breadcrumbJsonLd(town, [
    { name: town.name, path: '/' },
    { name: 'Things to do', path: '/things-to-do/' },
  ]),
];
---
{/* The town's name in the heading, not only in the eyebrow and the <title>:
    the page ranked around position 30 to 60 for "things to do in <town>" on
    every guide while its H1 said "Things to do" (the search audit of 7
    November 2026). */}
<Page title={`Things to do in ${town.name}`} jsonLd={structured} seoTitle={guide?.data.seoTitle ?? `Things to do in ${town.name}, Colorado`} eyebrow={town.name} {description} intro={`Trails, parks and places worth an afternoon in and around ${town.name}.`}>
  <SubTownLinks slot="after-header" class="mt-5" />
  {conditionsLinks.length > 0 && (
    <aside slot="after-header" class="mt-6 max-w-2xl rounded-lg border-l-4 border-accent bg-raised p-5 ring-1 ring-line-soft" aria-labelledby="roads">
      <p id="roads" class="eyebrow">Roads and closures</p>
      <ul class="mt-2 grid gap-1.5 text-[0.9375rem] leading-snug">
        {conditionsLinks.map((l) => (
          <li>
            <a href={l.url} rel="noopener" class="font-semibold text-primary underline">{l.label}</a>
            {l.note && <span class="text-ink-muted"> — {l.note}</span>}
          </li>
        ))}
      </ul>
      <p class="mt-2 text-[0.875rem] leading-relaxed text-ink-muted">Official pages, linked live. This guide does not report road or trail conditions itself.</p>
    </aside>
  )}
  {/* Places to stay are one more group of the list, as the shops are on Eat
     & Drink: their own heading, count and filter button. */}
  {/* Three picks, the list with its filters, then the rest of the picks (the audit of 13 November 2026). */}
  {guide && <PicksGuide page={guide} places={[...places, ...lodging]} part="lead" />}
  <div id="directory" class="scroll-mt-6">
    <PlaceDirectory places={[...places, ...lodging]} heading={`${guide ? 'Every trail, park and venue' : 'Trails, parks and venues'}${lodging.length > 0 ? ', and places to stay' : ''}`} filterable emptyMessage="No trails, parks or venues listed yet." />
  </div>
  {guide && <PicksGuide page={guide} places={[...places, ...lodging]} part="rest" />}
  {outdoors.length > 0 && (
    <section class="mt-20">
      <SectionHeader eyebrow="From the guide" title="Outdoors, in depth" href="/guides/" linkLabel="All guides" />
      {outdoors.length === 1 ? (
        <ArticleCard article={outdoors[0]} row />
      ) : (
        <div class="grid gap-x-8 gap-y-10 md:grid-cols-2">
          {outdoors.map((article) => <ArticleCard article={article} />)}
        </div>
      )}
    </section>
  )}
  {nearPlace && <NearThisTown place={nearPlace} name={town.name} class="mt-20" />}
  {/* The hub's articles anchored to this guide's town, as links only (the brief of 13 November 2026). */}
  {nearPlace && <NearbyArticles place={nearPlace} />}
  {/* The Thursday email, once, under the list: this page type had no form
      at all (the sweep of 10 November 2026). Nothing on a guide the email
      does not cover (NewsletterSignup). */}
  <NewsletterSignup town={town} id="things-to-do" variant="home" class="mt-14" />
</Page>
