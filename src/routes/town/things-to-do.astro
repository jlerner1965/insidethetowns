---
import Page from '@/layouts/Page.astro';
import PlaceDirectory from '@/components/PlaceDirectory.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getTown } from '@/config';
import { getTownEntries } from '@/lib/content';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';
import { THINGS_TO_DO_TYPES } from '@/content/schemas';

const town = getTown();
const all = await getTownEntries('places');
const byFeatured = (a: { data: { featured: boolean; title: string } }, b: { data: { featured: boolean; title: string } }) =>
  Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title);
const places = all.filter((p) => THINGS_TO_DO_TYPES.includes(p.data.type)).sort(byFeatured);
const lodging = all.filter((p) => p.data.type === 'lodging').sort(byFeatured);
const outdoors = (await getTownEntries('articles')).filter(
  (a) => a.data.tags.includes('outdoors') || a.data.category.toLowerCase() === 'outdoors',
);
const listing = [...places, ...lodging].map((p) => ({ name: p.data.title, path: `/places/${p.slug}/` }));
const structured = [
  collectionPageJsonLd(town, {
    name: `Things to do in ${town.name}, Colorado`,
    description: `Trails, parks and venues in and around ${town.name}, ${town.state}.`,
    path: '/things-to-do/',
    items: listing,
  }),
  breadcrumbJsonLd(town, [
    { name: town.name, path: '/' },
    { name: 'Things to Do', path: '/things-to-do/' },
  ]),
];
---
<Page title="Things to Do" jsonLd={structured} seoTitle={`Things to do in ${town.name}, Colorado`} eyebrow={town.name} description={`Trails, parks and venues in and around ${town.name}, ${town.state}.`} intro={`Trails, parks and places worth an afternoon in and around ${town.name}.`}>
  <PlaceDirectory places={places} heading="Trails, parks and venues" filterable emptyMessage="No trails, parks or venues listed yet." />
  {lodging.length > 0 && (
    <section class="mt-20">
      <h2 class="eyebrow mb-8 border-b-2 border-accent pb-4">Stay the night</h2>
      <PlaceDirectory places={lodging} lead={2} />
    </section>
  )}
  {outdoors.length > 0 && (
    <section class="mt-20">
      <h2 class="eyebrow mb-8 border-b-2 border-accent pb-4">Outdoors, in depth</h2>
      <div class="grid gap-x-8 gap-y-10 md:grid-cols-2">
        {outdoors.map((article) => <ArticleCard article={article} />)}
      </div>
    </section>
  )}
</Page>
