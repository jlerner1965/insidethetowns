---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import { getTown } from '@/config';
import { getTownEntries, type TownEntry } from '@/lib/content';
import { formatDayLong, formatTimeRange, toIsoLocal } from '@/lib/dates';
import { eventJsonLd } from '@/lib/seo';
import { CATEGORY_LABELS } from '@/content/schemas';

export async function getStaticPaths() {
  const events = await getTownEntries('events');
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

interface Props {
  event: TownEntry<'events'>;
}

const town = getTown();
const { event } = Astro.props;
const { data } = event;
const { Content } = await render(event);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const shareImage = data.image ? (await getImage({ src: data.image, width: 1200, height: 630, format: 'jpg' })).src : undefined;
const description = `${formatDayLong(data.start)}, ${formatTimeRange(data.start, data.end, data.allDay)} at ${data.venue}, ${town.name}.`;
---
<Page
  title={data.title}
  description={description}
  image={shareImage}
  imageAlt={data.imageAlt}
  jsonLd={eventJsonLd(town, event, url, shareImage ? new URL(shareImage, Astro.site).toString() : undefined)}
  narrow
>
  <dl class="mb-8 grid gap-x-8 gap-y-3 rounded-lg border border-line bg-white p-6 sm:grid-cols-2">
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">When</dt>
      <dd class="mt-1 font-medium">
        <time datetime={toIsoLocal(data.start)}>{formatDayLong(data.start)}</time><br />
        {formatTimeRange(data.start, data.end, data.allDay)}
        {data.recurring && <span class="block text-sm text-ink-muted">{data.recurring}</span>}
      </dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Where</dt>
      <dd class="mt-1 font-medium">{data.venue}{data.address && <span class="block text-sm text-ink-muted">{data.address}</span>}</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Cost</dt>
      <dd class="mt-1 font-medium">{data.cost ?? 'See organizer'}</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Category</dt>
      <dd class="mt-1 font-medium">{CATEGORY_LABELS[data.category]}</dd>
    </div>
    {data.url && (
      <div class="sm:col-span-2">
        <a href={data.url} rel="noopener" class="inline-block rounded-md bg-accent px-4 py-2 font-semibold text-white hover:bg-accent-dark">Organizer’s page →</a>
      </div>
    )}
  </dl>
  {data.image && <Image src={data.image} alt={data.imageAlt ?? ''} width={960} height={640} class="mb-8 rounded-lg" />}
  <div class="prose">
    <Content />
  </div>
  <p class="mt-10 text-sm"><a href="/events/" class="text-accent-dark underline">← All events</a></p>
</Page>
