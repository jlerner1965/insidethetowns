---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import { getTown } from '@/config';
import { getTownEntries, type TownEntry } from '@/lib/content';
import { dayKey, formatDate, formatDayLong, formatDayRange, formatDayShort, formatMonthDay, formatTime, formatTimeRange, formatWeekday, toIsoLocal } from '@/lib/dates';
import { exportWhen, finalDay, isCanceled, isInProgress, isMultiDay, isOver, lastDay, listedUntil, nextOccurrence, occurrences, uniqueByEvent, upcoming } from '@/lib/events';
import { googleCalendarUrl, showKey } from '@/lib/ics';
import { pickCanonical } from '@/lib/series';
import { breadcrumbJsonLd, eventJsonLd } from '@/lib/seo';
import { resolveSiteImage } from '@/lib/images';
import { EVENT_STATUS_LABELS, shownCategoryLabel } from '@/content/schemas';
import Provenance from '@/components/Provenance.astro';
import EventCard from '@/components/EventCard.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';

export async function getStaticPaths() {
  const events = await getTownEntries('events');
  /**
   * A recurring series is stored as one file per occurrence, so a council
   * meeting can be twelve pages that differ only in the date. Index the one a
   * reader could still attend and mark the rest noindex, so the series is
   * searchable once rather than competing with itself.
   *
   * The same rule decides the sitemap, from src/lib/series.ts, so the page's
   * noindex and its absence from the sitemap cannot drift apart.
   */
  const canonical = pickCanonical(
    events.map((e) => ({ slug: e.slug, key: `${e.data.title}|${e.data.venue}`, startDay: dayKey(e.data.start), lastDay: finalDay(e), canceled: isCanceled(e) })),
    dayKey(new Date()),
  );
  // A matinee and an evening show are two listings with one title on one
  // day, and so two pages with one <title> (pre-launch audit, 8 October
  // 2026: four pairs in Fort Collins, one in Loveland). Such a pair gets its
  // start time in the title; every other listing keeps the date alone.
  const perDay = new Map<string, number>();
  for (const e of events) {
    const key = `${e.data.title}|${dayKey(e.data.start)}`;
    perDay.set(key, (perDay.get(key) ?? 0) + 1);
  }
  return events.map((event) => ({
    params: { slug: event.slug },
    props: {
      event,
      canonicalOccurrence: canonical.get(`${event.data.title}|${event.data.venue}`) === event.slug,
      sameDayTwin: (perDay.get(`${event.data.title}|${dayKey(event.data.start)}`) ?? 0) > 1,
    },
  }));
}

interface Props {
  event: TownEntry<'events'>;
  canonicalOccurrence: boolean;
  /** Another listing with this title falls on the same day, so the title carries the time. */
  sameDayTwin: boolean;
}

const town = getTown();
const { event, canonicalOccurrence, sameDayTwin } = Astro.props;
const { data } = event;
const { Content } = await render(event);
const next = nextOccurrence(event);
const when = next.data;
// Called off or postponed: said in the eyebrow, the title tag and a notice
// above the body, so the page cannot be skimmed as an invitation.
const statusLabel = data.status !== 'scheduled' ? EVENT_STATUS_LABELS[data.status] : undefined;
/**
 * A production's shows still to come, each with its own way into a calendar:
 * a reader goes to one show, not to the run, and two shows on one Saturday
 * are two choices (fresh audit, 9 October 2026). The structured data keeps
 * every show once the run is over, so the page still says what it was; the
 * calendar list goes, row by row in a stale build as each show passes.
 */
const allShows = data.performances ? occurrences([event], { horizonDays: 400 }) : [];
const showsLeft = upcoming(allShows);
const shows = showsLeft.length > 0 ? showsLeft : allShows;
const repeatNote = data.performances
  ? `${data.performances.length} performances, ${formatDayRange(data.start, data.performances.at(-1)!.start)}`
  : data.recurring ??
    (data.repeat === 'weekly' && data.until ? `Every ${formatWeekday(data.start)} through ${formatDate(data.until)}` : undefined);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const shareImage = data.image ? (await getImage({ src: data.image, width: 1200, height: 630, format: 'jpg' })).src : undefined;
/**
 * The structured data's picture: the listing's own, or else the town's, the
 * same file the share card falls back to. Four listings in nine hundred have
 * a picture, and an Event with no image is left out of the picture-led event
 * results (Search Console, 10 October 2026).
 */
const structuredImage =
  shareImage ?? (await getImage({ src: resolveSiteImage(town.slug, town.hero.image), width: 1200, height: 630, format: 'jpg' })).src;
/**
 * An organizer with its own listing in this guide (a library, a museum, a
 * theatre) has its site there; the structured data uses it when the event
 * does not give one. Matched on the name exactly, so nothing is guessed.
 */
const listedOrganizerUrl = data.organizer
  ? (await getTownEntries('places')).find((p) => p.data.title.toLowerCase() === data.organizer!.toLowerCase())?.data.url
  : undefined;
// The next sitting's own: a production's show carries its time and its note.
const timeText = next.data.timeNote ?? formatTimeRange(when.start, when.end, data.allDay);
// A run of days leads with its range, or "Now through…" while it is on, not
// with the day it opened: Les Misérables said "Thursday, September 10" into
// October.
const dayText = isMultiDay(next)
  ? isInProgress(next) ? `Now through ${formatMonthDay(when.end!)}` : formatDayRange(when.start, when.end!)
  : formatDayLong(when.start);
/**
 * Date, time and venue alone say nothing about the event and collide with
 * every other listing at the same place. Lead with the particulars, which are
 * what a searcher needs, then the body's first sentence. SEO.astro clamps the
 * result, so the sentence is what gets shortened, not the specifics.
 */
const firstSentence = (event.body ?? '').trim().split(/(?<=[.!?])\s+/)[0]?.trim() ?? '';
const particulars = `${statusLabel ? `${statusLabel}. ` : ''}${dayText}, ${timeText} at ${data.venue}, ${town.name}.`;
const description = firstSentence.length > 30 ? `${particulars} ${firstSentence}` : particulars;
/**
 * Two ways into a reader's own calendar, neither needing a script: the
 * single-event .ics that Apple and Outlook open, and Google's template link.
 * Both carry the next occurrence, which is the one a reader can still attend,
 * timed the way the structured data times it (`exportWhen`).
 */
const googleFor = (occurrence: typeof next) =>
  googleCalendarUrl({
    title: data.title,
    ...exportWhen(occurrence),
    location: [data.venue, data.address, `${town.name}, CO`].filter(Boolean).join(', '),
    description: firstSentence,
    url,
  });
const googleUrl = googleFor(next);
// Called off or postponed: the date is struck through, the calendar links go
// (nobody should add a meeting that is not happening), and the organizer's
// page is offered as a check rather than as the next step.
const offList = isCanceled(event);
/**
 * Three more things on soon, the same venue's first. A listing with a short
 * description and no picture left a wide empty column beside the facts, and
 * every event page ended at the back link.
 */
const soon = uniqueByEvent(upcoming(occurrences(await getTownEntries('events'), { horizonDays: 30 }))).filter(
  (e) => e.slug !== event.slug && e.data.title !== data.title && !isCanceled(e),
);
const alsoOn = [...soon.filter((e) => e.data.venue === data.venue), ...soon.filter((e) => e.data.venue !== data.venue)].slice(0, 3);
const facts = [
  { label: repeatNote ? 'Next' : 'When', value: [dayText, timeText, repeatNote].filter(Boolean) },
  { label: 'Where', value: [data.venue, data.address].filter(Boolean) },
  // Only when the listing records it. "See organizer" below is a pointer to
  // whoever runs the thing, which is not always who owns the room.
  ...(data.organizer ? [{ label: 'Who', value: [data.organizer] }] : []),
  { label: 'Cost', value: [data.cost ?? 'See organizer'] },
];
---
<Page
  kind="Event"
  title={data.title}
  seoTitle={`${statusLabel ? `${statusLabel}: ` : ''}${data.title} — ${formatDate(when.start)}${sameDayTwin && !when.allDay ? `, ${formatTime(when.start)}` : ''}`}
  eyebrow={shownCategoryLabel(data.category)}
  status={statusLabel}
  description={description}
  image={shareImage}
  imageAlt={data.imageAlt}
  {/* Not indexed if it is a repeat of a series, and not if it is simply over:
     a finished one-day listing is a thin page about something nobody can
     attend. It stays reachable, because a URL that was live should not start
     404ing, but it is kept out of search and out of the sitemap. "Over" is
     every date it has, by the Denver day: the sitemap asks the same. */}
  noindex={!canonicalOccurrence || isOver(event)}
  jsonLd={[
    // A production is an Event per show, as Google asks of separately
    // ticketed performances; anything else is its next occurrence.
    ...(shows.length > 0 ? shows : [next]).map((e) =>
      eventJsonLd(town, e, url, new URL(structuredImage, Astro.site).toString(), listedOrganizerUrl),
    ),
    breadcrumbJsonLd(town, [
      { name: town.name, path: '/' },
      { name: 'Events', path: '/events/' },
      { name: data.title, path: `/events/${event.slug}/` },
    ]),
  ]}
>
  {/*
    Two columns on a wide screen, one on a phone, and on a phone the order
    changes: the notice, then When and Where, then the picture and the
    description. The facts used to come after the whole description and the
    back link, a screen or two down. Each column's wrapper is `contents`
    below lg, so its children take part in the outer column's `order`.
  */}
  <div class="flex flex-col gap-10 lg:grid lg:grid-cols-[1fr_20rem] lg:items-start lg:gap-16">
    <div class="contents lg:block">
      {statusLabel && (
        <div class="order-1 max-w-[40rem] rounded-r-lg border-l-4 border-highlight bg-highlight-soft p-5 lg:mb-10" role="note">
          <p class="eyebrow text-ink">{statusLabel}</p>
          <p class="mt-2 leading-relaxed">
            {data.statusNote}
            {data.statusSource && (
              <Fragment>
                {' '}<a href={data.statusSource} rel="noopener" class="text-primary underline">Source →</a>
              </Fragment>
            )}
          </p>
        </div>
      )}
      <div class="order-3">
        {data.image && (
          <figure class="mb-10">
            <Image src={data.image} alt={data.imageAlt ?? ''} width={1200} height={800} class="rounded-lg" />
            {data.imageCredit && (
              <figcaption class="mt-2 text-[0.8125rem] text-ink-muted">Photo: {data.imageCredit}</figcaption>
            )}
          </figure>
        )}
        <div class="prose">
          <Content />
        </div>
        {alsoOn.length > 0 && (
          <section class="mt-14" aria-labelledby="also-on" data-hide-when-empty>
            <h2 id="also-on" class="eyebrow border-b-2 border-accent pb-3">Also coming up in {town.name}</h2>
            <div class="border-b border-line-soft">
              {alsoOn.map((e) => <EventCard event={e} />)}
            </div>
          </section>
        )}
        {/* Search lands people here, not on the home page; the one ask the
            guide makes goes where the readers are. */}
        <div class="mt-14">
          <NewsletterSignup town={town} compact id="event-signup" />
        </div>
      </div>
      <p class="order-5 text-[0.9375rem] lg:mt-12"><a href="/events/" class="inline-block -my-1 py-1 font-semibold text-primary underline">← All events</a></p>
    </div>
    <div class="contents lg:block lg:pt-1">
      <aside class="order-2">
        <dl class="divide-y divide-line-soft border-y border-line-soft">
          {facts.map((f) => (
            <div class="py-4">
              <dt class="eyebrow">{f.label}</dt>
              <dd class="mt-1.5 leading-snug">
                {f.value.map((line, i) => (
                  <span class:list={['block', i > 0 && 'text-[0.9375rem] text-ink-muted', offList && i === 0 && (f.label === 'When' || f.label === 'Next') && 'text-ink-muted line-through decoration-ink-muted']}>
                    {i === 0 && (f.label === 'When' || f.label === 'Next') ? <time datetime={toIsoLocal(when.start)}>{line}</time> : line}
                  </span>
                ))}
              </dd>
            </div>
          ))}
        </dl>
        {data.url && (
          <a href={data.url} rel="noopener" class:list={['btn mt-6', offList ? 'btn-outline text-primary' : 'btn-primary']}>Organizer’s page →</a>
        )}
        {/* Two buttons, not two 20px text links a middot apart. */}
        {!offList && showsLeft.length > 0 && (
          <div class="mt-6" data-hide-when-empty>
            <p class="eyebrow" id="shows">Performances · add one to your calendar</p>
            <ul class="mt-2 divide-y divide-line-soft border-y border-line-soft" aria-labelledby="shows">
              {showsLeft.map((show) => {
                const label = `${formatDayShort(show.data.start)}, ${show.data.timeNote ?? formatTime(show.data.start)}`;
                return (
                  <li class="py-3" data-event-day={lastDay(show)} data-end={toIsoLocal(listedUntil(show))}>
                    <time datetime={toIsoLocal(show.data.start)} class="block leading-snug">{label}</time>
                    <div class="mt-2 flex flex-wrap gap-2">
                      <a href={`/events/${event.slug}/${showKey(show.data.start)}.ics`} class="btn btn-outline min-h-11 text-primary" aria-label={`${label}: add to Apple or Outlook`}>Apple, Outlook</a>
                      <a href={googleFor(show)} rel="noopener" class="btn btn-outline min-h-11 text-primary" aria-label={`${label}: add to Google Calendar`}>Google</a>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        )}
        {!offList && !data.performances && (
          <div class="mt-6">
            <p class="eyebrow">Add to calendar</p>
            <div class="mt-2 flex flex-wrap gap-2">
              <a href={`/events/${event.slug}.ics`} class="btn btn-outline min-h-11 text-primary">Apple, Outlook</a>
              <a href={googleUrl} rel="noopener" class="btn btn-outline min-h-11 text-primary">Google</a>
            </div>
          </div>
        )}
      </aside>
      <div class="order-4 -mt-4 lg:mt-0">
        <Provenance
          verified={data.verified}
          source={data.source}
          item={`event/${event.slug}`}
          title={data.title}
          note="Times can change; the organizer’s page is the record."
        />
      </div>
    </div>
  </div>
</Page>
