---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import { getTown } from '@/config';
import { getTownEntries, type TownEntry } from '@/lib/content';
import { formatDayLong, formatTimeRange, toIsoLocal } from '@/lib/dates';
import { eventJsonLd } from '@/lib/seo';
import { CATEGORY_LABELS } from '@/content/schemas';

export async function getStaticPaths() {
  const events = await getTownEntries('events');
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

interface Props {
  event: TownEntry<'events'>;
}

const town = getTown();
const { event } = Astro.props;
const { data } = event;
const { Content } = await render(event);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const shareImage = data.image ? (await getImage({ src: data.image, width: 1200, height: 630, format: 'jpg' })).src : undefined;
const description = `${formatDayLong(data.start)}, ${formatTimeRange(data.start, data.end, data.allDay)} at ${data.venue}, ${town.name}.`;
const facts = [
  { label: 'When', value: [formatDayLong(data.start), formatTimeRange(data.start, data.end, data.allDay), data.recurring].filter(Boolean) },
  { label: 'Where', value: [data.venue, data.address].filter(Boolean) },
  { label: 'Cost', value: [data.cost ?? 'See organizer'] },
];
---
<Page
  title={data.title}
  eyebrow={CATEGORY_LABELS[data.category]}
  description={description}
  image={shareImage}
  imageAlt={data.imageAlt}
  jsonLd={eventJsonLd(town, event, url, shareImage ? new URL(shareImage, Astro.site).toString() : undefined)}
>
  <div class="grid gap-12 lg:grid-cols-[1fr_20rem] lg:gap-16">
    <div>
      {data.image && <Image src={data.image} alt={data.imageAlt ?? ''} width={1200} height={800} class="mb-10 rounded-lg" />}
      <div class="prose">
        <Content />
      </div>
      <p class="mt-12 text-[0.9375rem]"><a href="/events/" class="font-semibold text-accent-dark no-underline hover:underline">← All events</a></p>
    </div>
    <aside class="lg:pt-1">
      <dl class="divide-y divide-line-soft border-y border-line-soft">
        {facts.map((f) => (
          <div class="py-4">
            <dt class="eyebrow">{f.label}</dt>
            <dd class="mt-1.5 leading-snug">
              {f.value.map((line, i) => (
                <span class:list={['block', i > 0 && 'text-[0.9375rem] text-ink-muted']}>
                  {i === 0 && f.label === 'When' ? <time datetime={toIsoLocal(data.start)}>{line}</time> : line}
                </span>
              ))}
            </dd>
          </div>
        ))}
      </dl>
      {data.url && <a href={data.url} rel="noopener" class="btn btn-primary mt-6">Organizer’s page →</a>}
    </aside>
  </div>
</Page>
