---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import { getTown } from '@/config';
import { getTownEntries, type TownEntry } from '@/lib/content';
import { dayKey, formatDate, formatDayLong, formatDayRange, formatMonthDay, formatTimeRange, formatWeekday, toIsoLocal } from '@/lib/dates';
import { isCanceled, isInProgress, isMultiDay, isPast, nextOccurrence, occurrences, uniqueByEvent, upcoming } from '@/lib/events';
import { googleCalendarUrl } from '@/lib/ics';
import { pickCanonical } from '@/lib/series';
import { breadcrumbJsonLd, eventJsonLd } from '@/lib/seo';
import { EVENT_STATUS_LABELS, shownCategoryLabel } from '@/content/schemas';
import Provenance from '@/components/Provenance.astro';
import EventCard from '@/components/EventCard.astro';

export async function getStaticPaths() {
  const events = await getTownEntries('events');
  /**
   * A recurring series is stored as one file per occurrence, so a council
   * meeting can be twelve pages that differ only in the date. Index the one a
   * reader could still attend and mark the rest noindex, so the series is
   * searchable once rather than competing with itself.
   *
   * The same rule decides the sitemap, from src/lib/series.ts, so the page's
   * noindex and its absence from the sitemap cannot drift apart.
   */
  const canonical = pickCanonical(
    events.map((e) => ({ slug: e.slug, key: `${e.data.title}|${e.data.venue}`, startDay: dayKey(e.data.start), canceled: isCanceled(e) })),
    dayKey(new Date()),
  );
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event, canonicalOccurrence: canonical.get(`${event.data.title}|${event.data.venue}`) === event.slug },
  }));
}

interface Props {
  event: TownEntry<'events'>;
  canonicalOccurrence: boolean;
}

const town = getTown();
const { event, canonicalOccurrence } = Astro.props;
const { data } = event;
const { Content } = await render(event);
const next = nextOccurrence(event);
const when = next.data;
// Called off or postponed: said in the eyebrow, the title tag and a notice
// above the body, so the page cannot be skimmed as an invitation.
const statusLabel = data.status !== 'scheduled' ? EVENT_STATUS_LABELS[data.status] : undefined;
const repeatNote =
  data.recurring ??
  (data.repeat === 'weekly' && data.until ? `Every ${formatWeekday(data.start)} through ${formatDate(data.until)}` : undefined);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const shareImage = data.image ? (await getImage({ src: data.image, width: 1200, height: 630, format: 'jpg' })).src : undefined;
const timeText = data.timeNote ?? formatTimeRange(when.start, when.end, data.allDay);
// A run of days leads with its range, or "Now through…" while it is on, not
// with the day it opened: Les Misérables said "Thursday, September 10" into
// October.
const dayText = isMultiDay(next)
  ? isInProgress(next) ? `Now through ${formatMonthDay(when.end!)}` : formatDayRange(when.start, when.end!)
  : formatDayLong(when.start);
/**
 * Date, time and venue alone say nothing about the event and collide with
 * every other listing at the same place. Lead with the particulars, which are
 * what a searcher needs, then the body's first sentence. SEO.astro clamps the
 * result, so the sentence is what gets shortened, not the specifics.
 */
const firstSentence = (event.body ?? '').trim().split(/(?<=[.!?])\s+/)[0]?.trim() ?? '';
const particulars = `${statusLabel ? `${statusLabel}. ` : ''}${dayText}, ${timeText} at ${data.venue}, ${town.name}.`;
const description = firstSentence.length > 30 ? `${particulars} ${firstSentence}` : particulars;
/**
 * Two ways into a reader's own calendar, neither needing a script: the
 * single-event .ics that Apple and Outlook open, and Google's template link.
 * Both carry the next occurrence, which is the one a reader can still attend.
 */
const googleUrl = googleCalendarUrl({
  title: data.title,
  start: when.start,
  end: when.end,
  allDay: data.allDay,
  location: [data.venue, data.address, `${town.name}, CO`].filter(Boolean).join(', '),
  description: firstSentence,
  url,
});
// Called off or postponed: the date is struck through, the calendar links go
// (nobody should add a meeting that is not happening), and the organizer's
// page is offered as a check rather than as the next step.
const offList = isCanceled(event);
/**
 * Three more things on soon, the same venue's first. A listing with a short
 * description and no picture left a wide empty column beside the facts, and
 * every event page ended at the back link.
 */
const soon = uniqueByEvent(upcoming(occurrences(await getTownEntries('events'), { horizonDays: 30 }))).filter(
  (e) => e.slug !== event.slug && e.data.title !== data.title && !isCanceled(e),
);
const alsoOn = [...soon.filter((e) => e.data.venue === data.venue), ...soon.filter((e) => e.data.venue !== data.venue)].slice(0, 3);
const facts = [
  { label: repeatNote ? 'Next' : 'When', value: [dayText, timeText, repeatNote].filter(Boolean) },
  { label: 'Where', value: [data.venue, data.address].filter(Boolean) },
  // Only when the listing records it. "See organizer" below is a pointer to
  // whoever runs the thing, which is not always who owns the room.
  ...(data.organizer ? [{ label: 'Who', value: [data.organizer] }] : []),
  { label: 'Cost', value: [data.cost ?? 'See organizer'] },
];
---
<Page
  kind="Event"
  title={data.title}
  seoTitle={`${statusLabel ? `${statusLabel}: ` : ''}${data.title} — ${formatDate(when.start)}`}
  eyebrow={[statusLabel, shownCategoryLabel(data.category)].filter(Boolean).join(' · ') || undefined}
  description={description}
  image={shareImage}
  imageAlt={data.imageAlt}
  {/* Not indexed if it is a repeat of a series, and not if it is simply over:
     a finished one-day listing is a thin page about something nobody can
     attend. It stays reachable, because a URL that was live should not start
     404ing, but it is kept out of search and out of the sitemap. */}
  noindex={!canonicalOccurrence || isPast(event)}
  jsonLd={[
    eventJsonLd(town, next, url, shareImage ? new URL(shareImage, Astro.site).toString() : undefined),
    breadcrumbJsonLd(town, [
      { name: town.name, path: '/' },
      { name: 'Events', path: '/events/' },
      { name: data.title, path: `/events/${event.slug}/` },
    ]),
  ]}
>
  {/*
    Two columns on a wide screen, one on a phone, and on a phone the order
    changes: the notice, then When and Where, then the picture and the
    description. The facts used to come after the whole description and the
    back link, a screen or two down. Each column's wrapper is `contents`
    below lg, so its children take part in the outer column's `order`.
  */}
  <div class="flex flex-col gap-10 lg:grid lg:grid-cols-[1fr_20rem] lg:items-start lg:gap-16">
    <div class="contents lg:block">
      {statusLabel && (
        <div class="order-1 max-w-[40rem] rounded-r-lg border-l-4 border-highlight bg-highlight-soft p-5 lg:mb-10" role="note">
          <p class="eyebrow text-ink">{statusLabel}</p>
          <p class="mt-2 leading-relaxed">
            {data.statusNote}
            {data.statusSource && (
              <Fragment>
                {' '}<a href={data.statusSource} rel="noopener" class="text-accent-text">Source →</a>
              </Fragment>
            )}
          </p>
        </div>
      )}
      <div class="order-3">
        {data.image && <Image src={data.image} alt={data.imageAlt ?? ''} width={1200} height={800} class="mb-10 rounded-lg" />}
        <div class="prose">
          <Content />
        </div>
        {alsoOn.length > 0 && (
          <section class="mt-14" aria-labelledby="also-on" data-hide-when-empty>
            <h2 id="also-on" class="eyebrow border-b-2 border-accent pb-3">Also coming up in {town.name}</h2>
            <div class="border-b border-line-soft">
              {alsoOn.map((e) => <EventCard event={e} />)}
            </div>
          </section>
        )}
      </div>
      <p class="order-5 text-[0.9375rem] lg:mt-12"><a href="/events/" class="font-semibold text-accent-text no-underline hover:underline">← All events</a></p>
    </div>
    <div class="contents lg:block lg:pt-1">
      <aside class="order-2">
        <dl class="divide-y divide-line-soft border-y border-line-soft">
          {facts.map((f) => (
            <div class="py-4">
              <dt class="eyebrow">{f.label}</dt>
              <dd class="mt-1.5 leading-snug">
                {f.value.map((line, i) => (
                  <span class:list={['block', i > 0 && 'text-[0.9375rem] text-ink-muted', offList && i === 0 && (f.label === 'When' || f.label === 'Next') && 'text-ink-muted line-through decoration-ink-faint']}>
                    {i === 0 && (f.label === 'When' || f.label === 'Next') ? <time datetime={toIsoLocal(when.start)}>{line}</time> : line}
                  </span>
                ))}
              </dd>
            </div>
          ))}
        </dl>
        {data.url && (
          <a href={data.url} rel="noopener" class:list={['btn mt-6', offList ? 'btn-outline text-accent-text' : 'btn-primary']}>Organizer’s page →</a>
        )}
        {/* Two buttons, not two 20px text links a middot apart. */}
        {!offList && (
          <div class="mt-6">
            <p class="eyebrow">Add to calendar</p>
            <div class="mt-2 flex flex-wrap gap-2">
              <a href={`/events/${event.slug}.ics`} class="btn btn-outline min-h-11 text-accent-text">Apple, Outlook</a>
              <a href={googleUrl} rel="noopener" class="btn btn-outline min-h-11 text-accent-text">Google</a>
            </div>
          </div>
        )}
      </aside>
      <div class="order-4 -mt-4 lg:mt-0">
        <Provenance
          verified={data.verified}
          source={data.source}
          item={`event/${event.slug}`}
          title={data.title}
          note="Times can change; the organizer’s page is the record."
        />
      </div>
    </div>
  </div>
</Page>
