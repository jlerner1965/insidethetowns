---
import Page from '@/layouts/Page.astro';
import SponsorLine from '@/components/SponsorLine.astro';
import EventList from '@/components/EventList.astro';
import EventFilters from '@/components/EventFilters.astro';
import DayStrip from '@/components/DayStrip.astro';
import NearbyWeekend from '@/components/NearbyWeekend.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import WeeklyRegulars from '@/components/WeeklyRegulars.astro';
import SubTownLinks from '@/components/SubTownLinks.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { getTown } from '@/config';
import { getTownEntries } from '@/lib/content';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';
import { categoriesIn, groupByDay, occurrences, splitOngoing, uniqueByEvent, upcoming, weeklyRegulars, weeklyTest } from '@/lib/events';
import { CATEGORY_LABELS, EVENT_CATEGORIES, type EventCategory } from '@/content/schemas';
import { subTownsOf } from '@/lib/sub-towns';

const town = getTown();
const entries = await getTownEntries('events');
/**
 * Two lists. The date list is the one-time events and the town meetings,
 * each on its date; the weekly regulars — the storytime, the trivia night,
 * the market — are a fact about the week rather than a date, and appear once
 * each in "Every week in [Town]" below. On Erie the old single list ran to
 * two hundred rows, most of them weekly, and Brewfest was somewhere in the
 * middle. `weeklyTest` decides, over the whole collection.
 */
const isWeekly = weeklyTest(entries);
const dated = entries.filter((e) => !isWeekly(e));
const all = occurrences(dated, { horizonDays: 400 });
const nextTwoWeeks = upcoming(all, { days: 14 });
const later = uniqueByEvent(upcoming(all).filter((e) => !nextTwoWeeks.includes(e)));
const shown = [...nextTwoWeeks, ...later];
const weekly = weeklyRegulars(entries);
const options = categoriesIn(shown, EVENT_CATEGORIES).map((c) => ({ value: c, label: CATEGORY_LABELS[c as EventCategory] }));
const fortnightDays = groupByDay(splitOngoing(nextTwoWeeks).dated);
// Carbon Valley: a "Where" row on the filters, one pill per town.
const subTowns = subTownsOf(town);


const structured = [
  collectionPageJsonLd(town, {
    name: `${town.name}, Colorado events`,
    description: `What’s on in ${town.name} this week and next: markets, music, festivals, trails and more.`,
    path: '/events/',
    items: uniqueByEvent([...shown, ...weekly]).map((e) => ({ name: e.data.title, path: `/events/${e.slug}/` })),
  }),
  breadcrumbJsonLd(town, [
    { name: town.name, path: '/' },
    { name: 'Events', path: '/events/' },
  ]),
];
---
<Page
  title="Events"
  seoTitle={`${town.name}, Colorado events`}
  jsonLd={structured}
  eyebrow={`What’s on in ${town.name}`}
  description={`What’s on in ${town.name} this week and next: markets, music, festivals, trails and more.`}
  intro={
    weekly.length > 0
      ? 'The next two weeks first, then everything further out; town meetings are under Civic. The weekly regulars are listed once each, below. Past events drop off on their own.'
      : 'The next two weeks first, then everything further out; town meetings are under Civic. Past events drop off on their own.'
  }
>
  <p slot="after-header" class="mt-5 text-[0.9375rem] text-ink-muted">
    Just the weekend? <a href="/this-weekend/" class="font-semibold text-accent-text">This weekend in {town.name}</a>.
    Know of something missing? <a href="/submit-event/" class="font-semibold text-accent-text">Submit an event</a>.
    Or <a href="/events/calendar.ics" class="font-semibold text-accent-text">subscribe to the calendar</a> in your calendar app.
  </p>
  <SubTownLinks slot="after-header" class="mt-3" hrefFor={(slug) => `/${slug}/`} />
  <SponsorLine slot="after-header" sponsor={town.sponsors?.events} />

  <div data-filter-root>
    <EventFilters categories={options} subTowns={subTowns} />
    <DayStrip
      days={fortnightDays}
      more={[
        ...(later.length > 0 ? [{ href: '#further-out', label: 'Further out' }] : []),
        ...(weekly.length > 0 ? [{ href: '#every-week', label: 'Every week' }] : []),
      ]}
    />
    <div data-filter-section>
      <h2 class="sr-only">Next 14 days</h2>
      <EventList events={nextTwoWeeks} emptyMessage="Nothing listed for the next two weeks yet." />
    </div>
    {/*
      The signup used to sit above the listings, which on a phone put the first
      event some 1,200 pixels down — a whole screen and more — on the one page
      a reader opens to see what is on. It follows the fortnight now, for the
      reason the home page gives for its copy: the offer lands once the reader
      has had the listings and can tell whether a weekly note of them is worth
      an address.
    */}
    <div class="mt-12 md:mt-16">
      <NewsletterSignup town={town} />
    </div>
    {/* This weekend's picks from next door, after the fortnight rather than at
       the foot of the page after December. The filters above are this town's
       and leave it alone (data-filter-ignore). */}
    <div data-filter-ignore>
      <NearbyWeekend town={town} class="mt-16 md:mt-20" />
    </div>
    {later.length > 0 && (
      <div id="further-out" class="mt-16 scroll-mt-4 md:mt-24" data-filter-section>
        <SectionHeader eyebrow="After the next two weeks" title="Further out" />
        {/* Months of single days: smaller day names, so the list reads as a
            look ahead rather than a second fortnight at full size. */}
        <EventList events={later} compact />
      </div>
    )}
    <p data-filter-empty hidden class="rounded-lg border border-dashed border-line px-6 py-10 text-center text-ink-muted">Nothing listed that matches. Try <button type="button" class="font-semibold text-accent-text underline" data-filter-reset>everything, any time</button>.</p>
  </div>

  <WeeklyRegulars events={weekly} townName={town.name} />
</Page>
