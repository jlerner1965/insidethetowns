---
import Page from '@/layouts/Page.astro';
import SponsorLine from '@/components/SponsorLine.astro';
import EventCard from '@/components/EventCard.astro';
import EventList from '@/components/EventList.astro';
import EventFilters from '@/components/EventFilters.astro';
import DayStrip from '@/components/DayStrip.astro';
import NearbyWeekend from '@/components/NearbyWeekend.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import WeeklyRegulars from '@/components/WeeklyRegulars.astro';
import SubTownLinks from '@/components/SubTownLinks.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { getTown } from '@/config';
import { getTownEntries } from '@/lib/content';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';
import { agenda, categoriesIn, groupByDay, occurrences, splitOngoing, uniqueByEvent } from '@/lib/events';
import { currentPicks } from '@/lib/weekly';
import { bigDates } from '@/lib/big-dates';
import { formatDate, formatDayLong, toIsoLocal } from '@/lib/dates';
import { CATEGORY_LABELS, EVENT_CATEGORIES, type EventCategory } from '@/content/schemas';
import { subTownsOf } from '@/lib/sub-towns';
import { guidesWithTraditions } from '@/lib/tradition-files';

const town = getTown();
const entries = await getTownEntries('events');
// When this page was built. It is rebuilt nightly and on every push, and the
// browser drops what has finished in between (Freshness.astro); the date
// tells a reader, and a search engine, how current the list is.
const refreshedAt = new Date();
/**
 * Two lists from one expansion (src/lib/events.ts, `agenda`). The date list
 * is every occurrence of the next fourteen days, in date and clock order;
 * unfiltered it shows the one-time events and the town meetings on their
 * dates and each run once, at its next open day, and holds back the weekly
 * regulars' dates, which are a fact about the week and appear once each in
 * "Every week in [Town]" below (on Erie the old single list ran to two
 * hundred rows, most of them weekly, and Brewfest was somewhere in the
 * middle). A date filter brings every held-back row in that window out, so
 * "Today" on a Monday has the Monday chess club the home page shows
 * (calendar audit, 26 October 2026). `weeklyTest` decides what is weekly.
 */
const { fortnight, later, weekly } = agenda(entries);
const nextTwoWeeks = fortnight.map((r) => r.event);
const held = new Map(fortnight.map((r) => [r.event, { regular: r.regular, repeat: r.repeat }]));
const shownUnfiltered = fortnight.filter((r) => !r.regular && !r.repeat).map((r) => r.event);
const shown = [...nextTwoWeeks, ...later, ...weekly];
const options = categoriesIn(shown, EVENT_CATEGORIES).map((c) => ({ value: c, label: CATEGORY_LABELS[c as EventCategory] }));
const fortnightDays = groupByDay(splitOngoing(nextTwoWeeks).dated);
// A day of held-back rows only is not on the unfiltered strip either.
const hiddenDays = new Set(fortnightDays.filter((d) => d.events.every((e) => !shownUnfiltered.includes(e))).map((d) => d.key));
const all = occurrences(entries, { horizonDays: 400 });
// Carbon Valley: a "Where" row on the filters, one pill per town.
const subTowns = subTownsOf(town);
// "Every year in <Town>" (/traditions/), linked from here and nowhere else,
// on a guide that a tradition record names (src/lib/traditions.ts).
const hasTraditions = guidesWithTraditions().has(town.slug);
// The parade, the festival, the Fourth: the dates a reader searches for by
// name months out, linked from here so each has a permanent way in
// (src/lib/big-dates.ts). Beyond the fortnight the list already shows.
const big = bigDates(all, { now: refreshedAt });
/**
 * Our picks this week (the owner's brief, 6 November 2026): the editor's
 * three to five for the next seven days, named in the week's notes
 * (content/<town>/weekly/, `picks`) or flagged `featured` on the listing
 * (src/lib/weekly.ts, currentPicks), above the full list, each tagged
 * again in the list so no listing appears twice. Nothing is picked by a
 * machine: with none flagged the section is not drawn. It replaced the
 * "Highlights" block of 26 October, which ranked the fortnight itself.
 * The filters hide it, since a reader who has asked for free music this
 * weekend wants that list alone.
 */
const picks = currentPicks(await getTownEntries('weekly'), nextTwoWeeks, refreshedAt);
const pickSlugs = new Set(picks.map((e) => e.slug));

const description = `What’s on in ${town.name} this week and next: markets, music, festivals, trails and more, then the big dates further out and the weekly regulars.`;
const structured = [
  collectionPageJsonLd(town, {
    name: `${town.name}, Colorado events`,
    description,
    path: '/events/',
    items: uniqueByEvent(shown).map((e) => ({ name: e.data.title, path: `/events/${e.slug}/` })),
  }),
  breadcrumbJsonLd(town, [
    { name: town.name, path: '/' },
    { name: 'Events', path: '/events/' },
  ]),
];
---
<Page
  title="Events"
  seoTitle={`${town.name}, Colorado events`}
  jsonLd={structured}
  eyebrow={`What’s on in ${town.name}`}
  {description}
  intro={`What’s listed in ${town.name}: the next two weeks, then further out, and the weekly regulars.`}
>
  {/* The weekend's page and the refresh date under the title in small type.
      The two things a reader does here besides read, Submit an event and
      Subscribe to calendar, were buttons here (owner, 26 October 2026) and
      are now after the list: with them, the filters and the jump links, a
      phone's first screen held no event at all (the reader pass, 1 November
      2026). */}
  <p slot="after-header" class="mt-4 text-[0.875rem] text-ink-muted">
    <a href="/this-weekend/" class="font-semibold text-primary underline">Just the weekend?</a>{hasTraditions && <Fragment> · <a href="/traditions/" class="font-semibold text-primary underline">Every year in {town.name}</a></Fragment>} · Refreshed <time datetime={toIsoLocal(refreshedAt)}>{formatDate(refreshedAt)}</time>
  </p>
  <SubTownLinks slot="after-header" class="mt-3" hrefFor={(slug) => `/${slug}/`} />
  <SponsorLine slot="after-header" sponsor={town.sponsors?.events} />

  <div data-filter-root>
    {/* The order of the top (the owner's brief, 6 November 2026): the time
        filters out, the rest of the filters and the day strip behind one
        control, then the picks, the Thursday email, and the calendar. */}
    <EventFilters categories={options} subTowns={subTowns} regulars={weekly.length > 0}>
      <DayStrip
        days={fortnightDays}
        hiddenDays={hiddenDays}
        more={[
          ...(later.length > 0 ? [{ href: '#further-out', label: 'Further out' }] : []),
          ...(weekly.length > 0 ? [{ href: '#every-week', label: 'Every week' }] : []),
        ]}
      />
    </EventFilters>
    {picks.length > 0 && (
      <section class="mb-10 md:mb-12" data-filter-ignore data-filter-highlights aria-labelledby="picks-heading">
        <div class="mb-6 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-line-soft pb-3">
          <h2 id="picks-heading" class="text-2xl font-medium">Our picks this week</h2>
          <p class="text-[0.875rem] text-ink-muted">The editor's choice for the next seven days; everything is below.</p>
        </div>
        <div class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
          {picks.map((event) => <EventCard event={event} pick />)}
        </div>
      </section>
    )}
    {/* The Thursday email once here, after the picks and before the long
        list, in the home page's short form (the heading, one line, the
        field, the button, "Free. Unsubscribe anytime."; the town pre-ticked,
        no town picker: the owner, 6 November 2026); the foot keeps the full
        form with the picker. Not on a phone, where it stood between the
        picks and the calendar (audit of 9 November 2026; the owner, 10
        November): the form at the foot is the phone's. Left out of the filtering. */}
    <div class="mb-12 hidden md:mb-16 md:block" data-filter-ignore>
      <NewsletterSignup town={town} id="events-mid" variant="home" />
    </div>
    {/* An empty fortnight is not a module: with later dates or regulars to
        show, it is left out rather than announcing its absence. */}
    {(nextTwoWeeks.length > 0 || (later.length === 0 && weekly.length === 0)) && (
      <div data-filter-section hidden={nextTwoWeeks.length > 0 && shownUnfiltered.length === 0}>
        <h2 id="all-listings" class="mb-6 scroll-mt-4 border-b border-line-soft pb-3 text-2xl font-medium">Next 14 days, by day</h2>
        <EventList events={nextTwoWeeks} held={held} picks={pickSlugs} emptyMessage="Nothing listed for the next two weeks yet." />
      </div>
    )}
    {big.length > 0 && (
      <section id="big-dates" class="mt-16 scroll-mt-4 md:mt-20" data-filter-ignore aria-labelledby="big-dates-heading">
        <SectionHeader eyebrow="Mark the calendar" title="Big dates ahead" id="big-dates-heading" />
        <ul class="divide-y divide-line-soft border-y border-line-soft">
          {big.map((event) => (
            <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1 py-3">
              <time datetime={toIsoLocal(event.data.start)} class="w-44 shrink-0 text-[0.9375rem] text-ink-muted">{formatDayLong(event.data.start)}</time>
              <a href={`/events/${event.slug}/`} class="inline-block -my-3 py-3 font-semibold text-primary underline">{event.data.title}</a>
              <span class="text-[0.9375rem] text-ink-muted">{event.data.venue}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
    {later.length > 0 && (
      <div id="further-out" class="mt-16 scroll-mt-4 md:mt-24" data-filter-section>
        <SectionHeader eyebrow="After the next two weeks" title="Further out" />
        {/* Months of single days: smaller day names, so the list reads as a
            look ahead rather than a second fortnight at full size. */}
        <EventList events={later} compact />
      </div>
    )}
    <WeeklyRegulars events={weekly} townName={town.name} />
    {/*
      The signup used to sit above the listings, which on a phone put the first
      event some 1,200 pixels down on the one page a reader opens to see what
      is on; then between the fortnight and "Further out", where it and the
      neighbours' picks cut the town's own list in two (owner, 26 October
      2026). It follows every listing of the town's now, the offer landing
      once the reader has had them, and the neighbours come after it: this
      page is the town's first. The filters above are this town's and leave
      the nearby block alone (data-filter-ignore).
    */}
    <div class="mt-16 flex flex-wrap gap-3 md:mt-20">
      <a href="/submit-event/" class="btn btn-outline py-2.5 text-primary">Submit an event</a>
      <a href="/events/calendar.ics" class="btn btn-outline py-2.5 text-primary">Subscribe to calendar</a>
    </div>
    <div class="mt-10">
      <NewsletterSignup town={town} />
    </div>
    <div data-filter-ignore>
      <NearbyWeekend town={town} signup={false} class="mt-16 md:mt-20" />
    </div>
    <p data-filter-empty hidden class="rounded-lg border border-dashed border-line px-6 py-10 text-center text-ink-muted">Nothing listed that matches. Try <button type="button" class="font-semibold text-primary underline" data-filter-reset>everything, any time</button>.</p>
  </div>
</Page>
