---
/**
 * Living Here (/living-here/): which body handles what, as links to the
 * right page of each official site, from the town's config
 * (TownConfig.livingHere). The layout is shared; every word is the town's,
 * and the day the links were read is said once, under the title. Nothing here
 * restates what an official page says, because a copied closure is wrong by
 * the time it is read; it links.
 */
import Page from '@/layouts/Page.astro';
import UpdateRow from '@/components/UpdateRow.astro';
import CheckedLine from '@/components/CheckedLine.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { getTown } from '@/config';
import { getTownEntries } from '@/lib/content';
import { currentUpdates } from '@/lib/updates';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';

const town = getTown();
const living = town.livingHere!;
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const updates = currentUpdates(await getTownEntries('updates')).slice(0, 3);
const description = `Living in ${town.name}, Colorado: who handles utilities, trash, roads, schools, recreation and problems, with the official page for each.`;
const structured = [
  collectionPageJsonLd(town, { name: `Living in ${town.name}, Colorado`, description, path: '/living-here/' }),
  breadcrumbJsonLd(town, [
    { name: town.name, path: '/' },
    { name: 'Living here', path: '/living-here/' },
  ]),
];
---
<Page title={`Living in ${town.name}`} seoTitle={`Living in ${town.name}, CO: utilities, schools, who to call`} eyebrow="Living here" {description} intro={living.intro} jsonLd={structured} kind="Guide">
  <CheckedLine slot="after-header" dates={living.sections.map((s) => s.verified)} />
  <nav slot="after-header" aria-label="On this page" class="mt-6 flex flex-wrap gap-x-5 gap-y-1 text-[0.9375rem]">
    {living.sections.map((s) => <a href={`#${slug(s.title)}`} class="inline-block -my-1 py-1 font-semibold text-primary underline">{s.title}</a>)}
    {updates.length > 0 && <a href="#changes" class="inline-block -my-1 py-1 font-semibold text-primary underline">What changed</a>}
  </nav>
  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-16">
    <div class="min-w-0">
      {living.sections.map((s, i) => (
        <section id={slug(s.title)} class:list={['scroll-mt-4', i > 0 && 'mt-12']} aria-labelledby={`${slug(s.title)}-h`}>
          <SectionHeader id={`${slug(s.title)}-h`} title={s.title} />
          {s.note && <p class="-mt-4 mb-2 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-muted">{s.note}</p>}
          <ul class="divide-y divide-line-soft">
            {s.items.map((item) => (
              <li class="py-3 text-[0.9375rem] leading-snug">
                <a href={item.url} rel={/^https?:/.test(item.url) ? 'noopener' : undefined} data-track={item.track ?? 'service'} class="inline-block -my-1 py-1 font-semibold text-primary underline">{item.label} →</a>
                {item.note && <span class="block text-ink-muted">{item.note}</span>}
              </li>
            ))}
          </ul>
        </section>
      ))}
      {updates.length > 0 && (
        <section id="changes" class="mt-12 scroll-mt-4" aria-labelledby="changes-h">
          <SectionHeader id="changes-h" title="What changed lately" href="/updates/" linkLabel="All local changes" />
          <div class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
            {updates.map((u) => <UpdateRow update={u} compact />)}
          </div>
        </section>
      )}
    </div>
    <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-lg bg-raised p-6 ring-1 ring-line-soft">
        <p class="eyebrow border-b border-line-soft pb-3">Official sources</p>
        <ul class="mt-3 space-y-2 text-[0.9375rem]">
          <li><a href={town.officialLinks.townSite} rel="noopener" class="font-semibold text-primary underline">{town.officialLinks.townSiteLabel ?? `The official ${town.name} site`} →</a></li>
          {town.officialLinks.policeNonEmergency && <li><a href={town.officialLinks.policeNonEmergency} rel="noopener" class="font-semibold text-primary underline">{town.officialLinks.policeNonEmergencyLabel} →</a><span class="block text-ink-muted">Non-emergency. In an emergency, call 911.</span></li>}
        </ul>
        <p class="mt-4 text-[0.875rem] leading-relaxed text-ink-muted">{town.siteTitle} is an independent guide, not a government site. Where a page here and an official page differ, the official page controls.</p>
      </div>
      <div class="rounded-lg bg-raised p-6 ring-1 ring-line-soft">
        <p class="eyebrow border-b border-line-soft pb-3">Also on this guide</p>
        <ul class="mt-3 space-y-2 text-[0.9375rem]">
          <li><a href="/moving-here/" class="font-semibold text-primary underline">Moving to {town.name}: the longer read</a></li>
          {town.families && <li><a href="/families/" class="font-semibold text-primary underline">{town.families.label}</a></li>}
          {town.participation && <li><a href="/get-involved/" class="font-semibold text-primary underline">{town.participation.label}</a></li>}
          <li><a href="/guides/" class="font-semibold text-primary underline">The guides</a></li>
          <li><a href="/directory/" class="font-semibold text-primary underline">Every place, in one list</a></li>
        </ul>
      </div>
    </aside>
  </div>
</Page>
