---
/**
 * Local changes (/updates/): what is current, then the archive. The
 * collection is content/<town>/updates/; which is which is
 * src/lib/updates.ts. An old notice is never recycled as news; it stays
 * here, dated, for the reader who wants to know when something changed.
 */
import Page from '@/layouts/Page.astro';
import UpdateRow from '@/components/UpdateRow.astro';
import { getTown } from '@/config';
import { getTownEntries } from '@/lib/content';
import { archivedUpdates, currentUpdates } from '@/lib/updates';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';

const town = getTown();
const all = await getTownEntries('updates');
const now = new Date();
const current = currentUpdates(all, now);
const archive = archivedUpdates(all, now);
const description = `Local changes in ${town.name}, Colorado: openings, closures, road and park work, public decisions and program announcements, each dated and sourced, with an archive.`;
const structured = [
  collectionPageJsonLd(town, { name: `Local changes in ${town.name}, Colorado`, description, path: '/updates/' }),
  breadcrumbJsonLd(town, [
    { name: town.name, path: '/' },
    { name: 'Local changes', path: '/updates/' },
  ]),
];
---
<Page title="Local changes" seoTitle={`Local changes in ${town.name}, CO`} eyebrow={town.name} {description} intro="What changed, who it affects, when, what to do, and where the original is. A proposal is marked as a proposal, work under way as under way; each notice says when it took effect, when this guide published it and when the source was last read." jsonLd={structured} kind="Guide" narrow>
  {current.length === 0 && archive.length === 0 ? (
    <p class="rounded-lg border border-dashed border-line px-6 py-10 text-center text-ink-muted">Nothing logged yet.</p>
  ) : (
    <Fragment>
      <h2 class="eyebrow border-b-2 border-accent pb-3">Current</h2>
      {current.length === 0 ? (
        <p class="mt-4 text-ink-muted">Nothing current. The archive is below.</p>
      ) : (
        <div class="mt-2">{current.map((u) => <UpdateRow update={u} />)}</div>
      )}
      {archive.length > 0 && (
        <section class="mt-14" aria-labelledby="archive-h">
          <h2 id="archive-h" class="eyebrow border-b-2 border-accent pb-3">Archive</h2>
          <div class="mt-2">{archive.map((u) => <UpdateRow update={u} />)}</div>
        </section>
      )}
    </Fragment>
  )}
  <p class="mt-10 text-[0.9375rem] text-ink-muted">Know of a change that should be here? <a href="/contact/" class="font-semibold text-primary underline">Send it with the source</a>.</p>
</Page>
