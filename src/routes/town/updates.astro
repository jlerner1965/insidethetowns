---
/**
 * Local changes (/updates/): what is current, then the archive. The
 * collection is content/<town>/updates/; which is which is
 * src/lib/updates.ts. An old notice is never recycled as news; it stays
 * here, dated, for the reader who wants to know when something changed.
 * From lg, a side column as on Living here (the Berthoud analysis, 8
 * November 2026: the list stood in half the screen with the rest empty):
 * how the page works, the official site, and the guide's other "who to
 * call" pages.
 */
import Page from '@/layouts/Page.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import UpdateRow from '@/components/UpdateRow.astro';
import CheckedLine from '@/components/CheckedLine.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { getTown } from '@/config';
import { getTownEntries } from '@/lib/content';
import { archivedUpdates, currentUpdates } from '@/lib/updates';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';

const town = getTown();
const all = await getTownEntries('updates');
const now = new Date();
const current = currentUpdates(all, now);
const archive = archivedUpdates(all, now);
const description = `Local changes in ${town.name}, Colorado: openings, closures, road and park work, public decisions and program announcements, each dated and sourced, with an archive.`;
const structured = [
  collectionPageJsonLd(town, { name: `Local changes in ${town.name}, Colorado`, description, path: '/updates/' }),
  breadcrumbJsonLd(town, [
    { name: town.name, path: '/' },
    { name: 'Local changes', path: '/updates/' },
  ]),
];
---
<Page title="Local changes" seoTitle={`Local changes in ${town.name}, CO`} eyebrow={town.name} {description} intro={`What changed in ${town.name}, who it affects, and what to do.`} jsonLd={structured} kind="Guide">
  <CheckedLine slot="after-header" perItem dates={current.map((u) => u.data.verified)} />
  <div class="grid gap-12 lg:grid-cols-[minmax(0,44rem)_19rem] lg:justify-between lg:gap-16">
  <div class="min-w-0">
  {current.length === 0 && archive.length === 0 ? (
    <p class="rounded-lg border border-dashed border-line px-6 py-10 text-center text-ink-muted">Nothing logged yet.</p>
  ) : (
    <Fragment>
      <SectionHeader title="Current" />
      {current.length === 0 ? (
        <p class="text-ink-muted">Nothing current. The archive is below.</p>
      ) : (
        <div>{current.map((u) => <UpdateRow update={u} />)}</div>
      )}
      {archive.length > 0 && (
        <section class="mt-14" aria-labelledby="archive-h">
          <SectionHeader id="archive-h" title="Archive" />
          <div>{archive.map((u) => <UpdateRow update={u} />)}</div>
        </section>
      )}
    </Fragment>
  )}
  <p class="mt-10 text-[0.9375rem] text-ink-muted">Know of a change that should be here? <a href="/contact/" class="font-semibold text-primary underline">Send it with the source</a>.</p>
  </div>
  <aside class="space-y-8 lg:sticky lg:top-6 lg:self-start">
    <div class="rounded-lg bg-raised p-6 ring-1 ring-line-soft">
      <p class="eyebrow border-b border-line-soft pb-3">How this page works</p>
      <ul class="mt-3 space-y-2 text-[0.9375rem] leading-snug text-ink-muted">
        <li>Each change is from an official page: the Town, the county, the library or the district, linked on its row.</li>
        <li>A change stays under Current until its end date, then moves to the archive with its date.</li>
      </ul>
    </div>
    <div class="rounded-lg bg-raised p-6 ring-1 ring-line-soft">
      <p class="eyebrow border-b border-line-soft pb-3">Official sources</p>
      <ul class="mt-3 space-y-2 text-[0.9375rem]">
        <li><a href={town.officialLinks.townSite} rel="noopener" class="font-semibold text-primary underline">{town.officialLinks.townSiteLabel ?? `The official ${town.name} site`} →</a></li>
      </ul>
      <p class="mt-4 text-[0.875rem] leading-relaxed text-ink-muted">{town.siteTitle} is an independent guide, not a government site. Where a page here and an official page differ, the official page controls.</p>
    </div>
    <div class="rounded-lg bg-raised p-6 ring-1 ring-line-soft">
      <p class="eyebrow border-b border-line-soft pb-3">Also on this guide</p>
      <ul class="mt-3 space-y-2 text-[0.9375rem]">
        {town.livingHere && <li><a href="/living-here/" class="font-semibold text-primary underline">Living in {town.name}: who to call</a></li>}
        {town.families && <li><a href="/families/" class="font-semibold text-primary underline">Kids’ activities and school days off</a></li>}
        {town.participation && <li><a href="/get-involved/" class="font-semibold text-primary underline">{town.participation.label}</a></li>}
        <li><a href="/events/" class="font-semibold text-primary underline">What’s on</a></li>
      </ul>
    </div>
  </aside>
  </div>
  {/* The Thursday email, once, under the list: this page type had no form
      at all (the sweep of 10 November 2026). Nothing on a guide the email
      does not cover (NewsletterSignup). */}
  <NewsletterSignup town={town} id="updates" variant="home" class="mt-14" />
</Page>
