---
/**
 * Every guide the town has, newest first, on one grid of matching cards.
 *
 * Until this page existed an article was reachable from the home page while
 * it was one of the two newest, from Things to Do if it was about the
 * outdoors, and otherwise from nowhere. A guide to the playgrounds is worth
 * more in its third year than its first week, and this is where it lives.
 */
import Page from '@/layouts/Page.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getTown } from '@/config';
import { getTownEntries } from '@/lib/content';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';

const town = getTown();
const articles = (await getTownEntries('articles')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
// The practical subjects first, the history last: a reader looking for the
// splash pad should not scroll past the railroad to find it.
const ORDER = ['Families', 'Food & drink', 'Outdoors', 'Moving here', 'Community', 'Civic', 'History'];
const categories = [...new Set(articles.map((a) => a.data.category))].sort((a, b) => {
  const ia = ORDER.indexOf(a);
  const ib = ORDER.indexOf(b);
  return (ia < 0 ? ORDER.length : ia) - (ib < 0 ? ORDER.length : ib) || a.localeCompare(b);
});
/**
 * The intro names what the page holds, not what it hopes to. Four guides
 * promised "where to eat" and "the outdoors" over two or three articles on
 * history and moving here, so the subjects are read off the articles.
 */
const SUBJECT: Record<string, string> = {
  Families: `${town.name} with kids`,
  'Food & drink': 'where to eat',
  Outdoors: 'the outdoors',
  'Moving here': 'what moving here is like',
  Community: 'who runs what',
  Civic: 'the civic side of town',
  History: 'how the town got this way',
};
const subjects = categories.map((c) => SUBJECT[c] ?? c.toLowerCase());
const subjectList = subjects.length > 1 ? `${subjects.slice(0, -1).join(', ')}, and ${subjects[subjects.length - 1]}` : subjects.join('');
const description = `Guides to ${town.name}, ${town.state}: ${subjectList}. ${articles.length} so far, each with its sources.`;
const structured = [
  collectionPageJsonLd(town, {
    name: `Guides to ${town.name}, Colorado`,
    description,
    path: '/guides/',
    items: articles.map((a) => ({ name: a.data.title, path: `/articles/${a.slug}/` })),
  }),
  breadcrumbJsonLd(town, [
    { name: town.name, path: '/' },
    { name: 'Guides', path: '/guides/' },
  ]),
];
---
<Page title="Guides" seoTitle={`Guides to ${town.name}, Colorado`} eyebrow={town.name} {description} intro={articles.length > 0 ? `The longer reads: ${subjectList}. Each says where its facts came from.` : 'The longer reads, as they are written. Each will say where its facts came from.'} jsonLd={structured}>
  {articles.length === 0 ? (
    <p class="text-ink-muted">Guides are on their way.</p>
  ) : (
    <Fragment>
      {/*
        One grid, newest first, every guide on the same compact card with its
        subject in the eyebrow (6 October 2026). The page used to give each
        subject its own titled section, which on most towns meant six large
        sections holding one article each.
      */}
      <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => <ArticleCard article={article} compact />)}
      </div>
    </Fragment>
  )}
</Page>
