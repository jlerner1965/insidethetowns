---
import { render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import { getTown } from '@/config';
import { getTownEntry } from '@/lib/content';

const town = getTown();
const page = await getTownEntry('pages', 'moving-here');
const Content = page ? (await render(page)).Content : null;
const { listingsLinks, schoolDistrict, commuteNotes } = town.movingHere;
---
<Page
  title={page?.data.title ?? `Moving to ${town.name}`}
  eyebrow="Moving here"
  intro={page?.data.description}
  description={page?.data.description ?? `Schools, commutes, housing and what to expect when you move to ${town.name}, ${town.state}.`}
>
  <div class="grid gap-12 lg:grid-cols-[1fr_20rem] lg:gap-16">
    <div>
      {Content ? (
        <div class="prose"><Content /></div>
      ) : (
        <p class="text-ink-muted">Guide coming soon.</p>
      )}
    </div>
    <aside class="space-y-8 lg:pt-1">
      <div>
        <p class="eyebrow border-b border-line-soft pb-3">Homes for sale</p>
        <ul class="mt-3 space-y-2.5 text-[0.9375rem]">
          {listingsLinks.map((l) => (
            <li><a href={l.url} rel="noopener nofollow" class="font-semibold text-accent-dark no-underline hover:underline">{l.label} →</a></li>
          ))}
        </ul>
      </div>
      <dl class="divide-y divide-line-soft border-y border-line-soft text-[0.9375rem]">
        {schoolDistrict && (
          <div class="py-4"><dt class="eyebrow">Schools</dt><dd class="mt-1.5 leading-snug">{schoolDistrict}</dd></div>
        )}
        {commuteNotes && (
          <div class="py-4"><dt class="eyebrow">Commute</dt><dd class="mt-1.5 leading-snug">{commuteNotes}</dd></div>
        )}
        {town.population && (
          <div class="py-4"><dt class="eyebrow">Population</dt><dd class="mt-1.5 leading-snug">About {town.population.toLocaleString('en-US')}</dd></div>
        )}
      </dl>
    </aside>
  </div>
</Page>
