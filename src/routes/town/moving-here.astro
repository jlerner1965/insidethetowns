---
import { render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import { countyLabel, getNetworkHub, getTown, liveTowns } from '@/config';
import { formatDate, parseLocal } from '@/lib/dates';
import { getTownEntry } from '@/lib/content';

const town = getTown();
const page = await getTownEntry('pages', 'moving-here');
const rendered = page ? await render(page) : null;
const Content = rendered?.Content ?? null;
// The guide runs to a couple of thousand words, so its own section headings
// double as the contents list. It also gives the column beside the text
// something to hold all the way down, instead of a page-length empty margin.
const contents = (rendered?.headings ?? []).filter((h) => h.depth === 2);
const { listingsLinks, schoolDistrict, commuteNotes } = town.movingHere;
const { countySplit } = town;
const hub = getNetworkHub();
const others = liveTowns().length - 1;
---
<Page
  title={page?.data.title ?? `Moving to ${town.name}`}
  eyebrow="Moving here"
  intro={page?.data.description}
  description={page?.data.description ?? `Schools, commutes, housing and what to expect when you move to ${town.name}, ${town.state}.`}
>
  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-16">
    <div>
      {Content ? (
        <div class="prose"><Content /></div>
      ) : (
        <p class="text-ink-muted">Guide coming soon.</p>
      )}
    </div>
    <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
      {contents.length > 2 && (
        <nav aria-labelledby="contents-heading">
          <p class="eyebrow border-b border-line-soft pb-3" id="contents-heading">In this guide</p>
          <ol class="mt-3 space-y-2 text-[0.9375rem] leading-snug">
            {contents.map((h, i) => (
              <li class="flex gap-3">
                <span class="tabular-nums text-ink-faint">{String(i + 1).padStart(2, '0')}</span>
                <a href={`#${h.slug}`} class="no-underline hover:text-accent-text hover:underline">{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
      {listingsLinks.length > 0 && (
        <div>
          <p class="eyebrow border-b border-line-soft pb-3">Homes for sale</p>
          <ul class="mt-3 space-y-2.5 text-[0.9375rem]">
            {listingsLinks.map((l) => (
              <li><a href={l.url} rel="noopener nofollow" class="font-semibold text-accent-text no-underline hover:underline">{l.label} →</a></li>
            ))}
          </ul>
        </div>
      )}
      {others > 0 && (
        <div class="rounded-lg bg-accent-tint p-5">
          <p class="eyebrow">Still deciding</p>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-muted">
            {town.name} next to the other {others} guides in the network: population, elevation, schools and the
            drive to Denver, side by side.
          </p>
          <a
            href={`https://${hub.domain}/moving/`}
            class="mt-3 inline-block text-[0.9375rem] font-semibold text-accent-text no-underline hover:underline"
          >Which Front Range town? →</a>
        </div>
      )}
      <dl class="divide-y divide-line-soft border-y border-line-soft text-[0.9375rem]">
        <div class="py-4">
          <dt class="eyebrow">County</dt>
          <dd class="mt-1.5 leading-snug">
            {countyLabel(town)}
            {countySplit && (
              <>
                <span class="mt-1.5 block text-ink-muted">{countySplit.note}</span>
                <span class="mt-1.5 block text-[0.8125rem] text-ink-faint">
                  <a href={countySplit.source} class="text-accent-text" rel="nofollow">Source</a>
                  {' · checked '}
                  <time datetime={countySplit.verified}>{formatDate(parseLocal(countySplit.verified))}</time>
                </span>
              </>
            )}
          </dd>
        </div>
        {schoolDistrict && (
          <div class="py-4"><dt class="eyebrow">Schools</dt><dd class="mt-1.5 leading-snug">{schoolDistrict}</dd></div>
        )}
        {commuteNotes && (
          <div class="py-4"><dt class="eyebrow">Commute</dt><dd class="mt-1.5 leading-snug">{commuteNotes}</dd></div>
        )}
        {town.population && (
          <div class="py-4"><dt class="eyebrow">Population</dt><dd class="mt-1.5 leading-snug">About {town.population.toLocaleString('en-US')}</dd></div>
        )}
      </dl>
    </aside>
  </div>
</Page>
