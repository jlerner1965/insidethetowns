---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import ContentsList from '@/components/ContentsList.astro';
import { countyLabel, getNetworkHub, getTown, liveTowns } from '@/config';
import { formatDate, parseLocal } from '@/lib/dates';
import { getTownEntry } from '@/lib/content';

const town = getTown();
const page = await getTownEntry('pages', 'moving-here');
const rendered = page ? await render(page) : null;
const Content = rendered?.Content ?? null;
// The guide runs to a couple of thousand words, so its own section headings
// double as the contents list. It also gives the column beside the text
// something to hold all the way down, instead of a page-length empty margin.
const contents = (rendered?.headings ?? []).filter((h) => h.depth === 2);
const { listingsLinks, schoolDistrict, commuteNotes } = town.movingHere;
const { countySplit } = town;
const hub = getNetworkHub();
const others = liveTowns().length - 1;
// The page's photograph, shown as an article's is. It sat in the frontmatter
// and on /credits/ without appearing here, and every share preview fell back
// to the hero.
const image = page?.data.image;
const shareImage = image ? (await getImage({ src: image, width: 1200, height: 630, format: 'jpg' })).src : undefined;
---
<Page
  title={page?.data.title ?? `Moving to ${town.name}`}
  seoTitle={`Moving to ${town.name}, Colorado`}
  eyebrow="Moving here"
  intro={page?.data.description}
  description={page?.data.description ?? `Schools, commutes, housing and what to expect when you move to ${town.name}, ${town.state}.`}
  image={shareImage}
  imageAlt={page?.data.imageAlt}
>
  {image && (
    <figure class:list={['mb-12', image.width < 1000 && 'max-w-2xl']}>
      <Image src={image} alt={page?.data.imageAlt ?? ''} width={1600} height={900} class:list={['w-full rounded-lg object-cover', image.width >= 1000 && 'lg:h-[32rem]!']} />
      {page?.data.imageCredit && (
        <figcaption class="mt-2 text-[0.8125rem] text-ink-muted">Photo: {page.data.imageCredit}</figcaption>
      )}
    </figure>
  )}
  {/*
    On a phone: the facts (county, schools, commute), then the contents, then
    the guide, then the listings links. They came after the whole guide,
    some 6,000px down. On a wide screen the rail scrolls with the page and
    only the contents stay pinned: the whole rail, pinned, was taller than a
    laptop screen and hid its own last 450px. Each column's wrapper is
    `contents` below lg so its children take part in the outer `order`.
  */}
  <div class="flex flex-col gap-10 lg:grid lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-16">
    <div class="contents lg:block">
      {contents.length > 2 && (
        <div class="order-2 lg:hidden">
          <ContentsList headings={contents} label="In this guide" variant="panel" id="contents-panel" />
        </div>
      )}
      <div class="order-3 lg:order-none">
        {Content ? (
          <div class="prose"><Content /></div>
        ) : (
          <p class="text-ink-muted">Guide coming soon.</p>
        )}
      </div>
    </div>
    <div class="contents lg:flex lg:flex-col lg:gap-8">
      {town.sponsors?.movingHere && (
        <div class="order-6 rounded-lg border border-line-soft bg-raised p-5 lg:order-none" data-sponsor>
          <p class="eyebrow text-ink-muted">Sponsor</p>
          <p class="mt-2 text-[0.9375rem] leading-snug">
            Moving Here is supported by <a href={town.sponsors.movingHere.url} rel="sponsored noopener" class="font-semibold text-primary">{town.sponsors.movingHere.name}</a>{town.sponsors.movingHere.line && <span class="text-ink-muted"> · {town.sponsors.movingHere.line}</span>}
          </p>
        </div>
      )}
      <dl class="order-1 divide-y divide-line-soft border-y border-line-soft text-[0.9375rem] lg:order-none">
        <div class="py-4">
          <dt class="eyebrow">County</dt>
          <dd class="mt-1.5 leading-snug">
            {countyLabel(town)}
            {countySplit && (
              <>
                <span class="mt-1.5 block text-ink-muted">{countySplit.note}</span>
                <span class="mt-1.5 block text-[0.8125rem] text-ink-muted">
                  <a href={countySplit.source} class="text-primary" rel="nofollow">Source</a>
                  {' · checked '}
                  <time datetime={countySplit.verified}>{formatDate(parseLocal(countySplit.verified))}</time>
                </span>
              </>
            )}
          </dd>
        </div>
        {schoolDistrict && (
          <div class="py-4"><dt class="eyebrow">Schools</dt><dd class="mt-1.5 leading-snug">{schoolDistrict}</dd></div>
        )}
        {commuteNotes && (
          <div class="py-4"><dt class="eyebrow">Commute</dt><dd class="mt-1.5 leading-snug">{commuteNotes}</dd></div>
        )}
        {town.population && (
          <div class="py-4"><dt class="eyebrow">Population</dt><dd class="mt-1.5 leading-snug">{town.population.toLocaleString('en-US')} at the 2020 census</dd></div>
        )}
      </dl>
      {listingsLinks.length > 0 && (
        <div class="order-4 lg:order-none">
          <p class="eyebrow border-b border-line-soft pb-3">Homes for sale</p>
          <ul class="mt-3 space-y-2.5 text-[0.9375rem]">
            {listingsLinks.map((l) => (
              <li><a href={l.url} rel="noopener nofollow" class="inline-block -my-1 py-1 font-semibold text-primary no-underline hover:underline">{l.label} →</a></li>
            ))}
          </ul>
        </div>
      )}
      {others > 0 && (
        <div class="order-5 rounded-lg bg-raised p-5 ring-1 ring-line-soft lg:order-none">
          <p class="eyebrow">Still deciding</p>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-muted">
            {town.name} next to the other {others} guides in the network: population, elevation, schools and the
            drive to Denver, side by side.
          </p>
          <a
            href={`https://${hub.domain}/moving/`}
            class="mt-3 inline-block text-[0.9375rem] font-semibold text-primary no-underline hover:underline"
          >Which Front Range town? →</a>
        </div>
      )}
      {contents.length > 2 && (
        <div class="lg:sticky lg:top-24">
          <ContentsList headings={contents} label="In this guide" variant="rail" id="contents-heading" />
        </div>
      )}
    </div>
  </div>
</Page>
