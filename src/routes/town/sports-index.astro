---
/**
 * /sports/ on a guide that follows several schools (Loveland's four,
 * src/config/school-sports.ts): each school as one row, its records this
 * fall, its next game (whichever team plays it) and its last result, from
 * the same data files its own page reads, and a link to that page. A town
 * with one school has no such page: its /sports/ is the school's own.
 */
import Page from '@/layouts/Page.astro';
import { getTown } from '@/config';
import { schoolsFor, sportsPath, type SportsData } from '@/config/school-sports';
import { formatDayShort, formatShortDate } from '@/lib/dates';
import { bigGame, formatGameTime, gameDay, latestResult, outcome, RESULT_WORD, seasonOf, sportsDataFor, where } from '@/lib/school-sports';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';

const town = getTown();
const files = import.meta.glob<SportsData>('../../../data/*/sports*.json', { eager: true, import: 'default' });
const schools = schoolsFor(town.slug);
if (schools.length < 2) throw new Error(`${town.slug} follows ${schools.length} school(s); /sports/ is the school's own page (src/integrations/town-routes.ts)`);
const now = new Date();
const rows = schools.map((school) => {
  const data = sportsDataFor(school, files) ?? { generated: '', sports: [] };
  const teams = data.sports.filter((s) => s.fetched && !s.empty);
  const fetched = data.sports.map((s) => s.fetched).filter(Boolean) as string[];
  return { school, teams, next: bigGame(data, now), last: latestResult(data), read: fetched.length ? new Date(fetched.sort().at(-1)!) : undefined };
});
// The season, from the first school's data (seasonOf): the four share a calendar.
const { label: seasonLabel, season } = seasonOf(sportsDataFor(schools[0]!, files) ?? { generated: '', sports: [] }, schools[0]!.teams, now);
const seasonWord = season.toLowerCase();
// The newest run among the schools' files: the page's dateModified and its sitemap lastmod.
const stamps = schools.map((school) => Date.parse(sportsDataFor(school, files)?.generated ?? '')).filter((t) => !Number.isNaN(t));
const generated = stamps.length ? new Date(Math.max(...stamps)) : undefined;
const reads = rows.map((r) => r.read).filter(Boolean) as Date[];
const newest = reads.length ? new Date(Math.max(...reads.map((d) => d.getTime()))) : undefined;
const names = schools.map((s) => s.school);
const COUNT: Record<number, string> = { 2: 'two', 3: 'three', 4: 'four', 5: 'five', 6: 'six' };
const description = `${town.name}’s high-school scores and schedules this ${seasonWord}: ${names.slice(0, -1).join(', ')} and ${names.at(-1)}, from MaxPreps, each checked against the school’s own calendar where there is one.`;
const jsonLd = [
  collectionPageJsonLd(town, {
    name: `${town.name} high-school sports`,
    description,
    path: '/sports/',
    items: schools.map((s) => ({ name: `${s.school} ${s.mascot}`, path: sportsPath(s) })),
    updated: generated,
  }),
  breadcrumbJsonLd(town, [
    { name: town.name, path: '/' },
    { name: 'Sports', path: '/sports/' },
  ]),
];
---
<Page title="High school sports" seoTitle={`${town.name} high-school scores and schedules`} eyebrow={`${town.name} · ${seasonLabel}`} {description} intro={`Scores, schedules and records for ${town.name}’s ${COUNT[schools.length] ?? schools.length} high schools this ${seasonWord}.`} {jsonLd}>
  {newest && <p slot="after-header" class="mt-3 text-[0.9375rem] text-ink-muted">Scores from MaxPreps, read {formatShortDate(newest)}.</p>}
  <ul class="divide-y divide-line-soft border-y border-line-soft">
    {rows.map(({ school, teams, next, last }) => (
      <li class="py-5">
        <a href={sportsPath(school)} class="group block no-underline">
          <h2 class="display-md text-[1.75rem] group-hover:underline md:text-[2rem]">{school.school} {school.mascot}</h2>
          {teams.length > 0 ? (
            <p class="mt-2 text-[0.9375rem] text-ink-muted">
              {teams.map((t, i) => (
                <Fragment>{i > 0 && ' · '}{t.name}{' '}<strong class="font-semibold text-ink">{t.overall ?? '—'}</strong></Fragment>
              ))}
            </p>
          ) : (
            <p class="mt-2 text-[0.9375rem] text-ink-muted">No scores yet: the first read has not run.</p>
          )}
          {next && (
            <p class="mt-1 text-[0.9375rem]">
              Next: <strong class="font-semibold">{next.team.name}</strong> {where(next.game)} {next.game.opponent}, <time datetime={next.game.date}>{formatDayShort(gameDay(next.game))}</time>{next.game.time && ` · ${formatGameTime(next.game)}`}
            </p>
          )}
          {last?.game.result && (
            <p class="mt-1 text-[0.9375rem]">
              Last: <strong class="font-semibold">{last.team.name}</strong> {RESULT_WORD[last.game.result].toLowerCase()} {outcome(last.game)}, <time datetime={last.game.date}>{formatDayShort(gameDay(last.game))}</time>
            </p>
          )}
          <p class="mt-2 text-[0.9375rem]"><span class="font-semibold text-primary underline">Scores and schedules →</span></p>
        </a>
      </li>
    ))}
  </ul>
</Page>
