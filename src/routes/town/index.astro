---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import EventCard from '@/components/EventCard.astro';
import PlaceCard from '@/components/PlaceCard.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getTown } from '@/config';
import { getTownEntries } from '@/lib/content';
import { upcoming } from '@/lib/events';
import { websiteJsonLd } from '@/lib/seo';

const town = getTown();
const events = upcoming(await getTownEntries('events'), { limit: 4 });
const places = await getTownEntries('places');
const featuredPlaces = [...places.filter((p) => p.data.featured), ...places.filter((p) => !p.data.featured)].slice(0, 6);
const articles = (await getTownEntries('articles')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 2);
---
<Base jsonLd={websiteJsonLd(town)}>
  <Hero />

  <section class="container-page py-12">
    <div class="mb-6 flex items-baseline justify-between gap-4">
      <h2 class="text-3xl font-bold">This week in {town.name}</h2>
      <a href="/events/" class="text-sm font-semibold text-accent-dark hover:underline">All events →</a>
    </div>
    {events.length === 0 ? (
      <p class="text-ink-muted">No upcoming events listed yet. <a href="/contact/#submit-event" class="underline">Submit one.</a></p>
    ) : (
      <div class="grid gap-4 md:grid-cols-2">
        {events.map((event) => <EventCard event={event} />)}
      </div>
    )}
  </section>

  <section class="container-page py-12">
    <div class="mb-6 flex items-baseline justify-between gap-4">
      <h2 class="text-3xl font-bold">Where to go</h2>
      <a href="/eat-drink/" class="text-sm font-semibold text-accent-dark hover:underline">Eat &amp; drink →</a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featuredPlaces.map((place) => <PlaceCard place={place} />)}
    </div>
  </section>

  {articles.length > 0 && (
    <section class="container-page py-12">
      <h2 class="mb-6 text-3xl font-bold">Latest</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
    </section>
  )}

  <section class="container-page py-12">
    <div class="rounded-lg bg-accent-dark p-8 text-white md:p-12">
      <h2 class="text-3xl font-bold">Thinking of moving to {town.name}?</h2>
      <p class="mt-3 max-w-xl text-white/85">
        Schools, commutes, what the housing market looks like, and what nobody tells you until you live here.
      </p>
      <a href="/moving-here/" class="mt-6 inline-block rounded-md bg-white px-4 py-2 font-semibold text-accent-dark hover:bg-neutral-bg">Read the guide</a>
    </div>
  </section>
</Base>
