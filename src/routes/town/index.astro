---
/**
 * The town home page for every guide without the flagship layout: the
 * shared page. A guide whose config carries `home` is built from
 * home-flagship.astro instead (src/integrations/town-routes.ts, homeRoute),
 * so nothing of the flagship's reaches this page's build. The markup is on
 * one line so the page is byte for byte what it was when this file chose
 * between the two layouts, whitespace included.
 */
import Base from '@/layouts/Base.astro';
import ClassicHome from '@/components/home/ClassicHome.astro';
---
<Base><ClassicHome /></Base>
