---
/**
 * The town home page, the same file for every guide (design pass, 26
 * October 2026): src/components/home/TownHome.astro reads the guide's
 * config for what to lead with and what to close on.
 */
import Base from '@/layouts/Base.astro';
import TownHome from '@/components/home/TownHome.astro';
import { getNetworkHub, getTown, isSectionBuild } from '@/config';
import { breadcrumbJsonLd, collectionPageJsonLd, fillDescription } from '@/lib/seo';
import { townNav } from '@/lib/nav';
import { homeTitle } from '@/lib/titles';

// The tagline, and where it is short (Niwot's is 113 characters), the line
// of trust the page prints under What's happening.
const town = getTown();
const description = fillDescription(town.tagline, ['Every listing checked against its source.']);
/*
 * The home page's BreadcrumbList: every other page carried one and the
 * seven guides' homes on the hub did not (the site audit of 19 November
 * 2026). On the hub the trail starts at the hub, as the hub's town pages
 * do; the guide's own domain starts at the guide. The merge rewrites the
 * guide's address to its place on the hub (scripts/lib/section-merge.ts).
 */
const hub = getNetworkHub();
const crumbs = breadcrumbJsonLd(town, [{ name: town.name, path: '/' }]);
if (isSectionBuild()) crumbs.itemListElement = [{ '@type': 'ListItem', position: 1, name: hub.siteTitle, item: `https://${hub.domain}/` }, { ...crumbs.itemListElement[0]!, position: 2 }];
/*
 * CollectionPage and its ItemList, as the hub's town pages carry (the
 * owner, 20 November 2026: the same structured data on the eleven guides).
 * A town page lists its annual dates; a guide's home is a front door, so
 * its list is the guide's own pages, the ones its menu names, each of which
 * marks up what it lists. The merge rewrites the addresses as it does the
 * trail's.
 */
const collection = collectionPageJsonLd(town, { name: homeTitle(town), description, path: '/', items: townNav(town).map((n) => ({ name: n.label, path: n.href })) });
---
<Base {description} jsonLd={[collection, crumbs]}><TownHome /></Base>
