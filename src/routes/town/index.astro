---
/**
 * The town home page, the same file for every guide (design pass, 26
 * October 2026): src/components/home/TownHome.astro reads the guide's
 * config for what to lead with and what to close on.
 */
import Base from '@/layouts/Base.astro';
import TownHome from '@/components/home/TownHome.astro';
import { getTown } from '@/config';
import { fillDescription } from '@/lib/seo';

// The tagline, and where it is short (Niwot's is 113 characters), the line
// of trust the page prints under What's happening.
const description = fillDescription(getTown().tagline, ['Every listing checked against its source.']);
---
<Base {description}><TownHome /></Base>
