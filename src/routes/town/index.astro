---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import EventCard from '@/components/EventCard.astro';
import PlaceCard from '@/components/PlaceCard.astro';
import PlaceFeature from '@/components/PlaceFeature.astro';
import PlaceIndex from '@/components/PlaceIndex.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getTown } from '@/config';
import { getTownEntries } from '@/lib/content';
import { occurrences, uniqueByEvent, upcoming } from '@/lib/events';

const town = getTown();
const events = uniqueByEvent(upcoming(occurrences(await getTownEntries('events')))).slice(0, 4);
const places = await getTownEntries('places');
// Cards are for photographs. A card with no photograph is an empty grey box,
// and most of these towns have only a handful of licensed images, so the rest
// of the section is an index of names instead of a grid of placeholders.
const pickedFirst = <T extends { data: { featured: boolean } }>(list: T[]) => [
  ...list.filter((p) => p.data.featured),
  ...list.filter((p) => !p.data.featured),
];
const placeCards = pickedFirst(places.filter((p) => p.data.image)).slice(0, 3);
const carded = new Set(placeCards.map((p) => p.slug));
const placeIndex = pickedFirst(places.filter((p) => !carded.has(p.slug))).slice(0, 8);
const articles = (await getTownEntries('articles')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 2);
const [lead, second] = articles;
---
<Base>
  <Hero />

  {/* The page is a run of coloured bands: white, then the accent at 9%, then
     the accent itself. Without them the whole site is one sheet of tan. */}
  <section class="band band-white">
    <div class="container-page">
    <SectionHeader eyebrow={`This week in ${town.name}`} title="What’s on" href="/events/" linkLabel="All events" />
    {events.length === 0 ? (
      <p class="text-ink-muted">No upcoming events listed yet. <a href="/contact/#submit-event" class="text-accent-dark underline">Submit one.</a></p>
    ) : (
      <div class="grid border-b border-line-soft md:grid-cols-2 md:gap-x-12">
        {events.map((event) => <EventCard event={event} />)}
      </div>
    )}
    </div>
  </section>

  <section class="band band-tint">
    <div class="container-page">
    <SectionHeader eyebrow="Eat, drink, wander" title="Where to go" href="/eat-drink/" linkLabel="Eat & drink" />
    {places.length === 0 ? (
      <p class="text-ink-muted">Places are on their way.</p>
    ) : (
      <>
        {placeCards.length === 1 && <PlaceFeature place={placeCards[0]} />}
        {placeCards.length > 1 && (
          <div class:list={['grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:gap-x-8', placeCards.length > 2 && 'lg:grid-cols-3']}>
            {placeCards.map((place) => <PlaceCard place={place} />)}
          </div>
        )}
        {placeIndex.length > 0 && (
          <div class:list={[placeCards.length > 0 && 'mt-12 border-t border-line-soft pt-2']}>
            <PlaceIndex places={placeIndex} />
          </div>
        )}
      </>
    )}
    </div>
  </section>

  {lead && (
    <section class="band band-white">
      <div class="container-page">
      <SectionHeader eyebrow="Latest" title="From the guide" />
      <ArticleCard article={lead} feature />
      {second && (
        <div class="mt-12 max-w-xl border-t border-line-soft pt-8">
          <ArticleCard article={second} />
        </div>
      )}
      </div>
    </section>
  )}

  <section class="on-dark bg-accent-dark text-white">
    <div class="container-page grid gap-8 py-16 md:grid-cols-[3fr_2fr] md:items-end md:py-24">
      <div>
        <p class="eyebrow text-highlight">Moving here</p>
        <h2 class="display-md mt-4 text-4xl lg:text-6xl">Thinking of making {town.name} home?</h2>
      </div>
      <div>
        <p class="text-lg leading-relaxed text-white/85">
          Schools, commutes, what the housing market looks like, and what nobody tells you until you live here.
        </p>
        <a href="/moving-here/" class="btn btn-light mt-6">Read the guide</a>
      </div>
    </div>
  </section>
</Base>
