---
/**
 * The town home page. A guide whose config carries `home` (the two
 * flagships, 21 October 2026) gets the flagship layout: a compact split
 * masthead, the week first with its supporting column, a signature
 * section, the places, the email, resident resources and the neighbours.
 * Every other guide keeps the shared page as it was.
 */
import Base from '@/layouts/Base.astro';
import ClassicHome from '@/components/home/ClassicHome.astro';
import FlagshipHome from '@/components/home/FlagshipHome.astro';
import { getTown } from '@/config';

const town = getTown();
---
<Base>
  {town.home ? <FlagshipHome town={town} /> : <ClassicHome />}
</Base>
