---
/**
 * The participation hub (/get-involved/): the organizations, clubs,
 * volunteer roles, public meetings and social activities a resident can
 * join, from content/<town>/programs/ (the ways-in kinds, src/lib/programs.ts).
 * Each says what it does, who can take part, what it costs, how to make a
 * first inquiry and the next public date, from the organizer's own page.
 * A venue booking is never shown as an invitation: the access line says
 * members, registration or the public.
 */
import Page from '@/layouts/Page.astro';
import ProgramRow from '@/components/ProgramRow.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import { getTown } from '@/config';
import { getTownEntries } from '@/lib/content';
import { byName, isWayIn } from '@/lib/programs';
import { PROGRAM_KIND_LABELS, type ProgramKind } from '@/content/schemas';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';

const town = getTown();
const participation = town.participation!;
const programs = byName((await getTownEntries('programs')).filter(isWayIn));
// Grouped by what kind of way in it is, in the order a newcomer asks:
// turn up (social), join (clubs and organizations), serve (volunteer), speak (meetings).
const ORDER: ProgramKind[] = ['social', 'club', 'organization', 'volunteer', 'meeting', 'service'];
const groups = ORDER.map((kind) => ({ kind, programs: programs.filter((p) => p.data.kind === kind) })).filter((g) => g.programs.length > 0);
const GROUP_LABELS: Partial<Record<ProgramKind, string>> = {
  social: 'Turn up',
  club: 'Clubs and groups',
  organization: 'Organizations to join',
  volunteer: 'Volunteer',
  meeting: 'Public meetings',
  service: 'Services and schools',
};
const published = programs.filter((p) => p.data.newcomers).length;
const description = `${participation.label} in ${town.name}, Colorado: ${programs.length} verified ways to join, serve or turn up, each with cost, contact and the next public date from the organizer's own page.`;
const structured = [
  collectionPageJsonLd(town, { name: `${participation.label} in ${town.name}, Colorado`, description, path: '/get-involved/', items: programs.map((p) => ({ name: p.data.title, path: '/get-involved/' })) }),
  breadcrumbJsonLd(town, [
    { name: town.name, path: '/' },
    { name: participation.label, path: '/get-involved/' },
  ]),
];
---
<Page title={`${participation.label} in ${town.name}`} seoTitle={`${participation.label} in ${town.name}, CO: clubs, volunteering, meetings`} eyebrow={town.name} {description} intro={participation.intro} jsonLd={structured} kind="Guide">
  <nav slot="after-header" aria-label="On this page" class="mt-6 flex flex-wrap gap-x-5 gap-y-1 text-[0.9375rem]">
    {groups.map((g) => <a href={`#${g.kind}`} class="inline-block -my-1 py-1 font-semibold text-primary underline">{GROUP_LABELS[g.kind] ?? PROGRAM_KIND_LABELS[g.kind]}</a>)}
  </nav>

  {programs.length === 0 ? (
    <p class="rounded-lg border border-dashed border-line px-6 py-10 text-center text-ink-muted">Nothing verified yet. The first entry goes up once an organizer's own page has been read.</p>
  ) : (
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-16">
      <div class="min-w-0">
        {groups.map((g, i) => (
          <section id={g.kind} class:list={['scroll-mt-4', i > 0 && 'mt-14']} aria-labelledby={`${g.kind}-h`}>
            <h2 id={`${g.kind}-h`} class="eyebrow border-b-2 border-accent pb-3">{GROUP_LABELS[g.kind] ?? PROGRAM_KIND_LABELS[g.kind]}</h2>
            <div class="mt-2 rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
              {g.programs.map((p) => <ProgramRow program={p} showKind={false} />)}
            </div>
          </section>
        ))}
      </div>
      <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-lg bg-raised p-6 ring-1 ring-line-soft">
          <p class="eyebrow border-b border-line-soft pb-3">What the lines mean</p>
          <ul class="mt-3 space-y-2 text-[0.9375rem] leading-snug text-ink-muted">
            <li><strong class="text-ink">Newcomers welcome</strong> is said only where the organizer says it.</li>
            <li><strong class="text-ink">Members and their guests</strong> means a meeting a non-member does not simply walk into.</li>
            <li>A room booked at a hall is a booking, not an invitation; the times here are the organizer's, not the hall's.</li>
            <li>{published} of the {programs.length} entries say newcomers are welcome. Every entry names its source and the day it was read.</li>
          </ul>
        </div>
        <div class="rounded-lg bg-raised p-6 ring-1 ring-line-soft">
          <p class="eyebrow border-b border-line-soft pb-3">Also on this guide</p>
          <ul class="mt-3 space-y-2 text-[0.9375rem]">
            <li><a href="/events/?category=civic" class="font-semibold text-primary underline">Town and county meetings on the calendar</a></li>
            {town.families && <li><a href="/families/" class="font-semibold text-primary underline">{town.families.label}</a></li>}
            {town.livingHere && <li><a href="/living-here/" class="font-semibold text-primary underline">Living here: who handles what</a></li>}
            <li><a href="/submit-event/" class="font-semibold text-primary underline">Run a group that should be here? Send it in</a></li>
          </ul>
        </div>
      </aside>
    </div>
  )}
  <div class="mt-14">
    <NewsletterSignup town={town} compact id="get-involved" />
  </div>
</Page>
