---
/**
 * The town's high school sports, laid out the way a scores site is: the
 * records across the top, the next game big in the town's dark band, a
 * scoreboard of the latest scores, then every team: its next games first
 * and the whole season behind "Show all N games", all read from
 * data/<town>/sports.json. The Saturday and Wednesday runs write that file
 * (`npm run sports`); nothing here is typed in by hand.
 *
 * Only the teams in play are laid out: the fall and winter lists in
 * src/config/school-sports.ts, and of those, one MaxPreps has nothing for
 * (both cross country teams, October 2026; the winter teams until their
 * schedules are posted) is left off until it has a game.
 *
 * Built on Base with its own masthead and bands, the way the home page is,
 * rather than on Page: the big game has to be a full-width band between
 * the masthead and the rest, and Page has no slot there.
 *
 * The route is injected for the towns in src/config/school-sports.ts
 * (src/integrations/town-routes.ts), which also names the school, the
 * mascot and the calendar: at /sports/ for a town's only school, and at
 * /sports/<slug>/ for each of a town's several (Loveland's four), the page
 * reading its school off its own path. The source line at the top dates the
 * newest read; a team whose own read is older than that says so under its
 * table, so a week MaxPreps could not be reached shows. A game the school
 * calendar contradicts is not in the file's `upcoming` list at all
 * (scripts/lib/sports-crosscheck.ts), so the page simply shows the next game
 * the two sources agree on, or none.
 *
 * The navigation audit of 22 October 2026 cut the method text (a per-team
 * "updated" line, the record-count notes, the empty cross country line and
 * a closing paragraph) to the one source line and a sentence at the foot.
 */
import Base from '@/layouts/Base.astro';
import CtaBand from '@/components/CtaBand.astro';
import NextUp from '@/components/NextUp.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import TeamSeason from '@/components/TeamSeason.astro';
import { getTown } from '@/config';
import { schoolSportsFor, schoolsFor, sportsPath, teamPath, type SportData, type SportsData } from '@/config/school-sports';
import { dayKey, formatDayShort, formatShortDate } from '@/lib/dates';
import { bigGame, coming, gameDay as day, latestResult, recentResults, RESULT_WORD, placeText, schoolCssVars, schoolPageTitle, seasonComplete, seasonOf, sportsDataFor, teamsWithData, where } from '@/lib/school-sports';
import { breadcrumbJsonLd, collectionPageJsonLd, sportsEventJsonLd } from '@/lib/seo';

const town = getTown();
// Every town's file is in the bundle; the route exists only for towns in the config.
const files = import.meta.glob<SportsData>('../../../data/*/sports*.json', { eager: true, import: 'default' });
const slug = Astro.url.pathname.match(/^\/sports\/([^/]+)\/?$/)?.[1];
const cfg = schoolSportsFor(town.slug, slug);
if (!cfg) throw new Error(`No school is configured for ${Astro.url.pathname} on ${town.slug} (src/config/school-sports.ts)`);
const schools = schoolsFor(town.slug);
const sisters = schools.filter((s) => s !== cfg);
const path = sportsPath(cfg);
const data: SportsData = sportsDataFor(cfg, files) ?? { generated: '', sports: [] };
const sports: SportData[] = data.sports;
const MAXPREPS_SCHOOL = cfg.maxpreps;
const { school, mascot, calendar } = cfg;
// "football, boys soccer, volleyball and softball": the teams the page has
// something for, a boys' and a girls' team of one sport as one. From the
// data, not the config's list: the description promised cross country,
// which every page left off because MaxPreps had nothing for it.
const followed = [...new Set(sports.filter((t) => t.fetched && !t.empty).map((t) => t.name.toLowerCase().replace(/^(boys|girls) (cross country)$/, '$2')))];
const teamList = followed.length > 1 ? `${followed.slice(0, -1).join(', ')} and ${followed.at(-1)}` : followed[0] ?? 'every team';
const now = new Date();
const today = dayKey(now);
// "Fall 2026", "Winter 2026": the season of the next game listed, from the data (seasonOf).
const { season: seasonName, label: seasonLabel } = seasonOf(data, cfg.teams, now);
const seasonWord = seasonName.toLowerCase();
const description = `${school} ${mascot} scores, schedules and records this ${seasonWord}: ${teamList}, from MaxPreps${calendar ? ', checked against the school calendar' : ''}.`;
// One guide, one colour: a guide that follows one school wears it; a guide
// that follows several (Loveland) keeps its own on every school's page.
const schoolStyle = schools.length === 1 ? schoolCssVars(cfg) : undefined;

const next = bigGame(data, now);
const then = coming(data).filter((c) => c.game.date >= today && c.game.url !== next?.game.url);
const latest = latestResult(data);
const board = recentResults(data, 6);

// The teams with a season to show and the ones whose page has never been
// read. A team MaxPreps has nothing for yet (cross country in the fall) is
// left off: an empty line on every page until spring helped nobody.
const teams = teamsWithData(data);
const unread = sports.filter((s) => !s.fetched && !s.empty);

const fetchedDates = sports.map((s) => s.fetched).filter(Boolean) as string[];
const newest = fetchedDates.length ? new Date(fetchedDates.sort().at(-1)!) : undefined;
/** A team read more than three days before the newest read: its date is worth showing. */
const stale = (s: SportData) => !!newest && !!s.fetched && newest.getTime() - new Date(s.fetched).getTime() > 3 * 86_400_000;

/** The pill's colours: a win in the primary, a loss in the ink, a tie in the soft accent. */
const PILL = {
  W: 'bg-primary text-white',
  L: 'bg-ink text-raised',
  T: 'bg-accent-soft text-ink',
} as const;

const shortName = (s: { school: string }) => s.school.replace(/ (High )?School$/, '');
const indexName = `${town.name} high school sports`;
// "Berthoud High School Spartans Scores & Schedules — Football, Soccer,
// Volleyball, Softball": the sports from the teams with data, never typed.
const pageTitle = schoolPageTitle(cfg, teams);
const jsonLd = [
  collectionPageJsonLd(town, { name: pageTitle, description, path }),
  breadcrumbJsonLd(town, [
    { name: town.name, path: '/' },
    { name: 'Sports', path: '/sports/' },
    ...(cfg.slug ? [{ name: school, path }] : []),
  ]),
  // One SportsEvent per game to come, every team, from the data alone (src/lib/seo.ts).
  ...coming(data)
    .filter((c) => c.game.date >= today)
    .map((c) => sportsEventJsonLd(town, cfg, c.team, c.game, path))
    .filter((e): e is NonNullable<typeof e> => !!e),
];
---
<Base title={pageTitle} fullTitle={`${pageTitle} · ${town.siteTitle}`} {description} {jsonLd}>
  {/* The school's colour from here to the foot, where the guide follows one school: see SchoolSports.colors. */}
  <div style={schoolStyle}>
  <header class="border-b-2 border-accent bg-raised">
    <div class="container-page py-10 md:py-14">
      <div class="max-w-3xl">
        {cfg.slug ? (
          <nav aria-label="Breadcrumb" class="mb-3">
            <ol class="eyebrow flex flex-wrap items-center gap-x-2">
              <li><a href="/sports/" class="underline underline-offset-2">{indexName}</a></li>
              <li aria-hidden="true">›</li>
              <li aria-current="page">{shortName(cfg)}</li>
            </ol>
          </nav>
        ) : (
          <p class="eyebrow mb-3">Sports · {seasonLabel}</p>
        )}
        {/* 2.25rem on a phone: "Resurrection Christian sports" in two lines, not three. */}
        <h1 class="display-md text-[2.25rem] sm:text-5xl md:text-6xl">{school} sports</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted md:text-xl">
          Scores, schedules and records for every {mascot} team this {seasonWord}.
        </p>
        {cfg.note && <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-muted">{cfg.note}</p>}
      </div>

      {/* The records strip: every team in play, its record as the headline,
          each a link to its season below. The first thing a scores site
          shows, and the one line a parent in the stands wants. */}
      {teams.length > 0 && (
        <nav class="mt-8" aria-label="Teams and records">
          {/* One row per team on a phone, the record at the right edge; from
              40rem the teams sit side by side as columns. */}
          <ul class="divide-y divide-line-soft border-y border-line-soft sm:flex sm:divide-x sm:divide-y-0">
            {teams.map((s) => (
              <li class="sm:flex-1">
                <a href={`#${s.key}`} class="group flex items-baseline justify-between gap-4 py-3 no-underline sm:block sm:py-4 sm:pr-6 sm:pl-5 sm:first:pl-0">
                  <span class="min-w-0">
                    <span class="eyebrow block">{s.name}</span>
                    {s.league && (
                      <span class="mt-0.5 block text-[0.875rem] leading-snug text-ink-muted sm:hidden">
                        {s.league.place ? `${s.league.place} in the ` : ''}{s.league.name}
                      </span>
                    )}
                  </span>
                  <span class="display-md shrink-0 whitespace-nowrap text-[2.25rem] text-primary group-hover:underline sm:mt-1 sm:block md:text-5xl">{s.overall ?? '—'}</span>
                  {s.league && (
                    <span class="mt-1 hidden whitespace-nowrap text-[0.875rem] text-ink-muted sm:block">
                      {s.league.place ? `${s.league.place} in the ` : ''}{s.league.name}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      {/* The page's one source line. */}
      <p class="mt-5 text-[0.9375rem] text-ink-muted">
        {calendar ? 'Scores from ' : 'Scores and schedules from '}<a href={MAXPREPS_SCHOOL} rel="noopener" class="font-semibold text-primary underline">MaxPreps</a>{newest && `, read ${formatShortDate(newest)}`}{calendar && <Fragment>; dates checked against the <a href={calendar.url} rel="noopener" class="font-semibold text-primary underline">school calendar</a></Fragment>}.
      </p>
      {sisters.length > 0 && (
        <p class="mt-2 text-[0.9375rem] text-ink-muted">
          Also in {town.name}: {sisters.map((s, i) => (
            <Fragment>{i > 0 && (i === sisters.length - 1 ? ' and ' : ', ')}<a href={sportsPath(s)} class="font-semibold text-primary underline">{shortName(s)} {s.mascot}</a></Fragment>
          ))}.
        </p>
      )}
    </div>
  </header>

  {/* The one thing most readers came for: the next game, big, in the
      school's colour, with the rest of the week beside it; off season, the
      last result (NextUp). */}
  <NextUp {mascot} {next} {then} {latest} complete={seasonComplete(data, now)} seasonHref={(t) => `#${t.key}`} {today} />

  {/* The scoreboard: the latest scores across the teams, each as the two
      lines a scores ticker shows, the winner in the heavier ink. */}
  {board.length > 0 && (
    <section class="band band-white">
      <div class="container-page">
        <SectionHeader eyebrow="Scoreboard" title="Latest scores" id="scores" />
        <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-labelledby="scores">
          {board.map(({ team, game }, i) => {
            const won = game.result === 'W';
            const lost = game.result === 'L';
            return (
              // Three on a phone, where six ran 1,100px before any schedule; six from 40rem.
              <li class:list={['rounded-lg bg-paper p-5 ring-1 ring-line-soft', i >= 3 && 'hidden sm:block']}>
                <p class="flex items-baseline justify-between gap-3 text-[0.8125rem] text-ink-muted">
                  <span class="eyebrow">{team.name}</span>
                  <span><time datetime={game.date}>{formatDayShort(day(game))}</time>{game.stage && ` · ${game.stage}`} · {placeText(game)}</span>
                </p>
                {game.score ? (
                  <dl class="mt-4 space-y-1.5">
                    <div class="flex items-baseline justify-between gap-4">
                      <dt class:list={['text-lg leading-tight', won ? 'font-semibold text-ink' : 'text-ink-muted']}>{mascot}</dt>
                      <dd class:list={['display-md text-[2rem] tabular-nums', won ? 'text-primary' : 'text-ink-muted']}>{game.score.us}</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-4">
                      <dt class:list={['text-lg leading-tight', lost ? 'font-semibold text-ink' : 'text-ink-muted']}>{game.opponent}</dt>
                      <dd class:list={['display-md text-[2rem] tabular-nums', lost ? 'text-ink' : 'text-ink-muted']}>{game.score.them}</dd>
                    </div>
                  </dl>
                ) : (
                  <p class="display-md mt-4 text-[2rem] text-primary">{game.place ?? '—'} <span class="font-body text-lg tracking-normal text-ink-muted">{where(game)} {game.opponent}</span></p>
                )}
                <p class="mt-4 flex items-center gap-2 text-[0.9375rem]">
                  {game.result && <span class:list={['inline-flex h-6 w-6 items-center justify-center rounded-full text-[0.75rem] font-bold', PILL[game.result]]} aria-hidden="true">{game.result}</span>}
                  <a href={game.url} rel="noopener" class="font-semibold text-primary underline">{game.result ? RESULT_WORD[game.result] : 'The meet'} on MaxPreps</a>
                </p>
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  )}

  {/* Every team: the record and the run of results up top, then the next
      games, and the whole season, oldest first, behind "Show all N games"
      (TeamSeason, the article each team's own page draws too). */}
  <section class="band band-paper">
    <div class="container-page">
      <SectionHeader eyebrow="Every team" title={`The ${mascot} this season`} />
      {sports.length === 0 ? (
        <p class="text-ink-muted">No scores yet: the first read has not run.</p>
      ) : (
        <div class="space-y-6">
          {/* Each team's season, its heading a link to the team's own page (/sports/<team>/). */}
          {teams.map((s) => <TeamSeason team={s} {today} heading={{ level: 'h3', text: s.name, href: teamPath(cfg, s.key) }} stale={stale(s)} />)}

          {unread.length > 0 && (
            <p class="text-[0.9375rem] leading-relaxed text-ink-muted">
              Not read yet: {unread.map((s, i) => (
                <Fragment>{i > 0 && ', '}<a href={s.maxprepsUrl || MAXPREPS_SCHOOL} rel="noopener" class="underline">{s.name.toLowerCase()}</a></Fragment>
              ))}.
            </p>
          )}
        </div>
      )}

      <p class="mt-10 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-muted">
        {calendar ? 'A game MaxPreps and the school calendar disagree on waits until a person has checked it.' : cfg.calendarNote ?? 'Scores and dates are MaxPreps’s, as coaches report them.'} <a href="/editorial/" class="underline">How this guide checks its facts</a>.
      </p>
    </div>
  </section>
  <CtaBand
    eyebrow="Sports"
    title="Know a score we have wrong?"
    body="If a game moved or a score is off, say so and we will check it."
    links={[
      { label: 'Report a correction', href: `/correct/?item=sports&title=${encodeURIComponent(`${school} sports`)}`, primary: true },
      { label: `This week in ${town.name}`, href: '/this-week/' },
    ]}
  />
  </div>
</Base>
