---
import Page from '@/layouts/Page.astro';
import PlaceDirectory from '@/components/PlaceDirectory.astro';
import { getTown } from '@/config';
import { getTownEntries } from '@/lib/content';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';
import { EAT_DRINK_TYPES } from '@/content/schemas';

const town = getTown();
const byFeatured = (a: { data: { featured: boolean; title: string } }, b: { data: { featured: boolean; title: string } }) =>
  Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title);
const all = await getTownEntries('places');
const places = all.filter((p) => EAT_DRINK_TYPES.includes(p.data.type)).sort(byFeatured);
const shops = all.filter((p) => p.data.type === 'shop').sort(byFeatured);
const listing = [...places, ...shops].map((p) => ({ name: p.data.title, path: `/places/${p.slug}/` }));
/**
 * Written once and used for both the meta description and the CollectionPage
 * markup, which have to agree. The old line ran to 48 characters on Erie and
 * told a searcher nothing the title had not already said; a snippet is the
 * one chance to say what the page holds, so it says it.
 */
const description = `Restaurants, bars, coffee shops and stores in ${town.name}, ${town.state}: what each one is, where to find it and what it is known for. Nobody pays to be listed.`;
const structured = [
  collectionPageJsonLd(town, {
    name: `Where to eat & drink in ${town.name}, Colorado`,
    description,
    path: '/eat-drink/',
    items: listing,
  }),
  breadcrumbJsonLd(town, [
    { name: town.name, path: '/' },
    { name: 'Eat & Drink', path: '/eat-drink/' },
  ]),
];
---
<Page title="Eat & Drink" jsonLd={structured} seoTitle={`Where to eat & drink in ${town.name}, Colorado`} eyebrow={town.name} {description} intro={`Where to eat, drink, browse and linger in ${town.name}. Listings are editorial; nobody pays to be here.`}>
  <PlaceDirectory places={places} heading="Places to eat and drink" filterable emptyMessage="No places listed yet." />
  {shops.length > 0 && (
    <section class="mt-20">
      <h2 class="eyebrow mb-8 border-b-2 border-accent pb-4">Shops</h2>
      <PlaceDirectory places={shops} />
    </section>
  )}
</Page>
