---
import Page from '@/layouts/Page.astro';
import PlaceDirectory from '@/components/PlaceDirectory.astro';
import { getTown } from '@/config';
import { getTownEntries } from '@/lib/content';
import { EAT_DRINK_TYPES } from '@/content/schemas';

const town = getTown();
const byFeatured = (a: { data: { featured: boolean; title: string } }, b: { data: { featured: boolean; title: string } }) =>
  Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title);
const all = await getTownEntries('places');
const places = all.filter((p) => EAT_DRINK_TYPES.includes(p.data.type)).sort(byFeatured);
const shops = all.filter((p) => p.data.type === 'shop').sort(byFeatured);
---
<Page title="Eat & Drink" seoTitle={`Where to eat & drink in ${town.name}, Colorado`} eyebrow={town.name} description={`Restaurants, bars, coffee and shops in ${town.name}, ${town.state}.`} intro={`Where to eat, drink, browse and linger in ${town.name}. Listings are editorial; nobody pays to be here.`}>
  <PlaceDirectory places={places} heading="Places to eat and drink" filterable emptyMessage="No places listed yet." />
  {shops.length > 0 && (
    <section class="mt-20">
      <h2 class="eyebrow mb-8 border-b-2 border-accent pb-4">Shops</h2>
      <PlaceDirectory places={shops} />
    </section>
  )}
</Page>
