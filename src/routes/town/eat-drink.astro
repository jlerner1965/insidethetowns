---
import Page from '@/layouts/Page.astro';
import PlaceDirectory from '@/components/PlaceDirectory.astro';
import SubTownLinks from '@/components/SubTownLinks.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getTown } from '@/config';
import { getTownEntries } from '@/lib/content';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo';
import { byProminence } from '@/lib/places';
import { EAT_DRINK_TYPES } from '@/content/schemas';

const town = getTown();
const all = (await getTownEntries('places')).filter((p) => !p.delisted);
const places = all.filter((p) => EAT_DRINK_TYPES.includes(p.data.type)).sort(byProminence);
const shops = all.filter((p) => p.data.type === 'shop').sort(byProminence);
const listing = [...places, ...shops].map((p) => ({ name: p.data.title, path: `/places/${p.slug}/` }));
// The guide's own articles on eating out (breakfast, coffee, patios), filed
// under Food & drink. They were reachable from /guides/ alone, which the
// menu reaches last; Things to do has listed its Outdoors articles under the
// directory since October, and this is the same block (flagship audit,
// 4 November 2026).
const articles = (await getTownEntries('articles'))
  .filter((a) => a.data.category === 'Food & drink')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
/**
 * Written once and used for both the meta description and the CollectionPage
 * markup, which have to agree. The old line ran to 48 characters on Erie and
 * told a searcher nothing the title had not already said; a snippet is the
 * one chance to say what the page holds, so it says it.
 */
const description = `Restaurants, bars, coffee shops and stores in ${town.name}, ${town.state}: what each one is, where to find it and what it is known for. Nobody pays to be listed.`;
const structured = [
  collectionPageJsonLd(town, {
    name: `Where to eat & drink in ${town.name}, Colorado`,
    description,
    path: '/eat-drink/',
    items: listing,
  }),
  breadcrumbJsonLd(town, [
    { name: town.name, path: '/' },
    { name: 'Eat & drink', path: '/eat-drink/' },
  ]),
];
---
{/* The town's name in the heading (see /things-to-do/): "Eat & drink" alone
    ranked on page three or worse for "restaurants in <town>" on every guide
    but Johnstown (the search audit of 7 November 2026). */}
<Page title={`Eat & drink in ${town.name}`} jsonLd={structured} seoTitle={`Where to eat & drink in ${town.name}, Colorado`} eyebrow={town.name} {description} intro={`${places.length + shops.length} places to eat, drink, browse and linger in ${town.name}. Listings are editorial; nobody pays to be here.`}>
  <SubTownLinks slot="after-header" class="mt-5" />
  {/* The shops are one more group of the same list, with its own heading,
     count and filter button. As a separate section under a small label they
     were a third style of header, and the filters above left them alone. */}
  <PlaceDirectory places={[...places, ...shops]} heading="Places to eat, drink and shop" filterable emptyMessage="No places listed yet." />
  {articles.length > 0 && (
    <section class="mt-20">
      <SectionHeader eyebrow="From the guide" title="Eating out, in depth" href="/guides/" linkLabel="All guides" />
      {articles.length === 1 ? (
        <ArticleCard article={articles[0]} row />
      ) : (
        <div class="grid gap-x-8 gap-y-10 md:grid-cols-2">
          {articles.map((article) => <ArticleCard article={article} />)}
        </div>
      )}
    </section>
  )}
</Page>
