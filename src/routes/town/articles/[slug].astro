---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import DatedNotice from '@/components/DatedNotice.astro';
import { getTownEntries, type TownEntry } from '@/lib/content';
import { dayKey, formatDate, toIsoLocal } from '@/lib/dates';
import { getNetworkHub, getTown } from '@/config';
import { articleJsonLd, breadcrumbJsonLd } from '@/lib/seo';

export async function getStaticPaths() {
  const articles = await getTownEntries('articles');
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props {
  article: TownEntry<'articles'>;
}

const town = getTown();
const editor = getNetworkHub().editor;
const { article } = Astro.props;
const { data } = article;
const { Content, headings } = await render(article);
// Long reads get a contents rail, which is also what stops the column beside
// the text from being a page-length empty margin.
const contents = headings.filter((h) => h.depth === 2);
const shareImage = data.image ? (await getImage({ src: data.image, width: 1200, height: 630, format: 'jpg' })).src : undefined;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const byline = editor?.name ?? town.siteTitle;
const bylineUrl = editor?.url ?? '/about/';
const correctionHref = `/contact/?subject=${encodeURIComponent('Correction')}&article=${encodeURIComponent(url)}#send-message`;
const contributionLabel = data.contribution?.type === 'sponsored' ? 'Sponsored content' : 'Contributed article';
const corrections = [...data.corrections].sort((a, b) => a.date.getTime() - b.date.getTime());
---
<Page title={data.title} eyebrow={data.category} intro={data.excerpt} description={data.excerpt} image={shareImage} imageAlt={data.imageAlt} type="article"
  jsonLd={[
    articleJsonLd(town, article, url, shareImage ? new URL(shareImage, Astro.site).toString() : undefined),
    breadcrumbJsonLd(town, [
      { name: town.name, path: '/' },
      { name: 'Things to Do', path: '/things-to-do/' },
      { name: data.title, path: `/articles/${article.slug}/` },
    ]),
  ]}>
  <p slot="after-header" class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-muted">
    <span>By <a href={bylineUrl} rel="author" class="font-semibold text-ink underline decoration-line underline-offset-4 hover:text-accent-text">{byline}</a></span>
    <span aria-hidden="true">·</span>
    <span>Published <time datetime={toIsoLocal(data.date)}>{formatDate(data.date)}</time></span>
    {data.updated && <span> · Updated {formatDate(data.updated)}</span>}
  </p>
  {data.contribution && (
    <aside class="mb-8 rounded-lg border-l-4 border-accent bg-accent-tint p-5" aria-label={contributionLabel}>
      <p class="eyebrow">{contributionLabel}</p>
      <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-muted">
        {data.contribution.type === 'sponsored' ? 'Paid for by ' : 'Submitted by '}
        {data.contribution.url ? (
          <a
            href={data.contribution.url}
            rel={data.contribution.type === 'sponsored' ? 'sponsored noopener' : 'noopener'}
            class="font-semibold text-accent-text"
          >{data.contribution.name}</a>
        ) : (
          <strong class="font-semibold text-ink">{data.contribution.name}</strong>
        )}.
        {data.contribution.note && <Fragment> {data.contribution.note}</Fragment>}
      </p>
    </aside>
  )}
  {data.supersededAfter && data.supersededNote && (
    <DatedNotice from={dayKey(data.supersededAfter)}>
      <strong class="font-semibold">This was written beforehand.</strong>{' '}
      {data.supersededNote}
      {data.supersededSource && (
        <Fragment>
          {' '}<a href={data.supersededSource} class="text-accent-text" rel="nofollow">{data.supersededSourceLabel}</a>.
        </Fragment>
      )}
    </DatedNotice>
  )}
  {data.image && (
    <figure class="mb-12">
      <Image src={data.image} alt={data.imageAlt ?? ''} width={1600} height={900} class="w-full rounded-lg" />
      {data.imageCredit && (
        <figcaption class="mt-2 text-[0.8125rem] text-ink-faint">Photo: {data.imageCredit}</figcaption>
      )}
    </figure>
  )}
  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-16">
    <div>
      <div class="prose">
        <Content />
      </div>
      {corrections.length > 0 && (
        <section class="mt-12 border-t border-line pt-8" aria-labelledby="corrections-heading">
          <h2 id="corrections-heading" class="font-display text-2xl font-semibold">Corrections</h2>
          <ul class="mt-4 space-y-3 text-[0.9375rem] leading-relaxed text-ink-muted">
            {corrections.map((correction) => (
              <li>
                <time datetime={toIsoLocal(correction.date)} class="font-semibold text-ink">{formatDate(correction.date)}</time>
                {' — '}{correction.note}
              </li>
            ))}
          </ul>
        </section>
      )}
      <footer class="mt-12 rounded-lg bg-raised p-5 text-[0.9375rem] leading-relaxed text-ink-muted ring-1 ring-line-soft">
        <strong class="font-semibold text-ink">See an error?</strong>{' '}
        <a href={correctionHref} class="font-semibold text-accent-text">Report a correction about this article</a>.
        Material corrections are dated and listed on the page.
      </footer>
    </div>
    {contents.length > 2 && (
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <nav aria-labelledby="contents-heading">
          <p class="eyebrow border-b border-line-soft pb-3" id="contents-heading">In this article</p>
          <ol class="mt-3 space-y-2 text-[0.9375rem] leading-snug">
            {contents.map((h, i) => (
              <li class="flex gap-3">
                <span class="tabular-nums text-ink-faint">{String(i + 1).padStart(2, '0')}</span>
                <a href={`#${h.slug}`} class="no-underline hover:text-accent-text hover:underline">{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    )}
  </div>
</Page>
