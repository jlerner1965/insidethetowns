---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import DatedNotice from '@/components/DatedNotice.astro';
import ContentsList from '@/components/ContentsList.astro';
import ArticleStrip from '@/components/ArticleStrip.astro';
import { getTownEntries, type TownEntry } from '@/lib/content';
import { dayKey, formatDate, toIsoLocal } from '@/lib/dates';
import { checkedBy } from '@/lib/editor';
import { getTown } from '@/config';
import { articleJsonLd, breadcrumbJsonLd } from '@/lib/seo';

export async function getStaticPaths() {
  const articles = await getTownEntries('articles');
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props {
  article: TownEntry<'articles'>;
}

const town = getTown();
const { article } = Astro.props;
const { data } = article;
const { Content, headings } = await render(article);
// Long reads get a contents rail, which is also what stops the column beside
// the text from being a page-length empty margin.
const contents = headings.filter((h) => h.depth === 2);
const shareImage = data.image ? (await getImage({ src: data.image, width: 1200, height: 630, format: 'jpg' })).src : undefined;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const glance: Array<[string, string]> = data.glance
  ? (
      [
        ['Start', data.glance.start],
        ['How long', data.glance.duration],
        ['Getting around', data.glance.by],
        ['Best day', data.glance.bestDay],
        ['Before you go', data.glance.caveat],
      ] as Array<[string, string | undefined]>
    ).filter((pair): pair is [string, string] => !!pair[1])
  : [];
---
<Page title={data.title} kind="Guide" eyebrow={data.category} intro={data.excerpt} description={data.excerpt} image={shareImage} imageAlt={data.imageAlt} type="article"
  jsonLd={[
    articleJsonLd(town, article, url, shareImage ? new URL(shareImage, Astro.site).toString() : undefined),
    breadcrumbJsonLd(town, [
      { name: town.name, path: '/' },
      { name: 'Guides', path: '/guides/' },
      { name: data.title, path: `/articles/${article.slug}/` },
    ]),
  ]}>
  <Fragment slot="after-header">
    <p class="mt-5 text-sm text-ink-muted">
      <time datetime={toIsoLocal(data.date)}>{formatDate(data.date)}</time>
      {data.updated && <span> · Updated {formatDate(data.updated)}</span>}
      {data.verified && <span> · {checkedBy(formatDate(data.verified))}</span>}
    </p>
    {/* The route at a glance, in the masthead: what a visitor decides on
        before reading the stops. Only the lines the article supports. */}
    {glance.length > 0 && (
      <dl class="mt-7 grid gap-x-8 gap-y-4 border-t border-accent/30 pt-6 sm:grid-cols-2" aria-label="At a glance">
        {glance.map(([term, detail]) => (
          <div>
            <dt class="eyebrow text-ink-muted">{term}</dt>
            <dd class="mt-1 text-[0.9375rem] leading-snug">{detail}</dd>
          </div>
        ))}
      </dl>
    )}
  </Fragment>
  {data.supersededAfter && data.supersededNote && (
    <DatedNotice from={dayKey(data.supersededAfter)}>
      <strong class="font-semibold">This was written beforehand.</strong>{' '}
      {data.supersededNote}
      {data.supersededSource && (
        <Fragment>
          {' '}<a href={data.supersededSource} class="text-primary underline" rel="nofollow">{data.supersededSourceLabel}</a>.
        </Fragment>
      )}
    </DatedNotice>
  )}
  {/* A photograph too small for the page's width is shown at its own size
      rather than stretched soft across 1,200px. */}
  {data.image && (
    <figure class:list={['mb-12', data.image.width < 1000 && 'max-w-2xl']}>
      {/* Held to 32rem on a wide screen: full width at 16:9 it was some 680px
          tall and the text began a screen and a half down. */}
      <Image src={data.image} alt={data.imageAlt ?? ''} width={1600} height={900} class:list={['w-full rounded-lg object-cover', data.image.width >= 1000 && 'lg:h-[32rem]!']} />
      {data.imageCredit && (
        <figcaption class="mt-2 text-[0.8125rem] text-ink-muted">Photo: {data.imageCredit}</figcaption>
      )}
    </figure>
  )}
  {contents.length > 2 && (
    <div class="mb-10 lg:hidden">
      <ContentsList headings={contents} label="In this article" variant="panel" id="contents-panel" />
    </div>
  )}
  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-16">
    <div class="prose">
      <Content />
      {(data.sources ?? []).length > 0 && (
        <aside class="mt-12 border-t border-line-soft pt-6 text-[0.875rem] leading-relaxed text-ink-muted not-prose">
          <p class="eyebrow mb-2">Sources</p>
          <ul class="space-y-2.5 text-[0.9375rem]">
            {data.sources.map((s) => (
              <li><a href={s.url} rel="noopener" class="inline-block -my-1 py-1 underline">{s.label}</a></li>
            ))}
          </ul>
          {data.verified && <p class="mt-3">{checkedBy(formatDate(data.verified))}. Hours, prices and seasons change; the sources above are the record.</p>}
        </aside>
      )}
    </div>
    {contents.length > 2 && (
      <aside class="hidden lg:sticky lg:top-24 lg:block lg:self-start">
        <ContentsList headings={contents} label="In this article" variant="rail" id="contents-heading" />
      </aside>
    )}
  </div>

  {/* Where to go after the last line: the next few listings, this week, three
      related links and the email. An article used to end at its sources and
      then the footer. */}
  <ArticleStrip article={article} />
</Page>
