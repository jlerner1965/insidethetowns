---
/**
 * "Every year in <Town>": the guide's traditions (src/lib/traditions.ts),
 * in the guide's own palette. Three groups, one state each
 * (src/lib/traditions.ts, rowState): "Date confirmed", soonest first;
 * "Canceled", never among the dates to come (audit, 13 November 2026);
 * and "Not announced yet". Rows as on the hub's season page, with the
 * category dot and the type's label where the hub has the town.
 *
 * Built only on a guide that a record names (src/integrations/town-routes.ts,
 * traditionRoutes), and linked from the guide's events page and the footer
 * of every page. The Thursday signup closes it, as it is everywhere else (it
 * is dark on a quiet or visitor guide, as there).
 *
 * The guide's full annual index since the review of 14 November 2026: each
 * tradition's name links the guide's own page for it where there is one,
 * and every annual event page (`annual: true`) no record names is listed
 * under "More every year" (src/lib/annual-pages.ts). Erie's Balloon
 * Festival and Berthoud Day had pages linked from nowhere.
 */
import Page from '@/layouts/Page.astro';
import TraditionRow from '@/components/TraditionRow.astro';
import DateCorrection from '@/components/DateCorrection.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import OpenNow from '@/components/OpenNow.astro';
import { appliesTo } from '@/lib/hub-towns';
import { findTown, getNetworkHub, getTown } from '@/config';
import { STANDALONE_GUIDES } from '@/config/hub-towns';
import { getTownEntries, getTraditions } from '@/lib/content';
import { dayKey, formatDayLong, parseLocal } from '@/lib/dates';
import { annualPageFor, unmatchedAnnualPages, type AnnualPage } from '@/lib/annual-pages';
import { subTownsOf } from '@/lib/sub-towns';
import { eventPage, lineFor, placeKey, placeRows, publishedHubTowns, showings, type ShowingContext } from '@/lib/hub-towns';
import { breadcrumbJsonLd, collectionPageJsonLd, traditionEventJsonLd } from '@/lib/seo';
import { TRADITION_TYPE_INFO, nextRow, rowsByState, type TraditionRow as Row } from '@/lib/traditions';
import { TITLE_LIMIT } from '@/lib/titles';

const town = getTown();
const hub = getNetworkHub();
const today = dayKey(new Date());
const records = await getTraditions();
/**
 * A standalone guide shows everything that applies to it: its own
 * traditions, the shared outdoor dates that name it, and the statewide
 * ones (src/lib/hub-towns.ts). Any other guide shows the records it is
 * the home of, as before the restructure.
 */
const place = placeKey(town.slug);
const standalone = !!place && !!STANDALONE_GUIDES[place];
const mine = standalone
  ? placeRows(records, place!, today)
  : { traditions: records.filter((r) => r.town?.guide === town.slug).map((r) => nextRow(r, today)), outdoor: [], statewide: [] };
const states = rowsByState(mine.traditions);
const dated = states.upcoming;
const canceled = states.canceled;
const waiting = [...states.waiting, ...states.past];
const outdoor = [...mine.outdoor, ...mine.statewide];
const rows = [...dated, ...canceled, ...waiting, ...outdoor];
const ctx: ShowingContext = {
  hubDomain: hub.domain,
  published: new Set(publishedHubTowns(records).map((t) => t.slug)),
  guideDomain: (key) => findTown(STANDALONE_GUIDES[key]?.guide ?? '')?.domain,
  guideName: (key) => findTown(STANDALONE_GUIDES[key]?.guide ?? '')?.siteTitle ?? key,
};
// The guide's annual event pages: each tradition links its own, and the rest are listed.
const annualPages: AnnualPage[] = (await getTownEntries('events'))
  .filter((e) => e.data.annual)
  .map((e) => ({ slug: e.slug, title: e.data.title, start: dayKey(e.data.start) }));
const guideTowns = [town.name, ...subTownsOf(town).map((t) => t.label)];
const pageHref = (row: Row) => {
  const page = annualPageFor(row.record, annualPages, guideTowns);
  return page ? `/events/${page.slug}/` : undefined;
};
const moreAnnual = unmatchedAnnualPages(rows.map((row) => row.record), annualPages, guideTowns);
const rowProps = (row: Row) => ({
  row,
  href: pageHref(row),
  eyebrow: 'category' as const,
  line: place ? lineFor(row.record, place) : undefined,
  also: standalone ? showings(row.record, ctx).filter((s) => s.key !== place) : [],
});
const years = [...new Set(rows.filter((r) => !r.past).map((r) => r.year))].sort();
const yearText = years.join(' and ');
const kinds = [...new Set(rows.map((r) => TRADITION_TYPE_INFO[r.record.type].plural.toLowerCase()))];
const kindText = kinds.length > 1 ? `${kinds.slice(0, -1).join(', ')} and ${kinds.at(-1)}` : kinds[0];

const path = '/traditions/';
const pageUrl = `https://${town.domain}${path}`;
// Within TITLE_LIMIT: the kinds by name while they fit, else the plain
// "annual events" (Windsor's listed seven kinds in 149 characters; the
// owner's review, 13 November 2026). A year range in the short form.
const yearShort = years.length > 1 ? `${years[0]}–${String(years.at(-1)).slice(2)}` : yearText;
const seoTitle =
  [`${town.name}, Colorado ${kindText}${yearText ? ` ${yearText}` : ''}`, `${town.name}, Colorado ${kindText}${yearShort ? ` ${yearShort}` : ''}`].find((t) => t.length <= TITLE_LIMIT) ??
  `${town.name}, Colorado annual events and dates${yearShort ? ` ${yearShort}` : ''}`;
const description = `${town.name}, Colorado’s ${kindText}${yearText ? ` for ${yearText}` : ''}: the date each organizer has published, or that it has not yet, and the page it was read from.`;
const structured = [
  collectionPageJsonLd(town, {
    name: `Every year in ${town.name}`,
    description,
    path,
    items: rows.map((r) => ({ name: r.record.name, url: `${pageUrl}#${r.record.slug}` })),
  }),
  breadcrumbJsonLd(town, [
    { name: town.siteTitle, path: '/' },
    { name: `Every year in ${town.name}`, path },
  ]),
  // An event is marked up on one page: here when this guide is its home (eventPage).
  ...rows.map((r) => (r.past || eventPage(r.record, ctx) !== place ? undefined : traditionEventJsonLd(r.record, r.entry, pageUrl))).filter((e) => !!e),
];
const subject = `[Correction] ${town.name} traditions`;
const mailto = `mailto:${hub.correctionsEmail ?? town.social.email}?subject=${encodeURIComponent(subject)}`;
---
<Page
  title={`Every year in ${town.name}`}
  {seoTitle}
  eyebrow={`${town.name} traditions`}
  {description}
  intro="The events this town holds every year and the outdoor dates around it, with the date where it has been set, and where we read it."
  jsonLd={structured}
>
  {dated.length > 0 && (
    <section aria-labelledby="confirmed-heading" class="mb-14 md:mb-16">
      <h2 id="confirmed-heading" class="mb-6 border-b-2 border-accent pb-3 text-3xl font-medium">Date confirmed</h2>
      <div class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
        {dated.map((row) => <TraditionRow {...rowProps(row)} />)}
      </div>
    </section>
  )}
  {canceled.length > 0 && (
    <section aria-labelledby="canceled-heading" class="mb-14 md:mb-16" data-tradition-group="canceled">
      <h2 id="canceled-heading" class="mb-6 border-b-2 border-accent pb-3 text-3xl font-medium">Canceled</h2>
      <div class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
        {canceled.map((row) => <TraditionRow {...rowProps(row)} />)}
      </div>
    </section>
  )}
  {waiting.length > 0 && (
    <section aria-labelledby="waiting-heading" class="mb-14 md:mb-16">
      <h2 id="waiting-heading" class="mb-6 border-b-2 border-accent pb-3 text-3xl font-medium">Not announced yet</h2>
      <div class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
        {waiting.map((row) => <TraditionRow {...rowProps(row)} />)}
      </div>
    </section>
  )}
  {moreAnnual.length > 0 && (
    <section aria-labelledby="more-heading" class="mb-14 md:mb-16" data-annual-pages>
      <h2 id="more-heading" class="mb-6 border-b-2 border-accent pb-3 text-3xl font-medium">More every year</h2>
      <ul class="divide-y divide-line-soft rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
        {moreAnnual.map((p) => (
          <li class="py-4">
            <a href={`/events/${p.slug}/`} class="text-xl font-medium leading-tight no-underline hover:text-primary hover:underline">{p.title}</a>
            <p class="mt-1 text-[0.9375rem] text-ink-muted">
              {p.start >= today ? 'Next' : 'Last held'} <time datetime={p.start}>{formatDayLong(parseLocal(p.start))}, {p.start.slice(0, 4)}</time>
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}
  {outdoor.length > 0 && (
    <section id="outdoor-dates" aria-labelledby="outdoor-heading" class="mb-14 scroll-mt-4 md:mb-16">
      <h2 id="outdoor-heading" class="mb-6 border-b-2 border-accent pb-3 text-3xl font-medium">Outdoor dates</h2>
      <div class="rounded-lg bg-raised px-5 ring-1 ring-line-soft sm:px-7">
        {outdoor.map((row) => <TraditionRow {...rowProps(row)} />)}
      </div>
      {standalone && <OpenNow records={records.filter((r) => !r.statewide && appliesTo(r, place!))} {today} class="mt-6" />}
    </section>
  )}

  {/* Where the dates come from, and an ask to the organizers; no yellow box and no "a date wrong?" (the owner, 14 November 2026). */}
  <p class="mb-12 text-[0.9375rem] leading-relaxed text-ink-muted">
    Every date links to the page it was read from. Organizing one of these, or one we don’t list? <a href={mailto} class="underline">Send us your dates</a>.
  </p>

  <NewsletterSignup town={town} />
  <DateCorrection />
</Page>
