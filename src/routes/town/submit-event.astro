---
/**
 * The event submission form.
 *
 * Every route into this network was a mailto:, which converts badly on a phone
 * — it opens an app most people have never configured — and returns freeform
 * prose somebody then has to parse by hand. What, when, where, the source to
 * check it against, and a way to reply; everything else a listing carries is
 * read off the organizer's page.
 *
 * "When" is in Mountain Time, says so, and can say what a real schedule
 * needs: an end time if there is one, all day, and a line for other dates or
 * a repeat. One date and time could not describe a two-night show or a
 * Thursday series, and the second night arrived as a guess.
 *
 * The organizer's link is required rather than optional, because the editorial
 * policy says every listing is checked against its source before it goes up.
 * Without a link there is nothing to check it against.
 *
 * There is no CAPTCHA. It would cost submissions from exactly the people most
 * likely to know about the church supper nobody else has listed. `_gotcha` is
 * Formspree's own honeypot: visible only to something filling every field.
 */
import Page from '@/layouts/Page.astro';
import { getTown } from '@/config';
import { eventEmailHref } from '@/lib/submit';
import { PRIVACY_LINE } from '@/lib/privacy';

const town = getTown();
const action = town.formspreeId ? `https://formspree.io/f/${town.formspreeId}` : undefined;
const mailto = eventEmailHref(town.social.email, `Event submission — ${town.siteTitle}`);
const field = 'mt-1.5 block w-full rounded-md border border-line bg-raised px-3 py-2.5 text-[1.0625rem] font-normal';
const label = 'block text-sm font-semibold';
// The legend floats inside the card's padding: on a ring (not a border) it
// had no notch to sit in and straddled the card's top edge, indented past the
// labels below it.
const group = 'space-y-5 rounded-lg bg-raised p-5 ring-1 ring-line-soft sm:p-6 md:p-8 [&>legend+*]:clear-both';
---
<Page
  title="Submit an event"
  eyebrow={town.name}
  description={`Tell us about an event in ${town.name} and we’ll check it and put it up.`}
  intro={`Anything open to the public in and around ${town.name}. Listings are free — we don’t charge to be here and never will.`}
  narrow
>
  {action ? (
    <form action={action} method="POST" class="space-y-8">
      <input type="hidden" name="_subject" value={`Event submission — ${town.siteTitle}`} />
      <input type="hidden" name="town" value={town.slug} />
      <input type="hidden" name="_next" value={`https://${town.domain}/thanks/`} />
      <p class="hidden" aria-hidden="true">
        <label>Leave this blank <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </p>

      {/* The fields a listing cannot be checked without (owner's call,
          7 October 2026), and the three optional ones a schedule needs: the
          rest is read off the organizer's page. */}
      <fieldset class={group}>
        <legend class="eyebrow float-left mb-1 w-full p-0">The event</legend>
        <label class={label}>
          Event name
          <input type="text" name="title" required autocomplete="off" class={field} />
        </label>
        <div class="grid gap-5 sm:grid-cols-3">
          <label class={label}>
            Date
            <input type="date" name="date" required class={field} />
          </label>
          <label class={label}>
            Start time <span class="font-normal text-ink-muted">(Mountain Time)</span>
            <input type="time" name="start_time" class={field} data-start-time />
          </label>
          <label class={label}>
            End time <span class="font-normal text-ink-muted">(optional)</span>
            <input type="time" name="end_time" class={field} data-end-time />
          </label>
        </div>
        <label class="flex min-h-11 items-center gap-2.5 text-[0.9375rem] font-semibold">
          <input type="checkbox" name="all_day" value="yes" class="size-5 shrink-0 rounded border-line" data-all-day />
          All day, no set times
        </label>
        <label class={label}>
          Other dates, or how it repeats <span class="font-normal text-ink-muted">(optional)</span>
          <textarea name="other_dates" rows="2" maxlength="300" placeholder="Also Friday the 16th at 7:30 pm; or every Thursday through November" class={field}></textarea>
        </label>
        <label class={label}>
          Location
          <input type="text" name="venue" required autocomplete="off" placeholder="Venue, or an address" class={field} />
        </label>
        <label class={label}>
          Link to the source
          <input type="url" name="url" required inputmode="url" placeholder="https://" class={field} />
          <span class="mt-1.5 block text-sm font-normal text-ink-muted">
            The organizer’s own page, a Facebook event or a venue’s calendar: every listing is checked against its
            source before it goes up.
          </span>
        </label>
        <label class={label}>
          Your email
          <input type="email" name="email" required autocomplete="email" class={field} />
          <span class="mt-1.5 block text-sm font-normal text-ink-muted">
            Only so we can come back to you with a question, and it is never published. {PRIVACY_LINE}
          </span>
        </label>
      </fieldset>

      <div class="space-y-4">
        <button type="submit" class="btn btn-primary w-full justify-center sm:w-auto">Send it in</button>
        <p class="text-sm leading-relaxed text-ink-muted">
          We check every submission against the organizer’s own page before it goes up, usually within a couple of
          days. If something is wrong once it is live, <a href="/contact/" class="text-accent-text underline">tell us</a> and it
          gets fixed.
        </p>
      </div>
    </form>
  ) : (
    <div class="prose">
      <p>
        The form here isn’t switched on yet, so email it instead — it reaches the same place and gets the same
        treatment.
      </p>
      <p><a href={mailto} class="btn btn-primary no-underline">Email an event</a></p>
      <p>
        The email opens with what we need already listed: the event name, the date and start time in Mountain Time,
        the location, and a link to the organizer’s own page, with lines for an end time and any other dates. The
        link matters: every listing is checked against its source before it goes up, usually within a couple of days.
      </p>
    </div>
  )}
</Page>

<script>
  // A start time is asked for unless the event is all day. Without the
  // script neither is required, and the source settles it when we check.
  for (const box of document.querySelectorAll<HTMLInputElement>('[data-all-day]')) {
    const form = box.form;
    const start = form?.querySelector<HTMLInputElement>('[data-start-time]');
    const end = form?.querySelector<HTMLInputElement>('[data-end-time]');
    const sync = () => {
      if (start) {
        start.required = !box.checked;
        start.disabled = box.checked;
      }
      if (end) end.disabled = box.checked;
    };
    box.addEventListener('change', sync);
    sync();
  }
</script>
