{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "api/**/*", "astro.config.mjs"],
  "exclude": ["dist", "node_modules"]
}
