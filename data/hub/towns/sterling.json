  "heritage": {
    "nameOrigin": {
      "text": "David Leavitt, a railroad surveyor and Illinois native, established a post office and named it Sterling in honor of his boyhood home in Illinois.",
      "source": "https://www.historycolorado.org/sites/default/files/media/document/2022/Downtown%20Sterling%20Historic%20District_NR.pdf",
      "checked": "2026-11-12"
    },
    "founded": {
      "year": 1881,
      "text": "The rail line was completed in 1881, and Minos C. King filed a plat for Sterling's original townsite in September of that year.",
      "source": "https://www.historycolorado.org/sites/default/files/media/document/2022/Downtown%20Sterling%20Historic%20District_NR.pdf",
      "checked": "2026-11-12"
    },
    "timeline": [
      {
        "year": 1871,
        "text": "William Shaw Hadfield arrived and made his home on an island in the South Platte River a few miles south of present-day Sterling.",
        "source": "https://www.sterlingcolo.com/our_city/about_sterling/index.php",
        "checked": "2026-11-12"
      },
      {
        "year": 1873,
        "text": "Settlers about four miles north of the present town site built the first irrigation ditch.",
        "source": "https://www.sterlingcolo.com/our_city/about_sterling/index.php",
        "checked": "2026-11-12"
      },
      {
        "year": 1881,
        "text": "The Union Pacific Railroad came through, and a section house and depot were built.",
        "source": "https://www.sterlingcolo.com/our_city/about_sterling/index.php",
        "checked": "2026-11-12"
      },
      {
        "year": 1884,
        "text": "Sterling was incorporated on December 13.",
        "source": "https://www.sterlingcolo.com/our_city/about_sterling/index.php",
        "checked": "2026-11-12"
      },
      {
        "year": 1887,
        "text": "Sterling was made the county seat.",
        "source": "https://www.sterlingcolo.com/our_city/about_sterling/index.php",
        "checked": "2026-11-12"
      }
