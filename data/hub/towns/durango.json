  "heritage": {
    "nameOrigin": {
      "text": "Durango was named after Durango, Mexico; the word comes from the Basque \"Urango\", meaning \"water town\" or \"well watered place\".",
      "source": "https://www.durangoco.gov/274/History",
      "checked": "2026-11-12"
    },
    "founded": {
      "year": 1880,
      "text": "Formed by the Denver and Rio Grande Railroad Company in September 1880 to serve the San Juan mining district.",
      "source": "https://www.durangoco.gov/274/History",
      "checked": "2026-11-12"
    },
    "timeline": [
      {
        "year": 1881,
        "text": "The railroad arrived in Durango on August 5, 1881.",
        "source": "https://durangotrain.com/history/",
        "checked": "2026-11-12"
      },
      {
        "year": 1882,
        "text": "The tracks to Silverton were completed by July and trains began hauling passengers and freight.",
        "source": "https://durangotrain.com/history/",
        "checked": "2026-11-12"
      },
      {
        "year": 1889,
        "text": "A fire virtually destroyed downtown.",
        "source": "https://durangotrain.com/history/",
        "checked": "2026-11-12"
      },
      {
        "year": 1912,
        "text": "Voters approved a home rule charter on September 3, making Durango the fourth home rule city in Colorado.",
        "source": "https://www.durangoco.gov/274/History",
        "checked": "2026-11-12"
      },
      {
        "year": 1956,
        "text": "Fort Lewis College relocated to Durango.",
        "source": "https://www.durangoco.gov/274/History",
        "checked": "2026-11-12"
      }
    ],
