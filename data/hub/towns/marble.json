  "heritage": {
    "nameOrigin": {
      "text": "The marble beds on Yule Creek were named Yule Marble in 1874; the neighboring settlements of Clarence and Marble agreed in 1890 to join as one town called Marble.",
      "source": "https://marblehistory.org/marble-timeline/",
      "checked": "2026-11-12"
    },
    "founded": {
      "year": 1881,
      "text": "The town of Clarence was founded east of Carbonate Creek; it joined the neighboring Town of Marble in 1890",
      "source": "https://marblehistory.org/marble-timeline/",
      "checked": "2026-11-12"
    },
    "timeline": [
      {
        "year": 1906,
        "text": "The Colorado Yule Marble Company was organized and built seven miles of new track into Marble.",
        "source": "https://marblehistory.org/marble-history/",
        "checked": "2026-11-12"
      },
      {
        "year": 1915,
        "text": "Marble's population reached 1,500.",
        "source": "https://marblehistory.org/marble-history/",
        "checked": "2026-11-12"
      },
      {
        "year": 1943,
        "text": "The railroad tracks were taken up and the machinery sold for scrap metal.",
        "source": "https://marblehistory.org/marble-history/",
        "checked": "2026-11-12"
      },
      {
        "year": 1972,
        "text": "The town was reincorporated.",
        "source": "https://marblehistory.org/marble-history/",
        "checked": "2026-11-12"
      }
