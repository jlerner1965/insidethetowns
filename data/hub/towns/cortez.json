  "heritage": {
    "founded": {
      "year": 1886,
      "text": "On Christmas Day 1886 Matt Hammond hauled a wagon of lumber onto the old cattle roundup ground to put up the town's first buildings.",
      "source": "https://www.cortezco.gov/318/History-of-City",
      "checked": "2026-11-12"
    },
    "timeline": [
      {
        "year": 1887,
        "text": "By spring, hundreds of men were at work on the irrigation system meant to bring water to the valley.",
        "source": "https://www.cortezco.gov/318/History-of-City",
        "checked": "2026-11-12"
      },
      {
        "year": 1889,
        "text": "The stone block at the corner of Main and Market was completed.",
        "source": "https://www.cortezco.gov/318/History-of-City",
        "checked": "2026-11-12"
      },
      {
        "year": 1891,
        "text": "The Rio Grande Southern reached Dolores; the spur to Cortez was never completed.",
        "source": "https://www.cortezco.gov/318/History-of-City",
        "checked": "2026-11-12"
      },
      {
        "year": 1906,
        "text": "The Mesa Verde area was designated a national park.",
