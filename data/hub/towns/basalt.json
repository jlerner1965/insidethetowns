  "heritage": {
    "nameOrigin": {
      "text": "The town was known as Aspen Junction until 1895, when it was renamed Basalt for the basaltic rock of Black Mountain, now Basalt Mountain.",
      "source": "https://www.basalt.net/380/History-of-Basalt",
      "checked": "2026-11-12"
    },
    "founded": {
      "year": 1887,
      "text": "The railroad established a town site on the north side of the Fryingpan River, first called Aspen Junction",
      "source": "https://www.basalt.net/380/History-of-Basalt",
      "checked": "2026-11-12"
    },
    "timeline": [
      {
        "year": 1882,
        "text": "Seven charcoal kilns were built near the confluence of the Roaring Fork and Fryingpan rivers to supply smelters in Aspen.",
        "source": "https://www.basalt.net/380/History-of-Basalt",
        "checked": "2026-11-12"
      },
      {
        "year": 1887,
        "text": "The town of Aspen Junction was formed across the Fryingpan River from the kilns.",
        "source": "https://www.basalt.net/380/History-of-Basalt",
        "checked": "2026-11-12"
      },
      {
        "year": 1895,
        "text": "Aspen Junction was renamed Basalt.",
        "source": "https://www.basalt.net/380/History-of-Basalt",
        "checked": "2026-11-12"
      },
      {
