  "heritage": {
    "nameOrigin": {
      "text": "The town takes its name from Crested Butte Mountain, which rises to the northeast.",
      "source": "https://npgallery.nps.gov/GetAsset/d1c49d14-a736-4e40-a2e6-329fd28293fa",
      "checked": "2026-11-13"
    },
    "founded": {
      "year": 1878,
      "text": "Howard F. Smith established the settlement at the junction of Coal Creek and the Slate River; it was known as Crested Butte by the summer of 1878.",
      "source": "https://npgallery.nps.gov/GetAsset/d1c49d14-a736-4e40-a2e6-329fd28293fa",
      "checked": "2026-11-13"
    },
    "timeline": [
      {
        "year": 1874,
        "text": "Settlers looking for precious metals were in the area as early as 1874.",
        "source": "https://www.historycolorado.org/location/crested-butte-historic-district",
        "checked": "2026-11-12"
      },
      {
        "year": 1880,
        "text": "Crested Butte, a supply center for nearby mining camps, was incorporated.",
        "source": "https://www.historycolorado.org/location/crested-butte-historic-district",
        "checked": "2026-11-12"
      },
      {
        "year": 1882,
        "text": "Coal mines and coke ovens made the Crested Butte area the state's leading mountain coal operation by 1882.",
        "source": "https://www.historycolorado.org/location/crested-butte-historic-district",
        "checked": "2026-11-12"
      },
      {
        "year": 1952,
        "text": "The major coal mines shut down.",
        "source": "https://www.historycolorado.org/location/crested-butte-historic-district",
        "checked": "2026-11-12"
      },
      {
        "year": 1974,
        "text": "The Crested Butte Historic District was listed on the National Register on May 29, 1974.",
        "source": "https://www.historycolorado.org/location/crested-butte-historic-district",
        "checked": "2026-11-12"
      }
    ],
