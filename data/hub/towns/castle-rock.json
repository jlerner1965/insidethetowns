      "checked": "2026-11-12"
    },
    "founded": {
      "year": 1874,
      "text": "Platted on April 25, 1874, on land Jeremiah Gould homesteaded in 1869",
      "source": "https://www.historycolorado.org/sites/default/files/media/documents/2018/5da653.pdf",
      "checked": "2026-11-12"
    },
    "timeline": [
      {
        "year": 1874,
        "text": "Locals pushed for a railroad depot in Castle Rock, the designated seat of the newly realigned Douglas County.",
        "source": "https://www.castlerockhistoricalsociety.org/",
        "checked": "2026-11-12"
      },
      {
        "year": 1875,
        "text": "A depot of rhyolite stone went up on Third Street on the Denver & Rio Grande line.",
        "source": "https://www.castlerockhistoricalsociety.org/?page_id=3044",
        "checked": "2026-11-12"
      },
      {
        "year": 1962,
        "text": "The Castle Rock Chamber of Commerce created the Starlighting celebration.",
        "source": "https://castlerock.org/castle-rock-starlighting/",
        "checked": "2026-11-12"
      },
      {
        "year": 1970,
        "text": "The depot was moved to 420 Elbert Street.",
        "source": "https://www.castlerockhistoricalsociety.org/?page_id=3044",
        "checked": "2026-11-12"
      },
      {
        "year": 1997,
        "text": "The Castle Rock Historical Society opened the Castle Rock Museum in the depot in October.",
